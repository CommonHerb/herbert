-- Notes session recovery: one private directory and plain-text snapshot per
-- edited session. No original path is reopened or adopted during recovery.
-- All storage is startup-only. All filesystem calls use already open directory
-- descriptors. Copies remain after exit/save/discard, for explicit user cleanup.
-- r: snapshot file context, state (serial0, parent-synced8, directory-created16), relative path bytes.
func recovery_new(capacity):
    let f = File(FileState(0, 0, false, 0, 0, false, 0, false, 0), linux_buffer(capacity + 1), linux_cstring("recovery.txt"), linux_buffer(128), linux_buffer(144), linux_buffer(144), linux_buffer(1), linux_buffer(144), linux_buffer(capacity), linux_buffer(128))
    let st = f.state
    st.dirfd = 0 - 1
    st.mode = 384
    return (f, linux_buffer(24), linux_buffer(128))
end

func recovery_open(r, original, tries):
    if tries == 0: return 0 - 17 end
    let parent = original.state.dirfd
    if linux_u64(r.1, 16) == 0:
        let serial = linux_u64(r.1, 0) + 1
        do linux_put64(r.1, 0, serial)
        do linux_text(r.2, 0, ".herbert-notes-")
        let pidend = linux_decimal(r.2, 15, linux_syscall6(39, 0, 0, 0, 0, 0, 0))
        do buffer_set(r.2, pidend, 45)
        let last = linux_decimal(r.2, pidend + 1, serial)
        do buffer_set(r.2, last, 0)
        let created = linux_syscall6(258, parent, buffer_address(r.2), 448, 0, 0, 0)
        if created == 0 - 17: return recovery_open(r, original, tries - 1) end
        if created != 0: return created end
        do linux_put64(r.1, 16, 1)
    end
    -- After mkdir succeeds, retry that same candidate. Open/stat/mode failures
    -- must never create another empty directory on every subsequent edit.
    let last = linux_nul_end(r.2, 0, buffer_length(r.2))
    -- O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC: never follow a replaced link.
    let fd = linux_syscall6(257, parent, buffer_address(r.2), 720896, 0, 0, 0)
    if linux_error(fd): return fd end
    let snapshot = r.0
    let snapshot_state = snapshot.state
    let checked = linux_syscall6(5, fd, buffer_address(snapshot.stat), 0, 0, 0, 0)
    if checked == 0:
        if (linux_u32(snapshot.stat, 24) & 61951) != 16832 or linux_u32(snapshot.stat, 28) != linux_syscall6(107, 0, 0, 0, 0, 0, 0): checked = 0 - 13 end
    end
    -- mkdir mode never grants group/other access, even with permissive umask.
    -- A restrictive umask that removes owner access is a visible refusal.
    if checked != 0:
        do linux_syscall6(3, fd, 0, 0, 0, 0, 0)
        return checked
    end
    snapshot_state.dirfd = fd
    do linux_text(r.2, last, "/recovery.txt")
    do buffer_set(r.2, last + 13, 0)
    return 0
end

-- A completed checkpoint uses file_save's write/fsync/rename/directory-fsync
-- contract. A failed pre-publication attempt retains the prior snapshot. A
-- published but uncertain result is 1. Failures do not disable ordinary editing.
func recovery_save(r, original, bytes, count):
    let snapshot = r.0
    if linux_error(snapshot.state.dirfd):
        let opened = recovery_open(r, original, 32)
        if opened != 0: return file_result(snapshot, opened) end
    end
    let saved = file_save(snapshot, bytes, count)
    if saved != 0: return saved end
    if linux_u64(r.1, 8) == 0:
        let synced = linux_syscall6(74, original.state.dirfd, 0, 0, 0, 0, 0)
        if synced != 0: return file_result(snapshot, 1) end
        do linux_put64(r.1, 8, 1)
    end
    return 0
end

func recovery_close(r): return file_close(r.0) end

-- Before another document is edited: the next checkpoint creates a new private
-- directory beside that document. The previous session's copy stays where it is;
-- the directory serial keeps counting, so no name is reused.
func recovery_reset(r):
    do recovery_close(r)
    let snapshot = r.0
    let st = snapshot.state
    st.status = 0
    st.exists = false
    st.count = 0
    st.published = false
    st.uncertain = false
    st.saved_count = 0
    do linux_put64(r.1, 8, 0)
    do linux_put64(r.1, 16, 0)
    return 0
end
