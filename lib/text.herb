-- Text in and out: the pieces every program here used to build by hand, a
-- byte at a time. Requires lib/linux.herb; no main. Reading looks at a span
-- of a buffer, from at up to stop (stop itself not included), or of a string,
-- for the command line's arguments (linux_argument gives strings, and the
-- language reads a string with index, a buffer with buffer_get, so each reader
-- comes in both forms). Writing puts text into a fixed buffer at an offset and
-- returns the offset after it, so a line is built by passing each result on to
-- the next call. None of the readers and writers allocates, so a program may
-- use them for weeks; a write past a buffer's end stops the program with
-- lib/linux.herb's range message. The text_add functions and text_string at
-- the end are the exception: they grow a buffer, so they allocate, and are for
-- output made once (a test mode's report, a message before exit).
-- Names begin text_; lib/text_buffer.herb (Notes) uses that prefix too, and
-- none of these names is one of its.

-- Whether the byte b is a decimal digit, 0 to 9.
func text_digit(b): return b >= 48 and b <= 57 end

-- Whether the byte b is a blank: a space or a tab (a newline is not).
func text_blank(b): return b == 32 or b == 9 end

-- Whether value * 10 + d is still below 2^64: the one rule for the size of a
-- whole number (2^64 - 1 is 18446744073709551615).
func text_fits(value, d):
    return value < 1844674407370955161 or (value == 1844674407370955161 and d <= 5)
end

-- The first byte from at, before stop, that is not a blank; stop if none is.
func text_skip(b, at, stop):
    while at < stop and text_blank(buffer_get(b, at)): at = at + 1 end
    return at
end

-- The next field from at, before stop: any blanks skipped, then the bytes up
-- to the next blank or stop. (start, after); (stop, stop) when only blanks are
-- left. Fields are split on spaces and tabs only, so a line's newline (and a
-- carriage return before it) is the caller's to take off first.
func text_field(b, at, stop):
    let start = text_skip(b, at, stop)
    let after = start
    while after < stop and not text_blank(buffer_get(b, after)): after = after + 1 end
    return (start, after)
end

-- A whole number at at, before stop: the digits from at up to the first byte
-- that is not one. (ok, value, next), next being the byte after the last digit.
-- ok is false, and value 0, when there is no digit at at or the number passes
-- 2^64 - 1. Zeros in front are allowed ("007" is 7). What may come after it is
-- the caller's to check: next == stop for a span that is all number.
func text_whole(b, at, stop):
    let start = at
    let value = 0
    while at < stop and text_digit(buffer_get(b, at)):
        let d = buffer_get(b, at) - 48
        if not text_fits(value, d): return (false, 0, at) end
        value = value * 10 + d
        at = at + 1
    end
    return (at != start, value, at)
end

-- As text_whole, with no zero in front of another digit ("0" is a number,
-- "07" is not): a number as a program writes it.
func text_whole_strict(b, at, stop):
    let n = text_whole(b, at, stop)
    if n.0 and n.2 - at > 1 and buffer_get(b, at) == 48: return (false, 0, n.2) end
    return n
end

-- text_whole and text_whole_strict for a string s, from at before stop (at
-- most length(s)).
func text_string_whole(s, at, stop):
    let start = at
    let value = 0
    while at < stop and text_digit(index(s, at)):
        let d = index(s, at) - 48
        if not text_fits(value, d): return (false, 0, at) end
        value = value * 10 + d
        at = at + 1
    end
    return (at != start, value, at)
end

func text_string_whole_strict(s, at, stop):
    let n = text_string_whole(s, at, stop)
    if n.0 and n.2 - at > 1 and index(s, at) == 48: return (false, 0, n.2) end
    return n
end

-- Whether the bytes of s come at at, before stop (more may follow them).
func text_starts(b, at, stop, s):
    if at > stop or stop - at < length(s): return false end
    let i = 0
    while i < length(s):
        if buffer_get(b, at + i) != index(s, i): return false end
        i = i + 1
    end
    return true
end

-- Whether the bytes from at to stop are exactly s.
func text_is(b, at, stop, s):
    return stop - at == length(s) and text_starts(b, at, stop, s)
end

-- s into b at at: the offset after it.
func text_put(b, at, s):
    do linux_text(b, at, s)
    return at + length(s)
end

-- n in decimal, no zero in front, into b at at: the offset after it. The same
-- as linux_decimal, by the name the other writers share.
func text_put_whole(b, at, n): return linux_decimal(b, at, n) end

-- n in decimal with zeros in front to make at least width digits ("07" for 7
-- and width 2; a longer number is written whole): the offset after it.
func text_put_padded(b, at, n, width):
    let digits = 1
    let rest = n / 10
    while rest != 0:
        digits = digits + 1
        rest = rest / 10
    end
    while digits < width:
        at = text_put(b, at, "0")
        digits = digits + 1
    end
    return linux_decimal(b, at, n)
end

-- n / unit to the nearest tenth, a half rounding up, as "12.3", worked out in
-- whole numbers: ten tenths carry into the whole part (9.96 is "10.0"). unit is
-- 1 to 2^60 (1024 turns KiB into MiB). The offset after it.
func text_put_tenths(b, at, n, unit):
    let whole = n / unit
    let tenths = ((n % unit) * 10 + unit / 2) / unit
    if tenths == 10:
        whole = whole + 1
        tenths = 0
    end
    at = text_put(b, linux_decimal(b, at, whole), ".")
    return linux_decimal(b, at, tenths)
end

-- Growing output. These add to the end of out, a buffer made with new_buffer,
-- and so allocate whenever it grows: for output made once, printed with
-- flogger(freeze(out)) or given to linux_die. Each returns 0.
func text_add(out, s):
    let i = 0
    while i < length(s):
        do append(out, index(s, i))
        i = i + 1
    end
    return 0
end

-- count bytes of b from from.
func text_add_span(out, b, from, count):
    let i = 0
    while i < count:
        do append(out, buffer_get(b, from + i))
        i = i + 1
    end
    return 0
end

-- n in decimal, no zero in front.
func text_add_whole(out, n):
    if n >= 10: do text_add_whole(out, n / 10) end
    do append(out, 48 + n % 10)
    return 0
end

-- The bytes from from to stop of b as a string, for the readers that take one
-- (allocates).
func text_string(b, from, stop):
    let out = new_buffer()
    do text_add_span(out, b, from, stop - from)
    return freeze(out)
end
