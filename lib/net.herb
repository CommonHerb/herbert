-- Knocking on a computer over TCP: does it answer at this IPv4 address and
-- port? Requires lib/linux.herb and lib/text.herb; no main, no libc.
-- Addresses only: no name (DNS, /etc/hosts) is looked up. A knock starts a connection, waits for it at
-- most a time limit, closes it on every path and never sends a byte.
-- A Net record (net_new, once) holds everything a knock needs: a knock
-- allocates nothing, so a program may knock every few seconds for weeks.
-- Two ways to knock, one knock at a time per Net: net_knock waits for the
-- answer; net_start begins a knock and net_check looks at it without waiting,
-- for a program that must keep going meanwhile, such as a window (net_left
-- says how long it may wait before looking again, net_stop gives a knock up).
-- net_start_reading begins a knock that does not wait either and, once the
-- computer takes the connection, keeps it open and reads what the computer
-- sends, without waiting, into the Net's 256-byte reply buffer, until the
-- computer closes it, 256 bytes have come, or the time limit passes: how
-- Scope hears from its helper. It still never sends a byte.
-- Layouts and numbers: Linux x86-64 UAPI. sockaddr_in is 16 bytes (family 2,
-- then port and address in network byte order, then 8 zero bytes); pollfd 8;
-- timespec 16. The system calls and flags go by their names in lib/linux.herb
-- (linux_socket, linux_connect, linux_receive, linux_get_option, linux_close);
-- POLLIN 1, POLLOUT 4.
-- https://man7.org/linux/man-pages/man2/connect.2.html (EINPROGRESS, SO_ERROR)
-- https://man7.org/linux/man-pages/man2/recv.2.html (MSG_DONTWAIT, EAGAIN)
-- https://man7.org/linux/man-pages/man7/tcp.7.html
-- https://man7.org/linux/man-pages/man7/ip.7.html (the errors)

-- What the last knock found. outcome:
--   0 answered     the connection was accepted (error 0), or accepted and then
--                  reset (ECONNRESET) or closed and reset (EPIPE): Linux gives
--                  those only once the handshake is done, since a reset before
--                  it is ECONNREFUSED; error keeps which;
--   1 refused      the computer said no (a reset; ECONNREFUSED): it is there,
--                  but nothing takes connections on that port;
--   2 no answer    nothing came back within the time limit (also the kernel's
--                  own give-up, ETIMEDOUT, which a limit of a minute or less
--                  never reaches with Linux's default retries);
--   3 unreachable  the network says there is no way there: ENETUNREACH,
--                  EHOSTUNREACH, ENETDOWN or EHOSTDOWN, from this computer's
--                  own routes at once or from an ICMP message later;
--   4 error        anything else, the Linux error in error.
-- error is the Linux error number that decided the outcome, 0 when none did
-- (a plain answer, and the time limit reached); elapsed is the knock's length
-- in whole milliseconds on the monotonic clock.
-- While a knock begun by net_start or net_start_reading is under way, pending
-- is true, fd is its socket (a caller may wait on it, for events, along with
-- its own descriptors), started is when it began, in microseconds on the
-- monotonic clock, and limit its time limit in ms; outcome says error, with
-- error 0, until it ends. events is what to wait for: POLLOUT (4) while the
-- connection is being made, POLLIN (1) once a reading knock is reading (a
-- connected socket is always ready for POLLOUT, so waiting for that then
-- would never wait).
-- reading is true for a knock begun by net_start_reading. got is how many
-- bytes it has read into the Net's reply buffer, and closed is true when the
-- computer then closed the connection (end of file): only then are those got
-- bytes all it sent. A reading knock that is answered keeps outcome 0
-- (answered), whatever it reads or does not; error 0 unless the connection
-- failed while it read (ECONNRESET, for one).
ref record NetState:
    outcome: int
    error: int
    elapsed: int
    pending: bool
    fd: int
    started: int
    limit: int
    reading: bool
    events: int
    got: int
    closed: bool
end

-- The state, then the sockaddr_in, pollfd and timespec buffers, SO_ERROR's
-- value and length (two 32-bit fields), and the reply buffer of a reading
-- knock (256 bytes).
record Net:
    state: NetState
    address: buffer
    poll: buffer
    clock: buffer
    option: buffer
    reply: buffer
end

func net_new():
    let st = NetState(4, 0, 0, false, 0, 0, 0, false, 4, 0, false)
    return Net(st, linux_buffer(16), linux_buffer(8), linux_buffer(16), linux_buffer(8), linux_buffer(256))
end

-- Dotted IPv4 text: exactly four numbers 0 to 255 joined by single dots, and
-- nothing else, not even a space. (true, address), the first number in the top
-- byte, or (false, 0). A leading zero is refused, since some tools read "010"
-- as octal 8; so are signs, hex, empty parts and any text before or after.
func net_ipv4(text):
    let address = 0
    let at = 0
    let parts = 0
    while parts < 4:
        if parts > 0:
            if at >= length(text) or index(text, at) != 46: return (false, 0) end
            at = at + 1
        end
        let part = text_string_whole_strict(text, at, length(text))
        if not part.0 or part.1 > 255: return (false, 0) end
        address = (address << 8) | part.1
        at = part.2
        parts = parts + 1
    end
    if at != length(text): return (false, 0) end
    return (true, address)
end

-- A whole decimal number from 1 to most, the whole text, with no zero in
-- front: (true, n) or (false, 0).
func net_whole(text, most):
    let n = text_string_whole_strict(text, 0, length(text))
    if not n.0 or n.2 != length(text) or n.1 == 0 or n.1 > most: return (false, 0) end
    return (true, n.1)
end

-- A TCP port, 1 to 65535.
func net_port(text): return net_whole(text, 65535) end

-- A time limit in whole milliseconds, 1 to 60000.
func net_limit(text): return net_whole(text, 60000) end

func net_classify(e):
    if e == 111: return 1 end
    if e == 101 or e == 113 or e == 100 or e == 112: return 3 end
    if e == 110: return 2 end
    return 4
end

-- Microseconds on the monotonic clock, through n.clock, or raw -errno. A knock
-- times itself in microseconds so that rounding to whole milliseconds can
-- never cut its time limit short.
func net_clock(n): return linux_clock_us(n.clock) end

-- Whole milliseconds since started (microseconds).
func net_since(n, started):
    let now = net_clock(n)
    if linux_error(now) or now < started: return 0 end
    return (now - started) / 1000
end

-- poll says the attempt on fd has ended (revents in ready): SO_ERROR says how.
-- A reset (ECONNRESET) or a close and reset (EPIPE) comes only after the
-- computer took the connection, so it answered. Otherwise connected means no
-- error, and writable without a hang-up (an unconnected socket polls as
-- POLLOUT|POLLHUP with no error). (outcome, error).
func net_ended(n, fd, ready):
    let got = linux_get_option(fd, linux_sol_socket(), linux_so_error(), n.option)
    if linux_error(got): return (4, 0 - got) end
    let e = linux_u32(n.option, 0)
    if e == 104 or e == 32: return (0, e) end
    if e != 0: return (net_classify(e), e) end
    if (ready & 4) != 0 and (ready & 16) == 0: return (0, 0) end
    return (4, 107)
end

-- The connection started on fd is under way: wait for it to end, until limit
-- milliseconds after started (microseconds). Every pass polls: for the time
-- left, rounded up to a whole millisecond, or, once the limit has passed, for
-- none; so "no answer" is said only after a poll at or past the limit that
-- could have seen an answer and did not. EINTR, or a poll that comes back
-- before the limit, polls again for what is left. (outcome, error).
func net_wait(n, fd, started, limit):
    let deadline = started + limit * 1000
    while true:
        let now = net_clock(n)
        if linux_error(now): return (4, 0 - now) end
        let wait = 0
        if now < deadline: wait = (deadline - now + 999) / 1000 end
        let ready = linux_poll(fd, n.poll, 4, wait)
        if ready != 0 and ready != 0 - 4:
            if linux_error(ready): return (4, 0 - ready) end
            return net_ended(n, fd, ready)
        end
        if ready == 0 and wait == 0: return (2, 0) end
    end
    return (4, 0)
end

-- connect on a non-blocking socket either ends at once (loopback can accept or
-- refuse in the call; a missing route fails in it) or is under way (EINPROGRESS).
func net_attempt(n, fd, started, limit):
    let connected = linux_connect(fd, n.address, 16)
    if connected == 0: return (0, 0) end
    if connected != 0 - 115: return (net_classify(0 - connected), 0 - connected) end
    return net_wait(n, fd, started, limit)
end

-- What a knock accepts: a 32-bit address, a port 1 to 65535 and a limit of 1
-- to 60000 ms.
func net_range(address, port, limit):
    return address <= 4294967295 and port != 0 and port <= 65535 and limit != 0 and limit <= 60000
end

-- A 32-bit address in the dotted form net_ipv4 reads, into b at at: the
-- offset after it.
func net_put_address(b, at, address):
    at = text_put(b, text_put_whole(b, at, address >> 24), ".")
    at = text_put(b, text_put_whole(b, at, (address >> 16) & 255), ".")
    at = text_put(b, text_put_whole(b, at, (address >> 8) & 255), ".")
    return text_put_whole(b, at, address & 255)
end

-- The 16-byte sockaddr_in for a 32-bit address and a port, into b.
func net_sockaddr(b, address, port):
    do buffer_set(b, 0, 2)
    do buffer_set(b, 1, 0)
    do buffer_set(b, 2, port >> 8)
    do buffer_set(b, 3, port & 255)
    do buffer_set(b, 4, address >> 24)
    do buffer_set(b, 5, (address >> 16) & 255)
    do buffer_set(b, 6, (address >> 8) & 255)
    do buffer_set(b, 7, address & 255)
    do linux_put64(b, 8, 0)
    return 0
end

-- Fills n.address with the sockaddr_in for address and port, then makes the
-- knock's socket, SOCK_STREAM|SOCK_NONBLOCK|SOCK_CLOEXEC: its descriptor, or
-- raw -errno.
func net_socket(n, address, port):
    do net_sockaddr(n.address, address, port)
    return linux_socket(linux_af_inet(), linux_sock_stream() | linux_sock_nonblock() | linux_sock_cloexec(), linux_ipproto_tcp())
end

-- A knock begins: nothing found yet, nothing read.
func net_reset(st, reading):
    st.outcome = 4
    st.error = 0
    st.elapsed = 0
    st.reading = reading
    st.events = 4
    st.got = 0
    st.closed = false
    return 0
end

-- Knock once on address (a 32-bit IPv4 address, as net_ipv4 gives it) at TCP
-- port, waiting at most limit milliseconds (1 to 60000). Returns the outcome
-- and leaves outcome, error and elapsed in n.state. A port, address or limit
-- out of range is an error, 22 (EINVAL), before any socket is made. The socket
-- is SOCK_NONBLOCK|SOCK_CLOEXEC and is closed before the knock returns,
-- whatever happened; close's own result cannot change what was found (Linux
-- frees the descriptor either way), so it is not looked at. A knock begun by
-- net_start and still pending on n is given up first (net_stop).
func net_knock(n, address, port, limit):
    do net_stop(n)
    let st = n.state
    do net_reset(st, false)
    let started = net_clock(n)
    if linux_error(started):
        st.error = 0 - started
        return 4
    end
    if not net_range(address, port, limit):
        st.error = 22
        return 4
    end
    let fd = net_socket(n, address, port)
    if linux_error(fd):
        st.error = 0 - fd
        st.elapsed = net_since(n, started)
        return 4
    end
    let found = net_attempt(n, fd, started, limit)
    do linux_close(fd)
    st.outcome = found.0
    st.error = found.1
    st.elapsed = net_since(n, started)
    return st.outcome
end

-- Ends the knock under way on n: closes its socket and keeps outcome and error
-- as what it found. Returns the outcome.
func net_finish(n, outcome, error):
    let st = n.state
    do linux_close(st.fd)
    st.pending = false
    st.outcome = outcome
    st.error = error
    st.elapsed = net_since(n, st.started)
    return outcome
end

-- Gives up the knock under way on n, if there is one: its socket is closed and
-- the state keeps no outcome (error, with error 0). Nothing happens otherwise.
func net_stop(n):
    let st = n.state
    if not st.pending: return 0 end
    do net_finish(n, 4, 0)
    return 0
end

-- Begins a knock as net_knock does, with the same rules, but does not wait.
-- Returns the outcome when the knock ended at once (connect can accept or
-- refuse on this computer, a missing route fails in it, and a range or socket
-- error comes before it), or 5 while it is under way (n.state.pending). Then
-- call net_check now and then, until it gives an outcome: at the latest
-- net_left(n) ms later, and sooner when n.state.fd polls ready for
-- n.state.events. A knock still under way on n is given up first (net_stop).
func net_start(n, address, port, limit):
    return net_begin(n, address, port, limit, false)
end

-- Begins a knock as net_start does, and once the computer takes the connection
-- (outcome answered, no error) keeps it open and reads what the computer sends
-- into n.reply, without waiting, until the computer closes the connection,
-- 256 bytes have come, the connection fails, or the time limit passes,
-- whichever comes first: the knock ends there, answered, with n.state.got
-- bytes in n.reply and n.state.closed true only if the computer closed it.
-- It never sends a byte. The time limit covers the whole knock, connecting
-- and reading. Look at it with net_check as at any knock begun by net_start.
func net_start_reading(n, address, port, limit):
    return net_begin(n, address, port, limit, true)
end

func net_begin(n, address, port, limit, reading):
    do net_stop(n)
    let st = n.state
    do net_reset(st, reading)
    let started = net_clock(n)
    if linux_error(started):
        st.error = 0 - started
        return 4
    end
    if not net_range(address, port, limit):
        st.error = 22
        return 4
    end
    let fd = net_socket(n, address, port)
    if linux_error(fd):
        st.error = 0 - fd
        st.elapsed = net_since(n, started)
        return 4
    end
    st.pending = true
    st.fd = fd
    st.started = started
    st.limit = limit
    let connected = linux_connect(fd, n.address, 16)
    if connected == 0: return net_connected(n, 0, 0) end
    if connected != 0 - 115: return net_finish(n, net_classify(0 - connected), 0 - connected) end
    return 5
end

-- The connection attempt of the knock under way on n has ended with outcome
-- and error. A reading knock that was answered with no error goes on to read
-- (one look now, since the reply may be there already); any other knock ends.
func net_connected(n, outcome, error):
    let st = n.state
    if st.reading and outcome == 0 and error == 0:
        st.events = 1
        return net_read(n)
    end
    return net_finish(n, outcome, error)
end

-- One look at what has come on the reading knock's connection, waiting for
-- nothing: recvfrom with MSG_DONTWAIT into the rest of n.reply, again until
-- nothing more is there. The knock ends, answered, when the computer has
-- closed the connection (closed), when n.reply is full, when the connection
-- has failed (error says how), or when nothing more is there and the clock,
-- read just before the recvfrom that found nothing, is at or past the time
-- limit; otherwise it returns 5, still under way. EINTR looks again.
func net_read(n):
    let st = n.state
    let deadline = st.started + st.limit * 1000
    while true:
        let now = net_clock(n)
        if linux_error(now): return net_finish(n, 0, 0 - now) end
        let want = buffer_length(n.reply) - st.got
        if want == 0: return net_finish(n, 0, 0) end
        let r = linux_receive(st.fd, n.reply, st.got, want, linux_msg_dontwait())
        if r == 0:
            st.closed = true
            return net_finish(n, 0, 0)
        elif r == 0 - 11:
            if now >= deadline: return net_finish(n, 0, 0) end
            return 5
        elif r != 0 - 4:
            if linux_error(r): return net_finish(n, 0, 0 - r) end
            if r > want: return net_finish(n, 0, 0) end
            st.got = st.got + r
        end
    end
    return 5
end

-- One look at the knock under way on fd, waiting for nothing: (ended, outcome,
-- error). The clock is read before each poll, so "no answer" is said only when
-- a poll that began at or after deadline (microseconds) found nothing. EINTR
-- looks again.
func net_look(n, fd, deadline):
    while true:
        let now = net_clock(n)
        if linux_error(now): return (true, 4, 0 - now) end
        let ready = linux_poll(fd, n.poll, 4, 0)
        if ready != 0 - 4:
            if ready != 0:
                if linux_error(ready): return (true, 4, 0 - ready) end
                let ended = net_ended(n, fd, ready)
                return (true, ended.0, ended.1)
            end
            if now >= deadline: return (true, 2, 0) end
            return (false, 4, 0)
        end
    end
    return (true, 4, 0)
end

-- Looks at the knock begun by net_start or net_start_reading without waiting:
-- its outcome once it has ended (the socket then closed, and outcome, error
-- and elapsed in n.state, and for a reading knock got and closed), or 5 while
-- it is still under way. With no knock under way it returns the last outcome.
func net_check(n):
    let st = n.state
    if not st.pending: return st.outcome end
    if st.events == 1: return net_read(n) end
    let look = net_look(n, st.fd, st.started + st.limit * 1000)
    if not look.0: return 5 end
    return net_connected(n, look.1, look.2)
end

-- Whole milliseconds, rounded up, until the time limit of the knock under way
-- on n; 0 once it has passed, or when no knock is under way. A caller that
-- waits that long and then calls net_check never misses the limit.
func net_left(n):
    let st = n.state
    if not st.pending: return 0 end
    let now = net_clock(n)
    let deadline = st.started + st.limit * 1000
    if linux_error(now) or now >= deadline: return 0 end
    return (deadline - now + 999) / 1000
end

func net_outcome_name(outcome):
    if outcome == 0: return "answered" end
    if outcome == 1: return "refused" end
    if outcome == 2: return "no answer" end
    if outcome == 3: return "unreachable" end
    return "error"
end

-- Plain words for the Linux errors a knock can meet; "" for any other.
func net_error_name(e):
    if e == 101: return "network is unreachable" end
    if e == 113: return "no route to host" end
    if e == 100: return "network is down" end
    if e == 112: return "host is down" end
    if e == 111: return "connection refused" end
    if e == 32: return "broken pipe" end
    if e == 110: return "timed out" end
    if e == 13: return "permission denied" end
    if e == 1: return "operation not permitted" end
    if e == 22: return "invalid argument" end
    if e == 99: return "address not available" end
    if e == 104: return "connection reset" end
    if e == 107: return "not connected" end
    if e == 24: return "too many open files" end
    if e == 23: return "too many open files in the system" end
    if e == 105: return "no buffer space" end
    if e == 12: return "out of memory" end
    return ""
end
