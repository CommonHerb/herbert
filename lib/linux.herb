-- Herbert-owned Linux/x86-64 helpers, using the kernel syscall ABI directly.
-- This file has no main and is concatenated before its consumer. No libc.
-- Integer syscall results retain Linux's raw two's-complement -errno values.
-- Constants/layouts: Linux x86-64 UAPI; pollfd=8, timespec=16, utsname=390.
-- https://man7.org/linux/man-pages/man2/send.2.html
-- https://man7.org/linux/man-pages/man2/recv.2.html
-- https://man7.org/linux/man-pages/man2/poll.2.html
-- https://man7.org/linux/man-pages/man5/proc_pid_environ.5.html

func linux_error(r):
    return r >= 0 - 4095
end

-- The caller includes any desired newline; messages must never contain secrets.
func linux_die(message):
    do stderr_write(message)
    do process_exit(1)
    return 0
end

-- Startup allocation only: one block of exactly size zero bytes (buffer_fill,
-- not a byte at a time). Its size never changes unless the caller appends.
-- Take buffer_address only after the last append; growth can relocate storage.
func linux_buffer(size):
    let b = new_buffer()
    do buffer_fill(b, size, 0)
    return b
end

func linux_range(b, offset, size):
    if offset > buffer_length(b):
        return false
    end
    return size <= buffer_length(b) - offset
end

func linux_require_range(b, offset, size):
    if linux_range(b, offset, size):
        return 0
    end
    return linux_die("linux: byte-buffer range is outside its allocation\n")
end

func linux_u16(b, o):
    do linux_require_range(b, o, 2)
    return buffer_get(b, o) | (buffer_get(b, o + 1) << 8)
end

func linux_u32(b, o):
    do linux_require_range(b, o, 4)
    return linux_u16(b, o) | (linux_u16(b, o + 2) << 16)
end

func linux_u64(b, o):
    do linux_require_range(b, o, 8)
    return linux_u32(b, o) | (linux_u32(b, o + 4) << 32)
end

-- Field stores keep the low 16/32/64 bits, in little-endian byte order.
func linux_put16(b, o, v):
    do linux_require_range(b, o, 2)
    do buffer_set(b, o, v & 255)
    do buffer_set(b, o + 1, (v >> 8) & 255)
    return 0
end

func linux_put32(b, o, v):
    do linux_require_range(b, o, 4)
    do linux_put16(b, o, v)
    do linux_put16(b, o + 2, v >> 16)
    return 0
end

func linux_put64(b, o, v):
    do linux_require_range(b, o, 8)
    do linux_put32(b, o, v)
    do linux_put32(b, o + 4, v >> 32)
    return 0
end

-- Byte copy between spans, overlap-safe in either direction (buffer_copy moves
-- backward when the destination lies inside the source above it). The range
-- checks in front keep this function's own message for a bad span.
func linux_copy(dst, offset, src, from, n):
    do linux_require_range(dst, offset, n)
    do linux_require_range(src, from, n)
    do buffer_copy(dst, offset, src, from, n)
    return 0
end

func linux_text(dst, offset, s):
    do linux_require_range(dst, offset, length(s))
    let i = 0
    while i < length(s):
        do buffer_set(dst, offset + i, index(s, i))
        i = i + 1
    end
    return 0
end

func linux_cstring(s):
    let b = linux_buffer(length(s) + 1)
    do linux_text(b, 0, s)
    return b
end

-- Scratch buffer must have at least 16 bytes. Error is a raw -errno value.
func linux_clock_ms(clockbuf):
    do linux_require_range(clockbuf, 0, 16)
    let result = linux_syscall6(228, 1, buffer_address(clockbuf), 0, 0, 0, 0)
    if linux_error(result):
        return result
    end
    return linux_u64(clockbuf, 0) * 1000 + linux_u64(clockbuf, 8) / 1000000
end

-- Scratch buffer must have at least 8 bytes. Returns revents, zero on timeout,
-- or raw -errno. EINTR is returned to the caller, which owns its deadline.
func linux_poll(fd, pollbuf, events, timeout):
    do linux_require_range(pollbuf, 0, 8)
    do linux_put32(pollbuf, 0, fd)
    do linux_put16(pollbuf, 4, events)
    do linux_put16(pollbuf, 6, 0)
    let result = linux_syscall6(7, buffer_address(pollbuf), 1, timeout, 0, 0, 0)
    if linux_error(result):
        return result
    elif result == 0:
        return 0
    end
    return linux_u16(pollbuf, 6)
end

-- Waiting on several descriptors at once. linux_poll_entry writes pollfd entry
-- i of pollbuf (fd, events, revents cleared) and returns i + 1, the count so
-- far; linux_poll_many waits on the first count entries for at most timeout
-- ms and returns how many are ready, zero on timeout, or raw -errno. EINTR is
-- returned to the caller, which owns its deadline. No allocation.
func linux_poll_entry(pollbuf, i, fd, events):
    do linux_require_range(pollbuf, i * 8, 8)
    do linux_put32(pollbuf, i * 8, fd)
    do linux_put16(pollbuf, i * 8 + 4, events)
    do linux_put16(pollbuf, i * 8 + 6, 0)
    return i + 1
end

func linux_poll_many(pollbuf, count, timeout):
    do linux_require_range(pollbuf, 0, count * 8)
    return linux_syscall6(7, buffer_address(pollbuf), count, timeout, 0, 0, 0)
end

-- Shared exact socket transfer: every retry, including partial progress and
-- EINTR, shares one five-second monotonic deadline. No heap allocation here.
-- Send uses MSG_NOSIGNAL|MSG_DONTWAIT; receive uses MSG_DONTWAIT.
func linux_transfer(fd, b, offset, remaining, pollbuf, clockbuf, started, sending):
    while remaining != 0:
        let now = linux_clock_ms(clockbuf)
        if linux_error(now):
            return now
        elif now - started >= 5000:
            return 0 - 110
        end
        let number = 45
        let flags = 64
        let events = 1
        if sending:
            number = 44
            flags = 16448
            events = 4
        end
        let result = linux_syscall6(number, fd, buffer_address(b) + offset, remaining, flags, 0, 0)
        if result == 0 - 11:
            let waited = linux_poll(fd, pollbuf, events, 5000 - (now - started))
            if linux_error(waited) and waited != 0 - 4:
                return waited
            elif waited != 0 - 4 and (waited & 32) != 0:
                return 0 - 9
            end
        elif result != 0 - 4:
            if linux_error(result):
                return result
            elif result == 0:
                return 0 - 104
            end
            offset = offset + result
            remaining = remaining - result
        end
    end
    return 0
end

-- Connected stream sockets only. Zero means ALL requested bytes transferred;
-- failure may follow partial progress, so callers must abandon the transaction.
-- EOF before completion maps to -ECONNRESET (104), timeout to -ETIMEDOUT (110).
func linux_send_all(fd, b, offset, count, pollbuf, clockbuf):
    if not linux_range(b, offset, count):
        return 0 - 22
    end
    let started = linux_clock_ms(clockbuf)
    if linux_error(started):
        return started
    end
    return linux_transfer(fd, b, offset, count, pollbuf, clockbuf, started, true)
end

func linux_read_exact(fd, b, offset, count, pollbuf, clockbuf):
    if not linux_range(b, offset, count):
        return 0 - 22
    end
    let started = linux_clock_ms(clockbuf)
    if linux_error(started):
        return started
    end
    return linux_transfer(fd, b, offset, count, pollbuf, clockbuf, started, false)
end

func linux_read_file_loop(fd, b, used, cap):
    while true:
        let result = linux_syscall6(0, fd, buffer_address(b) + used, cap + 1 - used, 0, 0, 0)
        if result != 0 - 4:
            if linux_error(result):
                return (result, used)
            elif result == 0:
                return (0, used)
            elif used + result > cap:
                return (0 - 27, used + result)
            end
            used = used + result
        end
    end
    return (0, 0)
end

-- Startup whole-file reader for regular files and /proc/self/environ.
-- Returns (status, fixed buffer of cap+1 bytes, actual bytes read). The spare
-- byte probes EOF at exact capacity; oversize is -EFBIG (27), never truncation.
-- Errors preserve count for diagnosis, but content is usable only on status 0.
-- This bounds memory, not blocking duration; do not use it for sockets/FIFOs.
func linux_read_file(path, cap):
    if cap >= 0 - 4095:
        return (0 - 22, new_buffer(), 0)
    end
    let b = linux_buffer(cap + 1)
    let pathname = linux_cstring(path)
    let fd = linux_syscall6(2, buffer_address(pathname), 524288, 0, 0, 0, 0)
    if linux_error(fd):
        return (fd, b, 0)
    end
    let incoming = linux_read_file_loop(fd, b, 0, cap)
    let closed = linux_syscall6(3, fd, 0, 0, 0, 0, 0)
    if incoming.0 != 0:
        return (incoming.0, b, incoming.1)
    elif linux_error(closed):
        return (closed, b, incoming.1)
    end
    return (0, b, incoming.1)
end

-- Read the exec-time environment once. Never print these potentially secret
-- bytes. Remaining zero-filled capacity terminates lookup after the last entry.
func linux_environment():
    let incoming = linux_read_file("/proc/self/environ", 1048576)
    if incoming.0 != 0:
        do linux_die("linux: cannot read the process environment\n")
    end
    return incoming.1
end

func linux_nul_end(b, from, limit):
    while from < limit:
        if buffer_get(b, from) == 0: return from end
        from = from + 1
    end
    return limit
end

func linux_name_matches(b, offset, limit, name, i):
    while i < length(name):
        if offset + i >= limit: return false end
        if buffer_get(b, offset + i) != index(name, i): return false end
        i = i + 1
    end
    return offset + i < limit and buffer_get(b, offset + i) == 61
end

func linux_string_loop(b, from, limit, out):
    while from < limit:
        do append(out, buffer_get(b, from))
        from = from + 1
    end
    return freeze(out)
end

-- Startup lookup only; absent and empty values both return the empty string.
-- Scans without allocation, then copies only the first matching value.
func linux_env(env, name):
    let offset = 0
    while offset < buffer_length(env):
        if buffer_get(env, offset) == 0: return "" end
        let limit = linux_nul_end(env, offset, buffer_length(env))
        if linux_name_matches(env, offset, limit, name, 0):
            return linux_string_loop(env, offset + length(name) + 1, limit, new_buffer())
        end
        offset = limit + 1
    end
    return ""
end

func linux_hostname():
    let b = linux_buffer(390)
    let result = linux_syscall6(63, buffer_address(b), 0, 0, 0, 0, 0)
    if linux_error(result):
        do linux_die("linux: cannot read the host name\n")
    end
    return linux_string_loop(b, 65, linux_nul_end(b, 65, 130), new_buffer())
end

-- Startup-only argument access. Linux exposes NUL-separated argv in procfs.
-- Read once and reuse; returned strings are allocated only for requested args.
func linux_arguments():
    let incoming = linux_read_file("/proc/self/cmdline", 65536)
    if incoming.0 != 0:
        do linux_die("linux: cannot read program arguments\n")
    end
    return (incoming.1, incoming.2)
end

func linux_argument(args, wanted):
    let current = 0
    let offset = 0
    while offset < args.1:
        let limit = linux_nul_end(args.0, offset, args.1)
        if wanted == current: return linux_string_loop(args.0, offset, limit, new_buffer()) end
        current = current + 1
        offset = limit + 1
    end
    return ""
end

-- Write unsigned decimal into caller-owned storage; return the next offset.
func linux_decimal(b, offset, n):
    let at = offset
    if n >= 10: at = linux_decimal(b, offset, n / 10) end
    do linux_require_range(b, at, 1)
    do buffer_set(b, at, 48 + n % 10)
    return at + 1
end

-- How many arguments args (as linux_arguments gives it) holds, the program's
-- own name included: 1 when it was given none. linux_argument(args, k) is ""
-- both past the last argument and for an empty one; this tells them apart.
func linux_argument_count(args):
    let total = 0
    let offset = 0
    while offset < args.1:
        offset = linux_nul_end(args.0, offset, args.1) + 1
        total = total + 1
    end
    return total
end

-- Microseconds on the monotonic clock, through clockbuf (at least 16 bytes),
-- or raw -errno: linux_clock_ms finer.
func linux_clock_us(clockbuf):
    do linux_require_range(clockbuf, 0, 16)
    let result = linux_syscall6(228, 1, buffer_address(clockbuf), 0, 0, 0, 0)
    if linux_error(result): return result end
    return linux_u64(clockbuf, 0) * 1000000 + linux_u64(clockbuf, 8) / 1000
end

-- Linux's numbers by name. Flags (x86-64 UAPI): open's (O_RDONLY is 0, so a
-- file opened to read needs only these), socket's, send and receive's, the
-- socket options used here, and the file-type bits of a stat's st_mode.
func linux_o_nonblock(): return 2048 end
func linux_o_cloexec(): return 524288 end
func linux_af_inet(): return 2 end
func linux_sock_stream(): return 1 end
func linux_sock_nonblock(): return 2048 end
func linux_sock_cloexec(): return 524288 end
func linux_ipproto_tcp(): return 6 end
func linux_sol_socket(): return 1 end
func linux_so_reuseaddr(): return 2 end
func linux_so_error(): return 4 end
func linux_msg_dontwait(): return 64 end
func linux_msg_nosignal(): return 16384 end
func linux_s_ifmt(): return 61440 end
func linux_s_ifreg(): return 32768 end

-- The system calls, one each, by name (x86-64 numbers from the kernel's
-- syscall_64.tbl), their arguments in the order of their man pages and passed
-- through unchanged. Each returns what Linux returns: a count or descriptor,
-- or raw -errno (test it with linux_error). A buffer span given to Linux is
-- checked first, as linux_poll does; a path is a NUL-terminated buffer (see
-- linux_cstring). EINTR is returned to the caller. None allocates.
-- https://man7.org/linux/man-pages/man2/syscalls.2.html

-- open(2): a descriptor for path.
func linux_open(path, flags, mode):
    do linux_require_range(path, 0, 1)
    return linux_syscall6(2, buffer_address(path), flags, mode, 0, 0, 0)
end

-- read(2): up to count bytes from fd into b at at; the count read, 0 at the end.
func linux_read(fd, b, at, count):
    do linux_require_range(b, at, count)
    return linux_syscall6(0, fd, buffer_address(b) + at, count, 0, 0, 0)
end

-- write(2): up to count bytes of b from at to fd; the count written.
func linux_write(fd, b, at, count):
    do linux_require_range(b, at, count)
    return linux_syscall6(1, fd, buffer_address(b) + at, count, 0, 0, 0)
end

-- close(2). Linux frees the descriptor even when it reports an error.
func linux_close(fd): return linux_syscall6(3, fd, 0, 0, 0, 0, 0) end

-- fstat(2): fd's struct stat (144 bytes) into answer; st_mode is the 32-bit
-- field at 24.
func linux_fstat(fd, answer):
    do linux_require_range(answer, 0, 144)
    return linux_syscall6(5, fd, buffer_address(answer), 0, 0, 0, 0)
end

-- statfs(2): the struct statfs (120 bytes) of the file system holding path,
-- into answer.
func linux_statfs(path, answer):
    do linux_require_range(path, 0, 1)
    do linux_require_range(answer, 0, 120)
    return linux_syscall6(137, buffer_address(path), buffer_address(answer), 0, 0, 0, 0)
end

-- socket(2): a descriptor; kind is the type, with linux_sock_nonblock() and
-- linux_sock_cloexec() or-ed in as wanted.
func linux_socket(domain, kind, protocol): return linux_syscall6(41, domain, kind, protocol, 0, 0, 0) end

-- connect(2) and bind(2) to the first size bytes of address (a sockaddr_in is
-- 16; net_sockaddr fills one).
func linux_connect(fd, address, size):
    do linux_require_range(address, 0, size)
    return linux_syscall6(42, fd, buffer_address(address), size, 0, 0, 0)
end

func linux_bind(fd, address, size):
    do linux_require_range(address, 0, size)
    return linux_syscall6(49, fd, buffer_address(address), size, 0, 0, 0)
end

-- listen(2), with a queue of backlog.
func linux_listen(fd, backlog): return linux_syscall6(50, fd, backlog, 0, 0, 0, 0) end

-- accept4(2): a descriptor for the next connection, its address into address
-- and that address's length into size (4 bytes), which the caller first sets
-- to the room in address (linux_put32(size, 0, 16)).
func linux_accept(fd, address, size, flags):
    do linux_require_range(size, 0, 4)
    do linux_require_range(address, 0, linux_u32(size, 0))
    return linux_syscall6(288, fd, buffer_address(address), buffer_address(size), flags, 0, 0)
end

-- send and receive on a connected socket, sendto(2) and recvfrom(2) with no
-- address: count bytes of b from at, with flags (linux_msg_dontwait(),
-- linux_msg_nosignal()). The count sent or received; 0 received at the end.
func linux_send(fd, b, at, count, flags):
    do linux_require_range(b, at, count)
    return linux_syscall6(44, fd, buffer_address(b) + at, count, flags, 0, 0)
end

func linux_receive(fd, b, at, count, flags):
    do linux_require_range(b, at, count)
    return linux_syscall6(45, fd, buffer_address(b) + at, count, flags, 0, 0)
end

-- setsockopt(2) of a 32-bit option: value is put into the first 4 bytes of b,
-- which is passed as the option.
func linux_set_option(fd, level, name, b, value):
    do linux_put32(b, 0, value)
    return linux_syscall6(54, fd, level, name, buffer_address(b), 4, 0)
end

-- getsockopt(2) of a 32-bit option, through b (8 bytes): the option's room
-- (zeroed first) at 0 and its length (set to 4 first) at 4. Then the value is
-- linux_u32(b, 0).
func linux_get_option(fd, level, name, b):
    do linux_put32(b, 0, 0)
    do linux_put32(b, 4, 4)
    return linux_syscall6(55, fd, level, name, buffer_address(b), buffer_address(b) + 4, 0)
end

-- nanosleep(2) for the struct timespec in timespec (16 bytes: seconds, then
-- nanoseconds); 0, or raw -errno (EINTR when a signal ends it early).
func linux_sleep(timespec):
    do linux_require_range(timespec, 0, 16)
    return linux_syscall6(35, buffer_address(timespec), 0, 0, 0, 0, 0)
end
