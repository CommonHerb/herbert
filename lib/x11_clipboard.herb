-- The desktop clipboard for an X11 window from lib/x11.herb: take CLIPBOARD
-- and answer other applications' requests for its text, and ask the current
-- owner for text. Requires lib/linux.herb and lib/x11.herb. Opt in with
-- x11_enable_clipboard at startup; call x11_serve after each x11_events.
-- Text is offered as UTF8_STRING and text/plain;charset=utf-8, with TARGETS and
-- TIMESTAMP; incremental (INCR) transfers are refused in both directions, which
-- bounds a paste to the 65,504 bytes one reply buffer holds. All storage is
-- allocated by x11_enable_clipboard; nothing allocates while serving or pasting.

-- Startup only, after x11_open and before the event loop, like x11_enable_text.
-- capacity bounds the text this window can offer on the clipboard.
func x11_enable_clipboard(c, capacity):
    let st = c.state
    -- Pastes take turns over eight properties (x11_clip_request).
    let properties = linux_buffer(32)
    do linux_put32(properties, 0, x11_intern(c, "HERBERT_CLIPBOARD_0"))
    do linux_put32(properties, 4, x11_intern(c, "HERBERT_CLIPBOARD_1"))
    do linux_put32(properties, 8, x11_intern(c, "HERBERT_CLIPBOARD_2"))
    do linux_put32(properties, 12, x11_intern(c, "HERBERT_CLIPBOARD_3"))
    do linux_put32(properties, 16, x11_intern(c, "HERBERT_CLIPBOARD_4"))
    do linux_put32(properties, 20, x11_intern(c, "HERBERT_CLIPBOARD_5"))
    do linux_put32(properties, 24, x11_intern(c, "HERBERT_CLIPBOARD_6"))
    do linux_put32(properties, 28, x11_intern(c, "HERBERT_CLIPBOARD_7"))
    st.clip = X11Clip(true, false, 0, x11_intern(c, "CLIPBOARD"), x11_intern(c, "TARGETS"), x11_intern(c, "UTF8_STRING"), x11_intern(c, "text/plain;charset=utf-8"), x11_intern(c, "TIMESTAMP"), linux_u32(properties, 0), x11_intern(c, "INCR"), linux_buffer(capacity), 0, linux_buffer(256), 0, false, 0, false, 0, 0, 0, 0, 0, 0, properties, 0, 0, false)
    -- Counting starts at the last InternAtom, whose reply was the last message read.
    let cb = st.clip
    cb.sent = st.sequence
    cb.read = st.sequence
    cb.synced = st.sequence
    return 0
end

func x11_change_property(c, window, property, kind, format, mode, units):
    let p = x11_request(c, 18, mode, 24 + x11_pad(units * (format / 8)))
    do linux_put32(c.requests, p + 4, window)
    do linux_put32(c.requests, p + 8, property)
    do linux_put32(c.requests, p + 12, kind)
    do buffer_set(c.requests, p + 16, format)
    do linux_put32(c.requests, p + 20, units)
    return p + 24
end

-- Text goes out in 32 KiB pieces, the first replacing the property and the rest
-- appending, so each request fits the fixed request buffer.
func x11_put_text(c, cb, window, property, kind, offset, mode):
    while true:
        let n = cb.count - offset
        if n > 32768: n = 32768 end
        let q = x11_change_property(c, window, property, kind, 8, mode, n)
        do linux_copy(c.requests, q, cb.data, offset, n)
        if offset + n >= cb.count: return 0 end
        offset = offset + n
        mode = 2
    end
    return 0
end

func x11_notify(c, requestor, selection, target, property, time):
    let p = x11_request(c, 25, 0, 44)
    do linux_put32(c.requests, p + 4, requestor)
    do buffer_set(c.requests, p + 12, 31)
    do linux_put32(c.requests, p + 16, time)
    do linux_put32(c.requests, p + 20, requestor)
    do linux_put32(c.requests, p + 24, selection)
    do linux_put32(c.requests, p + 28, target)
    return linux_put32(c.requests, p + 32, property)
end

-- Answer one queued request: the formats offered, the ownership time, or the
-- text as UTF8_STRING or text/plain;charset=utf-8. Anything else is refused.
func x11_serve_one(c, cb, at):
    let p = cb.pending
    let requestor = linux_u32(p, at + 12)
    let selection = linux_u32(p, at + 16)
    let target = linux_u32(p, at + 20)
    let property = linux_u32(p, at + 24)
    if property == 0: property = target end
    let answer = 0
    if cb.owned and selection == cb.clipboard:
        if target == cb.targets:
            let q = x11_change_property(c, requestor, property, 4, 32, 0, 4)
            do linux_put32(c.requests, q, cb.targets)
            do linux_put32(c.requests, q + 4, cb.timestamp)
            do linux_put32(c.requests, q + 8, cb.utf8)
            do linux_put32(c.requests, q + 12, cb.mime)
            answer = property
        elif target == cb.timestamp:
            let q = x11_change_property(c, requestor, property, 19, 32, 0, 1)
            do linux_put32(c.requests, q, cb.time)
            answer = property
        elif target == cb.utf8 or target == cb.mime:
            do x11_put_text(c, cb, requestor, property, target, 0, 0)
            answer = property
        end
    end
    return x11_notify(c, requestor, selection, target, answer, linux_u32(p, at + 4))
end

func x11_serve(c):
    let st = c.state
    let cb = st.clip
    if not cb.on or cb.pending_count == 0: return 0 end
    let from = cb.sent + 1
    let i = 0
    while i != cb.pending_count:
        do x11_serve_one(c, cb, i * 32)
        i = i + 1
    end
    cb.pending_count = 0
    -- One range, extended forward while the server has not passed it, so the
    -- errors of an earlier answer stay ignored when a later one follows first.
    if not cb.tolerant: cb.tolerant_from = from end
    cb.tolerant_to = cb.sent
    cb.tolerant = true
    return x11_flush(c)
end

-- Take the clipboard with count bytes of src from offset from. time is the
-- server time of the user's copy command (ICCCM rules out CurrentTime). Nothing
-- waits for the server here; x11_clip_owned asks whether the claim held.
func x11_clip_own(c, src, from, count, time):
    let st = c.state
    let cb = st.clip
    do linux_copy(cb.data, 0, src, from, count)
    cb.count = count
    cb.time = time
    cb.owned = true
    -- An owner question still unanswered was asked before this claim.
    cb.heed = false
    let p = x11_request(c, 22, 0, 16)
    do linux_put32(c.requests, p + 4, st.window)
    do linux_put32(c.requests, p + 8, cb.clipboard)
    do linux_put32(c.requests, p + 12, time)
    return x11_flush(c)
end

-- Whether this window owns CLIPBOARD, for a paste. The server silently ignores a
-- claim older than the clipboard's last change, as when another application took
-- it a moment later, so while this window believes it holds the clipboard this
-- asks the server (GetSelectionOwner, ICCCM 2.1); the answer, read by the event
-- loop (x11_loop_reply), keeps the belief only if the server names this window,
-- and otherwise this window stops answering for it. True only once the server has
-- named this window. The answer comes after any input already waiting; if the key
-- queue fills first (256), or two seconds pass, this gives up and returns false.
-- Whether this window owns the clipboard is then unknown, so owned is left as it
-- was (requests are still answered from it) until the answer, read later, settles
-- it, unless a claim was made since. The paste then asks the owner like any paste;
-- if that is this window, it answers its own request once the paste stops waiting.
func x11_clip_owned(c):
    let st = c.state
    let cb = st.clip
    let asked = false
    let start = linux_clock_ms(c.clock)
    do x11_need(not linux_error(start), "desktop: monotonic clock failed\n")
    while true:
        if cb.asking == 0:
            if asked or not cb.owned: return cb.owned end
            let p = x11_request(c, 23, 0, 8)
            do linux_put32(c.requests, p + 4, cb.clipboard)
            cb.asking = st.sequence + 1
            cb.heed = true
            asked = true
            do x11_flush(c)
        end
        do x11_events_loop(c, 512)
        if cb.asking != 0:
            if st.queue_count >= 256: return false end
            let now = linux_clock_ms(c.clock)
            do x11_need(not linux_error(now), "desktop: monotonic clock failed\n")
            if now - start >= 2000: return false end
            do linux_poll(st.fd, c.poll, 1, 2000 - (now - start))
        end
    end
    return false
end

func x11_clip_data(c): return c.state.clip.data end
func x11_clip_count(c): return c.state.clip.count end

-- Finish an event whose first bytes the nonblocking drain already read, so a
-- synchronous reply can use the reply buffer from its start.
func x11_settle(c):
    let st = c.state
    let have = st.partial
    if have == 0: return 0 end
    let got = linux_read_exact(st.fd, c.replies, have, 32 - have, c.poll, c.clock)
    do x11_need(got == 0, "desktop: incomplete X11 event\n")
    st.partial = 0
    if buffer_get(c.replies, 0) == 1: return x11_keyboard_reply(c) end
    return x11_dispatch(c)
end

-- A reply while the event loop runs: events are dispatched and a pending
-- keyboard-map reply is completed on the way, unlike startup's x11_reply.
func x11_reply_runtime(c, sequence):
    let st = c.state
    while true:
        let got = linux_read_exact(st.fd, c.replies, 0, 32, c.poll, c.clock)
        do x11_need(got == 0, "desktop: incomplete X11 reply\n")
        if buffer_get(c.replies, 0) != 1:
            do x11_dispatch(c)
        elif st.reply_pending != 0 and linux_u16(c.replies, 2) == st.reply_pending - 1:
            do x11_keyboard_reply(c)
        else:
            do x11_need(linux_u16(c.replies, 2) == sequence, "desktop: X11 reply sequence mismatch\n")
            do x11_seen(c, sequence)
            let extra = linux_u32(c.replies, 4) * 4
            do x11_need(extra <= buffer_length(c.replies) - 32, "desktop: X11 reply exceeds fixed buffer\n")
            let rest = linux_read_exact(st.fd, c.replies, 32, extra, c.poll, c.clock)
            do x11_need(rest == 0, "desktop: truncated X11 reply body\n")
            return extra
        end
    end
    return 0
end

func x11_clip_wait(c, cb, start, wait_ms):
    let st = c.state
    while true:
        do x11_events_loop(c, 512)
        if cb.notified: return 0 end
        -- With 256 keys queued nothing more is read until they are handled, so no
        -- answer can arrive: waiting longer would only hold the keys up.
        if st.queue_count >= 256: return 0 end
        let now = linux_clock_ms(c.clock)
        do x11_need(not linux_error(now), "desktop: monotonic clock failed\n")
        if now - start >= wait_ms: return 0 end
        do linux_poll(st.fd, c.poll, 1, wait_ms - (now - start))
    end
    return 0
end

func x11_clip_fetch(c, cb):
    let st = c.state
    do x11_settle(c)
    let p = x11_request(c, 20, 1, 24)
    do linux_put32(c.requests, p + 4, st.window)
    do linux_put32(c.requests, p + 8, cb.property)
    do linux_put32(c.requests, p + 20, 16376)
    do x11_flush(c)
    let extra = x11_reply_runtime(c, st.sequence)
    let r = c.replies
    if linux_u32(r, 8) == cb.incr or linux_u32(r, 12) != 0: return 0 - 3 end
    if buffer_get(r, 1) != 8 or linux_u32(r, 16) > extra: return 0 - 4 end
    return linux_u32(r, 16)
end

-- Ask the clipboard's owner for UTF-8 text, waiting up to wait_ms. The result is
-- a byte count, the text at c.replies offset 32 until the next X11 call, or
-- 0 - 1 no owner or a refusal, 0 - 2 no answer in time (or none readable before
-- 256 queued keys are handled), 0 - 3 more than 65,504 bytes or an incremental
-- transfer, 0 - 4 not 8-bit text. time is the server time of the user's paste
-- command. Each request asks for the text in the next of eight properties,
-- emptied first, and only an answer carrying this request's time and property
-- (or None, a refusal) counts: an owner's late answer to an earlier request that
-- timed out writes that request's property and is never read. Events keep
-- queueing while it waits.
func x11_clip_request(c, time, wait_ms):
    let st = c.state
    let cb = st.clip
    cb.notified = false
    cb.asked = time
    cb.property = linux_u32(cb.properties, cb.turn * 4)
    cb.turn = (cb.turn + 1) % 8
    let d = x11_request(c, 19, 0, 12)
    do linux_put32(c.requests, d + 4, st.window)
    do linux_put32(c.requests, d + 8, cb.property)
    let p = x11_request(c, 24, 0, 24)
    do linux_put32(c.requests, p + 4, st.window)
    do linux_put32(c.requests, p + 8, cb.clipboard)
    do linux_put32(c.requests, p + 12, cb.utf8)
    do linux_put32(c.requests, p + 16, cb.property)
    do linux_put32(c.requests, p + 20, time)
    do x11_flush(c)
    let start = linux_clock_ms(c.clock)
    do x11_need(not linux_error(start), "desktop: monotonic clock failed\n")
    do x11_clip_wait(c, cb, start, wait_ms)
    if not cb.notified: return 0 - 2 end
    if cb.answer == 0: return 0 - 1 end
    return x11_clip_fetch(c, cb)
end
