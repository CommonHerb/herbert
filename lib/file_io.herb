-- Linux x86-64 regular-file documents. No libc, no per-read/save allocation.
-- Open the parent directory once; all later operations are relative to that
-- descriptor. Final symlinks, nonregular and multiply linked files are refused.
-- Existing-target replacement preserves rwx mode, not ACLs/xattrs/ownership.
-- Concurrent changes observed before publication are refused, except a status
-- that differs only in its permission bits and change time, which file_recheck
-- adopts when its caller asks, together with any change a stat cannot show: an
-- outside edit that keeps the size and the modification time and comes with a
-- permission change is not seen (nor are extended attributes). file_recheck
-- reads nothing for a new document, or after a publish whose check failed and
-- left the baseline unconfirmed: file_save's recovery checks that one first, and
-- there a permission changed since is refused. There is no interprocess lock:
-- another writer can still race the final check and rename.
-- Result: 0 success; raw -errno failure; 1 means published but durability or
-- baseline refresh failed (do not claim the old file survived that result).
-- A File (below): its state, the read bytes (capacity + 1), basename, temp name
-- (scratch, 256 bytes from file_new: a save's temporary name, or a load's leaf
-- name while it is checked), stat (scratch: every stat writes it before it is read),
-- baseline stat, original path bytes (NUL terminated, useful for display),
-- temp-file stat, last published bytes (recovery after an unsuccessful
-- post-rename stat) and the latest rescue-copy basename (NUL terminated; valid
-- after copy result 0 or 1). file_new's basename and path have 4096 bytes, so one
-- File can load document after document. The stat buffers keep the kernel's layout. State:
-- status and published cover the last operation, rescue calls included;
-- uncertain marks a baseline not yet confirmed after a publish.

ref record FileState:
    dirfd: int
    status: int
    exists: bool
    count: int
    serial: int
    published: bool
    mode: int
    uncertain: bool
    saved_count: int
end

record File:
    state: FileState
    bytes: buffer
    basename: buffer
    temp: buffer
    stat: buffer
    baseline: buffer
    path: buffer
    temp_stat: buffer
    saved: buffer
    copy_name: buffer
end

func file_status(f): return f.state.status end
func file_count(f): return f.state.count end
func file_copy_name(f): return f.copy_name end
func file_result(f, result):
    let st = f.state
    st.status = result
    return result
end

func file_path_scan(path, count, p, slash):
    while p < count:
        if buffer_get(path, p) == 0: return 0 - 2 end
        if buffer_get(path, p) == 47: slash = p end
        p = p + 1
    end
    return slash
end

func file_dot_leaf(path, leaf, count):
    if count - leaf == 1: return buffer_get(path, leaf) == 46 end
    if count - leaf == 2: return buffer_get(path, leaf) == 46 and buffer_get(path, leaf + 1) == 46 end
    return false
end

func file_stat(f):
    return linux_syscall6(262, f.state.dirfd, buffer_address(f.basename), buffer_address(f.stat), 256, 0, 0)
end

func file_regular(stat):
    if (linux_u32(stat, 24) & 61440) == 40960: return 0 - 40 end
    if (linux_u32(stat, 24) & 61440) != 32768: return 0 - 22 end
    if linux_u64(stat, 16) != 1: return 0 - 31 end
    if linux_u32(stat, 28) != linux_syscall6(107, 0, 0, 0, 0, 0, 0): return 0 - 13 end
    return 0
end

-- Detect ordinary independent edits/replacements, including same-size edits.
func file_same(a, b):
    return linux_u64(a, 0) == linux_u64(b, 0) and linux_u64(a, 8) == linux_u64(b, 8) and linux_u64(a, 16) == linux_u64(b, 16) and linux_u32(a, 24) == linux_u32(b, 24) and linux_u64(a, 48) == linux_u64(b, 48) and linux_u64(a, 88) == linux_u64(b, 88) and linux_u64(a, 96) == linux_u64(b, 96) and linux_u64(a, 104) == linux_u64(b, 104) and linux_u64(a, 112) == linux_u64(b, 112)
end

-- Rename can change ctime. Other ordinary content/identity fields must match
-- the synced temporary file before adopting its published name as a baseline.
func file_renamed_same(a, b):
    return linux_u64(a, 0) == linux_u64(b, 0) and linux_u64(a, 8) == linux_u64(b, 8) and linux_u64(a, 16) == linux_u64(b, 16) and linux_u32(a, 24) == linux_u32(b, 24) and linux_u64(a, 48) == linux_u64(b, 48) and linux_u64(a, 88) == linux_u64(b, 88) and linux_u64(a, 96) == linux_u64(b, 96)
end

func file_read_bytes(f, fd, used):
    let st = f.state
    while true:
        let got = linux_syscall6(0, fd, buffer_address(f.bytes) + used, buffer_length(f.bytes) - used, 0, 0, 0)
        if got != 0 - 4:
            if linux_error(got): return got end
            st.count = used + got
            if used + got >= buffer_length(f.bytes): return 0 - 27 end
            if got == 0: return 0 end
            used = used + got
        end
    end
    return 0
end

func file_read(f):
    let st = f.state
    let fd = linux_syscall6(257, st.dirfd, buffer_address(f.basename), 657408, 0, 0, 0)
    if linux_error(fd): return file_result(f, fd) end
    let status = linux_syscall6(5, fd, buffer_address(f.stat), 0, 0, 0, 0)
    if status == 0: status = file_regular(f.stat) end
    if status == 0:
        let baseline = linux_copy(f.baseline, 0, f.stat, 0, 144)
        status = file_read_bytes(f, fd, 0)
    end
    if status == 0:
        status = linux_syscall6(5, fd, buffer_address(f.stat), 0, 0, 0, 0)
        if status == 0 and not file_same(f.stat, f.baseline): status = 0 - 116 end
    end
    let closed = linux_syscall6(3, fd, 0, 0, 0, 0, 0)
    if status == 0 and linux_error(closed): status = closed end
    if status == 0:
        status = file_stat(f)
        if status == 0 and not file_same(f.stat, f.baseline): status = 0 - 116 end
        st.mode = linux_u32(f.baseline, 24) & 511
    end
    return file_result(f, status)
end

-- All of a File's storage is allocated here: documents of at most capacity
-- bytes, a caller-chosen limit from zero through 16 MiB, and paths of at most
-- 4095 bytes. file_load fills it, as often as needed, without allocating.
func file_new(capacity):
    return File(FileState(0 - 1, 0, false, 0, 0, false, 384, false, 0), linux_buffer(capacity + 1), linux_buffer(4096), linux_buffer(256), linux_buffer(144), linux_buffer(144), linux_buffer(4096), linux_buffer(144), linux_buffer(capacity), linux_buffer(128))
end

-- The name in f.temp (NUL terminated), looked up through dirfd, a folder just
-- opened, before f changes: its stat, not following a symlink, goes into f.stat
-- (scratch: every stat of f writes it before anything reads it). 0: a regular
-- file the library will read; 0 - 2: nothing there, a new document; anything
-- else refuses: the stat's own error (13 in a folder that can be read but not
-- searched), or file_regular's 40 a symlink, 22 not a regular file, 31 hard
-- links, 13 another owner.
func file_leaf(f, dirfd):
    let stat = linux_syscall6(262, dirfd, buffer_address(f.temp), buffer_address(f.stat), 256, 0, 0)
    if stat == 0: return file_regular(f.stat) end
    return stat
end

-- f takes dirfd, a folder already open, with the name already in f.basename,
-- once file_leaf has found there a regular file (found 0) or nothing (found
-- 0 - 2): the directory f held is closed and its state starts over (its
-- temp/rescue serial keeps counting), its old document gone. Nothing there is a
-- new empty document (result 0, count 0, not existing). A regular file is read
-- by file_read; a refusal there (it cannot be opened or read, too large, changed
-- while read, or no longer one file_regular accepts: it is never compared with
-- file_leaf's stat, so a regular file swapped for another is read) leaves f on
-- the new folder, marked existing, count the bytes read (capacity + 1 when too
-- large). Use f only after a result of 0: a save after a refusal is checked as
-- any save is (116 after a file that did not open; a file too large is replaced).
func file_adopt(f, dirfd, found):
    let st = f.state
    do file_close(f)
    st.status = 0
    st.exists = false
    st.count = 0
    st.published = false
    st.mode = 384
    st.uncertain = false
    st.saved_count = 0
    st.dirfd = dirfd
    if found == 0 - 2: return 0 end
    st.exists = true
    return file_read(f)
end

-- Load the document named by path's first count bytes into f's own storage.
-- f changes only once the file is one the library will read, or missing (a new
-- empty document; a missing folder is an error). Before that, the path is
-- checked (22; then 36 for a leaf over 255 bytes), its folder is opened, and the
-- leaf's own stat runs through that folder (file_leaf). A refusal at any of
-- these (a bad path, a leaf over 255 bytes, a folder missing, unopenable, or
-- readable but not searchable, a symlink, not a regular file, a second link,
-- another owner) leaves f exactly as it was, still on its document, only its
-- status saying the refusal (a folder already opened is closed again); of f's
-- storage only the scratch f.temp (the leaf's name, or ".") and f.stat (the
-- leaf's stat) were written. The length check also keeps the leaf within
-- f.temp (255 bytes and a NUL). Then f takes the new folder and path
-- (file_adopt), and only file_read's refusals remain (unreadable, too large,
-- changed while read): those leave f on the new folder without its old
-- document, as file_adopt says. The result is also file_status(f). Call
-- file_close even on errors; a dirfd of -1 represents a parent not
-- successfully open.
func file_load(f, path, count):
    if count == 0 or count >= buffer_length(f.path) or count > 4095 or not linux_range(path, 0, count): return file_result(f, 0 - 22) end
    let slash = file_path_scan(path, count, 0, 0 - 1)
    let leaf = 0
    if slash < count: leaf = slash + 1 end
    if slash == 0 - 2 or leaf == count or file_dot_leaf(path, leaf, count): return file_result(f, 0 - 22) end
    if count - leaf > 255: return file_result(f, 0 - 36) end
    -- The parent's name is the path cut at its last slash ("/" for a leaf at
    -- the root), ended in the caller's own buffer for the open and put back at
    -- once, or "." written into the temp-name scratch. Nothing is allocated.
    let dirfd = 0
    if slash < count:
        let cut = slash
        if slash == 0: cut = 1 end
        let kept = buffer_get(path, cut)
        do buffer_set(path, cut, 0)
        dirfd = linux_syscall6(2, buffer_address(path), 589824, 0, 0, 0, 0)
        do buffer_set(path, cut, kept)
    else:
        do linux_text(f.temp, 0, ".")
        do buffer_set(f.temp, 1, 0)
        dirfd = linux_syscall6(2, buffer_address(f.temp), 589824, 0, 0, 0, 0)
    end
    if linux_error(dirfd): return file_result(f, dirfd) end
    do linux_copy(f.temp, 0, path, leaf, count - leaf)
    do buffer_set(f.temp, count - leaf, 0)
    let found = file_leaf(f, dirfd)
    if found != 0 and found != 0 - 2:
        do linux_syscall6(3, dirfd, 0, 0, 0, 0, 0)
        return file_result(f, found)
    end
    do linux_copy(f.path, 0, path, 0, count)
    do buffer_set(f.path, count, 0)
    do linux_copy(f.basename, 0, f.path, leaf, count - leaf + 1)
    return file_adopt(f, dirfd, found)
end

-- A folder scan's storage, allocated once by file_scan_new and reused by every
-- file_scan: dents takes the getdents64 records, 32 KiB (what a C library's
-- readdir reads at a time: about 500 short entries a call, and room for a record
-- of the longest name, 280 bytes); stat one entry's status; name the newest
-- match's name, NUL terminated (at most 255 bytes); time its modification time
-- (seconds, nanoseconds).
record FileScan:
    dents: buffer
    stat: buffer
    name: buffer
    time: buffer
end

func file_scan_new(): return FileScan(linux_buffer(32768), linux_buffer(144), linux_buffer(256), linux_buffer(16)) end
func file_scan_name(scan): return scan.name end

-- Whether b[p, stop) begins with prefix.
func file_prefixed(b, p, stop, prefix):
    if stop - p < length(prefix): return false end
    let i = 0
    while i < length(prefix):
        if buffer_get(b, p + i) != index(prefix, i): return false end
        i = i + 1
    end
    return true
end

-- Whether stat's modification time is later than the one in time. Seconds are
-- signed (before 1970 they are negative), so both are compared with the sign
-- bit flipped; equal seconds go to the nanoseconds.
func file_later(stat, time):
    let a = (linux_u64(stat, 88) ^ 9223372036854775808)
    let b = (linux_u64(time, 0) ^ 9223372036854775808)
    if a != b: return a > b end
    return linux_u64(stat, 96) > linux_u64(time, 8)
end

-- Count the folders in f's opened folder whose names begin with prefix, and
-- keep the newest of them by modification time in scan (file_scan_name). The
-- folder is listed from its start with getdents64 into scan's own buffer, as
-- many calls as it takes; nothing is allocated. An entry counts only when it
-- is a folder itself: the listing's type says directory (or unknown, which some
-- filesystems give), and a stat through f's folder that does not follow a
-- symlink (fstatat, AT_SYMLINK_NOFOLLOW) says directory too, so a symlink, a
-- plain file or anything else wearing the name is skipped. That stat's time
-- picks the newest, never the name; on a tie the first listed stays. Nothing
-- inside any folder is read. Result: the count (with 0 the name is empty), or a
-- raw -errno when f's folder cannot be listed.
func file_scan(f, scan, prefix):
    let dirfd = f.state.dirfd
    do buffer_set(scan.name, 0, 0)
    if linux_error(dirfd): return 0 - 9 end
    let rewound = linux_syscall6(8, dirfd, 0, 0, 0, 0, 0)
    if linux_error(rewound): return rewound end
    let found = 0
    while true:
        let got = linux_syscall6(217, dirfd, buffer_address(scan.dents), buffer_length(scan.dents), 0, 0, 0)
        if linux_error(got): return got end
        if got == 0: return found end
        let p = 0
        while p < got:
            let reclen = linux_u16(scan.dents, p + 16)
            if reclen == 0: return 0 - 5 end
            let kind = buffer_get(scan.dents, p + 18)
            let name = p + 19
            let stop = linux_nul_end(scan.dents, name, p + reclen)
            if (kind == 4 or kind == 0) and stop < p + reclen and stop - name < buffer_length(scan.name) and file_prefixed(scan.dents, name, stop, prefix):
                let checked = linux_syscall6(262, dirfd, buffer_address(scan.dents) + name, buffer_address(scan.stat), 256, 0, 0)
                if checked == 0 and (linux_u32(scan.stat, 24) & 61440) == 16384:
                    found = found + 1
                    if found == 1 or file_later(scan.stat, scan.time):
                        do linux_put64(scan.time, 0, linux_u64(scan.stat, 88))
                        do linux_put64(scan.time, 8, linux_u64(scan.stat, 96))
                        do linux_copy(scan.name, 0, scan.dents, name, stop - name + 1)
                    end
                end
            end
            p = p + reclen
        end
    end
    return found
end

-- Whether name is one plain name: not empty, ".", or "..", and without a slash
-- or a NUL.
func file_one_name(name):
    if length(name) == 0 or equal(name, ".") or equal(name, ".."): return false end
    let i = 0
    while i < length(name):
        if index(name, i) == 47 or index(name, i) == 0: return false end
        i = i + 1
    end
    return true
end

-- Load the file name inside the folder, within f's opened folder, that folder
-- names (its bytes up to a NUL; one name, no slash, not . or ..) into g,
-- through descriptors only, as file_load loads one: the names are checked (22;
-- then 36 for a name over 255 bytes), that folder is opened relative to f's with
-- O_DIRECTORY | O_NOFOLLOW (a symlink at its name is refused with 20), and the
-- file's own stat runs through it (file_leaf) before g changes. A refusal at
-- any of these (a bad name, a name over 255 bytes, a folder missing,
-- unopenable or readable but not searchable, a final symlink, a nonregular or
-- multiply linked file, one owned by another account) leaves g exactly as it
-- was but its scratch (g.temp, g.stat), and closes that folder if it opened.
-- Then g takes the folder (file_adopt) and the file is read, once; one larger
-- than g's capacity is refused (27, after capacity + 1 bytes), and file_read's
-- refusals leave g as file_adopt says (a copy refused while read stays marked
-- existing), so only a result of 0 means g holds the copy. g.path holds
-- "folder/name".
func file_load_inside(g, f, folder, name):
    let count = linux_nul_end(folder, 0, buffer_length(folder))
    if count == 0 or count == buffer_length(folder) or count + length(name) + 1 >= buffer_length(g.path) or not file_one_name(name): return file_result(g, 0 - 22) end
    if file_path_scan(folder, count, 0, 0 - 1) != 0 - 1 or file_dot_leaf(folder, 0, count): return file_result(g, 0 - 22) end
    if length(name) > 255: return file_result(g, 0 - 36) end
    let fd = linux_syscall6(257, f.state.dirfd, buffer_address(folder), 720896, 0, 0, 0)
    if linux_error(fd): return file_result(g, fd) end
    do linux_text(g.temp, 0, name)
    do buffer_set(g.temp, length(name), 0)
    let found = file_leaf(g, fd)
    if found != 0 and found != 0 - 2:
        do linux_syscall6(3, fd, 0, 0, 0, 0, 0)
        return file_result(g, found)
    end
    do linux_copy(g.path, 0, folder, 0, count)
    do buffer_set(g.path, count, 47)
    do linux_text(g.path, count + 1, name)
    do buffer_set(g.path, count + 1 + length(name), 0)
    do linux_copy(g.basename, 0, g.path, count + 1, length(name) + 1)
    return file_adopt(g, fd, found)
end

-- A new File loaded from a path string. Its storage serves later file_load calls.
func file_open(path, capacity):
    let badcapacity = capacity > 16777216
    if badcapacity: capacity = 0 end
    let f = file_new(capacity)
    if badcapacity or length(path) > 4095:
        do file_result(f, 0 - 22)
        return f
    end
    do linux_text(f.path, 0, path)
    do file_load(f, f.path, length(path))
    return f
end

func file_temp(f, tries):
    let st = f.state
    while tries != 0:
        let serial = st.serial + 1
        st.serial = serial
        do linux_text(f.temp, 0, ".herbert-save-")
        let pidend = linux_decimal(f.temp, 14, linux_syscall6(39, 0, 0, 0, 0, 0, 0))
        do buffer_set(f.temp, pidend, 45)
        let serialend = linux_decimal(f.temp, pidend + 1, serial)
        do linux_text(f.temp, serialend, ".tmp")
        do buffer_set(f.temp, serialend + 4, 0)
        let fd = linux_syscall6(257, st.dirfd, buffer_address(f.temp), 655553, 384, 0, 0)
        if fd != 0 - 17: return fd end
        tries = tries - 1
    end
    return 0 - 17
end

func file_write_bytes(fd, bytes, offset, count):
    while count != 0:
        let sent = linux_syscall6(1, fd, buffer_address(bytes) + offset, count, 0, 0, 0)
        if sent != 0 - 4:
            if linux_error(sent): return sent end
            if sent == 0: return 0 - 5 end
            offset = offset + sent
            count = count - sent
        end
    end
    return 0
end

-- Prepare and close an already exclusively created temporary file. A rescue
-- copy must not disturb f.temp_stat, which can identify an uncertain original save.
func file_fill_temp(f, fd, bytes, count, mode, record_version):
    let status = file_write_bytes(fd, bytes, 0, count)
    if status == 0: status = linux_syscall6(91, fd, mode, 0, 0, 0, 0) end
    if status == 0: status = linux_syscall6(74, fd, 0, 0, 0, 0, 0) end
    if status == 0 and record_version: status = linux_syscall6(5, fd, buffer_address(f.temp_stat), 0, 0, 0, 0) end
    let closed = linux_syscall6(3, fd, 0, 0, 0, 0, 0)
    if status == 0 and linux_error(closed): status = closed end
    return status
end

func file_bytes_same(a, b, count, p):
    while p < count:
        if buffer_get(a, p) != buffer_get(b, p): return false end
        p = p + 1
    end
    return true
end

-- A failed post-publication stat must not turn our own successful rename into
-- an apparent external edit. Retry verifies inode, stable metadata AND bytes
-- before accepting a new baseline. Any failed check remains fail-closed.
func file_recover_baseline(f):
    let st = f.state
    let checked = file_stat(f)
    if checked != 0: return checked end
    if not file_renamed_same(f.stat, f.temp_stat): return 0 - 116 end
    let loaded = file_read(f)
    if loaded != 0: return loaded end
    if not file_renamed_same(f.baseline, f.temp_stat) or file_count(f) != st.saved_count: return 0 - 116 end
    if not file_bytes_same(f.bytes, f.saved, file_count(f), 0): return 0 - 116 end
    st.uncertain = false
    return 0
end

func file_conflict(f):
    if f.state.uncertain: return file_recover_baseline(f) end
    let status = file_stat(f)
    if not f.state.exists:
        if status == 0 - 2: return 0 end
        if status == 0: return 0 - 17 end
        return status
    end
    if status != 0: return status end
    let regular = file_regular(f.stat)
    if regular != 0: return regular end
    if not file_same(f.stat, f.baseline): return 0 - 116 end
    return 0
end

-- The document's state as it is now, read before a save through the folder held
-- since it opened (a final symlink is not followed). Whenever that stat works,
-- state.mode becomes the permission bits it found, before any refusal below
-- (31, 13 another owner, 40, 22), so a caller that shows the mode shows the
-- last status it could read; a stat that fails (a file gone, a folder that
-- cannot be searched, an I/O error) leaves state.mode as it was. A permission
-- change made while the document is open is adopted: when the file's mode
-- differs from its baseline and nothing else does but the change time (same
-- device, inode, link count, owner, group, size and modification time), the
-- baseline takes the current stat, so file_save keeps the new bits and does not
-- refuse the change. Any other difference stays a conflict (116), and so does a
-- change time that moved with the mode as recorded: a chmod undone and an
-- outside edit whose modification time was put back look the same, so both are
-- refused. The limit that comes with adopting: an outside change that keeps the
-- size and the modification time and comes with a permission change (the bytes
-- rewritten in place with the time put back, or extended attributes set) is not
-- seen; it is adopted with the mode, and file_save then replaces it. Result: 0;
-- 116; the refusal file_save would give first (2 gone, 40 a symlink, 22 not a
-- regular file, 31 hard links, 13 another owner or a folder that cannot be
-- searched); or any other error of the stat itself (5, 12 and the like), which
-- file_save's own stat a moment later might not meet, so a caller goes on to
-- file_save after 0 or 116 only (file_save refuses 116 itself). A new document
-- reads nothing and gives 0, and so does a baseline not yet confirmed after a
-- publish: file_save's own recovery checks that one first, against what it
-- published (identity, mode, size, modification time and bytes), so there a
-- permission changed since is refused (116) until it is back to the published
-- one. Refusing a file whose owner write bit is off is the caller's.
func file_recheck(f):
    let st = f.state
    if not st.exists or st.uncertain: return file_result(f, 0) end
    let status = file_stat(f)
    if status == 0: st.mode = linux_u32(f.stat, 24) & 511 end
    if status == 0: status = file_regular(f.stat) end
    if status != 0: return file_result(f, status) end
    if file_same(f.stat, f.baseline): return file_result(f, 0) end
    let mode = linux_u32(f.stat, 24)
    let was = linux_u32(f.baseline, 24)
    let kept = linux_u64(f.stat, 0) == linux_u64(f.baseline, 0) and linux_u64(f.stat, 8) == linux_u64(f.baseline, 8) and linux_u64(f.stat, 16) == linux_u64(f.baseline, 16) and linux_u32(f.stat, 28) == linux_u32(f.baseline, 28) and linux_u32(f.stat, 32) == linux_u32(f.baseline, 32) and linux_u64(f.stat, 48) == linux_u64(f.baseline, 48) and linux_u64(f.stat, 88) == linux_u64(f.baseline, 88) and linux_u64(f.stat, 96) == linux_u64(f.baseline, 96)
    if kept and mode != was and (mode & 61440) == (was & 61440):
        do linux_copy(f.baseline, 0, f.stat, 0, 144)
        return file_result(f, 0)
    end
    return file_result(f, 0 - 116)
end

func file_save(f, bytes, count):
    let st = f.state
    st.published = false
    if not linux_range(bytes, 0, count): return file_result(f, 0 - 22) end
    if count > buffer_length(f.saved): return file_result(f, 0 - 27) end
    -- Recovery rereads into f.bytes. Do not silently overwrite a caller's proposed
    -- content if it aliases that internal scratch; keep edits in its own buffer.
    if st.uncertain and buffer_address(bytes) == buffer_address(f.bytes): return file_result(f, 0 - 22) end
    let checked = file_conflict(f)
    if checked != 0: return file_result(f, checked) end
    let fd = file_temp(f, 32)
    if linux_error(fd): return file_result(f, fd) end
    let status = file_fill_temp(f, fd, bytes, count, st.mode, true)
    if status == 0: status = file_conflict(f) end
    if status == 0:
        if not st.exists:
            status = linux_syscall6(316, st.dirfd, buffer_address(f.temp), st.dirfd, buffer_address(f.basename), 1, 0)
        else:
            status = linux_syscall6(264, st.dirfd, buffer_address(f.temp), st.dirfd, buffer_address(f.basename), 0, 0)
        end
    end
    if status != 0:
        do linux_syscall6(263, st.dirfd, buffer_address(f.temp), 0, 0, 0, 0)
        return file_result(f, status)
    end
    st.published = true
    st.exists = true
    do linux_copy(f.saved, 0, bytes, 0, count)
    st.saved_count = count
    st.uncertain = true
    let synced = linux_syscall6(74, st.dirfd, 0, 0, 0, 0, 0)
    let refreshed = file_stat(f)
    if refreshed == 0 and file_renamed_same(f.stat, f.temp_stat):
        do linux_copy(f.baseline, 0, f.stat, 0, 144)
        st.uncertain = false
    else:
        refreshed = 0 - 116
    end
    if synced != 0 or refreshed != 0: return file_result(f, 1) end
    return file_result(f, 0)
end

func file_copy_publish(f, tries):
    let st = f.state
    while tries != 0:
        do linux_text(f.copy_name, 0, "herbert-rescue-")
        let pidend = linux_decimal(f.copy_name, 15, linux_syscall6(39, 0, 0, 0, 0, 0, 0))
        do buffer_set(f.copy_name, pidend, 45)
        let serialend = linux_decimal(f.copy_name, pidend + 1, st.serial)
        do linux_text(f.copy_name, serialend, ".txt")
        do buffer_set(f.copy_name, serialend + 4, 0)
        let status = linux_syscall6(316, st.dirfd, buffer_address(f.temp), st.dirfd, buffer_address(f.copy_name), 1, 0)
        if status != 0 - 17: return status end
        st.serial = st.serial + 1
        tries = tries - 1
    end
    return 0 - 17
end

-- Persist edits to a new private sibling without replacing or adopting the
-- original document. No original-file conflict check is needed. Existing copy
-- names are never overwritten; at most 32 candidate names are attempted.
-- The returned basename is file_copy_name(f), only after result 0 or 1.
-- Return 1 means the copy was published but its directory sync failed.
func file_save_copy(f, bytes, count):
    let st = f.state
    st.published = false
    if not linux_range(bytes, 0, count): return file_result(f, 0 - 22) end
    if count > buffer_length(f.saved): return file_result(f, 0 - 27) end
    let fd = file_temp(f, 32)
    if linux_error(fd): return file_result(f, fd) end
    let status = file_fill_temp(f, fd, bytes, count, 384, false)
    if status == 0: status = file_copy_publish(f, 32) end
    if status != 0:
        do linux_syscall6(263, st.dirfd, buffer_address(f.temp), 0, 0, 0, 0)
        return file_result(f, status)
    end
    st.published = true
    let synced = linux_syscall6(74, st.dirfd, 0, 0, 0, 0, 0)
    if synced != 0: return file_result(f, 1) end
    return file_result(f, 0)
end

func file_close(f):
    let st = f.state
    let fd = st.dirfd
    if linux_error(fd): return 0 end
    st.dirfd = 0 - 1
    return linux_syscall6(3, fd, 0, 0, 0, 0, 0)
end
