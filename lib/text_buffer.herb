-- Fixed-capacity ASCII text editing. All storage is allocated at construction;
-- editing, navigation and inspection reuse it. LF ends lines; TAB is four
-- visual columns to the next tab stop. Cursor positions are byte boundaries.
-- Tuple: (bytes, state). State u64: length, cursor, desired vertical column.
func text_buffer(capacity):
    let t = (linux_buffer(capacity), linux_buffer(24))
    let goal = linux_put64(t.1, 16, 0 - 1)
    return t
end

func text_length(t): return linux_u64(t.1, 0) end
func text_cursor(t): return linux_u64(t.1, 8) end

func text_ascii(ch):
    return (ch >= 32 and ch <= 126) or ch == 10 or ch == 9
end

func text_validate(bytes, count, p):
    if p >= count: return true end
    if not text_ascii(buffer_get(bytes, p)): return false end
    return text_validate(bytes, count, p + 1)
end

-- A rejected load leaves the previous text intact: -EFBIG or -EILSEQ.
func text_load(t, bytes, count):
    if count > buffer_length(t.0): return 0 - 27 end
    if not linux_range(bytes, 0, count): return 0 - 22 end
    if not text_validate(bytes, count, 0): return 0 - 84 end
    let copied = linux_copy(t.0, 0, bytes, 0, count)
    let size = linux_put64(t.1, 0, count)
    let cursor = linux_put64(t.1, 8, 0)
    let goal = linux_put64(t.1, 16, 0 - 1)
    return 0
end

func text_seek(t, pos):
    if pos > text_length(t): pos = text_length(t) end
    let stored = linux_put64(t.1, 8, pos)
    return linux_put64(t.1, 16, 0 - 1)
end

func text_shift_right(bytes, last, stop):
    if last <= stop: return 0 end
    let moved = buffer_set(bytes, last, buffer_get(bytes, last - 1))
    return text_shift_right(bytes, last - 1, stop)
end

-- Returns 1 when changed, 0 at capacity or for an unsupported byte.
func text_insert(t, ch):
    let size = text_length(t)
    if size == buffer_length(t.0) or not text_ascii(ch): return 0 end
    let p = text_cursor(t)
    let shifted = text_shift_right(t.0, size, p)
    let stored = buffer_set(t.0, p, ch)
    let grown = linux_put64(t.1, 0, size + 1)
    let moved = text_seek(t, p + 1)
    return 1
end

func text_delete(t):
    let p = text_cursor(t)
    let size = text_length(t)
    if p >= size: return 0 end
    let copied = linux_copy(t.0, p, t.0, p + 1, size - p - 1)
    let shrunk = linux_put64(t.1, 0, size - 1)
    let goal = linux_put64(t.1, 16, 0 - 1)
    return 1
end

func text_backspace(t):
    let p = text_cursor(t)
    if p == 0: return 0 end
    let moved = text_seek(t, p - 1)
    return text_delete(t)
end

func text_line_start(t, p):
    if p == 0: return 0 end
    if buffer_get(t.0, p - 1) == 10: return p end
    return text_line_start(t, p - 1)
end

func text_line_end(t, p):
    if p >= text_length(t): return text_length(t) end
    if buffer_get(t.0, p) == 10: return p end
    return text_line_end(t, p + 1)
end

func text_next_column(column, ch):
    if ch == 9: return ((column / 4) + 1) * 4 end
    return column + 1
end

func text_column_loop(t, p, stop, column):
    if p >= stop: return column end
    return text_column_loop(t, p + 1, stop, text_next_column(column, buffer_get(t.0, p)))
end

func text_column(t, p):
    return text_column_loop(t, text_line_start(t, p), p, 0)
end

func text_row_loop(t, p, stop, row):
    if p >= stop: return row end
    if buffer_get(t.0, p) == 10: row = row + 1 end
    return text_row_loop(t, p + 1, stop, row)
end

func text_row(t, p): return text_row_loop(t, 0, p, 0) end

func text_row_start(t, p, rows):
    if rows == 0: return p end
    let e = text_line_end(t, p)
    if e >= text_length(t): return e end
    return text_row_start(t, e + 1, rows - 1)
end

func text_column_position(t, p, target, column):
    if p >= text_length(t): return p end
    let ch = buffer_get(t.0, p)
    if ch == 10: return p end
    let next = text_next_column(column, ch)
    if next > target: return p end
    return text_column_position(t, p + 1, target, next)
end

func text_vertical(t, downward, steps):
    if steps == 0: return 0 end
    let p = text_cursor(t)
    let goal = linux_u64(t.1, 16)
    if goal == 0 - 1:
        goal = text_column(t, p)
        let remembered = linux_put64(t.1, 16, goal)
    end
    let start = text_line_start(t, p)
    let target = start
    if downward:
        let e = text_line_end(t, p)
        if e >= text_length(t): return 0 end
        target = e + 1
    else:
        if start == 0: return 0 end
        target = text_line_start(t, start - 1)
    end
    let moved = linux_put64(t.1, 8, text_column_position(t, target, goal, 0))
    return text_vertical(t, downward, steps - 1)
end
