-- Fixed-capacity UTF-8 editing; storage is allocated only at construction.
-- Logical LF, preserved uniform LF/CRLF file style, disk-byte capacity limit.
-- Cursor offsets count logical UTF-8 bytes and always lie on Unicode 18 default
-- extended grapheme boundaries. Each grapheme occupies one editor column;
-- TAB advances to the next four-column stop. Bytes are never normalized.
-- History: at most 256 records AND a payload byte budget (capacity unless
-- text_buffer_history chooses another). Each 56-byte record has kind0 pos8
-- byte-count16 cursor-before24 cursor-after32 payload-offset40 disk-width48.
-- Kind is 1 insert or 2 removal, plus 4 when the record continues the one
-- before it: a replace is a removal and an insertion undone and redone together.
-- Arbitrarily long deleted clusters are complete records; oldest complete
-- records (a whole replace at once) are evicted until both limits fit. Editing
-- discards redo.
-- Loading marks every grapheme boundary once; an edit shifts the marks with
-- the text and re-marks only the lines it touched. Rows are counted from one
-- remembered line, so neither editing nor drawing scans the whole document.

-- goal is the column Up and Down aim for, -1 when none is remembered. The
-- history records form a ring of 256 slots: oldest is the first retained
-- record's slot, retained how many are kept and applied how many of those are in
-- effect (the rest are redo). The payload ring holds payload_bytes bytes from
-- oldest_payload. disk_length counts the bytes the text takes on disk, where a
-- CRLF file stores two per newline. row_pos is the start of a remembered line
-- and row its row number (the newlines before it).
ref record TextState:
    length: int
    cursor: int
    goal: int
    oldest: int
    retained: int
    applied: int
    crlf: bool
    disk_length: int
    oldest_payload: int
    payload_bytes: int
    row_pos: int
    row: int
end

-- bytes is the logical text; history the 256 records; serialized the file
-- bytes of a CRLF text; marks one boundary flag per position and one for the
-- end; payload the history's byte ring; scratch one encoded scalar.
record Text:
    state: TextState
    bytes: buffer
    history: buffer
    serialized: buffer
    marks: buffer
    payload: buffer
    scratch: buffer
end

func text_buffer(capacity): return text_buffer_history(capacity, capacity) end

-- A history budget of twice the capacity holds any one replace of the whole text.
func text_buffer_history(capacity, history):
    let t = Text(TextState(0, 0, 0 - 1, 0, 0, 0, false, 0, 0, 0, 0, 0), linux_buffer(capacity), linux_buffer(14336), linux_buffer(capacity), linux_buffer(capacity + 1), linux_buffer(history), linux_buffer(4))
    do buffer_set(t.marks, 0, 1)
    return t
end

func text_length(t): return t.state.length end
func text_cursor(t): return t.state.cursor end
func text_crlf(t): return t.state.crlf end
func text_file_length(t): return t.state.disk_length end

func text_file_width(t, cp):
    if cp == 10 and text_crlf(t): return 2 end
    return utf8_width(cp)
end

-- Borrowed output remains valid until the next edit or serialization.
func text_file_bytes(t):
    if not text_crlf(t): return t.bytes end
    let p = 0
    let out = 0
    while p != text_length(t):
        let ch = buffer_get(t.bytes, p)
        if ch == 10:
            do buffer_set(t.serialized, out, 13)
            out = out + 1
        end
        do buffer_set(t.serialized, out, ch)
        p = p + 1
        out = out + 1
    end
    return t.serialized
end

-- Retained ASCII predicate for callers with explicitly ASCII-only interfaces.
func text_ascii(ch):
    return (ch >= 32 and ch <= 126) or ch == 10 or ch == 9
end

-- Validate all bytes without changing text/state. Return 0 no newline, 1 LF,
-- 2 CRLF, or -EILSEQ (malformed UTF-8, C0/DEL/C1 except TAB/LF/CRLF,
-- bare CR, mixed endings). Unicode format characters/noncharacters are valid.
func text_style(bytes, count, p, style):
    while p < count:
        let decoded = utf8_decode(bytes, p, count)
        if linux_error(decoded.0): return decoded.0 end
        let cp = decoded.0
        if cp == 13:
            if decoded.1 >= count or style == 1: return 0 - 84 end
            if buffer_get(bytes, decoded.1) != 10: return 0 - 84 end
            p = decoded.1 + 1
            style = 2
        else:
            if not utf8_text_allowed(cp): return 0 - 84 end
            if cp == 10:
                if style == 2: return 0 - 84 end
                style = 1
            end
            p = decoded.1
        end
    end
    return style
end

func text_decode(t, bytes, count, p, out):
    while p != count:
        if buffer_get(bytes, p) == 13: p = p + 1 end
        do buffer_set(t.bytes, out, buffer_get(bytes, p))
        p = p + 1
        out = out + 1
    end
    return out
end

func text_refresh(t): return unicode_grapheme_mark(t.bytes, text_length(t), t.marks) end

-- Rejection leaves text, style, cursor and history intact. New/empty or
-- newline-free files default to LF. No trailing newline or BOM is invented.
func text_load(t, bytes, count):
    if count > buffer_length(t.bytes): return 0 - 27 end
    if not linux_range(bytes, 0, count): return 0 - 22 end
    let style = text_style(bytes, count, 0, 0)
    if linux_error(style): return style end
    let copied = text_decode(t, bytes, count, 0, 0)
    let st = t.state
    st.length = copied
    st.cursor = 0
    st.goal = 0 - 1
    st.oldest = 0
    st.retained = 0
    st.applied = 0
    st.crlf = style == 2
    st.disk_length = count
    st.oldest_payload = 0
    st.payload_bytes = 0
    st.row_pos = 0
    st.row = 0
    return text_refresh(t)
end

func text_boundary(t, pos):
    if pos > text_length(t): return false end
    return buffer_get(t.marks, pos) != 0
end

func text_floor(t, pos):
    while not text_boundary(t, pos):
        pos = pos - 1
    end
    return pos
end

func text_ceil(t, pos):
    while not text_boundary(t, pos):
        pos = pos + 1
    end
    return pos
end

func text_next(t, pos):
    if pos >= text_length(t): return text_length(t) end
    return text_ceil(t, pos + 1)
end

func text_previous(t, pos):
    if pos > text_length(t): pos = text_length(t) end
    if pos == 0: return 0 end
    return text_floor(t, pos - 1)
end

func text_seek(t, pos):
    if pos > text_length(t): pos = text_length(t) end
    let st = t.state
    st.cursor = text_floor(t, pos)
    st.goal = 0 - 1
    return 0
end

func text_shift_right(bytes, last, stop, width):
    while last > stop:
        do buffer_set(bytes, last - 1 + width, buffer_get(bytes, last - 1))
        last = last - 1
    end
    return 0
end

func text_history_at(t, i): return ((t.state.oldest + i) % 256) * 56 end
func text_history_kind(t, at): return linux_u64(t.history, at) & 3 end
func text_history_joined(t, at): return (linux_u64(t.history, at) & 4) != 0 end

func text_history_sum(t, i, stop, total):
    while i != stop:
        total = total + linux_u64(t.history, text_history_at(t, i) + 16)
        i = i + 1
    end
    return total
end

-- Truncate redo only once an edit has passed every rejection/capacity check.
func text_history_truncate(t):
    let st = t.state
    st.retained = st.applied
    st.payload_bytes = text_history_sum(t, 0, st.applied, 0)
    return 0
end

-- Callers first check that need fits the whole budget (text_history_fits).
-- A record left continuing an evicted one is evicted too: no half replace stays.
func text_history_make_room(t, need):
    let st = t.state
    while true:
        let used = st.payload_bytes
        let retained = st.retained
        let orphan = retained > 0 and text_history_joined(t, text_history_at(t, 0))
        if retained < 256 and need <= buffer_length(t.payload) - used and not orphan: return 0 end
        let at = text_history_at(t, 0)
        let oldcount = linux_u64(t.history, at + 16)
        let nextbyte = (linux_u64(t.history, at + 40) + oldcount) % buffer_length(t.payload)
        st.oldest = (st.oldest + 1) % 256
        st.oldest_payload = nextbyte
        st.payload_bytes = used - oldcount
        st.retained = retained - 1
        st.applied = retained - 1
    end
    return 0
end

func text_history_copy_in(t, at, src, from, count):
    while count != 0:
        do buffer_set(t.payload, at, buffer_get(src, from))
        at = (at + 1) % buffer_length(t.payload)
        from = from + 1
        count = count - 1
    end
    return 0
end

func text_history_push(t, kind, pos, src, from, count, width, before):
    do text_history_truncate(t)
    do text_history_make_room(t, count)
    let st = t.state
    let retained = st.retained
    let used = st.payload_bytes
    let payload = (st.oldest_payload + used) % buffer_length(t.payload)
    do text_history_copy_in(t, payload, src, from, count)
    let at = text_history_at(t, retained)
    do linux_put64(t.history, at, kind)
    do linux_put64(t.history, at + 8, pos)
    do linux_put64(t.history, at + 16, count)
    do linux_put64(t.history, at + 24, before)
    do linux_put64(t.history, at + 40, payload)
    do linux_put64(t.history, at + 48, width)
    st.payload_bytes = used + count
    st.retained = retained + 1
    st.applied = retained + 1
    return at
end

func text_history_copy_out(t, at, to, count):
    while count != 0:
        do buffer_set(t.bytes, to, buffer_get(t.payload, at))
        at = (at + 1) % buffer_length(t.payload)
        to = to + 1
        count = count - 1
    end
    return 0
end

-- Re-mark the lines holding positions from..to after an edit there.
func text_remark(t, from, to):
    return unicode_grapheme_mark_lines(t.bytes, text_length(t), t.marks, text_line_start(t, from), text_line_end(t, to))
end

-- Before an edit at pos, move the remembered line back to pos's line if it lies
-- later, so the edit changes neither its position nor its row.
func text_row_before(t, pos):
    let st = t.state
    if st.row_pos <= pos: return 0 end
    let start = text_line_start(t, pos)
    st.row = st.row - text_newlines(t.bytes, start, st.row_pos, 0)
    st.row_pos = start
    return 0
end

-- Exact recorded byte spans deliberately ignore current grapheme boundaries:
-- undoing an inserted combining mark removes only that mark, not its base.
-- Internal only: a history record guarantees capacity and valid UTF-8 result.
-- The marks, one more than the bytes, move with them before the re-mark.
func text_history_apply(t, at, inserting):
    let pos = linux_u64(t.history, at + 8)
    let count = linux_u64(t.history, at + 16)
    let width = linux_u64(t.history, at + 48)
    let size = text_length(t)
    let st = t.state
    do text_row_before(t, pos)
    if inserting:
        do text_shift_right(t.bytes, size, pos, count)
        do text_shift_right(t.marks, size + 1, pos, count)
        do text_history_copy_out(t, linux_u64(t.history, at + 40), pos, count)
        st.length = size + count
        st.disk_length = st.disk_length + width
        return text_remark(t, pos, pos + count)
    end
    do linux_copy(t.bytes, pos, t.bytes, pos + count, size - pos - count)
    do linux_copy(t.marks, pos, t.marks, pos + count, size - pos - count + 1)
    st.length = size - count
    st.disk_length = st.disk_length - width
    return text_remark(t, pos, pos)
end

-- Returns 1 if changed, 0 for disallowed scalar or insufficient disk capacity.
-- A scalar may join surrounding clusters; move to the first boundary at/after
-- its final byte so subsequent navigation never starts inside a cluster.
func text_insert(t, cp):
    if not utf8_text_allowed(cp): return 0 end
    let width = text_file_width(t, cp)
    if width > buffer_length(t.bytes) - text_file_length(t): return 0 end
    if not text_history_fits(t, utf8_width(cp)): return 0 end
    let count = utf8_store(t.scratch, 0, cp)
    let before = text_cursor(t)
    let at = text_history_push(t, 1, before, t.scratch, 0, count, width, before)
    do text_history_apply(t, at, true)
    let after = text_ceil(t, before + count)
    do text_seek(t, after)
    do linux_put64(t.history, at + 32, after)
    return 1
end

func text_remove(t, pos, stop, before):
    if not text_history_fits(t, stop - pos): return 0 end
    return text_remove_span(t, pos, stop, before, 2)
end

func text_history_fits(t, need): return need <= buffer_length(t.payload) end

func text_newlines(bytes, p, stop, n):
    while p < stop:
        if buffer_get(bytes, p) == 10: n = n + 1 end
        p = p + 1
    end
    return n
end

-- On-disk bytes of count logical bytes: each newline is two bytes in CRLF style.
func text_disk_width(t, bytes, from, count):
    if not text_crlf(t): return count end
    return count + text_newlines(bytes, from, from + count, 0)
end

func text_remove_span(t, pos, stop, before, kind):
    let count = stop - pos
    let at = text_history_push(t, kind, pos, t.bytes, pos, count, text_disk_width(t, t.bytes, pos, count), before)
    do text_history_apply(t, at, false)
    do text_seek(t, pos)
    do linux_put64(t.history, at + 32, text_cursor(t))
    return 1
end

-- Replace the logical span [start, stop) with count bytes of src from offset
-- from, as one undo step. start and stop lie on grapheme boundaries; src is
-- valid UTF-8 text without CR (the caller checks it). Returns 1 when changed,
-- 0 when the result exceeds the disk capacity, 2 when the history budget cannot
-- hold the step. Nothing changes unless it returns 1. src must not be the text.
func text_replace(t, start, stop, src, from, count):
    let removed = stop - start
    if removed == 0 and count == 0: return 0 end
    let width = text_disk_width(t, src, from, count)
    let freed = text_disk_width(t, t.bytes, start, removed)
    if width > buffer_length(t.bytes) - text_file_length(t) + freed: return 0 end
    if not text_history_fits(t, removed + count): return 2 end
    let before = text_cursor(t)
    let kind = 1
    if removed > 0:
        do text_remove_span(t, start, stop, before, 2)
        kind = 5
    end
    if count == 0: return 1 end
    let at = text_history_push(t, kind, start, src, from, count, width, before)
    do text_history_apply(t, at, true)
    let after = text_ceil(t, start + count)
    do text_seek(t, after)
    do linux_put64(t.history, at + 32, after)
    return 1
end

func text_replace_scalar(t, start, stop, cp):
    if not utf8_text_allowed(cp): return 0 end
    let count = utf8_store(t.scratch, 0, cp)
    return text_replace(t, start, stop, t.scratch, 0, count)
end

func text_delete(t):
    let before = text_cursor(t)
    if before >= text_length(t): return 0 end
    return text_remove(t, before, text_next(t, before), before)
end

func text_backspace(t):
    let before = text_cursor(t)
    if before == 0: return 0 end
    return text_remove(t, text_previous(t, before), before, before)
end

func text_undo(t):
    let st = t.state
    while true:
        let applied = st.applied
        if applied == 0: return 0 end
        let at = text_history_at(t, applied - 1)
        do text_history_apply(t, at, text_history_kind(t, at) == 2)
        do text_seek(t, linux_u64(t.history, at + 24))
        st.applied = applied - 1
        if not text_history_joined(t, at): return 1 end
    end
    return 0
end

func text_redo(t):
    let st = t.state
    while true:
        let applied = st.applied
        if applied == st.retained: return 0 end
        let at = text_history_at(t, applied)
        do text_history_apply(t, at, text_history_kind(t, at) == 1)
        do text_seek(t, linux_u64(t.history, at + 32))
        st.applied = applied + 1
        let again = false
        if applied + 1 < st.retained:
            if text_history_joined(t, text_history_at(t, applied + 1)): again = true end
        end
        if not again: return 1 end
    end
    return 0
end

func text_line_start(t, p):
    while p != 0:
        if buffer_get(t.bytes, p - 1) == 10: return p end
        p = p - 1
    end
    return 0
end

func text_line_end(t, p):
    while p < text_length(t):
        if buffer_get(t.bytes, p) == 10: return p end
        p = p + 1
    end
    return text_length(t)
end

func text_next_column(column, ch):
    if ch == 9: return ((column / 4) + 1) * 4 end
    return column + 1
end

func text_column_loop(t, p, stop, column):
    while p < stop:
        column = text_next_column(column, buffer_get(t.bytes, p))
        p = text_next(t, p)
    end
    return column
end

func text_column(t, p):
    if p > text_length(t): p = text_length(t) end
    p = text_floor(t, p)
    return text_column_loop(t, text_line_start(t, p), p, 0)
end

-- The row of position p, counted from the remembered line, which then moves to
-- p's line.
func text_row(t, p):
    if p > text_length(t): p = text_length(t) end
    let st = t.state
    let row = st.row
    if p >= st.row_pos:
        row = row + text_newlines(t.bytes, st.row_pos, p, 0)
    else:
        row = row - text_newlines(t.bytes, p, st.row_pos, 0)
    end
    st.row_pos = text_line_start(t, p)
    st.row = row
    return row
end

func text_row_found(t, p, row):
    let st = t.state
    st.row_pos = p
    st.row = row
    return p
end

func text_rows_down(t, p, at, row):
    while at != row:
        let e = text_line_end(t, p)
        if e >= text_length(t):
            do text_row_found(t, p, at)
            return e
        end
        p = e + 1
        at = at + 1
    end
    return text_row_found(t, p, at)
end

func text_rows_up(t, p, at, row):
    while at != row:
        p = text_line_start(t, p - 1)
        at = at - 1
    end
    return text_row_found(t, p, at)
end

-- The start of the given row, or the end of the text if it has fewer rows. The
-- remembered line moves to that row, or to the last.
func text_row_offset(t, row):
    let st = t.state
    if row >= st.row: return text_rows_down(t, st.row_pos, st.row, row) end
    return text_rows_up(t, st.row_pos, st.row, row)
end

-- The given row, or the document's last row if it has fewer: found by walking
-- from the remembered line, never by counting the text beyond that row. The
-- remembered line moves to the row returned.
func text_row_clamp(t, row):
    do text_row_offset(t, row)
    return t.state.row
end

func text_column_position(t, p, target, column):
    while p < text_length(t):
        let ch = buffer_get(t.bytes, p)
        if ch == 10: return p end
        let next = text_next_column(column, ch)
        if next > target: return p end
        column = next
        p = text_next(t, p)
    end
    return p
end

func text_vertical(t, downward, steps):
    while steps != 0:
        let p = text_cursor(t)
        let st = t.state
        let goal = st.goal
        if goal == 0 - 1:
            goal = text_column(t, p)
            st.goal = goal
        end
        let start = text_line_start(t, p)
        let target = start
        if downward:
            let e = text_line_end(t, p)
            if e >= text_length(t): return 0 end
            target = e + 1
        else:
            if start == 0: return 0 end
            target = text_line_start(t, start - 1)
        end
        st.cursor = text_column_position(t, target, goal, 0)
        steps = steps - 1
    end
    return 0
end

-- Literal, case-sensitive, byte-exact search without normalization. A match
-- must begin AND end at document grapheme boundaries. Interior bytes cannot
-- match a combining suffix, variation selector, or one scalar of a ZWJ cluster.
func text_match(t, query, count, pos, i):
    while i != count:
        if buffer_get(t.bytes, pos + i) != buffer_get(query, i): return false end
        i = i + 1
    end
    return true
end

func text_find_loop(t, query, count, pos, backward, candidates, remaining):
    while remaining != 0:
        if text_boundary(t, pos) and text_boundary(t, pos + count):
            if text_match(t, query, count, pos, 0): return pos end
        end
        let next = (pos + 1) % candidates
        if backward: next = (pos + candidates - 1) % candidates end
        pos = next
        remaining = remaining - 1
    end
    return 0 - 1
end

func text_find(t, query, count, start, backward):
    if count == 0 or count > text_length(t) or count > buffer_length(query): return 0 - 1 end
    let candidates = text_length(t) - count + 1
    if start >= candidates:
        start = 0
        if backward: start = candidates - 1 end
    end
    return text_find_loop(t, query, count, start, backward, candidates, candidates)
end
