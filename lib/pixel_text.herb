-- Small original 5x7 bitmap lettering for Herbert X11 examples.
-- No font files or font service. Scale is an integer pixel size.
-- Glyph literals and drawing requests allocate nothing during a frame.
func pixel_glyph(ch):
    if ch == 65: return "01110100011000111111100011000110001" end
    if ch == 66: return "11110100011000111110100011000111110" end
    if ch == 67: return "01111100001000010000100001000001111" end
    if ch == 68: return "11110100011000110001100011000111110" end
    if ch == 69: return "11111100001000011110100001000011111" end
    if ch == 70: return "11111100001000011110100001000010000" end
    if ch == 71: return "01111100001000010111100011000101111" end
    if ch == 72: return "10001100011000111111100011000110001" end
    if ch == 73: return "11111001000010000100001000010011111" end
    if ch == 74: return "00111000100001000010100101001001100" end
    if ch == 75: return "10001100101010011000101001001010001" end
    if ch == 76: return "10000100001000010000100001000011111" end
    if ch == 77: return "10001110111010110101100011000110001" end
    if ch == 78: return "10001110011010110011100011000110001" end
    if ch == 79: return "01110100011000110001100011000101110" end
    if ch == 80: return "11110100011000111110100001000010000" end
    if ch == 81: return "01110100011000110001101011001001101" end
    if ch == 82: return "11110100011000111110101001001010001" end
    if ch == 83: return "01111100001000001110000010000111110" end
    if ch == 84: return "11111001000010000100001000010000100" end
    if ch == 85: return "10001100011000110001100011000101110" end
    if ch == 86: return "10001100011000110001100010101000100" end
    if ch == 87: return "10001100011000110101101011101110001" end
    if ch == 88: return "10001100010101000100010101000110001" end
    if ch == 89: return "10001100010101000100001000010000100" end
    if ch == 90: return "11111000010001000100010001000011111" end
    if ch == 47: return "00001000100001000100010000100010000" end
    if ch == 45: return "00000000000000011111000000000000000" end
    if ch == 32: return "00000000000000000000000000000000000" end
    if ch == 33: return "00100001000010000100001000000000100" end
    if ch == 34: return "01010010100101000000000000000000000" end
    if ch == 35: return "01010111110101001010111110101000000" end
    if ch == 36: return "00100011111010001110001011111000100" end
    if ch == 37: return "11001110100010001000101100011000000" end
    if ch == 38: return "01100100101010001000101011001001101" end
    if ch == 39: return "00100001000100000000000000000000000" end
    if ch == 40: return "00010001000100001000010000010000010" end
    if ch == 41: return "01000001000001000010000100010001000" end
    if ch == 42: return "00000101010111011111011101010100000" end
    if ch == 43: return "00000001000010011111001000010000000" end
    if ch == 44: return "00000000000000000000001000010001000" end
    if ch == 46: return "00000000000000000000000000011000110" end
    if ch == 48: return "01110100011001110101110011000101110" end
    if ch == 49: return "00100011000010000100001000010001110" end
    if ch == 50: return "01110100010000100010001000100011111" end
    if ch == 51: return "11110000010000101110000010000111110" end
    if ch == 52: return "00010001100101010010111110001000010" end
    if ch == 53: return "11111100001000011110000010000111110" end
    if ch == 54: return "00110010001000011110100011000101110" end
    if ch == 55: return "11111000010001000100010000100001000" end
    if ch == 56: return "01110100011000101110100011000101110" end
    if ch == 57: return "01110100011000101111000010001001100" end
    if ch == 58: return "00000001100011000000001100011000000" end
    if ch == 59: return "00000001100011000000001000010001000" end
    if ch == 60: return "00010001000100010000010000010000010" end
    if ch == 61: return "00000000001111100000111110000000000" end
    if ch == 62: return "01000001000001000001000100010001000" end
    if ch == 63: return "01110100010000100010001000000000100" end
    if ch == 64: return "01110100011011110101101111000001110" end
    if ch == 91: return "01110010000100001000010000100001110" end
    if ch == 92: return "10000010000010000010000010000000000" end
    if ch == 93: return "01110000100001000010000100001001110" end
    if ch == 94: return "00100010101000100000000000000000000" end
    if ch == 95: return "00000000000000000000000000000011111" end
    if ch == 96: return "01000001000000000000000000000000000" end
    if ch == 97: return "00000000000111000001011111000101111" end
    if ch == 98: return "10000100001111010001100011000111110" end
    if ch == 99: return "00000000000111110000100001000001111" end
    if ch == 100: return "00001000010111110001100011000101111" end
    if ch == 101: return "00000000000111010001111111000001111" end
    if ch == 102: return "00110010010100011100010000100001000" end
    if ch == 103: return "00000011111000110001011110000101110" end
    if ch == 104: return "10000100001111010001100011000110001" end
    if ch == 105: return "00100000000110000100001000010001110" end
    if ch == 106: return "00010000000011000010000101001001100" end
    if ch == 107: return "10000100001001010100110001010010010" end
    if ch == 108: return "01100001000010000100001000010001110" end
    if ch == 109: return "00000000001101010101101011010110101" end
    if ch == 110: return "00000000001111010001100011000110001" end
    if ch == 111: return "00000000000111010001100011000101110" end
    if ch == 112: return "00000111101000110001111101000010000" end
    if ch == 113: return "00000011111000110001011110000100001" end
    if ch == 114: return "00000000001011011001100001000010000" end
    if ch == 115: return "00000000000111110000011100000111110" end
    if ch == 116: return "01000010001110001000010000100100110" end
    if ch == 117: return "00000000001000110001100011000101111" end
    if ch == 118: return "00000000001000110001100010101000100" end
    if ch == 119: return "00000000001000110001101011010101010" end
    if ch == 120: return "00000000001000101010001000101010001" end
    if ch == 121: return "00000100011000110001011110000101110" end
    if ch == 122: return "00000000001111100010001000100011111" end
    if ch == 123: return "00010001000010001000001000010000010" end
    if ch == 124: return "00100001000010000100001000010000100" end
    if ch == 125: return "01000001000010000010001000010001000" end
    if ch == 126: return "00000000000100110110000000000000000" end
    return "11111100011010110101101011000111111"
end

func pixel_letter(c, glyph, x, y, scale, i):
    if i == 35: return 0 end
    if index(glyph, i) == 49:
        let drawn = x11_rect(c, x + (i % 5) * scale, y + (i / 5) * scale, scale, scale)
    end
    return pixel_letter(c, glyph, x, y, scale, i + 1)
end

func pixel_text_loop(c, text, x, y, scale, i):
    if i == length(text): return 0 end
    let drawn = pixel_letter(c, pixel_glyph(index(text, i)), x + i * 6 * scale, y, scale, 0)
    return pixel_text_loop(c, text, x, y, scale, i + 1)
end

func pixel_text(c, text, x, y, scale):
    return pixel_text_loop(c, text, x, y, scale, 0)
end

-- Fixed buffer text, without freezing/copying into a temporary string.
func pixel_text_buffer_loop(c, b, offset, count, x, y, scale, i):
    if i == count: return 0 end
    let drawn = pixel_letter(c, pixel_glyph(buffer_get(b, offset + i)), x + i * 6 * scale, y, scale, 0)
    return pixel_text_buffer_loop(c, b, offset, count, x, y, scale, i + 1)
end

func pixel_text_buffer(c, b, offset, count, x, y, scale):
    let checked = linux_require_range(b, offset, count)
    return pixel_text_buffer_loop(c, b, offset, count, x, y, scale, 0)
end

-- Bounded recursion (at most 20 digits for uint64), with no temporary strings.
-- Returns the next x coordinate, allowing callers to place a suffix.
func pixel_number(c, n, x, y, scale):
    let at = x
    if n >= 10: at = pixel_number(c, n / 10, x, y, scale) end
    let drawn = pixel_letter(c, pixel_glyph(48 + n % 10), at, y, scale, 0)
    return at + 6 * scale
end
