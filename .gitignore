build/
__pycache__/
*.pyc

# Kernel-blob generator scripts (gen_<link>_blob.py): not repository content. Each
# printed a multiboot32-<link> blob block for stack/i386_oracle/i386_targets.herb (see
# its "Machine-generated from <link>_ref.build_elf() by gen_<link>_blob.py" comments).
# The blobs rebuild from the tracked *_ref.py builders alone; no generator is tracked here.
bootstrap/tests/gen_*_blob.py

# Optional raw kernel-gate captures.
_kernel_evidence/

# Retained developer compiler evidence stays on disk, outside version control.
.herbert-build.*/

# Previous generated compiler-source snapshots are retained by explicit assembly.
/stack/.compiler-source.*/

# Failed seed-publication staging is retained as local recovery evidence.
/bootstrap/seed/.reseed.*/

# Notes writes these beside the document it opens; never repository content.
.herbert-notes-*/
herbert-rescue-*.txt
.herbert-save-*.tmp
