-- Modulo-by-zero TRAP probe. Same shape as divzero but `%`. Fed a zero second
-- byte, the modulo divisor is zero: exit 1, empty stdout, no #DE crash (graded
-- by link15), and `herbert: line 8: division by zero` on stderr (not graded).
func main():
    let inp = clogger()
    let a = index(inp, 0)
    let b = index(inp, 1)
    return a % b
end
