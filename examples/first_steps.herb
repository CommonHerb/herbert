-- Hosted checkpoint: a normal window, responsive character, repeated drawing.
-- Linked with lib/linux.herb, lib/x11.herb and lib/pixel_text.herb by Make.
-- Application logic lives here; the compiler knows nothing about this example.
-- World coordinates remain bounded; every frame reuses the same byte buffers.

func first_grid_columns(c, x):
    while x < 614:
        do x11_rect(c, x, 102, 1, 316)
        x = x + 32
    end
    return 0
end

func first_grid_rows(c, y):
    while y < 418:
        do x11_rect(c, 26, y, 588, 1)
        y = y + 32
    end
    return 0
end

func first_draw(c, x, y, tick):
    do x11_color(c, 1054759)
    do x11_rect(c, 0, 0, 640, 480)
    do x11_color(c, 15265527)
    do pixel_text(c, "HERBERT", 28, 27, 3)
    do x11_color(c, 8820395)
    do pixel_text(c, "FIRST STEPS", 192, 40, 1)
    do pixel_text(c, "MOVE AROUND", 28, 80, 1)
    do x11_color(c, 2767956)
    do x11_rect(c, 24, 100, 592, 320)
    do x11_color(c, 1384240)
    do x11_rect(c, 26, 102, 588, 316)
    do x11_color(c, 1977151)
    do first_grid_columns(c, 56)
    do first_grid_rows(c, 132)
    do x11_color(c, 660510)
    do x11_ellipse(c, x - 15, y + 10, 32, 10)
    -- Gold is unique to the character, permitting independent pixel checks.
    do x11_color(c, 16173151)
    do x11_ellipse(c, x - 14, y - 14, 28, 28)
    do x11_color(c, 1054759)
    let eyeheight = 6
    if tick % 180 >= 174: eyeheight = 2 end
    do x11_rect(c, x - 6, y - 5, 3, eyeheight)
    do x11_rect(c, x + 3, y - 5, 3, eyeheight)
    do x11_color(c, 11255503)
    do pixel_text(c, "ARROWS / WASD", 28, 441, 1)
    do pixel_text(c, "ESC TO CLOSE", 538 - 12 * 6, 441, 1)
    do x11_color(c, 5793911)
    do pixel_text(c, "MADE IN HERBERT", 28, 462, 1)
    -- A small breathing indicator makes ongoing idle updates visible too.
    let pulse = 3832176
    if tick % 60 >= 30: pulse = 6867876 end
    do x11_color(c, pulse)
    do x11_ellipse(c, 600, 40, 8, 8)
    return x11_present(c)
end

func first_position(value, decrease, increase, low, high):
    if decrease and not increase:
        if value <= low + 3: return low end
        return value - 3
    elif increase and not decrease:
        if value + 3 >= high: return high end
        return value + 3
    end
    return value
end

-- A quick Escape press and release can both arrive in one event drain, so the
-- held-key state alone can miss it. Ordered presses survive that; movement
-- keys still read held state below.
func first_escape(c, event):
    while x11_next_key(c, event):
        if linux_u32(event, 0) == 65307: return true end
    end
    return false
end

func first_loop(c, x, y, tick, last, event):
    while true:
        do x11_events(c)
        if x11_closed(c) or first_escape(c, event):
            let closed = x11_close(c)
            do x11_need(closed == 0, "desktop: display close failed\n")
            do process_exit(0)
            return 0
        end
        let now = linux_clock_ms(c.clock)
        do x11_need(not linux_error(now), "desktop: monotonic clock failed\n")
        if now - last < 16:
            let waited = linux_poll(c.state.fd, c.poll, 1, 16 - (now - last))
            do x11_need(not linux_error(waited) or waited == 0 - 4, "desktop: input wait failed\n")
        else:
            let nx = first_position(x, x11_key(c, 65361) or x11_key(c, 97), x11_key(c, 65363) or x11_key(c, 100), 42, 598)
            let ny = first_position(y, x11_key(c, 65362) or x11_key(c, 119), x11_key(c, 65364) or x11_key(c, 115), 118, 402)
            do first_draw(c, nx, ny, tick)
            x = nx
            y = ny
            tick = (tick + 1) % 180
            last = now
        end
    end
    return 0
end

func main():
    let c = x11_open(640, 480, "Herbert - First steps")
    do x11_enable_text(c)
    let event = linux_buffer(16)
    do first_draw(c, 320, 270, 0)
    let now = linux_clock_ms(c.clock)
    do x11_need(not linux_error(now), "desktop: monotonic clock failed\n")
    return first_loop(c, 320, 270, 1, now, event)
end
