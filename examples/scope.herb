-- Scope: a window on this machine and the owner's other computers. It shows
-- the machine's name, how busy its processor is, how much of its memory is in
-- use, how full the disk it runs from is and how warm its drive and processor
-- are, read again once a second, and whether each other computer listed in
-- ~/.config/herbert/computers.txt answers, knocked every 5 seconds without
-- the window ever waiting for one; a computer that runs Scope's helper
-- (examples/scope_helper.herb) on the port it is knocked at answers with its
-- own processor and memory figures, which its row then shows. Linked after
-- lib/linux.herb, lib/x11.herb, lib/pixel_text.herb, lib/text.herb,
-- lib/net.herb and lib/figures.herb by Make.
-- Every buffer and record is built at startup. A frame reads each /proc file
-- through the one fixed 4096-byte chunk of lib/figures.herb's scanner, a byte
-- at a time, keeping only the numbers it wants, asks statfs about the disk into
-- one fixed 120-byte answer, reads each temperature into one fixed 32-byte
-- buffer, and draws from fixed text buffers; each computer has one Net for all
-- its knocks, and the figures its helper sends are read from that Net's fixed
-- reply buffer. So a run of days allocates nothing after startup.

-- The window's state. The three paths are NUL-terminated; scan reads them
-- (lib/figures.herb), and its name buffer holds this computer's name, host_count
-- bytes of it. cpu_state is 0 while a second processor sample is awaited (a
-- dash), 1 with a reading, 2 when /proc/stat cannot be read or used; mem_state
-- is 1 or 2 the same way. prev holds the last processor sample's eight
-- counters, as the scanner's counts does, and prev_total their sum: where the
-- next interval starts.
-- The three text buffers hold exactly what the window draws for the processor,
-- memory and the memory detail line; interval is the time between samples, ms.
-- disk and heat are the disk row and the temperature line, read with the rest.
ref record Scope:
    stat_path: buffer
    meminfo_path: buffer
    host_path: buffer
    scan: FiguresScan
    host_count: int
    host_ok: bool
    have_prev: bool
    prev_total: int
    prev: buffer
    cpu_state: int
    cpu_percent: int
    mem_state: int
    mem_percent: int
    mem_used: int
    mem_total: int
    cpu_text: buffer
    cpu_count: int
    mem_text: buffer
    mem_count: int
    detail: buffer
    detail_count: int
    interval: int
    list: ScopeList
    disk: ScopeDisk
    heat: ScopeHeat
end

-- The disk this computer runs from, as Linux's statfs system call
-- (linux_statfs) gives it for path, NUL-terminated: "/" in the window, empty
-- (which statfs refuses) in the --test forms that name no disk. answer is
-- statfs's 120-byte struct statfs (x86-64), the 64-bit words at 8, 16, 24, 32
-- and 72 being f_bsize, f_blocks, f_bfree, f_bavail and f_frsize. state is 1
-- with a reading, 2 when statfs failed or its figures cannot be shown; percent
-- is the part in use, size and free are KiB. text and detail hold what the
-- window draws for the row and the line under it.
ref record ScopeDisk:
    path: buffer
    answer: buffer
    state: int
    percent: int
    size: int
    free: int
    text: buffer
    count: int
    detail: buffer
    detail_count: int
end

-- One temperature, from Linux's hwmon files. found is whether startup found
-- its device: hwmon number which, kind 1 nvme (the drive), 2 k10temp or 3
-- coretemp (the processor); path is its temp1_input, NUL-terminated, the one
-- file read again at each sample. warning and critical are the drive's
-- temp1_max and temp1_crit, read once at startup, in millidegrees Celsius, 0
-- for none. state is 1 with a reading (reading, in millidegrees), 2 for n/a.
ref record ScopeSensor:
    found: bool
    which: int
    kind: int
    path: buffer
    warning: int
    critical: int
    state: int
    reading: int
end

-- The temperature line: the drive and the processor, line the bytes read from
-- a sensor's file (32, more than a reading needs), and text what the window
-- draws, count bytes: the drive's part, drive_count bytes, then the
-- processor's. A part whose device was not found is left out.
ref record ScopeHeat:
    drive: ScopeSensor
    processor: ScopeSensor
    line: buffer
    text: buffer
    drive_count: int
    count: int
end

-- One other computer: where to knock (address and port, as net_ipv4 and
-- net_port read them), its own Net, made once, and what its row shows. shown
-- is the outcome of its last finished knock (0 to 4, as in lib/net.herb), or 5
-- until the first one ends ("checking"); error is that knock's Linux error.
-- due is when its next knock starts, in ms on the window's clock; note holds
-- "Linux error N" for an error that has no words in net_error_name.
-- figures is true when that knock read a reply from the computer's helper
-- (figures_reply_read): the row then shows text, text_count bytes, instead of
-- "answers". The fields from have_prev to mem_total are the computer's
-- processor and memory, kept by scope_cpu and scope_memory exactly as the
-- window's own are; counts is the reply's processor reading as scope_cpu reads
-- counters (BUSY first, the rest of TOTAL fourth, as idle).
ref record ScopeComputer:
    address: int
    port: int
    net: Net
    shown: int
    error: int
    due: int
    note: buffer
    figures: bool
    have_prev: bool
    prev_total: int
    prev: buffer
    counts: buffer
    cpu_state: int
    cpu_percent: int
    mem_state: int
    mem_percent: int
    mem_used: int
    mem_total: int
    text: buffer
    text_count: int
end

-- A row of the other computers' section. kind 0 is a computer (which is its
-- index; main is its name and detail its address, which only scope
-- --computers prints: the window shows the name alone), 1 a problem with the
-- list (main in amber), 2 a note (main in grey). The texts are made at startup.
ref record ScopeRow:
    kind: int
    which: int
    main: buffer
    main_count: int
    detail: buffer
    detail_count: int
end

-- The other computers, read once at startup: at most six, in the list's
-- order, and the rows that show them, at most eight (the computers, then the
-- problems, or one note). problems counts the lines that could not be used;
-- lines and reasons hold the first eight of them. every and limit are the
-- knocks' interval and time limit in ms; polls holds the pollfd entries the
-- window waits on, its display and up to six knocks.
ref record ScopeList:
    computers: array(ScopeComputer)
    rows: array(ScopeRow)
    problems: int
    lines: array(int)
    reasons: array(int)
    every: int
    limit: int
    polls: buffer
end

func scope_list_new(every, limit):
    return ScopeList(new_array(ScopeComputer), new_array(ScopeRow), 0, new_array(int), new_array(int), every, limit, linux_buffer(56))
end

-- A disk, the one holding path, and a temperature line with no device found;
-- the window's own are set up by scope_watch.
func scope_disk_new(path):
    return ScopeDisk(linux_cstring(path), linux_buffer(120), 2, 0, 0, 0, linux_buffer(32), 0, linux_buffer(96), 0)
end

func scope_sensor_new():
    return ScopeSensor(false, 0, 0, linux_buffer(1), 0, 0, 2, 0)
end

func scope_heat_new():
    return ScopeHeat(scope_sensor_new(), scope_sensor_new(), linux_buffer(32), linux_buffer(64), 0, 0)
end

func scope_new(stat, meminfo, host, interval):
    return Scope(linux_cstring(stat), linux_cstring(meminfo), linux_cstring(host), figures_scan_new(), 0, false, false, 0, linux_buffer(64), 0, 0, 2, 0, 0, 0, linux_buffer(96), 0, linux_buffer(96), 0, linux_buffer(96), 0, interval, scope_list_new(5000, 2000), scope_disk_new(""), scope_heat_new())
end

-- A computer to knock at address and port, with its Net and buffers.
func scope_computer_new(address, port):
    return ScopeComputer(address, port, net_new(), 5, 0, 0, linux_buffer(24), false, false, 0, linux_buffer(64), linux_buffer(64), 0, 0, 2, 0, 0, 0, linux_buffer(32), 0)
end

-- This computer's name, from host_path, into the scanner's name buffer.
func scope_read_host(st):
    st.host_count = figures_read_name(st.scan, st.host_path)
    st.host_ok = st.host_count > 0
    return 0
end

-- part / whole as a whole percent, to the nearest, a half rounding up, exact
-- for any 64-bit numbers; whole is above zero and part not above it. 100 *
-- part is never formed: part is added up 100 times modulo whole, rest staying
-- below whole and the sum never passing 2^64, and the wraps counted are the
-- quotient. Then rest is the remainder, and rest >= whole - rest says it is at
-- least half of whole.
func scope_percent(part, whole):
    let quotient = 0
    let rest = 0
    let i = 0
    while i < 100:
        if part >= whole - rest:
            rest = part - (whole - rest)
            quotient = quotient + 1
        else:
            rest = rest + part
        end
        i = i + 1
    end
    if rest >= whole - rest: return quotient + 1 end
    return quotient
end

-- A new processor sample, whose eight counters are in counts and sum to
-- total. Each counter's change since the last sample is its time in the
-- interval; a counter that went back, as iowait can, counts none. spent is all
-- of it and worked all but idle (the 4th) and iowait (the 5th). The first
-- sample, and one whose total went back (the counters restart only with the
-- computer, which ends Scope too), show a dash for one interval. When no
-- time was counted the figure stays as it was, so nothing divides by zero.
-- Every sample becomes the start of the next interval. st is the window's
-- state, for this computer, or a ScopeComputer, for another one's helper.
func scope_cpu(st, ok, total, counts):
    if not ok:
        st.cpu_state = 2
        st.have_prev = false
        return 0
    end
    if not st.have_prev or total < st.prev_total:
        st.cpu_state = 0
    else:
        let spent = 0
        let worked = 0
        let i = 0
        while i < 8:
            let now = linux_u64(counts, i * 8)
            let before = linux_u64(st.prev, i * 8)
            if now > before:
                spent = spent + (now - before)
                if i != 3 and i != 4: worked = worked + (now - before) end
            end
            i = i + 1
        end
        if spent != 0:
            st.cpu_percent = scope_percent(worked, spent)
            st.cpu_state = 1
        end
    end
    do linux_copy(st.prev, 0, counts, 0, 64)
    st.prev_total = total
    st.have_prev = true
    return 0
end

-- Memory in use is MemTotal less MemAvailable, none if more is available than
-- there is. st is the window's state or a ScopeComputer, as for scope_cpu.
func scope_memory(st, ok, total, available):
    if not ok:
        st.mem_state = 2
        return 0
    end
    let used = 0
    if available < total: used = total - available end
    st.mem_used = used
    st.mem_total = total
    st.mem_percent = scope_percent(used, total)
    st.mem_state = 1
    return 0
end

-- What the window shows, into the fixed text buffers.
func scope_texts(st):
    if st.cpu_state == 0:
        st.cpu_count = text_put(st.cpu_text, 0, "-")
    elif st.cpu_state == 1:
        st.cpu_count = text_put(st.cpu_text, text_put_whole(st.cpu_text, 0, st.cpu_percent), "%")
    else:
        st.cpu_count = text_put(st.cpu_text, 0, "unavailable")
    end
    if st.mem_state != 1:
        st.mem_count = text_put(st.mem_text, 0, "unavailable")
        st.detail_count = 0
        return 0
    end
    st.mem_count = text_put(st.mem_text, text_put_whole(st.mem_text, 0, st.mem_percent), "%")
    let unit = 1048576
    let name = " GiB"
    if st.mem_total < 1048576:
        unit = 1024
        name = " MiB"
    end
    let at = text_put_tenths(st.detail, 0, st.mem_used, unit)
    at = text_put(st.detail, at, name)
    at = text_put(st.detail, at, " of ")
    at = text_put_tenths(st.detail, at, st.mem_total, unit)
    at = text_put(st.detail, at, name)
    st.detail_count = text_put(st.detail, at, " in use")
    return 0
end

-- n blocks of f bytes, in KiB, rounded down: (fits, kib). n * f is never
-- formed. With n = 1024 a + b and f = 1024 q + r it is n q + a r + b r / 1024,
-- rounded down; a r is below 2^54 * 2^10 and b r below 2^20, so only n q and
-- the sum can pass 2^64, and both are checked.
func scope_kib(n, f):
    let q = f / 1024
    let r = f % 1024
    if q != 0 and n > (0 - 1) / q: return (false, 0) end
    let whole = n * q
    let rest = (n / 1024) * r + ((n % 1024) * r) / 1024
    if whole + rest < whole: return (false, 0) end
    return (true, whole + rest)
end

-- statfs's figures as df works them out (through statvfs): blocks of frsize
-- bytes, the disk's size blocks, in use blocks less bfree (none if more is
-- free than there is), and free bavail, what an ordinary user may still
-- write. The percent is in use over in use and free, so the blocks Linux keeps
-- back for the system count as neither, as in df, and the block size cancels
-- out of it; with nothing in use and nothing free (all kept back) the disk is
-- full for the owner, 100 %. A disk of no blocks or blocks of no bytes, or
-- figures too large for 64 bits in KiB, cannot be shown.
func scope_disk_figures(disk, ok, blocks, bfree, bavail, frsize):
    disk.state = 2
    if not ok or blocks == 0 or frsize == 0: return 0 end
    let used = 0
    if bfree < blocks: used = blocks - bfree end
    if bavail > (0 - 1) - used: return 0 end
    let size = scope_kib(blocks, frsize)
    let free = scope_kib(bavail, frsize)
    if not size.0 or not free.0: return 0 end
    disk.size = size.1
    disk.free = free.1
    disk.percent = 100
    if used + bavail != 0: disk.percent = scope_percent(used, used + bavail) end
    disk.state = 1
    return 0
end

-- statfs on the disk's path, into its fixed answer: (asked, blocks, bfree,
-- bavail, frsize), f_bsize standing in for an f_frsize of zero, as statvfs
-- does. asked is false when statfs refused.
func scope_statfs(disk):
    let got = linux_statfs(disk.path, disk.answer)
    if linux_error(got): return (false, 0, 0, 0, 0) end
    let frsize = linux_u64(disk.answer, 72)
    if frsize == 0: frsize = linux_u64(disk.answer, 8) end
    return (true, linux_u64(disk.answer, 16), linux_u64(disk.answer, 24), linux_u64(disk.answer, 32), frsize)
end

-- What the disk row shows: "54%", and under it "413.2 GiB free of 936.8 GiB"
-- (in MiB for a disk under 1 GiB), or "unavailable" and nothing under it.
func scope_disk_texts(disk):
    if disk.state != 1:
        disk.count = text_put(disk.text, 0, "unavailable")
        disk.detail_count = 0
        return 0
    end
    disk.count = text_put(disk.text, text_put_whole(disk.text, 0, disk.percent), "%")
    let unit = 1048576
    let name = " GiB"
    if disk.size < 1048576:
        unit = 1024
        name = " MiB"
    end
    let at = text_put_tenths(disk.detail, 0, disk.free, unit)
    at = text_put(disk.detail, at, name)
    at = text_put(disk.detail, at, " free of ")
    at = text_put_tenths(disk.detail, at, disk.size, unit)
    disk.detail_count = text_put(disk.detail, at, name)
    return 0
end

func scope_disk_sample(disk):
    let asked = scope_statfs(disk)
    do scope_disk_figures(disk, asked.0, asked.1, asked.2, asked.3, asked.4)
    return scope_disk_texts(disk)
end

-- Up to buffer_length(b) bytes from the start of the file at path
-- (NUL-terminated), into b: (readable, bytes read). It is opened without
-- blocking (O_NONBLOCK), so a FIFO put in its place cannot hold the window.
-- Allocates nothing.
func scope_read_small(path, b):
    let fd = linux_open(path, linux_o_nonblock() | linux_o_cloexec(), 0)
    if linux_error(fd): return (false, 0) end
    let n = 0
    let ok = true
    let going = true
    while going:
        let got = linux_read(fd, b, n, buffer_length(b) - n)
        if got != 0 - 4:
            if linux_error(got) or got > buffer_length(b) - n:
                ok = false
                going = false
            elif got == 0:
                going = false
            else:
                n = n + got
                going = n < buffer_length(b)
            end
        end
    end
    do linux_close(fd)
    return (ok, n)
end

-- The file at path, read into b, as a whole number in plain decimal, as Linux
-- writes a sensor's file: digits only, at least one, below 2^64, and at most
-- one newline after them; a sign, a space or anything else, an empty file, or
-- a file that fills b (it may go on) is not plain. (plain, value).
func scope_read_value(path, b):
    let got = scope_read_small(path, b)
    let n = got.1
    if not got.0 or n == buffer_length(b): return (false, 0) end
    if n > 0 and buffer_get(b, n - 1) == 10: n = n - 1 end
    let value = text_whole(b, 0, n)
    if not value.0 or value.2 != n: return (false, 0) end
    return (true, value.1)
end

-- root/hwmonN/file into b, NUL-terminated; b holds length(root) + 32 bytes,
-- room for "/hwmon", two digits, "/", "temp1_input" and the NUL.
func scope_hwmon_path(b, root, which, file):
    let at = text_put_whole(b, text_put(b, text_put(b, 0, root), "/hwmon"), which)
    at = text_put(b, text_put(b, at, "/"), file)
    do buffer_set(b, at, 0)
    return at
end

-- The name file at path, into b: its length, less one newline after it; 0
-- when it cannot be read. A name longer than b is cut there, which no name
-- looked for is near.
func scope_name_read(path, b):
    let got = scope_read_small(path, b)
    let n = got.1
    if not got.0: return 0 end
    if n > 0 and buffer_get(b, n - 1) == 10: n = n - 1 end
    return n
end

func scope_sensor_found(sensor, root, which, kind):
    sensor.found = true
    sensor.which = which
    sensor.kind = kind
    sensor.path = linux_buffer(length(root) + 32)
    do scope_hwmon_path(sensor.path, root, which, "temp1_input")
    return 0
end

-- A limit of the drive's, in millidegrees, read once at startup: none (0) when
-- its file cannot be read or is not plain decimal, or it says 0 or more than
-- 200 °C (200000), which no drive means: this computer's drive says 65261850
-- for one of its other limits.
func scope_limit(path, b):
    let value = scope_read_value(path, b)
    if not value.0 or value.1 > 200000: return 0 end
    return value.1
end

-- The temperatures under root, the hwmon directory (/sys/class/hwmon), found
-- once, at startup, since Linux may number its devices differently at each
-- boot. Each of hwmon0 to hwmon63 is looked at, a number whose name file
-- cannot be read (a gap Linux leaves when a device goes) being skipped: the
-- drive is the first named nvme, its temp1_input the temperature the drive
-- judges its own limits by, and the processor the first k10temp (AMD), or else
-- the first coretemp (Intel). The drive's two limits are read here too.
func scope_heat_find(heat, root):
    let path = linux_buffer(length(root) + 32)
    let core = 64
    let which = 0
    while which < 64:
        do scope_hwmon_path(path, root, which, "name")
        let n = scope_name_read(path, heat.line)
        if not heat.drive.found and text_is(heat.line, 0, n, "nvme"):
            do scope_sensor_found(heat.drive, root, which, 1)
        elif not heat.processor.found and text_is(heat.line, 0, n, "k10temp"):
            do scope_sensor_found(heat.processor, root, which, 2)
        elif core == 64 and text_is(heat.line, 0, n, "coretemp"):
            core = which
        end
        which = which + 1
    end
    if not heat.processor.found and core < 64: do scope_sensor_found(heat.processor, root, core, 3) end
    let drive = heat.drive
    if drive.found:
        do scope_hwmon_path(path, root, drive.which, "temp1_max")
        drive.warning = scope_limit(path, heat.line)
        do scope_hwmon_path(path, root, drive.which, "temp1_crit")
        drive.critical = scope_limit(path, heat.line)
    end
    return 0
end

-- A sensor's temp1_input again: a reading, or n/a when it cannot be read or is
-- not plain decimal (a negative one included).
func scope_sensor_read(sensor, b):
    if not sensor.found: return 0 end
    let value = scope_read_value(sensor.path, b)
    sensor.state = 2
    if value.0:
        sensor.state = 1
        sensor.reading = value.1
    end
    return 0
end

-- Millidegrees as whole degrees, to the nearest, a half rounding up.
func scope_degrees(milli):
    if milli % 1000 >= 500: return milli / 1000 + 1 end
    return milli / 1000
end

-- The drive's shade: 0 green, more than 10 °C under its warning limit or with
-- no limit; 1 amber, within 10 °C under it; 2 red, at or above it; 3 grey,
-- n/a. Each compares the reading in millidegrees, as the drive itself does.
func scope_drive_shade(sensor):
    if sensor.state != 1: return 3 end
    let warning = sensor.warning
    if warning == 0: return 0 end
    if sensor.reading >= warning: return 2 end
    if warning <= 10000 or sensor.reading >= warning - 10000: return 1 end
    return 0
end

func scope_shade_ink(shade):
    if shade == 0: return 6867876 end
    if shade == 1: return 16173151 end
    if shade == 2: return 15680580 end
    return 11255503
end

func scope_heat_part(heat, at, name, sensor):
    at = text_put(heat.text, at, name)
    if sensor.state != 1: return text_put(heat.text, at, "n/a") end
    return text_put(heat.text, text_put_whole(heat.text, at, scope_degrees(sensor.reading)), " C")
end

-- What the temperature line shows: "DRIVE 35 C  PROCESSOR 39 C", a part
-- whose device was not found left out.
func scope_heat_texts(heat):
    let at = 0
    if heat.drive.found: at = scope_heat_part(heat, at, "DRIVE ", heat.drive) end
    heat.drive_count = at
    if heat.processor.found:
        if at > 0: at = text_put(heat.text, at, "  ") end
        at = scope_heat_part(heat, at, "PROCESSOR ", heat.processor)
    end
    heat.count = at
    return 0
end

func scope_heat_sample(heat):
    do scope_sensor_read(heat.drive, heat.line)
    do scope_sensor_read(heat.processor, heat.line)
    return scope_heat_texts(heat)
end

-- The window's own disk and temperatures: statfs on path, the sensors under
-- hwmon (startup only).
func scope_watch(st, hwmon, path):
    let disk = st.disk
    disk.path = linux_cstring(path)
    return scope_heat_find(st.heat, hwmon)
end

func scope_sample(st):
    let cpu = figures_read_stat(st.scan, st.stat_path)
    do scope_cpu(st, cpu.0, cpu.1, st.scan.counts)
    let mem = figures_read_meminfo(st.scan, st.meminfo_path)
    do scope_memory(st, mem.0, mem.1, mem.2)
    do scope_read_host(st)
    do scope_texts(st)
    do scope_disk_sample(st.disk)
    return scope_heat_sample(st.heat)
end

-- The list of other computers, read once at startup. It is opened without
-- blocking (O_NONBLOCK), so a FIFO cannot hold startup, and read only if it
-- is a regular file, and only up to 64 KiB: at most 65537 bytes are asked for,
-- the last only to learn whether the file ends there. (status, data, size):
-- status 0 read, 1 missing, 2 could not be read, 3 larger than 64 KiB.
func scope_list_file(path):
    let data = linux_buffer(65537)
    let fd = linux_open(path, linux_o_nonblock() | linux_o_cloexec(), 0)
    if fd == 0 - 2: return (1, data, 0) end
    if linux_error(fd): return (2, data, 0) end
    let stat = linux_buffer(144)
    let status = 0
    let got = linux_fstat(fd, stat)
    if linux_error(got) or (linux_u32(stat, 24) & linux_s_ifmt()) != linux_s_ifreg(): status = 2 end
    let size = 0
    let going = status == 0
    while going:
        let n = linux_read(fd, data, size, 65537 - size)
        if n != 0 - 4:
            if linux_error(n) or n > 65537 - size:
                status = 2
                going = false
            elif n == 0:
                going = false
            else:
                size = size + n
                going = size <= 65536
            end
        end
    end
    if status == 0 and size > 65536: status = 3 end
    do linux_close(fd)
    return (status, data, size)
end

-- A name is 1 to 24 bytes of printable ASCII other than the space.
func scope_name_ok(data, from, stop):
    if stop - from > 24: return false end
    while from < stop:
        let b = buffer_get(data, from)
        if b < 33 or b > 126: return false end
        from = from + 1
    end
    return true
end

func scope_row_add(list, kind, which):
    let row = ScopeRow(kind, which, linux_buffer(64), 0, linux_buffer(96), 0)
    do add(list.rows, row)
    return row
end

func scope_note(list, kind, main, detail):
    let row = scope_row_add(list, kind, 0)
    row.main_count = text_put(row.main, 0, main)
    row.detail_count = text_put(row.detail, 0, detail)
    return 0
end

-- A good line: its computer, with a Net of its own, and its row.
func scope_computer(list, data, from, stop, address, port):
    let row = scope_row_add(list, 0, count(list.computers))
    do linux_copy(row.main, 0, data, from, stop - from)
    row.main_count = stop - from
    let at = text_put(row.detail, net_put_address(row.detail, 0, address), " port ")
    row.detail_count = text_put_whole(row.detail, at, port)
    do add(list.computers, scope_computer_new(address, port))
    return 0
end

-- A line that cannot be used, and why: 1 not three words, 2 the name, 3 the
-- address, 4 the port, 5 a computer past the sixth. The first eight are kept.
func scope_problem(list, line, reason):
    if list.problems < 8:
        do add(list.lines, line)
        do add(list.reasons, reason)
    end
    list.problems = list.problems + 1
    return 0
end

-- One line, from to stop, without its newline (or a carriage return just
-- before it): blank, a comment (its first word starts with #), a computer, or
-- a problem. Words are separated by spaces and tabs.
func scope_list_line(list, data, from, stop, line):
    if stop > from and buffer_get(data, stop - 1) == 13: stop = stop - 1 end
    let name = text_field(data, from, stop)
    if name.0 == stop: return 0 end
    if buffer_get(data, name.0) == 35: return 0 end
    let address = text_field(data, name.1, stop)
    let port = text_field(data, address.1, stop)
    if port.0 == stop or text_skip(data, port.1, stop) != stop: return scope_problem(list, line, 1) end
    if not scope_name_ok(data, name.0, name.1): return scope_problem(list, line, 2) end
    let ip = net_ipv4(text_string(data, address.0, address.1))
    if not ip.0: return scope_problem(list, line, 3) end
    let number = net_port(text_string(data, port.0, port.1))
    if not number.0: return scope_problem(list, line, 4) end
    if count(list.computers) == 6: return scope_problem(list, line, 5) end
    return scope_computer(list, data, name.0, name.1, ip.1, number.1)
end

-- Lines end at a newline; a last line without one still counts.
func scope_list_parse(list, data, size):
    let line = 1
    let from = 0
    let at = 0
    while at < size:
        if buffer_get(data, at) == 10:
            do scope_list_line(list, data, from, at, line)
            line = line + 1
            from = at + 1
        end
        at = at + 1
    end
    if from < size: do scope_list_line(list, data, from, size, line) end
    return 0
end

func scope_reason(reason):
    if reason == 1: return "write a name, an address and a port, with spaces between" end
    if reason == 2: return "the name must be 1 to 24 characters, ASCII only, no spaces" end
    if reason == 3: return "the address must be four numbers 0 to 255 joined by dots" end
    if reason == 4: return "the port must be a number 1 to 65535" end
    return "Scope shows at most 6 other computers"
end

func scope_problem_row(list, line, reason):
    let row = scope_row_add(list, 1, 0)
    let at = text_put_whole(row.main, text_put(row.main, 0, "line "), line)
    if reason == 5:
        at = text_put(row.main, at, ": more than 6 listed")
    else:
        at = text_put(row.main, at, " not understood")
    end
    row.main_count = at
    row.detail_count = text_put(row.detail, 0, scope_reason(reason))
    return 0
end

-- After the computers come the problems, in the list's order. There are at
-- most eight rows: when the problems do not fit, the last row says how many
-- more there are and the line of the first of them.
func scope_list_rows(list, status):
    let none = "list them in ~/.config/herbert/computers.txt, one per line: name address port"
    if status == 1: return scope_note(list, 2, "none listed", none) end
    if status == 2: return scope_note(list, 1, "could not read the list", "~/.config/herbert/computers.txt") end
    if status == 3:
        return scope_note(list, 1, "could not read the list", "~/.config/herbert/computers.txt is over 64 KiB")
    end
    let room = 8 - count(list.computers)
    let shown = list.problems
    if shown > room: shown = room - 1 end
    let i = 0
    while i < shown:
        do scope_problem_row(list, get(list.lines, i), get(list.reasons, i))
        i = i + 1
    end
    if list.problems > shown:
        let row = scope_row_add(list, 1, 0)
        let at = text_put_whole(row.main, text_put(row.main, 0, "and "), list.problems - shown)
        row.main_count = text_put_whole(row.main, text_put(row.main, at, " more problems from line "), get(list.lines, shown))
    end
    if count(list.rows) == 0: return scope_note(list, 2, "none listed", none) end
    return 0
end

-- The list at path (NUL-terminated); have is false when there is no path
-- (HOME is not set), which shows as a list that could not be read.
func scope_list_load(list, have, path):
    if not have: return scope_list_rows(list, 2) end
    let file = scope_list_file(path)
    if file.0 == 0: do scope_list_parse(list, file.1, file.2) end
    return scope_list_rows(list, file.0)
end

-- The owner's list, $HOME/.config/herbert/computers.txt.
func scope_home_list(every, limit):
    let list = scope_list_new(every, limit)
    let home = linux_env(linux_environment(), "HOME")
    if length(home) == 0:
        do scope_list_load(list, false, linux_buffer(1))
        return list
    end
    let tail = "/.config/herbert/computers.txt"
    let path = linux_buffer(length(home) + length(tail) + 1)
    do linux_text(path, 0, home)
    do linux_text(path, length(home), tail)
    do scope_list_load(list, true, path)
    return list
end

func scope_file_list(path, every, limit):
    let list = scope_list_new(every, limit)
    do scope_list_load(list, true, linux_cstring(path))
    return list
end

-- The window is 640 wide; its height fits the rows and never changes.
func scope_height(list): return 552 + count(list.rows) * 34 end

-- What a computer's row shows with figures: "CPU 12%  MEM 41%", the processor
-- a dash until a second reply and either figure n/a when its helper could not
-- read it.
func scope_figures_text(it):
    let at = text_put(it.text, 0, "CPU ")
    if it.cpu_state == 0:
        at = text_put(it.text, at, "-")
    elif it.cpu_state == 1:
        at = text_put(it.text, text_put_whole(it.text, at, it.cpu_percent), "%")
    else:
        at = text_put(it.text, at, "n/a")
    end
    at = text_put(it.text, at, "  MEM ")
    if it.mem_state == 1:
        it.text_count = text_put(it.text, text_put_whole(it.text, at, it.mem_percent), "%")
    else:
        it.text_count = text_put(it.text, at, "n/a")
    end
    return 0
end

-- The knock's result into its computer's row; true if what the row shows
-- changed. A knock that was answered and read a well-formed reply, the whole
-- of what the computer sent before it closed the connection, gives the row
-- figures: the reply's processor reading goes through scope_cpu as two
-- counters, BUSY and the rest of TOTAL, and its memory through scope_memory,
-- the same steps as the window's own figures. Any other end drops the figures,
-- and the processor's two-reading history starts over.
func scope_result(it):
    let st = it.net.state
    let had = it.figures
    it.figures = false
    if st.outcome == 0 and st.closed:
        let reply = figures_reply_read(it.net.reply, st.got)
        if reply.0:
            do linux_put64(it.counts, 0, reply.3)
            do linux_put64(it.counts, 24, reply.2 - reply.3)
            do scope_cpu(it, reply.1, reply.2, it.counts)
            do scope_memory(it, reply.4, reply.5, reply.6)
            do scope_figures_text(it)
            it.figures = true
        end
    end
    if not it.figures: it.have_prev = false end
    let changed = it.shown != st.outcome or it.error != st.error or had or it.figures
    it.shown = st.outcome
    it.error = st.error
    return changed
end

-- Looks at every knock under way, without waiting, and starts the knocks that
-- are due: a computer is knocked again every list.every ms, start to start,
-- and never while its last knock is still under way. A row keeps its last
-- result until the next knock ends. True if any row changed.
func scope_knocks(list, now):
    let changed = false
    let i = 0
    while i < count(list.computers):
        let it = get(list.computers, i)
        let st = it.net.state
        if st.pending:
            if net_check(it.net) != 5:
                if scope_result(it): changed = true end
            end
        end
        if not st.pending and now >= it.due:
            it.due = now + list.every
            if net_start_reading(it.net, it.address, it.port, list.limit) != 5:
                if scope_result(it): changed = true end
            end
        end
        i = i + 1
    end
    return changed
end

-- What the window waits on, and for how long: its display, and every knock
-- under way, put into list.polls, each for its events (POLLOUT while it
-- connects, POLLIN while it reads a reply); at most wait ms (the time to the
-- next reading), less if a knock is due sooner or a pending knock's time limit
-- ends sooner (net_left, rounded up, so the look after the wait is at or past
-- it). (wait, entries).
func scope_wait(c, list, now, wait):
    let entries = linux_poll_entry(list.polls, 0, c.state.fd, 1)
    let i = 0
    while i < count(list.computers):
        let it = get(list.computers, i)
        let st = it.net.state
        if st.pending:
            entries = linux_poll_entry(list.polls, entries, st.fd, st.events)
            let left = net_left(it.net)
            if left < wait: wait = left end
        elif it.due <= now:
            wait = 0
        elif it.due - now < wait:
            wait = it.due - now
        end
        i = i + 1
    end
    return (wait, entries)
end

-- Gives up every knock still under way, before the window closes.
func scope_stop(list):
    let i = 0
    while i < count(list.computers):
        do net_stop(get(list.computers, i).net)
        i = i + 1
    end
    return 0
end

-- A bar is 400 pixels long, four to a percent shown.
func scope_bar_width(state, percent):
    if state == 1: return percent * 4 end
    return 0
end

func scope_ink(state):
    if state == 1: return 15265527 end
    if state == 2: return 16173151 end
    return 11255503
end

func scope_row(c, label, y, state, percent, text, count, fill):
    do x11_color(c, 15265527)
    do pixel_text(c, label, 46, y, 2)
    do x11_color(c, 2767956)
    do x11_rect(c, 46, y + 22, 400, 22)
    let width = scope_bar_width(state, percent)
    if width > 0:
        do x11_color(c, fill)
        do x11_rect(c, 46, y + 22, width, 22)
    end
    do x11_color(c, scope_ink(state))
    return pixel_text_buffer(c, text, 0, count, 464, y + 26, 2)
end

-- A computer's result, at (352, y): its helper's figures (in green), answers
-- (answered or refused, in green), checking (grey) until its first knock ends,
-- or no answer, unreachable or error in amber; under error, what Linux said.
func scope_status(c, it, y):
    let shown = it.shown
    if it.figures:
        do x11_color(c, 6867876)
        return pixel_text_buffer(c, it.text, 0, it.text_count, 352, y, 2)
    end
    if shown == 0 or shown == 1:
        do x11_color(c, 6867876)
        return pixel_text(c, "answers", 352, y, 2)
    end
    if shown == 5:
        do x11_color(c, 11255503)
        return pixel_text(c, "checking", 352, y, 2)
    end
    do x11_color(c, 16173151)
    if shown == 2: return pixel_text(c, "no answer", 352, y, 2) end
    if shown == 3: return pixel_text(c, "unreachable", 352, y, 2) end
    do pixel_text(c, "error", 352, y, 2)
    let name = net_error_name(it.error)
    if length(name) > 0: return pixel_text(c, name, 352, y + 19, 1) end
    let at = text_put(it.note, 0, "Linux error ")
    return pixel_text_buffer(c, it.note, 0, text_put_whole(it.note, at, it.error), 352, y + 19, 1)
end

-- The other computers' section, its panel ending at bottom: a row every 34
-- pixels, its main text at scale 2. A problem or a note has its detail 19
-- pixels under that at scale 1, saying what to fix; a computer shows its name
-- alone (the owner's choice), with its result to the right.
func scope_others(c, list, bottom):
    do x11_color(c, 8820395)
    do pixel_text(c, "OTHER COMPUTERS", 28, 442, 1)
    do x11_color(c, 2767956)
    do x11_rect(c, 24, 458, 592, bottom - 458)
    do x11_color(c, 1384240)
    do x11_rect(c, 26, 460, 588, bottom - 462)
    let i = 0
    while i < count(list.rows):
        let row = get(list.rows, i)
        let y = 472 + i * 34
        let ink = 15265527
        if row.kind == 1: ink = 16173151 end
        if row.kind == 2: ink = 11255503 end
        do x11_color(c, ink)
        do pixel_text_buffer(c, row.main, 0, row.main_count, 46, y, 2)
        if row.kind == 0:
            do scope_status(c, get(list.computers, row.which), y)
        else:
            do x11_color(c, 11255503)
            do pixel_text_buffer(c, row.detail, 0, row.detail_count, 46, y + 19, 1)
        end
        i = i + 1
    end
    return 0
end

-- The temperature line at (46, y), scale 2: the drive's part in its shade,
-- then the processor's in white (grey for n/a), after it.
func scope_heat_draw(c, heat, y):
    if heat.drive_count > 0:
        do x11_color(c, scope_shade_ink(scope_drive_shade(heat.drive)))
        do pixel_text_buffer(c, heat.text, 0, heat.drive_count, 46, y, 2)
    end
    if heat.count > heat.drive_count:
        let ink = 15265527
        if heat.processor.state != 1: ink = 11255503 end
        do x11_color(c, ink)
        do pixel_text_buffer(c, heat.text, heat.drive_count, heat.count - heat.drive_count, 46 + heat.drive_count * 12, y, 2)
    end
    return 0
end

func scope_draw(c, st, pulse):
    let bottom = 478 + count(st.list.rows) * 34
    do x11_color(c, 1054759)
    do x11_rect(c, 0, 0, 640, bottom + 74)
    do x11_color(c, 15265527)
    do pixel_text(c, "HERBERT", 28, 27, 3)
    do x11_color(c, 8820395)
    do pixel_text(c, "SCOPE", 192, 40, 1)
    do pixel_text(c, "THIS COMPUTER", 28, 80, 1)
    if st.host_ok:
        let scale = 2
        if st.host_count > 48: scale = 1 end
        do x11_color(c, 15265527)
        do pixel_text_buffer(c, st.scan.name, 0, st.host_count, 28, 96, scale)
    else:
        do x11_color(c, 16173151)
        do pixel_text(c, "unavailable", 28, 96, 2)
    end
    do x11_color(c, 2767956)
    do x11_rect(c, 24, 128, 592, 292)
    do x11_color(c, 1384240)
    do x11_rect(c, 26, 130, 588, 288)
    do scope_row(c, "PROCESSOR", 146, st.cpu_state, st.cpu_percent, st.cpu_text, st.cpu_count, 6867876)
    do scope_row(c, "MEMORY", 212, st.mem_state, st.mem_percent, st.mem_text, st.mem_count, 7317724)
    do x11_color(c, 11255503)
    do pixel_text_buffer(c, st.detail, 0, st.detail_count, 46, 270, 1)
    do scope_row(c, "DISK", 300, st.disk.state, st.disk.percent, st.disk.text, st.disk.count, 11833005)
    do x11_color(c, 11255503)
    do pixel_text_buffer(c, st.disk.detail, 0, st.disk.detail_count, 46, 358, 1)
    do scope_heat_draw(c, st.heat, 388)
    do scope_others(c, st.list, bottom)
    do x11_color(c, 11255503)
    do pixel_text(c, "ESC OR Q TO CLOSE", 28, bottom + 22, 1)
    do x11_color(c, 5793911)
    do pixel_text(c, "MADE IN HERBERT", 28, bottom + 44, 1)
    -- The small light changes at every new sample, so a running window shows it.
    let light = 3832176
    if pulse == 1: light = 6867876 end
    do x11_color(c, light)
    do x11_ellipse(c, 600, 40, 8, 8)
    return x11_present(c)
end

-- Escape, q or Q. Every queued press is read, so none is left for later.
func scope_quit(c, event):
    let quit = false
    while x11_next_key(c, event):
        let key = linux_u32(event, 0)
        if key == 65307 or key == 113 or key == 81: quit = true end
    end
    return quit
end

-- The window's loop. It waits on its display and on every knock under way
-- together (scope_wait), so input, readings and knocks never wait for each
-- other: the wait ends at a key or other display event, a knock that ends, a
-- knock's time limit, a knock that is due, or the next reading.
func scope_loop(c, st, event, last, pulse):
    let list = st.list
    while true:
        do x11_events(c)
        if x11_closed(c) or scope_quit(c, event):
            do scope_stop(list)
            let closed = x11_close(c)
            do x11_need(closed == 0, "scope: display close failed\n")
            do process_exit(0)
            return 0
        end
        let now = linux_clock_ms(c.clock)
        do x11_need(not linux_error(now), "scope: monotonic clock failed\n")
        let changed = scope_knocks(list, now)
        if now - last >= st.interval:
            do scope_sample(st)
            pulse = 1 - pulse
            do scope_draw(c, st, pulse)
            last = now
        elif changed:
            do scope_draw(c, st, pulse)
        elif x11_exposed(c):
            do x11_present(c)
        end
        do x11_ack_expose(c)
        let plan = scope_wait(c, list, now, st.interval - (now - last))
        let waited = linux_poll_many(list.polls, plan.1, plan.0)
        do x11_need(not linux_error(waited) or waited == 0 - 4, "scope: input wait failed\n")
    end
    return 0
end

func scope_window(st, list):
    st.list = list
    do scope_sample(st)
    let c = x11_open(640, scope_height(list), "Herbert - Scope")
    do x11_enable_text(c)
    let event = linux_buffer(16)
    do scope_draw(c, st, 0)
    let now = linux_clock_ms(c.clock)
    do x11_need(not linux_error(now), "scope: monotonic clock failed\n")
    return scope_loop(c, st, event, now, 0)
end

-- Test mode output, built once with lib/text.herb's growing writers; nothing
-- here runs in the window.
func scope_out_pair(out, label, reading):
    do text_add(out, label)
    if not reading.0: return text_add(out, "=unavailable\n") end
    do text_add(out, "=")
    do text_add_whole(out, reading.1)
    do text_add(out, " ")
    do text_add_whole(out, reading.2)
    return text_add(out, "\n")
end

-- scope --sample STAT1 STAT2 [STAT3 ...] MEMINFO HOSTNAME: the processor
-- samples in order, the memory figures and the name go through the same steps
-- as the window's, and what the window would then show is printed, one
-- "name=value" line each; there are count - 4 processor samples.
func scope_sample_mode(args, count):
    let st = scope_new(linux_argument(args, 2), linux_argument(args, count - 2), linux_argument(args, count - 1), 1000)
    let out = new_buffer()
    let k = 2
    while k < count - 2:
        if k > 2: st.stat_path = linux_cstring(linux_argument(args, k)) end
        let reading = figures_read_stat(st.scan, st.stat_path)
        do scope_cpu(st, reading.0, reading.1, st.scan.counts)
        do text_add(out, "stat")
        do text_add_whole(out, k - 1)
        do scope_out_pair(out, "", reading)
        k = k + 1
    end
    let mem = figures_read_meminfo(st.scan, st.meminfo_path)
    do scope_memory(st, mem.0, mem.1, mem.2)
    do scope_out_pair(out, "meminfo", mem)
    do scope_read_host(st)
    do scope_texts(st)
    do text_add(out, "host=")
    if st.host_ok:
        do text_add_span(out, st.scan.name, 0, st.host_count)
    else:
        do text_add(out, "unavailable")
    end
    do text_add(out, "\nprocessor=")
    do text_add_span(out, st.cpu_text, 0, st.cpu_count)
    do text_add(out, "\nprocessor-bar=")
    do text_add_whole(out, scope_bar_width(st.cpu_state, st.cpu_percent))
    do text_add(out, "\nmemory=")
    do text_add_span(out, st.mem_text, 0, st.mem_count)
    do text_add(out, "\nmemory-bar=")
    do text_add_whole(out, scope_bar_width(st.mem_state, st.mem_percent))
    do text_add(out, "\ndetail=")
    do text_add_span(out, st.detail, 0, st.detail_count)
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end

-- scope --computers [FILE]: what the list of other computers (FILE, or the
-- owner's) means, one line a row, "kind<TAB>main<TAB>detail" (kind computer,
-- problem or note), then the window's height. The window draws main and, for
-- a problem or a note, detail; a computer's detail is the address and port it
-- is knocked at, printed here only. No knock is made.
func scope_list_mode(list):
    let out = new_buffer()
    let i = 0
    while i < count(list.rows):
        let row = get(list.rows, i)
        if row.kind == 0:
            do text_add(out, "computer\t")
        elif row.kind == 1:
            do text_add(out, "problem\t")
        else:
            do text_add(out, "note\t")
        end
        do text_add_span(out, row.main, 0, row.main_count)
        do text_add(out, "\t")
        do text_add_span(out, row.detail, 0, row.detail_count)
        do text_add(out, "\n")
        i = i + 1
    end
    do text_add(out, "height\t")
    do text_add_whole(out, scope_height(list))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end

-- scope --replies FILE [FILE ...]: each file's bytes, in order, as the reply
-- one computer's knocks read, through the same steps as the window's: as much
-- of it as a knock reads (256 bytes), counted as all the computer sent only
-- when the file ends before the 256th byte, as a knock counts a reply only
-- when the computer closes the connection after it and stops reading once it
-- has 256 bytes. What the computer's row then shows
-- is printed, one line each: "row=CPU 40%  MEM 75%", or "row=answers" when it
-- shows no figures. No knock is made.
func scope_replies_mode(args, count):
    let it = scope_computer_new(0, 0)
    let st = it.net.state
    let out = new_buffer()
    let k = 2
    while k < count:
        let file = linux_read_file(linux_argument(args, k), 256)
        if file.0 != 0 and file.0 != 0 - 27: return linux_die("scope: cannot read a reply file\n") end
        let n = file.2
        if n > 256: n = 256 end
        do linux_copy(it.net.reply, 0, file.1, 0, n)
        st.outcome = 0
        st.error = 0
        st.got = n
        st.closed = file.0 == 0 and n < 256
        do scope_result(it)
        do text_add(out, "row=")
        if it.figures:
            do text_add_span(out, it.text, 0, it.text_count)
        else:
            do text_add(out, "answers")
        end
        do text_add(out, "\n")
        k = k + 1
    end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end

-- The disk row's three lines, "disk=54%", "disk-bar=216" and "disk-detail=413.2
-- GiB free of 936.8 GiB", as scope_disk_texts made them.
func scope_out_disk(out, disk):
    do text_add(out, "disk=")
    do text_add_span(out, disk.text, 0, disk.count)
    do text_add(out, "\ndisk-bar=")
    do text_add_whole(out, scope_bar_width(disk.state, disk.percent))
    do text_add(out, "\ndisk-detail=")
    do text_add_span(out, disk.detail, 0, disk.detail_count)
    return text_add(out, "\n")
end

func scope_out_limit(out, limit):
    do text_add(out, " ")
    if limit == 0: return text_add(out, "none") end
    return text_add_whole(out, limit)
end

-- A sensor found at startup: "hwmon3", then for the drive its two limits
-- ("none" for none), for the processor its kind; or "none".
func scope_out_sensor(out, label, sensor):
    do text_add(out, label)
    if not sensor.found: return text_add(out, "none\n") end
    do text_add(out, "hwmon")
    do text_add_whole(out, sensor.which)
    if sensor.kind == 1:
        do scope_out_limit(out, sensor.warning)
        do scope_out_limit(out, sensor.critical)
    elif sensor.kind == 2:
        do text_add(out, " k10temp")
    else:
        do text_add(out, " coretemp")
    end
    return text_add(out, "\n")
end

-- scope --readings HWMON STATFS: the temperatures under the directory HWMON,
-- found and read as the window finds and reads them under /sys/class/hwmon,
-- and the disk holding STATFS, asked of statfs as the window asks about /;
-- what the window would then show for them is printed, one "name=value" line
-- each, after what was found and read: each sensor, and statfs's figures
-- (f_blocks, f_bfree, f_bavail and the block size) or "unavailable".
func scope_readings_mode(args):
    let heat = scope_heat_new()
    do scope_heat_find(heat, linux_argument(args, 2))
    do scope_heat_sample(heat)
    let disk = scope_disk_new(linux_argument(args, 3))
    let asked = scope_statfs(disk)
    do scope_disk_figures(disk, asked.0, asked.1, asked.2, asked.3, asked.4)
    do scope_disk_texts(disk)
    let out = new_buffer()
    do scope_out_sensor(out, "drive-sensor=", heat.drive)
    do scope_out_sensor(out, "processor-sensor=", heat.processor)
    do text_add(out, "statfs=")
    if asked.0:
        do text_add_whole(out, asked.1)
        do text_add(out, " ")
        do text_add_whole(out, asked.2)
        do text_add(out, " ")
        do text_add_whole(out, asked.3)
        do text_add(out, " ")
        do text_add_whole(out, asked.4)
        do text_add(out, "\n")
    else:
        do text_add(out, "unavailable\n")
    end
    do scope_out_disk(out, disk)
    do text_add(out, "temperatures=")
    do text_add_span(out, heat.text, 0, heat.count)
    do text_add(out, "\ndrive-colour=")
    let shade = scope_drive_shade(heat.drive)
    if not heat.drive.found:
        do text_add(out, "none")
    elif shade == 0:
        do text_add(out, "green")
    elif shade == 1:
        do text_add(out, "amber")
    elif shade == 2:
        do text_add(out, "red")
    else:
        do text_add(out, "grey")
    end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end

-- A whole number of 1 to 20 digits, below 2^64: (ok, value).
func scope_whole(text):
    if length(text) > 20: return (false, 0) end
    let n = text_string_whole(text, 0, length(text))
    if not n.0 or n.2 != length(text): return (false, 0) end
    return (true, n.1)
end

-- scope --disk-figures BLOCKS BFREE BAVAIL FRSIZE: those four numbers, as
-- statfs would give them, through the same steps as the window's disk row;
-- the row's three lines are printed, as --readings prints them.
func scope_disk_figures_mode(args):
    let blocks = scope_whole(linux_argument(args, 2))
    let bfree = scope_whole(linux_argument(args, 3))
    let bavail = scope_whole(linux_argument(args, 4))
    let frsize = scope_whole(linux_argument(args, 5))
    if not blocks.0 or not bfree.0 or not bavail.0 or not frsize.0: return linux_die("scope: usage: scope\n") end
    let disk = scope_disk_new("")
    do scope_disk_figures(disk, true, blocks.1, bfree.1, bavail.1, frsize.1)
    do scope_disk_texts(disk)
    let out = new_buffer()
    do scope_out_disk(out, disk)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end

-- A whole number of milliseconds, 1 to 60000; 0 for anything else.
func scope_milliseconds(text):
    if length(text) > 5: return 0 end
    let n = text_string_whole(text, 0, length(text))
    if not n.0 or n.2 != length(text) or n.1 > 60000: return 0 end
    return n.1
end

func main():
    let args = linux_arguments()
    let count = linux_argument_count(args)
    if count == 1:
        let st = scope_new("/proc/stat", "/proc/meminfo", "/proc/sys/kernel/hostname", 1000)
        do scope_watch(st, "/sys/class/hwmon", "/")
        return scope_window(st, scope_home_list(5000, 2000))
    end
    let mode = linux_argument(args, 1)
    if count >= 6 and equal(mode, "--sample"): return scope_sample_mode(args, count) end
    if count == 2 and equal(mode, "--computers"): return scope_list_mode(scope_home_list(5000, 2000)) end
    if count >= 3 and equal(mode, "--replies"): return scope_replies_mode(args, count) end
    if count == 3 and equal(mode, "--computers"):
        return scope_list_mode(scope_file_list(linux_argument(args, 2), 5000, 2000))
    end
    if count == 4 and equal(mode, "--readings"): return scope_readings_mode(args) end
    if count == 6 and equal(mode, "--disk-figures"): return scope_disk_figures_mode(args) end
    -- scope --test STAT MEMINFO HOSTNAME MILLISECONDS [COMPUTERS EVERY LIMIT
    -- [HWMON STATFS]]: the window, reading those files at that interval, and
    -- knocking on the computers in COMPUTERS every EVERY ms with a limit of
    -- LIMIT ms (without them, the owner's list as usual); with HWMON and STATFS,
    -- its temperatures are found under HWMON and its disk is the one holding
    -- STATFS (without them, it has none: no temperatures, and a disk statfs
    -- refuses). The tests use it; see examples/scope.md.
    if (count == 6 or count == 9 or count == 11) and equal(mode, "--test"):
        let ms = scope_milliseconds(linux_argument(args, 5))
        let st = scope_new(linux_argument(args, 2), linux_argument(args, 3), linux_argument(args, 4), ms)
        if count == 6 and ms != 0: return scope_window(st, scope_home_list(5000, 2000)) end
        let every = scope_milliseconds(linux_argument(args, 7))
        let limit = scope_milliseconds(linux_argument(args, 8))
        if count == 11 and ms != 0 and every != 0 and limit != 0:
            do scope_watch(st, linux_argument(args, 9), linux_argument(args, 10))
        end
        if count >= 9 and ms != 0 and every != 0 and limit != 0:
            return scope_window(st, scope_file_list(linux_argument(args, 6), every, limit))
        end
    end
    return linux_die("scope: usage: scope\n")
end
