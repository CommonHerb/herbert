-- A small complete game. This file owns its rules; the compiler has none.
-- Linked after linux.herb, x11.herb, pixel_text.herb and grid_map.herb.
-- A move commits to one adjacent floor tile and animates over eight frames.
-- Every frame and restart reuses fixed buffers allocated before the main loop.

-- State u64 fields: source cell, target cell, transition frame, dots left,
-- and completed steps. Cells retain the loaded map.
func maze_restart(map, cells, state):
    do linux_copy(cells, 0, map.cells, 0, map.width * map.height)
    do linux_put64(state, 0, map.spawn)
    do linux_put64(state, 8, map.spawn)
    do linux_put64(state, 16, 0)
    do linux_put64(state, 24, map.dots)
    do linux_put64(state, 32, 0)
    return 0
end

-- A single cardinal direction per move. Opposites cancel; horizontal wins
-- if both axes are held. Starting another move always checks its target tile.
func maze_target(c, map, cells, cell):
    let left = x11_key(c, 65361) or x11_key(c, 97)
    let right = x11_key(c, 65363) or x11_key(c, 100)
    let up = x11_key(c, 65362) or x11_key(c, 119)
    let down = x11_key(c, 65364) or x11_key(c, 115)
    let target = cell
    if left and not right:
        if cell % map.width != 0: target = cell - 1 end
    elif right and not left:
        if cell % map.width + 1 < map.width: target = cell + 1 end
    elif up and not down:
        if cell >= map.width: target = cell - map.width end
    elif down and not up:
        if cell + map.width < map.width * map.height: target = cell + map.width end
    end
    if buffer_get(cells, target) == 35: return cell end
    return target
end

func maze_update(c, map, cells, state):
    if linux_u64(state, 24) == 0: return 0 end
    let source = linux_u64(state, 0)
    let target = linux_u64(state, 8)
    let frame = linux_u64(state, 16)
    if frame == 0:
        target = maze_target(c, map, cells, source)
        do linux_put64(state, 8, target)
        if target == source: return 0 end
    end
    frame = frame + 1
    if frame == 8:
        if buffer_get(cells, target) == 46:
            do buffer_set(cells, target, 32)
            do linux_put64(state, 24, linux_u64(state, 24) - 1)
        end
        do linux_put64(state, 0, target)
        do linux_put64(state, 32, linux_u64(state, 32) + 1)
        frame = 0
    end
    return linux_put64(state, 16, frame)
end

-- Command presses survive a quick press/release between animation frames.
-- Movement still uses held state. Result: 0 ordinary, 1 close, 2 restarted.
func maze_commands(c, map, cells, state, event, result):
    if not x11_next_key(c, event): return result end
    let key = linux_u32(event, 0)
    if key == 65307: return 1 end
    if key == 114 or key == 82:
        do maze_restart(map, cells, state)
        result = 2
    end
    return maze_commands(c, map, cells, state, event, result)
end

-- Two drawing passes keep wall colors grouped and the X11 batch bounded.
func maze_walls(c, map, cells, ox, oy, cell, accent):
    if cell >= map.width * map.height: return 0 end
    if buffer_get(cells, cell) == 35:
        let x = ox + (cell % map.width) * 24
        let y = oy + (cell / map.width) * 24
        if accent:
            do x11_rect(c, x + 3, y + 3, 18, 2)
        else:
            do x11_rect(c, x + 1, y + 1, 22, 22)
        end
    end
    return maze_walls(c, map, cells, ox, oy, cell + 1, accent)
end

func maze_dots(c, map, cells, ox, oy, cell):
    if cell >= map.width * map.height: return 0 end
    if buffer_get(cells, cell) == 46:
        do x11_ellipse(c, ox + (cell % map.width) * 24 + 9, oy + (cell / map.width) * 24 + 9, 6, 6)
    end
    return maze_dots(c, map, cells, ox, oy, cell + 1)
end

func maze_draw(c, map, cells, state, tick):
    let ox = (800 - map.width * 24) / 2
    let oy = 112 + (456 - map.height * 24) / 2
    do x11_color(c, 1054759)
    do x11_rect(c, 0, 0, 800, 640)
    do x11_color(c, 15265527)
    do pixel_text(c, "HERBERT", 28, 27, 3)
    do x11_color(c, 8820395)
    do pixel_text(c, "MAZE", 192, 40, 1)
    do pixel_text(c, "DOTS LEFT", 28, 79, 1)
    do pixel_text(c, "STEPS", 650, 79, 1)
    do x11_color(c, 15265527)
    do pixel_number(c, linux_u64(state, 24), 94, 77, 2)
    do pixel_number(c, linux_u64(state, 32) % 1000000, 692, 79, 1)
    do x11_color(c, 1384240)
    do x11_rect(c, ox - 4, oy - 4, map.width * 24 + 8, map.height * 24 + 8)
    do x11_color(c, 2377568)
    do maze_walls(c, map, cells, ox, oy, 0, false)
    do x11_color(c, 3958662)
    do maze_walls(c, map, cells, ox, oy, 0, true)
    do x11_color(c, 14868688)
    do maze_dots(c, map, cells, ox, oy, 0)
    let source = linux_u64(state, 0)
    let target = linux_u64(state, 8)
    let distance = linux_u64(state, 16) * 3
    let x = ox + (source % map.width) * 24 + 12
    let y = oy + (source / map.width) * 24 + 12
    if target % map.width > source % map.width: x = x + distance end
    if target % map.width < source % map.width: x = x - distance end
    if target / map.width > source / map.width: y = y + distance end
    if target / map.width < source / map.width: y = y - distance end
    do x11_color(c, 660510)
    do x11_ellipse(c, x - 9, y + 6, 18, 6)
    -- Character gold stays unique for independent image observations.
    do x11_color(c, 16173151)
    do x11_ellipse(c, x - 9, y - 9, 18, 18)
    do x11_color(c, 1054759)
    let eyeheight = 4
    if tick % 180 >= 174: eyeheight = 1 end
    do x11_rect(c, x - 4, y - 3, 2, eyeheight)
    do x11_rect(c, x + 2, y - 3, 2, eyeheight)
    if linux_u64(state, 24) == 0:
        do x11_color(c, 6867876)
        do x11_rect(c, 216, 280, 368, 104)
        do x11_color(c, 1054759)
        do x11_rect(c, 219, 283, 362, 98)
        do x11_color(c, 15265527)
        do pixel_text(c, "MAZE COMPLETE", 322, 304, 2)
        do x11_color(c, 11255503)
        do pixel_text(c, "PRESS R TO PLAY AGAIN", 340, 350, 1)
    end
    do x11_color(c, 11255503)
    do pixel_text(c, "ARROWS / WASD TO MOVE", 28, 591, 1)
    do pixel_text(c, "R TO RESTART", 336, 591, 1)
    do pixel_text(c, "ESC TO CLOSE", 650, 591, 1)
    do x11_color(c, 5793911)
    do pixel_text(c, "COLLECT EVERY DOT", 28, 617, 1)
    do pixel_text(c, "MADE IN HERBERT", 680, 617, 1)
    let pulse = 3832176
    if tick % 60 >= 30: pulse = 6867876 end
    do x11_color(c, pulse)
    do x11_ellipse(c, 764, 40, 8, 8)
    return x11_present(c)
end

func maze_loop(c, map, cells, state, event, tick, last):
    do x11_events(c)
    let command = maze_commands(c, map, cells, state, event, 0)
    if x11_closed(c) or command == 1:
        let closed = x11_close(c)
        do x11_need(closed == 0, "maze: display close failed\n")
        do process_exit(0)
        return 0
    end
    let now = linux_clock_ms(c.clock)
    do x11_need(not linux_error(now), "maze: monotonic clock failed\n")
    if command == 2:
        do maze_draw(c, map, cells, state, 0)
        return maze_loop(c, map, cells, state, event, 1, now)
    end
    if now - last < 16:
        let waited = linux_poll(c.state.fd, c.poll, 1, 16 - (now - last))
        do x11_need(not linux_error(waited) or waited == 0 - 4, "maze: input wait failed\n")
        return maze_loop(c, map, cells, state, event, tick, last)
    end
    do maze_update(c, map, cells, state)
    do maze_draw(c, map, cells, state, tick)
    return maze_loop(c, map, cells, state, event, (tick + 1) % 180, now)
end

-- Startup diagnostics only; no number-to-string allocation in the game loop.
func maze_error_number(number):
    let digits = linux_buffer(20)
    let count = linux_decimal(digits, 0, number)
    return stderr_write(linux_string_loop(digits, 0, count, new_buffer()))
end

func maze_map_error(map):
    do stderr_write("maze: ")
    do stderr_write(grid_map_error(map.status))
    if map.error_row != 0:
        do stderr_write(" (row ")
        do maze_error_number(map.error_row)
        do stderr_write(", column ")
        do maze_error_number(map.error_column)
        do stderr_write(")")
    end
    return linux_die("\n")
end

func main():
    let args = linux_arguments()
    let path = linux_argument(args, 1)
    if length(path) == 0: path = "examples/maze.txt" end
    if length(linux_argument(args, 2)) != 0: return linux_die("maze: usage: maze [map-file]\n") end
    let loaded = linux_read_file(path, 4096)
    if loaded.0 != 0:
        if loaded.0 == 0 - 27: return linux_die("maze: map file exceeds 4096 bytes\n") end
        return linux_die("maze: cannot read map file; check its path and permissions\n")
    end
    let map = grid_map_parse(loaded.1, loaded.2, 31, 19)
    if map.status != 0: return maze_map_error(map) end
    let cells = linux_buffer(map.width * map.height)
    let state = linux_buffer(40)
    do maze_restart(map, cells, state)
    let c = x11_open(800, 640, "Herbert - Maze")
    do x11_enable_text(c)
    let event = linux_buffer(16)
    do maze_draw(c, map, cells, state, 0)
    let now = linux_clock_ms(c.clock)
    do x11_need(not linux_error(now), "maze: monotonic clock failed\n")
    return maze_loop(c, map, cells, state, event, 1, now)
end
