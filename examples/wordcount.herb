-- Byte-oriented word counter for ordinary Linux/x86_64 Herbert.
-- Result: (LF line endings, ASCII-whitespace-delimited words, bytes).
-- One input allocation; the scan is one loop with no per-byte heap allocations.

func scan(s, i, lines, words, in_word):
    while i < length(s):
        let c = index(s, i)
        if c == 10:
            lines = lines + 1
            in_word = false
        elif c == 32 or (c >= 9 and c <= 13):
            in_word = false
        elif not in_word:
            words = words + 1
            in_word = true
        end
        i = i + 1
    end
    return (lines, words, i)
end

func main():
    let incoming = stdin_read()
    if incoming.0 != 0:
        do stderr_write("wordcount: cannot read standard input\n")
        do process_exit(1)
        return (0, 0, 0)
    end
    return scan(incoming.1, 0, 0, 0, false)
end
