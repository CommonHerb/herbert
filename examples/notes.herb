-- A bounded plain-text editor, compiled and supported entirely in Herbert.
-- Libraries: linux, x11_clipboard, utf8, unicode_grapheme, file_io, text_buffer,
-- session_recovery, x11, pixel_text, unicode_display. UTF-8 + LF/CRLF + TAB.
-- App state is one reference record, built once in main and updated in place.
-- It holds the open document's File and a spare one: Ctrl+O loads the spare and
-- the two swap, so opening a file allocates nothing either. The selection runs
-- from anchor (-1 when there is none) to the cursor. Copied text lives in the
-- X11 clipboard's own buffer; clip is scratch for text pasted from elsewhere,
-- after its CRLF newlines become LF. time is the server time of the key being
-- handled, which the clipboard protocol asks for. dragging is true from a left
-- press in the text to its release, or until a prompt opens; drag_x/drag_y hold
-- the pointer's last place and scrolled_at the last time a drag held past an
-- edge scrolled the view.
-- detached is true while the wheel has moved the view away from the cursor;
-- the next key (other than a bare modifier), click or drag re-attaches it, and
-- the view follows the cursor every frame as before. going is the Go to line
-- field, with the number typed so far and its digit count. scan is the folder
-- scan's storage, allocated here once; found is how many session folders sat
-- beside the document when it opened, and found_differs whether the newest
-- one's copy differs from the file (notes_recovery_scan).
-- No per-event/frame/save string or tuple creation.

ref record NotesState:
    doc: File
    spare: File
    top: int
    left: int
    dirty: bool
    confirming: bool
    message_id: int
    save_result: int
    needs_draw: bool
    checkpoint_pending: bool
    recovery_result: int
    recovery_attempted: bool
    finding: bool
    query_count: int
    query_matched: bool
    missing_glyphs: bool
    unicode_input: bool
    unicode_value: int
    unicode_digits: int
    opening: bool
    path: buffer
    path_count: int
    open_result: int
    anchor: int
    clip: buffer
    time: int
    dragging: bool
    drag_x: int
    drag_y: int
    scrolled_at: int
    detached: bool
    going: bool
    line_value: int
    line_digits: int
    scan: FileScan
    found: int
    found_differs: bool
end

-- The largest document, in bytes on disk.
func notes_capacity(): return 4194304 end

-- The limit's number appears in the startup refusal, two status messages and the Bytes line, and the history
-- budget (twice it) in a third message; each writes it from notes_capacity(), so the capacity has one source. The status messages draw it in place (notes_status) so a frame
-- allocates nothing; this helper builds the one-time startup message.
func notes_limit_text(prefix, suffix):
    let digits = linux_buffer(20)
    let count = linux_decimal(digits, 0, notes_capacity())
    let b = new_buffer()
    let i = 0
    while i < length(prefix):
        do append(b, index(prefix, i))
        i = i + 1
    end
    i = 0
    while i < count:
        do append(b, buffer_get(digits, i))
        i = i + 1
    end
    i = 0
    while i < length(suffix):
        do append(b, index(suffix, i))
        i = i + 1
    end
    return freeze(b)
end

func notes_redraw(s):
    s.needs_draw = true
    return 0
end

func notes_message(s, message):
    s.message_id = message
    return notes_redraw(s)
end

func notes_changed(s):
    s.anchor = 0 - 1
    s.dirty = true
    s.checkpoint_pending = true
    return notes_message(s, 1)
end

func notes_checkpoint(recovery, f, t, s):
    if not s.checkpoint_pending: return 0 end
    let checkpoint = recovery_save(recovery, f, text_file_bytes(t), text_file_length(t))
    s.recovery_result = checkpoint
    s.recovery_attempted = true
    s.checkpoint_pending = false
    return notes_redraw(s)
end

func notes_recovery_current(s):
    return s.recovery_attempted and s.recovery_result == 0 and not s.checkpoint_pending
end

func notes_quit(c, f, t, s, recovery):
    do notes_checkpoint(recovery, f, t, s)
    do recovery_close(recovery)
    do file_close(f)
    do file_close(s.spare)
    do x11_close(c)
    do process_exit(0)
    return 0
end

func notes_request_close(c, f, t, s, recovery):
    s.unicode_input = false
    s.opening = false
    s.going = false
    s.dragging = false
    do notes_checkpoint(recovery, f, t, s)
    do x11_ack_close(c)
    if not s.dirty: return notes_quit(c, f, t, s, recovery) end
    s.confirming = true
    return notes_message(s, 5)
end

-- An existing document whose owner write bit is off: as the file was when it
-- opened, then as the last Ctrl+S found it (file_recheck reads it again whenever
-- its stat works, also before a refusal for a second link, another owner, a
-- symlink or a folder at its name; a file gone, or a stat that fails, keeps the
-- mark it had). The exception: after a save that published but whose check
-- after the rename failed, file_recheck reads nothing until file_save's own
-- recovery confirms that save, so the mark stays as it was. file_save renames a
-- new file over the old one, which only the folder's permission governs, so
-- Notes itself refuses to save over it (45) when file_recheck gave 0 or 116;
-- any other result has already ended that Ctrl+S with its own sentence. A new
-- document, not yet on disk, is never read-only.
func notes_read_only(f): return f.state.exists and (f.state.mode & 128) == 0 end

-- The Ctrl+S failures a person can act on get their own sentence; every other
-- code keeps message 4 and its number. A new document that was never on disk
-- cannot have been deleted or moved, so its 2 stays generic.
func notes_save_error(f, status):
    if status == 0 - 116: return 46 end
    if status == 0 - 13: return 47 end
    if status == 0 - 2 and f.state.exists: return 48 end
    return 4
end

func notes_save(f, t, s):
    if s.recovery_attempted and s.recovery_result != 0:
        s.checkpoint_pending = true
    end
    -- The file as it is now, not as it opened: a permission changed since then is
    -- taken as it is, so a read-only file made writable saves on this Ctrl+S and
    -- a file made read-only is refused like one that opened read-only. Any result
    -- of file_recheck but 0 and 116 ends this Ctrl+S with that result's own
    -- sentence before file_save is called, read-only or not: a file gone 48; a
    -- second link, a symlink or another kind of file at its name the general
    -- sentence and 31, 40 or 22; a folder that cannot be searched, or another
    -- owner, 47; a stat that failed (EIO, ENOMEM) the general sentence and its
    -- number. So nothing is written when the recheck's own stat fails though
    -- file_save's stat a moment later might work. Only after 0 or 116 is a
    -- document recorded read-only refused as read-only (45).
    -- After a save whose check after the rename failed (message 6 with the
    -- baseline unconfirmed; a failed sync alone is not this) nothing is read here:
    -- file_save's recovery checks the file against what it published, and a
    -- permission changed since is a change by another program (46) there.
    let current = file_recheck(f)
    if current != 0 and current != 0 - 116:
        s.save_result = current
        return notes_message(s, notes_save_error(f, current))
    end
    if notes_read_only(f): return notes_message(s, 45) end
    let result = file_save(f, text_file_bytes(t), text_file_length(t))
    s.save_result = result
    if result == 0:
        s.dirty = false
        s.confirming = false
        return notes_message(s, 2)
    elif result == 1:
        -- Publication happened; retain dirty/confirmation so the warning is
        -- visible. A successful retry can establish durability and clear it.
        s.dirty = true
        return notes_message(s, 6)
    end
    return notes_message(s, notes_save_error(f, result))
end

func notes_save_copy(f, t, s):
    let result = file_save_copy(f, text_file_bytes(t), text_file_length(t))
    s.save_result = result
    -- A rescue never adopts a new document or clears the original's dirty or
    -- close-confirmation state. Show the exact sibling basename by leaving any
    -- input panel after publication. The last search query remains repeatable.
    if result == 0 or result == 1:
        s.finding = false
        s.unicode_input = false
        s.opening = false
        s.going = false
    end
    if result == 0: return notes_message(s, 7) end
    if result == 1: return notes_message(s, 8) end
    if result == 0 - 13: return notes_message(s, 49) end
    return notes_message(s, 9)
end

func notes_find(t, s, query, backward, advance):
    if s.query_count == 0:
        s.finding = true
        return notes_message(s, 15)
    end
    let start = text_cursor(t)
    if advance:
        if backward:
            if start == 0: start = 0 - 1 else: start = start - 1 end
        else:
            start = start + 1
        end
    end
    let found = text_find(t, query, s.query_count, start, backward)
    s.query_matched = false
    if found != 0 - 1:
        do text_seek(t, found)
        s.query_matched = true
        return notes_message(s, 12)
    end
    return notes_message(s, 13)
end

-- Text arrives as Unicode scalar values. Encode an entire scalar or reject it;
-- query input and document input never expose a partial UTF-8 sequence.
func notes_insert_scalar(t, s, query, ch):
    if not utf8_text_allowed(ch): return notes_message(s, 18) end
    if s.opening:
        if ch == 9 or ch == 10: return notes_message(s, 18) end
        let count = s.path_count
        if utf8_width(ch) > 4095 - count: return notes_message(s, 29) end
        let next = utf8_store(s.path, count, ch)
        s.path_count = next
        return notes_message(s, 19)
    end
    if s.finding:
        if ch == 9 or ch == 10: return notes_message(s, 18) end
        let count = s.query_count
        let width = utf8_width(ch)
        if width > 64 - count: return notes_message(s, 14) end
        let next = utf8_store(query, count, ch)
        s.query_count = next
        return notes_find(t, s, query, false, false)
    end
    if notes_selected(t, s):
        let replaced = text_replace_scalar(t, notes_from(t, s), notes_to(t, s), ch)
        return notes_edited(s, replaced)
    end
    let changed = text_insert(t, ch)
    if changed == 0: return notes_message(s, 3) end
    return notes_changed(s)
end

func notes_selected(t, s): return s.anchor != 0 - 1 and s.anchor != text_cursor(t) end

func notes_from(t, s):
    if s.anchor < text_cursor(t): return s.anchor end
    return text_cursor(t)
end

func notes_to(t, s):
    if s.anchor > text_cursor(t): return s.anchor end
    return text_cursor(t)
end

-- A text_replace result: 1 changed, 0 no room (notes_capacity), 2 too large to undo.
func notes_edited(s, result):
    if result == 1: return notes_changed(s) end
    if result == 2: return notes_message(s, 35) end
    return notes_message(s, 3)
end

-- Copied text is offered whole from the clipboard's own buffer.
func notes_fits_clipboard(c, t, s): return notes_to(t, s) - notes_from(t, s) <= buffer_length(x11_clip_data(c)) end

func notes_copy(c, t, s):
    if not notes_selected(t, s): return notes_message(s, 32) end
    if not notes_fits_clipboard(c, t, s): return notes_message(s, 41) end
    let start = notes_from(t, s)
    do x11_clip_own(c, t.bytes, start, notes_to(t, s) - start, s.time)
    return notes_message(s, 31)
end

func notes_cut(c, t, s):
    if not notes_selected(t, s): return notes_message(s, 32) end
    if not notes_fits_clipboard(c, t, s): return notes_message(s, 41) end
    do notes_copy(c, t, s)
    return notes_edited(s, text_replace(t, notes_from(t, s), notes_to(t, s), s.clip, 0, 0))
end

-- Pasted text follows the file rules: valid UTF-8, TAB and LF or CRLF (in any
-- mix); each CRLF becomes LF. Returns the count copied to dst, or -1 to refuse.
func notes_normalize(src, p, stop, dst, out):
    while p < stop:
        let decoded = utf8_decode(src, p, stop)
        if linux_error(decoded.0): return 0 - 1 end
        if decoded.0 == 13:
            if decoded.1 >= stop or buffer_get(src, decoded.1) != 10: return 0 - 1 end
        else:
            if not utf8_text_allowed(decoded.0): return 0 - 1 end
            do linux_copy(dst, out, src, p, decoded.1 - p)
            out = out + decoded.1 - p
        end
        p = decoded.1
    end
    return out
end

-- One line for the Open and Find fields: valid text without TAB or newline.
func notes_line_valid(bytes, p, count):
    while p < count:
        let decoded = utf8_decode(bytes, p, count)
        if linux_error(decoded.0) or decoded.0 == 9 or decoded.0 == 10 or not utf8_text_allowed(decoded.0): return false end
        p = decoded.1
    end
    return true
end

-- Fields take one line: one trailing newline is dropped, and anything else
-- multi-line, a TAB or a disallowed character refuses the whole paste.
func notes_paste_field(t, s, query, bytes, count):
    if count > 0 and buffer_get(bytes, count - 1) == 10: count = count - 1 end
    if not notes_line_valid(bytes, 0, count): return notes_message(s, 34) end
    if s.opening:
        if count > 4095 - s.path_count: return notes_message(s, 29) end
        do linux_copy(s.path, s.path_count, bytes, 0, count)
        s.path_count = s.path_count + count
        return notes_message(s, 19)
    end
    if count > 64 - s.query_count: return notes_message(s, 14) end
    do linux_copy(query, s.query_count, bytes, 0, count)
    s.query_count = s.query_count + count
    return notes_find(t, s, query, false, false)
end

-- Pasted text replaces the selection, or goes in at the cursor, as one undo step.
func notes_paste_text(t, s, query, bytes, count):
    if count == 0: return notes_message(s, 33) end
    if s.opening or s.finding: return notes_paste_field(t, s, query, bytes, count) end
    let start = text_cursor(t)
    let stop = start
    if notes_selected(t, s):
        start = notes_from(t, s)
        stop = notes_to(t, s)
    end
    return notes_edited(s, text_replace(t, start, stop, bytes, 0, count))
end

-- Text this window copied is pasted directly; otherwise the clipboard's owner
-- is asked, for at most two seconds.
func notes_paste(c, t, s, query):
    if x11_clip_owned(c): return notes_paste_text(t, s, query, x11_clip_data(c), x11_clip_count(c)) end
    let got = x11_clip_request(c, s.time, 2000)
    if got == 0 - 1: return notes_message(s, 36) end
    if got == 0 - 2: return notes_message(s, 37) end
    if got == 0 - 3: return notes_message(s, 39) end
    if got == 0 - 4: return notes_message(s, 38) end
    let count = notes_normalize(c.replies, 32, 32 + got, s.clip, 0)
    if count == 0 - 1: return notes_message(s, 40) end
    return notes_paste_text(t, s, query, s.clip, count)
end

func notes_hex_digit(key):
    if key >= 48 and key <= 57: return key - 48 end
    if key >= 65 and key <= 70: return key - 65 + 10 end
    if key >= 97 and key <= 102: return key - 97 + 10 end
    return 0 - 1
end

-- Ctrl+Shift+U, hex digits, Enter/Space is an explicit scalar-entry method.
-- Compose/IME services are not used. Escape cancels without editing anything.
func notes_unicode_key(t, s, query, key, mods):
    if key == 65307:
        s.unicode_input = false
        return notes_message(s, 1)
    end
    if (mods & 12) != 0: return 0 end
    let digits = s.unicode_digits
    if key == 65288:
        if digits > 0:
            s.unicode_value = s.unicode_value / 16
            s.unicode_digits = digits - 1
        end
        return notes_message(s, 16)
    end
    if key == 65293 or key == 32:
        let value = s.unicode_value
        if digits == 0 or not utf8_text_allowed(value): return notes_message(s, 18) end
        if (s.finding or s.opening) and (value == 9 or value == 10): return notes_message(s, 18) end
        s.unicode_input = false
        return notes_insert_scalar(t, s, query, value)
    end
    let digit = notes_hex_digit(key)
    if digit == 0 - 1: return 0 end
    if digits == 6: return notes_message(s, 17) end
    s.unicode_value = s.unicode_value * 16 + digit
    s.unicode_digits = digits + 1
    return notes_message(s, 16)
end

-- Ctrl+G, decimal digits, Enter goes to that line (0 means the first; past the
-- last means the end of the text). Escape cancels without moving anything.
func notes_line_start(s):
    s.going = true
    s.line_value = 0
    s.line_digits = 0
    return notes_message(s, 42)
end

func notes_line_key(t, s, key, mods):
    if key == 65307:
        s.going = false
        return notes_message(s, 1)
    end
    if (mods & 12) != 0: return 0 end
    let digits = s.line_digits
    if key == 65288:
        if digits > 0:
            s.line_value = s.line_value / 10
            s.line_digits = digits - 1
        end
        return notes_message(s, 42)
    end
    if key == 65293:
        if digits == 0: return notes_message(s, 44) end
        let line = s.line_value
        if line > 0: line = line - 1 end
        s.going = false
        s.anchor = 0 - 1
        do text_seek(t, text_row_offset(t, line))
        return notes_message(s, 1)
    end
    if key < 48 or key > 57: return 0 end
    if digits == 7: return notes_message(s, 43) end
    s.line_value = s.line_value * 10 + (key - 48)
    s.line_digits = digits + 1
    return notes_message(s, 42)
end

func notes_search_key(t, s, query, key, mods):
    if key == 65307:
        s.finding = false
        return notes_message(s, 1)
    end
    if key == 65293 or key == 65472:
        return notes_find(t, s, query, (mods & 1) != 0, s.query_matched)
    end
    if (mods & 12) != 0: return 0 end
    if key == 65288:
        let count = s.query_count
        let previous = unicode_grapheme_previous(query, count, count)
        s.query_count = previous
        return notes_find(t, s, query, false, false)
    end
    let ch = x11_text_scalar(key)
    if ch == 0 - 1: return 0 end
    return notes_insert_scalar(t, s, query, ch)
end

-- Paths are bytes; offer only a prefix the Open field can show and edit.
func notes_path_valid(bytes, p, count):
    while p < count:
        let decoded = utf8_decode(bytes, p, count)
        if linux_error(decoded.0) or decoded.0 == 9 or decoded.0 == 10 or not utf8_text_allowed(decoded.0): return false end
        p = decoded.1
    end
    return true
end

-- The Open field starts with the open document's folder, absolute when the
-- working directory is known, so a typed name opens beside that document.
func notes_open_prefix(s):
    let f = s.doc
    let count = linux_nul_end(f.path, 0, buffer_length(f.path))
    let slash = file_path_scan(f.path, count, 0, 0 - 1)
    let folder = 0
    if slash < count: folder = slash + 1 end
    let at = 0
    if count == 0 or buffer_get(f.path, 0) != 47:
        let got = linux_syscall6(79, buffer_address(s.path), buffer_length(s.path), 0, 0, 0, 0)
        if not linux_error(got) and got > 1:
            at = got - 1
            if buffer_get(s.path, at - 1) != 47:
                do buffer_set(s.path, at, 47)
                at = at + 1
            end
        end
    end
    if at + folder > 4095: return 0 end
    do linux_copy(s.path, at, f.path, 0, folder)
    if not notes_path_valid(s.path, 0, at + folder): return 0 end
    return at + folder
end

func notes_open_start(s):
    if s.dirty: return notes_message(s, 22) end
    s.anchor = 0 - 1
    s.finding = false
    s.opening = true
    s.path_count = notes_open_prefix(s)
    return notes_message(s, 19)
end

func notes_open_error(status):
    if status == 0 - 27: return 23 end
    if status == 0 - 40: return 24 end
    if status == 0 - 31: return 25 end
    if status == 0 - 116: return 26 end
    if status == 0 - 22: return 30 end
    return 28
end

-- Session folders from earlier sessions beside the document just opened (at
-- startup and after Ctrl+O): the .herbert-notes-* folders in its folder,
-- counted by one scan of the folder its File already holds (file_scan; a
-- symlink or a plain file wearing the name is not one). Only the newest, by
-- modification time, is read: its recovery.txt, loaded once into the spare File
-- (free at open time; at most the document capacity) and compared byte for byte
-- with the bytes just opened. A copy that cannot be read is not called
-- different. Line y=85 says so until the first edit (notes_draw_found).
func notes_recovery_scan(s):
    let f = s.doc
    let g = s.spare
    s.found = 0
    s.found_differs = false
    let found = file_scan(f, s.scan, ".herbert-notes-")
    if linux_error(found) or found == 0: return 0 end
    s.found = found
    let loaded = file_load_inside(g, f, file_scan_name(s.scan), "recovery.txt")
    if loaded == 0 and g.state.exists:
        s.found_differs = file_count(g) != file_count(f) or not file_bytes_same(g.bytes, f.bytes, file_count(f), 0)
    end
    do file_close(g)
    return 0
end

-- Load the typed path into the spare File, then its text, and swap. A refusal
-- leaves the open document, its text, history and recovery session as they were.
func notes_open(t, s, recovery):
    if s.dirty: return notes_message(s, 22) end
    do notes_checkpoint(recovery, s.doc, t, s)
    let g = s.spare
    let loaded = file_load(g, s.path, s.path_count)
    if loaded != 0:
        do file_close(g)
        s.open_result = loaded
        return notes_message(s, notes_open_error(loaded))
    end
    let text = text_load(t, g.bytes, file_count(g))
    if text != 0:
        do file_close(g)
        s.open_result = text
        if text == 0 - 27: return notes_message(s, 23) end
        return notes_message(s, 27)
    end
    let old = s.doc
    s.doc = g
    s.spare = old
    do file_close(old)
    do recovery_reset(recovery)
    s.top = 0
    s.left = 0
    s.detached = false
    s.confirming = false
    s.save_result = 0
    s.checkpoint_pending = false
    s.recovery_result = 0
    s.recovery_attempted = false
    s.opening = false
    s.query_matched = false
    do notes_recovery_scan(s)
    if g.state.exists: return notes_message(s, 20) end
    return notes_message(s, 21)
end

func notes_open_key(t, s, recovery, query, key, mods):
    if key == 65307:
        s.opening = false
        return notes_message(s, 1)
    end
    if key == 65293: return notes_open(t, s, recovery) end
    if (mods & 12) != 0: return 0 end
    if key == 65288:
        let previous = unicode_grapheme_previous(s.path, s.path_count, s.path_count)
        s.path_count = previous
        return notes_message(s, 19)
    end
    let ch = x11_text_scalar(key)
    if ch == 0 - 1: return 0 end
    return notes_insert_scalar(t, s, query, ch)
end

func notes_key(c, t, s, recovery, query, key, mods):
    let f = s.doc
    let control = (mods & 4) != 0
    if control and (mods & 1) != 0 and (key == 115 or key == 83): return notes_save_copy(f, t, s) end
    if control and (key == 115 or key == 83): return notes_save(f, t, s) end
    if s.confirming:
        if key == 65307:
            s.confirming = false
            return notes_message(s, 1)
        elif (key == 121 or key == 89) and (mods & 204) == 0:
            return notes_quit(c, f, t, s, recovery)
        end
        return 0
    end
    if s.unicode_input: return notes_unicode_key(t, s, query, key, mods) end
    if s.going: return notes_line_key(t, s, key, mods) end
    if control and (mods & 1) != 0 and (key == 117 or key == 85):
        s.unicode_input = true
        s.unicode_value = 0
        s.unicode_digits = 0
        return notes_message(s, 16)
    end
    if control and (key == 113 or key == 81): return notes_request_close(c, f, t, s, recovery) end
    if control and (key == 111 or key == 79): return notes_open_start(s) end
    if control and (key == 118 or key == 86): return notes_paste(c, t, s, query) end
    if s.opening: return notes_open_key(t, s, recovery, query, key, mods) end
    if control and (key == 102 or key == 70):
        s.anchor = 0 - 1
        s.finding = true
        s.query_count = 0
        s.query_matched = false
        return notes_message(s, 15)
    end
    if s.finding: return notes_search_key(t, s, query, key, mods) end
    if control and (key == 103 or key == 71): return notes_line_start(s) end
    if key == 65472:
        -- F3 and Shift+F3 move to a match; like Ctrl+F they never select.
        s.anchor = 0 - 1
        return notes_find(t, s, query, (mods & 1) != 0, true)
    end
    if key == 65307:
        -- The first Escape drops a selection; the next one closes.
        if notes_selected(t, s):
            s.anchor = 0 - 1
            return notes_redraw(s)
        end
        return notes_request_close(c, f, t, s, recovery)
    end
    if (mods & 8) != 0: return 0 end
    let cursor = text_cursor(t)
    let changed = 0
    if control and (key == 97 or key == 65):
        s.anchor = 0
        do text_seek(t, text_length(t))
        return notes_redraw(s)
    end
    if control and (key == 99 or key == 67): return notes_copy(c, t, s) end
    if control and (key == 120 or key == 88): return notes_cut(c, t, s) end
    -- Shift extends a selection from where it started. Without Shift a movement
    -- key drops it; Left and Right first go to its start or end.
    let selected = notes_selected(t, s)
    if key >= 65360 and key <= 65367:
        if (mods & 1) != 0:
            if s.anchor == 0 - 1: s.anchor = cursor end
        elif selected and (key == 65361 or key == 65363) and not control:
            let edge = notes_from(t, s)
            if key == 65363: edge = notes_to(t, s) end
            s.anchor = 0 - 1
            do text_seek(t, edge)
            return notes_redraw(s)
        else:
            if selected: let dropped = notes_redraw(s) end
            s.anchor = 0 - 1
        end
    end
    if selected and (key == 65288 or key == 65535):
        return notes_edited(s, text_replace(t, notes_from(t, s), notes_to(t, s), s.clip, 0, 0))
    end
    if control and (key == 122 or key == 90):
        if (mods & 1) != 0: changed = text_redo(t) else: changed = text_undo(t) end
        if changed == 0:
            if (mods & 1) != 0: return notes_message(s, 11) end
            return notes_message(s, 10)
        end
    elif control and (key == 121 or key == 89):
        changed = text_redo(t)
        if changed == 0: return notes_message(s, 11) end
    elif key == 65361:
        do text_seek(t, text_previous(t, cursor))
    elif key == 65363:
        do text_seek(t, text_next(t, cursor))
    elif key == 65362:
        do text_vertical(t, false, 1)
    elif key == 65364:
        do text_vertical(t, true, 1)
    elif key == 65360:
        let target = text_line_start(t, cursor)
        if control: target = 0 end
        do text_seek(t, target)
    elif key == 65367:
        let target = text_line_end(t, cursor)
        if control: target = text_length(t) end
        do text_seek(t, target)
    elif key == 65365:
        do text_vertical(t, false, 20)
    elif key == 65366:
        do text_vertical(t, true, 20)
    elif control:
        return 0
    elif key == 65288:
        changed = text_backspace(t)
    elif key == 65535:
        changed = text_delete(t)
    else:
        let ch = x11_text_scalar(key)
        if key == 65293: ch = 10 end
        if key == 65289: ch = 9 end
        if ch != 0 - 1: return notes_insert_scalar(t, s, query, ch) end
    end
    if changed != 0: return notes_changed(s) end
    if cursor != text_cursor(t): return notes_redraw(s) end
    return 0
end

func notes_in_text(x, y): return x >= 26 and x < 874 and y >= 98 and y < 522 end

-- The character boundary nearest a point in the text. Above, below or beside
-- the text it is one row or column past the view, so a held drag scrolls.
func notes_point(t, s, x, y):
    let row = s.top
    if y < 100:
        if row > 0: row = row - 1 end
    elif y >= 520:
        row = s.top + 21
    else:
        row = s.top + (y - 100) / 20
    end
    let col = s.left
    if x < 28:
        if col > 0: col = col - 1 end
    elif x >= 868:
        col = s.left + 70
    else:
        col = s.left + (x - 28 + 6) / 12
    end
    return text_column_position(t, text_row_offset(t, row), col, 0)
end

-- A left press in the text places the cursor (with Shift, extends the
-- selection); dragging selects. Fields, Unicode entry and the close prompt
-- ignore the pointer.
func notes_pointer(t, s, symbol, state, code):
    if symbol == 4294967043:
        -- A click (the cursor still where the press put the anchor) leaves no
        -- anchor behind; a drag or Shift+click that covered text keeps its selection.
        if s.anchor == text_cursor(t): s.anchor = 0 - 1 end
        s.dragging = false
        return 0
    end
    if s.confirming or s.unicode_input or s.opening or s.finding or s.going: return 0 end
    if symbol == 4294967044 or symbol == 4294967045:
        if s.dragging: return 0 end
        return notes_wheel(t, s, symbol == 4294967044, code)
    end
    let x = code % 65536
    let y = code / 65536
    if symbol == 4294967041:
        if not notes_in_text(x, y): return 0 end
        do notes_attach(s)
        let target = notes_point(t, s, x, y)
        if (state & 1) != 0:
            if s.anchor == 0 - 1: s.anchor = text_cursor(t) end
        else:
            s.anchor = target
        end
        s.dragging = true
    end
    if not s.dragging: return 0 end
    s.drag_x = x
    s.drag_y = y
    do text_seek(t, notes_point(t, s, x, y))
    return notes_redraw(s)
end

-- A wheel tick moves the view three rows and leaves the cursor and selection
-- where they are; the view stays there until the cursor next moves (notes_view).
-- Downward it stops where Ctrl+End would, the last row at the bottom: the row
-- that would be at the bottom is looked for from the remembered line, so a
-- notch costs the distance between the cursor's line and the view, never a
-- count of the whole text.
func notes_wheel(t, s, upward, ticks):
    -- A key handled earlier in this drain may have moved the cursor or shrunk
    -- the text with the view not yet redrawn: start from the view it would show.
    do notes_view(t, s)
    let rows = 3 * ticks
    let top = s.top
    if upward:
        if rows > top: rows = top end
        top = top - rows
    else:
        let want = top + rows
        let reached = text_row_clamp(t, want + 20)
        let limit = 0
        if reached > 20: limit = reached - 20 end
        if want > limit: want = limit end
        if want > top: top = want end
    end
    if top == s.top: return 0 end
    s.top = top
    s.detached = true
    return notes_redraw(s)
end

-- A view the wheel moved away comes back at the next key that is not a bare
-- modifier, or the next press in the text (notes_pointer), before that input
-- is handled: whatever it does to the cursor, the next frame follows the
-- cursor again. A press lands on the row it was seen on, the view as drawn.
func notes_attach(s):
    if not s.detached: return 0 end
    s.detached = false
    return notes_redraw(s)
end

func notes_modifier(key): return (key >= 65505 and key <= 65518) or key == 65027 end

-- Open, Find, Go to line, Unicode entry or the close prompt has the keyboard.
func notes_prompted(s): return s.opening or s.finding or s.going or s.unicode_input or s.confirming end

func notes_keys(c, t, s, recovery, query, event):
    while x11_next_key(c, event):
        s.time = linux_u32(event, 12)
        let symbol = linux_u32(event, 0)
        if symbol >= 4294967041:
            do notes_pointer(t, s, symbol, linux_u32(event, 4), linux_u32(event, 8))
        else:
            if not notes_modifier(symbol): do notes_attach(s) end
            do notes_key(c, t, s, recovery, query, symbol, linux_u32(event, 4))
            -- A prompt this key opened ends a held drag, so its edge scroll never
            -- moves the cursor or the view under the prompt.
            if notes_prompted(s): s.dragging = false end
        end
    end
    return 0
end

-- The view follows the cursor every frame, except while the wheel has moved it
-- away; the next key, click or drag re-attaches it (notes_attach).
func notes_view(t, s):
    if s.detached: return 0 end
    let cursor = text_cursor(t)
    let row = text_row(t, cursor)
    let col = text_column(t, cursor)
    let top = s.top
    let left = s.left
    if row < top: top = row end
    if row >= top + 21: top = row - 20 end
    if col < left: left = col end
    if col >= left + 70: left = col - 69 end
    -- Never past where Ctrl+End stops (the last row at the bottom): a document
    -- that lost its rows below the cursor would otherwise show only its last row.
    let reached = text_row_clamp(t, top + 20)
    let limit = 0
    if reached > 20: limit = reached - 20 end
    if top > limit: top = limit end
    s.top = top
    s.left = left
    return 0
end

func notes_draw_line(c, t, s, p, col, left, y):
    while p < text_length(t) and col < left + 70:
        let ch = buffer_get(t.bytes, p)
        if ch == 10: return 0 end
        let next = text_next(t, p)
        if col >= left and ch != 9:
            if not unicode_display_supported(t.bytes, p, next):
                s.missing_glyphs = true
            end
            do pixel_unicode_cluster(c, t.bytes, p, next, 28 + (col - left) * 12, y, 2)
        end
        col = text_next_column(col, ch)
        p = next
    end
    return 0
end

func notes_draw_rows(c, t, s, p, left, row):
    while row != 21:
        do notes_draw_line(c, t, s, p, 0, left, 102 + row * 20)
        let e = text_line_end(t, p)
        if e >= text_length(t): return 0 end
        p = e + 1
        row = row + 1
    end
    return 0
end

func notes_draw_query(c, query, count, p, x):
    while p < count:
        let next = unicode_grapheme_next(query, count, p)
        do pixel_unicode_cluster(c, query, p, next, x, 578, 1)
        p = next
        x = x + 6
    end
    return 0
end

-- Inspect the query before drawing the status line so its fallback label is
-- current in the same frame. Call only while the Find field is visible.
func notes_query_missing(query, count, p):
    while p < count:
        let next = unicode_grapheme_next(query, count, p)
        if not unicode_display_supported(query, p, next): return true end
        p = next
    end
    return false
end

func notes_graphemes(bytes, count, p, n):
    while p < count:
        p = unicode_grapheme_next(bytes, count, p)
        n = n + 1
    end
    return n
end

func notes_skip(bytes, count, p, n):
    while n != 0 and p < count:
        p = unicode_grapheme_next(bytes, count, p)
        n = n - 1
    end
    return p
end

-- The Open field shows the path's last 130 characters.
func notes_path_start(bytes, count):
    let total = notes_graphemes(bytes, count, 0, 0)
    if total <= 130: return 0 end
    return notes_skip(bytes, count, 0, total - 130)
end

func notes_draw_hex(c, value, digits, x):
    while digits != 0:
        let digit = value % 16
        let ch = 48 + digit
        if digit >= 10: ch = 65 + digit - 10 end
        do pixel_letter(c, pixel_glyph(ch), x + (digits - 1) * 6, 580, 1, 0)
        value = value / 16
        digits = digits - 1
    end
    return 0
end

func notes_warning(message):
    if (message >= 3 and message <= 11) or message == 13 or message == 14 or message == 17 or message == 18: return true end
    return (message >= 22 and message <= 30) or (message >= 32 and message <= 41) or message == 43 or message == 44 or (message >= 45 and message <= 49)
end

-- The refused saves and rescues: while the close prompt is pending, each says
-- its reason, shorter except the general rescue failure (9), whose sentence is
-- short already, and keeps the prompt's own instruction beside it.
func notes_refusal(message): return message == 4 or message == 9 or (message >= 45 and message <= 49) end

-- Highlight [a, b) behind the visible rows: the selection, or Find's match. A
-- selected newline shows as a half-cell stub at the end of its line.
func notes_draw_marks(c, t, p, left, row, a, b):
    while row != 21 and p <= b:
        let e = text_line_end(t, p)
        if b > p and a <= e:
            let from = a
            if from < p: from = p end
            let to = b
            if to > e: to = e end
            let c0 = text_column_loop(t, p, from, 0)
            let c1 = text_column_loop(t, from, to, c0)
            if c0 < left: c0 = left end
            if c1 > left + 70: c1 = left + 70 end
            let width = 0
            if c1 > c0: width = (c1 - c0) * 12 end
            if b > e and e < text_length(t) and c1 >= c0 and c1 < left + 70: width = width + 6 end
            if width > 0: let mark = x11_rect(c, 28 + (c0 - left) * 12, 100 + row * 20, width, 20) end
        end
        if e >= text_length(t): return 0 end
        p = e + 1
        row = row + 1
    end
    return 0
end

func notes_status(c, f, t, s, query):
    do x11_color(c, 11255503)
    do pixel_text(c, "Line", 28, 542, 1)
    do pixel_number(c, text_row(t, text_cursor(t)) + 1, 62, 542, 1)
    do pixel_text(c, "Column", 124, 542, 1)
    do pixel_number(c, text_column(t, text_cursor(t)) + 1, 170, 542, 1)
    do pixel_text(c, "Bytes", 248, 542, 1)
    let bytes = pixel_number(c, text_file_length(t), 288, 542, 1)
    do pixel_text(c, "/", 336, 542, 1)
    do pixel_number(c, notes_capacity(), 348, 542, 1)
    let style = "LF"
    if text_crlf(t): style = "CRLF" end
    do pixel_text(c, style, 402, 542, 1)
    let encoding = "UTF-8"
    if s.missing_glyphs: encoding = "UTF-8 | Boxed glyphs unavailable" end
    do pixel_text(c, encoding, 450, 542, 1)
    let dirty = "Saved"
    if s.dirty: dirty = "UNSAVED" end
    do pixel_text(c, dirty, 806, 542, 1)
    -- On a read-only document the sentence after an edit, the close prompt and the help row under it say
    -- that Ctrl+Shift+S saves a copy where they would say that Ctrl+S saves; Ctrl+O's refusal names the
    -- copy too, and still says that Ctrl+O opens another file only after Ctrl+S saves. The key list on
    -- row 580, drawn when no prompt is up, still lists Ctrl+S, which message 45 then refuses.
    let readonly = notes_read_only(f)
    if readonly: do pixel_text(c, "read-only |", 734, 542, 1) end
    let message = s.message_id
    let status = "Ready. UTF-8 text; original bytes and newline style are preserved."
    if message == 1 and s.dirty:
        status = "Edited. Ctrl+S saves this document."
        if readonly: status = "Edited. This file is read-only; Ctrl+Shift+S saves a copy." end
    end
    if message == 2: status = "Saved. File and containing directory synced." end
    if message == 3: status = "Not enough space (" end
    if message == 4: status = "Save failed; no replacement this attempt. Ctrl+Shift+S saves a rescue copy." end
    if message == 5:
        status = "Unsaved: Y discards edits; latest recovery INCOMPLETE. Esc returns | Ctrl+S saves."
        if readonly: status = "Unsaved: Y discards edits; latest recovery INCOMPLETE. Esc returns | Ctrl+Shift+S saves a copy." end
        if not s.recovery_attempted:
            status = "Save unconfirmed: Y closes; NO recovery copy. Esc returns | Ctrl+S retries."
            if readonly: status = "Save unconfirmed: Y closes; NO recovery copy. Esc returns | Ctrl+Shift+S saves a copy." end
        end
        if notes_recovery_current(s):
            status = "Unsaved: Y closes (recovery kept). Esc returns. Ctrl+S saves. Ctrl+Shift+S rescues."
            if readonly: status = "Unsaved: Y closes (recovery kept). Esc returns. Ctrl+Shift+S saves a copy." end
        end
    end
    if message == 6: status = "Written; sync/verification failed. Ctrl+S retries; Ctrl+Shift+S rescues." end
    if message == 7: status = "Rescue copy saved. Original stays open; its unsaved state is unchanged." end
    if message == 8: status = "Rescue copy written, but directory sync failed. Keep this window open." end
    if message == 10: status = "No more undo history (up to 256 edits / " end
    if message == 11: status = "No more redo history." end
    if message == 12: status = "Match. F3 next | Shift+F3 previous | Ctrl+F new search" end
    if message == 13: status = "No matching text. Search is case-sensitive and wraps at either end." end
    if message == 15: status = "Type a case-sensitive search. Enter next | Shift+Enter previous | Esc done" end
    if message == 14: status = "Search is limited to 64 UTF-8 bytes." end
    if message == 16: status = "Unicode entry: type up to 6 hex digits, then Enter/Space. Esc cancels." end
    if message == 17: status = "Unicode entry: at most 6 hex digits. Backspace removes one." end
    if message == 18: status = "Not an allowed Unicode character. Text is unchanged." end
    if message == 9: status = "Rescue failed; no copy published this attempt. Your edits remain here." end
    if message == 19: status = "Open: type a path. Enter opens | Esc cancels. A name that does not exist yet starts an empty file." end
    if message == 20: status = "Opened. Original bytes and newline style are preserved." end
    if message == 21: status = "New file. It is created when you save with Ctrl+S." end
    if message == 22:
        status = "Unsaved edits. Ctrl+S saves (or Ctrl+Shift+S rescues) before Ctrl+O opens another file."
        if readonly: status = "Unsaved edits to a read-only file. Ctrl+Shift+S saves a copy; Ctrl+O opens another file after Ctrl+S saves." end
    end
    if message == 23: status = "Not opened: the file exceeds the " end
    if message == 24: status = "Not opened: symbolic links are refused. Open the intended file directly." end
    if message == 25: status = "Not opened: multiply hardlinked files are refused to preserve their links." end
    if message == 26: status = "Not opened: the file changed while opening. Try again." end
    if message == 27: status = "Not opened: expected valid UTF-8 text, TAB and uniform LF or CRLF." end
    if message == 28: status = "Not opened: no such folder, no permission, or a file owned by another account. Error" end
    if message == 29: status = "A path is limited to 4095 bytes." end
    if message == 30: status = "Not opened: name a regular file, not a folder." end
    if message == 31: status = "Copied." end
    if message == 32: status = "Nothing is selected. Shift with a movement key, or Ctrl+A, selects text." end
    if message == 33: status = "Nothing to paste. Ctrl+C or Ctrl+X copies a selection first." end
    if message == 34: status = "A path or search takes one line of text, without tabs." end
    if message == 35: status = "This edit is too large to undo, so it was not made." end
    if message == 36: status = "Nothing to paste: no application offers text on the clipboard." end
    if message == 37: status = "The clipboard's owner did not answer in time. Nothing was pasted." end
    if message == 38: status = "The clipboard holds no text Notes can paste." end
    if message == 39: status = "The clipboard text is larger than Notes can paste (65,504 bytes)." end
    if message == 40: status = "Not pasted: the clipboard text has control characters, a bare CR or invalid UTF-8." end
    if message == 41: status = "Not copied: the selection is larger than the clipboard holds (65,536 bytes)." end
    if message == 42: status = "Go to line: type a number, then Enter. Esc cancels. Ctrl+Home and Ctrl+End jump to the top and bottom." end
    if message == 43: status = "Go to line: at most 7 digits. Backspace removes one." end
    if message == 44: status = "Type a line number first, then Enter. Esc cancels." end
    if message == 45: status = "Not saved: this file is read-only. Make it writable and press Ctrl+S again, or Ctrl+Shift+S to save a copy beside it." end
    if message == 46: status = "Not saved: another program changed this file or its permissions since it was opened. Ctrl+Shift+S saves a copy beside it." end
    if message == 47: status = "Not saved: no permission to write in this folder, or the file belongs to another account. Fix it, then Ctrl+S." end
    if message == 48: status = "Not saved: the file was deleted or moved since it was opened. Ctrl+Shift+S saves a copy beside it." end
    if message == 49: status = "Rescue failed: no permission to write in this folder. Fix the folder, then Ctrl+Shift+S again." end
    if s.confirming and message == 7:
        status = "Rescue saved. Close pending: Y closes; Esc returns."
    end
    if s.confirming and message == 8:
        status = "Copy written; sync uncertain. Close pending: Y closes; Esc returns."
    end
    let pending = s.confirming and notes_refusal(message)
    if pending:
        if message == 4: status = "Save failed; nothing replaced. Ctrl+Shift+S saves a rescue copy." end
        if message == 45: status = "Not saved: read-only. Make it writable, or Ctrl+Shift+S saves a copy." end
        if message == 46: status = "Not saved: the file or its permissions changed. Ctrl+Shift+S saves a copy." end
        if message == 47: status = "Not saved: no permission in this folder, or the file is not yours." end
        if message == 48: status = "Not saved: the file was deleted or moved. Ctrl+Shift+S saves a copy." end
        if message == 49: status = "Rescue failed: no permission to write in this folder." end
    end
    if notes_warning(message): let warning = x11_color(c, 16173151) end
    do pixel_text(c, status, 28, 560, 1)
    if pending:
        -- The instruction of the close prompt that is up (message 5), in its own words.
        let closing = " Close pending: Y discards edits; Esc returns."
        if not s.recovery_attempted: closing = " Close pending: Y closes; NO recovery copy; Esc returns." end
        if notes_recovery_current(s): closing = " Close pending: Y closes (recovery kept); Esc returns." end
        do pixel_text(c, closing, 28 + 6 * length(status), 560, 1)
    end
    if message == 3 or message == 23 or message == 10:
        -- the limit's number (or the history budget, twice it) and the rest of the sentence follow the prefix, drawn in place
        let number = notes_capacity()
        if message == 10: number = 2 * notes_capacity() end
        let after = pixel_number(c, number, 28 + 6 * length(status), 560, 1)
        if message == 3: do pixel_text(c, "-byte limit). Delete text before inserting more.", after, 560, 1) end
        if message == 23: do pixel_text(c, "-byte limit. This document is unchanged.", after, 560, 1) end
        if message == 10: do pixel_text(c, " history bytes).", after, 560, 1) end
    end
    if message == 4 or message == 9:
        do pixel_number(c, 0 - s.save_result, 830, 560, 1)
    end
    if message == 28:
        do pixel_number(c, 0 - s.open_result, 830, 560, 1)
    end
    if s.unicode_input and not s.confirming:
        do pixel_text(c, "Unicode U+", 28, 580, 1)
        do notes_draw_hex(c, s.unicode_value, s.unicode_digits, 88)
    elif s.going and not s.confirming:
        do pixel_text(c, "Go to line:", 28, 580, 1)
        if s.line_digits > 0: do pixel_number(c, s.line_value, 100, 580, 1) end
    elif s.opening and not s.confirming:
        do pixel_text(c, "Open:", 28, 580, 1)
        do notes_draw_query(c, s.path, s.path_count, notes_path_start(s.path, s.path_count), 70)
    elif s.finding and not s.confirming:
        do pixel_text(c, "Find:", 28, 580, 1)
        do notes_draw_query(c, query, s.query_count, 0, 70)
        do pixel_text(c, "Enter next | Shift+Enter previous | Esc done", 570, 580, 1)
    elif message == 7 or message == 8:
        do pixel_text(c, "Sibling file:", 28, 580, 1)
        let name = file_copy_name(f)
        do pixel_text_buffer(c, name, 0, linux_nul_end(name, 0, buffer_length(name)), 112, 580, 1)
    elif s.confirming and (message != 5 or readonly):
        -- The close prompt's three forms, as message 5 words them: after any other message replaces message 5,
        -- and under message 5 itself on a read-only document, where the key list would say that Ctrl+S saves.
        let closehelp = "Close pending: Y discards edits"
        let tail = " | Esc returns | Ctrl+S saves"
        if not s.recovery_attempted:
            closehelp = "Close pending: Y closes; NO recovery copy"
            tail = " | Esc returns | Ctrl+S retries"
        end
        if notes_recovery_current(s): closehelp = "Close pending: Y closes (recovery kept)" end
        if readonly: tail = " | Esc returns | Ctrl+Shift+S saves a copy" end
        do pixel_text(c, closehelp, 28, 580, 1)
        do pixel_text(c, tail, 28 + 6 * length(closehelp), 580, 1)
    else:
        do pixel_text(c, "Ctrl+S save | Ctrl+O open | Ctrl+G line | Ctrl+X/C/V cut, copy, paste | Ctrl+Z/Y undo, redo | Ctrl+F find | Ctrl+Shift+U Unicode | Ctrl+Q close", 28, 580, 1)
    end
    return 0
end

-- At most cells characters of text, from x.
func notes_text_cut(c, text, x, y, cells):
    let i = 0
    while i < length(text) and i < cells:
        do pixel_letter(c, pixel_glyph(index(text, i)), x + i * 6, y, 1, 0)
        i = i + 1
    end
    return 0
end

-- Line y=85 from the open of a document beside session folders until its first
-- edit (notes_recovery_scan): how many there are and the newest one's copy to
-- open, in amber, saying that copy differs from the file, when it does.
-- The folder's name is drawn as listed; a name too long for the row is cut at
-- the row's end, so the line keeps to its 130 characters (Notes's own names
-- fit).
func notes_draw_found(c, s):
    let name = file_scan_name(s.scan)
    let copies = "Recovery copies from earlier sessions sit beside this file ("
    let newest = "). Newest: "
    if s.found_differs:
        do x11_color(c, 16173151)
        copies = "Recovery copies beside this file ("
        newest = "). The newest differs from this file. Open "
    end
    do pixel_text(c, copies, 28, 85, 1)
    let x = pixel_number(c, s.found, 28 + 6 * length(copies), 85, 1)
    do pixel_text(c, newest, x, 85, 1)
    x = x + 6 * length(newest)
    let count = linux_nul_end(name, 0, buffer_length(name))
    if count > (808 - x) / 6: count = (808 - x) / 6 end
    do pixel_text_buffer(c, name, 0, count, x, 85, 1)
    x = x + 6 * count
    return notes_text_cut(c, "/recovery.txt", x, 85, (808 - x) / 6)
end

func notes_draw(c, f, t, s, recovery, query, blink):
    do notes_view(t, s)
    do x11_color(c, 1054759)
    do x11_rect(c, 0, 0, 900, 600)
    do x11_color(c, 15265527)
    do pixel_text(c, "Herbert Notes", 28, 24, 3)
    do x11_color(c, 8820395)
    do pixel_text(c, "PLAIN TEXT", 688, 39, 2)
    do pixel_text(c, "File:", 28, 72, 1)
    let pathcount = linux_nul_end(f.path, 0, buffer_length(f.path))
    if pathcount > 130: pathcount = 130 end
    do pixel_text_buffer(c, f.path, 0, pathcount, 70, 72, 1)
    do x11_color(c, 8820395)
    let recoverylabel = "Recovery: created on first edit; copies are kept until you remove them."
    if s.recovery_attempted:
        recoverylabel = "Recovery copy kept beside this file:"
        if s.recovery_result != 0:
            do x11_color(c, 16173151)
            recoverylabel = "RECOVERY INCOMPLETE. Save or rescue. Attempted path:"
        end
        do pixel_text_buffer(c, recovery.2, 0, linux_nul_end(recovery.2, 0, buffer_length(recovery.2)), 352, 85, 1)
    end
    if s.found > 0 and not s.recovery_attempted:
        do notes_draw_found(c, s)
    else:
        do pixel_text(c, recoverylabel, 28, 85, 1)
    end
    do x11_color(c, 2767956)
    do x11_rect(c, 24, 96, 852, 428)
    do x11_color(c, 1384240)
    do x11_rect(c, 26, 98, 848, 424)
    let first = text_row_offset(t, s.top)
    if notes_selected(t, s):
        do x11_color(c, 3033707)
        do notes_draw_marks(c, t, first, s.left, 0, notes_from(t, s), notes_to(t, s))
    elif s.finding and s.query_matched and not s.unicode_input and not s.confirming:
        do x11_color(c, 6969880)
        do notes_draw_marks(c, t, first, s.left, 0, text_cursor(t), text_cursor(t) + s.query_count)
    end
    do x11_color(c, 15265527)
    s.missing_glyphs = false
    do notes_draw_rows(c, t, s, first, s.left, 0)
    if s.finding and not s.unicode_input and not s.confirming:
        if notes_query_missing(query, s.query_count, 0):
            s.missing_glyphs = true
        end
    end
    if s.opening and not s.unicode_input and not s.confirming:
        if notes_query_missing(s.path, s.path_count, notes_path_start(s.path, s.path_count)):
            s.missing_glyphs = true
        end
    end
    if blink:
        -- The caret, when the cursor is in view (the wheel can scroll it out).
        let col = text_column(t, text_cursor(t))
        let row = text_row(t, text_cursor(t))
        if row >= s.top and row < s.top + 21 and col >= s.left and col < s.left + 70:
            do x11_color(c, 16173151)
            do x11_rect(c, 28 + (col - s.left) * 12, 100 + (row - s.top) * 20, 2, 18)
        end
    end
    do notes_status(c, f, t, s, query)
    s.needs_draw = false
    return x11_present(c)
end

func notes_loop(c, t, s, recovery, query, event, lastblink):
    while true:
        do x11_events(c)
        do x11_serve(c)
        -- Accepted typing belongs to the document before a batched WM close is
        -- considered. In particular, a queued ordinary Y must not confirm discard.
        do notes_keys(c, t, s, recovery, query, event)
        do notes_checkpoint(recovery, s.doc, t, s)
        if x11_closed(c): let requested = notes_request_close(c, s.doc, t, s, recovery) end
        let now = linux_clock_ms(c.clock)
        do x11_need(not linux_error(now), "notes: monotonic clock failed\n")
        -- A drag held past the text's edge scrolls one row or column per 50 ms.
        let held = s.dragging and not notes_in_text(s.drag_x, s.drag_y)
        if held and now - s.scrolled_at >= 50:
            s.scrolled_at = now
            do text_seek(t, notes_point(t, s, s.drag_x, s.drag_y))
            do notes_redraw(s)
        end
        let blink = (now / 500) % 2
        if s.needs_draw or blink != lastblink:
            do notes_draw(c, s.doc, t, s, recovery, query, blink == 0)
        elif x11_exposed(c):
            -- Refresh the retained pixmap after uncovering/expose without rebuilding
            -- all glyphs. Repainting and blinking allocate no new objects.
            do x11_present(c)
        end
        do x11_ack_expose(c)
        let wait = 500 - now % 500
        if held and wait > 50: wait = 50 end
        let waited = linux_poll(c.state.fd, c.poll, 1, wait)
        do x11_need(not linux_error(waited) or waited == 0 - 4, "notes: input wait failed\n")
        lastblink = blink
    end
    return 0
end

func main():
    let args = linux_arguments()
    let path = linux_argument(args, 1)
    if equal(path, ""): path = "notes.txt" end
    if not equal(linux_argument(args, 2), ""): return linux_die("usage: notes [plain-text-file]\n") end
    let opened = file_open(path, notes_capacity())
    if file_status(opened) != 0:
        let status = file_status(opened)
        do file_close(opened)
        if status == 0 - 27: return linux_die(notes_limit_text("notes: file exceeds the ", "-byte limit. No file changed.\n")) end
        if status == 0 - 40: return linux_die("notes: symbolic-link documents are refused. Open the intended regular file directly.\n") end
        if status == 0 - 31: return linux_die("notes: multiply hardlinked documents are refused to preserve their link structure.\n") end
        if status == 0 - 116: return linux_die("notes: file changed while opening. Try again after the other writer finishes.\n") end
        return linux_die("notes: cannot open a regular, singly linked file owned by you (or its parent). No file changed.\n")
    end
    let t = text_buffer_history(notes_capacity(), 2 * notes_capacity())
    let loaded = text_load(t, opened.bytes, file_count(opened))
    if loaded != 0:
        do file_close(opened)
        return linux_die("notes: expected valid UTF-8 text, TAB and uniform LF or CRLF. Invalid encoding, controls and mixed endings are refused unchanged.\n")
    end
    let f = opened
    let s = NotesState(f, file_new(notes_capacity()), 0, 0, false, false, 0, 0, false, false, 0, false, false, 0, false, false, false, 0, 0, false, linux_buffer(4096), 0, 0, 0 - 1, linux_buffer(65536), 0, false, 0, 0, 0, false, false, 0, 0, file_scan_new(), 0, false)
    do notes_recovery_scan(s)
    let recovery = recovery_new(notes_capacity())
    let query = linux_buffer(64)
    s.needs_draw = true
    let c = x11_open(900, 600, "Herbert - Notes")
    do x11_enable_text(c)
    do x11_enable_clipboard(c, 65536)
    do x11_enable_pointer(c)
    let event = linux_buffer(16)
    return notes_loop(c, t, s, recovery, query, event, 0 - 1)
end
