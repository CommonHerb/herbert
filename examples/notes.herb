-- A bounded plain-text editor, compiled and supported entirely in Herbert.
-- Libraries: linux, utf8, unicode_grapheme, file_io, text_buffer,
-- session_recovery, x11, pixel_text, unicode_display. UTF-8 + LF/CRLF + TAB.
-- App state is one reference record, built once in main and updated in place.
-- It holds the open document's File and a spare one: Ctrl+O loads the spare and
-- the two swap, so opening a file allocates nothing either. The selection runs
-- from anchor (-1 when there is none) to the cursor; the clipboard is a fixed
-- buffer of logical (LF) text.
-- No per-event/frame/save string or tuple creation.

ref record NotesState:
    doc: File
    spare: File
    top: int
    left: int
    dirty: bool
    confirming: bool
    message_id: int
    save_result: int
    needs_draw: bool
    checkpoint_pending: bool
    recovery_result: int
    recovery_attempted: bool
    finding: bool
    query_count: int
    query_matched: bool
    missing_glyphs: bool
    unicode_input: bool
    unicode_value: int
    unicode_digits: int
    opening: bool
    path: buffer
    path_count: int
    open_result: int
    anchor: int
    clip: buffer
    clip_count: int
end

func notes_redraw(s):
    s.needs_draw = true
    return 0
end

func notes_message(s, message):
    s.message_id = message
    return notes_redraw(s)
end

func notes_changed(s):
    s.anchor = 0 - 1
    s.dirty = true
    s.checkpoint_pending = true
    return notes_message(s, 1)
end

func notes_checkpoint(recovery, f, t, s):
    if not s.checkpoint_pending: return 0 end
    let checkpoint = recovery_save(recovery, f, text_file_bytes(t), text_file_length(t))
    s.recovery_result = checkpoint
    s.recovery_attempted = true
    s.checkpoint_pending = false
    return notes_redraw(s)
end

func notes_recovery_current(s):
    return s.recovery_attempted and s.recovery_result == 0 and not s.checkpoint_pending
end

func notes_quit(c, f, t, s, recovery):
    let checkpoint = notes_checkpoint(recovery, f, t, s)
    let closedrecovery = recovery_close(recovery)
    let closedfile = file_close(f)
    let closedspare = file_close(s.spare)
    let closedwindow = x11_close(c)
    do process_exit(0)
    return 0
end

func notes_request_close(c, f, t, s, recovery):
    s.unicode_input = false
    s.opening = false
    let checkpoint = notes_checkpoint(recovery, f, t, s)
    let acknowledged = x11_ack_close(c)
    if not s.dirty: return notes_quit(c, f, t, s, recovery) end
    s.confirming = true
    return notes_message(s, 5)
end

func notes_save(f, t, s):
    if s.recovery_attempted and s.recovery_result != 0:
        s.checkpoint_pending = true
    end
    let result = file_save(f, text_file_bytes(t), text_file_length(t))
    s.save_result = result
    if result == 0:
        s.dirty = false
        s.confirming = false
        return notes_message(s, 2)
    elif result == 1:
        -- Publication happened; retain dirty/confirmation so the warning is
        -- visible. A successful retry can establish durability and clear it.
        s.dirty = true
        return notes_message(s, 6)
    end
    return notes_message(s, 4)
end

func notes_save_copy(f, t, s):
    let result = file_save_copy(f, text_file_bytes(t), text_file_length(t))
    s.save_result = result
    -- A rescue never adopts a new document or clears the original's dirty or
    -- close-confirmation state. Show the exact sibling basename by leaving any
    -- input panel after publication. The last search query remains repeatable.
    if result == 0 or result == 1:
        s.finding = false
        s.unicode_input = false
    end
    if result == 0: return notes_message(s, 7) end
    if result == 1: return notes_message(s, 8) end
    return notes_message(s, 9)
end

func notes_find(t, s, query, backward, advance):
    if s.query_count == 0:
        s.finding = true
        return notes_message(s, 15)
    end
    let start = text_cursor(t)
    if advance:
        if backward:
            if start == 0: start = 0 - 1 else: start = start - 1 end
        else:
            start = start + 1
        end
    end
    let found = text_find(t, query, s.query_count, start, backward)
    s.query_matched = false
    if found != 0 - 1:
        let moved = text_seek(t, found)
        s.query_matched = true
        return notes_message(s, 12)
    end
    return notes_message(s, 13)
end

-- Text arrives as Unicode scalar values. Encode an entire scalar or reject it;
-- query input and document input never expose a partial UTF-8 sequence.
func notes_insert_scalar(t, s, query, ch):
    if not utf8_text_allowed(ch): return notes_message(s, 18) end
    if s.opening:
        if ch == 9 or ch == 10: return notes_message(s, 18) end
        let count = s.path_count
        if utf8_width(ch) > 4095 - count: return notes_message(s, 29) end
        let next = utf8_store(s.path, count, ch)
        s.path_count = next
        return notes_message(s, 19)
    end
    if s.finding:
        if ch == 9 or ch == 10: return notes_message(s, 18) end
        let count = s.query_count
        let width = utf8_width(ch)
        if width > 64 - count: return notes_message(s, 14) end
        let next = utf8_store(query, count, ch)
        s.query_count = next
        return notes_find(t, s, query, false, false)
    end
    if notes_selected(t, s):
        let replaced = text_replace_scalar(t, notes_from(t, s), notes_to(t, s), ch)
        return notes_edited(s, replaced)
    end
    let changed = text_insert(t, ch)
    if changed == 0: return notes_message(s, 3) end
    return notes_changed(s)
end

func notes_selected(t, s): return s.anchor != 0 - 1 and s.anchor != text_cursor(t) end

func notes_from(t, s):
    if s.anchor < text_cursor(t): return s.anchor end
    return text_cursor(t)
end

func notes_to(t, s):
    if s.anchor > text_cursor(t): return s.anchor end
    return text_cursor(t)
end

-- A text_replace result: 1 changed, 0 no room (65,536-byte limit), 2 too large to undo.
func notes_edited(s, result):
    if result == 1: return notes_changed(s) end
    if result == 2: return notes_message(s, 35) end
    return notes_message(s, 3)
end

func notes_copy(t, s):
    if not notes_selected(t, s): return notes_message(s, 32) end
    let start = notes_from(t, s)
    let count = notes_to(t, s) - start
    let copied = linux_copy(s.clip, 0, t.0, start, count)
    s.clip_count = count
    return notes_message(s, 31)
end

func notes_cut(t, s):
    if not notes_selected(t, s): return notes_message(s, 32) end
    let copied = notes_copy(t, s)
    return notes_edited(s, text_replace(t, notes_from(t, s), notes_to(t, s), s.clip, 0, 0))
end

-- One line for the Open and Find fields: valid text without TAB or newline.
func notes_line_valid(bytes, p, count):
    if p >= count: return true end
    let decoded = utf8_decode(bytes, p, count)
    if linux_error(decoded.0) or decoded.0 == 9 or decoded.0 == 10 or not utf8_text_allowed(decoded.0): return false end
    return notes_line_valid(bytes, decoded.1, count)
end

-- Fields take one line: one trailing newline is dropped, and anything else
-- multi-line, a TAB or a disallowed character refuses the whole paste.
func notes_paste_field(t, s, query, bytes, count):
    if count > 0 and buffer_get(bytes, count - 1) == 10: count = count - 1 end
    if not notes_line_valid(bytes, 0, count): return notes_message(s, 34) end
    if s.opening:
        if count > 4095 - s.path_count: return notes_message(s, 29) end
        let copied = linux_copy(s.path, s.path_count, bytes, 0, count)
        s.path_count = s.path_count + count
        return notes_message(s, 19)
    end
    if count > 64 - s.query_count: return notes_message(s, 14) end
    let copied = linux_copy(query, s.query_count, bytes, 0, count)
    s.query_count = s.query_count + count
    return notes_find(t, s, query, false, false)
end

-- Pasted text replaces the selection, or goes in at the cursor, as one undo step.
func notes_paste(t, s, query):
    if s.clip_count == 0: return notes_message(s, 33) end
    if s.opening or s.finding: return notes_paste_field(t, s, query, s.clip, s.clip_count) end
    let start = text_cursor(t)
    let stop = start
    if notes_selected(t, s):
        start = notes_from(t, s)
        stop = notes_to(t, s)
    end
    return notes_edited(s, text_replace(t, start, stop, s.clip, 0, s.clip_count))
end

func notes_hex_digit(key):
    if key >= 48 and key <= 57: return key - 48 end
    if key >= 65 and key <= 70: return key - 65 + 10 end
    if key >= 97 and key <= 102: return key - 97 + 10 end
    return 0 - 1
end

-- Ctrl+Shift+U, hex digits, Enter/Space is an explicit scalar-entry method.
-- Compose/IME services are not used. Escape cancels without editing anything.
func notes_unicode_key(t, s, query, key, mods):
    if key == 65307:
        s.unicode_input = false
        return notes_message(s, 1)
    end
    if (mods & 12) != 0: return 0 end
    let digits = s.unicode_digits
    if key == 65288:
        if digits > 0:
            s.unicode_value = s.unicode_value / 16
            s.unicode_digits = digits - 1
        end
        return notes_message(s, 16)
    end
    if key == 65293 or key == 32:
        let value = s.unicode_value
        if digits == 0 or not utf8_text_allowed(value): return notes_message(s, 18) end
        if (s.finding or s.opening) and (value == 9 or value == 10): return notes_message(s, 18) end
        s.unicode_input = false
        return notes_insert_scalar(t, s, query, value)
    end
    let digit = notes_hex_digit(key)
    if digit == 0 - 1: return 0 end
    if digits == 6: return notes_message(s, 17) end
    s.unicode_value = s.unicode_value * 16 + digit
    s.unicode_digits = digits + 1
    return notes_message(s, 16)
end

func notes_search_key(t, s, query, key, mods):
    if key == 65307:
        s.finding = false
        return notes_message(s, 1)
    end
    if key == 65293 or key == 65472:
        return notes_find(t, s, query, (mods & 1) != 0, s.query_matched)
    end
    if (mods & 12) != 0: return 0 end
    if key == 65288:
        let count = s.query_count
        let previous = unicode_grapheme_previous(query, count, count)
        s.query_count = previous
        return notes_find(t, s, query, false, false)
    end
    let ch = x11_text_scalar(key)
    if ch == 0 - 1: return 0 end
    return notes_insert_scalar(t, s, query, ch)
end

-- Paths are bytes; offer only a prefix the Open field can show and edit.
func notes_path_valid(bytes, p, count):
    if p >= count: return true end
    let decoded = utf8_decode(bytes, p, count)
    if linux_error(decoded.0) or decoded.0 == 9 or decoded.0 == 10 or not utf8_text_allowed(decoded.0): return false end
    return notes_path_valid(bytes, decoded.1, count)
end

-- The Open field starts with the open document's folder, absolute when the
-- working directory is known, so a typed name opens beside that document.
func notes_open_prefix(s):
    let f = s.doc
    let count = linux_nul_end(f.path, 0, buffer_length(f.path))
    let slash = file_path_scan(f.path, count, 0, 0 - 1)
    let folder = 0
    if slash < count: folder = slash + 1 end
    let at = 0
    if count == 0 or buffer_get(f.path, 0) != 47:
        let got = linux_syscall6(79, buffer_address(s.path), buffer_length(s.path), 0, 0, 0, 0)
        if not linux_error(got) and got > 1:
            at = got - 1
            if buffer_get(s.path, at - 1) != 47:
                let separator = buffer_set(s.path, at, 47)
                at = at + 1
            end
        end
    end
    if at + folder > 4095: return 0 end
    let copied = linux_copy(s.path, at, f.path, 0, folder)
    if not notes_path_valid(s.path, 0, at + folder): return 0 end
    return at + folder
end

func notes_open_start(s):
    if s.dirty: return notes_message(s, 22) end
    s.anchor = 0 - 1
    s.finding = false
    s.opening = true
    s.path_count = notes_open_prefix(s)
    return notes_message(s, 19)
end

func notes_open_error(status):
    if status == 0 - 27: return 23 end
    if status == 0 - 40: return 24 end
    if status == 0 - 31: return 25 end
    if status == 0 - 116: return 26 end
    if status == 0 - 22: return 30 end
    return 28
end

-- Load the typed path into the spare File, then its text, and swap. A refusal
-- leaves the open document, its text, history and recovery session as they were.
func notes_open(t, s, recovery):
    if s.dirty: return notes_message(s, 22) end
    let checkpoint = notes_checkpoint(recovery, s.doc, t, s)
    let g = s.spare
    let loaded = file_load(g, s.path, s.path_count)
    if loaded != 0:
        let closed = file_close(g)
        s.open_result = loaded
        return notes_message(s, notes_open_error(loaded))
    end
    let text = text_load(t, g.bytes, file_count(g))
    if text != 0:
        let closed = file_close(g)
        s.open_result = text
        if text == 0 - 27: return notes_message(s, 23) end
        return notes_message(s, 27)
    end
    let old = s.doc
    s.doc = g
    s.spare = old
    let closedold = file_close(old)
    let reset = recovery_reset(recovery)
    s.top = 0
    s.left = 0
    s.confirming = false
    s.save_result = 0
    s.checkpoint_pending = false
    s.recovery_result = 0
    s.recovery_attempted = false
    s.opening = false
    s.query_matched = false
    if g.state.exists: return notes_message(s, 20) end
    return notes_message(s, 21)
end

func notes_open_key(t, s, recovery, query, key, mods):
    if key == 65307:
        s.opening = false
        return notes_message(s, 1)
    end
    if key == 65293: return notes_open(t, s, recovery) end
    if (mods & 12) != 0: return 0 end
    if key == 65288:
        let previous = unicode_grapheme_previous(s.path, s.path_count, s.path_count)
        s.path_count = previous
        return notes_message(s, 19)
    end
    let ch = x11_text_scalar(key)
    if ch == 0 - 1: return 0 end
    return notes_insert_scalar(t, s, query, ch)
end

func notes_key(c, t, s, recovery, query, key, mods):
    let f = s.doc
    let control = (mods & 4) != 0
    if control and (mods & 1) != 0 and (key == 115 or key == 83): return notes_save_copy(f, t, s) end
    if control and (key == 115 or key == 83): return notes_save(f, t, s) end
    if s.confirming:
        if key == 65307:
            s.confirming = false
            return notes_message(s, 1)
        elif (key == 121 or key == 89) and (mods & 204) == 0:
            return notes_quit(c, f, t, s, recovery)
        end
        return 0
    end
    if s.unicode_input: return notes_unicode_key(t, s, query, key, mods) end
    if control and (mods & 1) != 0 and (key == 117 or key == 85):
        s.unicode_input = true
        s.unicode_value = 0
        s.unicode_digits = 0
        return notes_message(s, 16)
    end
    if control and (key == 113 or key == 81): return notes_request_close(c, f, t, s, recovery) end
    if control and (key == 111 or key == 79): return notes_open_start(s) end
    if control and (key == 118 or key == 86): return notes_paste(t, s, query) end
    if s.opening: return notes_open_key(t, s, recovery, query, key, mods) end
    if control and (key == 102 or key == 70):
        s.anchor = 0 - 1
        s.finding = true
        s.query_count = 0
        s.query_matched = false
        return notes_message(s, 15)
    end
    if s.finding: return notes_search_key(t, s, query, key, mods) end
    if key == 65472: return notes_find(t, s, query, (mods & 1) != 0, true) end
    if key == 65307:
        -- The first Escape drops a selection; the next one closes.
        if notes_selected(t, s):
            s.anchor = 0 - 1
            return notes_redraw(s)
        end
        return notes_request_close(c, f, t, s, recovery)
    end
    if (mods & 8) != 0: return 0 end
    let cursor = text_cursor(t)
    let changed = 0
    if control and (key == 97 or key == 65):
        s.anchor = 0
        let all = text_seek(t, text_length(t))
        return notes_redraw(s)
    end
    if control and (key == 99 or key == 67): return notes_copy(t, s) end
    if control and (key == 120 or key == 88): return notes_cut(t, s) end
    -- Shift extends a selection from where it started. Without Shift a movement
    -- key drops it; Left and Right first go to its start or end.
    let selected = notes_selected(t, s)
    if key >= 65360 and key <= 65367:
        if (mods & 1) != 0:
            if s.anchor == 0 - 1: s.anchor = cursor end
        elif selected and (key == 65361 or key == 65363) and not control:
            let edge = notes_from(t, s)
            if key == 65363: edge = notes_to(t, s) end
            s.anchor = 0 - 1
            let collapsed = text_seek(t, edge)
            return notes_redraw(s)
        else:
            if selected: let dropped = notes_redraw(s) end
            s.anchor = 0 - 1
        end
    end
    if selected and (key == 65288 or key == 65535):
        return notes_edited(s, text_replace(t, notes_from(t, s), notes_to(t, s), s.clip, 0, 0))
    end
    if control and (key == 122 or key == 90):
        if (mods & 1) != 0: changed = text_redo(t) else: changed = text_undo(t) end
        if changed == 0:
            if (mods & 1) != 0: return notes_message(s, 11) end
            return notes_message(s, 10)
        end
    elif control and (key == 121 or key == 89):
        changed = text_redo(t)
        if changed == 0: return notes_message(s, 11) end
    elif key == 65361:
        let moved = text_seek(t, text_previous(t, cursor))
    elif key == 65363:
        let moved = text_seek(t, text_next(t, cursor))
    elif key == 65362:
        let moved = text_vertical(t, false, 1)
    elif key == 65364:
        let moved = text_vertical(t, true, 1)
    elif key == 65360:
        let target = text_line_start(t, cursor)
        if control: target = 0 end
        let moved = text_seek(t, target)
    elif key == 65367:
        let target = text_line_end(t, cursor)
        if control: target = text_length(t) end
        let moved = text_seek(t, target)
    elif key == 65365:
        let moved = text_vertical(t, false, 20)
    elif key == 65366:
        let moved = text_vertical(t, true, 20)
    elif control:
        return 0
    elif key == 65288:
        changed = text_backspace(t)
    elif key == 65535:
        changed = text_delete(t)
    else:
        let ch = x11_text_scalar(key)
        if key == 65293: ch = 10 end
        if key == 65289: ch = 9 end
        if ch != 0 - 1: return notes_insert_scalar(t, s, query, ch) end
    end
    if changed != 0: return notes_changed(s) end
    if cursor != text_cursor(t): return notes_redraw(s) end
    return 0
end

func notes_keys(c, t, s, recovery, query, event):
    if not x11_next_key(c, event): return 0 end
    let handled = notes_key(c, t, s, recovery, query, linux_u32(event, 0), linux_u32(event, 4))
    return notes_keys(c, t, s, recovery, query, event)
end

func notes_view(t, s):
    let row = text_row(t, text_cursor(t))
    let col = text_column(t, text_cursor(t))
    let top = s.top
    let left = s.left
    if row < top: top = row end
    if row >= top + 21: top = row - 20 end
    if col < left: left = col end
    if col >= left + 70: left = col - 69 end
    s.top = top
    s.left = left
    return 0
end

func notes_draw_line(c, t, s, p, col, left, y):
    if p >= text_length(t) or col >= left + 70: return 0 end
    let ch = buffer_get(t.0, p)
    if ch == 10: return 0 end
    let next = text_next(t, p)
    if col >= left and ch != 9:
        if not unicode_display_supported(t.0, p, next):
            s.missing_glyphs = true
        end
        let letter = pixel_unicode_cluster(c, t.0, p, next, 28 + (col - left) * 12, y, 2)
    end
    return notes_draw_line(c, t, s, next, text_next_column(col, ch), left, y)
end

func notes_draw_rows(c, t, s, p, left, row):
    if row == 21: return 0 end
    let line = notes_draw_line(c, t, s, p, 0, left, 102 + row * 20)
    let e = text_line_end(t, p)
    if e >= text_length(t): return 0 end
    return notes_draw_rows(c, t, s, e + 1, left, row + 1)
end

func notes_draw_query(c, query, count, p, x):
    if p >= count: return 0 end
    let next = unicode_grapheme_next(query, count, p)
    let letter = pixel_unicode_cluster(c, query, p, next, x, 578, 1)
    return notes_draw_query(c, query, count, next, x + 6)
end

-- Inspect the query before drawing the status line so its fallback label is
-- current in the same frame. Call only while the Find field is visible.
func notes_query_missing(query, count, p):
    if p >= count: return false end
    let next = unicode_grapheme_next(query, count, p)
    if not unicode_display_supported(query, p, next): return true end
    return notes_query_missing(query, count, next)
end

func notes_graphemes(bytes, count, p, n):
    if p >= count: return n end
    return notes_graphemes(bytes, count, unicode_grapheme_next(bytes, count, p), n + 1)
end

func notes_skip(bytes, count, p, n):
    if n == 0 or p >= count: return p end
    return notes_skip(bytes, count, unicode_grapheme_next(bytes, count, p), n - 1)
end

-- The Open field shows the path's last 130 characters.
func notes_path_start(bytes, count):
    let total = notes_graphemes(bytes, count, 0, 0)
    if total <= 130: return 0 end
    return notes_skip(bytes, count, 0, total - 130)
end

func notes_draw_hex(c, value, digits, x):
    if digits == 0: return 0 end
    let digit = value % 16
    let ch = 48 + digit
    if digit >= 10: ch = 65 + digit - 10 end
    let letter = pixel_letter(c, pixel_glyph(ch), x + (digits - 1) * 6, 580, 1, 0)
    return notes_draw_hex(c, value / 16, digits - 1, x)
end

func notes_warning(message):
    if (message >= 3 and message <= 11) or message == 13 or message == 14 or message == 17 or message == 18: return true end
    return (message >= 22 and message <= 30) or (message >= 32 and message <= 35)
end

-- Highlight [a, b) behind the visible rows: the selection, or Find's match. A
-- selected newline shows as a half-cell stub at the end of its line.
func notes_draw_marks(c, t, p, left, row, a, b):
    if row == 21 or p > b: return 0 end
    let e = text_line_end(t, p)
    if b > p and a <= e:
        let from = a
        if from < p: from = p end
        let to = b
        if to > e: to = e end
        let c0 = text_column_loop(t, p, from, 0)
        let c1 = text_column_loop(t, from, to, c0)
        if c0 < left: c0 = left end
        if c1 > left + 70: c1 = left + 70 end
        let width = 0
        if c1 > c0: width = (c1 - c0) * 12 end
        if b > e and e < text_length(t) and c1 >= c0 and c1 < left + 70: width = width + 6 end
        if width > 0: let mark = x11_rect(c, 28 + (c0 - left) * 12, 100 + row * 20, width, 20) end
    end
    if e >= text_length(t): return 0 end
    return notes_draw_marks(c, t, e + 1, left, row + 1, a, b)
end

func notes_status(c, f, t, s, query):
    let color = x11_color(c, 11255503)
    let rowlabel = pixel_text(c, "Line", 28, 542, 1)
    let row = pixel_number(c, text_row(t, text_cursor(t)) + 1, 62, 542, 1)
    let collabel = pixel_text(c, "Column", 124, 542, 1)
    let col = pixel_number(c, text_column(t, text_cursor(t)) + 1, 170, 542, 1)
    let byteslabel = pixel_text(c, "Bytes", 248, 542, 1)
    let bytes = pixel_number(c, text_file_length(t), 288, 542, 1)
    let cap = pixel_text(c, "/ 65536", 330, 542, 1)
    let style = "LF"
    if text_crlf(t): style = "CRLF" end
    let ending = pixel_text(c, style, 402, 542, 1)
    let encoding = "UTF-8"
    if s.missing_glyphs: encoding = "UTF-8 | Boxed glyphs unavailable" end
    let encoded = pixel_text(c, encoding, 450, 542, 1)
    let dirty = "Saved"
    if s.dirty: dirty = "UNSAVED" end
    let label = pixel_text(c, dirty, 806, 542, 1)
    let message = s.message_id
    let status = "Ready. UTF-8 text; original bytes and newline style are preserved."
    if message == 1 and s.dirty: status = "Edited. Ctrl+S saves this document." end
    if message == 2: status = "Saved. File and containing directory synced." end
    if message == 3: status = "Not enough space (65536-byte limit). Delete text before inserting more." end
    if message == 4: status = "Save failed; no replacement this attempt. Ctrl+Shift+S saves a rescue copy." end
    if message == 5:
        status = "Unsaved: Y discards edits; latest recovery INCOMPLETE. Esc returns | Ctrl+S saves."
        if not s.recovery_attempted: status = "Save unconfirmed: Y closes; NO recovery copy. Esc returns | Ctrl+S retries." end
        if notes_recovery_current(s): status = "Unsaved: Y closes (recovery kept). Esc returns. Ctrl+S saves. Ctrl+Shift+S rescues." end
    end
    if message == 6: status = "Written; sync/verification failed. Ctrl+S retries; Ctrl+Shift+S rescues." end
    if message == 7: status = "Rescue copy saved. Original stays open; its unsaved state is unchanged." end
    if message == 8: status = "Rescue copy written, but directory sync failed. Keep this window open." end
    if message == 10: status = "No more undo history (up to 256 edits / 65536 history bytes)." end
    if message == 11: status = "No more redo history." end
    if message == 12: status = "Match. F3 next | Shift+F3 previous | Ctrl+F new search" end
    if message == 13: status = "No matching text. Search is case-sensitive and wraps at either end." end
    if message == 15: status = "Type a case-sensitive search. Enter next | Shift+Enter previous | Esc done" end
    if message == 14: status = "Search is limited to 64 UTF-8 bytes." end
    if message == 16: status = "Unicode entry: type up to 6 hex digits, then Enter/Space. Esc cancels." end
    if message == 17: status = "Unicode entry: at most 6 hex digits. Backspace removes one." end
    if message == 18: status = "Not an allowed Unicode character. Text is unchanged." end
    if message == 9: status = "Rescue failed; no copy published this attempt. Your edits remain here." end
    if message == 19: status = "Open: type a path. Enter opens | Esc cancels. A name that does not exist yet starts an empty file." end
    if message == 20: status = "Opened. Original bytes and newline style are preserved." end
    if message == 21: status = "New file. It is created when you save with Ctrl+S." end
    if message == 22: status = "Unsaved edits. Ctrl+S saves (or Ctrl+Shift+S rescues) before Ctrl+O opens another file." end
    if message == 23: status = "Not opened: the file exceeds the 65536-byte limit. This document is unchanged." end
    if message == 24: status = "Not opened: symbolic links are refused. Open the intended file directly." end
    if message == 25: status = "Not opened: multiply hardlinked files are refused to preserve their links." end
    if message == 26: status = "Not opened: the file changed while opening. Try again." end
    if message == 27: status = "Not opened: expected valid UTF-8 text, TAB and uniform LF or CRLF." end
    if message == 28: status = "Not opened: no such folder, no permission, or a file owned by another account. Error" end
    if message == 29: status = "A path is limited to 4095 bytes." end
    if message == 30: status = "Not opened: name a regular file, not a folder." end
    if message == 31: status = "Copied." end
    if message == 32: status = "Nothing is selected. Shift with a movement key, or Ctrl+A, selects text." end
    if message == 33: status = "Nothing to paste. Ctrl+C or Ctrl+X copies a selection first." end
    if message == 34: status = "A path or search takes one line of text, without tabs." end
    if message == 35: status = "This edit is too large to undo, so it was not made." end
    if s.confirming and message == 7:
        status = "Rescue saved. Close pending: Y closes; Esc returns."
    end
    if s.confirming and message == 8:
        status = "Copy written; sync uncertain. Close pending: Y closes; Esc returns."
    end
    if notes_warning(message): let warning = x11_color(c, 16173151) end
    let statusline = pixel_text(c, status, 28, 560, 1)
    if message == 4 or message == 9:
        let code = pixel_number(c, 0 - s.save_result, 830, 560, 1)
    end
    if message == 28:
        let code = pixel_number(c, 0 - s.open_result, 830, 560, 1)
    end
    if s.unicode_input and not s.confirming:
        let help = pixel_text(c, "Unicode U+", 28, 580, 1)
        let number = notes_draw_hex(c, s.unicode_value, s.unicode_digits, 88)
    elif s.opening and not s.confirming:
        let help = pixel_text(c, "Open:", 28, 580, 1)
        let typed = notes_draw_query(c, s.path, s.path_count, notes_path_start(s.path, s.path_count), 70)
    elif s.finding and not s.confirming:
        let help = pixel_text(c, "Find:", 28, 580, 1)
        let typed = notes_draw_query(c, query, s.query_count, 0, 70)
        let help2 = pixel_text(c, "Enter next | Shift+Enter previous | Esc done", 570, 580, 1)
    elif message == 7 or message == 8:
        let label = pixel_text(c, "Sibling file:", 28, 580, 1)
        let name = file_copy_name(f)
        let shown = pixel_text_buffer(c, name, 0, linux_nul_end(name, 0, buffer_length(name)), 112, 580, 1)
    elif s.confirming and message != 5:
        let closehelp = "Close pending: Y discards edits | Esc returns | Ctrl+S saves"
        if notes_recovery_current(s): closehelp = "Close pending: Y closes (recovery kept) | Esc returns | Ctrl+S saves" end
        let help = pixel_text(c, closehelp, 28, 580, 1)
    else:
        let help = pixel_text(c, "Ctrl+S save | Ctrl+O open | Ctrl+X/C/V cut, copy, paste | Ctrl+Z undo | Ctrl+Y redo | Ctrl+F find | Ctrl+Shift+U Unicode | Ctrl+Q close", 28, 580, 1)
    end
    return 0
end

func notes_draw(c, f, t, s, recovery, query, blink):
    let view = notes_view(t, s)
    let background = x11_color(c, 1054759)
    let canvas = x11_rect(c, 0, 0, 900, 600)
    let heading = x11_color(c, 15265527)
    let title = pixel_text(c, "Herbert Notes", 28, 24, 3)
    let subtitle = x11_color(c, 8820395)
    let hint = pixel_text(c, "PLAIN TEXT", 688, 39, 2)
    let label = pixel_text(c, "File:", 28, 72, 1)
    let pathcount = linux_nul_end(f.path, 0, buffer_length(f.path))
    if pathcount > 130: pathcount = 130 end
    let pathname = pixel_text_buffer(c, f.path, 0, pathcount, 70, 72, 1)
    let recoverycolor = x11_color(c, 8820395)
    let recoverylabel = "Recovery: created on first edit; copies are kept until you remove them."
    if s.recovery_attempted:
        recoverylabel = "Recovery copy kept beside this file:"
        if s.recovery_result != 0:
            let warning = x11_color(c, 16173151)
            recoverylabel = "RECOVERY INCOMPLETE. Save or rescue. Attempted path:"
        end
        let name = pixel_text_buffer(c, recovery.2, 0, linux_nul_end(recovery.2, 0, buffer_length(recovery.2)), 352, 85, 1)
    end
    let recoveryhint = pixel_text(c, recoverylabel, 28, 85, 1)
    let bordercolor = x11_color(c, 2767956)
    let border = x11_rect(c, 24, 96, 852, 428)
    let papercolor = x11_color(c, 1384240)
    let paper = x11_rect(c, 26, 98, 848, 424)
    let first = text_row_start(t, 0, s.top)
    if notes_selected(t, s):
        let markcolor = x11_color(c, 3033707)
        let marks = notes_draw_marks(c, t, first, s.left, 0, notes_from(t, s), notes_to(t, s))
    elif s.finding and s.query_matched and not s.unicode_input and not s.confirming:
        let matchcolor = x11_color(c, 6969880)
        let marks = notes_draw_marks(c, t, first, s.left, 0, text_cursor(t), text_cursor(t) + s.query_count)
    end
    let ink = x11_color(c, 15265527)
    s.missing_glyphs = false
    let text = notes_draw_rows(c, t, s, first, s.left, 0)
    if s.finding and not s.unicode_input and not s.confirming:
        if notes_query_missing(query, s.query_count, 0):
            s.missing_glyphs = true
        end
    end
    if s.opening and not s.unicode_input and not s.confirming:
        if notes_query_missing(s.path, s.path_count, notes_path_start(s.path, s.path_count)):
            s.missing_glyphs = true
        end
    end
    if blink:
        let cursorcolor = x11_color(c, 16173151)
        let col = text_column(t, text_cursor(t)) - s.left
        let row = text_row(t, text_cursor(t)) - s.top
        let cursor = x11_rect(c, 28 + col * 12, 100 + row * 20, 2, 18)
    end
    let status = notes_status(c, f, t, s, query)
    s.needs_draw = false
    return x11_present(c)
end

func notes_loop(c, t, s, recovery, query, event, lastblink):
    let events = x11_events(c)
    -- Accepted typing belongs to the document before a batched WM close is
    -- considered. In particular, a queued ordinary Y must not confirm discard.
    let keys = notes_keys(c, t, s, recovery, query, event)
    let checkpoint = notes_checkpoint(recovery, s.doc, t, s)
    if x11_closed(c): let requested = notes_request_close(c, s.doc, t, s, recovery) end
    let now = linux_clock_ms(c.clock)
    let checked = x11_need(not linux_error(now), "notes: monotonic clock failed\n")
    let blink = (now / 500) % 2
    if s.needs_draw or blink != lastblink:
        let drawn = notes_draw(c, s.doc, t, s, recovery, query, blink == 0)
    elif x11_exposed(c):
        -- Refresh the retained pixmap after uncovering/expose without rebuilding
        -- all glyphs. Repainting and blinking allocate no new objects.
        let presented = x11_present(c)
    end
    let exposed = x11_ack_expose(c)
    let waited = linux_poll(c.state.fd, c.poll, 1, 500 - now % 500)
    let checked2 = x11_need(not linux_error(waited) or waited == 0 - 4, "notes: input wait failed\n")
    return notes_loop(c, t, s, recovery, query, event, blink)
end

func main():
    let args = linux_arguments()
    let path = linux_argument(args, 1)
    if equal(path, ""): path = "notes.txt" end
    if not equal(linux_argument(args, 2), ""): return linux_die("usage: notes [plain-text-file]\n") end
    let opened = file_open(path, 65536)
    if file_status(opened) != 0:
        let status = file_status(opened)
        let closed = file_close(opened)
        if status == 0 - 27: return linux_die("notes: file exceeds the 65536-byte limit. No file changed.\n") end
        if status == 0 - 40: return linux_die("notes: symbolic-link documents are refused. Open the intended regular file directly.\n") end
        if status == 0 - 31: return linux_die("notes: multiply hardlinked documents are refused to preserve their link structure.\n") end
        if status == 0 - 116: return linux_die("notes: file changed while opening. Try again after the other writer finishes.\n") end
        return linux_die("notes: cannot open a regular, singly linked file owned by you (or its parent). No file changed.\n")
    end
    let t = text_buffer_history(65536, 131072)
    let loaded = text_load(t, opened.bytes, file_count(opened))
    if loaded != 0:
        let closed = file_close(opened)
        return linux_die("notes: expected valid UTF-8 text, TAB and uniform LF or CRLF. Invalid encoding, controls and mixed endings are refused unchanged.\n")
    end
    let f = opened
    let s = NotesState(f, file_new(65536), 0, 0, false, false, 0, 0, false, false, 0, false, false, 0, false, false, false, 0, 0, false, linux_buffer(4096), 0, 0, 0 - 1, linux_buffer(65536), 0)
    let recovery = recovery_new(65536)
    let query = linux_buffer(64)
    s.needs_draw = true
    let c = x11_open(900, 600, "Herbert - Notes")
    let textkeys = x11_enable_text(c)
    let event = linux_buffer(16)
    return notes_loop(c, t, s, recovery, query, event, 0 - 1)
end
