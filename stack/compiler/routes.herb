
-- The production routes. The 45 i386 routes are built by the oracle compiler
-- (stack/i386_oracle/); production recognizes them only to reject them.
func nc_route_is_i386(source):
    if nc_is_multiboot32_long(source):
        return true
    end
    if nc_is_multiboot32_bluefield(source):
        return true
    end
    if nc_is_multiboot32_contigo(source):
        return true
    end
    if nc_is_multiboot32_cloggard(source):
        return true
    end
    if nc_is_multiboot32_rizzing(source):
        return true
    end
    if nc_is_multiboot32_tick(source):
        return true
    end
    if nc_is_multiboot32_timer(source):
        return true
    end
    if nc_is_multiboot32_demand(source):
        return true
    end
    if nc_is_multiboot32_store(source):
        return true
    end
    if nc_is_multiboot32_page(source):
        return true
    end
    if nc_is_multiboot32_idt(source):
        return true
    end
    if nc_is_multiboot32_trikon(source):
        return true
    end
    if nc_is_multiboot32_nokta(source):
        return true
    end
    if nc_is_multiboot32_sitopia(source):
        return true
    end
    if nc_is_multiboot32_geeking(source):
        return true
    end
    if nc_is_multiboot32_holler(source):
        return true
    end
    if nc_is_module_holler(source):
        return true
    end
    if nc_is_module_mmj(source):
        return true
    end
    if nc_is_module_chiefturbo(source):
        return true
    end
    if nc_is_multiboot32_mumbani(source):
        return true
    end
    if nc_is_module_mumbani(source):
        return true
    end
    if nc_is_multiboot32_tandem(source):
        return true
    end
    if nc_is_module_tandem(source):
        return true
    end
    if nc_is_multiboot32_tickover(source):
        return true
    end
    if nc_is_multiboot32_rollcall(source):
        return true
    end
    if nc_is_multiboot32_tenement(source):
        return true
    end
    if nc_is_multiboot32_homestead(source):
        return true
    end
    if nc_is_multiboot32_furlough(source):
        return true
    end
    if nc_is_multiboot32_tessera(source):
        return true
    end
    if nc_is_multiboot32_cleave(source):
        return true
    end
    if nc_is_multiboot32_lethe(source):
        return true
    end
    if nc_is_multiboot32_platter(source):
        return true
    end
    if nc_is_multiboot32_durable(source):
        return true
    end
    if nc_is_multiboot32_cairn(source):
        return true
    end
    if nc_is_multiboot32_larder(source):
        return true
    end
    if nc_is_multiboot32_growheap(source):
        return true
    end
    if nc_is_multiboot32_delete(source):
        return true
    end
    if nc_is_multiboot32_backfill(source):
        return true
    end
    if nc_is_multiboot32_tract(source):
        return true
    end
    if nc_is_multiboot32_highwater(source):
        return true
    end
    if nc_is_multiboot32_coalgate(source):
        return true
    end
    if nc_is_multiboot32_ouroboros(source):
        return true
    end
    if nc_is_multiboot32_lodger(source):
        return true
    end
    if nc_is_multiboot32_input(source):
        return true
    end
    if nc_is_multiboot32(source):
        return true
    end
    return false
end

-- The route name after "-- emit: ", up to the newline the recognizers require.
func nc_route_name_loop(buf, source, i):
    while i < length(source):
        if index(source, i) == 10:
            return buf
        end
        do append(buf, index(source, i))
        i = i + 1
    end
    return buf
end

func nc_route_name(source):
    let buf = nc_route_name_loop(new_buffer(), source, 9)
    return freeze(buf)
end

-- The success marker. fwriter has published a.out; now say so. Before this,
-- the marker was main's rendered result, written by the entry stub after the
-- rename, so a closed or full stdout ended in status 1 with nothing on stderr
-- and a broken pipe in SIGPIPE, though a.out had been replaced. SIGPIPE is
-- blocked first (rt_sigprocmask, SIG_BLOCK, a one-bit set for signal 13), so a
-- gone reader is an EPIPE result rather than a kill; then "0\n" goes to fd 1 in
-- one write. Anything but two bytes written is said on stderr, and the status
-- is 1. The new a.out stays: it is complete and correct.
func nc_publish_marker():
    let mask = new_buffer()
    do append(mask, 0)
    do append(mask, 16)
    do append(mask, 0)
    do append(mask, 0)
    do append(mask, 0)
    do append(mask, 0)
    do append(mask, 0)
    do append(mask, 0)
    let blocked = linux_syscall6(14, 0, buffer_address(mask), 0, 8, 0, 0)
    let marker = new_buffer()
    do append(marker, 48)
    do append(marker, 10)
    let wrote = linux_syscall6(1, 1, buffer_address(marker), 2, 0, 0, 0)
    if wrote == 2:
        do process_exit(0)
    end
    let said = stderr_write("compiler: output published, but the success marker could not be written\n")
    do process_exit(1)
    return 0
end

func nc_drive(source):
    if nc_is_ast_dump(source):
        do nc_emit_ast_dump_program(source)
        return 0
    end
    if nc_is_multiboot32_long64(source):
        do nc_emit_multiboot32_long64_program(source)
        return 0
    end
    if nc_route_is_i386(source):
        let route = diagnostic_with_payload("emit route '", nc_route_name(source), "' is built by the i386 oracle compiler (stack/i386_oracle_fragment.herb), not the production compiler")
        do nc_fail(443, 0, route)
        return 0
    end
    -- Use the checked lexer on the hosted production path. The emit routes above
    -- that read their input run the same checked lexer and parser through
    -- nc_check_source before their own lexing.
    let lexed = err_lex_source(source)
    if lexed.0 == err_err_tag():
        do stderr_write(serialize_diagnostic(lexed.1))
        do stderr_write("\n")
        do process_exit(1)
        return 0
    end
    let tokens = lexed.2
    -- Validate the whole source before the unchecked AST builder consumes it.
    -- Diagnostic priority is lexical, then structural, then native AST/type
    -- checks; this does not promise the globally earliest source-position error.
    -- This is an interim two-pass front end, not checked AST construction.
    let structure = err_parse_program(tokens, lexed.3)
    if structure.0 == err_err_tag():
        do stderr_write(serialize_diagnostic(structure.1))
        do stderr_write("\n")
        do process_exit(1)
        return 0
    end
    let parsed_nodes = pool_new()
    let parsed = parse_program(tokens, 0, parsed_nodes)
    let nodes = retag_do_calls(retag_record_calls(parsed_nodes, parsed.0))
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let has_faultable = nc_prog_has_faultable(prog)
    if has_faultable != 0:
        do nc_append_fault_rodata(prog.1)
    end
    let analyzed = nc_analyze_program(type_pool, prog, ast_result.1)
    if analyzed.0 != 0:
        do nc_fail(analyzed.0, 0, "")
        return 0
    end
    let metas = analyzed.1
    let main_ret = get(metas, prog.2).ret
    -- link11/link12: if main returns a renderable AGGREGATE (int/bool/string/tuple,
    -- recursively; width 2..15), linearize it into a render plan carried through the
    -- entry layout/emit. An empty plan = the single-word int/bool (kringle) path.
    let main_rplan = nc_build_render_plan(type_pool, main_ret)
    let pass1 = nc_pass1_program(prog, metas, analyzed.2, analyzed.3, has_faultable, main_rplan)
    if pass1.0 != 0:
        return 0
    end
    let funcs = prog.0
    let layouts = pass1.1
    let main_layout = get(layouts, prog.2)
    let diag_base = 0
    if has_faultable != 0:
        diag_base = nc_fault_helper_start(analyzed.3, has_faultable, main_ret, main_rplan)
    end
    let cbuf = new_buffer()
    let entry = nc_emit_entry_stub(cbuf, main_layout.0, analyzed.2, analyzed.3, has_faultable, main_ret, pass1.2, prog.1, main_rplan)
    if entry.0 != 0:
        return 0
    end
    let emitted = nc_emit_functions_loop(entry.1, funcs, metas, layouts, prog.1, pass1.2, diag_base, 0, count(funcs))
    if emitted.0 != 0:
        return 0
    end
    let frozen_code = freeze(emitted.1)
    let code_len = length(frozen_code)
    if code_len != pass1.2:
        do nc_fail(418, 0, "program-length")
        return 0
    end
    let ro_len = nc_rodata_len(prog.1)
    let img = nc_roundup_page(120 + code_len + ro_len)
    let pad = img - 120 - code_len - ro_len
    let align_hi = 0
    if not nc_funcs_have_call(funcs):
        align_hi = 129
    end
    let buf = new_buffer()
    buf = nc_emit_ehdr(buf)
    buf = nc_emit_phdr(buf, img, align_hi)
    buf = append_str(buf, frozen_code)
    buf = nc_emit_rodata(buf, prog.1)
    buf = nc_emit_zeroes_loop(buf, pad)
    do fwriter(freeze(buf))
    return nc_publish_marker()
end
