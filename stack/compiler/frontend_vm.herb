-- Herbert diagnostics fragment. This is the error fragment with source
-- locations threaded through lexing, parsing, AST construction, and static
-- checking. It reads a Herbert program from stdin, emits a located diagnostic
-- for malformed input, and otherwise compiles and runs the program through
-- the same lowerer/VM path as the error fragment.
--
-- AST representation. Each node is a tuple (tag, atoms, kids, line) where:
--   - tag    : string — the S-expression head (e.g. "program", "add",
--                       "name", "if", "clause", "type-tuple", "dot")
--   - atoms  : array(string) — verbatim atoms following the tag (names,
--                       decimal integers for int/char/str payloads,
--                       "true"/"false", type words)
--   - kids   : array(int) — indices of child nodes in the shared pool
-- The pool is an array((string, array(string), array(int), int)). Children
-- are referenced by integer index into the pool — Herbert types are
-- finite (no recursive type aliases), so a node cannot directly contain
-- an array of nodes; an index-into-the-pool encoding is the standard
-- arena representation and lets a tuple-and-array AST hold the tree.
-- Counts (`count(pool)`, indices into arrays) are always non-negative,
-- so the parser never produces a negative intermediate value.
--
-- Parser structure. Each parse routine takes (tokens, pos, pool) and
-- returns (node_idx, new_pos). For list-collecting helpers (params,
-- args, statements) the caller passes the destination array and the
-- helper returns just the new position. Keyword classification is
-- positional: the lexer never tags keywords — an IDENTIFIER token's
-- text is inspected by the parser at the point where the grammar
-- decides whether `let`/`if`/`and`/`int`/... starts a production or
-- names a value. The full set of decision points is small and local
-- to each routine.
--
-- Serializer. `ser_dump` (the ast-dump route's) walks the pool and
-- appends bytes to a shared buffer (the buffer is mutated by reference;
-- the caller threads its handle through assignment). One special case:
-- a `dot` node emits kids before atoms (the spec writes `(dot EXPR N)`);
-- every other node emits atoms before kids.

-- ====================================================================
-- LEXER FUNCTIONS (verbatim from stack/lexer_fragment.herb)
-- ====================================================================

func is_digit(c):
    return c >= '0' and c <= '9'
end

func is_lower(c):
    return c >= 'a' and c <= 'z'
end

func is_upper(c):
    return c >= 'A' and c <= 'Z'
end

func is_alpha(c):
    return is_lower(c) or is_upper(c)
end

func is_ident_start(c):
    return is_alpha(c) or c == '_'
end

func is_ident_cont(c):
    return is_ident_start(c) or is_digit(c)
end

func is_ws(c):
    return c == ' ' or c == '\n' or c == 9 or c == 13
end

func is_two_byte_op_start(c):
    return c == '=' or c == '!' or c == '<' or c == '>'
end

-- `<<` and `>>` are two-byte operators (a doubled `<`/`>`). They must be lexed
-- before the single-byte `<`/`>` (longest match), so the scanner checks this
-- before is_one_byte_op below.
func is_shift_op_start(c):
    return c == '<' or c == '>'
end

func is_one_byte_op(c):
    return c == '=' or c == '+' or c == '-' or c == '*' or c == '/' or c == '%' or c == '<' or c == '>' or c == '&' or c == '|' or c == '^' or c == '~'
end

func end_of_ident(src, i, n):
    if i >= n:
        return i
    elif is_ident_cont(index(src, i)):
        return end_of_ident(src, i + 1, n)
    else:
        return i
    end
end

func end_of_int(src, i, n):
    if i >= n:
        return i
    elif is_digit(index(src, i)):
        return end_of_int(src, i + 1, n)
    else:
        return i
    end
end

func end_of_line(src, i, n):
    if i >= n:
        return i
    elif index(src, i) == '\n':
        return i
    else:
        return end_of_line(src, i + 1, n)
    end
end

func end_of_string(src, i, n):
    let c = index(src, i)
    if c == '"':
        return i + 1
    elif c == '\\':
        return end_of_string(src, i + 2, n)
    else:
        return end_of_string(src, i + 1, n)
    end
end

func end_of_char(src, i, n):
    if index(src, i) == '\\':
        return i + 3
    else:
        return i + 2
    end
end

func pour(src, from, to, b):
    if from >= to:
        return b
    else:
        do append(b, index(src, from))
        return pour(src, from + 1, to, b)
    end
end

func slice_text(src, from, to):
    return freeze(pour(src, from, to, new_buffer()))
end

func scan(src, i, n, line, out):
    if i >= n:
        return out
    end
    let c = index(src, i)
    if is_ws(c):
        if c == '\n':
            return scan(src, i + 1, n, line + 1, out)
        end
        return scan(src, i + 1, n, line, out)
    elif c == '-' and i + 1 < n and index(src, i + 1) == '-':
        return scan(src, end_of_line(src, i + 2, n), n, line, out)
    elif is_ident_start(c):
        let j = end_of_ident(src, i + 1, n)
        do add(out, (0, slice_text(src, i, j), line))
        return scan(src, j, n, line, out)
    elif is_digit(c):
        let j = end_of_int(src, i + 1, n)
        do add(out, (1, slice_text(src, i, j), line))
        return scan(src, j, n, line, out)
    elif c == '"':
        let j = end_of_string(src, i + 1, n)
        do add(out, (2, slice_text(src, i, j), line))
        return scan(src, j, n, line, out)
    elif c == '\'':
        let j = end_of_char(src, i + 1, n)
        do add(out, (3, slice_text(src, i, j), line))
        return scan(src, j, n, line, out)
    elif is_two_byte_op_start(c) and i + 1 < n and index(src, i + 1) == '=':
        do add(out, (5, slice_text(src, i, i + 2), line))
        return scan(src, i + 2, n, line, out)
    elif is_shift_op_start(c) and i + 1 < n and index(src, i + 1) == c:
        do add(out, (5, slice_text(src, i, i + 2), line))
        return scan(src, i + 2, n, line, out)
    elif is_one_byte_op(c):
        do add(out, (5, slice_text(src, i, i + 1), line))
        return scan(src, i + 1, n, line, out)
    else:
        do add(out, (4, slice_text(src, i, i + 1), line))
        return scan(src, i + 1, n, line, out)
    end
end

func lex_source(src):
    return scan(src, 0, length(src), 1, new_array((int, string, int)))
end

-- ====================================================================
-- DECIMAL CONVERSION (no */% in Herbert; build div10/mod10 by subtraction)
-- ====================================================================

func div10_acc(n, q):
    if n < 10:
        return q
    end
    return div10_acc(n - 10, q + 1)
end

func div10(n):
    return div10_acc(n, 0)
end

func mod10(n):
    if n < 10:
        return n
    end
    return mod10(n - 10)
end

-- Append decimal digits of n to buf, high-order first. Recursive on
-- div10(n); not a true tail call but the interpreter's heap-stack
-- model has no fixed depth ceiling.
func emit_decimal(buf, n):
    if n >= 10:
        buf = emit_decimal(buf, div10(n))
    end
    do append(buf, 48 + mod10(n))
    return buf
end

func int_to_str(n):
    return freeze(emit_decimal(new_buffer(), n))
end

-- ====================================================================
-- STRING / BUFFER HELPERS
-- ====================================================================

func append_str_loop(buf, s, i, n):
    if i >= n:
        return buf
    end
    do append(buf, index(s, i))
    return append_str_loop(buf, s, i + 1, n)
end

func append_str(buf, s):
    return append_str_loop(buf, s, 0, length(s))
end

-- ====================================================================
-- AST NODE POOL
-- ====================================================================

func pool_new():
    return new_array((string, array(string), array(int), int))
end

func add_node(pool, tag, atoms, kids, line):
    do add(pool, (tag, atoms, kids, line))
    return count(pool) - 1
end

func atoms0():
    return new_array(string)
end

func atoms1(s):
    let a = new_array(string)
    do add(a, s)
    return a
end

func kids0():
    return new_array(int)
end

func kids1(i):
    let a = new_array(int)
    do add(a, i)
    return a
end

func kids2(a, b):
    let r = new_array(int)
    do add(r, a)
    do add(r, b)
    return r
end

func make_binop(pool, tag, lidx, ridx, line):
    return add_node(pool, tag, atoms0(), kids2(lidx, ridx), line)
end

-- ====================================================================
-- CHAR / STRING LITERAL DECODING
-- ====================================================================

-- s is the raw lexed CHAR text, e.g. "'a'" or "'\\n'" — three or four
-- bytes including the surrounding single quotes. Returns the byte value.
func decode_char(s):
    let c1 = index(s, 1)
    if c1 == '\\':
        let c2 = index(s, 2)
        if c2 == 'n':
            return 10
        end
        if c2 == '\\':
            return 92
        end
        return 39
    end
    return c1
end

-- s is the raw lexed STRING text including the surrounding double quotes.
-- Walk s[1 .. length(s)-1) decoding \n \\ \" into a buffer; returns the
-- frozen byte string.
func decode_string_loop(s, i, end_i, buf):
    if i >= end_i:
        return buf
    end
    let c = index(s, i)
    if c == '\\':
        let c2 = index(s, i + 1)
        if c2 == 'n':
            do append(buf, 10)
            return decode_string_loop(s, i + 2, end_i, buf)
        end
        if c2 == '\\':
            do append(buf, 92)
            return decode_string_loop(s, i + 2, end_i, buf)
        end
        do append(buf, 34)
        return decode_string_loop(s, i + 2, end_i, buf)
    end
    do append(buf, c)
    return decode_string_loop(s, i + 1, end_i, buf)
end

func decode_string(s):
    return freeze(decode_string_loop(s, 1, length(s) - 1, new_buffer()))
end

-- Append decimal forms of each byte of `bytes` (a string) as a fresh
-- entry in the `atoms` array.
func collect_str_atoms(atoms, bytes, i, n):
    if i >= n:
        return atoms
    end
    do add(atoms, int_to_str(index(bytes, i)))
    return collect_str_atoms(atoms, bytes, i + 1, n)
end

-- Large literals reuse the immutable decimal strings for all 256 byte values.
-- Keep the same AST atoms while avoiding one new decimal buffer per byte.
func byte_decimal_strings_loop(out, i):
    if i >= 256:
        return out
    end
    do add(out, int_to_str(i))
    return byte_decimal_strings_loop(out, i + 1)
end

func collect_str_atoms_cached(atoms, bytes, i, n, cache):
    if i >= n:
        return atoms
    end
    do add(atoms, get(cache, index(bytes, i)))
    return collect_str_atoms_cached(atoms, bytes, i + 1, n, cache)
end

-- ====================================================================
-- TOKEN INSPECTION
-- ====================================================================

func tok_is_ident_text(tokens, pos, text):
    if pos >= count(tokens):
        return false
    end
    let t = get(tokens, pos)
    return t.0 == 0 and equal(t.1, text)
end

func tok_is_punct_text(tokens, pos, text):
    if pos >= count(tokens):
        return false
    end
    let t = get(tokens, pos)
    return t.0 == 4 and equal(t.1, text)
end

func tok_is_op_text(tokens, pos, text):
    if pos >= count(tokens):
        return false
    end
    let t = get(tokens, pos)
    return t.0 == 5 and equal(t.1, text)
end

-- ====================================================================
-- TYPE EXPRESSIONS (only inside new_array(...))
-- ====================================================================

func parse_type(tokens, pos, pool):
    let t = get(tokens, pos)
    let ln = t.2
    if t.0 == 0:
        if equal(t.1, "array"):
            -- array ( TYPE )
            pos = pos + 2
            let r = parse_type(tokens, pos, pool)
            pos = r.1 + 1
            return (add_node(pool, "type-array", atoms0(), kids1(r.0), ln), pos)
        end
        return (add_node(pool, "type", atoms1(t.1), kids0(), ln), pos + 1)
    end
    -- LPAREN starts a tuple type
    pos = pos + 1
    let kids = new_array(int)
    let r = parse_type(tokens, pos, pool)
    do add(kids, r.0)
    pos = parse_type_tail(tokens, r.1, pool, kids)
    pos = pos + 1
    return (add_node(pool, "type-tuple", atoms0(), kids, ln), pos)
end

func parse_type_tail(tokens, pos, pool, kids):
    if tok_is_punct_text(tokens, pos, ","):
        let r = parse_type(tokens, pos + 1, pool)
        do add(kids, r.0)
        return parse_type_tail(tokens, r.1, pool, kids)
    end
    return pos
end

-- ====================================================================
-- EXPRESSIONS
-- ====================================================================

func parse_expr(tokens, pos, pool):
    return parse_bitwise(tokens, pos, pool)
end

-- Bitwise/shift level (settled precedence c). Sits above the classless ladder:
-- parse a classless expression; if a bitwise/shift operator follows, the left
-- operand must be a single parenthesised/atomic primary (not a bare classless
-- chain) and the whole chain must stay within one class. A mix plants an
-- `nc_class_mix` poison node that nc_verify_ast rejects with ERR 442. This makes
-- `a & b | c`, `a << 2 + 3`, `x & 1 == 0`, and `1 + 2 << 1` all reject while
-- their fully-parenthesised forms parse. The existing ladder is unchanged.

-- Plant the `nc_class_mix` poison node and STOP the parser cleanly. The node is
-- added to the pool (so the post-parse all-functions scan in nc_verify_ast finds
-- it and rejects with ERR 442, regardless of reachability), and the returned
-- position is end-of-input so the enclosing body/func/program parse terminates
-- immediately instead of misparsing the leftover tokens (which, in a function
-- followed by more `func`s, runs parse_atom off the token stream -> a `get: out
-- of range` crash). A class-mix is always a reject, so discarding any trailing
-- tokens is correct -- the program will be rejected whole.
func plant_class_mix(tokens, pool, line):
    return (add_node(pool, "nc_class_mix", atoms0(), kids0(), line), count(tokens))
end

func parse_bitwise(tokens, pos, pool):
    -- Retain the first primary's endpoint while completing the same classless
    -- ladder. Re-parsing it duplicates every nested left bitwise subtree.
    let primary = parse_not(tokens, pos, pool)
    let r = parse_mul_loop(tokens, primary.1, pool, primary.0)
    r = parse_add_loop(tokens, r.1, pool, r.0)
    r = parse_cmp_loop(tokens, r.1, pool, r.0)
    r = parse_and_loop(tokens, r.1, pool, r.0)
    r = parse_or_loop(tokens, r.1, pool, r.0)
    let cls = 0
    if r.1 < count(tokens):
        cls = bit_class(get(tokens, r.1).1)
        if get(tokens, r.1).0 != 5:
            cls = 0
        end
    end
    if cls == 0:
        return r
    end
    -- A bitwise/shift op follows. A different endpoint means the ladder consumed
    -- an unparenthesised classless operator after the primary -> mix.
    if primary.1 != r.1:
        return plant_class_mix(tokens, pool, get(tokens, r.1).2)
    end
    return parse_bitwise_loop(tokens, r.1, pool, r.0, cls)
end

func parse_bitwise_loop(tokens, pos, pool, lidx, cls):
    let oc = bin_op_class(tokens, pos)
    if oc == 0:
        -- End of the expression (`)`, `,`, `:`, `.`, `end`, EOF, ...).
        return (lidx, pos)
    end
    if oc == 5:
        -- A classless binary op after a committed bitwise chain: mix.
        return plant_class_mix(tokens, pool, get(tokens, pos).2)
    end
    if oc != cls:
        -- A different bitwise class without parentheses: mix.
        return plant_class_mix(tokens, pool, get(tokens, pos).2)
    end
    let op_tok = get(tokens, pos)
    let r = parse_not(tokens, pos + 1, pool)
    return parse_bitwise_loop(tokens, r.1, pool, make_binop(pool, bit_tag(op_tok.1), lidx, r.0, op_tok.2), cls)
end

func parse_or_loop(tokens, pos, pool, lidx):
    if tok_is_ident_text(tokens, pos, "or"):
        let op_tok = get(tokens, pos)
        let r = parse_and(tokens, pos + 1, pool)
        return parse_or_loop(tokens, r.1, pool, make_binop(pool, "or", lidx, r.0, op_tok.2))
    end
    return (lidx, pos)
end

func parse_and(tokens, pos, pool):
    let r = parse_cmp(tokens, pos, pool)
    return parse_and_loop(tokens, r.1, pool, r.0)
end

func parse_and_loop(tokens, pos, pool, lidx):
    if tok_is_ident_text(tokens, pos, "and"):
        let op_tok = get(tokens, pos)
        let r = parse_cmp(tokens, pos + 1, pool)
        return parse_and_loop(tokens, r.1, pool, make_binop(pool, "and", lidx, r.0, op_tok.2))
    end
    return (lidx, pos)
end

func cmp_tag(text):
    if equal(text, "=="):
        return "eq"
    end
    if equal(text, "!="):
        return "ne"
    end
    if equal(text, "<"):
        return "lt"
    end
    if equal(text, ">"):
        return "gt"
    end
    if equal(text, "<="):
        return "le"
    end
    if equal(text, ">="):
        return "ge"
    end
    return ""
end

func parse_cmp(tokens, pos, pool):
    let r = parse_add(tokens, pos, pool)
    return parse_cmp_loop(tokens, r.1, pool, r.0)
end

func parse_cmp_loop(tokens, pos, pool, lidx):
    if pos >= count(tokens):
        return (lidx, pos)
    end
    let t = get(tokens, pos)
    if t.0 == 5:
        let tag = cmp_tag(t.1)
        if not equal(tag, ""):
            let r = parse_add(tokens, pos + 1, pool)
            return parse_cmp_loop(tokens, r.1, pool, make_binop(pool, tag, lidx, r.0, t.2))
        end
    end
    return (lidx, pos)
end

func add_tag(text):
    if equal(text, "+"):
        return "add"
    end
    if equal(text, "-"):
        return "sub"
    end
    return ""
end

-- Multiplicative operator -> AST tag. `*` `/` `%` bind tighter than `+ -`. They
-- are ordinary arithmetic (same operator class as add/sub), so no class-mix
-- poison applies to them; they just join the arithmetic ladder a tier tighter.
func mul_tag(text):
    if equal(text, "*"):
        return "mul"
    end
    if equal(text, "/"):
        return "div"
    end
    if equal(text, "%"):
        return "mod"
    end
    return ""
end

-- The bitwise/shift operators split into mutually-exclusive classes:
-- 1 = AND (&), 2 = OR (|), 3 = XOR (^), 4 = SHIFT (<< >>). 0 = not a
-- bitwise/shift op. Mirrors the C bootstrap's bit_class. Same-class chaining is
-- allowed and left-associative; mixing classes (or mixing with the classless
-- ladder) without parentheses is a parse-time reject (settled precedence c).
func bit_class(text):
    if equal(text, "&"):
        return 1
    end
    if equal(text, "|"):
        return 2
    end
    if equal(text, "^"):
        return 3
    end
    if equal(text, "<<"):
        return 4
    end
    if equal(text, ">>"):
        return 4
    end
    return 0
end

-- AST tag for a bitwise/shift operator token (only called when bit_class != 0).
func bit_tag(text):
    if equal(text, "&"):
        return "band"
    end
    if equal(text, "|"):
        return "bor"
    end
    if equal(text, "^"):
        return "bxor"
    end
    if equal(text, "<<"):
        return "shl"
    end
    return "shr"
end

-- Class id of the binary operator token at `pos` (kind-5 op or `and`/`or`
-- ident), for the require-parens mix check. Returns:
--   0  not a binary operator (ends the expression: ) , : . end EOF etc.)
--   1..4  a bitwise/shift class (see bit_class)
--   5  a classless binary op (+ - cmp and or) -- mixing one of these with a
--      committed bitwise chain (without parens) is a reject.
func bin_op_class(tokens, pos):
    if pos >= count(tokens):
        return 0
    end
    let t = get(tokens, pos)
    if t.0 == 0:
        if equal(t.1, "and") or equal(t.1, "or"):
            return 5
        end
        return 0
    end
    if t.0 != 5:
        return 0
    end
    let bc = bit_class(t.1)
    if bc != 0:
        return bc
    end
    if not equal(add_tag(t.1), ""):
        return 5
    end
    if not equal(mul_tag(t.1), ""):
        return 5
    end
    if not equal(cmp_tag(t.1), ""):
        return 5
    end
    return 0
end

func parse_add(tokens, pos, pool):
    let r = parse_mul(tokens, pos, pool)
    return parse_add_loop(tokens, r.1, pool, r.0)
end

func parse_add_loop(tokens, pos, pool, lidx):
    if pos >= count(tokens):
        return (lidx, pos)
    end
    let t = get(tokens, pos)
    if t.0 == 5:
        let tag = add_tag(t.1)
        if not equal(tag, ""):
            let r = parse_mul(tokens, pos + 1, pool)
            return parse_add_loop(tokens, r.1, pool, make_binop(pool, tag, lidx, r.0, t.2))
        end
    end
    return (lidx, pos)
end

-- Multiplicative tier (`*` `/` `%`): one precedence level tighter than additive
-- `+ -`, looser than the prefix-unary level (parse_not). Left-associative.
-- Mirrors parse_add, calling parse_not for its operands.
func parse_mul(tokens, pos, pool):
    let r = parse_not(tokens, pos, pool)
    return parse_mul_loop(tokens, r.1, pool, r.0)
end

func parse_mul_loop(tokens, pos, pool, lidx):
    if pos >= count(tokens):
        return (lidx, pos)
    end
    let t = get(tokens, pos)
    if t.0 == 5:
        let tag = mul_tag(t.1)
        if not equal(tag, ""):
            let r = parse_not(tokens, pos + 1, pool)
            return parse_mul_loop(tokens, r.1, pool, make_binop(pool, tag, lidx, r.0, t.2))
        end
    end
    return (lidx, pos)
end

func parse_not(tokens, pos, pool):
    if tok_is_ident_text(tokens, pos, "not"):
        let t = get(tokens, pos)
        let r = parse_not(tokens, pos + 1, pool)
        return (add_node(pool, "not", atoms0(), kids1(r.0), t.2), r.1)
    end
    -- `~` is the bitwise one's-complement unary: a distinct AST kind ("bnot")
    -- from boolean `not`, with an int (not bool) type rule, at the same prefix
    -- precedence level.
    if tok_is_op_text(tokens, pos, "~"):
        let t = get(tokens, pos)
        let r = parse_not(tokens, pos + 1, pool)
        return (add_node(pool, "bnot", atoms0(), kids1(r.0), t.2), r.1)
    end
    return parse_dot(tokens, pos, pool)
end

func parse_dot(tokens, pos, pool):
    let r = parse_atom(tokens, pos, pool)
    return parse_dot_loop(tokens, r.1, pool, r.0)
end

func parse_dot_loop(tokens, pos, pool, lidx):
    if tok_is_punct_text(tokens, pos, "."):
        let dot_tok = get(tokens, pos)
        let idx_tok = get(tokens, pos + 1)
        let new_idx = add_node(pool, "dot", atoms1(idx_tok.1), kids1(lidx), dot_tok.2)
        return parse_dot_loop(tokens, pos + 2, pool, new_idx)
    end
    return (lidx, pos)
end

func parse_atom(tokens, pos, pool):
    let t = get(tokens, pos)
    let k = t.0
    let s = t.1
    let ln = t.2
    if k == 1:
        return (add_node(pool, "int", atoms1(s), kids0(), ln), pos + 1)
    end
    if k == 3:
        return (add_node(pool, "char", atoms1(int_to_str(decode_char(s))), kids0(), ln), pos + 1)
    end
    if k == 2:
        let frozen = decode_string(s)
        let n = length(frozen)
        let atoms = atoms1(int_to_str(n))
        if n >= 1024:
            let cache = byte_decimal_strings_loop(new_array(string), 0)
            atoms = collect_str_atoms_cached(atoms, frozen, 0, n, cache)
        else:
            atoms = collect_str_atoms(atoms, frozen, 0, n)
        end
        return (add_node(pool, "str", atoms, kids0(), ln), pos + 1)
    end
    if k == 0:
        if equal(s, "true"):
            return (add_node(pool, "bool", atoms1("true"), kids0(), ln), pos + 1)
        end
        if equal(s, "false"):
            return (add_node(pool, "bool", atoms1("false"), kids0(), ln), pos + 1)
        end
        if tok_is_punct_text(tokens, pos + 1, "("):
            return parse_call(tokens, pos, pool)
        end
        return (add_node(pool, "name", atoms1(s), kids0(), ln), pos + 1)
    end
    -- LPAREN: grouping or tuple
    return parse_group_or_tuple(tokens, pos + 1, pool, ln)
end

func parse_call(tokens, pos, pool):
    let name_tok = get(tokens, pos)
    let name = name_tok.1
    let ln = name_tok.2
    pos = pos + 2
    if equal(name, "new_array"):
        let r = parse_type(tokens, pos, pool)
        pos = r.1 + 1
        return (add_node(pool, "call", atoms1(name), kids1(r.0), ln), pos)
    end
    let kids = new_array(int)
    if tok_is_punct_text(tokens, pos, ")"):
        return (add_node(pool, "call", atoms1(name), kids, ln), pos + 1)
    end
    pos = parse_args_loop(tokens, pos, pool, kids)
    pos = pos + 1
    return (add_node(pool, "call", atoms1(name), kids, ln), pos)
end

func parse_args_loop(tokens, pos, pool, kids):
    let r = parse_expr(tokens, pos, pool)
    do add(kids, r.0)
    if tok_is_punct_text(tokens, r.1, ","):
        return parse_args_loop(tokens, r.1 + 1, pool, kids)
    end
    return r.1
end

func parse_group_or_tuple(tokens, pos, pool, line):
    let r = parse_expr(tokens, pos, pool)
    let first_idx = r.0
    pos = r.1
    if tok_is_punct_text(tokens, pos, ","):
        let kids = new_array(int)
        do add(kids, first_idx)
        pos = parse_tuple_tail(tokens, pos + 1, pool, kids)
        pos = pos + 1
        return (add_node(pool, "tuple", atoms0(), kids, line), pos)
    end
    pos = pos + 1
    return (first_idx, pos)
end

func parse_tuple_tail(tokens, pos, pool, kids):
    let r = parse_expr(tokens, pos, pool)
    do add(kids, r.0)
    if tok_is_punct_text(tokens, r.1, ","):
        return parse_tuple_tail(tokens, r.1 + 1, pool, kids)
    end
    return r.1
end

-- ====================================================================
-- STATEMENTS
-- ====================================================================

func is_body_terminator(tokens, pos):
    if pos >= count(tokens):
        return true
    end
    let t = get(tokens, pos)
    if t.0 != 0:
        return false
    end
    if equal(t.1, "end"):
        return true
    end
    if equal(t.1, "elif"):
        return true
    end
    if equal(t.1, "else"):
        return true
    end
    return false
end

func parse_body(tokens, pos, pool):
    let stmt_kids = new_array(int)
    pos = parse_body_loop(tokens, pos, pool, stmt_kids)
    let line = 0
    if pos < count(tokens):
        let t = get(tokens, pos)
        line = t.2
    end
    return (add_node(pool, "body", atoms0(), stmt_kids, line), pos)
end

func parse_body_loop(tokens, pos, pool, stmt_kids):
    if is_body_terminator(tokens, pos):
        return pos
    end
    let r = parse_stmt(tokens, pos, pool)
    do add(stmt_kids, r.0)
    return parse_body_loop(tokens, r.1, pool, stmt_kids)
end

func parse_stmt(tokens, pos, pool):
    let t = get(tokens, pos)
    -- t is IDENTIFIER per grammar
    let text = t.1
    let ln = t.2
    if equal(text, "let"):
        return parse_let(tokens, pos + 1, pool, ln)
    end
    if equal(text, "return"):
        return parse_return(tokens, pos + 1, pool, ln)
    end
    if equal(text, "do"):
        return parse_do(tokens, pos + 1, pool, ln)
    end
    if equal(text, "if"):
        return parse_if(tokens, pos + 1, pool, ln)
    end
    return parse_assign(tokens, pos, pool, ln)
end

func parse_let(tokens, pos, pool, line):
    let name_tok = get(tokens, pos)
    let name = name_tok.1
    let r = parse_expr(tokens, pos + 2, pool)
    return (add_node(pool, "let", atoms1(name), kids1(r.0), line), r.1)
end

func parse_return(tokens, pos, pool, line):
    let r = parse_expr(tokens, pos, pool)
    return (add_node(pool, "return", atoms0(), kids1(r.0), line), r.1)
end

func parse_do(tokens, pos, pool, line):
    let r = parse_expr(tokens, pos, pool)
    return (add_node(pool, "do", atoms0(), kids1(r.0), line), r.1)
end

func parse_assign(tokens, pos, pool, line):
    let name_tok = get(tokens, pos)
    let name = name_tok.1
    if tok_is_punct_text(tokens, pos + 1, "."):
        let field_atoms = new_array(string)
        do add(field_atoms, name)
        do add(field_atoms, get(tokens, pos + 2).1)
        let fr = parse_expr(tokens, pos + 4, pool)
        return (add_node(pool, "field-assign", field_atoms, kids1(fr.0), line), fr.1)
    end
    let r = parse_expr(tokens, pos + 2, pool)
    return (add_node(pool, "assign", atoms1(name), kids1(r.0), line), r.1)
end

func parse_if(tokens, pos, pool, line):
    let if_kids = new_array(int)
    pos = parse_clause_into(tokens, pos, pool, if_kids)
    pos = parse_elifs(tokens, pos, pool, if_kids)
    if tok_is_ident_text(tokens, pos, "else"):
        let r = parse_else_clause(tokens, pos + 1, pool)
        do add(if_kids, r.0)
        pos = r.1
    end
    -- consume "end"
    pos = pos + 1
    return (add_node(pool, "if", atoms0(), if_kids, line), pos)
end

func parse_elifs(tokens, pos, pool, if_kids):
    if tok_is_ident_text(tokens, pos, "elif"):
        pos = parse_clause_into(tokens, pos + 1, pool, if_kids)
        return parse_elifs(tokens, pos, pool, if_kids)
    end
    return pos
end

-- Safe token line lookup: the token's line, or 0 if pos is out of range. Used on
-- error-recovery paths where a class-mix has made parse_expr stop at end-of-input
-- (plant_class_mix), so `pos` can sit past the last token; a bare get(tokens, pos)
-- would then fault. The line is only cosmetic here (the program is rejected via
-- the nc_class_mix scan), so 0 is fine.
func tok_line_or0(tokens, pos):
    if pos >= count(tokens):
        return 0
    end
    return get(tokens, pos).2
end

func parse_clause_into(tokens, pos, pool, if_kids):
    let cr = parse_expr(tokens, pos, pool)
    pos = cr.1 + 1
    let br = parse_body(tokens, pos, pool)
    let cidx = add_node(pool, "clause", atoms0(), kids2(cr.0, br.0), tok_line_or0(tokens, pos))
    do add(if_kids, cidx)
    return br.1
end

func parse_else_clause(tokens, pos, pool):
    -- pos is just after 'else'; consume ':'
    let line = get(tokens, pos - 1).2
    pos = pos + 1
    let br = parse_body(tokens, pos, pool)
    return (add_node(pool, "else", atoms0(), kids1(br.0), line), br.1)
end

-- ====================================================================
-- FUNCTIONS / PROGRAM
-- ====================================================================

-- The program node's kids are its functions; its atoms are the pool indices of
-- its record declarations, in decimal (none in a program without records).
func parse_program(tokens, pos, pool):
    let kids = new_array(int)
    let recs = new_array(string)
    pos = parse_funcs(tokens, pos, pool, kids, recs)
    let line = 0
    if count(tokens) > 0:
        line = get(tokens, 0).2
    end
    return (add_node(pool, "program", recs, kids, line), pos)
end

func parse_funcs(tokens, pos, pool, kids, recs):
    if pos >= count(tokens):
        return pos
    end
    if err_is_ref_record_head(tokens, pos):
        let rf = parse_recorddef(tokens, pos + 1, pool, "ref-record")
        do add(recs, int_to_str(rf.0))
        return parse_funcs(tokens, rf.1, pool, kids, recs)
    end
    if err_is_record_head(tokens, pos):
        let rr = parse_recorddef(tokens, pos, pool, "record")
        do add(recs, int_to_str(rr.0))
        return parse_funcs(tokens, rr.1, pool, kids, recs)
    end
    let r = parse_funcdef(tokens, pos, pool)
    do add(kids, r.0)
    return parse_funcs(tokens, r.1, pool, kids, recs)
end

-- record NAME: FIELD: TYPE ... end -> ("record", [NAME, FIELD...], [type...]);
-- ref record NAME: ... end is the same node tagged "ref-record".
func parse_record_fields(tokens, pos, pool, atoms, kids):
    if tok_is_ident_text(tokens, pos, "end"):
        return pos + 1
    end
    do add(atoms, get(tokens, pos).1)
    let r = parse_type(tokens, pos + 2, pool)
    do add(kids, r.0)
    return parse_record_fields(tokens, r.1, pool, atoms, kids)
end

func parse_recorddef(tokens, pos, pool, tag):
    let line = get(tokens, pos).2
    let atoms = new_array(string)
    do add(atoms, get(tokens, pos + 1).1)
    let kids = new_array(int)
    pos = parse_record_fields(tokens, pos + 3, pool, atoms, kids)
    return (add_node(pool, tag, atoms, kids, line), pos)
end

func is_record_decl_tag(tag):
    return equal(tag, "record") or equal(tag, "ref-record")
end

-- Constructors parse as calls. In a program that declares records, every call
-- whose callee is a record becomes "record-new", so no call walker sees one.
func record_decl_names_loop(nodes, recs, i, names):
    if i >= count(recs):
        return names
    end
    let decl = get(nodes, parse_decimal(get(recs, i)))
    do add(names, get(decl.1, 0))
    return record_decl_names_loop(nodes, recs, i + 1, names)
end

func record_decl_names(nodes, prog_idx):
    return record_decl_names_loop(nodes, get(nodes, prog_idx).1, 0, new_array(string))
end

func retag_record_calls_loop(nodes, names, out, i):
    if i >= count(nodes):
        return out
    end
    let node = get(nodes, i)
    if equal(node.0, "call") and err_name_seen(names, get(node.1, 0)):
        do add(out, ("record-new", node.1, node.2, node.3))
        return retag_record_calls_loop(nodes, names, out, i + 1)
    end
    do add(out, node)
    return retag_record_calls_loop(nodes, names, out, i + 1)
end

func retag_record_calls(nodes, prog_idx):
    if count(get(nodes, prog_idx).1) == 0:
        return nodes
    end
    return retag_record_calls_loop(nodes, record_decl_names(nodes, prog_idx), pool_new(), 0)
end

func parse_funcdef(tokens, pos, pool):
    -- tokens[pos+0]: "func"; pos+1: name; pos+2: "("
    let line = get(tokens, pos).2
    let name_tok = get(tokens, pos + 1)
    let name = name_tok.1
    pos = pos + 3
    let pr = parse_param_list(tokens, pos, pool)
    pos = pr.1 + 2
    let br = parse_body(tokens, pos, pool)
    pos = br.1 + 1
    let kids = kids2(pr.0, br.0)
    return (add_node(pool, "func", atoms1(name), kids, line), pos)
end

func parse_param_list(tokens, pos, pool):
    let atoms = new_array(string)
    let line = get(tokens, pos).2
    if tok_is_punct_text(tokens, pos, ")"):
        return (add_node(pool, "params", atoms, kids0(), line), pos)
    end
    pos = parse_param_loop(tokens, pos, atoms)
    return (add_node(pool, "params", atoms, kids0(), line), pos)
end

func parse_param_loop(tokens, pos, atoms):
    let t = get(tokens, pos)
    do add(atoms, t.1)
    if tok_is_punct_text(tokens, pos + 1, ","):
        return parse_param_loop(tokens, pos + 2, atoms)
    end
    return pos + 1
end

-- ====================================================================
-- SERIALIZER
-- ====================================================================

func emit_atoms(buf, atoms, i, n):
    if i >= n:
        return buf
    end
    do append(buf, ' ')
    buf = append_str(buf, get(atoms, i))
    return emit_atoms(buf, atoms, i + 1, n)
end

-- ====================================================================
-- AST-DUMP MODE (parser-equivalence altimeter)
--
-- When the source's first line is the directive `-- emit: ast-dump`, the
-- backend lexes and parses with the SAME production front end it compiles
-- with (lex_source + parse_program), then serializes the raw parse tree
-- with `ser_dump` and writes it to stdout. No verify, no lower,
-- no emit -- this is the parser's own tree, observable for the first time.
-- It exists so an independent C AST-dumper (built from bootstrap/parse.c
-- structs) can be diffed against the PRODUCTION parser over a corpus while
-- the C bootstrap still exists (the pre-switchover parser altimeter), and
-- so gen-1 can dump that tree NATIVELY (removing C from the dump path).
-- ====================================================================

func nc_is_ast_dump(source):
    let marker = "-- emit: ast-dump"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- Dump serializer. It canonicalizes the "char" tag to "int". A Herbert char literal IS an int value (byte_codepoint); the C
-- bootstrap's lexer stores char literals as TOK_INT_LIT, so parse.c yields an
-- E_INT node with no char provenance. Canonicalizing only the TAG (never the
-- value atom) makes the parser-structure comparison meaningful while STILL
-- surfacing any real value/structure divergence (the value atom is untouched).
func ser_dump(buf, pool, idx):
    let node = get(pool, idx)
    let tag = node.0
    let atoms = node.1
    let kids = node.2
    do append(buf, '(')
    if equal(tag, "char"):
        buf = append_str(buf, "int")
    else:
        buf = append_str(buf, tag)
    end
    if equal(tag, "dot"):
        buf = emit_kids_dump(buf, pool, kids, 0, count(kids))
        buf = emit_atoms(buf, atoms, 0, count(atoms))
    elif equal(tag, "program"):
        buf = emit_record_dumps(buf, pool, atoms, 0)
        buf = emit_kids_dump(buf, pool, kids, 0, count(kids))
    else:
        buf = emit_atoms(buf, atoms, 0, count(atoms))
        buf = emit_kids_dump(buf, pool, kids, 0, count(kids))
    end
    do append(buf, ')')
    return buf
end

-- The program node's atoms index its record declarations; dump them as trees.
func emit_record_dumps(buf, pool, recs, i):
    if i >= count(recs):
        return buf
    end
    do append(buf, ' ')
    buf = ser_dump(buf, pool, parse_decimal(get(recs, i)))
    return emit_record_dumps(buf, pool, recs, i + 1)
end

func emit_kids_dump(buf, pool, kids, i, n):
    if i >= n:
        return buf
    end
    do append(buf, ' ')
    buf = ser_dump(buf, pool, get(kids, i))
    return emit_kids_dump(buf, pool, kids, i + 1, n)
end

-- Validate `source` with the checked lexer and parser before an emit route
-- builds its tree with the unchecked ones (the hosted path in routes.herb does
-- the same before parse_program). On failure, report the located diagnostic
-- the hosted path reports and exit 1. On success the route lexes and parses
-- exactly as before, so an accepted program's tree and image do not change.
func nc_check_source(source):
    let lexed = err_lex_source(source)
    if lexed.0 == err_err_tag():
        let reported = stderr_write(serialize_diagnostic(lexed.1))
        let newline = stderr_write("\n")
        do process_exit(1)
        return 0
    end
    let structure = err_parse_program(lexed.2, lexed.3)
    if structure.0 == err_err_tag():
        let reported = stderr_write(serialize_diagnostic(structure.1))
        let newline = stderr_write("\n")
        do process_exit(1)
        return 0
    end
    return 0
end

func nc_emit_ast_dump_program(source):
    let checked = nc_check_source(source)
    let tokens = lex_source(source)
    let parsed_nodes = pool_new()
    let parsed = parse_program(tokens, 0, parsed_nodes)
    let nodes = retag_record_calls(parsed_nodes, parsed.0)
    let buf = new_buffer()
    buf = ser_dump(buf, nodes, parsed.0)
    do flogger(freeze(buf))
    do flogger("\n")
    return 0
end

-- ====================================================================
-- EMITTER
-- ====================================================================

func fault(msg):
    let a = new_array((int, int))
    return get(a, 0)
end

func times10(n):
    return n + n + n + n + n + n + n + n + n + n
end

func parse_decimal_loop(s, i, n, acc):
    if i >= n:
        return acc
    end
    return parse_decimal_loop(s, i + 1, n, times10(acc) + index(s, i) - '0')
end

func parse_decimal(s):
    return parse_decimal_loop(s, 0, length(s), 0)
end

func op_push_int():
    return 0
end

func op_push_bool():
    return 1
end

func op_push_str():
    return 2
end

func op_load_local():
    return 3
end

func op_store_local():
    return 4
end

func op_add():
    return 5
end

func op_sub():
    return 6
end

func op_lt():
    return 7
end

func op_le():
    return 8
end

func op_gt():
    return 9
end

func op_ge():
    return 10
end

func op_eq():
    return 11
end

func op_ne():
    return 12
end

func op_not():
    return 13
end

func op_make_tuple():
    return 14
end

func op_tuple_get():
    return 15
end

func op_br():
    return 16
end

func op_br_if_false():
    return 17
end

func op_br_and():
    return 18
end

func op_br_or():
    return 19
end

func op_call():
    return 20
end

func op_ret():
    return 21
end

func op_length():
    return 22
end

func op_index():
    return 23
end

func op_slice():
    return 24
end

func op_equal():
    return 25
end

func op_new_buffer():
    return 26
end

func op_freeze():
    return 27
end

func op_new_array():
    return 28
end

-- Ref records: add leaving the array on the stack, and a field store.
func op_arr_add_keep():
    return 63
end

func op_set_field():
    return 64
end

func op_get_field():
    return 65
end

func op_get():
    return 29
end

func op_count():
    return 30
end

func op_buf_append():
    return 31
end

func op_arr_add():
    return 32
end

func op_clogger():
    return 33
end

func op_flogger():
    return 34
end

func op_fwriter():
    return 35
end

-- Bitwise / shift opcodes. Appended at 36-41 (the dense 0-35 space is full and
-- the VM range-checks binops; never renumber an existing opcode). band/bor/bxor/
-- shl/shr are int x int -> int binops; bnot is the int -> int one's-complement
-- unary (a distinct opcode from boolean `not` at 13).
func op_band():
    return 36
end

func op_bor():
    return 37
end

func op_bxor():
    return 38
end

func op_shl():
    return 39
end

func op_shr():
    return 40
end

func op_bnot():
    return 41
end

-- Multiplicative opcodes. Appended at 42-44 after the current max (op_bnot=41);
-- NEVER renumber an existing opcode (the VM range-checks binops and pass-1 sizes
-- by op number). mul/div/mod are int x int -> int binops. div/mod also fault on a
-- zero divisor (a located runtime fault, exit-status parity with the C oracle),
-- so they are "faultable" (see nc_code_has_faultable_loop); mul never faults.
func op_mul():
    return 42
end

func op_div():
    return 43
end

func op_mod():
    return 44
end

-- trukfit (f3, device input): a 0-arg value builtin that reads ONE byte from the
-- COM1 RBR. Lowered ONLY by the multiboot32-input emit mode (nc32_lower_loop op 45);
-- it is deliberately absent from nc32_op_allowed/nc32_pops/nc32_pushes so every
-- OTHER mode and the near-axis path reject it (a body carrying op 45 fails the depth
-- gate / is rejected explicitly), keeping the device read isolated to the input mode.
func op_input_byte():
    return 45
end

func op_module_byte():
    return 46
end

-- coalgate (link 22) op_sys_read: the MODULE-SIDE syscall builtin. Unlike op_module_byte (op 46, which
-- reads the kernel's absolute [answer] cell -- a kernel-only primitive), sys_read() lowers to the
-- position-independent SYS_READ syscall (int 0x30, eax=0): the kernel delivers a late-bound byte the
-- CPL3 module cannot read itself, and irets back with it in eax. Absent from nc32_op_allowed/pops/pushes
-- (like op 45/46), so only the coalgate mode's sysread_proxy admits it; every other mode rejects it.
func op_sys_read():
    return 47
end

-- holler (link 24) op_sys_write: the MODULE-SIDE output syscall builtin. sys_write(v) emits le32(v) (4 bytes)
-- via the bounds-checked SYS_WRITE syscall (int 0x30, eax=2): the CPL3 module hands the kernel a pointer to v
-- on its OWN operand stack (ecx=esp, edx=4); the kernel relays the 4 bytes ONLY if [ecx,ecx+4) lies in the
-- module's User page [alloc_lo,alloc_hi) (the access_ok confused-deputy check). A VALUE builtin returning 0.
-- Absent from nc32_op_allowed/pops/pushes (like op 45/46/47): only the holler module mode's holler_proxy
-- admits it (net 0: pop the arg, push the result); every other mode rejects a body carrying op 48.
func op_sys_write():
    return 48
end

-- tandem (link 28) op_yield: the COOPERATIVE-SCHEDULER builtin. yield(v) passes v to the peer program via the
-- kernel's one-cell mailbox and switches to it (SYS_YIELD = int 0x30, eax=3); when this program is resumed, the
-- call RETURNS the value the peer last passed (a synchronous rendezvous). Lowers to 10 bytes (mov eax,3; int 0x30;
-- mov [esp],eax) -- net stack 0 (pop the arg at TOS, push the return into the same slot), exactly like op 48.
-- Absent from nc32_op_allowed/pops/pushes (like op 45/46/47/48): only the tandem module mode admits op 52.
func op_yield():
    return 52
end

-- chiefturbo (link 26) runtime-indexed-memory builtins. bufbase() pushes the captured buffer base (alloc_lo,
-- stashed at [ebp+0] by main's capture prologue); bufget(base,k) is a register-indexed SS-relative load
-- buf[k]; bufset(base,i,v) is a register-indexed SS-relative store buf[i]=v. Absent from nc32_op_allowed/
-- pops/pushes (like op 45/46/47/48): only the chiefturbo module mode admits a body carrying op 49/50/51.
func op_bufbase():
    return 49
end

func op_bufget():
    return 50
end

func op_bufset():
    return 51
end

-- riposte (nc link 64, 48th kernel-arc link): output_byte(v) -- the sovereign long64
-- target's FIRST program-authored device OUTPUT. A 1-arg VALUE builtin: writes v&0xff to
-- the COM1 THR (0x3F8), then polls LSR.TEMT (0x3FD bit 6) until the byte is FULLY ON THE
-- WIRE (write-then-drain -- STEP-0 proved Bochs's baud-paced TX drops back-to-back bytes
-- under a THRE-only discipline and loses the LAST byte to shutdown without the drain),
-- and returns v (pops 1, pushes 1 -- the FULL 64-bit argument, so a checksum consuming
-- the return value pins push-semantics beyond the al-truncated device write). Admitted
-- ONLY by the multi-function long64 path (nc_tap_*); absent from nc32/nc64/every other
-- op_allowed, so all other modes reject a body carrying op 53. 53 because 46-52 are taken.
func op_output_byte():
    return 53
end

-- Linux-hosted process I/O only. Existing opcode numbers and target allowlists
-- stay unchanged. process_exit is void; stderr_write consumes a string and
-- returns zero on complete transfer or a positive Linux errno on failure.
func op_process_exit():
    return 54
end

func op_stderr_write():
    return 55
end

-- Checked hosted input: one abstract (int, string), three machine words.
func op_stdin_read():
    return 56
end

-- folio (link67): sovereign boot-file input, admitted only by nc_tap_*.
-- One scalar result: the next byte 0..255, or stable EOF 256. Unlike the
-- historical module_byte answer cell, this consumes a validated module extent.
func op_boot_read():
    return 57
end

-- Linux/x86-64 hosted boundary. These generic operations are deliberately not
-- admitted by any freestanding target or by the VM. The syscall and borrowed
-- address are UNSAFE escape hatches: Linux can read/write the pointed storage,
-- and append may move a buffer's backing allocation. Safe byte access is bounded
-- by the initialized length; buffer_set requires a byte exactly as append does.
func op_linux_syscall6():
    return 58
end

func op_buffer_address():
    return 59
end

func op_buffer_get():
    return 60
end

func op_buffer_set():
    return 61
end

func op_buffer_length():
    return 62
end

func nc_is_hosted_memory_builtin(name):
    return equal(name, "linux_syscall6") or equal(name, "buffer_address") or equal(name, "buffer_get") or equal(name, "buffer_set") or equal(name, "buffer_length")
end

func emit_instr(ir, op, a, b):
    do add(ir, (0, op, a, b, 0, "", 0))
    return ir
end

func emit_instr_line(ir, op, a, b, line):
    do add(ir, (0, op, a, b, 0, "", line))
    return ir
end

func emit_instr_meta(ir, op, a, b, meta):
    do add(ir, (0, op, a, b, meta, "", 0))
    return ir
end

func emit_target_instr(ir, op, label):
    do add(ir, (0, op, 0, 0, 0, label, 0))
    return ir
end

func emit_label(ir, label):
    do add(ir, (1, 0, 0, 0, 0, label, 0))
    return ir
end

func make_label(prefix, n):
    let buf = new_buffer()
    buf = append_str(buf, prefix)
    buf = append_str(buf, int_to_str(n))
    return freeze(buf)
end

func collect_labels_loop(ir, i, n, pc, labels):
    if i >= n:
        return labels
    end
    let item = get(ir, i)
    if item.0 == 1:
        do add(labels, (item.5, pc))
        return collect_labels_loop(ir, i + 1, n, pc, labels)
    end
    return collect_labels_loop(ir, i + 1, n, pc + 1, labels)
end

func collect_labels(ir):
    return collect_labels_loop(ir, 0, count(ir), 0, new_array((string, int)))
end

func find_label_pos_loop(labels, name, i, n):
    if i >= n:
        return fault("missing label")
    end
    let item = get(labels, i)
    if equal(item.0, name):
        return item.1
    end
    return find_label_pos_loop(labels, name, i + 1, n)
end

func find_label_pos(labels, name):
    return find_label_pos_loop(labels, name, 0, count(labels))
end

func resolve_ir_loop(ir, i, n, labels, out):
    if i >= n:
        return out
    end
    let item = get(ir, i)
    if item.0 == 1:
        return resolve_ir_loop(ir, i + 1, n, labels, out)
    end
    if equal(item.5, ""):
        do add(out, (item.1, item.2, item.3))
    else:
        do add(out, (item.1, find_label_pos(labels, item.5), item.3))
    end
    return resolve_ir_loop(ir, i + 1, n, labels, out)
end

func resolve_ir(ir):
    let labels = collect_labels(ir)
    return resolve_ir_loop(ir, 0, count(ir), labels, new_array((int, int, int)))
end

func resolve_new_array_meta_loop(ir, i, n, out):
    if i >= n:
        return out
    end
    let item = get(ir, i)
    if item.0 == 1:
        return resolve_new_array_meta_loop(ir, i + 1, n, out)
    end
    do add(out, item.4)
    return resolve_new_array_meta_loop(ir, i + 1, n, out)
end

func resolve_new_array_meta(ir):
    return resolve_new_array_meta_loop(ir, 0, count(ir), new_array(int))
end

func resolve_instr_lines_loop(ir, i, n, out):
    if i >= n:
        return out
    end
    let item = get(ir, i)
    if item.0 == 1:
        return resolve_instr_lines_loop(ir, i + 1, n, out)
    end
    do add(out, item.6)
    return resolve_instr_lines_loop(ir, i + 1, n, out)
end

func resolve_instr_lines(ir):
    return resolve_instr_lines_loop(ir, 0, count(ir), new_array(int))
end

-- A lowering environment is (names, slots, next slot, count). Names and slots
-- are the persistent chunked arrays of types_and_inference.herb (nc_pget,
-- nc_pset_str, nc_pset_int): a copy shares them, and leaving a scope only lowers
-- count. The next slot keeps counting, so no two declarations share a slot.
func env_from_params_loop(params, i, n, env):
    if i >= n:
        return env
    end
    return env_from_params_loop(params, i + 1, n, env_let(env, get(params, i)))
end

func env_from_params(params):
    return env_from_params_loop(params, 0, count(params), (new_array(array(string)), new_array(array(int)), 0, 0))
end

func env_let(env, name):
    return (nc_pset_str(env.0, env.3, name), nc_pset_int(env.1, env.3, env.2), env.2 + 1, env.3 + 1)
end

func env_lookup_loop(env, name, n):
    if n == 0:
        return fault("name undefined")
    end
    let k = n - 1
    if equal(nc_pget(env.0, k), name):
        return nc_pget(env.1, k)
    end
    return env_lookup_loop(env, name, k)
end

func env_lookup(env, name):
    return env_lookup_loop(env, name, env.3)
end

func env_rebuild(env, keep):
    return (env.0, env.1, env.2, keep)
end

func string_from_atoms_loop(atoms, i, n, buf):
    if i >= n:
        return buf
    end
    do append(buf, parse_decimal(get(atoms, i)))
    return string_from_atoms_loop(atoms, i + 1, n, buf)
end

func string_from_atoms(atoms):
    let n = parse_decimal(get(atoms, 0))
    if n + 1 != count(atoms):
        return fault("bad string node")
    end
    return freeze(string_from_atoms_loop(atoms, 1, count(atoms), new_buffer()))
end

func intern_string_loop(strings, s, i, n):
    if i >= n:
        do add(strings, s)
        return count(strings) - 1
    end
    if equal(get(strings, i), s):
        return i
    end
    return intern_string_loop(strings, s, i + 1, n)
end

func intern_string(strings, s):
    return intern_string_loop(strings, s, 0, count(strings))
end

func opcode_for_binop(tag):
    if equal(tag, "add"):
        return op_add()
    end
    if equal(tag, "sub"):
        return op_sub()
    end
    if equal(tag, "mul"):
        return op_mul()
    end
    if equal(tag, "div"):
        return op_div()
    end
    if equal(tag, "mod"):
        return op_mod()
    end
    if equal(tag, "eq"):
        return op_eq()
    end
    if equal(tag, "ne"):
        return op_ne()
    end
    if equal(tag, "lt"):
        return op_lt()
    end
    if equal(tag, "le"):
        return op_le()
    end
    if equal(tag, "gt"):
        return op_gt()
    end
    if equal(tag, "ge"):
        return op_ge()
    end
    if equal(tag, "band"):
        return op_band()
    end
    if equal(tag, "bor"):
        return op_bor()
    end
    if equal(tag, "bxor"):
        return op_bxor()
    end
    if equal(tag, "shl"):
        return op_shl()
    end
    return op_shr()
end

func emit_exprs(kids, i, n, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    if i >= n:
        return ir
    end
    ir = emit_expr(get(kids, i), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    return emit_exprs(kids, i + 1, n, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
end

func emit_call_expr(name, kids, call_node_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let call_line = get(nodes, call_node_idx).3
    if equal(name, "new_array"):
        let elem = nc_type_from_type_expr(type_pool, nodes, get(kids, 0))
        if elem.0 != 0:
            return fault("bad new_array meta")
        end
        return emit_instr_meta(ir, op_new_array(), 0, 0, nc_type_intern_array(type_pool, nc_type_erase(type_pool, elem.1)))
    end
    ir = emit_exprs(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    if equal(name, "linux_syscall6"):
        return emit_instr(ir, op_linux_syscall6(), 0, 0)
    end
    if equal(name, "buffer_address"):
        return emit_instr(ir, op_buffer_address(), 0, 0)
    end
    if equal(name, "buffer_get"):
        return emit_instr_line(ir, op_buffer_get(), 0, 0, call_line)
    end
    if equal(name, "buffer_set"):
        return emit_instr_line(ir, op_buffer_set(), 0, 0, call_line)
    end
    if equal(name, "buffer_length"):
        return emit_instr(ir, op_buffer_length(), 0, 0)
    end
    if equal(name, "clogger"):
        return emit_instr(ir, op_clogger(), 0, 0)
    end
    if equal(name, "stdin_read"):
        return emit_instr(ir, op_stdin_read(), 0, 0)
    end
    if equal(name, "stderr_write"):
        return emit_instr(ir, op_stderr_write(), 0, 0)
    end
    if equal(name, "length"):
        return emit_instr(ir, op_length(), 0, 0)
    end
    if equal(name, "index"):
        return emit_instr_line(ir, op_index(), 0, 0, call_line)
    end
    if equal(name, "slice"):
        return emit_instr(ir, op_slice(), 0, 0)
    end
    if equal(name, "equal"):
        return emit_instr(ir, op_equal(), 0, 0)
    end
    if equal(name, "new_buffer"):
        return emit_instr(ir, op_new_buffer(), 0, 0)
    end
    if equal(name, "freeze"):
        return emit_instr(ir, op_freeze(), 0, 0)
    end
    if equal(name, "get"):
        return emit_instr_line(ir, op_get(), 0, 0, call_line)
    end
    if equal(name, "count"):
        return emit_instr(ir, op_count(), 0, 0)
    end
    if equal(name, "input_byte"):
        return emit_instr(ir, op_input_byte(), 0, 0)
    end
    if equal(name, "boot_read"):
        return emit_instr(ir, op_boot_read(), 0, 0)
    end
    if equal(name, "output_byte"):
        return emit_instr(ir, op_output_byte(), 0, 0)
    end
    if equal(name, "module_byte"):
        return emit_instr(ir, op_module_byte(), 0, 0)
    end
    if equal(name, "sys_read"):
        return emit_instr(ir, op_sys_read(), 0, 0)
    end
    if equal(name, "sys_write"):
        return emit_instr(ir, op_sys_write(), 0, 0)
    end
    if equal(name, "yield"):
        return emit_instr(ir, op_yield(), 0, 0)
    end
    if equal(name, "bufbase"):
        return emit_instr(ir, op_bufbase(), 0, 0)
    end
    if equal(name, "bufget"):
        return emit_instr(ir, op_bufget(), 0, 0)
    end
    if equal(name, "bufset"):
        return emit_instr(ir, op_bufset(), 0, 0)
    end
    if equal(name, "append") or equal(name, "add") or equal(name, "flogger") or equal(name, "process_exit"):
        return fault("void builtin in expression")
    end
    return emit_instr(ir, op_call(), nc_poly_lowered_call_target(type_pool, poly, caller_inst_idx, call_node_idx, call_line), count(kids))
end

func emit_expr(node_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let node = get(nodes, node_idx)
    let tag = node.0
    let atoms = node.1
    let kids = node.2
    if equal(tag, "int"):
        return emit_instr(ir, op_push_int(), parse_decimal(get(atoms, 0)), 0)
    end
    if equal(tag, "char"):
        return emit_instr(ir, op_push_int(), parse_decimal(get(atoms, 0)), 0)
    end
    if equal(tag, "str"):
        let s = string_from_atoms(atoms)
        return emit_instr(ir, op_push_str(), intern_string(strings, s), 0)
    end
    if equal(tag, "bool"):
        if equal(get(atoms, 0), "true"):
            return emit_instr(ir, op_push_bool(), 1, 0)
        end
        return emit_instr(ir, op_push_bool(), 0, 0)
    end
    if equal(tag, "name"):
        return emit_instr(ir, op_load_local(), env_lookup(env, get(atoms, 0)), 0)
    end
    if equal(tag, "and"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        let done = make_label("and", count(ir))
        ir = emit_target_instr(ir, op_br_and(), done)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_label(ir, done)
    end
    if equal(tag, "or"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        let done = make_label("or", count(ir))
        ir = emit_target_instr(ir, op_br_or(), done)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_label(ir, done)
    end
    if equal(tag, "not"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_not(), 0, 0)
    end
    if equal(tag, "bnot"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_bnot(), 0, 0)
    end
    if equal(tag, "add") or equal(tag, "sub") or equal(tag, "mul") or equal(tag, "div") or equal(tag, "mod") or equal(tag, "eq") or equal(tag, "ne") or equal(tag, "lt") or equal(tag, "le") or equal(tag, "gt") or equal(tag, "ge") or equal(tag, "band") or equal(tag, "bor") or equal(tag, "bxor") or equal(tag, "shl") or equal(tag, "shr"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, opcode_for_binop(tag), 0, 0)
    end
    if equal(tag, "tuple"):
        ir = emit_exprs(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_make_tuple(), count(kids), 0)
    end
    if equal(tag, "record-new"):
        let decl_idx = nc_record_decl_scan(nodes, get(atoms, 0), 0)
        if equal(get(nodes, decl_idx).0, "ref-record"):
            -- A ref record is a one-element array of the tuple of its fields.
            let rt = nc_record_type(type_pool, nodes, decl_idx, new_array(int))
            ir = emit_instr_meta(ir, op_new_array(), 0, 0, nc_type_erase(type_pool, rt.1))
            ir = emit_exprs(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
            ir = emit_instr(ir, op_make_tuple(), count(kids), 0)
            return emit_instr(ir, op_arr_add_keep(), 0, 0)
        end
        ir = emit_exprs(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_make_tuple(), count(kids), 0)
    end
    if equal(tag, "dot"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        if not is_digit(index(get(atoms, 0), 0)):
            let shape = lowered_field(poly, nodes, caller_inst_idx, node_idx, node)
            if equal(get(nodes, shape.4).0, "ref-record"):
                -- In place: the field's words straight from the record's element.
                return emit_instr(ir, op_get_field(), shape.2, 0)
            end
            return emit_instr(ir, op_tuple_get(), shape.2, 0)
        end
        return emit_instr(ir, op_tuple_get(), parse_decimal(get(atoms, 0)), 0)
    end
    if equal(tag, "call"):
        return emit_call_expr(get(atoms, 0), kids, node_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    end
    return fault("bad expression")
end

func if_ends_return(kids, i, n, nodes):
    if i >= n:
        return false
    end
    let arm = get(nodes, get(kids, i))
    if equal(arm.0, "else"):
        return body_ends_return(get(arm.2, 0), nodes)
    end
    if not body_ends_return(get(arm.2, 1), nodes):
        return false
    end
    return if_ends_return(kids, i + 1, n, nodes)
end

func stmt_ends_return(stmt_idx, nodes):
    let stmt = get(nodes, stmt_idx)
    if equal(stmt.0, "return"):
        return true
    end
    if equal(stmt.0, "if"):
        return if_ends_return(stmt.2, 0, count(stmt.2), nodes)
    end
    return false
end

func body_has_return(stmts, i, n, nodes):
    if i >= n:
        return false
    end
    if stmt_ends_return(get(stmts, i), nodes):
        return true
    end
    return body_has_return(stmts, i + 1, n, nodes)
end

func body_ends_return(body_idx, nodes):
    -- A return or exhaustive returning if terminates this body. Inference,
    -- branch joins and lowering must agree about that boundary, including nesting.
    let body = get(nodes, body_idx)
    return body_has_return(body.2, 0, count(body.2), nodes)
end

func emit_body(stmts, i, n, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    if i >= n:
        return env
    end
    env = emit_stmt(get(stmts, i), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    -- Inference ends this body at a returning statement. Lowering must not request
    -- specializations or local metadata for statements inference never visited.
    if stmt_ends_return(get(stmts, i), nodes):
        return env
    end
    return emit_body(stmts, i + 1, n, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
end

func emit_do_call(call_idx, stmt_line, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let node = get(nodes, call_idx)
    if not equal(node.0, "call"):
        return fault("do non-call")
    end
    let name = get(node.1, 0)
    let kids = node.2
    if equal(name, "append"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr_line(ir, op_buf_append(), 0, 0, stmt_line)
    end
    if equal(name, "add"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_arr_add(), 0, 0)
    end
    if equal(name, "flogger"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_flogger(), 0, 0)
    end
    if equal(name, "fwriter"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_fwriter(), 0, 0)
    end
    if equal(name, "process_exit"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_process_exit(), 0, 0)
    end
    return fault("bad do call")
end

func emit_if_arms(kids, i, n, env, ir, strings, nodes, prog_idx, type_pool, join_label, caller_inst_idx, poly):
    if i >= n:
        return env
    end
    let arm_idx = get(kids, i)
    let arm = get(nodes, arm_idx)
    let scope_mark = env.3
    if equal(arm.0, "else"):
        let body_idx = get(arm.2, 0)
        let body = get(nodes, body_idx)
        let body_env = emit_body(body.2, 0, count(body.2), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return env_rebuild(body_env, scope_mark)
    end
    let next_label = make_label("if", count(ir))
    ir = emit_expr(get(arm.2, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    ir = emit_target_instr(ir, op_br_if_false(), next_label)
    let body_idx = get(arm.2, 1)
    let body = get(nodes, body_idx)
    let body_env = emit_body(body.2, 0, count(body.2), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    env = env_rebuild(body_env, scope_mark)
    if (not body_ends_return(body_idx, nodes)) and i + 1 < n:
        ir = emit_target_instr(ir, op_br(), join_label)
    end
    ir = emit_label(ir, next_label)
    return emit_if_arms(kids, i + 1, n, env, ir, strings, nodes, prog_idx, type_pool, join_label, caller_inst_idx, poly)
end

func emit_if_stmt(kids, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let join_label = make_label("join", count(ir))
    env = emit_if_arms(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, join_label, caller_inst_idx, poly)
    ir = emit_label(ir, join_label)
    return env
end

-- (position, field count, declaration) of FIELD in the one record that
-- declares it, or (-1, 0, 0) when no record or more than one does.
func unique_record_field_loop(nodes, field, i, found):
    if i >= count(nodes):
        return found
    end
    let node = get(nodes, i)
    if is_record_decl_tag(node.0):
        let fi = nc_record_field_index(nodes, i, field)
        if fi != 0 - 1:
            if found.0 != 0 - 1:
                return (0 - 1, 0, 0)
            end
            found = (fi, count(node.1) - 1, i)
        end
    end
    return unique_record_field_loop(nodes, field, i + 1, found)
end

-- Inference records each field's position per instance. A missing entry means
-- the value's type stayed unknown there, as after a never-returning helper,
-- whose code the tuple form also compiles; resolve by the field's name when
-- exactly one record declares it.
func lowered_field(poly, nodes, inst_idx, node_idx, node):
    let i = nc_poly_field_find_loop(poly.3, inst_idx, node_idx, 0)
    if i == 0 - 1:
        let field = get(node.1, count(node.1) - 1)
        let u = unique_record_field_loop(nodes, field, 0, (0 - 1, 0, 0))
        if u.0 == 0 - 1:
            let failed = nc_fail(446, node.3, field)
            return (inst_idx, node_idx, 0, 0, 0)
        end
        return (inst_idx, node_idx, u.0, u.1, u.2)
    end
    return get(poly.3, i)
end

func emit_field_update(k, n, i, slot, value_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    if i >= n:
        return ir
    end
    if i == k:
        ir = emit_expr(value_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_field_update(k, n, i + 1, slot, value_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    end
    ir = emit_instr(ir, op_load_local(), slot, 0)
    ir = emit_instr(ir, op_tuple_get(), i, 0)
    return emit_field_update(k, n, i + 1, slot, value_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
end

func emit_stmt(stmt_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let stmt = get(nodes, stmt_idx)
    let tag = stmt.0
    let atoms = stmt.1
    let kids = stmt.2
    if equal(tag, "let"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_instr(ir, op_store_local(), env.2, 0)
        return env_let(env, get(atoms, 0))
    end
    if equal(tag, "assign"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_instr(ir, op_store_local(), env_lookup(env, get(atoms, 0)), 0)
        return env
    end
    if equal(tag, "field-assign"):
        -- The same code as x = (x.0, ..., e, ..., x.n-1) for a tuple.
        let shape = lowered_field(poly, nodes, caller_inst_idx, stmt_idx, stmt)
        let slot = env_lookup(env, get(atoms, 0))
        if equal(get(nodes, shape.4).0, "ref-record"):
            -- In place: the field's words go into the record's one element.
            let fields = nc_type_children(type_pool, nc_record_type(type_pool, nodes, shape.4, new_array(int)).1)
            ir = emit_instr(ir, op_load_local(), slot, 0)
            ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
            ir = emit_instr(ir, op_set_field(), nc_type_width_tuple(type_pool, fields, 0, shape.2, 0), nc_type_width(type_pool, get(fields, shape.2)))
            return env
        end
        ir = emit_field_update(shape.2, shape.3, 0, slot, get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_instr(ir, op_make_tuple(), shape.3, 0)
        ir = emit_instr(ir, op_store_local(), slot, 0)
        return env
    end
    if equal(tag, "return"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_instr(ir, op_ret(), 0, 0)
        return env
    end
    if equal(tag, "do"):
        ir = emit_do_call(get(kids, 0), stmt.3, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return env
    end
    if equal(tag, "if"):
        return emit_if_stmt(kids, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    end
    return fault("bad statement")
end

func lower_func_poly(func_idx, inst_idx, entry_pc, strings, nodes, prog_idx, type_pool, poly):
    let fn = get(nodes, func_idx)
    let name = get(fn.1, 0)
    let params_node = get(nodes, get(fn.2, 0))
    let body_node = get(nodes, get(fn.2, 1))
    let env = env_from_params(params_node.1)
    let ir = new_array((int, int, int, int, int, string, int))
    let out_env = emit_body(body_node.2, 0, count(body_node.2), env, ir, strings, nodes, prog_idx, type_pool, inst_idx, poly)
    let code = resolve_ir(ir)
    let new_array_meta = resolve_new_array_meta(ir)
    let instr_lines = resolve_instr_lines(ir)
    return (name, entry_pc, count(params_node.1), out_env.2, code, new_array_meta, instr_lines)
end

func lower_program_poly_loop(instances, i, entry_pc, funcs, strings, nodes, prog_idx, type_pool, poly):
    if i >= count(instances):
        return funcs
    end
    let prog = get(nodes, prog_idx)
    let inst = get(instances, i)
    let fn = lower_func_poly(get(prog.2, inst.0), i, entry_pc, strings, nodes, prog_idx, type_pool, poly)
    do add(funcs, fn)
    return lower_program_poly_loop(instances, i + 1, entry_pc + count(fn.4), funcs, strings, nodes, prog_idx, type_pool, poly)
end

func lower_program_poly(nodes, prog_idx, type_pool, poly):
    let strings = new_array(string)
    let funcs = new_array((string, int, int, int, array((int, int, int)), array(int), array(int)))
    funcs = lower_program_poly_loop(poly.0, 0, 0, funcs, strings, nodes, prog_idx, type_pool, poly)
    return (funcs, strings, 0)
end

func lower_program(nodes, prog_idx, type_pool):
    let ast_result = nc_verify_ast(nodes, prog_idx, type_pool)
    if ast_result.0 != 0:
        return (new_array((string, int, int, int, array((int, int, int)), array(int), array(int))), new_array(string), 0)
    end
    return lower_program_poly(nodes, prog_idx, type_pool, ast_result.2)
end

-- ====================================================================
-- ERROR-HANDLING FRONT END
-- ====================================================================

func err_ok_tag():
    return 0
end

func err_err_tag():
    return 1
end

func err_no_diag():
    return (0, 0, "")
end

func err_diag(code, line, payload):
    return (code, line, payload)
end

func diagnostic_with_payload(prefix, payload, suffix):
    let buf = new_buffer()
    buf = append_str(buf, prefix)
    buf = append_str(buf, payload)
    buf = append_str(buf, suffix)
    return freeze(buf)
end

func diagnostic_message(code, payload):
    if code == 101:
        return "unexpected character"
    end
    if code == 102:
        return "expected digit"
    end
    if code == 103:
        return "integer literal does not fit in 64 bits"
    end
    if code == 104:
        return "unknown escape sequence"
    end
    if code == 105:
        return "unterminated escape"
    end
    if code == 106:
        return "newline in string literal"
    end
    if code == 107:
        return "unterminated string literal"
    end
    if code == 108:
        return "empty character literal"
    end
    if code == 109:
        return "character literal not closed"
    end
    if code == 110:
        return "newline in character literal"
    end
    if code == 201:
        return "expected 'func' at top level"
    end
    if code == 202:
        return "invalid function header"
    end
    if code == 203:
        return "expected end"
    end
    if code == 204:
        return "expected expression"
    end
    if code == 205:
        return "'do' must be followed by a call"
    end
    if code == 206:
        return "expected integer after '.'"
    end
    if code == 207:
        return "expected ')'"
    end
    if code == 208:
        return "new_array requires a type argument"
    end
    if code == 209:
        return "function body must contain at least one statement"
    end
    if code == 210:
        return "if/elif/else arm must contain at least one statement"
    end
    if code == 211:
        return "invalid type expression"
    end
    if code == 212:
        return "invalid assignment or name"
    end
    if code == 213:
        return "invalid record declaration"
    end
    if code == 301:
        return diagnostic_with_payload("duplicate let '", payload, "' in this scope")
    end
    if code == 302:
        return diagnostic_with_payload("undefined name '", payload, "'")
    end
    if code == 303:
        return diagnostic_with_payload("assignment to undefined name '", payload, "'")
    end
    if code == 304:
        return diagnostic_with_payload("unknown function '", payload, "'")
    end
    if code == 305:
        return diagnostic_with_payload("wrong number of arguments to '", payload, "'")
    end
    if code == 306:
        return diagnostic_with_payload("wrong number of arguments to '", payload, "'")
    end
    if code == 307:
        return diagnostic_with_payload("wrong number of arguments to '", payload, "'")
    end
    if code == 308:
        return diagnostic_with_payload("builtin '", payload, "' has no value")
    end
    if code == 310:
        return diagnostic_with_payload("'do' requires a value-less call, got '", payload, "'")
    end
    if code == 311:
        return diagnostic_with_payload("duplicate parameter '", payload, "'")
    end
    if code == 312:
        return diagnostic_with_payload("duplicate function '", payload, "'")
    end
    if code == 313:
        return diagnostic_with_payload("function reuses built-in name '", payload, "'")
    end
    if code == 314:
        return "no main function defined"
    end
    if code == 315:
        return diagnostic_with_payload("function '", payload, "' must take zero parameters")
    end
    if code == 316:
        return diagnostic_with_payload("function '", payload, "' may complete without returning")
    end
    return "unknown error"
end

func serialize_diagnostic(diag):
    let code = diag.0
    let line = diag.1
    let payload = diag.2
    let buf = new_buffer()
    if line > 0:
        buf = append_str(buf, "line ")
        buf = append_str(buf, int_to_str(line))
        buf = append_str(buf, ": ")
    else:
        buf = append_str(buf, "program: ")
    end
    buf = append_str(buf, diagnostic_message(code, payload))
    buf = append_str(buf, " (ERR ")
    buf = append_str(buf, int_to_str(code))
    buf = append_str(buf, ")")
    return freeze(buf)
end

func err_empty_tokens():
    return new_array((int, string, int))
end

func err_lex_ok(tokens, eof_line):
    return (err_ok_tag(), err_no_diag(), tokens, eof_line)
end

func err_lex_fail(diag):
    return (err_err_tag(), diag, err_empty_tokens(), 0)
end

func err_pos_ok(pos):
    return (err_ok_tag(), err_no_diag(), pos)
end

func err_pos_fail(diag):
    return (err_err_tag(), diag, 0)
end

func err_parse_ok(pos):
    return (err_ok_tag(), err_no_diag(), pos, 0)
end

func err_parse_ok_extra(pos, extra):
    return (err_ok_tag(), err_no_diag(), pos, extra)
end

func err_parse_fail(diag):
    return (err_err_tag(), diag, 0, 0)
end

func err_parse_fail_at(code, line):
    return err_parse_fail(err_diag(code, line, ""))
end

func err_parse_fail_payload(code, line, payload):
    return err_parse_fail(err_diag(code, line, payload))
end

func err_token_line(tokens, pos, ctx):
    if pos >= count(tokens):
        return ctx.0
    end
    let t = get(tokens, pos)
    return t.2
end

func err_parse_fail_current(code, tokens, pos, ctx):
    return err_parse_fail_at(code, err_token_line(tokens, pos, ctx))
end

func err_expr_other():
    return 0
end

func err_expr_call():
    return 1
end

func err_expr_new_array():
    return 2
end

func err_is_valid_punct(c):
    return c == '(' or c == ')' or c == ',' or c == '.' or c == ':'
end

func err_end_of_int(src, i, n, line, acc):
    if i >= n:
        return err_pos_ok(i)
    end
    let c = index(src, i)
    if not is_digit(c):
        return err_pos_ok(i)
    end
    let d = c - '0'
    if acc > 1844674407370955161:
        return err_pos_fail(err_diag(103, line, ""))
    end
    if acc == 1844674407370955161 and d > 5:
        return err_pos_fail(err_diag(103, line, ""))
    end
    return err_end_of_int(src, i + 1, n, line, times10(acc) + d)
end

func err_string_escape_ok(c):
    return c == 'n' or c == '\\' or c == '"'
end

func err_char_escape_ok(c):
    return c == 'n' or c == '\\' or c == '\''
end

func err_end_of_string(src, i, n, line):
    if i >= n:
        return err_pos_fail(err_diag(107, line, ""))
    end
    let c = index(src, i)
    if c == '"':
        return err_pos_ok(i + 1)
    end
    if c == '\n':
        return err_pos_fail(err_diag(106, line, ""))
    end
    if c == '\\':
        if i + 1 >= n:
            return err_pos_fail(err_diag(105, line, ""))
        end
        if not err_string_escape_ok(index(src, i + 1)):
            return err_pos_fail(err_diag(104, line, ""))
        end
        return err_end_of_string(src, i + 2, n, line)
    end
    return err_end_of_string(src, i + 1, n, line)
end

func err_check_char_close(src, pos, n, line):
    if pos >= n:
        return err_pos_fail(err_diag(109, line, ""))
    end
    if index(src, pos) == '\n':
        return err_pos_fail(err_diag(110, line, ""))
    end
    if index(src, pos) != '\'':
        return err_pos_fail(err_diag(109, line, ""))
    end
    return err_pos_ok(pos + 1)
end

func err_end_of_char(src, i, n, line):
    if i >= n:
        return err_pos_fail(err_diag(109, line, ""))
    end
    let c = index(src, i)
    if c == '\n':
        return err_pos_fail(err_diag(110, line, ""))
    end
    if c == '\'':
        return err_pos_fail(err_diag(108, line, ""))
    end
    if c == '\\':
        if i + 1 >= n:
            return err_pos_fail(err_diag(105, line, ""))
        end
        if not err_char_escape_ok(index(src, i + 1)):
            return err_pos_fail(err_diag(104, line, ""))
        end
        return err_check_char_close(src, i + 2, n, line)
    end
    return err_check_char_close(src, i + 1, n, line)
end

func err_scan(src, i, n, line, out):
    if i >= n:
        return err_lex_ok(out, line)
    end
    let c = index(src, i)
    if is_ws(c):
        if c == '\n':
            return err_scan(src, i + 1, n, line + 1, out)
        end
        return err_scan(src, i + 1, n, line, out)
    elif c == '-' and i + 1 < n and index(src, i + 1) == '-':
        return err_scan(src, end_of_line(src, i + 2, n), n, line, out)
    elif is_ident_start(c):
        let j = end_of_ident(src, i + 1, n)
        do add(out, (0, slice_text(src, i, j), line))
        return err_scan(src, j, n, line, out)
    elif is_digit(c):
        let r = err_end_of_int(src, i, n, line, 0)
        if r.0 == err_err_tag():
            return err_lex_fail(r.1)
        end
        do add(out, (1, slice_text(src, i, r.2), line))
        return err_scan(src, r.2, n, line, out)
    elif c == '"':
        let r = err_end_of_string(src, i + 1, n, line)
        if r.0 == err_err_tag():
            return err_lex_fail(r.1)
        end
        do add(out, (2, slice_text(src, i, r.2), line))
        return err_scan(src, r.2, n, line, out)
    elif c == '\'':
        let r = err_end_of_char(src, i + 1, n, line)
        if r.0 == err_err_tag():
            return err_lex_fail(r.1)
        end
        do add(out, (3, slice_text(src, i, r.2), line))
        return err_scan(src, r.2, n, line, out)
    elif is_two_byte_op_start(c) and i + 1 < n and index(src, i + 1) == '=':
        do add(out, (5, slice_text(src, i, i + 2), line))
        return err_scan(src, i + 2, n, line, out)
    elif is_shift_op_start(c) and i + 1 < n and index(src, i + 1) == c:
        do add(out, (5, slice_text(src, i, i + 2), line))
        return err_scan(src, i + 2, n, line, out)
    elif is_one_byte_op(c):
        do add(out, (5, slice_text(src, i, i + 1), line))
        return err_scan(src, i + 1, n, line, out)
    elif err_is_valid_punct(c):
        do add(out, (4, slice_text(src, i, i + 1), line))
        return err_scan(src, i + 1, n, line, out)
    end
    return err_lex_fail(err_diag(101, line, slice_text(src, i, i + 1)))
end

func err_lex_source(src):
    return err_scan(src, 0, length(src), 1, new_array((int, string, int)))
end

func err_is_reserved_word(s):
    if equal(s, "func") or equal(s, "let") or equal(s, "return") or equal(s, "do"):
        return true
    end
    if equal(s, "if") or equal(s, "elif") or equal(s, "else") or equal(s, "end"):
        return true
    end
    if equal(s, "and") or equal(s, "or") or equal(s, "not"):
        return true
    end
    if equal(s, "true") or equal(s, "false"):
        return true
    end
    if equal(s, "int") or equal(s, "bool") or equal(s, "string"):
        return true
    end
    return equal(s, "buffer") or equal(s, "array")
end

func err_is_valid_name_token(tokens, pos):
    if pos >= count(tokens):
        return false
    end
    let t = get(tokens, pos)
    return t.0 == 0 and not err_is_reserved_word(t.1)
end

func err_name_seen_loop(names, start, n, name):
    if start >= n:
        return false
    end
    if equal(get(names, start), name):
        return true
    end
    return err_name_seen_loop(names, start + 1, n, name)
end

func err_name_seen(names, name):
    return err_name_seen_loop(names, 0, count(names), name)
end

func err_parse_type(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    if pos >= count(tokens):
        return err_parse_fail_at(211, line)
    end
    let t = get(tokens, pos)
    if t.0 == 0:
        if equal(t.1, "int") or equal(t.1, "bool") or equal(t.1, "string") or equal(t.1, "buffer"):
            return err_parse_ok(pos + 1)
        end
        if err_is_record_name(ctx, t.1):
            return err_parse_ok(pos + 1)
        end
        if equal(t.1, "array"):
            if not tok_is_punct_text(tokens, pos + 1, "("):
                return err_parse_fail_current(211, tokens, pos + 1, ctx)
            end
            let r = err_parse_type(tokens, pos + 2, ctx)
            if r.0 == err_err_tag():
                return r
            end
            if not tok_is_punct_text(tokens, r.2, ")"):
                return err_parse_fail_current(211, tokens, r.2, ctx)
            end
            return err_parse_ok(r.2 + 1)
        end
        return err_parse_fail_at(211, line)
    end
    if tok_is_punct_text(tokens, pos, "("):
        let r = err_parse_type(tokens, pos + 1, ctx)
        if r.0 == err_err_tag():
            return r
        end
        return err_parse_type_tuple_tail(tokens, r.2, ctx, 1, line)
    end
    return err_parse_fail_at(211, line)
end

func err_parse_type_tuple_tail(tokens, pos, ctx, n_items, tuple_line):
    if tok_is_punct_text(tokens, pos, ","):
        let r = err_parse_type(tokens, pos + 1, ctx)
        if r.0 == err_err_tag():
            return r
        end
        return err_parse_type_tuple_tail(tokens, r.2, ctx, n_items + 1, tuple_line)
    end
    if not tok_is_punct_text(tokens, pos, ")"):
        return err_parse_fail_current(211, tokens, pos, ctx)
    end
    if n_items < 2:
        return err_parse_fail_at(211, tuple_line)
    end
    return err_parse_ok(pos + 1)
end

-- This checked pass recognizes structure, not expression meaning. Share the
-- AST parser's operator vocabulary; leave precedence and class-mixing ERR 442
-- to that parser. A flat operand/operator chain avoids a second precedence
-- ladder drifting behind the language. Groups/calls still recurse structurally.
-- The root kind records only whether the complete expression is a call, for do.
func err_parse_expr(tokens, pos, ctx):
    let r = err_parse_not(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_expr_tail(tokens, r.2, ctx, r.3)
end

func err_parse_expr_tail(tokens, pos, ctx, root_kind):
    if bin_op_class(tokens, pos) == 0:
        return err_parse_ok_extra(pos, root_kind)
    end
    let r = err_parse_not(tokens, pos + 1, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_expr_tail(tokens, r.2, ctx, err_expr_other())
end

func err_parse_not(tokens, pos, ctx):
    if tok_is_ident_text(tokens, pos, "not") or tok_is_op_text(tokens, pos, "~"):
        let r = err_parse_not(tokens, pos + 1, ctx)
        if r.0 == err_err_tag():
            return r
        end
        return err_parse_ok_extra(r.2, err_expr_other())
    end
    return err_parse_dot(tokens, pos, ctx)
end

func err_parse_dot(tokens, pos, ctx):
    let r = err_parse_atom(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_dot_loop(tokens, r.2, ctx, r.3)
end

func err_parse_dot_loop(tokens, pos, ctx, root_kind):
    if tok_is_punct_text(tokens, pos, "."):
        if pos + 1 >= count(tokens):
            return err_parse_fail_current(206, tokens, pos + 1, ctx)
        end
        let idx_tok = get(tokens, pos + 1)
        if idx_tok.0 == 0 and err_has_records(ctx) and err_is_valid_name_token(tokens, pos + 1):
            return err_parse_dot_loop(tokens, pos + 2, ctx, err_expr_other())
        end
        if idx_tok.0 != 1:
            return err_parse_fail_at(206, idx_tok.2)
        end
        return err_parse_dot_loop(tokens, pos + 2, ctx, err_expr_other())
    end
    return err_parse_ok_extra(pos, root_kind)
end

func err_parse_atom(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    if pos >= count(tokens):
        return err_parse_fail_at(204, line)
    end
    let t = get(tokens, pos)
    let k = t.0
    let s = t.1
    if k == 1 or k == 2 or k == 3:
        return err_parse_ok_extra(pos + 1, err_expr_other())
    end
    if k == 0:
        if equal(s, "true") or equal(s, "false"):
            return err_parse_ok_extra(pos + 1, err_expr_other())
        end
        if err_is_reserved_word(s):
            return err_parse_fail_at(204, line)
        end
        if tok_is_punct_text(tokens, pos + 1, "("):
            return err_parse_call(tokens, pos, ctx)
        end
        return err_parse_ok_extra(pos + 1, err_expr_other())
    end
    if tok_is_punct_text(tokens, pos, "("):
        return err_parse_group_or_tuple(tokens, pos + 1, ctx)
    end
    return err_parse_fail_at(204, line)
end

func err_parse_call(tokens, pos, ctx):
    let name_tok = get(tokens, pos)
    let name = name_tok.1
    let line = name_tok.2
    pos = pos + 2
    if equal(name, "new_array"):
        if tok_is_punct_text(tokens, pos, ")"):
            return err_parse_fail_at(208, line)
        end
        let r = err_parse_type(tokens, pos, ctx)
        if r.0 == err_err_tag():
            return r
        end
        if not tok_is_punct_text(tokens, r.2, ")"):
            return err_parse_fail_current(208, tokens, r.2, ctx)
        end
        return err_parse_ok_extra(r.2 + 1, err_expr_new_array())
    end
    if tok_is_punct_text(tokens, pos, ")"):
        return err_parse_ok_extra(pos + 1, err_expr_call())
    end
    let r = err_parse_args_loop(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    if not tok_is_punct_text(tokens, r.2, ")"):
        return err_parse_fail_current(207, tokens, r.2, ctx)
    end
    return err_parse_ok_extra(r.2 + 1, err_expr_call())
end

func err_parse_args_loop(tokens, pos, ctx):
    let r = err_parse_expr(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    if tok_is_punct_text(tokens, r.2, ","):
        return err_parse_args_loop(tokens, r.2 + 1, ctx)
    end
    return err_parse_ok(r.2)
end

func err_parse_group_or_tuple(tokens, pos, ctx):
    let r = err_parse_expr(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    if tok_is_punct_text(tokens, r.2, ","):
        let tr = err_parse_tuple_tail(tokens, r.2 + 1, ctx)
        if tr.0 == err_err_tag():
            return tr
        end
        if not tok_is_punct_text(tokens, tr.2, ")"):
            return err_parse_fail_current(207, tokens, tr.2, ctx)
        end
        return err_parse_ok_extra(tr.2 + 1, err_expr_other())
    end
    if not tok_is_punct_text(tokens, r.2, ")"):
        return err_parse_fail_current(207, tokens, r.2, ctx)
    end
    return err_parse_ok_extra(r.2 + 1, r.3)
end

func err_parse_tuple_tail(tokens, pos, ctx):
    let r = err_parse_expr(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    if tok_is_punct_text(tokens, r.2, ","):
        return err_parse_tuple_tail(tokens, r.2 + 1, ctx)
    end
    return err_parse_ok(r.2)
end

func err_parse_body(tokens, pos, ctx, seen_count):
    if is_body_terminator(tokens, pos):
        return err_parse_ok_extra(pos, seen_count)
    end
    let r = err_parse_stmt(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_body(tokens, r.2, ctx, seen_count + 1)
end

func err_parse_stmt(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    if pos >= count(tokens):
        return err_parse_fail_at(205, line)
    end
    let t = get(tokens, pos)
    if t.0 != 0:
        return err_parse_fail_at(205, line)
    end
    let text = t.1
    if equal(text, "let"):
        return err_parse_let(tokens, pos + 1, ctx)
    end
    if equal(text, "return"):
        let r = err_parse_expr(tokens, pos + 1, ctx)
        if r.0 == err_err_tag():
            return r
        end
        return err_parse_ok(r.2)
    end
    if equal(text, "do"):
        return err_parse_do(tokens, pos + 1, ctx, line)
    end
    if equal(text, "if"):
        return err_parse_if(tokens, pos + 1, ctx, line)
    end
    if err_is_reserved_word(text):
        return err_parse_fail_at(205, line)
    end
    return err_parse_assign(tokens, pos, ctx)
end

func err_parse_let(tokens, pos, ctx):
    if not err_is_valid_name_token(tokens, pos):
        return err_parse_fail_current(212, tokens, pos, ctx)
    end
    if not tok_is_op_text(tokens, pos + 1, "="):
        return err_parse_fail_current(212, tokens, pos + 1, ctx)
    end
    let r = err_parse_expr(tokens, pos + 2, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_ok(r.2)
end

func err_parse_assign(tokens, pos, ctx):
    if not err_is_valid_name_token(tokens, pos):
        return err_parse_fail_current(212, tokens, pos, ctx)
    end
    if err_has_records(ctx) and tok_is_punct_text(tokens, pos + 1, ".") and err_is_valid_name_token(tokens, pos + 2) and tok_is_op_text(tokens, pos + 3, "="):
        let fr = err_parse_expr(tokens, pos + 4, ctx)
        if fr.0 == err_err_tag():
            return fr
        end
        return err_parse_ok(fr.2)
    end
    if not tok_is_op_text(tokens, pos + 1, "="):
        return err_parse_fail_current(212, tokens, pos, ctx)
    end
    let r = err_parse_expr(tokens, pos + 2, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_ok(r.2)
end

func err_parse_do(tokens, pos, ctx, do_line):
    let r = err_parse_expr(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    -- new_array is call-shaped too. Whether a callee is permitted in a do
    -- statement belongs to native semantic checking, not this structural pass.
    if r.3 != err_expr_call() and r.3 != err_expr_new_array():
        return err_parse_fail_at(205, do_line)
    end
    return err_parse_ok(r.2)
end

func err_parse_if(tokens, pos, ctx, if_line):
    let cr = err_parse_expr(tokens, pos, ctx)
    if cr.0 == err_err_tag():
        return cr
    end
    if not tok_is_punct_text(tokens, cr.2, ":"):
        return err_parse_fail_current(204, tokens, cr.2, ctx)
    end
    let br = err_parse_body(tokens, cr.2 + 1, ctx, 0)
    if br.0 == err_err_tag():
        return br
    end
    if br.3 == 0:
        return err_parse_fail_at(210, if_line)
    end
    let ar = err_parse_elifs(tokens, br.2, ctx, if_line)
    if ar.0 == err_err_tag():
        return ar
    end
    pos = ar.2
    if tok_is_ident_text(tokens, pos, "else"):
        let er = err_parse_else(tokens, pos + 1, ctx, if_line)
        if er.0 == err_err_tag():
            return er
        end
        pos = er.2
    end
    if not tok_is_ident_text(tokens, pos, "end"):
        return err_parse_fail_current(203, tokens, pos, ctx)
    end
    return err_parse_ok(pos + 1)
end

func err_parse_elifs(tokens, pos, ctx, if_line):
    if tok_is_ident_text(tokens, pos, "elif"):
        let cr = err_parse_expr(tokens, pos + 1, ctx)
        if cr.0 == err_err_tag():
            return cr
        end
        if not tok_is_punct_text(tokens, cr.2, ":"):
            return err_parse_fail_current(204, tokens, cr.2, ctx)
        end
        let br = err_parse_body(tokens, cr.2 + 1, ctx, 0)
        if br.0 == err_err_tag():
            return br
        end
        if br.3 == 0:
            return err_parse_fail_at(210, if_line)
        end
        return err_parse_elifs(tokens, br.2, ctx, if_line)
    end
    return err_parse_ok(pos)
end

func err_parse_else(tokens, pos, ctx, if_line):
    if not tok_is_punct_text(tokens, pos, ":"):
        return err_parse_fail_current(203, tokens, pos, ctx)
    end
    let br = err_parse_body(tokens, pos + 1, ctx, 0)
    if br.0 == err_err_tag():
        return br
    end
    if br.3 == 0:
        return err_parse_fail_at(210, if_line)
    end
    return err_parse_ok(br.2)
end

func err_parse_param_loop(tokens, pos, ctx, params):
    if not err_is_valid_name_token(tokens, pos):
        return err_parse_fail_current(202, tokens, pos, ctx)
    end
    let param_tok = get(tokens, pos)
    let name = param_tok.1
    if err_name_seen(params, name):
        return err_parse_fail_payload(311, param_tok.2, name)
    end
    do add(params, name)
    if tok_is_punct_text(tokens, pos + 1, ","):
        return err_parse_param_loop(tokens, pos + 2, ctx, params)
    end
    return err_parse_ok_extra(pos + 1, count(params))
end

func err_parse_param_list(tokens, pos, ctx):
    let params = new_array(string)
    if tok_is_punct_text(tokens, pos, ")"):
        return err_parse_ok_extra(pos, 0)
    end
    return err_parse_param_loop(tokens, pos, ctx, params)
end

func err_parse_func(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    if not err_is_valid_name_token(tokens, pos + 1):
        return err_parse_fail_current(202, tokens, pos + 1, ctx)
    end
    if not tok_is_punct_text(tokens, pos + 2, "("):
        return err_parse_fail_current(202, tokens, pos + 2, ctx)
    end
    let pr = err_parse_param_list(tokens, pos + 3, ctx)
    if pr.0 == err_err_tag():
        return pr
    end
    if not tok_is_punct_text(tokens, pr.2, ")"):
        return err_parse_fail_current(202, tokens, pr.2, ctx)
    end
    if not tok_is_punct_text(tokens, pr.2 + 1, ":"):
        return err_parse_fail_current(202, tokens, pr.2 + 1, ctx)
    end
    let br = err_parse_body(tokens, pr.2 + 2, ctx, 0)
    if br.0 == err_err_tag():
        return br
    end
    if br.3 == 0:
        return err_parse_fail_at(209, line)
    end
    if not tok_is_ident_text(tokens, br.2, "end"):
        return err_parse_fail_current(203, tokens, br.2, ctx)
    end
    return err_parse_ok(br.2 + 1)
end

func err_parse_program_loop(tokens, pos, ctx):
    if pos >= count(tokens):
        return err_parse_ok(pos)
    end
    if err_is_ref_record_head(tokens, pos):
        let rf = err_parse_record(tokens, pos + 1, ctx)
        if rf.0 == err_err_tag():
            return rf
        end
        return err_parse_program_loop(tokens, rf.2, ctx)
    end
    if err_is_record_head(tokens, pos):
        let rr = err_parse_record(tokens, pos, ctx)
        if rr.0 == err_err_tag():
            return rr
        end
        return err_parse_program_loop(tokens, rr.2, ctx)
    end
    if not tok_is_ident_text(tokens, pos, "func"):
        return err_parse_fail_current(201, tokens, pos, ctx)
    end
    let r = err_parse_func(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_program_loop(tokens, r.2, ctx)
end

-- A program that declares records may use their names as types and may use
-- field syntax (e.FIELD, x.FIELD = e). The names come from a token scan for a
-- top-level `record NAME :`; without one, field syntax and named types stay
-- structural errors (206, 211, 212).
func err_is_record_head(tokens, pos):
    if not tok_is_ident_text(tokens, pos, "record"):
        return false
    end
    if not err_is_valid_name_token(tokens, pos + 1):
        return false
    end
    return tok_is_punct_text(tokens, pos + 2, ":")
end

-- Only a declaration at the top level counts: the scan tracks block depth
-- (func, if and a record head open a block, end closes one), so the same
-- tokens inside a function body leave the program record-free.
func err_is_ref_record_head(tokens, pos):
    return tok_is_ident_text(tokens, pos, "ref") and err_is_record_head(tokens, pos + 1)
end

func err_record_names_scan(tokens, pos, names, depth):
    if pos >= count(tokens):
        return names
    end
    if depth == 0 and err_is_ref_record_head(tokens, pos):
        do add(names, get(tokens, pos + 2).1)
        return err_record_names_scan(tokens, pos + 4, names, 1)
    end
    if depth == 0 and err_is_record_head(tokens, pos):
        do add(names, get(tokens, pos + 1).1)
        return err_record_names_scan(tokens, pos + 3, names, 1)
    end
    if tok_is_ident_text(tokens, pos, "func") or tok_is_ident_text(tokens, pos, "if"):
        return err_record_names_scan(tokens, pos + 1, names, depth + 1)
    end
    if depth > 0 and tok_is_ident_text(tokens, pos, "end"):
        return err_record_names_scan(tokens, pos + 1, names, depth - 1)
    end
    return err_record_names_scan(tokens, pos + 1, names, depth)
end

func err_is_record_name(ctx, name):
    return err_name_seen(ctx.1, name)
end

func err_has_records(ctx):
    return count(ctx.1) > 0
end

-- record NAME: FIELD: TYPE ... end, with at least two fields (ERR 213).
func err_parse_record_fields(tokens, pos, ctx, n_fields, record_line):
    if tok_is_ident_text(tokens, pos, "end"):
        if n_fields < 2:
            return err_parse_fail_at(213, record_line)
        end
        return err_parse_ok(pos + 1)
    end
    if not err_is_valid_name_token(tokens, pos):
        return err_parse_fail_at(213, err_token_line(tokens, pos, ctx))
    end
    if not tok_is_punct_text(tokens, pos + 1, ":"):
        return err_parse_fail_at(213, err_token_line(tokens, pos + 1, ctx))
    end
    let t = err_parse_type(tokens, pos + 2, ctx)
    if t.0 == err_err_tag():
        return t
    end
    return err_parse_record_fields(tokens, t.2, ctx, n_fields + 1, record_line)
end

func err_parse_record(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    let name = get(tokens, pos + 1).1
    if equal(name, "record") or equal(name, "ref"):
        return err_parse_fail_at(213, line)
    end
    return err_parse_record_fields(tokens, pos + 3, ctx, 0, line)
end

func err_parse_program(tokens, eof_line):
    let names = err_record_names_scan(tokens, 0, new_array(string), 0)
    return err_parse_program_loop(tokens, 0, (eof_line, names))
end

func err_is_builtin_name(name):
    if nc_is_hosted_memory_builtin(name):
        return true
    end
    if equal(name, "boot_read"):
        return true
    end
    if equal(name, "length") or equal(name, "index") or equal(name, "slice"):
        return true
    end
    if equal(name, "equal") or equal(name, "new_buffer") or equal(name, "freeze"):
        return true
    end
    if equal(name, "new_array") or equal(name, "get") or equal(name, "count"):
        return true
    end
    if equal(name, "bufbase") or equal(name, "bufget") or equal(name, "bufset"):
        return true
    end
    if equal(name, "process_exit") or equal(name, "stderr_write") or equal(name, "stdin_read"):
        return true
    end
    return equal(name, "append") or equal(name, "add") or equal(name, "clogger") or equal(name, "flogger") or equal(name, "fwriter") or equal(name, "input_byte") or equal(name, "module_byte") or equal(name, "sys_read") or equal(name, "sys_write") or equal(name, "yield") or equal(name, "output_byte")
end

func err_is_void_builtin(name):
    return equal(name, "append") or equal(name, "add") or equal(name, "flogger") or equal(name, "fwriter") or equal(name, "process_exit")
end

func err_value_builtin_arity(name):
    if equal(name, "linux_syscall6"):
        return 7
    end
    if equal(name, "buffer_address") or equal(name, "buffer_length"):
        return 1
    end
    if equal(name, "buffer_get"):
        return 2
    end
    if equal(name, "buffer_set"):
        return 3
    end
    if equal(name, "boot_read"):
        return 0
    end
    if equal(name, "stdin_read"):
        return 0
    end
    if equal(name, "stderr_write"):
        return 1
    end
    if equal(name, "length"):
        return 1
    end
    if equal(name, "index"):
        return 2
    end
    if equal(name, "equal"):
        return 2
    end
    if equal(name, "new_buffer"):
        return 0
    end
    if equal(name, "freeze"):
        return 1
    end
    if equal(name, "get"):
        return 2
    end
    if equal(name, "count"):
        return 1
    end
    if equal(name, "sys_write"):
        return 1
    end
    if equal(name, "output_byte"):
        return 1
    end
    if equal(name, "yield"):
        return 1
    end
    if equal(name, "bufget"):
        return 2
    end
    if equal(name, "bufset"):
        return 3
    end
    if equal(name, "input_byte") or equal(name, "module_byte") or equal(name, "sys_read") or equal(name, "bufbase"):
        return 0
    end
    return 0
end

func err_void_builtin_arity(name):
    if equal(name, "process_exit"):
        return 1
    end
    if equal(name, "fwriter"):
        return 1
    end
    if equal(name, "flogger"):
        return 1
    end
    return 2
end
