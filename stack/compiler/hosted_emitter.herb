func nc_code_has_faultable_loop(code, i, n):
    if i >= n:
        return 0
    end
    let op = get(code, i).0
    -- 23/29/31 = index/get/append OOB faults; 43/44 = div/mod by-zero fault.
    -- A faultable op forces the fault-helper block (incl. the exit1 routine the
    -- div/mod zero-check jumps to) to be emitted. op_mul (42) never faults.
    if op == 23 or op == 29 or op == 31 or op == 43 or op == 44 or op == 60 or op == 61:
        return 1
    end
    return nc_code_has_faultable_loop(code, i + 1, n)
end

func nc_funcs_have_faultable_loop(funcs, i, n):
    if i >= n:
        return 0
    end
    if nc_code_has_faultable_loop(get(funcs, i).4, 0, count(get(funcs, i).4)) != 0:
        return 1
    end
    return nc_funcs_have_faultable_loop(funcs, i + 1, n)
end

func nc_prog_has_faultable(prog):
    return nc_funcs_have_faultable_loop(prog.0, 0, count(prog.0))
end

-- Little-endian byte-serialization helpers. Now that tonka added * / %, these
-- use real remainder/division. Pre-tonka (no * / %) they were O(value)
-- repeated-subtraction loops, which hung compilation on a large literal whose
-- PUSH_INT byte split ran billions of iterations (D15 -- throne). The byte
-- values are unchanged; only the cost is (O(value) -> O(1) per byte).
func nc_mod256(v):
    return v % 256
end

func nc_div256(v):
    return v / 256
end

func nc_append_le32(buf, v):
    let b0 = nc_mod256(v)
    let v1 = nc_div256(v)
    let b1 = nc_mod256(v1)
    let v2 = nc_div256(v1)
    let b2 = nc_mod256(v2)
    let v3 = nc_div256(v2)
    let b3 = nc_mod256(v3)
    do append(buf, b0)
    do append(buf, b1)
    do append(buf, b2)
    do append(buf, b3)
    return buf
end

func nc_append_le64(buf, v):
    let b0 = nc_mod256(v)
    let v1 = nc_div256(v)
    let b1 = nc_mod256(v1)
    let v2 = nc_div256(v1)
    let b2 = nc_mod256(v2)
    let v3 = nc_div256(v2)
    let b3 = nc_mod256(v3)
    let v4 = nc_div256(v3)
    let b4 = nc_mod256(v4)
    let v5 = nc_div256(v4)
    let b5 = nc_mod256(v5)
    let v6 = nc_div256(v5)
    let b6 = nc_mod256(v6)
    let v7 = nc_div256(v6)
    let b7 = nc_mod256(v7)
    do append(buf, b0)
    do append(buf, b1)
    do append(buf, b2)
    do append(buf, b3)
    do append(buf, b4)
    do append(buf, b5)
    do append(buf, b6)
    do append(buf, b7)
    return buf
end

func nc_append_s32(buf, neg, mag):
    if neg == 0:
        return nc_append_le32(buf, mag)
    end
    let m = mag - 1
    let b0 = nc_mod256(m)
    let v1 = nc_div256(m)
    let b1 = nc_mod256(v1)
    let v2 = nc_div256(v1)
    let b2 = nc_mod256(v2)
    let v3 = nc_div256(v2)
    let b3 = nc_mod256(v3)
    do append(buf, 255 - b0)
    do append(buf, 255 - b1)
    do append(buf, 255 - b2)
    do append(buf, 255 - b3)
    return buf
end

func nc_append_s8(buf, neg, mag):
    if neg == 0:
        do append(buf, mag)
    elif mag == 0:
        do append(buf, 0)
    else:
        do append(buf, 256 - mag)
    end
    return buf
end

func nc_signed_fits8(neg, mag):
    if neg == 0:
        return mag <= 127
    end
    return mag <= 128
end

func nc_rel_ok(target, base):
    if target >= base:
        return target - base < 2147483648
    end
    return base - target <= 2147483648
end

func nc_append_rel32(buf, target, base):
    if target >= base:
        return nc_append_le32(buf, target - base)
    end
    return nc_append_s32(buf, 1, base - target)
end

func nc_mul8_loop(acc, n):
    if n <= 0:
        return acc
    end
    return nc_mul8_loop(acc + 8, n - 1)
end

func nc_mul8(n):
    return nc_mul8_loop(0, n)
end

func nc_mod16_loop(v):
    if v < 16:
        return v
    end
    return nc_mod16_loop(v - 16)
end

func nc_mod16(v):
    return nc_mod16_loop(v)
end

func nc_round16_up(v):
    let m = nc_mod16(v)
    if m == 0:
        return v
    end
    return v + 16 - m
end

func nc_mod8_loop(v):
    if v < 8:
        return v
    end
    return nc_mod8_loop(v - 8)
end

func nc_round8_up(v):
    let m = nc_mod8_loop(v)
    if m == 0:
        return v
    end
    return v + 8 - m
end

func nc_disp_len_rbp(neg, mag):
    if nc_signed_fits8(neg, mag):
        return 4
    end
    return 7
end

func nc_disp_len_rbp_mzb(neg, mag):
    if nc_signed_fits8(neg, mag):
        return 5
    end
    return 8
end

func nc_disp_len_rsp(mag):
    if mag <= 127:
        return 5
    end
    return 8
end

func nc_disp_len_rdi(mag):
    if mag == 0:
        return 3
    end
    if mag <= 127:
        return 4
    end
    return 7
end

func nc_disp_len_rsi(mag):
    if mag == 0:
        return 3
    end
    if mag <= 127:
        return 4
    end
    return 7
end

func nc_disp_len_rsp_r8(mag):
    if mag <= 127:
        return 5
    end
    return 8
end

func nc_disp_pair_from_pos_minus(pos, sub):
    if pos >= sub:
        return (0, pos - sub)
    end
    return (1, sub - pos)
end

func nc_rslot_pair(ng, nf):
    let pos = 8 + nc_mul8(ng)
    let sub = nc_mul8(nf)
    return nc_disp_pair_from_pos_minus(pos, sub)
end

func nc_tail_dst_pair(ng, k):
    let pos = 8 + nc_mul8(ng)
    let sub = nc_mul8(k)
    return nc_disp_pair_from_pos_minus(pos, sub)
end

func nc_tail_copy_len_loop(k, nf, ng, acc):
    if k >= nf:
        return acc
    end
    let src = nc_mul8(nf - 1 - k)
    let dst = nc_tail_dst_pair(ng, k)
    return nc_tail_copy_len_loop(k + 1, nf, ng, acc + nc_disp_len_rsp(src) + nc_disp_len_rbp(dst.0, dst.1))
end

func nc_tail_len(ng, nf):
    let rslot = nc_rslot_pair(ng, nf)
    return 8 + nc_tail_copy_len_loop(0, nf, ng, 0) + nc_disp_len_rbp(rslot.0, rslot.1) + nc_disp_len_rbp(rslot.0, rslot.1) + 3 + 5
end

func nc_cleanup_len(nargs):
    if nc_mul8(nargs) <= 127:
        return 4
    end
    return 7
end

func nc_call_len(nargs):
    return 5 + nc_cleanup_len(nargs) + 1
end

func nc_local_mag(slot):
    return nc_mul8(slot + 1)
end

func nc_sub_len(frame_sz):
    if frame_sz <= 127:
        return 4
    end
    return 7
end

func nc_prologue_len(frame_sz):
    return 4 + nc_sub_len(frame_sz)
end

func nc_max_i(a, b):
    if a > b:
        return a
    end
    return b
end

func nc_frame_total_words(meta):
    let hidden = 0
    if meta.6 != 0 - 1:
        hidden = 1
    end
    return meta.5 + hidden + meta.8
end

func nc_frame_total(meta):
    return nc_round16_up(nc_mul8(nc_frame_total_words(meta)))
end

func nc_fault_route_len():
    return 12
end

func nc_fault_rodata_len():
    return 135
end

func nc_fault_helper_len():
    return 418
end

func nc_write_helper_len():
    return 46
end

func nc_render_int_body_len():
    return 58
end

func nc_render_bool_body_len():
    return 75
end

func nc_render_body_len(main_ret):
    if main_ret == nc_type_bool():
        return nc_render_bool_body_len()
    end
    return nc_render_int_body_len()
end

func nc_render_len(main_ret):
    return nc_render_body_len(main_ret) + nc_write_helper_len()
end

func nc_entry_head_len():
    return 19
end

func nc_entry_layout(has_heap, has_faultable, main_ret, rplan):
    let heap_len = 0
    if has_heap != 0:
        heap_len = 70
    end
    let head_len = nc_entry_head_len()
    let render_len = nc_render_len(main_ret)
    -- link11/link12: a renderable AGGREGATE main (non-empty render plan) inlines its
    -- whole render into the entry head and places the int/bool/str/write helpers in
    -- the render region; the single-word int/bool path keeps the scalar head +
    -- body+write. (A flat int/bool tuple's plan reproduces the garland byte length.)
    if count(rplan) > 0:
        let s = nc_tuple_sret_size(nc_rplan_words(rplan))
        head_len = nc_render_agg_head_len(s, rplan)
        render_len = nc_render_helpers_len()
    end
    let fault_len = 0
    if has_faultable != 0:
        fault_len = nc_fault_helper_len()
    end
    let fault_start = heap_len + head_len
    let render_start = fault_start + fault_len
    let function_start = render_start + render_len
    return (heap_len, head_len, fault_len, render_len, fault_start, render_start, function_start)
end

func nc_fault_helper_start(has_heap, has_faultable, main_ret, rplan):
    return nc_entry_layout(has_heap, has_faultable, main_ret, rplan).4
end

func nc_fault_diag_index_rel():
    return 0
end

func nc_fault_diag_get_rel():
    return 106
end

func nc_fault_diag_append_rel():
    return 212
end

func nc_fault_write_fd2_rel():
    return 307
end

func nc_fault_dec_fd2_rel():
    return 353
end

func nc_fault_exit1_rel():
    return 406
end

func nc_fault_prefix_off():
    return 0
end

func nc_fault_sep_index_off():
    return 14
end

func nc_fault_sep_get_off():
    return 32
end

func nc_fault_sep_append_off():
    return 48
end

func nc_fault_mid_len_off():
    return 69
end

func nc_fault_mid_cnt_off():
    return 91
end

func nc_fault_mid_byte_off():
    return 112
end

func nc_fault_close_paren_nl_off():
    return 132
end

func nc_fault_just_nl_off():
    return 134
end

func nc_arg_copy_len_loop(k, nwords, acc):
    if k >= nwords:
        return acc
    end
    let src_mag = 16 + nc_mul8(nwords - 1 - k)
    let dst_mag = nc_local_mag(k)
    return nc_arg_copy_len_loop(k + 1, nwords, acc + nc_disp_len_rbp(0, src_mag) + nc_disp_len_rbp(1, dst_mag))
end

func nc_load_local_len_loop(base, j, width, acc):
    if j >= width:
        return acc
    end
    return nc_load_local_len_loop(base, j + 1, width, acc + nc_disp_len_rbp(1, nc_local_mag(base + j)) + 1)
end

func nc_load_local_len(base, width):
    return nc_load_local_len_loop(base, 0, width, 0)
end

func nc_store_local_len_loop(base, j, acc):
    if j == 0 - 1:
        return acc
    end
    return nc_store_local_len_loop(base, j - 1, acc + 1 + nc_disp_len_rbp(1, nc_local_mag(base + j)))
end

func nc_store_local_len(base, width):
    return nc_store_local_len_loop(base, width - 1, 0)
end

func nc_sret_save_len(meta):
    if meta.6 == 0 - 1:
        return 0
    end
    return nc_disp_len_rbp(1, nc_local_mag(meta.6))
end

func nc_group_single_len(op):
    if op == 0:
        return 11
    end
    if op == 1:
        return 2
    end
    if op == 2:
        return 16
    end
    if op == 5 or op == 6:
        return 6
    end
    if op == 7 or op == 8 or op == 9 or op == 10 or op == 11 or op == 12:
        return 13
    end
    if op == 13:
        return 12
    end
    if op == 14:
        return 0
    end
    if op == 16:
        return 5
    end
    if op == 17:
        return 10
    end
    if op == 18 or op == 19:
        return 17
    end
    if op == 21:
        return 3
    end
    if op == 22:
        return 3
    end
    if op == 23:
        return 27
    end
    if op == 25:
        return 50
    end
    if op == 26:
        return 84
    end
    if op == 27:
        return 75
    end
    if op == 28:
        return 84
    end
    if op == 30:
        return 5
    end
    if op == 31:
        return 135
    end
    if op == 33:
        return 91
    end
    if op == 34:
        return 44
    end
    if op == 35:
        return 593
    end
    if op == 54:
        return 10
    end
    if op == 55:
        return 55
    end
    if op == 56:
        return 106
    end
    if op == 58:
        return 13
    end
    if op == 59:
        return 6
    end
    if op == 60:
        return 33
    end
    if op == 61:
        return 56
    end
    if op == 62:
        return 5
    end
    -- Bitwise / shift (36-41). LOAD-BEARING for branch-displacement layout:
    -- pass 1 sizes every instruction here; a missing arm would give the new
    -- ops length 0 and silently rot every branch offset in any function that
    -- uses them. band/bor/bxor/shl/shr are the same 6-byte shape as add/sub
    -- (pop rcx; pop rax; <3-byte op>; push rax); bnot is 5 bytes (pop rax;
    -- not rax; push rax) like op 30 (count).
    if op == 36 or op == 37 or op == 38 or op == 39 or op == 40:
        return 6
    end
    if op == 41:
        return 5
    end
    -- Multiplicative (42-44). LOAD-BEARING for branch-displacement layout: a
    -- wrong length here silently rots every branch offset in any function that
    -- uses these ops. mul is 7 bytes (pop rcx; pop rax; imul rax,rcx [4 bytes];
    -- push rax). div and mod are 18 bytes each: pop rcx; pop rax; test rcx,rcx
    -- [3]; jz exit1 [6]; xor rdx,rdx [3]; div rcx [3]; push rax|rdx [1]. These
    -- MUST match the byte counts emitted by nc_emit_mul / nc_emit_div_or_mod.
    if op == 42:
        return 7
    end
    if op == 43 or op == 44:
        return 18
    end
    return 0
end

func nc_heap_trap_len():
    return 12
end

func nc_heap_alloc_len():
    return 25
end

func nc_get_loads_len(width, j, acc):
    if j >= width:
        return acc
    end
    return nc_get_loads_len(width, j + 1, acc + nc_disp_len_rsi(nc_mul8(j)) + 1)
end

func nc_get_len(width):
    if width == 1:
        return 32
    end
    return 51 + nc_get_loads_len(width, 0, 0)
end

func nc_arr_add_store_len(width, k, acc):
    if k == 0 - 1:
        return acc
    end
    return nc_arr_add_store_len(width, k - 1, acc + 1 + nc_disp_len_rsi(nc_mul8(k)))
end

func nc_arr_add_len(width):
    return nc_disp_len_rsp_r8(nc_mul8(width)) + 177 + nc_arr_add_store_len(width, width - 1, 0)
end

func nc_rsp_store_len(mag):
    return nc_disp_len_rsp(mag)
end

func nc_tuple_get_copy_len_loop(j, f, w, s, acc):
    if j >= f:
        return acc
    end
    let src = nc_mul8(w - 1 - (s + j))
    let dst = nc_mul8(w - 1 - j)
    return nc_tuple_get_copy_len_loop(j + 1, f, w, s, acc + nc_disp_len_rsp(src) + nc_rsp_store_len(dst))
end

func nc_tuple_get_len(meta, pc):
    let tm = get(meta.10, pc)
    let drop = tm.0 - tm.2
    let cleanup = 0
    if drop > 0:
        cleanup = nc_cleanup_len(drop)
    end
    return nc_tuple_get_copy_len_loop(0, tm.2, tm.0, tm.1, 0) + cleanup
end

func nc_sret_scratch_mag(base_word, ret_width, k):
    return nc_mul8(base_word + ret_width - k)
end

func nc_call_ret_push_len_loop(base_word, ret_width, k, n, acc):
    if k >= n:
        return acc
    end
    return nc_call_ret_push_len_loop(base_word, ret_width, k + 1, n, acc + nc_disp_len_rbp(1, nc_sret_scratch_mag(base_word, ret_width, k)) + 1)
end

func nc_normal_call_len(meta, pc):
    let cm = get(meta.11, pc)
    if cm.2 == 1:
        return nc_disp_len_rbp(1, nc_sret_scratch_mag(meta.7, cm.1, 0)) + 5 + nc_cleanup_len(cm.0) + nc_call_ret_push_len_loop(meta.7, cm.1, 0, cm.1, 0)
    end
    return 5 + nc_cleanup_len(cm.0) + 1
end

func nc_tail_len_for_meta(meta, pc):
    let cm = get(meta.11, pc)
    let extra = 0
    if cm.2 == 3:
        extra = nc_disp_len_rbp(1, nc_local_mag(meta.6))
    end
    return nc_tail_len(meta.0, cm.0) + extra
end

func nc_aggregate_ret_store_len_loop(k, retw, acc):
    if k == 0 - 1:
        return acc
    end
    return nc_aggregate_ret_store_len_loop(k - 1, retw, acc + 1 + nc_disp_len_rdi(nc_mul8(k)))
end

func nc_ret_len(meta):
    if meta.2 <= 1:
        return 3
    end
    return nc_disp_len_rbp(1, nc_local_mag(meta.6)) + nc_aggregate_ret_store_len_loop(meta.2 - 1, meta.2, 0) + 2
end

func nc_group(code, i, n, fn, funcs, meta, metas):
    if i >= n:
        return (0, n)
    end
    let instr = get(code, i)
    let op = instr.0
    if op == 3:
        let base = get(meta.3, instr.1)
        let width = get(meta.4, instr.1)
        return (nc_load_local_len(base, width), i + 1)
    end
    if op == 4:
        let base = get(meta.3, instr.1)
        let width = get(meta.4, instr.1)
        return (nc_store_local_len(base, width), i + 1)
    end
    if op == 15:
        return (nc_tuple_get_len(meta, i), i + 1)
    end
    if op == 29:
        return (nc_get_len(get(meta.14, i).1), i + 1)
    end
    if op == 32:
        return (nc_arr_add_len(get(meta.14, i).1), i + 1)
    end
    if op == 20:
        let cm = get(meta.11, i)
        if cm.2 == 2 or cm.2 == 3:
            return (nc_tail_len_for_meta(meta, i), i + 2)
        end
        return (nc_normal_call_len(meta, i), i + 1)
    end
    if op == 21:
        return (nc_ret_len(meta), i + 1)
    end
    return (nc_group_single_len(op), i + 1)
end

func nc_pass1_fill_group(offs, bounds, j, next_i, cur, start):
    if j >= next_i:
        return (offs, bounds)
    end
    do add(offs, cur)
    if j == start:
        do add(bounds, 1)
    else:
        do add(bounds, 0)
    end
    return nc_pass1_fill_group(offs, bounds, j + 1, next_i, cur, start)
end

func nc_pass1_layout_loop(code, i, n, cur, offs, bounds, fn, funcs, meta, metas):
    if i >= n:
        do add(offs, cur)
        do add(bounds, 0)
        return (offs, bounds, cur)
    end
    let g = nc_group(code, i, n, fn, funcs, meta, metas)
    let filled = nc_pass1_fill_group(offs, bounds, i, g.1, cur, i)
    return nc_pass1_layout_loop(code, g.1, n, cur + g.0, filled.0, filled.1, fn, funcs, meta, metas)
end

func nc_pass1_layout(fn, funcs, meta, metas, prefix_len):
    return nc_pass1_layout_loop(fn.4, 0, count(fn.4), prefix_len, new_array(int), new_array(int), fn, funcs, meta, metas)
end

func nc_branch_end_delta(op):
    if op == 16:
        return 5
    end
    if op == 17:
        return 10
    end
    return 13
end

func nc_branch_and_rel_verify_loop(code, i, n, fn, funcs, meta, metas, layout, layouts):
    if i >= n:
        return 0
    end
    let instr = get(code, i)
    let op = instr.0
    let g = nc_group(code, i, n, fn, funcs, meta, metas)
    if op == 16 or op == 17 or op == 18 or op == 19:
        let target = instr.1
        if target >= n or target <= i:
            return nc_fail(415, 0, int_to_str(target))
        end
        if get(layout.2, target) == 0:
            return nc_fail(415, 0, int_to_str(target))
        end
        let base = layout.0 + get(layout.1, i) + nc_branch_end_delta(op)
        let dest = layout.0 + get(layout.1, target)
        if dest <= base:
            return nc_fail(415, 0, int_to_str(target))
        end
        if not nc_rel_ok(dest, base):
            return nc_fail(427, 0, "")
        end
    end
    if op == 20:
        let callee_layout = get(layouts, instr.1)
        let target_entry = callee_layout.0
        let base = 0
        let cm = get(meta.11, i)
        if cm.2 == 2 or cm.2 == 3:
            base = layout.0 + get(layout.1, i) + g.0
        elif cm.2 == 1:
            base = layout.0 + get(layout.1, i) + nc_disp_len_rbp(1, nc_sret_scratch_mag(meta.7, cm.1, 0)) + 5
        else:
            base = layout.0 + get(layout.1, i) + 5
        end
        if not nc_rel_ok(target_entry, base):
            return nc_fail(427, 0, "")
        end
    end
    return nc_branch_and_rel_verify_loop(code, g.1, n, fn, funcs, meta, metas, layout, layouts)
end

func nc_verify_layout_rels_loop(funcs, metas, layouts, i, n):
    if i >= n:
        return 0
    end
    let fn = get(funcs, i)
    let meta = get(metas, i)
    let layout = get(layouts, i)
    let r = nc_branch_and_rel_verify_loop(fn.4, 0, count(fn.4), fn, funcs, meta, metas, layout, layouts)
    if r != 0:
        return r
    end
    return nc_verify_layout_rels_loop(funcs, metas, layouts, i + 1, n)
end

func nc_entry_stub_len(has_clogger, has_heap, has_faultable, main_ret, rplan):
    return nc_entry_layout(has_heap, has_faultable, main_ret, rplan).6
end

func nc_pass1_program_loop(funcs, metas, i, n, entry, layouts):
    if i >= n:
        return (0, layouts, entry)
    end
    let fn = get(funcs, i)
    let meta = get(metas, i)
    let frame_sz = nc_frame_total(meta)
    let prefix_len = nc_prologue_len(frame_sz) + nc_sret_save_len(meta) + nc_arg_copy_len_loop(0, meta.0, 0)
    let lay = nc_pass1_layout(fn, funcs, meta, metas, prefix_len)
    let fn_len = lay.2
    do add(layouts, (entry, lay.0, lay.1, frame_sz, prefix_len, fn_len))
    return nc_pass1_program_loop(funcs, metas, i + 1, n, entry + fn_len, layouts)
end

func nc_pass1_program(prog, metas, has_clogger, has_heap, has_faultable, rplan):
    let funcs = prog.0
    let layouts = new_array((int, array(int), array(int), int, int, int))
    let main_ret = get(metas, prog.2).1
    let entry_layout = nc_entry_layout(has_heap, has_faultable, main_ret, rplan)
    let stub_len = nc_entry_stub_len(has_clogger, has_heap, has_faultable, main_ret, rplan)
    let r = nc_pass1_program_loop(funcs, metas, 0, count(funcs), stub_len, layouts)
    if r.0 != 0:
        return r
    end
    let main_layout = get(r.1, prog.2)
    let call_main_base = entry_layout.0 + 5
    if not nc_rel_ok(main_layout.0, call_main_base):
        return (nc_fail(427, 0, ""), r.1, r.2)
    end
    let call_render_base = entry_layout.0 + 10
    if not nc_rel_ok(entry_layout.5, call_render_base):
        return (nc_fail(427, 0, ""), r.1, r.2)
    end
    let vr = nc_verify_layout_rels_loop(funcs, metas, r.1, 0, count(funcs))
    if vr != 0:
        return (vr, r.1, r.2)
    end
    return r
end

