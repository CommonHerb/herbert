    do append(buf, 8)
    do append(buf, 195)
    do append(buf, 72)
    do append(buf, 131)
    do append(buf, 236)
    do append(buf, 8)
    do append(buf, 199)
    do append(buf, 4)
    do append(buf, 36)
    do append(buf, 102)
    do append(buf, 97)
    do append(buf, 108)
    do append(buf, 115)
    do append(buf, 102)
    do append(buf, 199)
    do append(buf, 68)
    do append(buf, 36)
    do append(buf, 4)
    do append(buf, 101)
    do append(buf, 10)
    do append(buf, 72)
    do append(buf, 137)
    do append(buf, 230)
    do append(buf, 186)
    buf = nc_append_le32(buf, 6)
    buf = nc_emit_call_abs(buf, write_off)
    do append(buf, 72)
    do append(buf, 131)
    do append(buf, 196)
    do append(buf, 8)
    do append(buf, 195)
    return buf
end

func nc_emit_render_main(buf, main_ret, render_start):
    let write_off = render_start + nc_render_body_len(main_ret)
    if main_ret == nc_type_bool():
        buf = nc_emit_render_bool_fd1(buf, write_off)
    else:
        buf = nc_emit_render_int_fd1(buf, write_off)
    end
    return nc_emit_write_fd(buf, 1)
end

-- ====================================================================
-- link11: render a returned FLAT int/bool TUPLE to stdout in Herbert's
-- canonical form, byte-identical to the C reference v_print_canonical_rec:
--   "(" + elements joined by ", " + ")" + "\n"
-- The single-word int/bool render path above (kringle, D14) is unchanged.
-- The N result words are delivered by the aggregate-return ABI: the entry
-- stub does `sub rsp,S; lea rdi,[rsp]; call main`, and main stores word k
-- to [rdi+8k] = [rsp+8k]. The render runs with rsp at that scratch base; the
-- structural literals are staged at [rsp+8N] (above the N results). Each
-- element renderer (int/bool, no newline) and the shared write helper are
-- placed once after the (optional) fault helpers; the inline render body
-- calls them. Lengths are exact (the ERR-418 sub-boundary check verifies).
-- Validated on silicon before wiring.

-- sret scratch size: N words rounded up to 16 + 16 (staging+pad), so that
-- `call main` keeps the rsp%16==0 the single-word path already relies on.
func nc_tuple_sret_size(n):
    let base = nc_mul8(n)
    if nc_mod16(base) != 0:
        base = base + 8
    end
    return base + 16
end

func nc_imm_rsp_len(s):
    if s <= 127:
        return 4
    end
    return 7
end

func nc_emit_sub_rsp_imm(buf, s):
    do append(buf, 72)
    if s <= 127:
        do append(buf, 131)
        do append(buf, 236)
        do append(buf, s)
        return buf
    end
    do append(buf, 129)
    do append(buf, 236)
    return nc_append_le32(buf, s)
end

func nc_emit_add_rsp_imm(buf, s):
    do append(buf, 72)
    if s <= 127:
        do append(buf, 131)
        do append(buf, 196)
        do append(buf, s)
        return buf
    end
    do append(buf, 129)
    do append(buf, 196)
    return nc_append_le32(buf, s)
end

func nc_render_int_noln_len():
    return 53
end

func nc_render_bool_noln_len():
    return 68
end

func nc_render_helpers_len():
    return nc_render_int_noln_len() + nc_render_bool_noln_len() + nc_render_str_noln_len() + nc_write_helper_len()
end

-- link12: a string element load+call stub (RSTR), 15 bytes:
--   mov rsi,[rsp+8w]; mov rdx,[rsp+8(w+1)]; call str_off
func nc_render_str_elem_len():
    return 15
end

-- link12: the string escaping helper (nc_emit_render_str_noln), 161 bytes
-- (hand-assembled + validated byte-exact vs C's print_string_lit before wiring).
func nc_render_str_noln_len():
    return 161
end

-- link12: per-token byte length of a render plan (see nc_build_render_plan).
func nc_rtok_len(kind):
    if kind == 0:
        return nc_render_putc_len()
    end
    if kind == 1:
        return nc_render_putsep_len()
    end
    if kind == 4:
        return nc_render_str_elem_len()
    end
    return nc_render_elem_len()
end

func nc_rplan_body_len_loop(rplan, i, n, acc):
    if i >= n:
        return acc
    end
    return nc_rplan_body_len_loop(rplan, i + 1, n, acc + nc_rtok_len(get(rplan, i).0))
end

func nc_rplan_body_len(rplan):
    return nc_rplan_body_len_loop(rplan, 0, count(rplan), 0)
end

-- Total result-word width W referenced by a plan (max word + the referenced
-- element's width). Drives the sret scratch size + the staging-slot offset 8W.
func nc_rtok_words(tok):
    if tok.0 == 2 or tok.0 == 3:
        return tok.1 + 1
    end
    if tok.0 == 4:
        return tok.1 + 2
    end
    return 0
end

func nc_rplan_words_loop(rplan, i, n, acc):
    if i >= n:
        return acc
    end
    let w = nc_rtok_words(get(rplan, i))
    let m = acc
    if w > m:
        m = w
    end
    return nc_rplan_words_loop(rplan, i + 1, n, m)
end

func nc_rplan_words(rplan):
    return nc_rplan_words_loop(rplan, 0, count(rplan), 0)
end

func nc_render_putc_len():
    return 20
end

func nc_render_putsep_len():
    return 22
end

func nc_render_elem_len():
    return 10
end

-- sret_head = sub rsp,S (imm8/imm32) + lea rdi,[rsp] (4) + call main (5).
func nc_render_sret_head_len(s):
    return nc_imm_rsp_len(s) + 4 + 5
end

-- tail = add rsp,S (imm8/imm32) + exit_group(0) (9).
func nc_render_tuple_tail_len(s):
    return nc_imm_rsp_len(s) + 9
end

-- link12: the entry-stub render head for ANY renderable aggregate, driven by the
-- linearized plan. (For a flat int/bool tuple the plan is PUTC'(' + elems +
-- PUTC')' + PUTC'\n', reproducing the garland flat byte length exactly.)
func nc_render_agg_head_len(s, rplan):
    return nc_render_sret_head_len(s) + nc_rplan_body_len(rplan) + nc_render_tuple_tail_len(s)
end

