func nc_emit_new_heap_header(buf, backing_size):
    do append(buf, 191)
    do append(buf, 24)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    buf = nc_emit_heap_alloc(buf)
    do append(buf, 73)
    do append(buf, 137)
    do append(buf, 192)
    do append(buf, 73)
    do append(buf, 199)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 73)
    do append(buf, 199)
    do append(buf, 64)
    do append(buf, 8)
    do append(buf, 2)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 191)
    buf = nc_append_le32(buf, backing_size)
    buf = nc_emit_heap_alloc(buf)
    do append(buf, 73)
    do append(buf, 137)
    do append(buf, 64)
    do append(buf, 16)
    do append(buf, 65)
    do append(buf, 80)
    return buf
end

func nc_emit_new_buffer(buf):
    return nc_emit_new_heap_header(buf, 2)
end

func nc_emit_new_array(buf, width):
    return nc_emit_new_heap_header(buf, nc_mul8(width + width))
end

func nc_emit_count(buf):
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 139)
    do append(buf, 0)
    do append(buf, 80)
    return buf
end

func nc_emit_get_loads(buf, width, j):
    if j >= width:
        return buf
    end
    buf = nc_emit_rsi_load_rax(buf, nc_mul8(j))
    do append(buf, 80)
    return nc_emit_get_loads(buf, width, j + 1)
end

func nc_emit_get(buf, width, line, diag_get_off, instr_off):
    do append(buf, 89)
    do append(buf, 65)
    do append(buf, 88)
    do append(buf, 77)
    do append(buf, 139)
    do append(buf, 8)
    do append(buf, 76)
    do append(buf, 57)
    do append(buf, 201)
    do append(buf, 114)
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 23)
    do append(buf, 77)
    do append(buf, 139)
    do append(buf, 80)
    do append(buf, 16)
    if width == 1:
        do append(buf, 73)
        do append(buf, 139)
        do append(buf, 4)
        do append(buf, 202)
        do append(buf, 80)
        return buf
    end
    do append(buf, 72)
    do append(buf, 105)
    do append(buf, 241)
    buf = nc_append_le32(buf, nc_mul8(width))
    do append(buf, 113)
    do append(buf, 12)
    buf = nc_emit_heap_trap(buf)
    do append(buf, 76)
    do append(buf, 1)
    do append(buf, 214)
    return nc_emit_get_loads(buf, width, 0)
end

func nc_emit_arr_add_stores(buf, k):
    if k == 0 - 1:
        return buf
    end
    do append(buf, 88)
    buf = nc_emit_rsi_store_rax(buf, nc_mul8(k))
    return nc_emit_arr_add_stores(buf, k - 1)
end

