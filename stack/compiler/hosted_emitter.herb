
-- Every hosted program carries the fault-helper block (K4). Each one writes
-- main's result through the fd1 write helper, whose failed write is reported
-- through the block ("herbert: cannot write output (error N)"); every heap
-- allocation reports a used-up heap through it; div/mod and the index, slice,
-- get, append and buffer_* ops report their located faults through it (slice
-- through index's helper). Before K4 the
-- block was emitted only for a program with one of the located-fault ops
-- (23/29/31/43/44/60/61/66/67), and any other program ended silently on a full
-- heap or a failed write. nc_drive appends the fault rodata when this is 1.
-- It is 2 when the emitted code stores with set (ARR_SET, op 68): the block
-- then also carries diag_set after exit1, and the rodata ": set: position "
-- after the write prefix, so no earlier offset moves and every program
-- without set keeps its image.
func nc_prog_has_faultable(prog):
    if nc_funcs_have_op_loop(prog.0, 68, 0, count(prog.0)):
        return 2
    end
    return 1
end

func nc_code_has_op_loop(code, op, i, n):
    while i < n:
        if get(code, i).0 == op:
            return true
        end
        i = i + 1
    end
    return false
end

func nc_funcs_have_op_loop(funcs, op, i, n):
    while i < n:
        let code = get(funcs, i).4
        if nc_code_has_op_loop(code, op, 0, count(code)):
            return true
        end
        i = i + 1
    end
    return false
end

-- Little-endian byte-serialization helpers. Now that tonka added * / %, these
-- use real remainder/division. Pre-tonka (no * / %) they were O(value)
-- repeated-subtraction loops, which hung compilation on a large literal whose
-- PUSH_INT byte split ran billions of iterations (D15 -- throne). The byte
-- values are unchanged; only the cost is (O(value) -> O(1) per byte).
func nc_mod256(v):
    return v % 256
end

func nc_div256(v):
    return v / 256
end

func nc_append_le32(buf, v):
    let b0 = nc_mod256(v)
    let v1 = nc_div256(v)
    let b1 = nc_mod256(v1)
    let v2 = nc_div256(v1)
    let b2 = nc_mod256(v2)
    let v3 = nc_div256(v2)
    let b3 = nc_mod256(v3)
    do append(buf, b0)
    do append(buf, b1)
    do append(buf, b2)
    do append(buf, b3)
    return buf
end

func nc_append_le64(buf, v):
    let b0 = nc_mod256(v)
    let v1 = nc_div256(v)
    let b1 = nc_mod256(v1)
    let v2 = nc_div256(v1)
    let b2 = nc_mod256(v2)
    let v3 = nc_div256(v2)
    let b3 = nc_mod256(v3)
    let v4 = nc_div256(v3)
    let b4 = nc_mod256(v4)
    let v5 = nc_div256(v4)
    let b5 = nc_mod256(v5)
    let v6 = nc_div256(v5)
    let b6 = nc_mod256(v6)
    let v7 = nc_div256(v6)
    let b7 = nc_mod256(v7)
    do append(buf, b0)
    do append(buf, b1)
    do append(buf, b2)
    do append(buf, b3)
    do append(buf, b4)
    do append(buf, b5)
    do append(buf, b6)
    do append(buf, b7)
    return buf
end

func nc_append_s32(buf, neg, mag):
    if neg == 0:
        return nc_append_le32(buf, mag)
    end
    let m = mag - 1
    let b0 = nc_mod256(m)
    let v1 = nc_div256(m)
    let b1 = nc_mod256(v1)
    let v2 = nc_div256(v1)
    let b2 = nc_mod256(v2)
    let v3 = nc_div256(v2)
    let b3 = nc_mod256(v3)
    do append(buf, 255 - b0)
    do append(buf, 255 - b1)
    do append(buf, 255 - b2)
    do append(buf, 255 - b3)
    return buf
end

func nc_append_s8(buf, neg, mag):
    if neg == 0:
        do append(buf, mag)
    elif mag == 0:
        do append(buf, 0)
    else:
        do append(buf, 256 - mag)
    end
    return buf
end

func nc_signed_fits8(neg, mag):
    if neg == 0:
        return mag <= 127
    end
    return mag <= 128
end

func nc_rel_ok(target, base):
    if target >= base:
        return target - base < 2147483648
    end
    return base - target <= 2147483648
end

func nc_append_rel32(buf, target, base):
    if target >= base:
        return nc_append_le32(buf, target - base)
    end
    return nc_append_s32(buf, 1, base - target)
end

func nc_mul8_loop(acc, n):
    while n > 0:
        acc = acc + 8
        n = n - 1
    end
    return acc
end

func nc_mul8(n):
    return nc_mul8_loop(0, n)
end

func nc_mod16_loop(v):
    while v >= 16:
        v = v - 16
    end
    return v
end

func nc_mod16(v):
    return nc_mod16_loop(v)
end

func nc_round16_up(v):
    let m = nc_mod16(v)
    if m == 0:
        return v
    end
    return v + 16 - m
end

func nc_disp_len_rbp(neg, mag):
    if nc_signed_fits8(neg, mag):
        return 4
    end
    return 7
end

func nc_disp_len_rsp(mag):
    if mag <= 127:
        return 5
    end
    return 8
end

func nc_disp_len_rdi(mag):
    if mag == 0:
        return 3
    end
    if mag <= 127:
        return 4
    end
    return 7
end

func nc_disp_len_rsi(mag):
    if mag == 0:
        return 3
    end
    if mag <= 127:
        return 4
    end
    return 7
end

func nc_disp_len_rsp_r8(mag):
    if mag <= 127:
        return 5
    end
    return 8
end

func nc_disp_pair_from_pos_minus(pos, sub):
    if pos >= sub:
        return (0, pos - sub)
    end
    return (1, sub - pos)
end

func nc_rslot_pair(ng, nf):
    let pos = 8 + nc_mul8(ng)
    let sub = nc_mul8(nf)
    return nc_disp_pair_from_pos_minus(pos, sub)
end

func nc_tail_dst_pair(ng, k):
    let pos = 8 + nc_mul8(ng)
    let sub = nc_mul8(k)
    return nc_disp_pair_from_pos_minus(pos, sub)
end

func nc_tail_copy_len_loop(k, nf, ng, acc):
    while k < nf:
        let src = nc_mul8(nf - 1 - k)
        let dst = nc_tail_dst_pair(ng, k)
        k = k + 1
        acc = acc + nc_disp_len_rsp(src) + nc_disp_len_rbp(dst.0, dst.1)
    end
    return acc
end

func nc_tail_len(ng, nf):
    let rslot = nc_rslot_pair(ng, nf)
    return 8 + nc_tail_copy_len_loop(0, nf, ng, 0) + nc_disp_len_rbp(rslot.0, rslot.1) + nc_disp_len_rbp(rslot.0, rslot.1) + 3 + 5
end

func nc_cleanup_len(nargs):
    if nc_mul8(nargs) <= 127:
        return 4
    end
    return 7
end

func nc_local_mag(slot):
    return nc_mul8(slot + 1)
end

func nc_sub_len(frame_sz):
    if frame_sz <= 127:
        return 4
    end
    return 7
end

func nc_prologue_len(frame_sz):
    return 4 + nc_sub_len(frame_sz)
end

func nc_max_i(a, b):
    if a > b:
        return a
    end
    return b
end

func nc_frame_total_words(meta):
    let hidden = 0
    if meta.sret_word != 0 - 1:
        hidden = 1
    end
    return meta.local_words + hidden + meta.max_sret
end

func nc_frame_total(meta):
    return nc_round16_up(nc_mul8(nc_frame_total_words(meta)))
end

func nc_fault_route_len():
    return 12
end

-- The fault rodata (nc_append_fault_rodata), appended after the program's own
-- strings: nine fragments (135 bytes), then ": division by zero\n" (19), the
-- out-of-memory sentence (53), the cannot-reserve sentence (41) and the
-- "cannot write output (error " prefix (36), each appended LAST so no earlier
-- offset moved. 284 bytes.
func nc_fault_rodata_len():
    return 284
end

-- A program that stores with set (has_faultable 2) also has ": set: position "
-- (16 bytes) after those 284 (nc_append_set_fault_rodata).
func nc_set_fault_rodata_len(has_faultable):
    if has_faultable == 2:
        return 16
    end
    return 0
end

-- The fault-helper block, placed after the entry head. Offsets from its start:
-- diag_index 0 (106), diag_get 106 (106), diag_append 212 (95), diag_div 307
-- (50), diag_oom 357 (22), diag_reserve 379 (22), diag_write 401 (60), write_fd2
-- 461 (46), dec_fd2 507 (53), exit1 560 (12). 572 bytes (418 before K4).
-- A program that stores with set (has_faultable 2) also carries diag_set at
-- 572 (106), after everything else: 678 bytes.
func nc_fault_helper_len():
    return 572
end

func nc_fault_diag_set_len():
    return 106
end

func nc_write_helper_len():
    return 46
end

func nc_render_int_body_len():
    return 58
end

func nc_render_bool_body_len():
    return 75
end

func nc_render_body_len(main_ret):
    if main_ret == nc_type_bool():
        return nc_render_bool_body_len()
    end
    return nc_render_int_body_len()
end

func nc_render_len(main_ret):
    return nc_render_body_len(main_ret) + nc_write_helper_len()
end

func nc_entry_head_len():
    return 19
end

func nc_entry_layout(has_heap, has_faultable, main_ret, rplan):
    let heap_len = 0
    if has_heap != 0:
        heap_len = 70
    end
    let head_len = nc_entry_head_len()
    let render_len = nc_render_len(main_ret)
    -- link11/link12: a renderable AGGREGATE main (non-empty render plan) inlines its
    -- whole render into the entry head and places the int/bool/str/write helpers in
    -- the render region; the single-word int/bool path keeps the scalar head +
    -- body+write. (A flat int/bool tuple's plan reproduces the garland byte length.)
    if count(rplan) > 0:
        let s = nc_tuple_sret_size(nc_rplan_words(rplan))
        head_len = nc_render_agg_head_len(s, rplan)
        render_len = nc_render_helpers_len()
    end
    let fault_len = 0
    if has_faultable != 0:
        fault_len = nc_fault_helper_len()
    end
    if has_faultable == 2:
        fault_len = fault_len + nc_fault_diag_set_len()
    end
    let fault_start = heap_len + head_len
    let render_start = fault_start + fault_len
    let function_start = render_start + render_len
    return (heap_len, head_len, fault_len, render_len, fault_start, render_start, function_start)
end

func nc_fault_helper_start(has_heap, has_faultable, main_ret, rplan):
    return nc_entry_layout(has_heap, has_faultable, main_ret, rplan).4
end

func nc_fault_diag_index_rel():
    return 0
end

func nc_fault_diag_get_rel():
    return 106
end

func nc_fault_diag_append_rel():
    return 212
end

func nc_fault_diag_div_rel():
    return 307
end

func nc_fault_diag_oom_rel():
    return 357
end

func nc_fault_diag_reserve_rel():
    return 379
end

func nc_fault_diag_write_rel():
    return 401
end

func nc_fault_diag_set_rel():
    return nc_fault_helper_len()
end

func nc_fault_write_fd2_rel():
    return 461
end

func nc_fault_dec_fd2_rel():
    return 507
end

func nc_fault_exit1_rel():
    return 560
end

func nc_fault_prefix_off():
    return 0
end

func nc_fault_sep_index_off():
    return 14
end

func nc_fault_sep_get_off():
    return 32
end

func nc_fault_sep_append_off():
    return 48
end

func nc_fault_mid_len_off():
    return 69
end

func nc_fault_mid_cnt_off():
    return 91
end

func nc_fault_mid_byte_off():
    return 112
end

func nc_fault_close_paren_nl_off():
    return 132
end

func nc_fault_just_nl_off():
    return 134
end

func nc_fault_sep_div_off():
    return 135
end

func nc_fault_oom_off():
    return 154
end

func nc_fault_reserve_off():
    return 207
end

func nc_fault_write_off():
    return 248
end

func nc_fault_sep_set_off():
    return 284
end

func nc_arg_copy_len_loop(k, nwords, acc):
    while k < nwords:
        let src_mag = 16 + nc_mul8(nwords - 1 - k)
        let dst_mag = nc_local_mag(k)
        k = k + 1
        acc = acc + nc_disp_len_rbp(0, src_mag) + nc_disp_len_rbp(1, dst_mag)
    end
    return acc
end

func nc_load_local_len_loop(base, j, width, acc):
    while j < width:
        let next_j = j + 1
        let next_acc = acc + nc_disp_len_rbp(1, nc_local_mag(base + j)) + 1
        j = next_j
        acc = next_acc
    end
    return acc
end

func nc_load_local_len(base, width):
    return nc_load_local_len_loop(base, 0, width, 0)
end

func nc_store_local_len_loop(base, j, acc):
    while j != 0 - 1:
        let next_j = j - 1
        let next_acc = acc + 1 + nc_disp_len_rbp(1, nc_local_mag(base + j))
        j = next_j
        acc = next_acc
    end
    return acc
end

func nc_store_local_len(base, width):
    return nc_store_local_len_loop(base, width - 1, 0)
end

func nc_sret_save_len(meta):
    if meta.sret_word == 0 - 1:
        return 0
    end
    return nc_disp_len_rbp(1, nc_local_mag(meta.sret_word))
end

func nc_group_single_len(op):
    if op == 0:
        return 11
    end
    if op == 1:
        return 2
    end
    if op == 2:
        return 16
    end
    if op == 5 or op == 6:
        return 6
    end
    if op == 7 or op == 8 or op == 9 or op == 10 or op == 11 or op == 12:
        return 13
    end
    if op == 13:
        return 12
    end
    if op == 14:
        return 0
    end
    if op == 16:
        return 5
    end
    if op == 17:
        return 10
    end
    if op == 18 or op == 19:
        return 17
    end
    if op == 21:
        return 3
    end
    if op == 22:
        return 3
    end
    if op == 23:
        return 27
    end
    if op == 24:
        return 52
    end
    if op == 25:
        return 50
    end
    if op == 26:
        return 84
    end
    if op == 27:
        return 75
    end
    if op == 28:
        return 84
    end
    if op == 30:
        return 5
    end
    if op == 31:
        return 135
    end
    if op == 33:
        return 91
    end
    if op == 34:
        return 44
    end
    if op == 35:
        return 593
    end
    if op == 54:
        return 10
    end
    if op == 55:
        return 55
    end
    if op == 56:
        return 106
    end
    if op == 58:
        return 13
    end
    if op == 59:
        return 6
    end
    if op == 60:
        return 33
    end
    if op == 61:
        return 56
    end
    if op == 62:
        return 5
    end
    if op == 66:
        return 171
    end
    if op == 67:
        return 142
    end
    -- Bitwise / shift (36-41). LOAD-BEARING for branch-displacement layout:
    -- pass 1 sizes every instruction here; a missing arm would give the new
    -- ops length 0 and silently rot every branch offset in any function that
    -- uses them. band/bor/bxor/shl/shr are the same 6-byte shape as add/sub
    -- (pop rcx; pop rax; <3-byte op>; push rax); bnot is 5 bytes (pop rax;
    -- not rax; push rax) like op 30 (count).
    if op == 36 or op == 37 or op == 38 or op == 39 or op == 40:
        return 6
    end
    if op == 41:
        return 5
    end
    -- Multiplicative (42-44). LOAD-BEARING for branch-displacement layout: a
    -- wrong length here silently rots every branch offset in any function that
    -- uses these ops. mul is 7 bytes (pop rcx; pop rax; imul rax,rcx [4 bytes];
    -- push rax). div and mod are 24 bytes each: mov r10d,line [6]; pop rcx;
    -- pop rax; test rcx,rcx [3]; jz diag_div [6]; xor rdx,rdx [3]; div rcx [3];
    -- push rax|rdx [1]. These MUST match the byte counts emitted by nc_emit_mul /
    -- nc_emit_div_or_mod.
    if op == 42:
        return 7
    end
    if op == 43 or op == 44:
        return 24
    end
    return 0
end

func nc_get_loads_len(width, j, acc):
    while j < width:
        let next_j = j + 1
        let next_acc = acc + nc_disp_len_rsi(nc_mul8(j)) + 1
        j = next_j
        acc = next_acc
    end
    return acc
end

func nc_get_len(width):
    if width == 1:
        return 32
    end
    return 51 + nc_get_loads_len(width, 0, 0)
end

func nc_arr_add_store_len(width, k, acc):
    while k != 0 - 1:
        let next_k = k - 1
        let next_acc = acc + 1 + nc_disp_len_rsi(nc_mul8(k))
        k = next_k
        acc = next_acc
    end
    return acc
end

-- SET_FIELD (op 64): [array, w value words] -> stores the words into the
-- array's element at word offset off, then drops the array. Emitted only for a
-- ref record, whose one element exists by construction, so there is no check.
--   mov rax, [rsp + 8w]; mov rax, [rax + 16]; (pop rcx; mov [rax + 8(off + j)], rcx) for j = w-1..0; add rsp, 8
func nc_emit_rax_field_store(buf, mag):
    do append_str(buf, "\x48\x89")
    if mag <= 127:
        do append(buf, 72)
        do append(buf, mag)
        return buf
    end
    do append(buf, 136)
    return nc_append_le32(buf, mag)
end

func nc_emit_set_field_stores(buf, off, j):
    while j != 0 - 1:
        do append(buf, 89)
        buf = nc_emit_rax_field_store(buf, nc_mul8(off + j))
        j = j - 1
    end
    return buf
end

func nc_emit_set_field(buf, off, w):
    do append_str(buf, "\x48\x8b")
    let mag = nc_mul8(w)
    if mag <= 127:
        do append_str(buf, "\x44\x24")
        do append(buf, mag)
    else:
        do append_str(buf, "\x84\x24")
        buf = nc_append_le32(buf, mag)
    end
    do append_str(buf, "\x48\x8b\x40\x10")
    buf = nc_emit_set_field_stores(buf, off, w - 1)
    do append_str(buf, "\x48\x83\xc4\x08")
    return buf
end

func nc_set_field_store_len(off, j, acc):
    while j != 0 - 1:
        let mag = nc_mul8(off + j)
        let one = 7
        if mag <= 127:
            one = 4
        end
        j = j - 1
        acc = acc + 1 + one
    end
    return acc
end

-- GET_FIELD (op 65): [ref record] -> the field's w words, read from the
-- record's one element at word offset s. Emitted only for a ref record, whose
-- element exists by construction, so there is no check.
--   pop rax; mov rax, [rax + 16]; push qword [rax + 8(s + j)] for j = 0..w-1
func nc_emit_get_field_loads(buf, s, j, w):
    while j < w:
        let mag = nc_mul8(s + j)
        do append(buf, 255)
        if mag <= 127:
            do append(buf, 112)
            do append(buf, mag)
        else:
            do append(buf, 176)
            buf = nc_append_le32(buf, mag)
        end
        j = j + 1
    end
    return buf
end

func nc_emit_get_field(buf, meta, pc):
    let tm = get(meta.tuple_meta, pc)
    do append_str(buf, "\x58\x48\x8b\x40\x10")
    return nc_emit_get_field_loads(buf, tm.1, 0, tm.2)
end

func nc_get_field_loads_len(s, j, w, acc):
    while j < w:
        let one = 6
        if nc_mul8(s + j) <= 127:
            one = 3
        end
        j = j + 1
        acc = acc + one
    end
    return acc
end

func nc_get_field_len(meta, pc):
    let tm = get(meta.tuple_meta, pc)
    return 5 + nc_get_field_loads_len(tm.1, 0, tm.2, 0)
end

func nc_set_field_len(off, w):
    let head = 8
    if nc_mul8(w) <= 127:
        head = 5
    end
    return head + 4 + nc_set_field_store_len(off, w - 1, 0) + 4
end

func nc_arr_add_len(width):
    return nc_disp_len_rsp_r8(nc_mul8(width)) + 177 + nc_arr_add_store_len(width, width - 1, 0)
end

func nc_rsp_store_len(mag):
    return nc_disp_len_rsp(mag)
end

func nc_tuple_get_copy_len_loop(j, f, w, s, acc):
    while j < f:
        let src = nc_mul8(w - 1 - (s + j))
        let dst = nc_mul8(w - 1 - j)
        j = j + 1
        acc = acc + nc_disp_len_rsp(src) + nc_rsp_store_len(dst)
    end
    return acc
end

func nc_tuple_get_len(meta, pc):
    let tm = get(meta.tuple_meta, pc)
    let drop = tm.0 - tm.2
    let cleanup = 0
    if drop > 0:
        cleanup = nc_cleanup_len(drop)
    end
    return nc_tuple_get_copy_len_loop(0, tm.2, tm.0, tm.1, 0) + cleanup
end

func nc_sret_scratch_mag(base_word, ret_width, k):
    return nc_mul8(base_word + ret_width - k)
end

func nc_call_ret_push_len_loop(base_word, ret_width, k, n, acc):
    while k < n:
        let next_k = k + 1
        let next_acc = acc + nc_disp_len_rbp(1, nc_sret_scratch_mag(base_word, ret_width, k)) + 1
        k = next_k
        acc = next_acc
    end
    return acc
end

func nc_normal_call_len(meta, pc):
    let cm = get(meta.call_meta, pc)
    if cm.2 == 1:
        return nc_disp_len_rbp(1, nc_sret_scratch_mag(meta.scratch_base, cm.1, 0)) + 5 + nc_cleanup_len(cm.0) + nc_call_ret_push_len_loop(meta.scratch_base, cm.1, 0, cm.1, 0)
    end
    return 5 + nc_cleanup_len(cm.0) + 1
end

func nc_tail_len_for_meta(meta, pc):
    let cm = get(meta.call_meta, pc)
    let extra = 0
    if cm.2 == 3:
        extra = nc_disp_len_rbp(1, nc_local_mag(meta.sret_word))
    end
    return nc_tail_len(meta.pwords, cm.0) + extra
end

func nc_aggregate_ret_store_len_loop(k, retw, acc):
    while k != 0 - 1:
        let next_k = k - 1
        let next_acc = acc + 1 + nc_disp_len_rdi(nc_mul8(k))
        k = next_k
        acc = next_acc
    end
    return acc
end

func nc_ret_len(meta):
    if meta.retw <= 1:
        return 3
    end
    return nc_disp_len_rbp(1, nc_local_mag(meta.sret_word)) + nc_aggregate_ret_store_len_loop(meta.retw - 1, meta.retw, 0) + 2
end

func nc_group(code, i, n, fn, funcs, meta, metas):
    if i >= n:
        return (0, n)
    end
    let instr = get(code, i)
    let op = instr.0
    if op == 3:
        let base = get(meta.bases, instr.1)
        let width = get(meta.widths, instr.1)
        return (nc_load_local_len(base, width), i + 1)
    end
    if op == 4:
        let base = get(meta.bases, instr.1)
        let width = get(meta.widths, instr.1)
        return (nc_store_local_len(base, width), i + 1)
    end
    if op == 15:
        return (nc_tuple_get_len(meta, i), i + 1)
    end
    if op == 29:
        return (nc_get_len(get(meta.heap_meta, i).1), i + 1)
    end
    if op == 32:
        return (nc_arr_add_len(get(meta.heap_meta, i).1), i + 1)
    end
    if op == 63:
        return (nc_arr_add_len(get(meta.heap_meta, i).1) - 4, i + 1)
    end
    if op == 68:
        return (nc_arr_set_len(get(meta.heap_meta, i).1), i + 1)
    end
    if op == 64:
        return (nc_set_field_len(instr.1, instr.2), i + 1)
    end
    if op == 65:
        return (nc_get_field_len(meta, i), i + 1)
    end
    if op == 20:
        let cm = get(meta.call_meta, i)
        if cm.2 == 2 or cm.2 == 3:
            return (nc_tail_len_for_meta(meta, i), i + 2)
        end
        return (nc_normal_call_len(meta, i), i + 1)
    end
    if op == 21:
        return (nc_ret_len(meta), i + 1)
    end
    return (nc_group_single_len(op), i + 1)
end

func nc_pass1_fill_group(offs, bounds, j, next_i, cur, start):
    while j < next_i:
        do add(offs, cur)
        if j == start:
            do add(bounds, 1)
        else:
            do add(bounds, 0)
        end
        j = j + 1
    end
    return (offs, bounds)
end

func nc_pass1_layout_loop(code, i, n, cur, offs, bounds, fn, funcs, meta, metas):
    while i < n:
        let g = nc_group(code, i, n, fn, funcs, meta, metas)
        let filled = nc_pass1_fill_group(offs, bounds, i, g.1, cur, i)
        i = g.1
        cur = cur + g.0
        offs = filled.0
        bounds = filled.1
    end
    do add(offs, cur)
    do add(bounds, 0)
    return (offs, bounds, cur)
end

func nc_pass1_layout(fn, funcs, meta, metas, prefix_len):
    return nc_pass1_layout_loop(fn.4, 0, count(fn.4), prefix_len, new_array(int), new_array(int), fn, funcs, meta, metas)
end

func nc_branch_end_delta(op):
    if op == 16:
        return 5
    end
    if op == 17:
        return 10
    end
    return 13
end

func nc_branch_and_rel_verify_loop(code, i, n, fn, funcs, meta, metas, layout, layouts):
    while i < n:
        let instr = get(code, i)
        let op = instr.0
        let g = nc_group(code, i, n, fn, funcs, meta, metas)
        if op == 16 or op == 17 or op == 18 or op == 19:
            let target = instr.1
            if target >= n or target == i:
                return nc_fail(415, 0, int_to_str(target))
            end
            -- Only an unconditional branch may go backward: a loop's branch back
            -- to its condition.
            if target < i and op != 16:
                return nc_fail(415, 0, int_to_str(target))
            end
            if get(layout.2, target) == 0:
                return nc_fail(415, 0, int_to_str(target))
            end
            let base = layout.0 + get(layout.1, i) + nc_branch_end_delta(op)
            let dest = layout.0 + get(layout.1, target)
            if target > i and dest <= base:
                return nc_fail(415, 0, int_to_str(target))
            end
            if target < i and dest >= base:
                return nc_fail(415, 0, int_to_str(target))
            end
            if not nc_rel_ok(dest, base):
                return nc_fail(427, 0, "")
            end
        end
        if op == 20:
            let callee_layout = get(layouts, instr.1)
            let target_entry = callee_layout.0
            let base = 0
            let cm = get(meta.call_meta, i)
            if cm.2 == 2 or cm.2 == 3:
                base = layout.0 + get(layout.1, i) + g.0
            elif cm.2 == 1:
                base = layout.0 + get(layout.1, i) + nc_disp_len_rbp(1, nc_sret_scratch_mag(meta.scratch_base, cm.1, 0)) + 5
            else:
                base = layout.0 + get(layout.1, i) + 5
            end
            if not nc_rel_ok(target_entry, base):
                return nc_fail(427, 0, "")
            end
        end
        i = g.1
    end
    return 0
end

func nc_verify_layout_rels_loop(funcs, metas, layouts, i, n):
    while i < n:
        let fn = get(funcs, i)
        let meta = get(metas, i)
        let layout = get(layouts, i)
        let r = nc_branch_and_rel_verify_loop(fn.4, 0, count(fn.4), fn, funcs, meta, metas, layout, layouts)
        if r != 0:
            return r
        end
        i = i + 1
    end
    return 0
end

func nc_entry_stub_len(has_clogger, has_heap, has_faultable, main_ret, rplan):
    return nc_entry_layout(has_heap, has_faultable, main_ret, rplan).6
end

func nc_pass1_program_loop(funcs, metas, i, n, entry, layouts):
    while i < n:
        let fn = get(funcs, i)
        let meta = get(metas, i)
        let frame_sz = nc_frame_total(meta)
        let prefix_len = nc_prologue_len(frame_sz) + nc_sret_save_len(meta) + nc_arg_copy_len_loop(0, meta.pwords, 0)
        let lay = nc_pass1_layout(fn, funcs, meta, metas, prefix_len)
        let fn_len = lay.2
        do add(layouts, (entry, lay.0, lay.1, frame_sz, prefix_len, fn_len))
        i = i + 1
        entry = entry + fn_len
    end
    return (0, layouts, entry)
end

func nc_pass1_program(prog, metas, has_clogger, has_heap, has_faultable, rplan):
    let funcs = prog.0
    let layouts = new_array((int, array(int), array(int), int, int, int))
    let main_ret = get(metas, prog.2).ret
    let entry_layout = nc_entry_layout(has_heap, has_faultable, main_ret, rplan)
    let stub_len = nc_entry_stub_len(has_clogger, has_heap, has_faultable, main_ret, rplan)
    let r = nc_pass1_program_loop(funcs, metas, 0, count(funcs), stub_len, layouts)
    if r.0 != 0:
        return r
    end
    let main_layout = get(r.1, prog.2)
    let call_main_base = entry_layout.0 + 5
    if not nc_rel_ok(main_layout.0, call_main_base):
        return (nc_fail(427, 0, ""), r.1, r.2)
    end
    let call_render_base = entry_layout.0 + 10
    if not nc_rel_ok(entry_layout.5, call_render_base):
        return (nc_fail(427, 0, ""), r.1, r.2)
    end
    let vr = nc_verify_layout_rels_loop(funcs, metas, r.1, 0, count(funcs))
    if vr != 0:
        return (vr, r.1, r.2)
    end
    return r
end

func nc_emit_ehdr(buf):
    do append_str(buf, "\x7f\x45\x4c\x46\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00")
    do append_str(buf, "\x02\x00\x3e\x00\x01\x00\x00\x00\x78\x00\x40\x00\x00\x00\x00\x00")
    do append_str(buf, "\x40\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")
    do append_str(buf, "\x00\x00\x00\x00\x40\x00\x38\x00\x01\x00\x00\x00\x00\x00\x00\x00")
    return buf
end

func nc_emit_phdr(buf, img, align_hi):
    do append_str(buf, "\x01\x00\x00\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")
    do append_str(buf, "\x00\x00\x40\x00\x00\x00\x00\x00\x00\x00\x40\x00\x00\x00\x00\x00")
    buf = nc_append_le64(buf, img)
    buf = nc_append_le64(buf, img)
    do append_str(buf, "\x00\x10\x00\x00\x00\x00\x00")
    do append(buf, align_hi)
    return buf
end

func nc_code_has_call_loop(code, i, n):
    while i < n:
        if get(code, i).0 == 20:
            return true
        end
        i = i + 1
    end
    return false
end

func nc_funcs_have_call_loop(funcs, i, n):
    while i < n:
        if nc_code_has_call_loop(get(funcs, i).4, 0, count(get(funcs, i).4)):
            return true
        end
        i = i + 1
    end
    return false
end

func nc_funcs_have_call(funcs):
    return nc_funcs_have_call_loop(funcs, 0, count(funcs))
end

func nc_mod4096_loop(v):
    while v >= 4096:
        v = v - 4096
    end
    return v
end

func nc_roundup_page(v):
    let rem = nc_mod4096_loop(v)
    if rem == 0:
        return v
    end
    return v + 4096 - rem
end

func nc_emit_disp_rbp_load_rax(buf, neg, mag):
    do append_str(buf, "\x48\x8b")
    if nc_signed_fits8(neg, mag):
        do append(buf, 69)
        return nc_append_s8(buf, neg, mag)
    end
    do append(buf, 133)
    return nc_append_s32(buf, neg, mag)
end

func nc_emit_disp_rbp_store_rax(buf, neg, mag):
    do append_str(buf, "\x48\x89")
    if nc_signed_fits8(neg, mag):
        do append(buf, 69)
        return nc_append_s8(buf, neg, mag)
    end
    do append(buf, 133)
    return nc_append_s32(buf, neg, mag)
end

func nc_emit_disp_rbp_lea_rsp(buf, neg, mag):
    do append_str(buf, "\x48\x8d")
    if nc_signed_fits8(neg, mag):
        do append(buf, 101)
        return nc_append_s8(buf, neg, mag)
    end
    do append(buf, 165)
    return nc_append_s32(buf, neg, mag)
end

func nc_emit_rsp_load_rax(buf, mag):
    do append_str(buf, "\x48\x8b")
    if mag <= 127:
        do append_str(buf, "\x44\x24")
        do append(buf, mag)
        return buf
    end
    do append_str(buf, "\x84\x24")
    return nc_append_le32(buf, mag)
end

func nc_emit_disp_rbp_store_r11(buf, neg, mag):
    do append_str(buf, "\x4c\x89")
    if nc_signed_fits8(neg, mag):
        do append(buf, 93)
        return nc_append_s8(buf, neg, mag)
    end
    do append(buf, 157)
    return nc_append_s32(buf, neg, mag)
end

func nc_emit_prologue(buf, frame_sz):
    do append_str(buf, "\x55\x48\x89\xe5")
    if frame_sz <= 127:
        do append_str(buf, "\x48\x83\xec")
        do append(buf, frame_sz)
    else:
        do append_str(buf, "\x48\x81\xec")
        buf = nc_append_le32(buf, frame_sz)
    end
    return buf
end

func nc_emit_disp_rbp_load_rdi(buf, neg, mag):
    do append_str(buf, "\x48\x8b")
    if nc_signed_fits8(neg, mag):
        do append(buf, 125)
        return nc_append_s8(buf, neg, mag)
    end
    do append(buf, 189)
    return nc_append_s32(buf, neg, mag)
end

func nc_emit_disp_rbp_store_rdi(buf, neg, mag):
    do append_str(buf, "\x48\x89")
    if nc_signed_fits8(neg, mag):
        do append(buf, 125)
        return nc_append_s8(buf, neg, mag)
    end
    do append(buf, 189)
    return nc_append_s32(buf, neg, mag)
end

func nc_emit_disp_rbp_lea_rdi(buf, neg, mag):
    do append_str(buf, "\x48\x8d")
    if nc_signed_fits8(neg, mag):
        do append(buf, 125)
        return nc_append_s8(buf, neg, mag)
    end
    do append(buf, 189)
    return nc_append_s32(buf, neg, mag)
end

func nc_emit_rsp_store_rax(buf, mag):
    do append_str(buf, "\x48\x89")
    if mag <= 127:
        do append_str(buf, "\x44\x24")
        do append(buf, mag)
        return buf
    end
    do append_str(buf, "\x84\x24")
    return nc_append_le32(buf, mag)
end

func nc_emit_rsp_load_r8(buf, mag):
    do append_str(buf, "\x4c\x8b")
    if mag <= 127:
        do append_str(buf, "\x44\x24")
        do append(buf, mag)
        return buf
    end
    do append_str(buf, "\x84\x24")
    return nc_append_le32(buf, mag)
end

func nc_emit_rsi_load_rax(buf, mag):
    do append_str(buf, "\x48\x8b")
    if mag == 0:
        do append(buf, 6)
        return buf
    end
    if mag <= 127:
        do append(buf, 70)
        do append(buf, mag)
        return buf
    end
    do append(buf, 134)
    return nc_append_le32(buf, mag)
end

func nc_emit_rsi_store_rax(buf, mag):
    do append_str(buf, "\x48\x89")
    if mag == 0:
        do append(buf, 6)
        return buf
    end
    if mag <= 127:
        do append(buf, 70)
        do append(buf, mag)
        return buf
    end
    do append(buf, 134)
    return nc_append_le32(buf, mag)
end

-- The heap trap, 12 bytes (every site's skip-over branch assumes 12): jmp rel32
-- to the fault block's out-of-memory helper, then 7 int3 bytes nothing reaches.
-- Every allocation past the 3.5 GiB heap takes it, and so does every size that
-- would wrap on the way to one (a doubled capacity, a byte size, an element
-- offset, buffer_fill's need). Before K4 it was an inline exit_group(1) with no
-- message.
func nc_emit_heap_trap(buf, oom_off):
    return nc_emit_fault_jmp12(buf, oom_off)
end

-- jmp rel32 to target + 7 int3 (0xCC): a 12-byte exit into the fault block,
-- the length of the inline exit_group(1) it replaces.
func nc_emit_fault_jmp12(buf, target):
    buf = nc_emit_jmp_abs(buf, target)
    do append_str(buf, "\xcc\xcc\xcc\xcc\xcc\xcc\xcc")
    return buf
end

func nc_emit_heap_alloc(buf, oom_off):
    do append_str(buf, "\x4c\x89\xf0\x49\x01\xfe\x72\x05\x4d\x39\xfe\x76\x0c")
    return nc_emit_heap_trap(buf, oom_off)
end

func nc_emit_call_abs(buf, target):
    let base = buffer_length(buf) + 5
    do append(buf, 232)
    return nc_append_rel32(buf, target, base)
end

func nc_emit_jmp_abs(buf, target):
    let base = buffer_length(buf) + 5
    do append(buf, 233)
    return nc_append_rel32(buf, target, base)
end

-- jg rel32 (0F 8F): taken when the flags of the last test say greater than zero.
func nc_emit_jg_abs(buf, target):
    let base = buffer_length(buf) + 6
    do append_str(buf, "\x0f\x8f")
    return nc_append_rel32(buf, target, base)
end

func nc_emit_fault_route(buf, line, target, base):
    do append_str(buf, "\x49\xc7\xc2")
    buf = nc_append_le32(buf, line)
    do append(buf, 233)
    return nc_append_rel32(buf, target, base)
end

func nc_emit_fault_fragment(buf, ro_base, frag_off, frag_len, write_off):
    let instr_off = buffer_length(buf)
    do append_str(buf, "\x48\x8d\x35")
    buf = nc_append_rel32(buf, ro_base + frag_off, instr_off + 7)
    do append(buf, 186)
    buf = nc_append_le32(buf, frag_len)
    return nc_emit_call_abs(buf, write_off)
end

func nc_emit_diag_dec_r12(buf, dec_off):
    do append_str(buf, "\x4c\x89\xe0")
    return nc_emit_call_abs(buf, dec_off)
end

func nc_emit_diag_dec_r13(buf, dec_off):
    do append_str(buf, "\x4c\x89\xe8")
    return nc_emit_call_abs(buf, dec_off)
end

func nc_emit_diag_dec_r14(buf, dec_off):
    do append_str(buf, "\x4c\x89\xf0")
    return nc_emit_call_abs(buf, dec_off)
end

func nc_emit_diag_index(buf, ro_base, write_off, dec_off, exit_off):
    do append_str(buf, "\x49\x89\xcc\x49\x89\xd5\x4d\x89\xd6")
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_prefix_off(), 14, write_off)
    buf = nc_emit_diag_dec_r14(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_sep_index_off(), 18, write_off)
    buf = nc_emit_diag_dec_r12(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_mid_len_off(), 22, write_off)
    buf = nc_emit_diag_dec_r13(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_close_paren_nl_off(), 2, write_off)
    return nc_emit_jmp_abs(buf, exit_off)
end

func nc_emit_diag_get(buf, ro_base, write_off, dec_off, exit_off):
    return nc_emit_diag_position_count(buf, ro_base, nc_fault_sep_get_off(), write_off, dec_off, exit_off)
end

-- set's bounds fault: get's helper with ": set: position " (106 bytes).
func nc_emit_diag_set(buf, ro_base, write_off, dec_off, exit_off):
    return nc_emit_diag_position_count(buf, ro_base, nc_fault_sep_set_off(), write_off, dec_off, exit_off)
end

-- rcx = the position, r9 = the count, r10 = the line: "herbert: line N" +
-- the 16-byte separator at sep_off + "P out of range (count C)" and a
-- newline. 106 bytes.
func nc_emit_diag_position_count(buf, ro_base, sep_off, write_off, dec_off, exit_off):
    do append_str(buf, "\x49\x89\xcc\x4d\x89\xcd\x4d\x89\xd6")
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_prefix_off(), 14, write_off)
    buf = nc_emit_diag_dec_r14(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, sep_off, 16, write_off)
    buf = nc_emit_diag_dec_r12(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_mid_cnt_off(), 21, write_off)
    buf = nc_emit_diag_dec_r13(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_close_paren_nl_off(), 2, write_off)
    return nc_emit_jmp_abs(buf, exit_off)
end

func nc_emit_diag_append(buf, ro_base, write_off, dec_off, exit_off):
    do append_str(buf, "\x49\x89\xcc\x4d\x89\xd6")
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_prefix_off(), 14, write_off)
    buf = nc_emit_diag_dec_r14(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_sep_append_off(), 21, write_off)
    buf = nc_emit_diag_dec_r12(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_mid_byte_off(), 20, write_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_just_nl_off(), 1, write_off)
    return nc_emit_jmp_abs(buf, exit_off)
end

-- Division or modulo by zero: the site loaded r10 with the operator's line.
-- mov r14,r10 (3) + "herbert: line " (17) + decimal r14 (8) + ": division by
-- zero\n" (17) + jmp exit1 (5) = 50 bytes.
func nc_emit_diag_div(buf, ro_base, write_off, dec_off, exit_off):
    do append_str(buf, "\x4d\x89\xd6")
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_prefix_off(), 14, write_off)
    buf = nc_emit_diag_dec_r14(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_sep_div_off(), 19, write_off)
    return nc_emit_jmp_abs(buf, exit_off)
end

-- The heap is used up (any heap trap): one sentence, no line. 22 bytes.
func nc_emit_diag_oom(buf, ro_base, write_off, exit_off):
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_oom_off(), 53, write_off)
    return nc_emit_jmp_abs(buf, exit_off)
end

-- The startup mmap of the 3.5 GiB heap failed (the heap stub). 22 bytes.
func nc_emit_diag_reserve(buf, ro_base, write_off, exit_off):
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_reserve_off(), 41, write_off)
    return nc_emit_jmp_abs(buf, exit_off)
end

-- main's result could not be written. The fd1 write helper jumps here with rax =
-- write's return: a negative errno, or 0 for a write that made no progress,
-- which is reported as EIO (5). neg rax; jnz +5; mov eax,5; mov r14,rax (13) +
-- "herbert: cannot write output (error " (17) + decimal r14 (8) + ")\n" (17) +
-- jmp exit1 (5) = 60 bytes. A broken pipe does not get here while SIGPIPE has
-- its default action: the signal ends the process first, as it does for
-- standard tools.
func nc_emit_diag_write(buf, ro_base, write_off, dec_off, exit_off):
    do append_str(buf, "\x48\xf7\xd8\x75\x05\xb8\x05\x00\x00\x00\x49\x89\xc6")
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_write_off(), 36, write_off)
    buf = nc_emit_diag_dec_r14(buf, dec_off)
    buf = nc_emit_fault_fragment(buf, ro_base, nc_fault_close_paren_nl_off(), 2, write_off)
    return nc_emit_jmp_abs(buf, exit_off)
end

-- The write loop: rsi=ptr, rdx=len -> write(2) to fd until every byte is out,
-- advancing past short writes; returns at once for len 0. 34 bytes. When a
-- write returns 0 or less it falls into the 12-byte failure path that follows
-- (nc_emit_write_fd for fd 2, nc_emit_write_fd1 for main's result).
func nc_emit_write_loop(buf, fd):
    do append_str(buf, "\x48\x85\xd2\x74\x1c\xb8\x01\x00\x00\x00\xbf")
    do append(buf, fd)
    do append_str(buf, "\x00\x00\x00\x0f\x05\x48\x85\xc0\x7e\x0c\x48\x01\xc6\x48\x29\xc2")
    do append_str(buf, "\x48\x85\xd2\x75\xe4\xc3")
    return buf
end

-- fd 2, the fault block's write: a failed write ends the process with exit 1 and
-- no message, since stderr is where the message would go. 46 bytes.
func nc_emit_write_fd(buf, fd):
    buf = nc_emit_write_loop(buf, fd)
    do append_str(buf, "\xb8\xe7\x00\x00\x00\xbf\x01\x00\x00\x00\x0f\x05")
    return buf
end

-- fd 1, main's rendered result: a failed write jumps to the fault block's
-- "cannot write output" helper (fail_off) with rax = write's return. 46 bytes.
func nc_emit_write_fd1(buf, fail_off):
    buf = nc_emit_write_loop(buf, 1)
    return nc_emit_fault_jmp12(buf, fail_off)
end

func nc_emit_write_fd2(buf):
    return nc_emit_write_fd(buf, 2)
end

func nc_emit_dec_fd2(buf, write_off):
    do append_str(buf, "\x48\x83\xec\x20\x4c\x8d\x54\x24\x14\x4c\x89\xd6\x48\xc7\xc1\x0a")
    do append_str(buf, "\x00\x00\x00\x31\xd2\x48\xf7\xf1\x80\xc2\x30\x48\xff\xce\x88\x16")
    do append_str(buf, "\x48\x85\xc0\x75\xee\x4c\x89\xd2\x48\x29\xf2")
    buf = nc_emit_call_abs(buf, write_off)
    do append_str(buf, "\x48\x83\xc4\x20\xc3")
    return buf
end

func nc_emit_render_int_fd1(buf, write_off):
    do append_str(buf, "\x48\x83\xec\x20\x4c\x8d\x54\x24\x14\x41\xc6\x02\x0a\x4c\x89\xd6")
    do append_str(buf, "\x48\xc7\xc1\x0a\x00\x00\x00\x31\xd2\x48\xf7\xf1\x80\xc2\x30\x48")
    do append_str(buf, "\xff\xce\x88\x16\x48\x85\xc0\x75\xee\x49\x8d\x52\x01\x48\x29\xf2")
    buf = nc_emit_call_abs(buf, write_off)
    do append_str(buf, "\x48\x83\xc4\x20\xc3")
    return buf
end

func nc_emit_render_bool_fd1(buf, write_off):
    do append_str(buf, "\x48\x85\xc0\x74\x22\x48\x83\xec\x08\xc7\x04\x24\x74\x72\x75\x65")
    do append_str(buf, "\xc6\x44\x24\x04\x0a\x48\x89\xe6\xba")
    buf = nc_append_le32(buf, 5)
    buf = nc_emit_call_abs(buf, write_off)
    do append_str(buf, "\x48\x83\xc4\x08\xc3\x48\x83\xec\x08\xc7\x04\x24\x66\x61\x6c\x73")
    do append_str(buf, "\x66\xc7\x44\x24\x04\x65\x0a\x48\x89\xe6\xba")
    buf = nc_append_le32(buf, 6)
    buf = nc_emit_call_abs(buf, write_off)
    do append_str(buf, "\x48\x83\xc4\x08\xc3")
    return buf
end

func nc_emit_render_main(buf, main_ret, render_start, write_fail_off):
    let write_off = render_start + nc_render_body_len(main_ret)
    if main_ret == nc_type_bool():
        buf = nc_emit_render_bool_fd1(buf, write_off)
    else:
        buf = nc_emit_render_int_fd1(buf, write_off)
    end
    return nc_emit_write_fd1(buf, write_fail_off)
end

-- ====================================================================
-- link11: render a returned FLAT int/bool TUPLE to stdout in Herbert's
-- canonical form, byte-identical to the C reference v_print_canonical_rec:
--   "(" + elements joined by ", " + ")" + "\n"
-- The single-word int/bool render path above (kringle, D14) is unchanged.
-- The N result words are delivered by the aggregate-return ABI: the entry
-- stub does `sub rsp,S; lea rdi,[rsp]; call main`, and main stores word k
-- to [rdi+8k] = [rsp+8k]. The render runs with rsp at that scratch base; the
-- structural literals are staged at [rsp+8N] (above the N results). Each
-- element renderer (int/bool, no newline) and the shared write helper are
-- placed once after the fault helpers; the inline render body
-- calls them. Lengths are exact (the ERR-418 sub-boundary check verifies).
-- Validated on silicon before wiring.

-- sret scratch size: N words rounded up to 16 + 16 (staging+pad), so that
-- `call main` keeps the rsp%16==0 the single-word path already relies on.
func nc_tuple_sret_size(n):
    let base = nc_mul8(n)
    if nc_mod16(base) != 0:
        base = base + 8
    end
    return base + 16
end

func nc_imm_rsp_len(s):
    if s <= 127:
        return 4
    end
    return 7
end

func nc_emit_sub_rsp_imm(buf, s):
    do append(buf, 72)
    if s <= 127:
        do append_str(buf, "\x83\xec")
        do append(buf, s)
        return buf
    end
    do append_str(buf, "\x81\xec")
    return nc_append_le32(buf, s)
end

func nc_emit_add_rsp_imm(buf, s):
    do append(buf, 72)
    if s <= 127:
        do append_str(buf, "\x83\xc4")
        do append(buf, s)
        return buf
    end
    do append_str(buf, "\x81\xc4")
    return nc_append_le32(buf, s)
end

func nc_render_int_noln_len():
    return 53
end

func nc_render_bool_noln_len():
    return 68
end

func nc_render_helpers_len():
    return nc_render_int_noln_len() + nc_render_bool_noln_len() + nc_render_str_noln_len() + nc_write_helper_len()
end

-- link12: a string element load+call stub (RSTR), 15 bytes:
--   mov rsi,[rsp+8w]; mov rdx,[rsp+8(w+1)]; call str_off
func nc_render_str_elem_len():
    return 15
end

-- link12: the string escaping helper (nc_emit_render_str_noln), 148 bytes since
-- K4 wrote it in runs (161 bytes before, one write per byte); same output bytes.
func nc_render_str_noln_len():
    return 148
end

-- link12: per-token byte length of a render plan (see nc_build_render_plan).
func nc_rtok_len(kind):
    if kind == 0:
        return nc_render_putc_len()
    end
    if kind == 1:
        return nc_render_putsep_len()
    end
    if kind == 4:
        return nc_render_str_elem_len()
    end
    return nc_render_elem_len()
end

func nc_rplan_body_len_loop(rplan, i, n, acc):
    while i < n:
        let next_i = i + 1
        let next_acc = acc + nc_rtok_len(get(rplan, i).0)
        i = next_i
        acc = next_acc
    end
    return acc
end

func nc_rplan_body_len(rplan):
    return nc_rplan_body_len_loop(rplan, 0, count(rplan), 0)
end

-- Total result-word width W referenced by a plan (max word + the referenced
-- element's width). Drives the sret scratch size + the staging-slot offset 8W.
func nc_rtok_words(tok):
    if tok.0 == 2 or tok.0 == 3:
        return tok.1 + 1
    end
    if tok.0 == 4:
        return tok.1 + 2
    end
    return 0
end

func nc_rplan_words_loop(rplan, i, n, acc):
    while i < n:
        let w = nc_rtok_words(get(rplan, i))
        let m = acc
        if w > m:
            m = w
        end
        i = i + 1
        acc = m
    end
    return acc
end

func nc_rplan_words(rplan):
    return nc_rplan_words_loop(rplan, 0, count(rplan), 0)
end

func nc_render_putc_len():
    return 20
end

func nc_render_putsep_len():
    return 22
end

func nc_render_elem_len():
    return 10
end

-- sret_head = sub rsp,S (imm8/imm32) + lea rdi,[rsp] (4) + call main (5).
func nc_render_sret_head_len(s):
    return nc_imm_rsp_len(s) + 4 + 5
end

-- tail = add rsp,S (imm8/imm32) + exit_group(0) (9).
func nc_render_tuple_tail_len(s):
    return nc_imm_rsp_len(s) + 9
end

-- link12: the entry-stub render head for ANY renderable aggregate, driven by the
-- linearized plan. (For a flat int/bool tuple the plan is PUTC'(' + elems +
-- PUTC')' + PUTC'\n', reproducing the garland flat byte length exactly.)
func nc_render_agg_head_len(s, rplan):
    return nc_render_sret_head_len(s) + nc_rplan_body_len(rplan) + nc_render_tuple_tail_len(s)
end

-- rax (unsigned 64-bit) -> decimal digits, NO newline, written to fd1 via the
-- shared write helper at write_off; ends in ret. 53 bytes.
func nc_emit_render_int_noln(buf, write_off):
    do append_str(buf, "\x48\x83\xec\x20\x4c\x8d\x54\x24\x14\x4c\x89\xd6\x48\xc7\xc1\x0a")
    do append_str(buf, "\x00\x00\x00\x31\xd2\x48\xf7\xf1\x80\xc2\x30\x48\xff\xce\x88\x16")
    do append_str(buf, "\x48\x85\xc0\x75\xee\x4c\x89\xd2\x48\x29\xf2")
    buf = nc_emit_call_abs(buf, write_off)
    do append_str(buf, "\x48\x83\xc4\x20\xc3")
    return buf
end

-- rax (0/1) -> "false"/"true", NO newline, fd1 via write_off; ends in ret. 68 bytes.
func nc_emit_render_bool_noln(buf, write_off):
    do append_str(buf, "\x48\x85\xc0\x74\x1d\x48\x83\xec\x08\xc7\x04\x24\x74\x72\x75\x65")
    do append_str(buf, "\x48\x89\xe6\xba\x04\x00\x00\x00")
    buf = nc_emit_call_abs(buf, write_off)
    do append_str(buf, "\x48\x83\xc4\x08\xc3\x48\x83\xec\x08\xc7\x04\x24\x66\x61\x6c\x73")
    do append_str(buf, "\xc6\x44\x24\x04\x65\x48\x89\xe6\xba\x05\x00\x00\x00")
    buf = nc_emit_call_abs(buf, write_off)
    do append_str(buf, "\x48\x83\xc4\x08\xc3")
    return buf
end

-- write a single literal byte `ch` to fd1 via the staging slot [rsp+stage]
-- (rsp = scratch base, unchanged), calling the write helper. 20 bytes.
func nc_emit_render_putc(buf, ch, stage, write_off):
    do append_str(buf, "\xc6\x44\x24")
    do append(buf, stage)
    do append(buf, ch)
    do append_str(buf, "\x48\x8d\x74\x24")
    do append(buf, stage)
    do append_str(buf, "\xba\x01\x00\x00\x00")
    buf = nc_emit_call_abs(buf, write_off)
    return buf
end

-- write ", " (comma, space) via the staging slot. 22 bytes.
func nc_emit_render_putsep(buf, stage, write_off):
    do append_str(buf, "\x66\xc7\x44\x24")
    do append(buf, stage)
    do append_str(buf, "\x2c\x20\x48\x8d\x74\x24")
    do append(buf, stage)
    do append_str(buf, "\xba\x02\x00\x00\x00")
    buf = nc_emit_call_abs(buf, write_off)
    return buf
end

-- load result word k (at [rsp+8k]) into rax, then call the int/bool renderer. 10 bytes.
-- link12: render an int/bool result word: mov rax,[rsp+8w]; call target. 10 bytes.
-- Indexed by the plan's WORD offset so mixed-width elements (strings, nested tuples)
-- address the right flattened slot.
func nc_emit_render_word_elem(buf, word, target_off):
    do append_str(buf, "\x48\x8b\x44\x24")
    do append(buf, nc_mul8(word))
    return nc_emit_call_abs(buf, target_off)
end

-- link12: render a string result word pair: mov rsi,[rsp+8w] (ptr);
-- mov rdx,[rsp+8(w+1)] (length); call str_off. 15 bytes.
func nc_emit_render_str_elem(buf, word, str_off):
    do append_str(buf, "\x48\x8b\x74\x24")
    do append(buf, nc_mul8(word))
    do append_str(buf, "\x48\x8b\x54\x24")
    do append(buf, nc_mul8(word + 1))
    return nc_emit_call_abs(buf, str_off)
end

-- link12: the string escaping helper. rsi=ptr, rdx=len -> write  "  + escaped bytes
-- +  "  to fd1 (no newline), escaping byte 10->\n, 92->\\, 34->\" else raw, byte-
-- identical to C's print_string_lit (bootstrap/value.c). Self-contained subroutine
-- (saves r12/r13/rbx; r12 = start of the pending run, r13 = scan pointer, rbx =
-- end). K4: written in runs, one write per run of plain bytes and one per escape
-- through the shared write helper (an empty run makes no syscall), so 100,000
-- plain bytes take 3 writes with the quotes where they took 100,002. 148 bytes:
-- 0 push r12/r13/rbx, set r12/r13/rbx; 15 write the opening quote; 37 loop: done
-- at end; next byte, advance; 64 escape: stage it, flush the run, write the two
-- bytes, the next run starts after it; 106 close: flush the run, closing quote.
func nc_emit_render_str_noln(buf, write_off):
    do append_str(buf, "\x41\x54\x41\x55\x53\x49\x89\xf4\x49\x89\xf5\x48\x8d\x1c\x16")
    -- 15: sub rsp,16; mov byte [rsp],34; lea rsi,[rsp]; mov edx,1; call write
    do append_str(buf, "\x48\x83\xec\x10\xc6\x04\x24\x22\x48\x8d\x34\x24\xba\x01\x00\x00")
    do append_str(buf, "\x00")
    buf = nc_emit_call_abs(buf, write_off)
    -- 37 loop: cmp r13,rbx; jae close (106); movzx eax,byte [r13]; inc r13
    do append_str(buf, "\x49\x39\xdd\x73\x40\x41\x0f\xb6\x45\x00\x49\xff\xc5")
    -- 50: cmp al,92; je 64; cmp al,34; je 64; cmp al,10; jne loop (37); mov al,110
    do append_str(buf, "\x3c\x5c\x74\x0a\x3c\x22\x74\x06\x3c\x0a\x75\xe7\xb0\x6e")
    -- 64 escape: mov byte [rsp],92; mov [rsp+1],al; flush the run: rsi=r12, rdx=r13-1-r12
    do append_str(buf, "\xc6\x04\x24\x5c\x88\x44\x24\x01\x4c\x89\xe6\x49\x8d\x55\xff\x4c")
    do append_str(buf, "\x29\xe2")
    buf = nc_emit_call_abs(buf, write_off)
    -- 87: lea rsi,[rsp]; mov edx,2; call write
    do append_str(buf, "\x48\x8d\x34\x24\xba\x02\x00\x00\x00")
    buf = nc_emit_call_abs(buf, write_off)
    -- 101: mov r12,r13; jmp loop (37)
    do append_str(buf, "\x4d\x89\xec\xeb\xbb")
    -- 106 close: rsi=r12, rdx=rbx-r12; call write
    do append_str(buf, "\x4c\x89\xe6\x48\x89\xda\x4c\x29\xe2")
    buf = nc_emit_call_abs(buf, write_off)
    -- 120: mov byte [rsp],34; lea rsi,[rsp]; mov edx,1; call write
    do append_str(buf, "\xc6\x04\x24\x22\x48\x8d\x34\x24\xba\x01\x00\x00\x00")
    buf = nc_emit_call_abs(buf, write_off)
    -- 138: add rsp,16; pop rbx; pop r13; pop r12; ret
    do append_str(buf, "\x48\x83\xc4\x10\x5b\x41\x5d\x41\x5c\xc3")
    return buf
end

-- link12: emit the render-plan body (the inline render in the entry stub). Walks the
-- SAME flat token list the length pass sums, so the two cannot drift.
func nc_emit_rplan(buf, rplan, i, n, stage, int_off, bool_off, str_off, write_off):
    while i < n:
        let tok = get(rplan, i)
        if tok.0 == 0:
            buf = nc_emit_render_putc(buf, tok.1, stage, write_off)
        end
        if tok.0 == 1:
            buf = nc_emit_render_putsep(buf, stage, write_off)
        end
        if tok.0 == 2:
            buf = nc_emit_render_word_elem(buf, tok.1, int_off)
        end
        if tok.0 == 3:
            buf = nc_emit_render_word_elem(buf, tok.1, bool_off)
        end
        if tok.0 == 4:
            buf = nc_emit_render_str_elem(buf, tok.1, str_off)
        end
        i = i + 1
    end
    return buf
end

func nc_emit_fault_exit1(buf):
    do append_str(buf, "\xb8\xe7\x00\x00\x00\xbf\x01\x00\x00\x00\x0f\x05")
    return buf
end

func nc_emit_fault_helpers(buf, ro_base, helper_start):
    let write_off = helper_start + nc_fault_write_fd2_rel()
    let dec_off = helper_start + nc_fault_dec_fd2_rel()
    let exit_off = helper_start + nc_fault_exit1_rel()
    buf = nc_emit_diag_index(buf, ro_base, write_off, dec_off, exit_off)
    buf = nc_emit_diag_get(buf, ro_base, write_off, dec_off, exit_off)
    buf = nc_emit_diag_append(buf, ro_base, write_off, dec_off, exit_off)
    buf = nc_emit_diag_div(buf, ro_base, write_off, dec_off, exit_off)
    buf = nc_emit_diag_oom(buf, ro_base, write_off, exit_off)
    buf = nc_emit_diag_reserve(buf, ro_base, write_off, exit_off)
    buf = nc_emit_diag_write(buf, ro_base, write_off, dec_off, exit_off)
    buf = nc_emit_write_fd2(buf)
    buf = nc_emit_dec_fd2(buf, write_off)
    return nc_emit_fault_exit1(buf)
end

-- diag_set, right after the block above, only in a program that stores with
-- set (has_faultable 2); it uses the block's write, decimal and exit helpers.
func nc_emit_set_fault_helper(buf, ro_base, helper_start, has_faultable):
    if has_faultable != 2:
        return buf
    end
    return nc_emit_diag_set(buf, ro_base, helper_start + nc_fault_write_fd2_rel(), helper_start + nc_fault_dec_fd2_rel(), helper_start + nc_fault_exit1_rel())
end

func nc_emit_rdi_store_rax(buf, mag):
    do append_str(buf, "\x48\x89")
    if mag == 0:
        do append(buf, 7)
        return buf
    end
    if mag <= 127:
        do append(buf, 71)
        do append(buf, mag)
        return buf
    end
    do append(buf, 135)
    return nc_append_le32(buf, mag)
end

func nc_emit_arg_copies_loop(buf, k, nwords):
    while k < nwords:
        let src_mag = 16 + nc_mul8(nwords - 1 - k)
        let dst_mag = nc_local_mag(k)
        buf = nc_emit_disp_rbp_load_rax(buf, 0, src_mag)
        buf = nc_emit_disp_rbp_store_rax(buf, 1, dst_mag)
        k = k + 1
    end
    return buf
end

func nc_emit_sret_save(buf, meta):
    if meta.sret_word == 0 - 1:
        return buf
    end
    return nc_emit_disp_rbp_store_rdi(buf, 1, nc_local_mag(meta.sret_word))
end

func nc_emit_push_int(buf, n):
    do append_str(buf, "\x48\xb8")
    buf = nc_append_le64(buf, n)
    do append(buf, 80)
    return buf
end

func nc_emit_push_bool(buf, n):
    do append(buf, 106)
    do append(buf, n)
    return buf
end

func nc_string_offset_loop(strings, i, target, acc):
    while i < target:
        let next_i = i + 1
        let next_acc = acc + length(get(strings, i))
        i = next_i
        acc = next_acc
    end
    return acc
end

func nc_string_offset(strings, idx):
    return nc_string_offset_loop(strings, 0, idx, 0)
end

func nc_rodata_len_loop(strings, i, n, acc):
    while i < n:
        let next_i = i + 1
        let next_acc = acc + length(get(strings, i))
        i = next_i
        acc = next_acc
    end
    return acc
end

func nc_rodata_len(strings):
    return nc_rodata_len_loop(strings, 0, count(strings), 0)
end

func nc_emit_push_str(buf, strings, idx, instr_off, code_len):
    let s = get(strings, idx)
    let lit_off = code_len + nc_string_offset(strings, idx)
    do append_str(buf, "\x48\x8d\x35")
    buf = nc_append_rel32(buf, lit_off, instr_off + 7)
    do append_str(buf, "\x56\x48\xc7\xc0")
    buf = nc_append_le32(buf, length(s))
    do append(buf, 80)
    return buf
end

func nc_emit_load_local_loop(buf, base, j, width):
    while j < width:
        buf = nc_emit_disp_rbp_load_rax(buf, 1, nc_local_mag(base + j))
        do append(buf, 80)
        j = j + 1
    end
    return buf
end

func nc_emit_load_local(buf, base, width):
    return nc_emit_load_local_loop(buf, base, 0, width)
end

func nc_emit_store_local_loop(buf, base, j):
    while j != 0 - 1:
        do append(buf, 88)
        buf = nc_emit_disp_rbp_store_rax(buf, 1, nc_local_mag(base + j))
        j = j - 1
    end
    return buf
end

func nc_emit_store_local(buf, base, width):
    return nc_emit_store_local_loop(buf, base, width - 1)
end

func nc_emit_add(buf):
    do append_str(buf, "\x59\x58\x48\x01\xc8\x50")
    return buf
end

func nc_emit_sub(buf):
    do append_str(buf, "\x59\x58\x48\x29\xc8\x50")
    return buf
end

func nc_emit_cmp_setcc(buf, setcc_byte):
    do append_str(buf, "\x59\x58\x48\x39\xc8\x0f")
    do append(buf, setcc_byte)
    do append_str(buf, "\xc2\x48\x0f\xb6\xc2\x50")
    return buf
end

func nc_emit_not(buf):
    do append_str(buf, "\x58\x48\x85\xc0\x0f\x94\xc0\x48\x0f\xb6\xc0\x50")
    return buf
end

-- Bitwise / shift emitters. The stack convention pops the right operand into
-- rcx (0x59) and the left into rax (0x58), computes lhs OP rhs into rax, then
-- pushes rax (0x50). Each is 6 bytes (matching the add/sub layout arm); bnot is
-- 5. For shifts the count is already in rcx (so cl), and `shl/shr rax,cl` reads
-- the count from cl, which x86 masks to 6 bits for 64-bit operands -- exactly
-- the `& 63` the C oracle and the meta-circular VM use.
func nc_emit_band(buf):
    do append_str(buf, "\x59\x58\x48\x21\xc8\x50")
    return buf
end

func nc_emit_bor(buf):
    do append_str(buf, "\x59\x58\x48\x09\xc8\x50")
    return buf
end

func nc_emit_bxor(buf):
    do append_str(buf, "\x59\x58\x48\x31\xc8\x50")
    return buf
end

func nc_emit_shl(buf):
    do append_str(buf, "\x59\x58\x48\xd3\xe0\x50")
    return buf
end

func nc_emit_shr(buf):
    do append_str(buf, "\x59\x58\x48\xd3\xe8\x50")
    return buf
end

func nc_emit_bnot(buf):
    do append_str(buf, "\x58\x48\xf7\xd0\x50")
    return buf
end

-- Multiply: pop rhs->rcx (0x59), pop lhs->rax (0x58), imul rax,rcx
-- (48 0F AF C1), push rax (0x50). imul keeps the low 64 bits, which is the
-- u64 modular-wrap product (identical for signed/unsigned). 7 bytes; must equal
-- nc_group_single_len(42).
func nc_emit_mul(buf):
    do append_str(buf, "\x59\x58\x48\x0f\xaf\xc1\x50")
    return buf
end

-- Divide / modulo. mov r10d,line (41 BA imm32) first, so the pinned bytes
-- below stay contiguous; then pop rhs(divisor)->rcx (0x59), pop lhs(dividend)
-- ->rax (0x58). Guard divide-by-zero BEFORE `div`: test rcx,rcx (48 85 C9); jz
-- diag_div (0F 84 rel32), the fault block's located helper, which prints
-- `herbert: line N: division by zero` (the C oracle's text) and exits 1; stdout
-- keeps what was written before. r10 is scratch at an op boundary. Then xor
-- rdx,rdx (48 31 D2) zero-extends the dividend, div rcx (48 F7 F1) gives the
-- unsigned 64-bit quotient in rax / remainder in rdx; push rax (0x50) for `/`,
-- push rdx (0x52) for `%`. 24 bytes; must equal nc_group_single_len(43/44). The
-- jz rel32 base is instr_off + 17 (the byte after the rel32 field: 6 mov + 1+1+3
-- + 2 jz opcode + 4 rel32).
func nc_emit_div_or_mod(buf, is_mod, line, diag_off, instr_off):
    do append_str(buf, "\x41\xba")
    buf = nc_append_le32(buf, line)
    do append_str(buf, "\x59\x58\x48\x85\xc9\x0f\x84")
    buf = nc_append_rel32(buf, diag_off, instr_off + 17)
    do append_str(buf, "\x48\x31\xd2\x48\xf7\xf1")
    if is_mod != 0:
        do append(buf, 82)
    else:
        do append(buf, 80)
    end
    return buf
end

func nc_emit_length(buf):
    do append_str(buf, "\x58\x5e\x50")
    return buf
end

func nc_emit_index(buf, line, diag_index_off, instr_off):
    do append_str(buf, "\x59\x5a\x5e\x48\x39\xd1\x72")
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_index_off, instr_off + 20)
    do append_str(buf, "\x4c\x0f\xb6\x04\x0e\x41\x50")
    return buf
end

-- slice(s, from, to): a cut that shares s's bytes, copying nothing. It checks
-- to against the length, then from against to, and faults through diag_index
-- (P in rcx, L in rdx, the line in r10), so a bad to names the length and a
-- bad from names to. 52 bytes (nc_group_single_len(24)):
--   pop rcx (to); pop rdx (from); pop rax (length); pop rsi (address)
--   cmp rcx, rax; jbe +15; mov rdx, rax; route    (to past the end)
--   cmp rdx, rcx; jbe +15; xchg rcx, rdx; route   (from past to)
--   add rsi, rdx; push rsi; sub rcx, rdx; push rcx
func nc_emit_slice(buf, line, diag_index_off, instr_off):
    do append_str(buf, "\x59\x5a\x58\x5e\x48\x39\xc1\x76")
    do append(buf, nc_fault_route_len() + 3)
    do append_str(buf, "\x48\x89\xc2")
    buf = nc_emit_fault_route(buf, line, diag_index_off, instr_off + 24)
    do append_str(buf, "\x48\x39\xca\x76")
    do append(buf, nc_fault_route_len() + 3)
    do append_str(buf, "\x48\x87\xd1")
    buf = nc_emit_fault_route(buf, line, diag_index_off, instr_off + 44)
    do append_str(buf, "\x48\x01\xd6\x56\x48\x29\xd1\x51")
    return buf
end

func nc_emit_equal(buf):
    do append_str(buf, "\x5a\x5f\x59\x5e\x48\x39\xd1\x75\x25\x4d\x31\xc0\x49\x39\xc8\x73")
    do append_str(buf, "\x14\x4e\x0f\xb6\x0c\x06\x4e\x0f\xb6\x14\x07\x4d\x39\xd1\x75\x0e")
    do append_str(buf, "\x49\xff\xc0\xeb\xe7\x48\xc7\xc0\x01\x00\x00\x00\xeb\x03\x48\x31")
    do append_str(buf, "\xc0\x50")
    return buf
end

func nc_emit_br(buf, target, base):
    do append(buf, 233)
    return nc_append_rel32(buf, target, base)
end

func nc_emit_br_if_false(buf, target, base):
    do append_str(buf, "\x58\x48\x85\xc0\x0f\x84")
    return nc_append_rel32(buf, target, base)
end

func nc_emit_br_and(buf, target, base):
    do append_str(buf, "\x48\x8b\x04\x24\x48\x85\xc0\x0f\x84")
    buf = nc_append_rel32(buf, target, base)
    do append_str(buf, "\x48\x83\xc4\x08")
    return buf
end

func nc_emit_br_or(buf, target, base):
    do append_str(buf, "\x48\x8b\x04\x24\x48\x85\xc0\x0f\x85")
    buf = nc_append_rel32(buf, target, base)
    do append_str(buf, "\x48\x83\xc4\x08")
    return buf
end

func nc_emit_cleanup(buf, words):
    let cleanup = nc_mul8(words)
    if cleanup <= 127:
        do append_str(buf, "\x48\x83\xc4")
        do append(buf, cleanup)
    else:
        do append_str(buf, "\x48\x81\xc4")
        buf = nc_append_le32(buf, cleanup)
    end
    return buf
end

func nc_emit_call_rel(buf, target, base):
    do append(buf, 232)
    return nc_append_rel32(buf, target, base)
end

func nc_emit_call_ret_words(buf, base_word, ret_width, k, n):
    while k < n:
        buf = nc_emit_disp_rbp_load_rax(buf, 1, nc_sret_scratch_mag(base_word, ret_width, k))
        do append(buf, 80)
        k = k + 1
    end
    return buf
end

func nc_emit_normal_call(buf, target, base, meta, cm):
    if cm.2 == 1:
        buf = nc_emit_disp_rbp_lea_rdi(buf, 1, nc_sret_scratch_mag(meta.scratch_base, cm.1, 0))
        buf = nc_emit_call_rel(buf, target, base)
        buf = nc_emit_cleanup(buf, cm.0)
        return nc_emit_call_ret_words(buf, meta.scratch_base, cm.1, 0, cm.1)
    end
    buf = nc_emit_call_rel(buf, target, base)
    buf = nc_emit_cleanup(buf, cm.0)
    do append(buf, 80)
    return buf
end

func nc_emit_tail_copy_loop(buf, k, nf, ng):
    while k < nf:
        let src = nc_mul8(nf - 1 - k)
        let dst = nc_tail_dst_pair(ng, k)
        buf = nc_emit_rsp_load_rax(buf, src)
        buf = nc_emit_disp_rbp_store_rax(buf, dst.0, dst.1)
        k = k + 1
    end
    return buf
end

func nc_emit_tail_call(buf, target, base, ng, nf, sret_word, aggregate):
    do append_str(buf, "\x4c\x8b\x5d\x08\x4c\x8b\x55\x00")
    buf = nc_emit_tail_copy_loop(buf, 0, nf, ng)
    let rslot = nc_rslot_pair(ng, nf)
    buf = nc_emit_disp_rbp_store_r11(buf, rslot.0, rslot.1)
    if aggregate != 0:
        buf = nc_emit_disp_rbp_load_rdi(buf, 1, nc_local_mag(sret_word))
    end
    buf = nc_emit_disp_rbp_lea_rsp(buf, rslot.0, rslot.1)
    do append_str(buf, "\x4c\x89\xd5\xe9")
    return nc_append_rel32(buf, target, base)
end

func nc_emit_tuple_get_copy_loop(buf, j, f, w, s):
    while j < f:
        let src = nc_mul8(w - 1 - (s + j))
        let dst = nc_mul8(w - 1 - j)
        buf = nc_emit_rsp_load_rax(buf, src)
        buf = nc_emit_rsp_store_rax(buf, dst)
        j = j + 1
    end
    return buf
end

func nc_emit_tuple_get(buf, meta, pc):
    let tm = get(meta.tuple_meta, pc)
    buf = nc_emit_tuple_get_copy_loop(buf, 0, tm.2, tm.0, tm.1)
    let drop = tm.0 - tm.2
    if drop > 0:
        buf = nc_emit_cleanup(buf, drop)
    end
    return buf
end

func nc_emit_ret(buf, meta):
    if meta.retw <= 1:
        do append_str(buf, "\x58\xc9\xc3")
        return buf
    end
    buf = nc_emit_disp_rbp_load_rdi(buf, 1, nc_local_mag(meta.sret_word))
    buf = nc_emit_aggregate_ret_stores(buf, meta.retw - 1)
    do append_str(buf, "\xc9\xc3")
    return buf
end

func nc_emit_aggregate_ret_stores(buf, k):
    while k != 0 - 1:
        do append(buf, 88)
        buf = nc_emit_rdi_store_rax(buf, nc_mul8(k))
        k = k - 1
    end
    return buf
end

-- clogger, 91 bytes: read stdin into the heap left (r15 - r14). Its exits:
-- a read that returns 0 or an error in the loop (+35) ends the input there and
-- returns what was read; when the heap left is exactly used, a one-byte probe
-- read (+58) that returns 0 (+67) returns the input too. A probe that returns
-- a byte (stdin larger than the heap left) jumps to the fault block's
-- out-of-memory helper (K4, ruling 17); a probe read error goes to the fault
-- block's exit1, the silent status 1 it ended with before. Those last 12 bytes
-- (+69: jg rel32, jmp rel32, int3) replace the inline exit_group(1) both shared.
func nc_emit_clogger(buf, oom_off, exit_off):
    do append_str(buf, "\x4d\x89\xf4\x4d\x31\xed\x4c\x89\xfa\x4c\x29\xe2\x4c\x29\xea\x48")
    do append_str(buf, "\x85\xd2\x74\x16\x31\xc0\x31\xff\x4c\x89\xe6\x4c\x01\xee\x0f\x05")
    do append_str(buf, "\x48\x85\xc0\x7e\x2c\x49\x01\xc5\xeb\xdc\x48\x83\xec\x08\x31\xc0")
    do append_str(buf, "\x31\xff\x48\x89\xe6\xba\x01\x00\x00\x00\x0f\x05\x48\x83\xc4\x08")
    do append_str(buf, "\x48\x85\xc0\x74\x0c")
    buf = nc_emit_jg_abs(buf, oom_off)
    buf = nc_emit_jmp_abs(buf, exit_off)
    do append_str(buf, "\xcc\x4d\x89\xe6\x4d\x01\xee\x41\x54\x41\x55")
    return buf
end

func nc_emit_flogger(buf):
    do append_str(buf, "\x5a\x5e\x48\x85\xd2\x74\x25\xb8\x01\x00\x00\x00\xbf\x01\x00\x00")
    do append_str(buf, "\x00\x0f\x05\x48\x85\xc0\x7e\x08\x48\x01\xc6\x48\x29\xc2\xeb\xe2")
    do append_str(buf, "\xb8\xe7\x00\x00\x00\xbf\x01\x00\x00\x00\x0f\x05")
    return buf
end

func nc_emit_stdin_read(buf):
    -- Checked hosted input. Preserve r12/r13/r15/rbp and all prior heap data.
    -- Return one (int, string); a failed read never exposes a partial prefix.
    -- 0: mov r8,r14; xor r9d,r9d. Original bump and uncommitted length.
    do append_str(buf, "\x4d\x89\xf0\x45\x31\xc9")
    -- loop (6): remaining = r15-r8-r9; jz probe (45). Never read count zero.
    do append_str(buf, "\x4c\x89\xfa\x4c\x29\xc2\x4c\x29\xca\x74\x1c")
    -- read(0, r8+r9, remaining). r8/r9 survive the syscall.
    do append_str(buf, "\x31\xc0\x31\xff\x4b\x8d\x34\x08\x0f\x05")
    -- Retry EINTR at loop (6); other errors -> errno (87); EOF -> success (95).
    do append_str(buf, "\x48\x83\xf8\xfc\x74\xe5\x48\x85\xc0\x78\x31\x74\x37")
    -- Accumulate positive short transfer; loop (6).
    do append_str(buf, "\x49\x01\xc1\xeb\xd9")
    -- probe (45): reserve ONE scratch word; retry (49) does not reserve again.
    do append_str(buf, "\x48\x83\xec\x08")
    -- read(0, rsp, 1); retry EINTR at (49).
    do append_str(buf, "\x31\xc0\x31\xff\x48\x89\xe6\xba\x01\x00\x00\x00\x0f\x05\x48\x83")
    do append_str(buf, "\xf8\xfc\x74\xec")
    -- Restore probe scratch before every terminal path; errno (87), EOF (95).
    do append_str(buf, "\x48\x83\xc4\x08\x48\x85\xc0\x78\x09\x74\x0f")
    -- Extra byte means overflow: positive synthetic ENOMEM; failure (90).
    do append_str(buf, "\xb8\x0c\x00\x00\x00\xeb\x03")
    -- errno (87): positive errno; failure (90): discard prefix, preserve r14.
    do append_str(buf, "\x48\xf7\xd8\x45\x31\xc9\xeb\x06")
    -- success (95): commit complete input and status zero.
    do append_str(buf, "\x4f\x8d\x34\x08\x31\xc0")
    -- result (101): status / original pointer / length. Total 106 bytes.
    do append_str(buf, "\x50\x41\x50\x41\x51")
    return buf
end

-- The operand stack contains nr,a1,a2,a3,a4,a5,a6 in that order. Linux takes
-- rax,rdi,rsi,rdx,r10,r8,r9 and destroys rcx/r11 (both caller scratch here).
-- No libc, errno conversion, allocation, EINTR retry, or descriptor policy is
-- hidden in this primitive. Higher-level Herbert code owns those decisions.
func nc_emit_linux_syscall6(buf):
    do append_str(buf, "\x41\x59\x41\x58\x41\x5a\x5a\x5e\x5f\x58\x0f\x05\x50")
    return buf
end

func nc_emit_buffer_address(buf):
    -- pop rax; mov rax,[rax+16]; push rax. The header stays private.
    do append_str(buf, "\x58\x48\x8b\x40\x10\x50")
    return buf
end

func nc_emit_buffer_get(buf, line, diag_get_off, instr_off):
    -- rcx=index, r8=header, r9=length. Reuse the located get-bounds route.
    do append_str(buf, "\x59\x41\x58\x4d\x8b\x08\x4c\x39\xc9\x72")
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 23)
    do append_str(buf, "\x4d\x8b\x50\x10")
    -- movzx eax,byte [r10+rcx]; push rax.
    do append_str(buf, "\x41\x0f\xb6\x04\x0a\x50")
    return buf
end

func nc_emit_buffer_set(buf, line, diag_get_off, diag_append_off, instr_off):
    -- Validate the value before the index, consistently with append's byte
    -- contract. Failure is located and cannot write outside the initialized span.
    do append_str(buf, "\x59\x48\x81\xf9\xff\x00\x00\x00\x76")
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_append_off, instr_off + 22)
    -- Save the validated byte in edx; then load index, header and length.
    do append_str(buf, "\x89\xca\x59\x41\x58\x4d\x8b\x08\x4c\x39\xc9\x72")
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 47)
    do append_str(buf, "\x4d\x8b\x50\x10")
    -- mov byte [r10+rcx],dl; push rdx (the written byte).
    do append_str(buf, "\x41\x88\x14\x0a\x52")
    return buf
end

-- buffer_copy(dst, at, src, from, n), op 66: n bytes from src[from..from+n)
-- to dst[at..at+n). Both spans are checked against the initialized lengths
-- before any byte moves, the destination first, as `at <= length` and
-- `n <= length - at` (no wrap); a span outside its buffer takes the located
-- get route with the first position of the span outside the buffer (at, or
-- the length) and that buffer's count. Overlap-safe: when the destination lies
-- inside the source span and above it the move runs backward. Scratch
-- registers only (rax rcx rdx rsi rdi r8 r9 r11, as linux_syscall6 clobbers).
-- No growth, no allocation; pushes n. 171 bytes (nc_group_single_len).
func nc_emit_buffer_copy(buf, line, diag_get_off, instr_off):
    -- pop rdx (n); pop rsi (from); pop r11 (src header); pop rcx (at); pop r8 (dst header).
    do append_str(buf, "\x5a\x5e\x41\x5b\x59\x41\x58")
    -- r9 = destination length; at <= r9 or fault with rcx = at, r9 = count (offset 15).
    do append_str(buf, "\x4d\x8b\x08\x4c\x39\xc9\x76\x0c")
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 27)
    -- rax = r9 - at; n <= rax or fault with rcx = the length (offset 41).
    do append_str(buf, "\x4c\x89\xc8\x48\x29\xc8\x48\x39\xc2\x76\x0f\x4c\x89\xc9")
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 53)
    -- r9 = source length; from <= r9 or fault with rcx = from (offset 64).
    do append_str(buf, "\x4d\x8b\x0b\x4c\x39\xce\x76\x0f\x48\x89\xf1")
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 76)
    -- rax = r9 - from; n <= rax or fault with rcx = the length (offset 90).
    do append_str(buf, "\x4c\x89\xc8\x48\x29\xf0\x48\x39\xc2\x76\x0f\x4c\x89\xc9")
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 102)
    -- rdi = destination data + at; rsi = source data + from; rcx = n (offset 102).
    do append_str(buf, "\x49\x8b\x78\x10\x48\x01\xcf\x49\x8b\x43\x10\x48\x01\xc6\x48\x89")
    do append_str(buf, "\xd1")
    -- rax = rdi - rsi; below n (unsigned) means the destination lies inside the source span, above it: backward (offset 119).
    do append_str(buf, "\x48\x89\xf8\x48\x29\xf0\x48\x39\xd0\x72\x04")
    -- forward: rep movsb (the direction flag is clear by the process ABI and never set); jmp done (offset 130).
    do append_str(buf, "\xf3\xa4\xeb\x24")
    -- backward, 8 bytes at a time from the end: while rcx >= 8: rcx -= 8; rax = [rsi+rcx]; [rdi+rcx] = rax (offset 134).
    do append_str(buf, "\x48\x83\xf9\x08\x72\x0e\x48\x83\xe9\x08\x48\x8b\x04\x0e\x48\x89")
    do append_str(buf, "\x04\x0f\xeb\xec")
    -- the byte tail: while rcx != 0: rcx -= 1; al = [rsi+rcx]; [rdi+rcx] = al (offset 154).
    do append_str(buf, "\x48\x85\xc9\x74\x0b\x48\xff\xc9\x8a\x04\x0e\x88\x04\x0f\xeb\xf0")
    -- done: push rdx (n, the count moved) (offset 170; 171 bytes in all).
    do append(buf, 82)
    return buf
end

-- buffer_fill(b, n, v), op 67: appends n copies of the byte v and pushes n.
-- v is checked first (the located append fault, whether or not n is zero);
-- n = 0 changes nothing. When length + n exceeds the capacity, new storage of
-- max(2 * capacity, length + n) bytes comes from the bump heap in one piece,
-- the old bytes move over with the forward string instruction and the header
-- takes the new pointer and capacity (the old storage stays, as after append);
-- a need that wraps, or storage past the heap limit, takes the heap trap as
-- append does. The new bytes are stored by rep stosb, never assumed zero.
-- Scratch registers only (rax rcx rdx rsi rdi r8 r9 r10 r11); the direction
-- flag is clear by the process ABI. 142 bytes (nc_group_single_len).
func nc_emit_buffer_fill(buf, line, diag_append_off, instr_off, oom_off):
    -- pop rcx (v); v <= 255 or fault through the located append route (base instr_off + 22).
    do append_str(buf, "\x59\x48\x81\xf9\xff\x00\x00\x00\x76\x0c")
    buf = nc_emit_fault_route(buf, line, diag_append_off, instr_off + 22)
    -- pop rdx (n); pop r8 (header); r9 = v (offset 22).
    do append_str(buf, "\x5a\x41\x58\x49\x89\xc9")
    -- r10 = length; rax = length + n, the need; a carry (a count that wraps) takes the heap trap (offset 28).
    do append_str(buf, "\x4d\x8b\x10\x4c\x89\xd0\x48\x01\xd0\x73\x0c")
    buf = nc_emit_heap_trap(buf, oom_off)
    -- r11 = capacity; room when capacity >= need: jump to offset 123 (offset 51).
    do append_str(buf, "\x4d\x8b\x58\x08\x49\x39\xc3\x73\x3f")
    -- grow: r11 = 2 * capacity, or the need when the doubling wraps or falls short of it (offset 60).
    do append_str(buf, "\x49\xd1\xe3\x72\x05\x49\x39\xc3\x73\x03\x49\x89\xc3")
    -- rdi = r11 bytes from the bump heap (rax), trapping past the limit (offset 73).
    do append_str(buf, "\x4c\x89\xdf")
    buf = nc_emit_heap_alloc(buf, oom_off)
    -- the old bytes move to the new storage: rsi = old data, rdi = new, rcx = length; rep movsb leaves rdi at new data + length (offset 101).
    do append_str(buf, "\x49\x8b\x70\x10\x48\x89\xc7\x4c\x89\xd1\xf3\xa4")
    -- the header takes the new data pointer and capacity; jump to the fill at offset 130 (offset 113).
    do append_str(buf, "\x49\x89\x40\x10\x4d\x89\x58\x08\xeb\x07")
    -- room: rdi = data + length (offset 123).
    do append_str(buf, "\x49\x8b\x78\x10\x4c\x01\xd7")
    -- fill: rcx = n, al = v, rep stosb; the length grows by n; push n (offset 130, end 142).
    do append_str(buf, "\x48\x89\xd1\x4c\x89\xc8\xf3\xaa\x49\x01\x10\x52")
    return buf
end

func nc_emit_process_exit(buf):
    -- 10 bytes: pop rdi; mov eax,231; syscall; ud2. Linux exit_group
    -- supplies the low eight status bits to the parent. Never fall through
    -- to main's renderer, even if the syscall unexpectedly returns.
    do append_str(buf, "\x5f\xb8\xe7\x00\x00\x00\x0f\x05\x0f\x0b")
    return buf
end

func nc_emit_stderr_write(buf):
    -- 55 bytes. Pop len/ptr into rdx/rsi; push one int result. No heap,
    -- frame, or callee-saved register changes. Empty input succeeds without
    -- a syscall. Retry EINTR; advance after real partial writes. Other raw
    -- negative syscall results become positive errno; zero progress is EIO.
    -- SIGPIPE remains inherited: a broken pipe may terminate the process.
    do append_str(buf, "\x5a\x5e")
    -- loop (2): test rdx,rdx; jz success (52)
    do append_str(buf, "\x48\x85\xd2\x74\x2d")
    -- mov eax,1; mov edi,2; syscall
    do append_str(buf, "\xb8\x01\x00\x00\x00\xbf\x02\x00\x00\x00\x0f\x05")
    -- cmp rax,-4; je loop (2)
    do append_str(buf, "\x48\x83\xf8\xfc\x74\xe9")
    -- test rax,rax; js errno (40); jz zero (45)
    do append_str(buf, "\x48\x85\xc0\x78\x0a\x74\x0d")
    -- add rsi,rax; sub rdx,rax; jmp loop (2)
    do append_str(buf, "\x48\x01\xc6\x48\x29\xc2\xeb\xda")
    -- errno (40): neg rax; jmp done (54)
    do append_str(buf, "\x48\xf7\xd8\xeb\x09")
    -- zero (45): mov eax,5; jmp done (54)
    do append_str(buf, "\xb8\x05\x00\x00\x00\xeb\x02")
    -- success (52): xor eax,eax; done (54): push rax
    do append_str(buf, "\x31\xc0\x50")
    return buf
end

func nc_emit_fwriter(buf):
    -- Atomic Linux publication of a.out. Its instruction-level reference, an
    -- assembly listing, is in git at the tag python-checks-2026-11-25.
    -- Open the directory, create an unpredictable exclusive temporary, write
    -- all bytes, fsync, check close without retry, then renameat. Errors before
    -- rename preserve a.out and clean our temporary; successful concurrent
    -- writers publish complete last-writer-wins images. Replaces symlinks,
    -- never follows their targets. No directory crash-durability guarantee.
    -- Preserve rbx/r12..r15 and the caller stack. getrandom fails closed.
    do append_str(buf, "\x41\x58\x41\x59\x53\x41\x54\x41\x55\x41\x56\x41\x57\x48\x83\xec")
    do append_str(buf, "\x60\x4d\x89\xce\x4d\x89\xc7\x49\xc7\xc4\xff\xff\xff\xff\x49\xc7")
    do append_str(buf, "\xc5\xff\xff\xff\xff\x31\xdb\x48\xb8\x2e\x68\x65\x72\x62\x65\x72")
    do append_str(buf, "\x74\x48\x89\x04\x24\xc7\x44\x24\x18\x2e\x74\x6d\x70\xc6\x44\x24")
    do append_str(buf, "\x1c\x00\x48\xb8\x61\x2e\x6f\x75\x74\x00\x00\x00\x48\x89\x44\x24")
    do append_str(buf, "\x28\x66\xc7\x44\x24\x30\x2e\x00\x48\xc7\x44\x24\x48\x80\x00\x00")
    do append_str(buf, "\x00\xb8\x01\x01\x00\x00\xbf\x9c\xff\xff\xff\x48\x8d\x74\x24\x30")
    do append_str(buf, "\xba\x00\x00\x09\x00\x45\x31\xd2\x0f\x05\x48\x83\xf8\xfc\x74\xe1")
    do append_str(buf, "\x48\x85\xc0\x0f\x88\x34\x01\x00\x00\x49\x89\xc4\x48\xff\x4c\x24")
    do append_str(buf, "\x48\x0f\x88\x26\x01\x00\x00\x48\x8d\x7c\x24\x50\xbe\x08\x00\x00")
    do append_str(buf, "\x00\xb8\x3e\x01\x00\x00\x31\xd2\x0f\x05\x48\x83\xf8\xfc\x74\xf1")
    do append_str(buf, "\x48\x85\xc0\x0f\x8e\x04\x01\x00\x00\x48\x39\xf0\x0f\x87\xfb\x00")
    do append_str(buf, "\x00\x00\x48\x01\xc7\x48\x29\xc6\x75\xd7\x48\x8b\x44\x24\x50\xb9")
    do append_str(buf, "\x10\x00\x00\x00\x89\xc2\x83\xe2\x0f\x83\xc2\x30\x83\xfa\x39\x76")
    do append_str(buf, "\x03\x83\xc2\x27\x88\x54\x0c\x07\x48\xc1\xe8\x04\xff\xc9\x75\xe4")
    do append_str(buf, "\xb8\x01\x01\x00\x00\x4c\x89\xe7\x48\x89\xe6\xba\xc1\x00\x0a\x00")
    do append_str(buf, "\x41\xba\xa4\x01\x00\x00\x0f\x05\x48\x83\xf8\xfc\x74\xe2\x48\x83")
    do append_str(buf, "\xf8\xef\x0f\x84\x74\xff\xff\xff\x48\x85\xc0\x0f\x88\x9c\x00\x00")
    do append_str(buf, "\x00\x49\x89\xc5\xbb\x01\x00\x00\x00\x4d\x85\xff\x74\x28\xb8\x01")
    do append_str(buf, "\x00\x00\x00\x4c\x89\xef\x4c\x89\xf6\x4c\x89\xfa\x0f\x05\x48\x83")
    do append_str(buf, "\xf8\xfc\x74\xe5\x48\x85\xc0\x7e\x74\x4c\x39\xf8\x77\x6f\x49\x01")
    do append_str(buf, "\xc6\x49\x29\xc7\xeb\xd3\xb8\x4a\x00\x00\x00\x4c\x89\xef\x0f\x05")
    do append_str(buf, "\x48\x83\xf8\xfc\x74\xf0\x48\x85\xc0\x75\x52\xb8\x03\x00\x00\x00")
    do append_str(buf, "\x4c\x89\xef\x49\xc7\xc5\xff\xff\xff\xff\x0f\x05\x48\x85\xc0\x75")
    do append_str(buf, "\x3c\xb8\x08\x01\x00\x00\x4c\x89\xe7\x48\x89\xe6\x4c\x89\xe2\x4c")
    do append_str(buf, "\x8d\x54\x24\x28\x0f\x05\x48\x83\xf8\xfc\x74\xe5\x48\x85\xc0\x75")
    do append_str(buf, "\x1c\xb8\x03\x00\x00\x00\x4c\x89\xe7\x0f\x05\x48\x83\xc4\x60\x41")
    do append_str(buf, "\x5f\x41\x5e\x41\x5d\x41\x5c\x5b\xe9\x94\x00\x00\x00\x4d\x85\xed")
    do append_str(buf, "\x78\x0a\xb8\x03\x00\x00\x00\x4c\x89\xef\x0f\x05\x85\xdb\x74\x15")
    do append_str(buf, "\xb8\x07\x01\x00\x00\x4c\x89\xe7\x48\x89\xe6\x31\xd2\x0f\x05\x48")
    do append_str(buf, "\x83\xf8\xfc\x74\xeb\x4d\x85\xe4\x78\x0a\xb8\x03\x00\x00\x00\x4c")
    do append_str(buf, "\x89\xe7\x0f\x05\x48\x8d\x35\x32\x00\x00\x00\xba\x24\x00\x00\x00")
    do append_str(buf, "\xb8\x01\x00\x00\x00\xbf\x02\x00\x00\x00\x0f\x05\x48\x83\xf8\xfc")
    do append_str(buf, "\x74\xee\x48\x85\xc0\x7e\x08\x48\x01\xc6\x48\x29\xc2\x75\xe1\xb8")
    do append_str(buf, "\xe7\x00\x00\x00\xbf\x01\x00\x00\x00\x0f\x05\x0f\x0b")
    do append_str(buf, "compiler: output publication failed\n")
    return buf
end

func nc_emit_new_heap_header(buf, backing_size, oom_off):
    do append_str(buf, "\xbf\x18\x00\x00\x00")
    buf = nc_emit_heap_alloc(buf, oom_off)
    do append_str(buf, "\x49\x89\xc0\x49\xc7\x00\x00\x00\x00\x00\x49\xc7\x40\x08\x02\x00")
    do append_str(buf, "\x00\x00\xbf")
    buf = nc_append_le32(buf, backing_size)
    buf = nc_emit_heap_alloc(buf, oom_off)
    do append_str(buf, "\x49\x89\x40\x10\x41\x50")
    return buf
end

func nc_emit_new_buffer(buf, oom_off):
    return nc_emit_new_heap_header(buf, 2, oom_off)
end

func nc_emit_new_array(buf, width, oom_off):
    return nc_emit_new_heap_header(buf, nc_mul8(width + width), oom_off)
end

func nc_emit_count(buf):
    do append_str(buf, "\x58\x48\x8b\x00\x50")
    return buf
end

func nc_emit_get_loads(buf, width, j):
    while j < width:
        buf = nc_emit_rsi_load_rax(buf, nc_mul8(j))
        do append(buf, 80)
        j = j + 1
    end
    return buf
end

func nc_emit_get(buf, width, line, diag_get_off, instr_off, oom_off):
    do append_str(buf, "\x59\x41\x58\x4d\x8b\x08\x4c\x39\xc9\x72")
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 23)
    do append_str(buf, "\x4d\x8b\x50\x10")
    if width == 1:
        do append_str(buf, "\x49\x8b\x04\xca\x50")
        return buf
    end
    do append_str(buf, "\x48\x69\xf1")
    buf = nc_append_le32(buf, nc_mul8(width))
    do append_str(buf, "\x71\x0c")
    buf = nc_emit_heap_trap(buf, oom_off)
    do append_str(buf, "\x4c\x01\xd6")
    return nc_emit_get_loads(buf, width, 0)
end

-- ARR_SET (op 68), `do set(a, i, v)`: [array, position, w value words] ->
-- nothing. get's bounds check, then the words stored over entry i in place:
--   mov rcx, [rsp + 8w] (position); mov r8, [rsp + 8w + 8] (array header);
--   mov r9, [r8]; cmp rcx, r9; jb +12; mov r10, line; jmp diag_set;
--   mov r10, [r8 + 16]; then for w = 1: pop rax; mov [r10 + rcx*8], rax;
--   else imul rsi, rcx, 8w; jno +12; heap trap; add rsi, r10 and
--   (pop rax; mov [rsi + 8k], rax) for k = w-1..0, as add stores; add rsp, 16.
-- No growth, no allocation: aliases see the change. nc_arr_set_len is its length.
func nc_emit_rsp_load_rcx(buf, mag):
    do append_str(buf, "\x48\x8b")
    if mag <= 127:
        do append_str(buf, "\x4c\x24")
        do append(buf, mag)
        return buf
    end
    do append_str(buf, "\x8c\x24")
    return nc_append_le32(buf, mag)
end

func nc_emit_arr_set(buf, width, line, diag_set_off, instr_off, oom_off):
    let mag = nc_mul8(width)
    buf = nc_emit_rsp_load_rcx(buf, mag)
    buf = nc_emit_rsp_load_r8(buf, mag + 8)
    do append_str(buf, "\x4d\x8b\x08\x4c\x39\xc9\x72")
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_set_off, instr_off + nc_disp_len_rsp(mag) + nc_disp_len_rsp_r8(mag + 8) + 8 + nc_fault_route_len())
    do append_str(buf, "\x4d\x8b\x50\x10")
    if width == 1:
        do append_str(buf, "\x58\x49\x89\x04\xca")
    else:
        do append_str(buf, "\x48\x69\xf1")
        buf = nc_append_le32(buf, mag)
        do append_str(buf, "\x71\x0c")
        buf = nc_emit_heap_trap(buf, oom_off)
        do append_str(buf, "\x4c\x01\xd6")
        buf = nc_emit_arr_add_stores(buf, width - 1)
    end
    do append_str(buf, "\x48\x83\xc4\x10")
    return buf
end

func nc_arr_set_len(width):
    let mag = nc_mul8(width)
    let head = nc_disp_len_rsp(mag) + nc_disp_len_rsp_r8(mag + 8) + 8 + nc_fault_route_len() + 4
    if width == 1:
        return head + 5 + 4
    end
    return head + 24 + nc_arr_add_store_len(width, width - 1, 0) + 4
end

func nc_emit_arr_add_stores(buf, k):
    while k != 0 - 1:
        do append(buf, 88)
        buf = nc_emit_rsi_store_rax(buf, nc_mul8(k))
        k = k - 1
    end
    return buf
end

func nc_emit_arr_add(buf, width, oom_off):
    return nc_emit_arr_add_any(buf, width, 0, oom_off)
end

-- ADD_KEEP (op 63) builds a ref record: add, leaving the array on the stack.
func nc_emit_arr_add_keep(buf, width, oom_off):
    return nc_emit_arr_add_any(buf, width, 1, oom_off)
end

func nc_emit_arr_add_any(buf, width, keep, oom_off):
    buf = nc_emit_rsp_load_r8(buf, nc_mul8(width))
    do append_str(buf, "\x4d\x8b\x08\x4d\x8b\x50\x08\x4d\x39\xd1\x0f\x85")
    buf = nc_append_le32(buf, 126)
    do append_str(buf, "\x4d\x89\xd3\x49\xd1\xe3\x73\x0c")
    buf = nc_emit_heap_trap(buf, oom_off)
    do append_str(buf, "\x4c\x89\xdf\x49\x69\xfb")
    buf = nc_append_le32(buf, nc_mul8(width))
    do append_str(buf, "\x71\x0c")
    buf = nc_emit_heap_trap(buf, oom_off)
    buf = nc_emit_heap_alloc(buf, oom_off)
    do append_str(buf, "\x49\x8b\x50\x10\x4c\x89\xcf\x48\x69\xff")
    buf = nc_append_le32(buf, width)
    do append_str(buf, "\x71\x0c")
    buf = nc_emit_heap_trap(buf, oom_off)
    do append_str(buf, "\x48\x31\xc9\x48\x39\xf9\x73\x0d\x48\x8b\x34\xca\x48\x89\x34\xc8")
    do append_str(buf, "\x48\xff\xc1\xeb\xee\x49\x89\x40\x10\x4d\x89\x58\x08\x49\x69\xf1")
    buf = nc_append_le32(buf, nc_mul8(width))
    do append_str(buf, "\x71\x0c")
    buf = nc_emit_heap_trap(buf, oom_off)
    do append_str(buf, "\x49\x03\x70\x10")
    buf = nc_emit_arr_add_stores(buf, width - 1)
    if keep == 0:
        do append_str(buf, "\x48\x83\xc4\x08")
    end
    do append_str(buf, "\x49\xff\xc1\x4d\x89\x08")
    return buf
end

func nc_emit_buf_append(buf, line, diag_append_off, instr_off, oom_off):
    do append_str(buf, "\x59\x48\x81\xf9\xff\x00\x00\x00\x76")
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_append_off, instr_off + 22)
    do append_str(buf, "\x41\x58\x4d\x8b\x08\x4d\x8b\x50\x08\x4d\x39\xd1\x0f\x85")
    buf = nc_append_le32(buf, 81)
    do append_str(buf, "\x4d\x89\xd3\x49\xd1\xe3\x73\x0c")
    buf = nc_emit_heap_trap(buf, oom_off)
    do append_str(buf, "\x4c\x89\xdf")
    buf = nc_emit_heap_alloc(buf, oom_off)
    do append_str(buf, "\x49\x8b\x50\x10\x48\x31\xf6\x4c\x39\xce\x73\x0d\x40\x8a\x3c\x32")
    do append_str(buf, "\x40\x88\x3c\x30\x48\xff\xc6\xeb\xee\x49\x89\x40\x10\x4d\x89\x58")
    do append_str(buf, "\x08\x49\x8b\x50\x10\x42\x88\x0c\x0a\x49\xff\xc1\x4d\x89\x08")
    return buf
end

func nc_emit_freeze(buf, oom_off):
    do append_str(buf, "\x41\x58\x4d\x8b\x08\x4d\x8b\x50\x10\x4c\x89\xcf\x48\x85\xff\x75")
    do append_str(buf, "\x05\xbf\x01\x00\x00\x00")
    buf = nc_emit_heap_alloc(buf, oom_off)
    do append_str(buf, "\x49\x89\xc3\x48\x31\xc9\x4c\x39\xc9\x73\x0d\x41\x8a\x3c\x0a\x41")
    do append_str(buf, "\x88\x3c\x0b\x48\xff\xc1\xeb\xee\x41\x53\x41\x51")
    return buf
end

-- mmap(NULL, 3.5 GiB, RW, PRIVATE|ANON); on failure (K4) jmp to the fault
-- block's "cannot reserve" helper (reserve_off), else r14 = base, r15 = end.
-- 70 bytes.
func nc_emit_heap_stub(buf, reserve_off):
    do append_str(buf, "\x48\xc7\xc0\x09\x00\x00\x00\x48\x31\xff\xbe\x00\x00\x00\xe0\x48")
    do append_str(buf, "\xc7\xc2\x03\x00\x00\x00\x49\xc7\xc2\x22\x00\x00\x00\x49\xc7\xc0")
    do append_str(buf, "\xff\xff\xff\xff\x4d\x31\xc9\x0f\x05\x48\x85\xc0\x79\x0c")
    buf = nc_emit_fault_jmp12(buf, reserve_off)
    do append_str(buf, "\x49\x89\xc6\x41\xbf\x00\x00\x00\xe0\x49\x01\xc7")
    return buf
end

func nc_emit_entry_check(start_len, buf, want, label):
    let got = buffer_length(buf) - start_len
    if got != want:
        return nc_fail(418, 0, label)
    end
    return 0
end

func nc_emit_entry_stub(buf, main_entry, has_clogger, has_heap, has_faultable, main_ret, code_len, strings, rplan):
    let layout = nc_entry_layout(has_heap, has_faultable, main_ret, rplan)
    let start_len = buffer_length(buf)
    -- The heap stub, the heap traps and main's result write all jump into the
    -- fault block (K4), so a hosted program is never emitted without it.
    if has_faultable == 0:
        return (nc_fail(418, 0, "entry-fault-block"), buf)
    end
    let write_fail_off = layout.4 + nc_fault_diag_write_rel()
    if has_heap != 0:
        buf = nc_emit_heap_stub(buf, layout.4 + nc_fault_diag_reserve_rel())
    end
    let ck = nc_emit_entry_check(start_len, buf, layout.0, "entry-heap")
    if ck != 0:
        return (ck, buf)
    end
    if count(rplan) > 0:
        -- link11/link12: aggregate-returning main. The entry head sets up the sret
        -- scratch, calls main, then INLINES the canonical render by walking the
        -- render plan (calling the int/bool/str/write helpers placed in the render
        -- region at layout.5), then exits. The plan already carries the structural
        -- '(' ')' ',' and the trailing '\n'.
        let n_words = nc_rplan_words(rplan)
        let stage = nc_mul8(n_words)
        let sret_size = nc_tuple_sret_size(n_words)
        let int_off = layout.5
        let bool_off = layout.5 + nc_render_int_noln_len()
        let str_off = layout.5 + nc_render_int_noln_len() + nc_render_bool_noln_len()
        let write_off = layout.5 + nc_render_int_noln_len() + nc_render_bool_noln_len() + nc_render_str_noln_len()
        buf = nc_emit_sub_rsp_imm(buf, sret_size)
        do append_str(buf, "\x48\x8d\x3c\x24")
        buf = nc_emit_call_abs(buf, main_entry)
        buf = nc_emit_rplan(buf, rplan, 0, count(rplan), stage, int_off, bool_off, str_off, write_off)
        buf = nc_emit_add_rsp_imm(buf, sret_size)
        do append_str(buf, "\xb8\xe7\x00\x00\x00\x31\xff\x0f\x05")
        ck = nc_emit_entry_check(start_len, buf, layout.4, "entry-head")
        if ck != 0:
            return (ck, buf)
        end
        if has_faultable != 0:
            let ro_base = code_len + nc_rodata_len(strings) - nc_fault_rodata_len() - nc_set_fault_rodata_len(has_faultable)
            buf = nc_emit_fault_helpers(buf, ro_base, nc_fault_helper_start(has_heap, has_faultable, main_ret, rplan))
            buf = nc_emit_set_fault_helper(buf, ro_base, nc_fault_helper_start(has_heap, has_faultable, main_ret, rplan), has_faultable)
        end
        ck = nc_emit_entry_check(start_len, buf, layout.5, "entry-fault")
        if ck != 0:
            return (ck, buf)
        end
        buf = nc_emit_render_int_noln(buf, write_off)
        buf = nc_emit_render_bool_noln(buf, write_off)
        buf = nc_emit_render_str_noln(buf, write_off)
        buf = nc_emit_write_fd1(buf, write_fail_off)
        ck = nc_emit_entry_check(start_len, buf, layout.6, "entry-render")
        if ck != 0:
            return (ck, buf)
        end
        return (0, buf)
    end
    do append(buf, 232)
    buf = nc_append_rel32(buf, main_entry, layout.0 + 5)
    do append(buf, 232)
    buf = nc_append_rel32(buf, layout.5, layout.0 + 10)
    do append_str(buf, "\xb8\xe7\x00\x00\x00\x31\xff\x0f\x05")
    ck = nc_emit_entry_check(start_len, buf, layout.4, "entry-head")
    if ck != 0:
        return (ck, buf)
    end
    if has_faultable != 0:
        let ro_base = code_len + nc_rodata_len(strings) - nc_fault_rodata_len() - nc_set_fault_rodata_len(has_faultable)
        buf = nc_emit_fault_helpers(buf, ro_base, nc_fault_helper_start(has_heap, has_faultable, main_ret, rplan))
        buf = nc_emit_set_fault_helper(buf, ro_base, nc_fault_helper_start(has_heap, has_faultable, main_ret, rplan), has_faultable)
    end
    ck = nc_emit_entry_check(start_len, buf, layout.5, "entry-fault")
    if ck != 0:
        return (ck, buf)
    end
    buf = nc_emit_render_main(buf, main_ret, layout.5, write_fail_off)
    ck = nc_emit_entry_check(start_len, buf, layout.6, "entry-render")
    if ck != 0:
        return (ck, buf)
    end
    return (0, buf)
end

func nc_lower_loop(fn, funcs, meta, metas, layout, layouts, strings, code_len, diag_base, i, n, buf):
    let oom_off = diag_base + nc_fault_diag_oom_rel()
    while i < n:
        let code = fn.4
        let instr = get(code, i)
        let op = instr.0
        let a = instr.1
        let g = nc_group(code, i, n, fn, funcs, meta, metas)
        let instr_off = layout.0 + get(layout.1, i)
        if op == 0:
            buf = nc_emit_push_int(buf, a)
        elif op == 1:
            buf = nc_emit_push_bool(buf, a)
        elif op == 2:
            buf = nc_emit_push_str(buf, strings, a, instr_off, code_len)
        elif op == 3:
            buf = nc_emit_load_local(buf, get(meta.bases, a), get(meta.widths, a))
        elif op == 4:
            buf = nc_emit_store_local(buf, get(meta.bases, a), get(meta.widths, a))
        elif op == 5:
            buf = nc_emit_add(buf)
        elif op == 6:
            buf = nc_emit_sub(buf)
        elif op == 7:
            buf = nc_emit_cmp_setcc(buf, 146)
        elif op == 8:
            buf = nc_emit_cmp_setcc(buf, 150)
        elif op == 9:
            buf = nc_emit_cmp_setcc(buf, 151)
        elif op == 10:
            buf = nc_emit_cmp_setcc(buf, 147)
        elif op == 11:
            buf = nc_emit_cmp_setcc(buf, 148)
        elif op == 12:
            buf = nc_emit_cmp_setcc(buf, 149)
        elif op == 13:
            buf = nc_emit_not(buf)
        elif op == 36:
            buf = nc_emit_band(buf)
        elif op == 37:
            buf = nc_emit_bor(buf)
        elif op == 38:
            buf = nc_emit_bxor(buf)
        elif op == 39:
            buf = nc_emit_shl(buf)
        elif op == 40:
            buf = nc_emit_shr(buf)
        elif op == 41:
            buf = nc_emit_bnot(buf)
        elif op == 42:
            buf = nc_emit_mul(buf)
        elif op == 43:
            buf = nc_emit_div_or_mod(buf, 0, get(fn.6, i), diag_base + nc_fault_diag_div_rel(), instr_off)
        elif op == 44:
            buf = nc_emit_div_or_mod(buf, 1, get(fn.6, i), diag_base + nc_fault_diag_div_rel(), instr_off)
        elif op == 15:
            buf = nc_emit_tuple_get(buf, meta, i)
        elif op == 16:
            buf = nc_emit_br(buf, layout.0 + get(layout.1, a), instr_off + 5)
        elif op == 17:
            buf = nc_emit_br_if_false(buf, layout.0 + get(layout.1, a), instr_off + 10)
        elif op == 18:
            buf = nc_emit_br_and(buf, layout.0 + get(layout.1, a), instr_off + 13)
        elif op == 19:
            buf = nc_emit_br_or(buf, layout.0 + get(layout.1, a), instr_off + 13)
        elif op == 20:
            let callee_layout = get(layouts, instr.1)
            let cm = get(meta.call_meta, i)
            if cm.2 == 2:
                buf = nc_emit_tail_call(buf, callee_layout.0, instr_off + g.0, meta.pwords, cm.0, meta.sret_word, 0)
            elif cm.2 == 3:
                buf = nc_emit_tail_call(buf, callee_layout.0, instr_off + g.0, meta.pwords, cm.0, meta.sret_word, 1)
            else:
                let call_base = instr_off + 5
                if cm.2 == 1:
                    call_base = instr_off + nc_disp_len_rbp(1, nc_sret_scratch_mag(meta.scratch_base, cm.1, 0)) + 5
                end
                buf = nc_emit_normal_call(buf, callee_layout.0, call_base, meta, cm)
            end
        elif op == 21:
            buf = nc_emit_ret(buf, meta)
        elif op == 22:
            buf = nc_emit_length(buf)
        elif op == 23:
            buf = nc_emit_index(buf, get(fn.6, i), diag_base + nc_fault_diag_index_rel(), instr_off)
        elif op == 24:
            buf = nc_emit_slice(buf, get(fn.6, i), diag_base + nc_fault_diag_index_rel(), instr_off)
        elif op == 25:
            buf = nc_emit_equal(buf)
        elif op == 26:
            buf = nc_emit_new_buffer(buf, oom_off)
        elif op == 27:
            buf = nc_emit_freeze(buf, oom_off)
        elif op == 28:
            buf = nc_emit_new_array(buf, get(meta.heap_meta, i).1, oom_off)
        elif op == 29:
            buf = nc_emit_get(buf, get(meta.heap_meta, i).1, get(fn.6, i), diag_base + nc_fault_diag_get_rel(), instr_off, oom_off)
        elif op == 30:
            buf = nc_emit_count(buf)
        elif op == 31:
            buf = nc_emit_buf_append(buf, get(fn.6, i), diag_base + nc_fault_diag_append_rel(), instr_off, oom_off)
        elif op == 32:
            buf = nc_emit_arr_add(buf, get(meta.heap_meta, i).1, oom_off)
        elif op == 63:
            buf = nc_emit_arr_add_keep(buf, get(meta.heap_meta, i).1, oom_off)
        elif op == 68:
            buf = nc_emit_arr_set(buf, get(meta.heap_meta, i).1, get(fn.6, i), diag_base + nc_fault_diag_set_rel(), instr_off, oom_off)
        elif op == 64:
            buf = nc_emit_set_field(buf, a, instr.2)
        elif op == 65:
            buf = nc_emit_get_field(buf, meta, i)
        elif op == 33:
            buf = nc_emit_clogger(buf, oom_off, diag_base + nc_fault_exit1_rel())
        elif op == 34:
            buf = nc_emit_flogger(buf)
        elif op == 35:
            buf = nc_emit_fwriter(buf)
        elif op == 54:
            buf = nc_emit_process_exit(buf)
        elif op == 55:
            buf = nc_emit_stderr_write(buf)
        elif op == 56:
            buf = nc_emit_stdin_read(buf)
        elif op == 58:
            buf = nc_emit_linux_syscall6(buf)
        elif op == 59:
            buf = nc_emit_buffer_address(buf)
        elif op == 60:
            buf = nc_emit_buffer_get(buf, get(fn.6, i), diag_base + nc_fault_diag_get_rel(), instr_off)
        elif op == 61:
            buf = nc_emit_buffer_set(buf, get(fn.6, i), diag_base + nc_fault_diag_get_rel(), diag_base + nc_fault_diag_append_rel(), instr_off)
        elif op == 62:
            buf = nc_emit_count(buf)
        elif op == 66:
            buf = nc_emit_buffer_copy(buf, get(fn.6, i), diag_base + nc_fault_diag_get_rel(), instr_off)
        elif op == 67:
            buf = nc_emit_buffer_fill(buf, get(fn.6, i), diag_base + nc_fault_diag_append_rel(), instr_off, oom_off)
        end
        i = g.1
    end
    return buf
end

func nc_emit_function(buf, fn, funcs, meta, metas, layout, layouts, strings, code_len, diag_base):
    if get(layout.1, 0) != layout.4:
        return (nc_fail(418, 0, "prefix"), buf)
    end
    if get(layout.1, count(fn.4)) != layout.5:
        return (nc_fail(418, 0, "length"), buf)
    end
    buf = nc_emit_prologue(buf, layout.3)
    buf = nc_emit_sret_save(buf, meta)
    buf = nc_emit_arg_copies_loop(buf, 0, meta.pwords)
    buf = nc_lower_loop(fn, funcs, meta, metas, layout, layouts, strings, code_len, diag_base, 0, count(fn.4), buf)
    return (0, buf)
end

func nc_emit_functions_loop(buf, funcs, metas, layouts, strings, code_len, diag_base, i, n):
    while i < n:
        let r = nc_emit_function(buf, get(funcs, i), funcs, get(metas, i), metas, get(layouts, i), layouts, strings, code_len, diag_base)
        if r.0 != 0:
            return r
        end
        buf = r.1
        i = i + 1
    end
    return (0, buf)
end

func nc_emit_zeroes_loop(buf, n):
    while n > 0:
        do append(buf, 0)
        n = n - 1
    end
    return buf
end

func nc_emit_rodata_loop(buf, strings, i, n):
    while i < n:
        buf = append_str(buf, get(strings, i))
        i = i + 1
    end
    return buf
end

func nc_emit_rodata(buf, strings):
    return nc_emit_rodata_loop(buf, strings, 0, count(strings))
end

func nc_append_fault_rodata(strings):
    do add(strings, "herbert: line ")
    do add(strings, ": index: position ")
    do add(strings, ": get: position ")
    do add(strings, ": append: byte value ")
    do add(strings, " out of range (length ")
    do add(strings, " out of range (count ")
    do add(strings, " out of range 0..255")
    do add(strings, ")\n")
    do add(strings, "\n")
    do add(strings, ": division by zero\n")
    do add(strings, "herbert: out of memory (the 3.5 GiB heap is used up)\n")
    do add(strings, "herbert: cannot reserve the 3.5 GiB heap\n")
    do add(strings, "herbert: cannot write output (error ")
    return strings
end

-- set's separator, after the fault rodata, for a program that stores with set
-- (nc_drive appends it when has_faultable is 2): nc_fault_sep_set_off.
func nc_append_set_fault_rodata(strings):
    do add(strings, ": set: position ")
    return strings
end
