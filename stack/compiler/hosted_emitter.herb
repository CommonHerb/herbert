-- write a single literal byte `ch` to fd1 via the staging slot [rsp+stage]
-- (rsp = scratch base, unchanged), calling the write helper. 20 bytes.
func nc_emit_render_putc(buf, ch, stage, write_off):
    do append(buf, 198)
    do append(buf, 68)
    do append(buf, 36)
    do append(buf, stage)
    do append(buf, ch)
    do append(buf, 72)
    do append(buf, 141)
    do append(buf, 116)
    do append(buf, 36)
    do append(buf, stage)
    do append(buf, 186)
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    buf = nc_emit_call_abs(buf, write_off)
    return buf
end

-- write ", " (comma, space) via the staging slot. 22 bytes.
func nc_emit_render_putsep(buf, stage, write_off):
    do append(buf, 102)
    do append(buf, 199)
    do append(buf, 68)
    do append(buf, 36)
    do append(buf, stage)
    do append(buf, 44)
    do append(buf, 32)
    do append(buf, 72)
    do append(buf, 141)
    do append(buf, 116)
    do append(buf, 36)
    do append(buf, stage)
    do append(buf, 186)
    do append(buf, 2)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    buf = nc_emit_call_abs(buf, write_off)
    return buf
end

-- load result word k (at [rsp+8k]) into rax, then call the int/bool renderer. 10 bytes.
-- link12: render an int/bool result word: mov rax,[rsp+8w]; call target. 10 bytes.
-- Indexed by the plan's WORD offset so mixed-width elements (strings, nested tuples)
-- address the right flattened slot.
func nc_emit_render_word_elem(buf, word, target_off):
    do append(buf, 72)
    do append(buf, 139)
    do append(buf, 68)
    do append(buf, 36)
    do append(buf, nc_mul8(word))
    return nc_emit_call_abs(buf, target_off)
end

-- link12: render a string result word pair: mov rsi,[rsp+8w] (ptr);
-- mov rdx,[rsp+8(w+1)] (length); call str_off. 15 bytes.
func nc_emit_render_str_elem(buf, word, str_off):
    do append(buf, 72)
    do append(buf, 139)
    do append(buf, 116)
    do append(buf, 36)
    do append(buf, nc_mul8(word))
    do append(buf, 72)
    do append(buf, 139)
    do append(buf, 84)
    do append(buf, 36)
    do append(buf, nc_mul8(word + 1))
    return nc_emit_call_abs(buf, str_off)
end

