-- code carrying the DEL dispatch + do_fs_del arm) differs. Byte-identical to delete_ref.build_elf(fsdel=True).
func nc32_delete_h0():
    return ""
end
func nc32_delete_t0():
    return ""
end
func nc32_delete_hexbytes(buf, hx, hi, hlen):
    if hi >= hlen:
        return buf
    end
    let b = nc32_geeking_hexval(index(hx, hi)) * 16 + nc32_geeking_hexval(index(hx, hi + 1))
    do append(buf, b)
    return nc32_delete_hexbytes(buf, hx, hi + 2, hlen)
end
func nc_emit_multiboot32_delete_program(source):
    let buf = new_buffer()
    let s0 = nc32_delete_h0()
    buf = nc32_delete_hexbytes(buf, s0, 0, length(s0))
    buf = nc32_larder_pd_loop(buf, 0)
    buf = nc32_geeking_pt_loop(buf, 0, 4096)
    let u0 = nc32_delete_t0()
    buf = nc32_delete_hexbytes(buf, u0, 0, length(u0))
    do fwriter(freeze(buf))
    return 0
end
func nc_is_multiboot32_delete(source):
    let marker = "-- emit: multiboot32-delete"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

