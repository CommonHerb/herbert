-- holler (link 24): the COMPILED SYS_WRITE module (coalgate-style: a raw, POSITION-INDEPENDENT i386 MODULE,
-- entry byte 0, the FROZEN holler kernel runs at ring 3). Like coalgate (exactly one sys_read, no branches,
-- straight-line + locals, implicit sys_exit) but ALSO emits its OWN output via >= 1 sys_write (op 48 -> the
-- bounds-checked int 0x30 eax=2). Reuses nc32_lower_loop wholesale; op 48 is admitted ONLY here, via
-- nc32_holler_proxy (op 47 -> push; op 48 -> pop+push net 0). Proven byte-identical to holler_ref.target_module.
func nc_emit_module_holler_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let fa = nc_fail(610, 0, "module-holler: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let fb = nc_fail(611, 0, "module-holler: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if nc32_count_sysread(code, n) != 1:
        let fi = nc_fail(612, 0, "module-holler: main must read sys_read() exactly once")
        return 0
    end
    if nc32_count_syswrite(code, n) < 1:
        let fw = nc_fail(613, 0, "module-holler: main must sys_write() at least once (it emits its OWN output)")
        return 0
    end
    if nc32_count_module(code, n) != 0:
        let fj = nc_fail(614, 0, "module-holler: module_byte() is kernel-only; a module reads via sys_read()")
        return 0
    end
    if nc32_count_input(code, n) != 0:
        let fk = nc_fail(615, 0, "module-holler: input_byte() faults at CPL3; a module reads via sys_read()")
        return 0
    end
    if nc32_has_branch(code, n):
        let fh = nc_fail(616, 0, "module-holler: control flow (if/branch) not in the v1 straight-line subset")
        return 0
    end
    let proxy = nc32_holler_proxy(code, n)
    if not nc32_body_ok(proxy, count(proxy)):
        let fc = nc_fail(617, 0, "module-holler: body not in the module/locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let fd = nc_fail(618, 0, "module-holler: too many locals (max 31)")
        return 0
    end
    let prefix_len = 0
    if nlocals > 0:
        prefix_len = 5
    end
    let lay = nc32_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let fe = nc_fail(619, 0, "module-holler: body length invariant")
        return 0
    end
    let mbuf = new_buffer()
    if nlocals > 0:
        do append(mbuf, 137)   -- 89
        do append(mbuf, 229)   -- E5  mov ebp,esp
        do append(mbuf, 131)   -- 83
        do append(mbuf, 236)   -- EC  sub esp,
        do append(mbuf, 4 * nlocals)
    end
    mbuf = append_str(mbuf, freeze(bodybuf))
    -- implicit sys_exit: mov bl,al; mov eax,SYS_EXIT(1); int 0x30. The kernel stores bl and never returns.
    do append(mbuf, 136)   -- 88
    do append(mbuf, 195)   -- C3  mov bl,al
    do append(mbuf, 184)   -- B8  mov eax,
    mbuf = nc_append_le32(mbuf, 1)   -- SYS_EXIT = 1
    do append(mbuf, 205)   -- CD
    do append(mbuf, 48)    -- 30  int 0x30
    do fwriter(freeze(mbuf))
    return 0
end

func nc_is_multiboot32_coalgate(source):
    let marker = "-- emit: multiboot32-coalgate"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- coalgate (link 22): THE KERNEL RUNS ITS FIRST HERBERT-COMPILED MODULE. A NEW emit KIND -- not a kernel
-- ELF but a raw, POSITION-INDEPENDENT i386 MODULE (entry byte 0) the FROZEN geeking kernel runs at ring 3.
-- The transform body reuses nc32_lower_loop wholesale; the module-side glue is op 47 sys_read (the only
-- input path a CPL3 module has -- module_byte/op46 reads an absolute kernel cell, input_byte/op45 #GPs at
-- CPL3, both BANNED) plus an IMPLICIT sys_exit appended after the body (main's return value, left in eax
-- by the final op 21 pop eax, becomes the one-byte exit status: mov bl,al; mov eax,1; int 0x30). v1 = the
-- straight-line + locals subset (no branches), exactly one sys_read. The byte convention is the named ABI
-- in audits/link22-coalgate/00-module-abi.md, proven byte-identical to coalgate_ref.target_module (STEP-0).
func nc_emit_multiboot32_coalgate_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let fa = nc_fail(580, 0, "multiboot32-coalgate: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let fb = nc_fail(581, 0, "multiboot32-coalgate: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if nc32_count_sysread(code, n) != 1:
        let fi = nc_fail(582, 0, "multiboot32-coalgate: main must read sys_read() exactly once")
        return 0
    end
    if nc32_count_module(code, n) != 0:
        let fj = nc_fail(583, 0, "multiboot32-coalgate: module_byte() is kernel-only; a module reads via sys_read()")
        return 0
    end
    if nc32_count_input(code, n) != 0:
        let fk = nc_fail(584, 0, "multiboot32-coalgate: input_byte() faults at CPL3; a module reads via sys_read()")
        return 0
    end
    if nc32_has_branch(code, n):
        let fh = nc_fail(585, 0, "multiboot32-coalgate: control flow (if/branch) not in the v1 straight-line subset")
        return 0
    end
    let proxy = nc32_sysread_proxy(code, n)
    if not nc32_body_ok(proxy, n):
        let fc = nc_fail(586, 0, "multiboot32-coalgate: body not in the module/locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let fd = nc_fail(587, 0, "multiboot32-coalgate: too many locals (max 31)")
        return 0
    end
    -- the module is its own base: lay the body at the frame-prologue length (0, or 5 for mov ebp,esp;
    -- sub esp,imm8), so the rel32 layout (epi = offset just past the body, where the sys_exit glue begins)
    -- is self-relative and the blob is position-independent regardless of load base.
    let prefix_len = 0
    if nlocals > 0:
        prefix_len = 5
    end
    let lay = nc32_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let fe = nc_fail(588, 0, "multiboot32-coalgate: body length invariant")
        return 0
    end
    let mbuf = new_buffer()
    if nlocals > 0:
        do append(mbuf, 137)   -- 89
        do append(mbuf, 229)   -- E5  mov ebp,esp
        do append(mbuf, 131)   -- 83
        do append(mbuf, 236)   -- EC  sub esp,
        do append(mbuf, 4 * nlocals)
    end
    mbuf = append_str(mbuf, freeze(bodybuf))
    -- implicit sys_exit: mov bl,al; mov eax,SYS_EXIT(1); int 0x30. The kernel stores bl and never returns.
    do append(mbuf, 136)   -- 88
    do append(mbuf, 195)   -- C3  mov bl,al
    do append(mbuf, 184)   -- B8  mov eax,
    mbuf = nc_append_le32(mbuf, 1)   -- SYS_EXIT = 1
    do append(mbuf, 205)   -- CD
    do append(mbuf, 48)    -- 30  int 0x30
    do fwriter(freeze(mbuf))
    return 0
end

func nc_is_multiboot32_ouroboros(source):
    let marker = "-- emit: multiboot32-ouroboros"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- ouroboros (link 23 / native-codegen Link 39): THE KERNEL RUNS THE STACK'S OWN ALGORITHM. coalgate runs a
-- straight-line single-function module; ouroboros makes the compiled ring-3 module a real ALGORITHM -- it
-- adds user CALLS + recursion (and ungates branches) to the position-independent 32-bit module path, so the
-- FROZEN geeking kernel runs a genuinely RECURSIVE compiled program. Self-contained (does NOT touch the
-- shared nc32_lower_loop / nc32_op_allowed: coalgate relies on op 20 being DISALLOWED to reject a recursive
-- main, so ouroboros gets its own nc_ouro_* validation that admits op 20). Module shape: [main][f1][f2]...,
-- entry byte 0 = main. main keeps coalgate's frame (mov ebp,esp; sub esp,4S; ends via SYS_EXIT glue); a
-- callee uses push ebp; mov ebp,esp; sub esp,4S; <copy params to negative slots> ... mov esp,ebp; pop ebp;
-- ret. A call (op 20) = E8 rel32 (signed; callee base may be BEFORE the call site -- the backward recursive
-- call) + add esp,4*nargs (caller cleanup) + push eax (result). Proven byte-identical to the STEP-0 target
-- run on QEMU+Bochs+KVM (audits/link23-ouroboros/01-step0-proof.md).

-- admitted ops for a module function (op 47 sys_read is proxied to op 0 before the depth walk; op 20 call
-- is admitted here, unlike the shared nc32_op_allowed).
func nc_ouro_op_allowed(op):
    if op == 0:
        return true
    end
    if op == 3:
        return true
    end
    if op == 4:
        return true
    end
    if op == 5:
        return true
    end
    if op == 6:
        return true
    end
    if op == 11:
        return true
    end
    if op == 16:
        return true
    end
    if op == 17:
        return true
    end
    if op == 20:
        return true
    end
    if op == 21:
        return true
    end
    if op == 42:
        return true
    end
    if op == 48:
        return true
    end
    if op == 49:
        return true
    end
    if op == 50:
        return true
    end
    if op == 51:
        return true
    end
    if op == 52:
        return true
    end
    return false
end

-- stack effect with op 20 (a call pops its nargs args, pushes one result). op 48 (mmj sys_write) is net 0:
-- it pops the operand (the value to emit, at TOS) and pushes the syscall result (0) into the same slot.
func nc_ouro_pops(op, nargs):
    if op == 20:
        return nargs
    end
    if op == 48:
        return 1
    end
    if op == 52:
        return 1
    end
    if op == 50:
        return 2
    end
    if op == 51:
        return 3
    end
    return nc32_pops(op)
end

func nc_ouro_pushes(op, nargs):
    if op == 20:
        return 1
    end
    if op == 48:
        return 1
    end
    if op == 52:
        return 1
    end
    if op == 49:
        return 1
    end
    if op == 50:
        return 1
    end
    if op == 51:
        return 1
    end
    return nc32_pushes(op)
end

-- PASS A depth gate (op-20-aware mirror of nc32_build_depths). The code passed in is the sys_read proxy
-- (op 47 -> op 0), so the walk never sees op 47; op 20 carries its nargs in field .2.
func nc_ouro_build_depths(code, i, n, cur, depths):
    if i >= n:
        return (1, depths)
    end
    let op = get(code, i).0
    if not nc_ouro_op_allowed(op):
        return (0, depths)
    end
    if cur > 3000:
        return (0, depths)
    end
    let pops = nc_ouro_pops(op, get(code, i).2)
    if cur < pops:
        return (0, depths)
    end
    do add(depths, cur)
    if op == 21:
        if cur != 1:
            return (0, depths)
        end
    end
    return nc_ouro_build_depths(code, i + 1, n, cur - pops + nc_ouro_pushes(op, get(code, i).2), depths)
end

-- full per-function subset gate: ends in RET, opcodes admitted + stack-balanced (PASS A), branches forward
-- + depth-agreeing (PASS B reuses nc32_check_branches, which inspects only op 16/17). Defense-in-depth: the
-- far-axis oracle has no C reference, so the gate proves each function well-formed itself.
func nc_ouro_body_ok(code, n):
    if n == 0:
        return false
    end
    if get(code, n - 1).0 != 21:
        return false
    end
    let bd = nc_ouro_build_depths(code, 0, n, 0, new_array(int))
    if bd.0 == 0:
        return false
    end
    return nc32_check_branches(code, 0, n, bd.1)
end

-- byte size of one instruction. op 20: E8 rel32 (5) + caller cleanup (0 if nargs==0, 3 for add esp,imm8,
-- 6 for add esp,imm32) + push eax (1). op 47 sys_read = 8 (mov eax,0; int 0x30; push eax).
-- Size of one instruction. op 20 (call) is ouroboros-only: E8 rel32 (5) + caller cleanup (0/3/6) + push eax
-- (1). Every other op REUSES nc32_op_size (the shared size table) -- NOT a duplicated copy, so toakie's
-- pushint_layout_size mutation anchor (the op-0/op-3 size block) stays exactly-once in nc32_op_size.
func nc_ouro_op_size(op, nargs, is_last):
    if op == 20:
        let cl = 0
        if nargs > 0:
            if 4 * nargs <= 127:
                cl = 3
            else:
                cl = 6
            end
        end
        return 5 + cl + 1
    end
    if op == 49:
        return 3
    end
    if op == 50:
        return 7
    end
    if op == 51:
        return 8
    end
    if op == 52:
        return 9
    end
    return nc32_op_size(op, is_last)
end

-- frame slot count S = max(nparams, max slot touched). Reserve 4S; copy params into the first nparams slots.
func nc_ouro_frame_size(fn):
    let code = fn.4
    let n = count(code)
    let s = nc32_nlocals_loop(code, 0, n, 0)
    if fn.2 > s:
        s = fn.2
    end
    return s
end

-- prologue bytes. main (frame>0): mov ebp,esp; sub esp,4S (5). callee (frame>0): push ebp; mov ebp,esp;
-- sub esp,4S (6) + nparams param-copies (6 each). frame==0: empty (entry/leaf needs no frame).
func nc_ouro_prologue_len(is_main, nparams, frame):
    if frame == 0:
        return 0
    end
    if is_main == 1:
        return 5
    end
    return 6 + nparams * 6
end

func nc_ouro_epilogue_len(is_main, frame):
    if is_main == 1:
        return 9
    end
    if frame > 0:
        return 4
    end
    return 1
end

func nc_ouro_body_size(code, i, n, acc):
    if i >= n:
        return acc
    end
    let il = 0
    if i == n - 1:
        il = 1
    end
    return nc_ouro_body_size(code, i + 1, n, acc + nc_ouro_op_size(get(code, i).0, get(code, i).2, il))
end

func nc_ouro_func_total(fn, is_main, frame):
    let code = fn.4
    let n = count(code)
    return nc_ouro_prologue_len(is_main, fn.2, frame) + nc_ouro_body_size(code, 0, n, 0) + nc_ouro_epilogue_len(is_main, frame)
end

-- PASS A: assign each function its base byte offset (cumulative; main is funcs[0] -> base 0 -> entry byte 0).
func nc_ouro_bases_loop(funcs, i, nf, cur, bases):
    if i >= nf:
        return bases
    end
    do add(bases, cur)
    let fn = get(funcs, i)
    let is_main = 0
    if i == 0:
        is_main = 1
    end
    let frame = nc_ouro_frame_size(fn)
    return nc_ouro_bases_loop(funcs, i + 1, nf, cur + nc_ouro_func_total(fn, is_main, frame), bases)
end

-- per-function ABSOLUTE instruction offsets; returns (offs, epi_abs) where epi_abs = offset just past the
-- body (where the epilogue begins). cur starts at the function base + prologue length.
func nc_ouro_offsets_loop(code, i, n, cur, offs):
    if i >= n:
        return (offs, cur)
    end
    do add(offs, cur)
    let il = 0
    if i == n - 1:
        il = 1
    end
    return nc_ouro_offsets_loop(code, i + 1, n, cur + nc_ouro_op_size(get(code, i).0, get(code, i).2, il), offs)
end

func nc_ouro_emit_param_copies(obuf, i, nparams):
    if i >= nparams:
        return obuf
    end
    -- mov eax,[ebp + 8 + 4*(nparams-1-i)]   (8B 45 disp8)  -- arg i (caller pushed left-to-right)
    do append(obuf, 139)
    do append(obuf, 69)
    do append(obuf, 8 + 4 * (nparams - 1 - i))
    -- mov [ebp - 4*(i+1)],eax   (89 45 disp8)               -- into negative slot i
    do append(obuf, 137)
    do append(obuf, 69)
    do append(obuf, 256 - 4 * (i + 1))
    return nc_ouro_emit_param_copies(obuf, i + 1, nparams)
end

func nc_ouro_emit_prologue(obuf, is_main, nparams, frame):
    if is_main == 1:
        do append(obuf, 137)   -- 89
        do append(obuf, 229)   -- E5  mov ebp,esp
        do append(obuf, 131)   -- 83
        do append(obuf, 236)   -- EC  sub esp,
        do append(obuf, 4 * frame)
        return obuf
    end
    do append(obuf, 85)    -- 55  push ebp
    do append(obuf, 137)   -- 89
    do append(obuf, 229)   -- E5  mov ebp,esp
    do append(obuf, 131)   -- 83
    do append(obuf, 236)   -- EC  sub esp,
    do append(obuf, 4 * frame)
    return nc_ouro_emit_param_copies(obuf, 0, nparams)
end

func nc_ouro_emit_epilogue(obuf, is_main, frame):
    if is_main == 1:
        do append(obuf, 136)   -- 88
        do append(obuf, 195)   -- C3  mov bl,al
        do append(obuf, 184)   -- B8  mov eax,
        obuf = nc_append_le32(obuf, 1)   -- SYS_EXIT = 1
        do append(obuf, 205)   -- CD
        do append(obuf, 48)    -- 30  int 0x30  (implicit sys_exit; never returns)
        return obuf
    end
    if frame > 0:
        do append(obuf, 137)   -- 89
        do append(obuf, 236)   -- EC  mov esp,ebp
        do append(obuf, 93)    -- 5D  pop ebp
        do append(obuf, 195)   -- C3  ret
        return obuf
    end
    do append(obuf, 195)   -- C3  ret
    return obuf
end

-- PASS B: lower one function's body with ABSOLUTE offsets. Branch rel32 (op 16/17) is intra-function and
-- forward-only (verified) so nc_append_le32 is safe; a call rel32 (op 20) targets the callee base, which may
-- be BEFORE the call site (the backward recursive call), so it goes through the SIGNED nc_append_rel32.
func nc_ouro_lower_body(obuf, code, i, n, offs, epi, bases):
    if i >= n:
        return obuf
    end
    let op = get(code, i).0
    let il = 0
    if i == n - 1:
        il = 1
    end
    let endoff = get(offs, i) + nc_ouro_op_size(op, get(code, i).2, il)
    if op == 0:
        do append(obuf, 104)
        obuf = nc_append_le32(obuf, get(code, i).1)
    elif op == 3:
        do append(obuf, 255)
        do append(obuf, 117)
        do append(obuf, 256 - 4 * (get(code, i).1 + 1))
    elif op == 4:
        do append(obuf, 143)
        do append(obuf, 69)
        do append(obuf, 256 - 4 * (get(code, i).1 + 1))
    elif op == 5:
        do append(obuf, 89)
        do append(obuf, 88)
        do append(obuf, 1)
        do append(obuf, 200)
        do append(obuf, 80)
    elif op == 6:
        do append(obuf, 89)
        do append(obuf, 88)
        do append(obuf, 41)
        do append(obuf, 200)
        do append(obuf, 80)
    elif op == 11:
        do append(obuf, 89)
        do append(obuf, 88)
        do append(obuf, 57)
        do append(obuf, 200)
        do append(obuf, 15)
        do append(obuf, 148)
        do append(obuf, 192)
        do append(obuf, 15)
        do append(obuf, 182)
        do append(obuf, 192)
        do append(obuf, 80)
    elif op == 42:
        do append(obuf, 89)
        do append(obuf, 88)
        do append(obuf, 15)
        do append(obuf, 175)
        do append(obuf, 193)
        do append(obuf, 80)
    elif op == 16:
        do append(obuf, 233)
        let t = get(code, i).1
        let toff = epi
        if t < n:
            toff = get(offs, t)
        end
        obuf = nc_append_le32(obuf, toff - endoff)
    elif op == 17:
        do append(obuf, 88)
        do append(obuf, 133)
        do append(obuf, 192)
        do append(obuf, 15)
        do append(obuf, 132)
        let t2 = get(code, i).1
        let toff2 = epi
        if t2 < n:
            toff2 = get(offs, t2)
        end
        obuf = nc_append_le32(obuf, toff2 - endoff)
    elif op == 47:
        do append(obuf, 184)   -- B8  mov eax,
        obuf = nc_append_le32(obuf, 0)   -- SYS_READ = 0
        do append(obuf, 205)   -- CD
        do append(obuf, 48)    -- 30  int 0x30
        do append(obuf, 80)    -- 50  push eax
    elif op == 48:
        -- mmj (link 25): op 48 sys_write -- emit le32 of the TOS operand via the bounds-checked int 0x30 eax=2.
        -- Same 18 bytes as holler's nc32_lower_loop op-48 arm (the kernel access_ok's [ecx,ecx+4) BY VALUE
        -- against the module's User page). Reached from INSIDE a recursion frame: ecx = the live operand-stack
        -- TOS, which descends per recursion level -- the new silicon surface, proven safe at STEP-0. Net stack 0.
        do append(obuf, 141)   -- 8D
        do append(obuf, 12)    -- 0C
        do append(obuf, 36)    -- 24  lea ecx,[esp]
        do append(obuf, 186)   -- BA  mov edx,
        obuf = nc_append_le32(obuf, 4)   -- len = 4 (le32)
        do append(obuf, 184)   -- B8  mov eax,
        obuf = nc_append_le32(obuf, 2)   -- SYS_WRITE = 2
        do append(obuf, 205)   -- CD
        do append(obuf, 48)    -- 30  int 0x30
        do append(obuf, 137)   -- 89
        do append(obuf, 4)     -- 04
        do append(obuf, 36)    -- 24  mov [esp],eax
    elif op == 49:
        -- chiefturbo op 49 bufbase(): push DWORD [ebp+0] -- the buffer base alloc_lo that main's capture
        -- prologue stashed at [ebp+0]. 3 bytes.
        do append(obuf, 255)   -- FF
        do append(obuf, 117)   -- 75
        do append(obuf, 0)     -- 00  push [ebp+0]
    elif op == 50:
        -- chiefturbo op 50 bufget(base,k): TOS=k, next=base. pop ecx(k); pop edx(base); SS: mov eax,[edx+ecx*4];
        -- push eax. The 0x36 SS-override is LOAD-BEARING (the buffer is in the module STACK SEGMENT; iret-to-CPL3
        -- NULLs DS on real silicon -> a DS-relative load #GPs; SS is restored flat by every iret). 7 bytes.
        do append(obuf, 89)    -- 59  pop ecx
        do append(obuf, 90)    -- 5A  pop edx
        do append(obuf, 54)    -- 36  SS override
        do append(obuf, 139)   -- 8B
        do append(obuf, 4)     -- 04
        do append(obuf, 138)   -- 8A  mov eax,SS:[edx+ecx*4]
        do append(obuf, 80)    -- 50  push eax
    elif op == 51:
        -- chiefturbo op 51 bufset(base,i,v): TOS=v, next=i, next=base. pop edx(v); pop ecx(i); pop eax(base);
        -- SS: mov [eax+ecx*4],edx; push edx. 0x36 SS-override LOAD-BEARING (same reason as bufget). 8 bytes.
        do append(obuf, 90)    -- 5A  pop edx
        do append(obuf, 89)    -- 59  pop ecx
        do append(obuf, 88)    -- 58  pop eax
        do append(obuf, 54)    -- 36  SS override
        do append(obuf, 137)   -- 89
        do append(obuf, 20)    -- 14
        do append(obuf, 136)   -- 88  mov SS:[eax+ecx*4],edx
        do append(obuf, 82)    -- 52  push edx
    elif op == 52:
        -- tandem op 52 yield(v): pass v to the peer via the kernel mailbox + switch (SYS_YIELD = int 0x30,
        -- eax=3); on resume, push the peer's value. v is passed in EBX (a REGISTER) so the kernel never
        -- dereferences a module address -- the confused-deputy-free channel. 9 bytes, net stack 0 (pop arg,
        -- push result). The cooperative two-program scheduler primitive.
        do append(obuf, 91)    -- 5B  pop ebx   (v -> ebx)
        do append(obuf, 184)   -- B8  mov eax,
        obuf = nc_append_le32(obuf, 3)   -- SYS_YIELD = 3
        do append(obuf, 205)   -- CD
        do append(obuf, 48)    -- 30  int 0x30
        do append(obuf, 80)    -- 50  push eax  (peer's value)
    elif op == 20:
        let callee = get(code, i).1
        let nargs = get(code, i).2
        let cbase = get(bases, callee)
        let call_end = get(offs, i) + 5
        do append(obuf, 232)   -- E8  call
        obuf = nc_append_rel32(obuf, cbase, call_end)
        if nargs > 0:
            if 4 * nargs <= 127:
                do append(obuf, 131)   -- 83
                do append(obuf, 196)   -- C4  add esp,
                do append(obuf, 4 * nargs)
            else:
                do append(obuf, 129)   -- 81
                do append(obuf, 196)   -- C4  add esp,
                obuf = nc_append_le32(obuf, 4 * nargs)
            end
        end
        do append(obuf, 80)    -- 50  push eax (result)
    elif op == 21:
        if il == 1:
            do append(obuf, 88)
        else:
            do append(obuf, 88)
            do append(obuf, 233)
            obuf = nc_append_le32(obuf, epi - endoff)
        end
    end
    return nc_ouro_lower_body(obuf, code, i + 1, n, offs, epi, bases)
end

func nc_ouro_emit_funcs(buf, funcs, i, nf, bases):
    if i >= nf:
        return buf
    end
    let fn = get(funcs, i)
    let code = fn.4
    let n = count(code)
    let is_main = 0
    if i == 0:
        is_main = 1
    end
    let frame = nc_ouro_frame_size(fn)
    if frame > 0:
        buf = nc_ouro_emit_prologue(buf, is_main, fn.2, frame)
    end
    let pbase = get(bases, i) + nc_ouro_prologue_len(is_main, fn.2, frame)
    let lay = nc_ouro_offsets_loop(code, 0, n, pbase, new_array(int))
    buf = nc_ouro_lower_body(buf, code, 0, n, lay.0, lay.1, bases)
    buf = nc_ouro_emit_epilogue(buf, is_main, frame)
    return nc_ouro_emit_funcs(buf, funcs, i + 1, nf, bases)
end

-- whole-program builtin counts (CPL3 sandbox discipline): the program reads via sys_read() exactly once;
-- module_byte()/input_byte() are banned everywhere (a CPL3 module cannot read an absolute kernel cell or in).
func nc_ouro_total_sysread(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let code = get(funcs, i).4
    return nc_ouro_total_sysread(funcs, i + 1, nf, acc + nc32_count_sysread(code, count(code)))
end

func nc_ouro_total_module(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let code = get(funcs, i).4
    return nc_ouro_total_module(funcs, i + 1, nf, acc + nc32_count_module(code, count(code)))
end

func nc_ouro_total_input(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let code = get(funcs, i).4
    return nc_ouro_total_input(funcs, i + 1, nf, acc + nc32_count_input(code, count(code)))
end

-- each call op must target an in-range function with matching arity (callee nparams == nargs).
func nc_ouro_calls_ok(code, i, n, funcs, nf):
    if i >= n:
        return true
    end
    if get(code, i).0 == 20:
        let callee = get(code, i).1
        let nargs = get(code, i).2
        if callee >= nf:
            let e7 = nc_fail(597, 0, "multiboot32-ouroboros: call target out of range")
            return false
        end
        if get(funcs, callee).2 != nargs:
            let e8 = nc_fail(598, 0, "multiboot32-ouroboros: call arity mismatch")
            return false
        end
    end
    return nc_ouro_calls_ok(code, i + 1, n, funcs, nf)
end

func nc_ouro_func_ok(fn, funcs, nf):
    let code = fn.4
    let n = count(code)
    let proxy = nc32_sysread_proxy(code, n)
    if not nc_ouro_body_ok(proxy, n):
        let e5 = nc_fail(595, 0, "multiboot32-ouroboros: function body not in the subset")
        return false
    end
    if nc_ouro_frame_size(fn) > 31:
        let e6 = nc_fail(596, 0, "multiboot32-ouroboros: too many slots (max 31)")
        return false
    end
    -- param-copy reads arg i from [ebp + 8 + 4*(nparams-1-i)] as a disp8; the largest, param 0 of a
    -- 31-param function, is +128 = 0x80, which x86 SIGN-EXTENDS to -128 (reads the wrong slot). The disp8
    -- bound is +124 (30 params), the positive-side analogue of the 31-slot frame cap (sub esp, imm8). A
    -- function with >30 params is a clean reject, not a silent mis-compile.
    if fn.2 > 30:
        let e9 = nc_fail(599, 0, "multiboot32-ouroboros: more than 30 parameters (param-copy [ebp+disp8] bound)")
        return false
    end
    return nc_ouro_calls_ok(code, 0, n, funcs, nf)
end

func nc_ouro_all_funcs_ok(funcs, i, nf):
    if i >= nf:
        return true
    end
    if not nc_ouro_func_ok(get(funcs, i), funcs, nf):
        return false
    end
    return nc_ouro_all_funcs_ok(funcs, i + 1, nf)
end

func nc_emit_multiboot32_ouroboros_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    let nf = count(funcs)
    -- main must be the entry function (funcs[0]); the poly seed guarantees it -- assert defensively so the
    -- entry is byte 0 of the module.
    if prog.2 != 0:
        let e0 = nc_fail(590, 0, "multiboot32-ouroboros: main not the entry (index 0)")
        return 0
    end
    let mainfn = get(funcs, 0)
    if not equal(mainfn.0, "main"):
        let e0b = nc_fail(590, 0, "multiboot32-ouroboros: entry function is not main")
        return 0
    end
    if mainfn.2 != 0:
        let e1 = nc_fail(591, 0, "multiboot32-ouroboros: main must take no parameters")
        return 0
    end
    if nc_ouro_total_sysread(funcs, 0, nf, 0) != 1:
        let e2 = nc_fail(592, 0, "multiboot32-ouroboros: program must read sys_read() exactly once")
        return 0
    end
    if nc_ouro_total_module(funcs, 0, nf, 0) != 0:
        let e3 = nc_fail(593, 0, "multiboot32-ouroboros: module_byte() is kernel-only; a module reads via sys_read()")
        return 0
    end
    if nc_ouro_total_input(funcs, 0, nf, 0) != 0:
        let e4 = nc_fail(594, 0, "multiboot32-ouroboros: input_byte() faults at CPL3; a module reads via sys_read()")
        return 0
    end
    if not nc_ouro_all_funcs_ok(funcs, 0, nf):
        return 0
    end
    let bases = nc_ouro_bases_loop(funcs, 0, nf, 0, new_array(int))
    let mbuf = new_buffer()
    mbuf = nc_ouro_emit_funcs(mbuf, funcs, 0, nf, bases)
    do fwriter(freeze(mbuf))
    return 0
end

-- ===== mmj (link 25 / native-codegen Link 41): THE UNION. The first compiled ring-3 module that BOTH computes
-- with control flow/recursion (ouroboros) AND emits its OWN multi-byte output (holler's op 48 sys_write). It
-- REUSES the entire nc_ouro_* emitter (which now admits op 48) and adds, at the whole-program gate, the two
-- requirements that make a module the union (not a holler re-skin): >= 1 sys_write AND genuine RECURSION (a
-- backward call). Variable-LENGTH output (e.g. down(N) emits N words) is the make-or-break -- unfakeable by
-- ouroboros (no op 48) or holler (straight-line => fixed count). Runs on the FROZEN holler kernel; byte-identical
-- to mmj_ref.target_module('down'), proven on QEMU+Bochs+KVM. =====

-- whole-program sys_write count (op 48): the union module must emit its OWN output at least once.
func nc_mmj_total_syswrite(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let code = get(funcs, i).4
    return nc_mmj_total_syswrite(funcs, i + 1, nf, acc + nc32_count_syswrite(code, count(code)))
end

-- does function fi contain a BACKWARD call (callee index <= fi)? Functions are laid out [main, f1, f2, ...] in
-- index order, so a call to a function whose index <= the caller's emits a backward E8 rel32 -- a self-call
-- (callee==fi) or a back-edge of a recursion cycle. This is the ONLY way to ITERATE in Herbert (no while; ouro
-- branches are forward-only), hence the only way to emit variable-LENGTH output. A forward-only call chain
-- (coalgate/ouroboros 'chain') has none.
func nc_mmj_func_backcall(code, i, n, fi):
    if i >= n:
        return false
    end
    if get(code, i).0 == 20:
        if get(code, i).1 <= fi:
            return true
        end
    end
    return nc_mmj_func_backcall(code, i + 1, n, fi)
end

func nc_mmj_has_backcall(funcs, i, nf):
    if i >= nf:
        return false
    end
    let code = get(funcs, i).4
    if nc_mmj_func_backcall(code, 0, count(code), i):
        return true
    end
    return nc_mmj_has_backcall(funcs, i + 1, nf)
end

-- anchored first-line directive "-- emit: module-mmj" (newline at mlen; the "-mmj" suffix is distinct from
-- "module-holler" / "multiboot32-ouroboros").
func nc_is_module_mmj(source):
    let marker = "-- emit: module-mmj"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

func nc_emit_module_mmj_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    let nf = count(funcs)
    if prog.2 != 0:
        let e0 = nc_fail(630, 0, "module-mmj: main not the entry (index 0)")
        return 0
    end
    let mainfn = get(funcs, 0)
    if not equal(mainfn.0, "main"):
        let e0b = nc_fail(630, 0, "module-mmj: entry function is not main")
        return 0
    end
    if mainfn.2 != 0:
        let e1 = nc_fail(631, 0, "module-mmj: main must take no parameters")
        return 0
    end
    if nc_ouro_total_sysread(funcs, 0, nf, 0) != 1:
        let e2 = nc_fail(632, 0, "module-mmj: program must read sys_read() exactly once")
        return 0
    end
    if nc_mmj_total_syswrite(funcs, 0, nf, 0) < 1:
        let e3 = nc_fail(633, 0, "module-mmj: program must sys_write() at least once (it emits its OWN output)")
        return 0
    end
    if nc_ouro_total_module(funcs, 0, nf, 0) != 0:
        let e4 = nc_fail(634, 0, "module-mmj: module_byte() is kernel-only; a module reads via sys_read()")
        return 0
    end
    if nc_ouro_total_input(funcs, 0, nf, 0) != 0:
        let e5 = nc_fail(635, 0, "module-mmj: input_byte() faults at CPL3; a module reads via sys_read()")
        return 0
    end
    if not nc_mmj_has_backcall(funcs, 0, nf):
        let e6 = nc_fail(636, 0, "module-mmj: requires genuine recursion (a backward call) -- the union, not a holler re-skin")
        return 0
    end
    if not nc_ouro_all_funcs_ok(funcs, 0, nf):
        return 0
    end
    let bases = nc_ouro_bases_loop(funcs, 0, nf, 0, new_array(int))
    let mbuf = new_buffer()
    mbuf = nc_ouro_emit_funcs(mbuf, funcs, 0, nf, bases)
    do fwriter(freeze(mbuf))
    return 0
end

-- ===== chiefturbo (link 26 / native-codegen Link 42): RUNTIME-INDEXED MEMORY. The compiled ring-3 module gains
-- a register-indexed load/store ([base+index*4]) into a runtime-filled buffer on its OWN User page, so it can
-- HOLD a stream of input it cannot fit in named slots and read any element back by a RUNTIME-COMPUTED index. It
-- REUSES the entire nc_ouro_* emitter (which now admits ops 49/50/51 in nc_ouro_op_allowed/pops/pushes/op_size/
-- lower_body -- NOT a duplicated op-emit, so toakie's pushint anchor + every prior op stay exactly-once) and adds
-- one main-only CAPTURE prologue (mov eax,esp; sub eax,0x1000; push eax -> alloc_lo at [ebp+0], which bufbase
-- reads). That +8-byte main prologue is the ONLY layout difference, so chiefturbo gets its own thin layout/emit
-- wrappers (arithmetic-only scaffolding; the op-byte lowering stays single-source in nc_ouro_lower_body). The
-- whole-program gate REPLACES mmj's recursion requirement with an INDEXED-OP requirement: >= 1 op 50/51. Runs on
-- the FROZEN holler kernel; byte-identical to chiefturbo_ref.target_module(), proven on QEMU+Bochs+KVM. =====

-- whole-program count of indexed memory ops (op 50 bufget / op 51 bufset). The module must carry >= 1, else it
-- is just an ouroboros/mmj re-skin (the headline capability is runtime-indexed memory, not a fixed slot).
func nc_chiefturbo_func_indexed(code, i, n, cnt):
    if i >= n:
        return cnt
    end
    let c = cnt
    if get(code, i).0 == 50:
        c = cnt + 1
    end
    if get(code, i).0 == 51:
        c = cnt + 1
    end
    return nc_chiefturbo_func_indexed(code, i + 1, n, c)
end

func nc_chiefturbo_total_indexed(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let code = get(funcs, i).4
    return nc_chiefturbo_total_indexed(funcs, i + 1, nf, acc + nc_chiefturbo_func_indexed(code, 0, count(code), 0))
end

func nc_chiefturbo_has_indexed_op(funcs, nf):
    return nc_chiefturbo_total_indexed(funcs, 0, nf, 0) >= 1
end

-- chiefturbo prologue length. IDENTICAL to nc_ouro_prologue_len EXCEPT main (frame>0) is 8 (MAIN_CAPTURE) + 5
-- (mov ebp,esp; sub esp,4S) = 13, because main stashes alloc_lo at [ebp+0] before its frame.
func nc_ct_prologue_len(is_main, nparams, frame):
    if frame == 0:
        return 0
    end
    if is_main == 1:
        return 13
    end
    return 6 + nparams * 6
end

func nc_ct_func_total(fn, is_main, frame):
    let code = fn.4
    let n = count(code)
    return nc_ct_prologue_len(is_main, fn.2, frame) + nc_ouro_body_size(code, 0, n, 0) + nc_ouro_epilogue_len(is_main, frame)
end

func nc_ct_bases_loop(funcs, i, nf, cur, bases):
    if i >= nf:
        return bases
    end
    do add(bases, cur)
    let fn = get(funcs, i)
    let is_main = 0
    if i == 0:
        is_main = 1
    end
    let frame = nc_ouro_frame_size(fn)
    return nc_ct_bases_loop(funcs, i + 1, nf, cur + nc_ct_func_total(fn, is_main, frame), bases)
end

-- main capture prologue: mov eax,esp (89 E0); sub eax,0x1000 (2D 00 10 00 00); push eax (50) -- captures
-- alloc_lo (=esp-0x1000, since esp==alloc_hi at module entry) at [ebp+0] for bufbase(). Then the normal main
-- frame (mov ebp,esp; sub esp,4S). Non-main prologues are IDENTICAL to nc_ouro_emit_prologue.
func nc_ct_emit_prologue(obuf, is_main, nparams, frame):
    if is_main == 1:
        do append(obuf, 137)   -- 89
        do append(obuf, 224)   -- E0  mov eax,esp
        do append(obuf, 45)    -- 2D  sub eax,
        obuf = nc_append_le32(obuf, 4096)   -- 0x1000
        do append(obuf, 80)    -- 50  push eax  (alloc_lo -> [ebp+0])
        do append(obuf, 137)   -- 89
        do append(obuf, 229)   -- E5  mov ebp,esp
        do append(obuf, 131)   -- 83
        do append(obuf, 236)   -- EC  sub esp,
        do append(obuf, 4 * frame)
        return obuf
    end
    do append(obuf, 85)    -- 55  push ebp
    do append(obuf, 137)   -- 89
    do append(obuf, 229)   -- E5  mov ebp,esp
    do append(obuf, 131)   -- 83
    do append(obuf, 236)   -- EC  sub esp,
    do append(obuf, 4 * frame)
    return nc_ouro_emit_param_copies(obuf, 0, nparams)
end

func nc_ct_emit_funcs(buf, funcs, i, nf, bases):
    if i >= nf:
        return buf
    end
    let fn = get(funcs, i)
    let code = fn.4
    let n = count(code)
    let is_main = 0
    if i == 0:
        is_main = 1
    end
    let frame = nc_ouro_frame_size(fn)
    if frame > 0:
        buf = nc_ct_emit_prologue(buf, is_main, fn.2, frame)
    end
    let pbase = get(bases, i) + nc_ct_prologue_len(is_main, fn.2, frame)
    let lay = nc_ouro_offsets_loop(code, 0, n, pbase, new_array(int))
    buf = nc_ouro_lower_body(buf, code, 0, n, lay.0, lay.1, bases)
    buf = nc_ouro_emit_epilogue(buf, is_main, frame)
    return nc_ct_emit_funcs(buf, funcs, i + 1, nf, bases)
end

-- anchored first-line directive "-- emit: module-chiefturbo" (newline at mlen; the "-chiefturbo" suffix is
-- distinct from "module-mmj" / "module-holler" / "multiboot32-ouroboros").
func nc_is_module_chiefturbo(source):
    let marker = "-- emit: module-chiefturbo"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

func nc_emit_module_chiefturbo_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    let nf = count(funcs)
    if prog.2 != 0:
        let e0 = nc_fail(630, 0, "module-chiefturbo: main not the entry (index 0)")
        return 0
    end
    let mainfn = get(funcs, 0)
    if not equal(mainfn.0, "main"):
        let e0b = nc_fail(630, 0, "module-chiefturbo: entry function is not main")
        return 0
    end
    if mainfn.2 != 0:
        let e1 = nc_fail(631, 0, "module-chiefturbo: main must take no parameters")
        return 0
    end
    if nc_ouro_total_sysread(funcs, 0, nf, 0) < 1:
        let e2 = nc_fail(632, 0, "module-chiefturbo: program must read sys_read() at least once")
        return 0
    end
    if nc_mmj_total_syswrite(funcs, 0, nf, 0) < 1:
        let e3 = nc_fail(633, 0, "module-chiefturbo: program must sys_write() at least once (it emits its OWN output)")
        return 0
    end
    if nc_ouro_total_module(funcs, 0, nf, 0) != 0:
        let e4 = nc_fail(634, 0, "module-chiefturbo: module_byte() is kernel-only; a module reads via sys_read()")
        return 0
    end
    if nc_ouro_total_input(funcs, 0, nf, 0) != 0:
        let e5 = nc_fail(635, 0, "module-chiefturbo: input_byte() faults at CPL3; a module reads via sys_read()")
        return 0
    end
    if not nc_chiefturbo_has_indexed_op(funcs, nf):
        let e6 = nc_fail(637, 0, "module-chiefturbo: requires an indexed memory op (bufget/bufset)")
        return 0
    end
    if not nc_ouro_all_funcs_ok(funcs, 0, nf):
        return 0
    end
    let bases = nc_ct_bases_loop(funcs, 0, nf, 0, new_array(int))
    let mbuf = new_buffer()
    mbuf = nc_ct_emit_funcs(mbuf, funcs, 0, nf, bases)
    do fwriter(freeze(mbuf))
    return 0
end

-- ===== mumbani (link 27 / native-codegen Link 43): MULTI-PAGE WORKING MEMORY. The kernel hands the compiled
-- module a working set LARGER THAN ONE PAGE (D20's second installment). TWO additive modes, NO change to any
-- existing mode: (1) module-mumbani = module-mmj with sys_read relaxed ==1 -> >=1 (the reverse forcing program
-- reads n + N words), reusing the ENTIRE nc_ouro_* emitter unchanged; (2) multiboot32-mumbani = the holler kernel
-- with npages=4 (3 alloc-size immediates 0x1000->0x4000 + the alloc_lo User-flip widened 1 PTE -> 4 PTEs). The
-- head blob is machine-generated from holler_ref.build_code(npages=4) (collision-proof diff recipe); PD/PT REUSE
-- geeking's loops verbatim (the 4-page User map is a RUNTIME flip in the head, not a PD/PT change); prefix_len is
-- UNCHANGED at 24564 (the extra flip bytes are absorbed by the pre-PD align-pad, like holler's do_write arm). =====

func nc_is_module_mumbani(source):
    let marker = "-- emit: module-mumbani"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- module-mumbani: the compiled recursive REVERSE module (reads n + N held-back words via readword, holds them in
-- the recursion stack, emits them reversed on unwind). IDENTICAL to module-mmj EXCEPT sys_read is relaxed from
-- exactly-once to at-least-once (reverse reads many). Reuses nc_ouro_emit_funcs wholesale -- no new op, no new
-- emit machinery. The genuinely-new capability is the KERNEL's multi-page region (multiboot32-mumbani), not the
-- module ISA. Byte-identical to mumbani_ref.target_module().
func nc_emit_module_mumbani_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    let nf = count(funcs)
    if prog.2 != 0:
        let e0 = nc_fail(640, 0, "module-mumbani: main not the entry (index 0)")
        return 0
    end
    let mainfn = get(funcs, 0)
    if not equal(mainfn.0, "main"):
        let e0b = nc_fail(640, 0, "module-mumbani: entry function is not main")
        return 0
    end
    if mainfn.2 != 0:
        let e1 = nc_fail(641, 0, "module-mumbani: main must take no parameters")
        return 0
    end
    if nc_ouro_total_sysread(funcs, 0, nf, 0) < 1:
        let e2 = nc_fail(642, 0, "module-mumbani: program must read sys_read() at least once")
