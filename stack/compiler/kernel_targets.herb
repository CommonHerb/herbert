-- mumbani (link 27): MULTI-PAGE WORKING MEMORY. Same body subset / layout / epilogue as holler (the kernel body
-- is a PURE CONDUIT reading module_byte once); the NEW capability is the 4-page allocator + 4-PTE User-flip in
-- the prefix. So this driver == holler's with nc32_mumbani_emit_prefix and the mumbani marker/fail-codes. Pairs
-- with the `module-mumbani` emit mode (the compiled recursive-reverse module).
func nc_emit_multiboot32_mumbani_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let fa = nc_fail(620, 0, "multiboot32-mumbani: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let fb = nc_fail(621, 0, "multiboot32-mumbani: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if nc32_count_module(code, n) != 1:
        let fi = nc_fail(622, 0, "multiboot32-mumbani: main must read module_byte() exactly once")
        return 0
    end
    if nc32_has_branch(code, n):
        let fh = nc_fail(623, 0, "multiboot32-mumbani: control flow (if/branch) not in the straight-line subset")
        return 0
    end
    let proxy = nc32_module_proxy(code, n)
    if not nc32_body_ok(proxy, n):
        let fc = nc_fail(624, 0, "multiboot32-mumbani: body not in the module/locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let fd = nc_fail(625, 0, "multiboot32-mumbani: too many locals (max 31)")
        return 0
    end
    let prefix_len = 24564
    if nlocals > 0:
        prefix_len = 24569
    end
    let lay = nc32_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let fe = nc_fail(626, 0, "multiboot32-mumbani: body length invariant")
        return 0
    end
    let code_len = prefix_len + bodylen + 58
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let cbuf = new_buffer()
    cbuf = nc32_mumbani_emit_prefix(cbuf, esp_top)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    let frozen_code = freeze(cbuf)
    if length(frozen_code) != code_len:
        let fg = nc_fail(627, 0, "multiboot32-mumbani: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader_pgalign(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

func nc_emit_multiboot32_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(450, 0, "multiboot32: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f6 = nc_fail(454, 0, "multiboot32: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f2 = nc_fail(451, 0, "multiboot32: body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(453, 0, "multiboot32: too many locals (max 31)")
        return 0
    end
    let prefix_len = 5
    if nlocals > 0:
        prefix_len = 10
    end
    let lay = nc32_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let f5 = nc_fail(452, 0, "multiboot32: body length invariant")
        return 0
    end
    let code_len = prefix_len + bodylen + 58
    let memsz = 12 + code_len + 16384
    let esp_val = 1048576 + memsz
    let cbuf = new_buffer()
    do append(cbuf, 188)
    cbuf = nc_append_le32(cbuf, esp_val)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    let frozen_code = freeze(cbuf)
    if length(frozen_code) != code_len:
        let f3 = nc_fail(452, 0, "multiboot32: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

-- zonday: the fixed 63-byte STRUCTURAL head (emitter-laid-out, like the ELF/MB
-- headers -- it is honest structure, not compiled Herbert). In execution order:
-- cli; lgdt my own GDT; far-jmp to reload CS=0x08; reload DS/ES/FS/GS/SS=0x10
-- (stale bootloader selectors index into MY new GDT -- QEMU and GRUB differ, so
-- they MUST be refreshed or one substrate triple-faults); mov esp (so the #DE
-- frame push lands in valid stack); lidt; then the #DE trigger (xor edx,edx; xor
-- ecx,ecx; div ecx); then the SENTINEL fall-through (mov al,0xBB; jmp epilogue --
-- reached only if the fault never fires, e.g. a mutation removed the trigger, so
-- a wrong byte is emitted -> RED); then the WRAPPER (the IDT gate vectors HERE):
-- cmp [esp], <faulting div EIP>; jne sentinel -- only a genuine #DE pushes that
-- EIP, so a non-fault entry cannot forge the proof; it then falls into the handler.
-- Three vaddrs are constants off V0=0x10000c (=1048588): far-jmp target V0+15,
-- the div EIP V0+45, the gate target (=this wrapper) V0+54. The GDTR/IDTR bases and
-- esp_top and the sentinel rel32 vary with the program and are passed in.
func nc32_idt_emit_head(buf, gdtr_vaddr, esp_top, idtr_vaddr, sentinel_rel32):
    do append(buf, 250)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 21)
    buf = nc_append_le32(buf, gdtr_vaddr)
    do append(buf, 234)
    buf = nc_append_le32(buf, 1048603)
    do append(buf, 8)
    do append(buf, 0)
    do append(buf, 102)
    do append(buf, 184)
    do append(buf, 16)
    do append(buf, 0)
    do append(buf, 142)
    do append(buf, 216)
    do append(buf, 142)
    do append(buf, 192)
    do append(buf, 142)
    do append(buf, 224)
    do append(buf, 142)
    do append(buf, 232)
    do append(buf, 142)
    do append(buf, 208)
    do append(buf, 188)
    buf = nc_append_le32(buf, esp_top)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 29)
    buf = nc_append_le32(buf, idtr_vaddr)
    do append(buf, 49)
    do append(buf, 210)
    do append(buf, 49)
    do append(buf, 201)
    do append(buf, 247)
    do append(buf, 241)
    do append(buf, 176)
    do append(buf, 187)
    do append(buf, 233)
    buf = nc_append_le32(buf, sentinel_rel32)
    do append(buf, 129)
    do append(buf, 60)
    do append(buf, 36)
    buf = nc_append_le32(buf, 1048633)
    do append(buf, 117)
    do append(buf, 240)
    return buf
end

-- zonday: the 44-byte data tables (emitter-laid-out at fixed vaddrs in the loaded
-- RWX image -- never built at runtime, so NO store-to-arbitrary-address primitive
-- is introduced, and typed-memory stays deferred). A flat 3-entry GDT (null + 32-bit
-- code 0x08 + 32-bit data 0x10), its GDTR (limit 23), a 1-entry IDT (vector 0/#DE:
-- gate offset = the wrapper vaddr, selector 0x0008, attr 0x8E = present/DPL0/32-bit
-- interrupt gate), and its IDTR (limit 7 -- only vector 0; any other exception finds
-- no gate -> triple-fault-reset, which is a correct RED for this fail-closed fixture).
func nc32_idt_emit_tables(buf, gdt_vaddr, idt_vaddr, gate_vaddr):
    buf = nc_emit_zeroes_loop(buf, 8)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 154)
    do append(buf, 207)
    do append(buf, 0)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 146)
    do append(buf, 207)
    do append(buf, 0)
    do append(buf, 23)
    do append(buf, 0)
    buf = nc_append_le32(buf, gdt_vaddr)
    let glo = gate_vaddr % 65536
    let ghi_full = gate_vaddr / 65536
    let ghi = ghi_full % 65536
    do append(buf, glo % 256)
    do append(buf, glo / 256)
    do append(buf, 8)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 142)
    do append(buf, ghi % 256)
    do append(buf, ghi / 256)
    do append(buf, 7)
    do append(buf, 0)
    buf = nc_append_le32(buf, idt_vaddr)
    return buf
end

-- zonday driver. Layout (vaddr V0=0x10000c): [HEAD 63] [handler: ebp-frame(0|5) +
-- toakie body + shared 58-byte epilogue] [tables 44]. The handler IS the compiled
-- main() body (toakie subset: locals, + - *, ==, if/else, return) -- the anti-
-- ceremony guard: the proof byte is produced by NORMAL compiled lowering, not a
-- canned blob. The handler has NO `mov esp` (the head already set it; the wrapper
-- validated the fault frame first) -- it runs below the #DE frame and falls into the
-- shared epilogue. It does NOT iret (a #DE re-faults on return; iret-resumption is a
-- deferred later link). Reuses lingo's ehdr/phdr/mbheader and toakie's verifier +
-- 2-pass layout/lowering + epilogue verbatim, so the existing modes are untouched.
func nc_emit_multiboot32_idt_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(455, 0, "multiboot32-idt: handler main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(456, 0, "multiboot32-idt: handler main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(457, 0, "multiboot32-idt: handler body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(458, 0, "multiboot32-idt: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(459, 0, "multiboot32-idt: body length invariant")
        return 0
    end
    let head_len = 63
    let hb = epi + 58
    let code_len = head_len + hb + 44
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let gdt_off = head_len + hb
    let gdt_vaddr = 1048588 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let idt_vaddr = gdtr_vaddr + 6
    let idtr_vaddr = idt_vaddr + 8
    let gate_vaddr = 1048642
    let epi_off_in_code = head_len + epi
    let sentinel_rel32 = epi_off_in_code - 54
    let cbuf = new_buffer()
    cbuf = nc32_idt_emit_head(cbuf, gdtr_vaddr, esp_top, idtr_vaddr, sentinel_rel32)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    cbuf = nc32_idt_emit_tables(cbuf, gdt_vaddr, idt_vaddr, gate_vaddr)
    let frozen_code = freeze(cbuf)
    if length(frozen_code) != code_len:
        let f6 = nc_fail(459, 0, "multiboot32-idt: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

-- timer: one `out imm8, al` (B0 val E6 port) -- byte output to a fixed port. The PIC
-- (0x20/0x21/0xA0/0xA1) and PIT (0x43/0x40) ports are all <= 0xFF, so the immediate-port
-- form is used; NO `in` (D18 port input stays deferred -- a full IMR write, not a
-- mask-preserving read).
func nc32_timer_out_imm(buf, val, port):
    do append(buf, 176)
    do append(buf, val)
    do append(buf, 230)
    do append(buf, port)
    return buf
end

-- timer (seventh kernel-arc link). The 97-byte HEAD: the 41-byte GDT-install (cli; lgdt;
-- far-jmp CS=0x08; reload DS/ES/FS/GS/SS=0x10; mov esp; lidt -- identical to zonday/chosen
-- up to here), then the NEW async setup: remap the 8259 PIC so IRQ0..15 land at vectors
-- 0x20..0x2F and unmask ONLY IRQ0 (full IMR writes, no read); program the 8254 PIT channel
-- 0 (mode 2, divisor 0xFFFF); `sti`; then a hlt-loop. The mainline here NEVER emits -- the
-- proof byte can only come via the asynchronous IRQ0 vectoring to the handler that follows.
func nc32_timer_emit_head(buf, gdtr_vaddr, esp_top, idtr_vaddr):
    do append(buf, 250)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 21)
    buf = nc_append_le32(buf, gdtr_vaddr)
    do append(buf, 234)
    buf = nc_append_le32(buf, 1048603)
    do append(buf, 8)
    do append(buf, 0)
    do append(buf, 102)
    do append(buf, 184)
    do append(buf, 16)
    do append(buf, 0)
    do append(buf, 142)
    do append(buf, 216)
    do append(buf, 142)
    do append(buf, 192)
    do append(buf, 142)
    do append(buf, 224)
    do append(buf, 142)
    do append(buf, 232)
    do append(buf, 142)
    do append(buf, 208)
    do append(buf, 188)
    buf = nc_append_le32(buf, esp_top)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 29)
    buf = nc_append_le32(buf, idtr_vaddr)
    buf = nc32_timer_out_imm(buf, 17, 32)
    buf = nc32_timer_out_imm(buf, 17, 160)
    buf = nc32_timer_out_imm(buf, 32, 33)
    buf = nc32_timer_out_imm(buf, 40, 161)
    buf = nc32_timer_out_imm(buf, 4, 33)
    buf = nc32_timer_out_imm(buf, 2, 161)
    buf = nc32_timer_out_imm(buf, 1, 33)
    buf = nc32_timer_out_imm(buf, 1, 161)
    buf = nc32_timer_out_imm(buf, 254, 33)
    buf = nc32_timer_out_imm(buf, 255, 161)
    buf = nc32_timer_out_imm(buf, 52, 67)
    buf = nc32_timer_out_imm(buf, 255, 64)
    buf = nc32_timer_out_imm(buf, 255, 64)
    do append(buf, 251)
    do append(buf, 244)
    do append(buf, 235)
    do append(buf, 253)
    return buf
end

-- tick (talkert): the 99-byte HEAD. Byte-identical to the 97-byte timer head EXCEPT it
-- inserts `xor esi,esi` (31 F6) immediately before `sti` -- zeroing the tick counter that
-- lives in esi and SURVIVES across the asynchronous interrupts (the CPU does not save/restore
-- GP registers on an interrupt-gate, and the idle mainline sti;hlt;jmp never touches esi, so
-- esi persists as architectural state from one IRQ0 to the next). NO pusha/popa: with an idle
-- mainline that holds no live GP register, save/restore would be ceremony -- worse, saving and
-- restoring esi around the handler's `inc esi` would PREVENT the counter from advancing. The
-- register-counter makes register-state-survival load-bearing instead (clobber esi -> RED).
-- NOTE the buffer variable is named `hbuf` (not the usual `buf`): this head deliberately
-- duplicates talcott's timer-head byte sequence (out_imm writes + sti;hlt;jmp tail), which
-- talcott's link23 MUTATION harness anchors on as `buf = nc32_timer_out_imm(buf, ...)` /
-- `do append(buf, 251)`. Using a distinct variable name keeps those anchors UNIQUE to the timer
-- head (the chosen/liberi/scottie/talcott "disambiguate a shared-block anchor at source" rule).
func nc32_tick_emit_head(hbuf, gdtr_vaddr, esp_top, idtr_vaddr):
    do append(hbuf, 250)
    do append(hbuf, 15)
    do append(hbuf, 1)
    do append(hbuf, 21)
    hbuf = nc_append_le32(hbuf, gdtr_vaddr)
    do append(hbuf, 234)
    hbuf = nc_append_le32(hbuf, 1048603)
    do append(hbuf, 8)
    do append(hbuf, 0)
    do append(hbuf, 102)
    do append(hbuf, 184)
    do append(hbuf, 16)
    do append(hbuf, 0)
    do append(hbuf, 142)
    do append(hbuf, 216)
    do append(hbuf, 142)
    do append(hbuf, 192)
    do append(hbuf, 142)
    do append(hbuf, 224)
    do append(hbuf, 142)
    do append(hbuf, 232)
    do append(hbuf, 142)
    do append(hbuf, 208)
    do append(hbuf, 188)
    hbuf = nc_append_le32(hbuf, esp_top)
    do append(hbuf, 15)
    do append(hbuf, 1)
    do append(hbuf, 29)
    hbuf = nc_append_le32(hbuf, idtr_vaddr)
    hbuf = nc32_timer_out_imm(hbuf, 17, 32)
    hbuf = nc32_timer_out_imm(hbuf, 17, 160)
    hbuf = nc32_timer_out_imm(hbuf, 32, 33)
    hbuf = nc32_timer_out_imm(hbuf, 40, 161)
    hbuf = nc32_timer_out_imm(hbuf, 4, 33)
    hbuf = nc32_timer_out_imm(hbuf, 2, 161)
    hbuf = nc32_timer_out_imm(hbuf, 1, 33)
    hbuf = nc32_timer_out_imm(hbuf, 1, 161)
    hbuf = nc32_timer_out_imm(hbuf, 254, 33)
    hbuf = nc32_timer_out_imm(hbuf, 255, 161)
    hbuf = nc32_timer_out_imm(hbuf, 52, 67)
    hbuf = nc32_timer_out_imm(hbuf, 255, 64)
    hbuf = nc32_timer_out_imm(hbuf, 255, 64)
    do append(hbuf, 49)
    do append(hbuf, 246)
    do append(hbuf, 251)
    do append(hbuf, 244)
    do append(hbuf, 235)
    do append(hbuf, 253)
    return hbuf
end

-- timer: the 300-byte data tables. A flat 3-entry GDT (null + 32-bit code 0x08 + 32-bit
-- data 0x10) + GDTR (limit 23); a 33-entry IDT -- vectors 0..31 NOT-PRESENT (fail-closed:
-- any masked IRQ or stray exception triple-faults, a correct RED), vector 0x20 = the IRQ0
-- gate (offset = the handler vaddr, selector 0x08, attr 0x8E = present/DPL0/32-bit
-- interrupt gate) -- + IDTR (limit 0x107). Emitter-laid-out at fixed vaddrs (no
-- store-to-arbitrary-address; typed-memory stays deferred).
func nc32_timer_emit_tables(buf, gdt_vaddr, idt_vaddr, gate_vaddr):
    buf = nc_emit_zeroes_loop(buf, 8)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 154)
    do append(buf, 207)
    do append(buf, 0)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 146)
    do append(buf, 207)
    do append(buf, 0)
    do append(buf, 23)
    do append(buf, 0)
    buf = nc_append_le32(buf, gdt_vaddr)
    buf = nc_emit_zeroes_loop(buf, 256)
    let glo = gate_vaddr % 65536
    let ghi_full = gate_vaddr / 65536
    let ghi = ghi_full % 65536
    do append(buf, glo % 256)
    do append(buf, glo / 256)
    do append(buf, 8)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 142)
    do append(buf, ghi % 256)
    do append(buf, ghi / 256)
    do append(buf, 7)
    do append(buf, 1)
    buf = nc_append_le32(buf, idt_vaddr)
    return buf
end

-- timer driver (the first ASYNCHRONOUS interrupt). Layout (vaddr V0=0x10000c):
-- [HEAD 97: GDT-install + PIC-remap + PIT-program + sti + hlt-loop] [HANDLER: ebp-frame(0|5)
-- + compiled toakie body + shared 58-byte epilogue] [TABLES 300]. The handler IS the
-- compiled main() body (toakie subset), reached ONLY via the IDT vec-0x20 gate when the
-- PIT's IRQ0 fires asynchronously -- the anti-ceremony guard: the proof byte is produced by
-- NORMAL compiled lowering on the async path, and the mainline head never emits. MINIMAL:
-- exit-on-first-IRQ (the epilogue's isa-debug-exit / Bochs power-off fire before any second
-- tick) -- NO EOI, NO iret-resume (those are the next link). Reuses zonday's GDT-install
-- shape + toakie's verifier/2-pass layout/lowering + the shared epilogue verbatim, so the
-- six prior emit modes stay byte-identical (the self-host fixpoint gen2==gen1 is preserved).
func nc_emit_multiboot32_timer_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(481, 0, "multiboot32-timer: handler main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(482, 0, "multiboot32-timer: handler main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(483, 0, "multiboot32-timer: handler body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(484, 0, "multiboot32-timer: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(485, 0, "multiboot32-timer: body length invariant")
        return 0
    end
    let head_len = 97
    let hb = epi + 58
    let tables_len = 300
    let code_len = head_len + hb + tables_len
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let gdt_off = head_len + hb
    let gdt_vaddr = 1048588 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let idt_vaddr = gdtr_vaddr + 6
    let idtr_vaddr = idt_vaddr + 264
    let gate_vaddr = 1048588 + head_len
    let cbuf = new_buffer()
    cbuf = nc32_timer_emit_head(cbuf, gdtr_vaddr, esp_top, idtr_vaddr)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    cbuf = nc32_timer_emit_tables(cbuf, gdt_vaddr, idt_vaddr, gate_vaddr)
    let frozen_code = freeze(cbuf)
    if length(frozen_code) != code_len:
        let f6 = nc_fail(485, 0, "multiboot32-timer: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

-- tick (talkert, eighth kernel-arc link): the acknowledged / periodic timer. Layout
-- (vaddr V0=0x10000c): [HEAD 99: GDT-install + PIC-remap + PIT-program + xor esi,esi + sti +
-- hlt-loop] [HANDLER: inc esi; cmp esi,3; jb .ack; ebp-frame(0|5) + compiled body + epilogue;
-- .ack: EOI(out 0x20,0x20) + iret] [TABLES 300 (reused verbatim from timer, parametric on the
-- gate vaddr = V0+99)]. On each IRQ0 the handler counts the tick in esi; for the first N-1=2
-- ticks it ACKNOWLEDGES the PIC and `iret`-RESUMES the mainline (the first async iret-resume --
-- an IRQ frame has NO error code, so NO `add esp,4`, unlike scottie's #PF); on the Nth (3rd)
-- tick esi==3 so it falls through to the compiled body + the shared epilogue, which emits the
-- proof byte and exits. The byte = the compiled body's return value (anti-ceremony: it tracks
-- the body) AND can only appear after surviving N ticks (it tracks the count). Deterministic by
-- COUNT, not wall-time (QEMU vs Bochs PIT rates differ; exit on esi==N is timing-independent).
-- Pays D19's async-SURVIVAL half (EOI + iret-resume + periodicity) that talcott deferred.
func nc_emit_multiboot32_tick_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(486, 0, "multiboot32-tick: handler main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(487, 0, "multiboot32-tick: handler main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(488, 0, "multiboot32-tick: handler body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(489, 0, "multiboot32-tick: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(490, 0, "multiboot32-tick: body length invariant")
        return 0
    end
    let head_len = 99
    let hb = epi + 73
    let tables_len = 300
    let code_len = head_len + hb + tables_len
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let gdt_off = head_len + hb
    let gdt_vaddr = 1048588 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let idt_vaddr = gdtr_vaddr + 6
    let idtr_vaddr = idt_vaddr + 264
    let gate_vaddr = head_len + 1048588
    let cbuf = new_buffer()
    cbuf = nc32_tick_emit_head(cbuf, gdtr_vaddr, esp_top, idtr_vaddr)
    do append(cbuf, 70)
    do append(cbuf, 131)
    do append(cbuf, 254)
    do append(cbuf, 3)
    do append(cbuf, 15)
    do append(cbuf, 130)
    let jb_rel = epi + 58
    cbuf = nc_append_le32(cbuf, jb_rel)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    do append(cbuf, 176)
    do append(cbuf, 32)
    do append(cbuf, 230)
    do append(cbuf, 32)
    do append(cbuf, 207)
    cbuf = nc32_timer_emit_tables(cbuf, gdt_vaddr, idt_vaddr, gate_vaddr)
    let frozen_code = freeze(cbuf)
    if length(frozen_code) != code_len:
        let f6 = nc_fail(491, 0, "multiboot32-tick: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

-- rizzing (the ELEVENTH kernel-arc link): the freestanding image's first MAINLINE task
-- that synchronizes with the timer ISR through a SHARED MEMORY word. Reuses talkert's
-- 32-bit substrate but: the tick counter moves esi -> a memory word `tick`; the IRQ0 ISR
-- becomes PURE GLUE (push eax; inc dword [tick]; EOI; pop eax; iret) -- it preserves the
-- mainline's eax (else an IRQ between the spin's load and compare corrupts the test; the
-- Bochs substrate caught this); the compiled body moves from the handler to the MAINLINE,
-- which SPINS on [tick] (mov eax,[tick]; cmp eax,N; jb) until N ticks have accrued, then cli
-- and runs the compiled body + the shared epilogue (proof byte = the body's return value,
-- reachable only after surviving N async ticks). The IDT vec-0x20 gate points at the glue
-- ISR. The compiled body uses the EXISTING control-flow+locals subset UNCHANGED (no widen),
-- so the ten prior modes stay byte-identical and the self-host fixpoint is preserved.
func nc32_rizz_emit_head(rbuf, gdtr_vaddr, esp_top, idtr_vaddr, tick_vaddr):
    do append(rbuf, 250)
    do append(rbuf, 15)
    do append(rbuf, 1)
    do append(rbuf, 21)
    rbuf = nc_append_le32(rbuf, gdtr_vaddr)
    do append(rbuf, 234)
    rbuf = nc_append_le32(rbuf, 1048603)
    do append(rbuf, 8)
    do append(rbuf, 0)
    do append(rbuf, 102)
    do append(rbuf, 184)
    do append(rbuf, 16)
    do append(rbuf, 0)
    do append(rbuf, 142)
    do append(rbuf, 216)
    do append(rbuf, 142)
    do append(rbuf, 192)
    do append(rbuf, 142)
    do append(rbuf, 224)
    do append(rbuf, 142)
    do append(rbuf, 232)
    do append(rbuf, 142)
    do append(rbuf, 208)
    do append(rbuf, 188)
    rbuf = nc_append_le32(rbuf, esp_top)
    do append(rbuf, 15)
    do append(rbuf, 1)
    do append(rbuf, 29)
    rbuf = nc_append_le32(rbuf, idtr_vaddr)
    rbuf = nc32_timer_out_imm(rbuf, 17, 32)
    rbuf = nc32_timer_out_imm(rbuf, 17, 160)
    rbuf = nc32_timer_out_imm(rbuf, 32, 33)
    rbuf = nc32_timer_out_imm(rbuf, 40, 161)
    rbuf = nc32_timer_out_imm(rbuf, 4, 33)
    rbuf = nc32_timer_out_imm(rbuf, 2, 161)
    rbuf = nc32_timer_out_imm(rbuf, 1, 33)
    rbuf = nc32_timer_out_imm(rbuf, 1, 161)
    rbuf = nc32_timer_out_imm(rbuf, 254, 33)
    rbuf = nc32_timer_out_imm(rbuf, 255, 161)
    rbuf = nc32_timer_out_imm(rbuf, 52, 67)
    rbuf = nc32_timer_out_imm(rbuf, 255, 64)
    rbuf = nc32_timer_out_imm(rbuf, 255, 64)
    do append(rbuf, 199)
    do append(rbuf, 5)
    rbuf = nc_append_le32(rbuf, tick_vaddr)
    rbuf = nc_append_le32(rbuf, 0)
    do append(rbuf, 251)
    return rbuf
end

func nc_emit_multiboot32_rizzing_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(492, 0, "multiboot32-rizzing: task main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(493, 0, "multiboot32-rizzing: task main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(494, 0, "multiboot32-rizzing: task body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(495, 0, "multiboot32-rizzing: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(496, 0, "multiboot32-rizzing: body length invariant")
        return 0
    end
    let head_len = 104
    let glue_len = 11
    let isr_len = 13
    let mainline_len = head_len + glue_len + epi + 58
    let isr_off = mainline_len
    let tables_off = isr_off + isr_len
    let tick_off = nc32_roundup4(tables_off + 300)
    let code_len = tick_off + 4
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let gate_vaddr = 1048588 + isr_off
    let gdt_vaddr = 1048588 + tables_off
    let gdtr_vaddr = gdt_vaddr + 24
    let idt_vaddr = gdtr_vaddr + 6
    let idtr_vaddr = idt_vaddr + 264
    let tick_vaddr = 1048588 + tick_off
    let mbuf = new_buffer()
    mbuf = nc32_rizz_emit_head(mbuf, gdtr_vaddr, esp_top, idtr_vaddr, tick_vaddr)
    do append(mbuf, 161)
    mbuf = nc_append_le32(mbuf, tick_vaddr)
    do append(mbuf, 131)
    do append(mbuf, 248)
    do append(mbuf, 3)
    do append(mbuf, 114)
    do append(mbuf, 246)
    do append(mbuf, 250)
    if nlocals > 0:
        do append(mbuf, 137)
        do append(mbuf, 229)
        do append(mbuf, 131)
        do append(mbuf, 236)
        do append(mbuf, 4 * nlocals)
    end
    mbuf = append_str(mbuf, freeze(bodybuf))
    mbuf = nc32_emit_epilogue(mbuf)
    do append(mbuf, 80)
    do append(mbuf, 255)
    do append(mbuf, 5)
    mbuf = nc_append_le32(mbuf, tick_vaddr)
    do append(mbuf, 176)
    do append(mbuf, 32)
    do append(mbuf, 230)
    do append(mbuf, 32)
    do append(mbuf, 88)
    do append(mbuf, 207)
    mbuf = nc32_timer_emit_tables(mbuf, gdt_vaddr, idt_vaddr, gate_vaddr)
    mbuf = nc_emit_zeroes_loop(mbuf, tick_off - tables_off - 300)
    mbuf = nc_append_le32(mbuf, 0)
    let frozen_code = freeze(mbuf)
    if length(frozen_code) != code_len:
        let f6 = nc_fail(497, 0, "multiboot32-rizzing: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

func nc_is_multiboot32_rizzing(source):
    let marker = "-- emit: multiboot32-rizzing"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- bluefield (the TWELFTH kernel-arc link): the freestanding image's first PREEMPTIVE
-- CONTEXT SWITCH between two tasks. Reuses talkert/rizzing's 32-bit substrate (GDT-install,
-- PIC remap, PIT program, the flat tables) but the IRQ0 ISR is no longer pure glue: it is a
-- SCHEDULER that saves the running task's full GP+esp context into its TCB slot and restores
-- the other task's (pusha; save esp -> [tcb+cur*4]; flip cur; load esp <- [tcb+cur*4]; EOI;
-- popa; iret). Task B is started "from cold" via a pre-laid 44-byte SEEDED stack block (8 GP
-- dwords in popa order + an iret frame eip=B_entry, cs=0x08, eflags=0x202). The forcing
-- observable is count-deterministic (a two-flag aready/bran handshake, NOT wall-time): task A's
-- compiled body computes vA, A CARRIES it in edx (a register the toakie/rizzing lowering never
-- writes), sets aready, then SPINS on bran; the timer preempts A, the scheduler switches to B,
-- B writes its marker vB to [shared], waits on aready, CLOBBERS edx (mov edx,0xB7B7B7B7), sets
-- bran, and spins; the timer preempts B, the scheduler restores A's edx=vA, and A recovers
-- (mov eax,edx; add eax,[shared]) and emits the proof byte = (vA + vB) mod 256 via the shared
-- 58-byte epilogue. The byte is correct ONLY if the switch genuinely SAVED A's edx (pusha onto
-- A's stack) across B's clobber and RESTORED it (popa) -- a fake/absent switch yields a wrong
-- byte or no frame. Task A's compiled body uses the EXISTING control-flow+locals subset
-- UNCHANGED (no widen); task B is hand-emitted glue (lower_program_poly prunes from main, so a
-- second compiled task would be dead-pruned -- the non-proof task is glue, like rizzing's ISR),
-- so the eleven prior emit modes stay byte-identical and the self-host fixpoint gen2==gen1 holds.
-- Graded on the far-axis DUAL-SUBSTRATE oracle (QEMU + Bochs vs a host-derived golden), not C.
-- HONEST SCOPE: this is a preemptive ring-0 GP+esp+eip+eflags context switch, NOT a full
-- architectural one (no segment regs / CR3 / FPU / per-task address space).
func nc32_bf_emit_head(bfh, gdtr_vaddr, esp_top, idtr_vaddr, cur_vaddr, tcb1_vaddr, seed_vaddr):
    do append(bfh, 250)
    do append(bfh, 15)
    do append(bfh, 1)
    do append(bfh, 21)
    bfh = nc_append_le32(bfh, gdtr_vaddr)
    do append(bfh, 234)
    bfh = nc_append_le32(bfh, 1048603)
    do append(bfh, 8)
    do append(bfh, 0)
    do append(bfh, 102)
    do append(bfh, 184)
    do append(bfh, 16)
    do append(bfh, 0)
    do append(bfh, 142)
    do append(bfh, 216)
    do append(bfh, 142)
    do append(bfh, 192)
    do append(bfh, 142)
    do append(bfh, 224)
    do append(bfh, 142)
    do append(bfh, 232)
    do append(bfh, 142)
    do append(bfh, 208)
    do append(bfh, 188)
    bfh = nc_append_le32(bfh, esp_top)
    do append(bfh, 15)
    do append(bfh, 1)
    do append(bfh, 29)
    bfh = nc_append_le32(bfh, idtr_vaddr)
    bfh = nc32_timer_out_imm(bfh, 17, 32)
    bfh = nc32_timer_out_imm(bfh, 17, 160)
    bfh = nc32_timer_out_imm(bfh, 32, 33)
    bfh = nc32_timer_out_imm(bfh, 40, 161)
    bfh = nc32_timer_out_imm(bfh, 4, 33)
    bfh = nc32_timer_out_imm(bfh, 2, 161)
    bfh = nc32_timer_out_imm(bfh, 1, 33)
    bfh = nc32_timer_out_imm(bfh, 1, 161)
    bfh = nc32_timer_out_imm(bfh, 254, 33)
    bfh = nc32_timer_out_imm(bfh, 255, 161)
    bfh = nc32_timer_out_imm(bfh, 52, 67)
    bfh = nc32_timer_out_imm(bfh, 255, 64)
    bfh = nc32_timer_out_imm(bfh, 255, 64)
    do append(bfh, 199)
    do append(bfh, 5)
    bfh = nc_append_le32(bfh, cur_vaddr)
    bfh = nc_append_le32(bfh, 0)
    do append(bfh, 199)
    do append(bfh, 5)
    bfh = nc_append_le32(bfh, tcb1_vaddr)
    bfh = nc_append_le32(bfh, seed_vaddr)
    do append(bfh, 251)
    return bfh
end

func nc_emit_multiboot32_bluefield_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(498, 0, "multiboot32-bluefield: task A main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(499, 0, "multiboot32-bluefield: task A main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(500, 0, "multiboot32-bluefield: task A body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(501, 0, "multiboot32-bluefield: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(502, 0, "multiboot32-bluefield: body length invariant")
        return 0
    end
    -- task A = ebp_prefix + body + a_glue(31: carry 2 + ready 10 + spin 11 + recover 2 + add 6) + epilogue 58
    let a_len = ebp_prefix + bodylen + 31 + 58
    let off_A = 114
    let off_B = off_A + a_len
    let off_sched = off_B + 37
    let off_tables = off_sched + 34
    let off_after = off_tables + 300
    let off_data = nc32_roundup4(off_after)
    let cur_vaddr = 1048588 + off_data
    let tcb_vaddr = 1048588 + off_data + 4
    let tcb1_vaddr = tcb_vaddr + 4
    let aready_vaddr = 1048588 + off_data + 12
    let bran_vaddr = 1048588 + off_data + 16
    let shared_vaddr = 1048588 + off_data + 20
    let off_seed = off_data + 24 + 256
    let seed_vaddr = 1048588 + off_seed
    let code_len = off_seed + 44 + 16
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let gate_vaddr = 1048588 + off_sched
    let gdt_vaddr = 1048588 + off_tables
    let gdtr_vaddr = gdt_vaddr + 24
    let idt_vaddr = gdtr_vaddr + 6
    let idtr_vaddr = idt_vaddr + 264
    let b_entry = 1048588 + off_B
    let bfm = new_buffer()
    bfm = nc32_bf_emit_head(bfm, gdtr_vaddr, esp_top, idtr_vaddr, cur_vaddr, tcb1_vaddr, seed_vaddr)
    if nlocals > 0:
        do append(bfm, 137)
        do append(bfm, 229)
        do append(bfm, 131)
        do append(bfm, 236)
        do append(bfm, 4 * nlocals)
    end
    bfm = append_str(bfm, freeze(bodybuf))
    do append(bfm, 137)
    do append(bfm, 194)
    do append(bfm, 199)
    do append(bfm, 5)
    bfm = nc_append_le32(bfm, aready_vaddr)
    bfm = nc_append_le32(bfm, 1)
    do append(bfm, 161)
    bfm = nc_append_le32(bfm, bran_vaddr)
    do append(bfm, 131)
    do append(bfm, 248)
    do append(bfm, 1)
    do append(bfm, 117)
    do append(bfm, 246)
    do append(bfm, 250)
    do append(bfm, 137)
    do append(bfm, 208)
    do append(bfm, 3)
    do append(bfm, 5)
    bfm = nc_append_le32(bfm, shared_vaddr)
    bfm = nc32_emit_epilogue(bfm)
    do append(bfm, 184)
    bfm = nc_append_le32(bfm, 46)
    do append(bfm, 163)
    bfm = nc_append_le32(bfm, shared_vaddr)
    do append(bfm, 161)
    bfm = nc_append_le32(bfm, aready_vaddr)
    do append(bfm, 131)
    do append(bfm, 248)
    do append(bfm, 1)
    do append(bfm, 117)
    do append(bfm, 246)
    do append(bfm, 186)
    do append(bfm, 183)
    do append(bfm, 183)
    do append(bfm, 183)
    do append(bfm, 183)
    do append(bfm, 199)
    do append(bfm, 5)
    bfm = nc_append_le32(bfm, bran_vaddr)
    bfm = nc_append_le32(bfm, 1)
    do append(bfm, 235)
    do append(bfm, 254)
    do append(bfm, 96)
    do append(bfm, 161)
    bfm = nc_append_le32(bfm, cur_vaddr)
    do append(bfm, 137)
    do append(bfm, 36)
    do append(bfm, 133)
    bfm = nc_append_le32(bfm, tcb_vaddr)
    do append(bfm, 131)
    do append(bfm, 240)
    do append(bfm, 1)
    do append(bfm, 163)
    bfm = nc_append_le32(bfm, cur_vaddr)
    do append(bfm, 139)
    do append(bfm, 36)
    do append(bfm, 133)
    bfm = nc_append_le32(bfm, tcb_vaddr)
    do append(bfm, 176)
    do append(bfm, 32)
    do append(bfm, 230)
    do append(bfm, 32)
    do append(bfm, 97)
    do append(bfm, 207)
    bfm = nc32_timer_emit_tables(bfm, gdt_vaddr, idt_vaddr, gate_vaddr)
    bfm = nc_emit_zeroes_loop(bfm, off_data - off_after)
    bfm = nc_emit_zeroes_loop(bfm, 24)
    bfm = nc_emit_zeroes_loop(bfm, 256)
    bfm = nc_emit_zeroes_loop(bfm, 32)
    bfm = nc_append_le32(bfm, b_entry)
    bfm = nc_append_le32(bfm, 8)
    bfm = nc_append_le32(bfm, 514)
    bfm = nc_emit_zeroes_loop(bfm, 16)
    let frozen_code = freeze(bfm)
    if length(frozen_code) != code_len:
        let f6 = nc_fail(503, 0, "multiboot32-bluefield: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

func nc_is_multiboot32_bluefield(source):
    let marker = "-- emit: multiboot32-bluefield"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- ============================================================================
-- contigo (fifteenth kernel-arc link / f1): the first DATA-DEPENDENT scheduling
-- decision. The timer-IRQ0 scheduler READS an input-derived state cell (inq, set
-- by the mainline from a late-bound COM1 byte) and takes a cmp;jcc to SELECT which
-- of two seeded tasks to dispatch via iret. Selected by "-- emit: multiboot32-contigo".
-- Layout (V0=0x10000c): [HEAD' 174: GDT-install + UART init + PIC-remap + PIT-program
-- + input read->inq + sti + jmp$ idle] [TASK A: ebp? + compiled body + epilogue 58]
-- [TASK B: mov eax,46 + epilogue 58] [SCHEDULER 30] [TABLES 300] [inq 8] [seedA 44]
-- [seedB 44] [guard 16]. Seed eflags = 0x002 (IF=0): one-shot cold dispatch (the task
-- runs uninterrupted to hlt, so no re-preemption / double-emit). The mainline idles
-- (jmp $) and NEVER emits; both tasks are reached ONLY via the scheduler's iret.
-- ============================================================================
func nc32_co_emit_head(coh, gdtr_vaddr, esp_top, idtr_vaddr, inq_vaddr):
    do append(coh, 250)
    do append(coh, 15)
    do append(coh, 1)
    do append(coh, 21)
    coh = nc_append_le32(coh, gdtr_vaddr)
    do append(coh, 234)
    coh = nc_append_le32(coh, 1048603)
    do append(coh, 8)
    do append(coh, 0)
    do append(coh, 102)
    do append(coh, 184)
    do append(coh, 16)
    do append(coh, 0)
    do append(coh, 142)
    do append(coh, 216)
    do append(coh, 142)
    do append(coh, 192)
    do append(coh, 142)
    do append(coh, 224)
    do append(coh, 142)
    do append(coh, 232)
    do append(coh, 142)
    do append(coh, 208)
    do append(coh, 188)
    coh = nc_append_le32(coh, esp_top)
    do append(coh, 15)
    do append(coh, 1)
    do append(coh, 29)
    coh = nc_append_le32(coh, idtr_vaddr)
    coh = nc32_uart_init(coh)
    coh = nc32_timer_out_imm(coh, 17, 32)
    coh = nc32_timer_out_imm(coh, 17, 160)
    coh = nc32_timer_out_imm(coh, 32, 33)
    coh = nc32_timer_out_imm(coh, 40, 161)
    coh = nc32_timer_out_imm(coh, 4, 33)
    coh = nc32_timer_out_imm(coh, 2, 161)
    coh = nc32_timer_out_imm(coh, 1, 33)
    coh = nc32_timer_out_imm(coh, 1, 161)
    coh = nc32_timer_out_imm(coh, 254, 33)
    coh = nc32_timer_out_imm(coh, 255, 161)
    coh = nc32_timer_out_imm(coh, 52, 67)
    coh = nc32_timer_out_imm(coh, 255, 64)
    coh = nc32_timer_out_imm(coh, 255, 64)
    do append(coh, 102)
    do append(coh, 186)
    do append(coh, 253)
    do append(coh, 3)
    do append(coh, 236)
    do append(coh, 168)
    do append(coh, 1)
    do append(coh, 116)
    do append(coh, 247)
    do append(coh, 102)
    do append(coh, 186)
    do append(coh, 248)
    do append(coh, 3)
    do append(coh, 236)
    do append(coh, 15)
    do append(coh, 182)
    do append(coh, 192)
    do append(coh, 163)
    coh = nc_append_le32(coh, inq_vaddr)
    do append(coh, 251)
    do append(coh, 235)
    do append(coh, 254)
    return coh
end

func nc_emit_multiboot32_contigo_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(514, 0, "multiboot32-contigo: task A main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(515, 0, "multiboot32-contigo: task A main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(516, 0, "multiboot32-contigo: task A body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(517, 0, "multiboot32-contigo: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(518, 0, "multiboot32-contigo: body length invariant")
        return 0
    end
    let off_A = 174
    let a_len = ebp_prefix + bodylen + 58
    let off_B = off_A + a_len
    let off_sched = off_B + 63
    let off_tables = off_sched + 30
    let off_after = off_tables + 300
    let off_data = nc32_roundup4(off_after)
    let inq_vaddr = 1048588 + off_data
    -- each task runs on its OWN 256-byte stack laid BELOW its seed (the seed's iret frame sits at the
    -- TOP): after `mov esp,seed; popa; iret` esp = seed+44 and the body's rbp frame + pushes grow DOWN
    -- through the dead seed into the 256-byte reserve -- so even a 31-local body never reaches inq /
    -- the tables / live code (closes the cross-model seed-stack-clobber flag; bluefield ran task A on
    -- the big mainline stack, but contigo dispatches BOTH tasks onto seeds, so each needs real headroom).
    let off_stackA = off_data + 8
    let off_seedA = off_stackA + 256
    let off_stackB = off_seedA + 44
    let off_seedB = off_stackB + 256
    let off_guard = off_seedB + 44
    let code_len = off_guard + 16
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let gate_vaddr = 1048588 + off_sched
    let gdt_vaddr = 1048588 + off_tables
    let gdtr_vaddr = gdt_vaddr + 24
    let idt_vaddr = gdtr_vaddr + 6
    let idtr_vaddr = idt_vaddr + 264
    let seedA_vaddr = 1048588 + off_seedA
    let seedB_vaddr = 1048588 + off_seedB
    let a_entry = 1048588 + off_A
    let b_entry = 1048588 + off_B
    let com = new_buffer()
    com = nc32_co_emit_head(com, gdtr_vaddr, esp_top, idtr_vaddr, inq_vaddr)
    if nlocals > 0:
        do append(com, 137)
        do append(com, 229)
        do append(com, 131)
        do append(com, 236)
        do append(com, 4 * nlocals)
    end
    com = append_str(com, freeze(bodybuf))
    com = nc32_emit_epilogue(com)
    do append(com, 184)
    com = nc_append_le32(com, 46)
    com = nc32_emit_epilogue(com)
    do append(com, 176)
    do append(com, 32)
    do append(com, 230)
    do append(com, 32)
    do append(com, 161)
    com = nc_append_le32(com, inq_vaddr)
    do append(com, 61)
    com = nc_append_le32(com, 128)
    do append(com, 115)
    do append(com, 7)
    do append(com, 188)
    com = nc_append_le32(com, seedA_vaddr)
    do append(com, 235)
    do append(com, 5)
    do append(com, 188)
    com = nc_append_le32(com, seedB_vaddr)
    do append(com, 97)
    do append(com, 207)
    com = nc32_timer_emit_tables(com, gdt_vaddr, idt_vaddr, gate_vaddr)
    com = nc_emit_zeroes_loop(com, off_data - off_after)
    com = nc_append_le32(com, 0)
    com = nc_emit_zeroes_loop(com, 4)
    com = nc_emit_zeroes_loop(com, 256)
    com = nc_emit_zeroes_loop(com, 32)
    com = nc_append_le32(com, a_entry)
    com = nc_append_le32(com, 8)
    com = nc_append_le32(com, 2)
    com = nc_emit_zeroes_loop(com, 256)
    com = nc_emit_zeroes_loop(com, 32)
    com = nc_append_le32(com, b_entry)
    com = nc_append_le32(com, 8)
    com = nc_append_le32(com, 2)
    com = nc_emit_zeroes_loop(com, 16)
    let frozen_code = freeze(com)
    if length(frozen_code) != code_len:
        let f6 = nc_fail(519, 0, "multiboot32-contigo: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

func nc_is_multiboot32_contigo(source):
    let marker = "-- emit: multiboot32-contigo"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- ============================================================================
-- cloggard (sixteenth kernel-arc link / f1-deepening): the first DATA-DEPENDENT
-- MULTI-QUANTUM scheduler -- a timer-IRQ0 run-queue that dispatches a SEQUENCE of
-- K=4 WARM tasks (bluefield save/restore sustained across quanta) and emits an
-- ordered TRACE on 0xE9, the schedule being a function of runtime input recomputed
-- EACH quantum (contigo's input-select, made a sequence). Selected by the directive
-- "-- emit: multiboot32-cloggard". Layout (V0=0x10000c): [HEAD 224: GDT-install +
-- UART + PIC/PIT + input read->inq + init {pos,done,cur,tcb0,tcb1} + sti + jmp$ idle]
-- [TASK A: mov esp,stackA + ebp? + body (->edi=vA) + accumulate/emit glue 37] [TASK B:
-- mov esp,stackB + marker glue 38] [SCHEDULER 128] [TABLES 300] [cells 24][seedA 44]
-- [seedB 44][stackA 256][stackB 256][guard 16]. Seeds eflags=0x202 (IF=1). Each
-- task per grant: inc acc; emit "DE (base+acc) AD"; mov [done],1; hlt (park); loop.
-- The scheduler advances ONLY on [done]==1 (DONE-FLAG INTERLOCK -- the per-grant unit
-- is bounded by the hlt and gated by done, so the K-byte trace is bit-identical on
-- QEMU and Bochs regardless of tick timing); next=(inq>>pos)&1 reads [inq] each
-- quantum; exit (isa-debug-exit + Bochs power-off) when pos>=K AND [done]==1.
-- ============================================================================
-- 15-byte framed emit: al -> "DE al AD" on 0xE9. Buffer `clf` not `buf` (anchor-collision: link25/26).
func nc32_clog_frame(clf):
    do append(clf, 136)
    do append(clf, 195)
    do append(clf, 102)
    do append(clf, 186)
    do append(clf, 233)
    do append(clf, 0)
    do append(clf, 176)
    do append(clf, 222)
    do append(clf, 238)
    do append(clf, 136)
    do append(clf, 216)
    do append(clf, 238)
    do append(clf, 176)
    do append(clf, 173)
    do append(clf, 238)
    return clf
end

-- one task tail: framed emit + mov [done],1 + hlt + jmp <rel8 back to the loop head>.
func nc32_clog_task_tail(clf, done_vaddr, jmprel):
    clf = nc32_clog_frame(clf)
    do append(clf, 199)
    do append(clf, 5)
    clf = nc_append_le32(clf, done_vaddr)
    clf = nc_append_le32(clf, 1)
    do append(clf, 244)
    do append(clf, 235)
    do append(clf, jmprel)
    return clf
end

func nc32_clog_emit_head(clh, gdtr_vaddr, esp_top, idtr_vaddr, inq_vaddr, pos_vaddr, done_vaddr, cur_vaddr, tcb0_vaddr, tcb1_vaddr, seedA_vaddr, seedB_vaddr):
    do append(clh, 250)
    do append(clh, 15)
    do append(clh, 1)
    do append(clh, 21)
    clh = nc_append_le32(clh, gdtr_vaddr)
    do append(clh, 234)
    clh = nc_append_le32(clh, 1048603)
    do append(clh, 8)
    do append(clh, 0)
    do append(clh, 102)
    do append(clh, 184)
    do append(clh, 16)
    do append(clh, 0)
    do append(clh, 142)
    do append(clh, 216)
    do append(clh, 142)
    do append(clh, 192)
    do append(clh, 142)
    do append(clh, 224)
    do append(clh, 142)
    do append(clh, 232)
    do append(clh, 142)
    do append(clh, 208)
    do append(clh, 188)
    clh = nc_append_le32(clh, esp_top)
    do append(clh, 15)
    do append(clh, 1)
    do append(clh, 29)
    clh = nc_append_le32(clh, idtr_vaddr)
    clh = nc32_uart_init(clh)
    clh = nc32_timer_out_imm(clh, 17, 32)
    clh = nc32_timer_out_imm(clh, 17, 160)
    clh = nc32_timer_out_imm(clh, 32, 33)
    clh = nc32_timer_out_imm(clh, 40, 161)
    clh = nc32_timer_out_imm(clh, 4, 33)
    clh = nc32_timer_out_imm(clh, 2, 161)
    clh = nc32_timer_out_imm(clh, 1, 33)
    clh = nc32_timer_out_imm(clh, 1, 161)
    clh = nc32_timer_out_imm(clh, 254, 33)
    clh = nc32_timer_out_imm(clh, 255, 161)
    clh = nc32_timer_out_imm(clh, 52, 67)
    clh = nc32_timer_out_imm(clh, 255, 64)
    clh = nc32_timer_out_imm(clh, 255, 64)
    do append(clh, 102)
    do append(clh, 186)
    do append(clh, 253)
    do append(clh, 3)
    do append(clh, 236)
    do append(clh, 168)
    do append(clh, 1)
    do append(clh, 116)
    do append(clh, 247)
    do append(clh, 102)
    do append(clh, 186)
    do append(clh, 248)
    do append(clh, 3)
    do append(clh, 236)
    do append(clh, 15)
    do append(clh, 182)
    do append(clh, 192)
    do append(clh, 163)
    clh = nc_append_le32(clh, inq_vaddr)
    do append(clh, 199)
    do append(clh, 5)
    clh = nc_append_le32(clh, pos_vaddr)
    clh = nc_append_le32(clh, 0)
    do append(clh, 199)
    do append(clh, 5)
    clh = nc_append_le32(clh, done_vaddr)
    clh = nc_append_le32(clh, 1)
    do append(clh, 199)
    do append(clh, 5)
    clh = nc_append_le32(clh, cur_vaddr)
    clh = nc_append_le32(clh, 2)
    do append(clh, 199)
    do append(clh, 5)
    clh = nc_append_le32(clh, tcb0_vaddr)
    clh = nc_append_le32(clh, seedA_vaddr)
    do append(clh, 199)
    do append(clh, 5)
    clh = nc_append_le32(clh, tcb1_vaddr)
    clh = nc_append_le32(clh, seedB_vaddr)
    do append(clh, 251)
    do append(clh, 235)
    do append(clh, 254)
    return clh
end

func nc_emit_multiboot32_cloggard_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(520, 0, "multiboot32-cloggard: task A main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(521, 0, "multiboot32-cloggard: task A main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(522, 0, "multiboot32-cloggard: task A body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(523, 0, "multiboot32-cloggard: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(524, 0, "multiboot32-cloggard: body length invariant")
        return 0
    end
    let off_A = 224
    let a_len = 5 + ebp_prefix + bodylen + 37
    let off_B = off_A + a_len
    let off_sched = off_B + 43
    let off_tables = off_sched + 128
    let off_after = off_tables + 300
    let off_data = nc32_roundup4(off_after)
    let inq_vaddr = 1048588 + off_data
    let pos_vaddr = inq_vaddr + 4
    let done_vaddr = inq_vaddr + 8
    let cur_vaddr = inq_vaddr + 12
    let tcb0_vaddr = inq_vaddr + 16
    let tcb1_vaddr = inq_vaddr + 20
    -- seeds (cold contexts, used once) come FIRST; each task runs on its OWN dedicated 256-byte
    -- stack (its entry does `mov esp,stackX_top`), so the running esp differs from the seed and the
    -- per-task warm save (mov [tcb+cur*4],esp) is LOAD-BEARING (NOP it -> tcb stays the seed ->
    -- cold re-dispatch -> the accumulation is lost). A 31-local body never reaches the cells.
    let off_seedA = off_data + 24
    let off_seedB = off_seedA + 44
    let off_stackA = off_seedB + 44
    let off_stackB = off_stackA + 256
    let off_guard = off_stackB + 256
    let code_len = off_guard + 16
    let stackA_top = 1048588 + off_stackA + 256
    let stackB_top = 1048588 + off_stackB + 256
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let gate_vaddr = 1048588 + off_sched
    let gdt_vaddr = 1048588 + off_tables
    let gdtr_vaddr = gdt_vaddr + 24
    let idt_vaddr = gdtr_vaddr + 6
    let idtr_vaddr = idt_vaddr + 264
    let seedA_vaddr = 1048588 + off_seedA
    let seedB_vaddr = 1048588 + off_seedB
    let a_entry = 1048588 + off_A
    let b_entry = 1048588 + off_B
    let com = new_buffer()
    com = nc32_clog_emit_head(com, gdtr_vaddr, esp_top, idtr_vaddr, inq_vaddr, pos_vaddr, done_vaddr, cur_vaddr, tcb0_vaddr, tcb1_vaddr, seedA_vaddr, seedB_vaddr)
    -- TASK A: mov esp,stackA_top (dedicated stack) + optional ebp frame + compiled body (-> eax=vA)
    -- + warm accumulate/emit glue.
    do append(com, 188)
    com = nc_append_le32(com, stackA_top)
    if nlocals > 0:
        do append(com, 137)
        do append(com, 229)
        do append(com, 131)
        do append(com, 236)
        do append(com, 4 * nlocals)
    end
    com = append_str(com, freeze(bodybuf))
    do append(com, 137)
    do append(com, 199)
    do append(com, 49)
    do append(com, 246)
    do append(com, 70)
    do append(com, 137)
    do append(com, 248)
    do append(com, 1)
    do append(com, 240)
    com = nc32_clog_task_tail(com, done_vaddr, 223)
    -- TASK B: mov esp,stackB_top (dedicated stack) + marker accumulate/emit glue.
    do append(com, 188)
    com = nc_append_le32(com, stackB_top)
    do append(com, 49)
    do append(com, 255)
    do append(com, 71)
    do append(com, 184)
    com = nc_append_le32(com, 176)
    do append(com, 1)
    do append(com, 248)
    com = nc32_clog_task_tail(com, done_vaddr, 220)
    -- SCHEDULER (128 bytes): completion-driven run-queue dispatcher.
    do append(com, 176)
    do append(com, 32)
    do append(com, 230)
    do append(com, 32)
    do append(com, 96)
    do append(com, 161)
    com = nc_append_le32(com, done_vaddr)
    do append(com, 133)
    do append(com, 192)
    do append(com, 116)
    do append(com, 73)
    do append(com, 161)
    com = nc_append_le32(com, pos_vaddr)
    do append(com, 131)
    do append(com, 248)
    do append(com, 4)
    do append(com, 115)
    do append(com, 65)
    do append(com, 161)
    com = nc_append_le32(com, cur_vaddr)
    do append(com, 131)
    do append(com, 248)
    do append(com, 2)
    do append(com, 116)
    do append(com, 7)
    do append(com, 137)
    do append(com, 36)
    do append(com, 133)
    com = nc_append_le32(com, tcb0_vaddr)
    do append(com, 139)
    do append(com, 13)
    com = nc_append_le32(com, pos_vaddr)
    do append(com, 161)
    com = nc_append_le32(com, inq_vaddr)
    do append(com, 211)
    do append(com, 232)
    do append(com, 131)
    do append(com, 224)
    do append(com, 1)
    do append(com, 163)
    com = nc_append_le32(com, cur_vaddr)
    do append(com, 255)
    do append(com, 5)
    com = nc_append_le32(com, pos_vaddr)
    do append(com, 199)
    do append(com, 5)
    com = nc_append_le32(com, done_vaddr)
    com = nc_append_le32(com, 0)
    do append(com, 139)
    do append(com, 36)
    do append(com, 133)
    com = nc_append_le32(com, tcb0_vaddr)
    do append(com, 97)
    do append(com, 207)
    do append(com, 97)
    do append(com, 207)
    -- exit: isa-debug-exit (QEMU) + "Shutdown" (Bochs power-off) + halt.
    do append(com, 102)
    do append(com, 186)
    do append(com, 244)
    do append(com, 0)
    do append(com, 176)
    do append(com, 0)
    do append(com, 238)
    do append(com, 102)
    do append(com, 186)
    do append(com, 0)
    do append(com, 137)
    com = nc32_emit_out_char(com, 83)
    com = nc32_emit_out_char(com, 104)
    com = nc32_emit_out_char(com, 117)
    com = nc32_emit_out_char(com, 116)
    com = nc32_emit_out_char(com, 100)
    com = nc32_emit_out_char(com, 111)
    com = nc32_emit_out_char(com, 119)
    com = nc32_emit_out_char(com, 110)
    do append(com, 250)
    do append(com, 244)
    do append(com, 235)
    do append(com, 253)
    -- TABLES (300) + DATA.
    com = nc32_timer_emit_tables(com, gdt_vaddr, idt_vaddr, gate_vaddr)
    com = nc_emit_zeroes_loop(com, off_data - off_after)
    com = nc_emit_zeroes_loop(com, 24)
    com = nc_emit_zeroes_loop(com, 32)
    com = nc_append_le32(com, a_entry)
    com = nc_append_le32(com, 8)
    com = nc_append_le32(com, 514)
    com = nc_emit_zeroes_loop(com, 32)
    com = nc_append_le32(com, b_entry)
    com = nc_append_le32(com, 8)
    com = nc_append_le32(com, 514)
    com = nc_emit_zeroes_loop(com, 256)
    com = nc_emit_zeroes_loop(com, 256)
    com = nc_emit_zeroes_loop(com, 16)
    let frozen_code = freeze(com)
    if length(frozen_code) != code_len:
        let f6 = nc_fail(525, 0, "multiboot32-cloggard: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

func nc_is_multiboot32_cloggard(source):
    let marker = "-- emit: multiboot32-cloggard"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

func nc32_roundup_4k(v):
    let r = v % 4096
    if r == 0:
        return v
    end
    return v + 4096 - r
end

-- chosen: the fixed 118-byte STRUCTURAL head (prologue 92 + #PF wrapper 26). Extends
-- zonday's GDT+IDT head with paging-enable. Only five le32 fields vary with the body
-- length (gdtr_vaddr, esp_top, idtr_vaddr, pd_vaddr, sentinel_rel32); everything else --
-- incl. the CR4 clear, the CR0.PG-enable, BOTH touch addresses, and the whole wrapper --
-- is a fixed byte sequence the white-box gate pins exactly.
--   cli; lgdt; far-jmp CS=0x08; reload DS/ES/FS/GS/SS=0x10; mov esp; lidt;
--   mov eax,cr4; and eax,0xFFFFFF4F (clear PAE/PSE/PGE -- Multiboot leaves CR4 UNDEFINED,
--     so PAE-set would reinterpret PD as a PDPT and triple-fault; SDM-mandated robustness);
--   mov eax,PD; mov cr3,eax; mov eax,cr0; or eax,0x80000000; mov cr0,eax (PAGING ON);
--   jmp $+2 (prefetch flush); TOUCH-A [0x2ff000] (mapped, must NOT fault);
--   TOUCH-B [0x300000] (the UNMAPPED neighbor, MUST #PF -> its EIP=0x10005b is the proof);
--   SENTINEL mov al,0xBB; jmp epilogue (reached only if B did NOT fault).
-- WRAPPER (the IDT vector-14 / #PF gate target): mov eax,cr2; cmp eax,0x300000; jne sentinel;
--   cmp dword [esp],0 (the #PF error code: not-present supervisor read == 0); jne sentinel;
--   cmp dword [esp+4],0x10005b (the saved EIP == TOUCH-B, proving WHICH access faulted);
--   jne sentinel -- then falls into the compiled handler body. CR2 alone is forgeable
--   (cr2 is ring-0-writable), so the proof rests on this wrapper + the white-box head pin.
func nc32_page_emit_head(buf, gdtr_vaddr, esp_top, idtr_vaddr, pd_vaddr, sentinel_rel32):
    do append(buf, 250)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 21)
    buf = nc_append_le32(buf, gdtr_vaddr)
    do append(buf, 234)
    buf = nc_append_le32(buf, 1048603)
    do append(buf, 8)
    do append(buf, 0)
    do append(buf, 102)
    do append(buf, 184)
    do append(buf, 16)
    do append(buf, 0)
    do append(buf, 142)
    do append(buf, 216)
    do append(buf, 142)
    do append(buf, 192)
    do append(buf, 142)
    do append(buf, 224)
    do append(buf, 142)
    do append(buf, 232)
    do append(buf, 142)
    do append(buf, 208)
    do append(buf, 188)
    buf = nc_append_le32(buf, esp_top)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 29)
    buf = nc_append_le32(buf, idtr_vaddr)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 224)
    do append(buf, 37)
    do append(buf, 79)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 224)
    do append(buf, 184)
    buf = nc_append_le32(buf, pd_vaddr)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 216)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 192)
    do append(buf, 13)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 128)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 192)
    do append(buf, 235)
    do append(buf, 0)
    do append(buf, 139)
    do append(buf, 5)
    buf = nc_append_le32(buf, 3141632)
    do append(buf, 139)
    do append(buf, 5)
    buf = nc_append_le32(buf, 3145728)
    do append(buf, 176)
    do append(buf, 187)
    do append(buf, 233)
    buf = nc_append_le32(buf, sentinel_rel32)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 208)
    do append(buf, 61)
    buf = nc_append_le32(buf, 3145728)
    do append(buf, 117)
    do append(buf, 239)
    do append(buf, 131)
    do append(buf, 60)
    do append(buf, 36)
    do append(buf, 0)
    do append(buf, 117)
    do append(buf, 233)
    do append(buf, 129)
    do append(buf, 124)
    do append(buf, 36)
    do append(buf, 4)
    buf = nc_append_le32(buf, 1048667)
    do append(buf, 117)
    do append(buf, 223)
    return buf
end

-- chosen: GDT (null + flat 32-bit code 0x08 + data 0x10) + GDTR (limit 23), then a
-- FIFTEEN-entry IDT (vectors 0..13 NOT present -> any other exception triple-faults =
-- correct fail-closed RED; vector 14 = the #PF gate, offset=wrapper vaddr / selector
-- 0x0008 / attr 0x8E) + IDTR (limit 0x77 = 15*8-1). Emitter-laid-out at fixed vaddrs
-- (no runtime store-to-arbitrary-address -> typed-memory candidate (d) stays deferred).
func nc32_page_emit_tables(buf, gdt_vaddr, idt_vaddr, gate_vaddr):
    buf = nc_emit_zeroes_loop(buf, 8)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 154)
    do append(buf, 207)
    do append(buf, 0)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 146)
    do append(buf, 207)
    do append(buf, 0)
    do append(buf, 23)
    do append(buf, 0)
    buf = nc_append_le32(buf, gdt_vaddr)
    buf = nc_emit_zeroes_loop(buf, 112)
    let glo = gate_vaddr % 65536
    let ghi_full = gate_vaddr / 65536
    let ghi = ghi_full % 65536
    do append(buf, glo % 256)
    do append(buf, glo / 256)
    do append(buf, 8)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 142)
    do append(buf, ghi % 256)
    do append(buf, ghi / 256)
    do append(buf, 119)
    do append(buf, 0)
    buf = nc_append_le32(buf, idt_vaddr)
    return buf
end

-- chosen: the page directory (4 KiB). PDE[0] -> the page table (present+RW); the rest
-- are zero (not present). pt_vaddr is 4 KiB-aligned so +3 == |0x003.
func nc32_page_emit_pd(buf, pt_vaddr):
    buf = nc_append_le32(buf, pt_vaddr + 3)
    buf = nc_emit_zeroes_loop(buf, 4092)
    return buf
end

-- chosen: the page table (4 KiB, 1024 entries) identity-mapping 0..4 MiB as
-- (i*4096)|present|RW, EXCEPT entry 768 (linear 0x300000 = the neighbor B) left zero
-- (not present) -- the single hole that forces the #PF. i*4096 (tonka's `*`) avoids any
-- bit-shift; +3 sets present+RW since i*4096 is 4 KiB-aligned.
func nc32_page_emit_pt_loop(buf, i):
    if i >= 1024:
        return buf
    end
    if i == 768:
        buf = nc_append_le32(buf, 0)
    else:
        buf = nc_append_le32(buf, i * 4096 + 3)
    end
    return nc32_page_emit_pt_loop(buf, i + 1)
end

-- chosen driver. Layout (vaddr V0=0x10000c): [HEAD 118 (prologue+wrapper)]
-- [ebp-frame(0|5) + compiled toakie body] [shared 58-byte epilogue] [GDT/GDTR/IDT/IDTR 156]
-- [pad to 4 KiB] [PD 4096] [PT 4096]. The handler IS the compiled main() body (toakie
-- subset) reached via the #PF wrapper -- the anti-ceremony guard: the proof byte is normal
-- compiled lowering, not a canned blob. No `mov esp` in the body (the head set it; the
-- wrapper validated the fault frame first); it does NOT iret (a #PF re-faults on return
-- with the mapping unfixed; iret-resumption is a deferred later link). Reuses lingo's
-- ehdr/phdr/mbheader and toakie's verifier + 2-pass layout/lowering + epilogue verbatim.
func nc_emit_multiboot32_page_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(460, 0, "multiboot32-page: handler main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(461, 0, "multiboot32-page: handler main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(462, 0, "multiboot32-page: handler body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(463, 0, "multiboot32-page: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(464, 0, "multiboot32-page: body length invariant")
        return 0
    end
    let head_len = 118
    let hb = epi + 58
    let gdt_off = head_len + hb
    let gdt_vaddr = 1048588 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let idt_vaddr = gdtr_vaddr + 6
    let idtr_vaddr = idt_vaddr + 120
    let tables_end = idtr_vaddr + 6
    let pd_vaddr = nc32_roundup_4k(tables_end)
    let pt_vaddr = pd_vaddr + 4096
    let load_end = pt_vaddr + 4096
    let esp_top = load_end + 16384
    if esp_top > 3141632:
        let f7 = nc_fail(465, 0, "multiboot32-page: image collides with the mapped/unmapped test region")
        return 0
    end
    let gate_vaddr = 1048680
    let sentinel_rel32 = 26 + epi
    let cbuf = new_buffer()
    cbuf = nc32_page_emit_head(cbuf, gdtr_vaddr, esp_top, idtr_vaddr, pd_vaddr, sentinel_rel32)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    cbuf = nc32_page_emit_tables(cbuf, gdt_vaddr, idt_vaddr, gate_vaddr)
    let pre_pd_len = length(freeze(cbuf))
    let pad_to_pd = pd_vaddr - 1048588 - pre_pd_len
    cbuf = nc_emit_zeroes_loop(cbuf, pad_to_pd)
    cbuf = nc32_page_emit_pd(cbuf, pt_vaddr)
    cbuf = nc32_page_emit_pt_loop(cbuf, 0)
    let frozen_code = freeze(cbuf)
    let code_len = length(frozen_code)
    if code_len != load_end - 1048588:
        let f6 = nc_fail(466, 0, "multiboot32-page: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let memsz = filesz + 16384
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

-- multiboot32-store: the fixed 99-byte head (prologue + the runtime computed-address
-- store + the MMU-gate access). Extends chosen's paging-enable, then -- the new capability
-- (candidate (d)) -- computes a page-table-entry slot ADDRESS from the target vaddr in a
-- register and STORES a valid PTE there at runtime, mapping vaddr 0x300000 (left unmapped
-- at build time, PT[0x300]=0) to the present frame just above the page table. It then
-- ACCESSES 0x300000: the MMU is the judge -- if the runtime store landed at the right slot
-- with the right bits, the access succeeds; otherwise it #PFs into a fail-closed (limit-0)
-- IDT -> triple-fault. The compiled main() body (toakie subset) then computes the proof
-- byte (anti-ceremony: real compiled lowering, not a blob). No fault on the happy path,
-- so no #PF handler and no `iret`; no TLB flush (the page was never accessed, so nothing
-- is cached -- proven on both substrates). The computed slot: eax = (0x300000 >> 10) +
-- PT_vaddr; the store: mov [eax], (map_frame | present | RW). pt_vaddr and the map frame
-- are derived from pd_vaddr (pt = pd+4096, frame = pd+8192).
func nc32_store_emit_head(buf, gdtr_vaddr, esp_top, idtr_vaddr, pd_vaddr):
    let pt_vaddr = pd_vaddr + 4096
    let map_pte = pd_vaddr + 8195
    do append(buf, 250)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 21)
    buf = nc_append_le32(buf, gdtr_vaddr)
    do append(buf, 234)
    buf = nc_append_le32(buf, 1048603)
    do append(buf, 8)
    do append(buf, 0)
    do append(buf, 102)
    do append(buf, 184)
    do append(buf, 16)
    do append(buf, 0)
    do append(buf, 142)
    do append(buf, 216)
    do append(buf, 142)
    do append(buf, 192)
    do append(buf, 142)
    do append(buf, 224)
    do append(buf, 142)
    do append(buf, 232)
    do append(buf, 142)
    do append(buf, 208)
    do append(buf, 188)
    buf = nc_append_le32(buf, esp_top)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 29)
    buf = nc_append_le32(buf, idtr_vaddr)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 224)
    do append(buf, 37)
    do append(buf, 79)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 224)
    do append(buf, 184)
    buf = nc_append_le32(buf, pd_vaddr)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 216)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 192)
    do append(buf, 13)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 128)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 192)
    do append(buf, 235)
    do append(buf, 0)
    do append(buf, 187)
    buf = nc_append_le32(buf, 3145728)
    do append(buf, 137)
    do append(buf, 216)
    do append(buf, 193)
    do append(buf, 232)
    do append(buf, 10)
    do append(buf, 5)
    buf = nc_append_le32(buf, pt_vaddr)
    do append(buf, 199)
    do append(buf, 0)
    buf = nc_append_le32(buf, map_pte)
    do append(buf, 160)
    buf = nc_append_le32(buf, 3145728)
    return buf
end

-- multiboot32-store tables: GDT (null + flat code 0x08 + data 0x10) + GDTR (limit 23) +
-- a FAIL-CLOSED IDTR (limit 0, base 0) -- no #PF handler is installed, so a #PF (which
-- only happens if the runtime store failed) cannot be delivered -> triple-fault = the
-- correct RED for this fixture. No IDT entries (simpler than chosen's 15-entry IDT).
func nc32_store_emit_tables(buf, gdt_vaddr):
    buf = nc_emit_zeroes_loop(buf, 8)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 154)
    do append(buf, 207)
    do append(buf, 0)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 146)
    do append(buf, 207)
    do append(buf, 0)
    do append(buf, 23)
    do append(buf, 0)
    buf = nc_append_le32(buf, gdt_vaddr)
    do append(buf, 0)
    do append(buf, 0)
    buf = nc_append_le32(buf, 0)
    return buf
end

-- multiboot32-store driver. Layout (vaddr V0=0x10000c): [HEAD 99 (prologue + computed
-- store + access)] [ebp-frame(0|5) + compiled toakie body] [shared 58-byte epilogue]
-- [GDT/GDTR/IDTR 36] [pad to 4 KiB] [PD 4096] [PT 4096, hole at 0x300]. Reuses chosen's
-- nc32_page_emit_pd/pt_loop verbatim (the build-time hole is what the runtime store fills)
-- and lingo's ehdr/phdr/mbheader + toakie's verifier + 2-pass layout/lowering + epilogue.
func nc_emit_multiboot32_store_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(467, 0, "multiboot32-store: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(468, 0, "multiboot32-store: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(469, 0, "multiboot32-store: body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(470, 0, "multiboot32-store: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(471, 0, "multiboot32-store: body length invariant")
        return 0
    end
    let head_len = 99
    let hb = epi + 58
    let gdt_off = head_len + hb
    let gdt_vaddr = 1048588 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let idtr_vaddr = gdtr_vaddr + 6
    let tables_end = idtr_vaddr + 6
    let pd_vaddr = nc32_roundup_4k(tables_end)
    let pt_vaddr = pd_vaddr + 4096
    let load_end = pt_vaddr + 4096
    let esp_top = load_end + 16384
    if esp_top > 3145728:
        let f7 = nc_fail(472, 0, "multiboot32-store: image collides with the mapped vaddr region")
        return 0
    end
    let cbuf = new_buffer()
    cbuf = nc32_store_emit_head(cbuf, gdtr_vaddr, esp_top, idtr_vaddr, pd_vaddr)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    cbuf = nc32_store_emit_tables(cbuf, gdt_vaddr)
    let pre_pd_len = length(freeze(cbuf))
    let pad_to_pd = pd_vaddr - 1048588 - pre_pd_len
    cbuf = nc_emit_zeroes_loop(cbuf, pad_to_pd)
    cbuf = nc32_page_emit_pd(cbuf, pt_vaddr)
    cbuf = nc32_page_emit_pt_loop(cbuf, 0)
    let frozen_code = freeze(cbuf)
    let code_len = length(frozen_code)
    if code_len != load_end - 1048588:
        let f6 = nc_fail(473, 0, "multiboot32-store: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let memsz = filesz + 16384
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

-- multiboot32-demand: the fixed 73-byte paging-enable prologue (IDENTICAL to liberi/chosen up
-- to `jmp $+2` -- cli; lgdt; far-jmp CS=0x08; reload DS/ES/FS/GS/SS=0x10; mov esp; lidt <REAL
-- #PF-handling IDTR>; clear CR4 (PAE/PSE/PGE); mov cr3 <own PD>; set CR0.PG; jmp $+2). Unlike
-- liberi, the store/access do NOT live in the head -- the faulting access is the GLUE after the
-- body, and the runtime store happens in the #PF HANDLER (the new capability).
func nc32_demand_emit_prologue(buf, gdtr_vaddr, esp_top, idtr_vaddr, pd_vaddr):
    do append(buf, 250)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 21)
    buf = nc_append_le32(buf, gdtr_vaddr)
    do append(buf, 234)
    buf = nc_append_le32(buf, 1048603)
    do append(buf, 8)
    do append(buf, 0)
    do append(buf, 102)
    do append(buf, 184)
    do append(buf, 16)
    do append(buf, 0)
    do append(buf, 142)
    do append(buf, 216)
    do append(buf, 142)
    do append(buf, 192)
    do append(buf, 142)
    do append(buf, 224)
    do append(buf, 142)
    do append(buf, 232)
    do append(buf, 142)
    do append(buf, 208)
    do append(buf, 188)
    buf = nc_append_le32(buf, esp_top)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 29)
    buf = nc_append_le32(buf, idtr_vaddr)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 224)
    do append(buf, 37)
    do append(buf, 79)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 224)
    do append(buf, 184)
    buf = nc_append_le32(buf, pd_vaddr)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 216)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 192)
    do append(buf, 13)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 128)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 192)
    do append(buf, 235)
    do append(buf, 0)
    return buf
end

-- multiboot32-demand GLUE (9 bytes): the FAULTING, RESUMED, offset-indexed load. After the
-- compiled body leaves V in eax, `movzx eax,al` (index = V & 0xFF) then `mov al,[eax+0x300000]`
-- touches the build-time hole -> #PF. After the handler maps it and `iret`s, the load
-- RE-EXECUTES and reads seed[V] = V^0x5A from the now-mapped frame; the epilogue frames al.
-- This glue sits exactly at `epi` (the body's branch/RET target), so EVERY return path --
-- terminal RET fall-through AND mid-body `pop eax; jmp epi` -- funnels through the resume.
func nc32_demand_emit_glue(buf):
    do append(buf, 15)
    do append(buf, 182)
    do append(buf, 192)
    do append(buf, 138)
    do append(buf, 128)
    buf = nc_append_le32(buf, 3145728)
    return buf
end

-- multiboot32-demand #PF HANDLER (29 bytes -- THE NEW CAPABILITY, pinned hardest white-box).
-- Reached via the IDT vector-14 gate. It does NOT emit (the proof byte comes from the resumed
-- mainline load). It preserves eax (the faulting load's index V), reads CR2 (the faulting
-- linear address 0x300000+V), computes the PTE slot &PT[0x300] at runtime (shr eax,10; add
-- eax,PT_base -- liberi's computed store, now sourced from CR2), STORES a valid PTE (maps the
-- page), flushes the TLB via CR3 reload (empirically required on BOTH QEMU and Bochs -- the #PF
-- does NOT auto-invalidate the cached not-present walk), restores eax, drops the #PF error code
-- (`add esp,4` -- iret does NOT pop it; omitting it loads the error code as EIP -> triple-fault),
-- then `iret` RESUMES the faulting load. A mutation of any step (store/flush/add-esp/iret) leaves
-- the page unmapped or the frame corrupt -> #PF re-fault / triple-fault / wrong byte (all RED).
func nc32_demand_emit_handler(buf, pt_vaddr, frame_pte):
    do append(buf, 80)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 208)
    do append(buf, 193)
    do append(buf, 232)
    do append(buf, 10)
    do append(buf, 5)
    buf = nc_append_le32(buf, pt_vaddr)
    do append(buf, 199)
    do append(buf, 0)
    buf = nc_append_le32(buf, frame_pte)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 216)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 216)
    do append(buf, 88)
    do append(buf, 131)
    do append(buf, 196)
    do append(buf, 4)
    do append(buf, 207)
    return buf
end

-- multiboot32-demand SEEDED FRAME (4 KiB, file-backed in the loadable segment -- NOT bss).
-- The handler maps vaddr 0x300000 to this frame; the resumed load reads seed[V]. seed[i] =
-- i ^ 0x5A for i in 0..255 (a nonzero mask, so the byte is NOT V -- the resume is INDEPENDENTLY
-- load-bearing: a forge that emits V directly fails, and a forge that XORs an immediate is
-- caught white-box because the byte must come from `mov al,[mem]`). The rest is zero.
func nc32_demand_frame_loop(buf, i):
    if i >= 256:
        return buf
    end
    do append(buf, i ^ 90)
    return nc32_demand_frame_loop(buf, i + 1)
end

func nc32_demand_emit_frame(buf):
    buf = nc32_demand_frame_loop(buf, 0)
    buf = nc_emit_zeroes_loop(buf, 3840)
    return buf
end

-- multiboot32-demand driver. Layout (vaddr V0=0x10000c): [PROLOGUE 73 (paging-enable)]
-- [ebp-frame(0|5) + compiled toakie body] [GLUE 9 (faulting resumed load)] [shared 58-byte
-- epilogue] [#PF HANDLER 29] [GDT/GDTR/IDT(15)/IDTR 156 -- chosen's nc32_page_emit_tables,
-- vector-14 gate -> the handler] [pad to 4 KiB] [PD 4096 -> PT] [PT 4096, hole at 0x300]
-- [SEEDED FRAME 4096]. Reuses chosen's nc32_page_emit_pd/pt_loop (the runtime store fills the
-- hole) + the toakie verifier/2-pass layout/lowering + the shared epilogue + lingo's ehdr/phdr/
-- mbheader. The frame is part of the loaded segment (filesz), so the seed survives to runtime.
func nc_emit_multiboot32_demand_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(474, 0, "multiboot32-demand: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(475, 0, "multiboot32-demand: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(476, 0, "multiboot32-demand: body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(477, 0, "multiboot32-demand: too many locals (max 31)")
        return 0
    end
    let ebp_prefix = 0
    if nlocals > 0:
        ebp_prefix = 5
    end
    let lay = nc32_layout_loop(code, 0, n, ebp_prefix, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - ebp_prefix:
        let f5 = nc_fail(478, 0, "multiboot32-demand: body length invariant")
        return 0
    end
    let off_handler = 73 + ebp_prefix + bodylen + 9 + 58
    let handler_vaddr = 1048588 + off_handler
    let off_tables = off_handler + 29
    let gdt_vaddr = 1048588 + off_tables
    let gdtr_vaddr = gdt_vaddr + 24
    let idt_vaddr = gdtr_vaddr + 6
    let idtr_vaddr = idt_vaddr + 120
    let tables_end = idtr_vaddr + 6
    let pd_vaddr = nc32_roundup_4k(tables_end)
    let pt_vaddr = pd_vaddr + 4096
    let frame_vaddr = pt_vaddr + 4096
    let load_end = frame_vaddr + 4096
    let esp_top = load_end + 16384
    if esp_top > 3145728:
        let f7 = nc_fail(479, 0, "multiboot32-demand: image collides with the mapped vaddr region")
        return 0
    end
    let frame_pte = frame_vaddr + 3
    let cbuf = new_buffer()
    cbuf = nc32_demand_emit_prologue(cbuf, gdtr_vaddr, esp_top, idtr_vaddr, pd_vaddr)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_demand_emit_glue(cbuf)
    cbuf = nc32_emit_epilogue(cbuf)
    cbuf = nc32_demand_emit_handler(cbuf, pt_vaddr, frame_pte)
    cbuf = nc32_page_emit_tables(cbuf, gdt_vaddr, idt_vaddr, handler_vaddr)
    let pre_pd_len = length(freeze(cbuf))
    let pad_to_pd = pd_vaddr - 1048588 - pre_pd_len
    cbuf = nc_emit_zeroes_loop(cbuf, pad_to_pd)
    cbuf = nc32_page_emit_pd(cbuf, pt_vaddr)
    cbuf = nc32_page_emit_pt_loop(cbuf, 0)
    cbuf = nc32_demand_emit_frame(cbuf)
    let frozen_code = freeze(cbuf)
    let code_len = length(frozen_code)
    if code_len != load_end - 1048588:
        let f6 = nc_fail(480, 0, "multiboot32-demand: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let memsz = filesz + 16384
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

-- hoopteeter: the fixed 56-byte LONG-MODE TRANSITION head (emitter-laid-out structure, like
-- the ELF/MB headers -- honest structure, not compiled Herbert). In execution order (entered
-- AFTER the compiled body has stashed V in esi): cli; lgdt my own GDT (which has a 64-bit
-- L=1 code descriptor at 0x08); normalize CR4 = PAE only (Multiboot leaves CR4 UNDEFINED --
-- chosen's lesson, but here we SET PAE for 4-level paging); mov cr3 = PML4 physical; set
-- EFER.LME via wrmsr to MSR 0xC0000080 (RMW: rdmsr; or eax,0x100; wrmsr -- LME-only, NXE stays
-- clear); set CR0.PG (now in IA-32e COMPATIBILITY mode); ljmp 0x08:long_entry -- reload CS into
-- the 64-bit segment, entering true 64-bit mode. Two le32 fields vary (gdtr_vaddr, pml4_vaddr)
-- plus the ljmp target (long_entry_vaddr); everything else is a fixed byte sequence the
-- white-box gate pins exactly. CR4=0x20 and the ljmp selector 0x08 are load-bearing.
func nc32_long_emit_head(buf, gdtr_vaddr, pml4_vaddr, long_entry_vaddr):
    do append(buf, 250)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 21)
    buf = nc_append_le32(buf, gdtr_vaddr)
    do append(buf, 184)
    do append(buf, 32)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 224)
    do append(buf, 184)
    buf = nc_append_le32(buf, pml4_vaddr)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 216)
    do append(buf, 185)
    do append(buf, 128)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 192)
    do append(buf, 15)
    do append(buf, 50)
    do append(buf, 13)
    do append(buf, 0)
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 15)
    do append(buf, 48)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 192)
    do append(buf, 13)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 128)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 192)
    do append(buf, 234)
    buf = nc_append_le32(buf, long_entry_vaddr)
    do append(buf, 8)
    do append(buf, 0)
    return buf
end

-- hoopteeter: the fixed 16-byte 64-bit OBSERVABLE (long_entry). The compiled body left its
-- return value V in eax and stashed it in esi before the mode switch. mov eax,esi (89 f0) +
-- nop (90) -- the FIRST 64-bit instruction reads esi (the LOW 32 bits = V) and ZERO-EXTENDS it
-- into rax, because a 32-bit `mov esi,eax` in protected mode leaves the HIGH 32 bits of rsi
-- ARCHITECTURALLY UNDEFINED (32-bit writes zero-extend only IN 64-bit mode) -- so reading rsi
-- directly (mov rax,rsi) would multiply (garbage<<32 | V) and corrupt the proof byte on real
-- silicon (the two emulators happen to zero it; cross-model Codex caught this, silicon-confirmed).
-- Then mov ecx,0x10001 (the fixed multiplier K); imul rax,rcx (REX.W 48 0F AF C1 -- 64-bit imul, the
-- low 64 bits; V*K << 2^64 so that IS the true product yet exceeds 2^32); shr rax,0x20 (REX.W 48 C1 E8 20 -- the HIGH dword into al). The shr count 0x20 (=32) is LOAD-BEARING: in
-- 32-bit/compat the count masks to 5 bits (0x20 & 0x1f = 0 -> no-op shift, al stays the low
-- byte) AND the REX.W 0x48 decodes as `dec eax`, so the identical bytes yield a DIFFERENT byte
-- -- which is exactly why a compat-mode (L=0 descriptor) forge fails. Leaves the proof byte in
-- al, then the shared epilogue frames it (0xDE<byte>0xAD on 0xE9 + result-dependent exit).
func nc32_long_emit_observable(buf):
    do append(buf, 137)
    do append(buf, 240)
    do append(buf, 144)
    do append(buf, 185)
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 72)
    do append(buf, 15)
    do append(buf, 175)
    do append(buf, 193)
    do append(buf, 72)
    do append(buf, 193)
    do append(buf, 232)
    do append(buf, 32)
    return buf
end

-- hoopteeter: the 30-byte GDT + GDTR. A 3-entry GDT: null, a 64-bit CODE descriptor
-- 0x00AF9A000000FFFF (P/DPL0/S/exec, G=1, and L=1 -- the long-mode bit, the single bit that
-- distinguishes true 64-bit from compatibility mode; the compat twin 0x00CF9A000000FFFF is
-- banned by the white-box gate), and a data descriptor 0x00AF92000000FFFF; then GDTR (limit
-- 0x17 = 3*8-1, base gdt_vaddr). Emitter-laid-out at a fixed vaddr.
func nc32_long_emit_gdt(buf, gdt_vaddr):
    buf = nc_emit_zeroes_loop(buf, 8)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 154)
    do append(buf, 175)
    do append(buf, 0)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 146)
    do append(buf, 175)
    do append(buf, 0)
    do append(buf, 23)
    do append(buf, 0)
    buf = nc_append_le32(buf, gdt_vaddr)
    return buf
end

-- hoopteeter: the PML4 (4 KiB). Entry 0 -> the PDPT (present+RW), the rest not present. PAE
-- entries are 8 bytes; the next-table pointer is the low dword (the table is 4 KiB-aligned, so
-- +3 == |present|RW), the high dword is 0 (no NX -- EFER.NXE stays clear, so bit 63 must be 0).
func nc32_long_emit_pml4(buf, pdpt_vaddr):
    buf = nc_append_le32(buf, pdpt_vaddr + 3)
    buf = nc_append_le32(buf, 0)
    buf = nc_emit_zeroes_loop(buf, 4088)
    return buf
end

-- hoopteeter: the PDPT (4 KiB). Entry 0 -> the PD (present+RW), the rest not present.
func nc32_long_emit_pdpt(buf, pd_vaddr):
    buf = nc_append_le32(buf, pd_vaddr + 3)
    buf = nc_append_le32(buf, 0)
    buf = nc_emit_zeroes_loop(buf, 4088)
    return buf
end

-- hoopteeter: the PD (4 KiB, 512 entries) identity-mapping the WHOLE low 1 GiB as 512 2-MiB
-- PAE pages: pd[i] = (i * 0x200000) | present | RW | PS(0x80) == i*2097152 + 0x83. i*0x200000
-- (tonka's `*`, no bit-shift) is 2-MiB-aligned so the low [20:0] frame bits are zero (a 2-MiB
-- PS page requires this). Mapping the full low 1 GiB (table size is a fixed 4 KiB regardless of
-- N) removes any image/stack/table-coverage question from the threat model -- nothing the image
-- touches is ever outside the map, so no spurious #PF/triple-fault as the image grows.
func nc32_long_emit_pd_loop(buf, i):
    if i >= 512:
        return buf
    end
    buf = nc_append_le32(buf, i * 2097152 + 131)
    buf = nc_append_le32(buf, 0)
    return nc32_long_emit_pd_loop(buf, i + 1)
end

-- hoopteeter driver. Layout (vaddr V0=0x10000c): [mov esp + ebp-frame(0|5)] [compiled toakie
-- body -- `return V` jumps to epi] [@epi: mov esi,eax (stash V)] [56-byte transition head]
-- [@long_entry: 16-byte 64-bit observable] [shared 58-byte epilogue] [GDT/GDTR 30] [pad to
-- 4 KiB] [PML4 4096] [PDPT 4096] [PD 4096]. The body IS the compiled main() body (toakie
-- subset: locals, + - *, ==, if/else, return) running in 32-bit -- the anti-ceremony guard:
-- the proof byte tracks NORMAL compiled lowering, not a canned blob. It then crosses into 64-bit
-- and the observable derives the proof byte = high dword of (V * 0x10001), 64-bit-distinguishing.
-- Reuses lingo's ehdr/phdr/mbheader + toakie's verifier/2-pass-layout/lowering + the shared
-- epilogue verbatim, so the eight prior modes are untouched (fixpoint preserved).
func nc_emit_multiboot32_long_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let f1 = nc_fail(492, 0, "multiboot32-long: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(493, 0, "multiboot32-long: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc32_body_ok(code, n):
        let f3 = nc_fail(494, 0, "multiboot32-long: body not in the control-flow+locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let f4 = nc_fail(495, 0, "multiboot32-long: too many locals (max 31)")
        return 0
    end
    let prefix_len = 5
    if nlocals > 0:
        prefix_len = 10
    end
    let lay = nc32_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let f5 = nc_fail(496, 0, "multiboot32-long: body length invariant")
        return 0
    end
    let v0 = 1048588
    let long_entry_vaddr = v0 + epi + 58
    let gdt_off = epi + 132
    let gdt_vaddr = v0 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let tables_end = gdtr_vaddr + 6
    let pml4_vaddr = nc32_roundup_4k(tables_end)
    let pdpt_vaddr = pml4_vaddr + 4096
    let pd_vaddr = pdpt_vaddr + 4096
    let load_end = pd_vaddr + 4096
    let esp_val = load_end + 16384
    if esp_val > 1073741824:
        let f7 = nc_fail(497, 0, "multiboot32-long: image exceeds the identity-mapped low 1 GiB")
        return 0
    end
    let cbuf = new_buffer()
    do append(cbuf, 188)
    cbuf = nc_append_le32(cbuf, esp_val)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    do append(cbuf, 137)
    do append(cbuf, 198)
    cbuf = nc32_long_emit_head(cbuf, gdtr_vaddr, pml4_vaddr, long_entry_vaddr)
    cbuf = nc32_long_emit_observable(cbuf)
    cbuf = nc32_emit_epilogue(cbuf)
    cbuf = nc32_long_emit_gdt(cbuf, gdt_vaddr)
    let pre_pml4_len = length(freeze(cbuf))
    let pad_to_pml4 = pml4_vaddr - v0 - pre_pml4_len
    cbuf = nc_emit_zeroes_loop(cbuf, pad_to_pml4)
    cbuf = nc32_long_emit_pml4(cbuf, pdpt_vaddr)
    cbuf = nc32_long_emit_pdpt(cbuf, pd_vaddr)
    cbuf = nc32_long_emit_pd_loop(cbuf, 0)
    let frozen_code = freeze(cbuf)
    let code_len = length(frozen_code)
    if code_len != load_end - v0:
        let f6 = nc_fail(498, 0, "multiboot32-long: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let memsz = filesz + 16384
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

-- toggler (TENTH kernel-arc link): "-- emit: multiboot32-long64" selects the freestanding image
-- that crosses into 64-bit long mode and runs a GENUINELY 64-bit COMPILED body -- the x86-64
-- BACKEND REUNIFICATION. hoopteeter (multiboot32-long) computes V in a 32-bit body and a canned
-- 16-byte observable derives the proof byte; toggler instead lowers the body through the SAME
-- near-axis 64-bit leaf emitters the Linux-ELF64 path uses (nc_emit_push_int/add/sub/mul -- REX.W),
-- AFTER entering long mode, so the proof byte = high dword of the body's OWN 64-bit result (a
-- multiply whose product exceeds 2^32: wrong under 32-bit-width arithmetic). One 64-bit lowering
-- table, both targets. Minimal slice -- straight-line arithmetic {PUSH_INT, ADD, SUB, MUL, RET},
-- single main(), no params/locals/branches (64-bit locals/branches widen a later link). With no
-- branches there are no body rel32s, so no layout pass is needed (emit the body, then measure).
-- The "-long64" suffix means nc_is_multiboot32 / _idt / _page / _store / _demand / _timer / _tick /
-- _long do NOT match (each requires its own marker followed by a newline; here source[mlen]='6').
func nc_is_multiboot32_long64(source):
    let marker = "-- emit: multiboot32-long64"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- The widened 64-bit subset (trikea/f2): PUSH_INT (0), LOAD_LOCAL (3), STORE_LOCAL (4), ADD (5),
-- SUB (6), EQ (11), NE (12), BR (16), BR_IF_FALSE (17), MUL (42), RET (21). Mirrors the proven
-- 32-bit toakie control-flow+locals subset but at 64-bit width: locals are 8-byte rbp-frame slots
-- ([rbp - 8*(slot+1)]) and branches resolve through a 64-bit layout pass. Still rejects call (20),
-- bitwise (36/37), div/mod (43/44), and anything else -- those remain deferred.
func nc64_op_allowed(op):
    if op == 0:
        return true
    end
    if op == 3:
        return true
    end
    if op == 4:
        return true
    end
    if op == 5:
        return true
    end
    if op == 6:
        return true
    end
    if op == 11:
        return true
    end
    if op == 12:
        return true
    end
    if op == 16:
        return true
    end
    if op == 17:
        return true
    end
    if op == 42:
        return true
    end
    if op == 21:
        return true
    end
    return false
end

-- Stack effect of each admitted 64-bit op (pops then pushes). REUSES the width-agnostic nc32_pops/
-- nc32_pushes (stack semantics are width-independent), but adds NE (op 12), which nc32 never admitted
-- and so leaves at 0/0: NE has the SAME stack effect as EQ (op 11) -- pop 2 operands, push 1 result.
-- Without this, an NE in a 64-bit body would be tracked as a no-op in the depth walk and mis-verify.
func nc64_pops(op):
    if op == 12:
        return 2
    end
    return nc32_pops(op)
end

func nc64_pushes(op):
    if op == 12:
        return 1
    end
    return nc32_pushes(op)
end

-- Two-pass CFG verifier mirroring nc32 (PASS A: forward depth walk; PASS B: nc32_check_branches for
-- forward-only + merge-point depth agreement). A COPY of nc32_build_depths with the depth cap at 1500
-- (NOT 3000) -- 64-bit pushes are 8 bytes (1500*8 = 12 KiB < the 16 KiB stack reserve above load_end),
-- and using nc64_pops/nc64_pushes so NE (op 12) is accounted. Records the depth BEFORE each instr;
-- rejects any unknown opcode, any underflow, any RET not at depth exactly 1. Returns (ok, depths).
func nc64_build_depths(code, i, n, cur, depths):
    if i >= n:
        return (1, depths)
    end
    let op = get(code, i).0
    if not nc64_op_allowed(op):
        return (0, depths)
    end
    if cur > 1500:
        return (0, depths)
    end
    let pops = nc64_pops(op)
    if cur < pops:
        return (0, depths)
    end
    do add(depths, cur)
    if op == 21:
        if cur != 1:
            return (0, depths)
        end
    end
    return nc64_build_depths(code, i + 1, n, cur - pops + nc64_pushes(op), depths)
end

-- The full 64-bit subset gate (mirrors nc32_body_ok): ends in RET, all opcodes admitted +
-- stack-balanced (PASS A), all branches forward + depth-agreeing (PASS B, reusing the width-agnostic
-- nc32_check_branches). Defense-in-depth: the far-axis oracle has no C reference, so the gate proves
-- the body's well-formedness itself before the 64-bit layout pass resolves branch rel32s.
func nc64_body_ok(code, n):
    if n == 0:
        return false
    end
    if get(code, n - 1).0 != 21:
        return false
    end
    let bd = nc64_build_depths(code, 0, n, 0, new_array(int))
    if bd.0 == 0:
        return false
    end
    return nc32_check_branches(code, 0, n, bd.1)
end

-- Byte size each op lowers to (matching the EXACT 64-bit lowering in nc64_lower_loop): PUSH_INT 11
-- (48 B8 imm64; push), LOAD_LOCAL 5 (48 8B 45 disp8; push), STORE_LOCAL 5 (pop; 48 89 45 disp8),
-- ADD/SUB 6 (REX.W), EQ/NE 13 (pop;pop; REX.W cmp; setcc; movzx; push), BR 5 (e9 rel32),
-- BR_IF_FALSE 10 (pop; test; je rel32), MUL 7 (REX.W imul), RET 1 if last (pop rax; fall through to
-- the grading tail) else 6 (pop rax; jmp epilogue). Drives the two-pass layout that resolves branch
-- rel32s AND the driver's body-length invariant (a mis-sized/dropped op is caught, never silently
-- mis-emitted -- the no-silent-drop guard the other freestanding drivers carry).
func nc64_op_size(op, is_last):
    if op == 0:
        return 11
    end
    if op == 3:
        return 5
    end
    if op == 4:
        return 5
    end
    if op == 5:
        return 6
    end
    if op == 6:
        return 6
    end
    if op == 11:
        return 13
    end
    if op == 12:
        return 13
    end
    if op == 16:
        return 5
    end
    if op == 17:
        return 10
    end
    if op == 42:
        return 7
    end
    if op == 21:
        if is_last == 1:
            return 1
        end
        return 6
    end
    return 0
end

func nc64_body_size_loop(code, i, n, acc):
    if i >= n:
        return acc
    end
    let il = 0
    if i == n - 1:
        il = 1
    end
    return nc64_body_size_loop(code, i + 1, n, acc + nc64_op_size(get(code, i).0, il))
end

-- PASS 1 layout (mirrors nc32_layout_loop at 64-bit width): byte offset of each instr from code start
-- (offsets INCLUDE the prefix, so a branch rel cancels the prefix). Returns (offs, epilogue_off); a
-- branch target == n resolves to epilogue_off.
func nc64_layout_loop(code, i, n, cur, offs):
    if i >= n:
        return (offs, cur)
    end
    do add(offs, cur)
    let il = 0
    if i == n - 1:
        il = 1
    end
    return nc64_layout_loop(code, i + 1, n, cur + nc64_op_size(get(code, i).0, il), offs)
end

-- Frame-local displacement as a disp8 byte: [rbp - 8*(slot+1)]. nlocals is capped at 15 upstream
-- (max slot 14), so 8*(slot+1) <= 120 fits a signed byte. The cap is 15 not 16 because the frame
-- prologue is `sub rsp, imm8` (48 83 EC ib), which SIGN-EXTENDS: frame = 8*16 = 128 would encode as
-- 0x80 = -128 and ADD to rsp. So 15 locals (frame 120, 0x78) is the true boundary, not the disp8 limit.
func nc64_emit_local_disp(buf, slot):
    do append(buf, 256 - 8 * (slot + 1))
    return buf
end

-- PASS 2 lowering (mirrors nc32_lower_loop at 64-bit width): emit each instr's bytes, resolving
-- BR/BR_IF_FALSE/mid-RET rel32 from the layout. REUSES the near-axis 64-bit leaf emitters for
-- PUSH_INT/ADD/SUB/MUL (the reunification -- each carries REX.W 0x48); locals use 8-byte rbp-frame
-- slots ([rbp - 8*(slot+1)]); EQ/NE lower to REX.W cmp + setcc + movzx; branches use the same forward
-- rel32 machinery as nc32 (gated forward-only, so every rel32 is non-negative). Terminal RET lowers to
-- a single `pop rax` (0x58, the driver appends the grading tail); a mid-body RET lowers to pop rax;
-- jmp epilogue.
func nc64_lower_loop(buf, code, i, n, offs, epi):
    if i >= n:
        return buf
    end
    let op = get(code, i).0
    let il = 0
    if i == n - 1:
        il = 1
    end
    let endoff = get(offs, i) + nc64_op_size(op, il)
    if op == 0:
        buf = nc_emit_push_int(buf, get(code, i).1)
    elif op == 3:
        do append(buf, 72)
        do append(buf, 139)
        do append(buf, 69)
        buf = nc64_emit_local_disp(buf, get(code, i).1)
        do append(buf, 80)
    elif op == 4:
        do append(buf, 88)
        do append(buf, 72)
        do append(buf, 137)
        do append(buf, 69)
        buf = nc64_emit_local_disp(buf, get(code, i).1)
    elif op == 5:
        buf = nc_emit_add(buf)
    elif op == 6:
        buf = nc_emit_sub(buf)
    elif op == 11:
        do append(buf, 89)
        do append(buf, 88)
        do append(buf, 72)
        do append(buf, 57)
        do append(buf, 200)
        do append(buf, 15)
        do append(buf, 148)
        do append(buf, 194)
        do append(buf, 72)
        do append(buf, 15)
        do append(buf, 182)
        do append(buf, 194)
        do append(buf, 80)
    elif op == 12:
        do append(buf, 89)
        do append(buf, 88)
        do append(buf, 72)
        do append(buf, 57)
        do append(buf, 200)
        do append(buf, 15)
        do append(buf, 149)
        do append(buf, 194)
        do append(buf, 72)
        do append(buf, 15)
        do append(buf, 182)
        do append(buf, 194)
        do append(buf, 80)
    elif op == 16:
        do append(buf, 233)
        let t = get(code, i).1
        let toff = epi
        if t < n:
            toff = get(offs, t)
        end
        buf = nc_append_le32(buf, toff - endoff)
    elif op == 17:
        do append(buf, 88)
        do append(buf, 72)
        do append(buf, 133)
        do append(buf, 192)
        do append(buf, 15)
        do append(buf, 132)
        let t2 = get(code, i).1
        let toff2 = epi
        if t2 < n:
            toff2 = get(offs, t2)
        end
        buf = nc_append_le32(buf, toff2 - endoff)
    elif op == 42:
        buf = nc_emit_mul(buf)
    elif op == 21:
        if il == 1:
            do append(buf, 88)
        else:
            do append(buf, 88)
            do append(buf, 233)
            buf = nc_append_le32(buf, epi - endoff)
        end
    end
    return nc64_lower_loop(buf, code, i + 1, n, offs, epi)
end

-- trikea/f2 driver (widened toggler). Layout (vaddr V0=0x10000c): [56-byte transition head -> ljmp
-- 0x08:long_entry] [@long_entry (64-bit): mov esp,esp_val (BC imm32 -- zero-extends rsp; the one extra
-- instruction long mode needs because the 32-bit handoff leaves rsp[63:32] undefined)] [optional rbp
-- frame: mov rbp,rsp (48 89 E5) + sub rsp,8*nlocals (48 83 EC imm8) -- present iff the body uses
-- locals] [the compiled body lowered via nc64_lower_loop -- if/else + rbp-frame locals + 64-bit
-- arithmetic; mid-body RET jmps to the grading tail, terminal RET (pop rax) falls through] [shr
-- rax,0x20 -- the grading tail: high dword of the body's 64-bit result into al] [shared 58-byte
-- epilogue: frame 0xDE<byte>0xAD on 0xE9 + result-dependent isa-debug-exit] [GDT/GDTR 30] [pad to
-- 4 KiB] [PML4][PDPT][PD]. The prefix is 5 bytes (mov esp) with no locals, 12 (mov esp + mov rbp,rsp +
-- sub rsp,imm8) with locals; branch rel32s resolve through nc64_layout_loop (the prefix is the layout
-- origin, so rel32s cancel it). Reuses hoopteeter's transition head/GDT/PAE tables and lingo's ehdr/
-- phdr/mbheader + the shared epilogue verbatim, so the nine prior modes are byte-identical and the
-- self-host fixpoint is preserved. For a straight-line no-locals body, prefix_len=5 and the layout/lower
-- produce IDENTICAL bytes to the pre-widen path -> byte-identical image (the f2 byte-identity guarantee).
-- ============================================================================
-- taproot (native-codegen link 62 / kernel-arc link 46): USER CALLS + RECURSION on
-- the sovereign x86-64 freestanding target. Widens multiboot32-long64 from a single
-- main() to a MULTI-FUNCTION program with recursion -- ouroboros's proven 32-bit call
-- ABI (push args; push rbp/mov rbp,rsp/sub rsp; param-copy; add rsp cleanup; push rax
-- result; backward E8 rel32) widened to 8-byte slots + REX.W. Herbert has no loops and
-- this target has no TCO, so recursion-via-call is the only iteration -- without it no
-- freestanding program of substance exists.
--
-- Dispatch: the long64 driver routes count(funcs)==1 to the UNTOUCHED single-function
-- path (byte-identical: link26/29 goldens are all single-main), count(funcs)>1 here.
-- main is funcs[0] (the graded entry; special prefix = the mode-setup mov esp + optional
-- rbp frame, then grading tail + shared epilogue; NEVER a call target). Callees (funcs[1..])
-- are standard 64-bit functions placed after main's epilogue, entered only by E8 rel32.
-- Calling main (index 0) is BANNED (it would re-run the mode setup and exit, never returning).
--
-- SAFETY (guard page -- the load-bearing invariant): the stack is relocated to its OWN
-- 2-MiB identity page, with the 2-MiB page BELOW it marked NON-PRESENT in the PD, so a
-- recursion that overflows the stack takes a #PF -> triple-fault (a deterministic,
-- observable divergence) instead of SILENTLY CORRUPTING the page tables (which sit just
-- above the image). The single-function path keeps the whole-low-1-GiB identity map.
-- ============================================================================

func nc_tap_op_allowed(op):
    if op == 57:
        return true
    end
    if op == 20:
        return true
    end
    if op == 45:
        return true
    end
    if op == 53:
        return true
    end
    if op == 49:
        return true
    end
    if op == 50:
        return true
    end
    if op == 51:
        return true
    end
    return nc64_op_allowed(op)
end

func nc_tap_pops(op, nargs):
    if op == 57:
        return 0
    end
    if op == 20:
        return nargs
    end
    if op == 45:
        return 0
    end
    if op == 53:
        return 1
    end
    if op == 49:
        return 0
    end
    if op == 50:
        return 2
    end
    if op == 51:
        return 3
    end
    return nc64_pops(op)
end

func nc_tap_pushes(op):
    if op == 57:
        return 1
    end
    if op == 20:
        return 1
    end
    if op == 45:
        return 1
    end
    if op == 53:
        return 1
    end
    if op == 49:
        return 1
    end
    if op == 50:
        return 1
    end
    if op == 51:
        return 1
    end
    return nc64_pushes(op)
end

-- PASS A depth walk (op-20-aware; mirrors nc64_build_depths). Cap 1500 (each push is
-- 8 bytes); the guard page is the runtime backstop for deeper recursion.
func nc_tap_build_depths(code, i, n, cur, depths):
    if i >= n:
        return (1, depths)
    end
    let op = get(code, i).0
    if not nc_tap_op_allowed(op):
        return (0, depths)
    end
    if cur > 1500:
        return (0, depths)
    end
    let pops = nc_tap_pops(op, get(code, i).2)
    if cur < pops:
        return (0, depths)
    end
    do add(depths, cur)
    if op == 21:
        if cur != 1:
            return (0, depths)
        end
    end
    return nc_tap_build_depths(code, i + 1, n, cur - pops + nc_tap_pushes(op), depths)
end

func nc_tap_body_ok(code, n):
    if n == 0:
        return false
    end
    if get(code, n - 1).0 != 21:
        return false
    end
    let bd = nc_tap_build_depths(code, 0, n, 0, new_array(int))
    if bd.0 == 0:
        return false
    end
    return nc32_check_branches(code, 0, n, bd.1)
end

-- op-20 size at 64-bit width: E8 rel32 (5) + caller cleanup (0 / add rsp,imm8 = 4 /
-- add rsp,imm32 = 7) + push rax (1). Every other op reuses nc64_op_size.
func nc_tap_op_size(op, nargs, is_last):
    if op == 57:
        return 19
    end
    if op == 20:
        let cl = 0
        if nargs > 0:
            if 8 * nargs <= 127:
                cl = 4
            else:
                cl = 7
            end
        end
        return 5 + cl + 1
    end
    if op == 45:
        return 18
    end
    if op == 53:
        return 18
    end
    if op == 49:
        return 11
    end
    if op == 50:
        return 7
    end
    if op == 51:
        return 8
    end
    return nc64_op_size(op, is_last)
end

func nc_tap_frame_size(fn):
    let code = fn.4
    let n = count(code)
    let s = nc32_nlocals_loop(code, 0, n, 0)
    if fn.2 > s:
        s = fn.2
    end
    return s
end

-- gyre (link65): tail-call eligibility on the long64 tap target -- the Linux-parity
-- rule (nc_is_tail_call precedent + EQUAL ARGUMENT WORDS + non-main caller). Every tap
-- slot is one word, so equal argument words == equal arity; every tap function returns
-- exactly one word (op-21 depth-1 invariant), so the Linux rw==my_rw leg is structural.
-- main is EXCLUDED: its prologue has no push rbp and no return address ([rbp]/[rbp+8]
-- would be garbage above the relocated stack top), and its op-21 falls into the grading
-- tail -- a tail transition from main would be flatly wrong, so its calls stay E8.
func nc_tap_is_tco(code, i, n, funcs, is_main, nparams):
    if is_main == 1:
        return false
    end
    if not nc_is_tail_call(code, i, n):
        return false
    end
    if get(funcs, get(code, i).1).2 == nparams:
        return true
    end
    return false
end

-- gyre: tail-transition byte length. Frame-zero caller (nparams==0, no locals -- the
-- operand stack holds exactly nargs==0 words at a tail site, so rsp ALREADY points AT
-- the return address and rbp is already the parent's): bare `E9 rel32` = 5. Frameful
-- caller: preamble (4+4) + 9 per copied arg (48 8B 44 24 ib = 5; 48 89 45 ib = 4) +
-- store r11 (4) + lea rsp (4) + mov rbp,r10 (3) + E9 rel32 (5) = 24 + 9*nargs. The
-- 14-param cap keeps every displacement disp8 (src max 8*13=104, dst max 8+8*14=120).
func nc_tap_tail_len(nargs, frame):
    if frame == 0:
        return 5
    end
    return 24 + 9 * nargs
end

-- gyre: per-site op size -- the tail-aware wrapper the tap grouping/sizing walkers
-- (nc_tap_body_size, nc_tap_offsets_loop, nc_tap_lower_body) use, so a TAIL op-20 is
-- sized as its transition and every other op keeps nc_tap_op_size. Sizing and lowering
-- consult the SAME nc_tap_is_tco predicate, so the ERR 610/611 block-length invariants
-- keep their teeth over tail sites.
func nc_tap_op_size_at(code, i, n, funcs, is_main, nparams, frame):
    if nc_tap_is_tco(code, i, n, funcs, is_main, nparams):
        return nc_tap_tail_len(get(code, i).2, frame)
    end
    let il = 0
    if i == n - 1:
        il = 1
    end
    return nc_tap_op_size(get(code, i).0, get(code, i).2, il)
end

-- gyre: copy the k-th of nf argument words from the OPERAND STACK into the caller's
-- incoming argument slots. The operand stack is the parallel-move staging area (the
-- Linux nc_emit_tail_copy_loop discipline): every new argument was fully evaluated and
-- pushed BEFORE any destination slot is written, so a swap `return f(b, a)` reads both
-- sources from staged copies, never from a clobbered slot. At a tail site the operand
-- stack holds EXACTLY the nf argument words (op-21 depth-1 invariant), arg k deepest:
-- src = [rsp + 8*(nf-1-k)]; dst = [rbp + 8 + 8*(nf-k)] -- arg k's own incoming slot
-- under the equal-arity rule (the Linux ng==nf specialization), disjoint from every
-- src because the operand stack sits below the frame while the slots sit above rbp.
func nc_tap_emit_tail_copy(obuf, k, nf):
    if k >= nf:
        return obuf
    end
    do append(obuf, 72)    -- 48 8B 44 24 ib mov rax,[rsp + 8*(nf-1-k)]
    do append(obuf, 139)
    do append(obuf, 68)
    do append(obuf, 36)
    do append(obuf, 8 * (nf - 1 - k))
    do append(obuf, 72)    -- 48 89 45 ib    mov [rbp + 8 + 8*(nf-k)],rax
    do append(obuf, 137)
    do append(obuf, 69)
    do append(obuf, 8 + 8 * (nf - k))
    return nc_tap_emit_tail_copy(obuf, k + 1, nf)
end

-- gyre: the TAIL transition -- the long64 port of the proven Linux nc_emit_tail_call,
-- same structure, tap ABI. Frameful caller:
--   4C 8B 5D 08  mov r11,[rbp+8]   save the return address BEFORE any slot is touched
--   4C 8B 55 00  mov r10,[rbp]     save the parent rbp
--   <copy loop>                    stage-copy nf args operand-stack -> incoming slots
--   4C 89 5D 08  mov [rbp+8],r11   rewrite the return-address slot (equal arity makes
--                                  this slot the SAME [rbp+8] -- kept for byte-level
--                                  parity with the Linux sequence's rslot store)
--   48 8D 65 08  lea rsp,[rbp+8]   the STACK RECLAMATION: locals + operand stack are
--                                  released in one move; rsp now points AT the return
--                                  address -- exactly a fresh E8 entry's stack shape
--   4C 89 D5     mov rbp,r10       restore the parent rbp
--   E9 rel32     jmp callee ENTRY  the callee's own prologue re-frames at the SAME
--                                  address -> constant stack at any depth
-- Frame-zero caller (nparams==0): rsp already points AT the return address and rbp is
-- already the parent's, so the transition is the bare E9. Either way the callee entry
-- state is byte-for-byte what an E8 call would have produced (minus the pushed frame).
func nc_tap_emit_tail_call(obuf, nargs, frame, cbase, tail_end):
    if frame == 0:
        do append(obuf, 233)   -- E9 rel32 jmp callee entry
        return nc_append_rel32(obuf, cbase, tail_end)
    end
    do append(obuf, 76)    -- 4C 8B 5D 08 mov r11,[rbp+8]
    do append(obuf, 139)
    do append(obuf, 93)
    do append(obuf, 8)
    do append(obuf, 76)    -- 4C 8B 55 00 mov r10,[rbp]
    do append(obuf, 139)
    do append(obuf, 85)
    do append(obuf, 0)
    obuf = nc_tap_emit_tail_copy(obuf, 0, nargs)
    do append(obuf, 76)    -- 4C 89 5D 08 mov [rbp+8],r11
    do append(obuf, 137)
    do append(obuf, 93)
    do append(obuf, 8)
    do append(obuf, 72)    -- 48 8D 65 08 lea rsp,[rbp+8] (reclaim locals + operands)
    do append(obuf, 141)
    do append(obuf, 101)
    do append(obuf, 8)
    do append(obuf, 76)    -- 4C 89 D5    mov rbp,r10
    do append(obuf, 137)
    do append(obuf, 213)
    do append(obuf, 233)   -- E9 rel32    jmp callee entry
    return nc_append_rel32(obuf, cbase, tail_end)
end

-- prologue bytes. main (frame>0): mov rbp,rsp (3) + sub rsp,8S (4) = 7. callee (frame>0):
-- push rbp (1) + mov rbp,rsp (3) + sub rsp,8S (4) + nparams*8 param-copies. frame==0: none.
func nc_tap_prologue_len(is_main, nparams, frame):
    if frame == 0:
        return 0
    end
    if is_main == 1:
        return 7
    end
    return 8 + nparams * 8
end

func nc_tap_epilogue_len(is_main, frame):
    if is_main == 1:
        return 0
    end
    if frame > 0:
        return 5
    end
    return 1
end

-- gyre: body sizing is TAIL-AWARE via nc_tap_op_size_at (a tail op-20 is sized as its
-- transition), so it threads (funcs, is_main, nparams, frame) -- the same context the
-- lowering consults, keeping sizes and bytes in lockstep for the ERR 610/611 checks.
func nc_tap_body_size(code, i, n, acc, funcs, is_main, nparams, frame):
    if i >= n:
        return acc
    end
    return nc_tap_body_size(code, i + 1, n, acc + nc_tap_op_size_at(code, i, n, funcs, is_main, nparams, frame), funcs, is_main, nparams, frame)
end

func nc_tap_func_total(fn, funcs, is_main, frame):
    let code = fn.4
    let n = count(code)
    return nc_tap_prologue_len(is_main, fn.2, frame) + nc_tap_body_size(code, 0, n, 0, funcs, is_main, fn.2, frame) + nc_tap_epilogue_len(is_main, frame)
end

func nc_tap_callees_total(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let fn = get(funcs, i)
    let frame = nc_tap_frame_size(fn)
    return nc_tap_callees_total(funcs, i + 1, nf, acc + nc_tap_func_total(fn, funcs, 0, frame))
end

-- absolute instruction offsets within one function (cur starts at the function's body
-- base = its image base + its prologue length). gyre: tail-aware via nc_tap_op_size_at.
func nc_tap_offsets_loop(code, i, n, cur, offs, funcs, is_main, nparams, frame):
    if i >= n:
        return (offs, cur)
    end
    do add(offs, cur)
    return nc_tap_offsets_loop(code, i + 1, n, cur + nc_tap_op_size_at(code, i, n, funcs, is_main, nparams, frame), offs, funcs, is_main, nparams, frame)
end

-- mov rax,[rbp + 16 + 8*(nparams-1-i)] (48 8B 45 disp8); mov [rbp - 8*(i+1)],rax
-- (48 89 45 disp8). Source disp bound: nparams<=14 -> 16+8*13=120<=127.
func nc_tap_emit_param_copies(obuf, i, nparams):
    if i >= nparams:
        return obuf
    end
    do append(obuf, 72)
    do append(obuf, 139)
    do append(obuf, 69)
    do append(obuf, 16 + 8 * (nparams - 1 - i))
    do append(obuf, 72)
    do append(obuf, 137)
    do append(obuf, 69)
    do append(obuf, 256 - 8 * (i + 1))
    return nc_tap_emit_param_copies(obuf, i + 1, nparams)
end

func nc_tap_emit_prologue(obuf, is_main, nparams, frame):
    if is_main == 1:
        do append(obuf, 72)    -- 48 89 E5 mov rbp,rsp
        do append(obuf, 137)
        do append(obuf, 229)
        do append(obuf, 72)    -- 48 83 EC ib sub rsp,8S
        do append(obuf, 131)
        do append(obuf, 236)
        do append(obuf, 8 * frame)
        return obuf
    end
    do append(obuf, 85)        -- 55 push rbp
    do append(obuf, 72)        -- 48 89 E5 mov rbp,rsp
    do append(obuf, 137)
    do append(obuf, 229)
    do append(obuf, 72)        -- 48 83 EC ib sub rsp,8S
    do append(obuf, 131)
    do append(obuf, 236)
    do append(obuf, 8 * frame)
    return nc_tap_emit_param_copies(obuf, 0, nparams)
end

func nc_tap_emit_epilogue(obuf, is_main, frame):
    if is_main == 1:
        return obuf
    end
    if frame > 0:
        do append(obuf, 72)    -- 48 89 EC mov rsp,rbp
        do append(obuf, 137)
        do append(obuf, 236)
        do append(obuf, 93)    -- 5D pop rbp
        do append(obuf, 195)   -- C3 ret
        return obuf
    end
    do append(obuf, 195)       -- C3 ret
    return obuf
end

-- lower one function body at 64-bit width with ABSOLUTE image offsets. Identical to
-- nc64_lower_loop for ops {0,3,4,5,6,11,12,16,17,42,21}; adds op 20 (call): E8 rel32 to
-- the callee's image base (bases[callee]) -- FORWARD or BACKWARD (recursion) via the
-- signed nc_append_rel32 -- + add rsp,8*nargs cleanup + push rax. gyre: an op-20 that
-- nc_tap_is_tco accepts (non-main, nc_is_tail_call, equal argument words) is lowered as
-- the constant-stack TAIL transition (nc_tap_emit_tail_call, E9 -- never E8) instead;
-- the op-21 after a tail site is still emitted (dead but shape-preserving, the Linux
-- lowering's discipline). NON-tail calls keep the E8 + cleanup + push rax form.
func nc_tap_lower_body(obuf, code, i, n, offs, epi, bases, funcs, is_main, nparams, frame, buf_2m):
    if i >= n:
        return obuf
    end
    let op = get(code, i).0
    let il = 0
    if i == n - 1:
        il = 1
    end
    let endoff = get(offs, i) + nc_tap_op_size_at(code, i, n, funcs, is_main, nparams, frame)
    if op == 0:
        obuf = nc_emit_push_int(obuf, get(code, i).1)
    elif op == 3:
        do append(obuf, 72)
        do append(obuf, 139)
        do append(obuf, 69)
        obuf = nc64_emit_local_disp(obuf, get(code, i).1)
        do append(obuf, 80)
    elif op == 4:
        do append(obuf, 88)
        do append(obuf, 72)
        do append(obuf, 137)
        do append(obuf, 69)
        obuf = nc64_emit_local_disp(obuf, get(code, i).1)
    elif op == 5:
        obuf = nc_emit_add(obuf)
    elif op == 6:
        obuf = nc_emit_sub(obuf)
    elif op == 11:
        do append(obuf, 89)
        do append(obuf, 88)
        do append(obuf, 72)
        do append(obuf, 57)
        do append(obuf, 200)
        do append(obuf, 15)
        do append(obuf, 148)
        do append(obuf, 194)
        do append(obuf, 72)
        do append(obuf, 15)
        do append(obuf, 182)
        do append(obuf, 194)
        do append(obuf, 80)
    elif op == 12:
        do append(obuf, 89)
        do append(obuf, 88)
        do append(obuf, 72)
        do append(obuf, 57)
        do append(obuf, 200)
        do append(obuf, 15)
        do append(obuf, 149)
        do append(obuf, 194)
        do append(obuf, 72)
        do append(obuf, 15)
        do append(obuf, 182)
        do append(obuf, 194)
        do append(obuf, 80)
    elif op == 16:
        do append(obuf, 233)
        let t = get(code, i).1
        let toff = epi
        if t < n:
            toff = get(offs, t)
        end
        obuf = nc_append_le32(obuf, toff - endoff)
    elif op == 17:
        do append(obuf, 88)
        do append(obuf, 72)
        do append(obuf, 133)
        do append(obuf, 192)
        do append(obuf, 15)
        do append(obuf, 132)
        let t2 = get(code, i).1
        let toff2 = epi
        if t2 < n:
            toff2 = get(offs, t2)
        end
        obuf = nc_append_le32(obuf, toff2 - endoff)
    elif op == 42:
        obuf = nc_emit_mul(obuf)
    elif op == 57:
        -- folio: R12/R13 are reserved cursor/end across all admitted ops and
        -- ordinary/tail calls. Compare BEFORE loading; EOF leaves both alone.
        do append(obuf, 184)  -- B8 00010000 mov eax,256
        obuf = nc_append_le32(obuf, 256)
        do append(obuf, 77)   -- 4D 39 EC cmp r12,r13
        do append(obuf, 57)
        do append(obuf, 236)
        do append(obuf, 115)  -- 73 08 jae done (unsigned)
        do append(obuf, 8)
        do append(obuf, 65)   -- 41 0F B6 04 24 movzx eax,byte [r12]
        do append(obuf, 15)
        do append(obuf, 182)
        do append(obuf, 4)
        do append(obuf, 36)
        do append(obuf, 73)   -- 49 FF C4 inc r12
        do append(obuf, 255)
        do append(obuf, 196)
        do append(obuf, 80)   -- done: push rax
    elif op == 45:
        -- hearken op_input_byte on the long64 target: poll COM1 LSR (0x3FD) for Data-Ready,
        -- then read the RBR (0x3F8) and push the byte zero-extended. 18 bytes, byte-identical
        -- to the proven i386 op-45 lowering -- port I/O + movzx + push are opcode-identical in
        -- long mode, and push (0x50) pushes 8 bytes (the long64 slot). Self-contained (the jz
        -- back-edge is an internal rel8), fully position-independent -> no layout dependence.
        do append(obuf, 102)   -- 66
        do append(obuf, 186)   -- BA  mov dx, 0x03FD (LSR)
        do append(obuf, 253)   -- FD
        do append(obuf, 3)     -- 03
        do append(obuf, 236)   -- EC  in al, dx
        do append(obuf, 168)   -- A8  test al,
        do append(obuf, 1)     -- 01     1 (Data-Ready)
        do append(obuf, 116)   -- 74  jz
        do append(obuf, 247)   -- F7     rel8 -9 -> back to the mov dx,0x3FD
        do append(obuf, 102)   -- 66
        do append(obuf, 186)   -- BA  mov dx, 0x03F8 (RBR)
        do append(obuf, 248)   -- F8
        do append(obuf, 3)     -- 03
        do append(obuf, 236)   -- EC  in al, dx  (the live byte)
        do append(obuf, 15)    -- 0F
        do append(obuf, 182)   -- B6  movzx eax, al
        do append(obuf, 192)   -- C0
        do append(obuf, 80)    -- 50  push rax (8-byte slot; upper 32 bits zeroed by movzx eax)
    elif op == 53:
        -- riposte op_output_byte on the long64 target: WRITE-THEN-DRAIN. Pop the argument,
        -- write its low byte to the COM1 THR (0x3F8), then poll LSR (0x3FD) bit 6 (TEMT --
        -- transmitter fully EMPTY, holding+shift both drained) before returning, so every
        -- op-53 leaves the byte ON THE WIRE and the THR free (the invariant that makes the
        -- unconditional write safe). STEP-0 proved the weaker THRE-before-write discipline
        -- LOSES bytes on Bochs's baud-paced TX model (back-to-back drops + a last-byte loss
        -- to shutdown); TEMT-after-write is also the real-16550-correct drain for the pinned
        -- physical target. Pushes the FULL argument back (rbx untouched by the poll), so the
        -- return value is v, not the al-truncated device byte. 18 self-contained bytes
        -- (internal rel8 back-edge only), position-independent -> no layout dependence.
        do append(obuf, 91)    -- 5B  pop rbx (the argument; bl = the wire byte)
        do append(obuf, 102)   -- 66
        do append(obuf, 186)   -- BA  mov dx, 0x03F8 (THR)
        do append(obuf, 248)   -- F8
        do append(obuf, 3)     -- 03
        do append(obuf, 136)   -- 88
        do append(obuf, 216)   -- D8  mov al, bl
        do append(obuf, 238)   -- EE  out dx, al  (the byte leaves the program)
        do append(obuf, 102)   -- 66
        do append(obuf, 186)   -- BA  mov dx, 0x03FD (LSR)
        do append(obuf, 253)   -- FD
        do append(obuf, 3)     -- 03
        do append(obuf, 236)   -- EC  in al, dx
        do append(obuf, 168)   -- A8  test al,
        do append(obuf, 64)    -- 40     0x40 (TEMT)
        do append(obuf, 116)   -- 74  jz
        do append(obuf, 247)   -- F7     rel8 -9 -> back to the mov dx,0x3FD
        do append(obuf, 83)    -- 53  push rbx (the full argument -- the op's value)
    elif op == 49:
        -- link66 op 49 bufbase(): push the 2-MiB-aligned base of the runtime-indexed buffer page as
        -- an ABSOLUTE immediate. buf_2m is a LAYOUT fact derived below from the phdr's own load_end,
        -- not a stack address -- long mode is flat and the buffer page is identity-mapped by the PD,
        -- so no segment override and no frame dependence (contrast the i386 op 49, which pushes
        -- [ebp+0] because its buffer lives in the module stack segment). movabs is the only 64-bit
        -- immediate form; 11 bytes. This immediate is what the gate's bufbase-eq leg decodes and
        -- compares against the phdr-derived base, and what M-basebias perturbs by +8.
        do append(obuf, 72)    -- 48
        do append(obuf, 184)   -- B8  movabs rax, imm64
        obuf = nc_append_le64(obuf, buf_2m)
        do append(obuf, 80)    -- 50  push rax
    elif op == 50:
        -- link66 op 50 bufget(base, k): TOS = k, next = base. The long64 analogue of the i386
        -- chiefturbo lowering (:15274-15283), with the SS override dropped (flat long mode) and the
        -- scale widened 4 -> 8 because a slot is a 64-bit word. 7 bytes, position-independent.
        do append(obuf, 89)    -- 59  pop rcx  (k)
        do append(obuf, 90)    -- 5A  pop rdx  (base)
        do append(obuf, 72)    -- 48
        do append(obuf, 139)   -- 8B
        do append(obuf, 4)     -- 04
        do append(obuf, 202)   -- CA  mov rax,[rdx+rcx*8]   (SIB scale bits 11 = x8)
        do append(obuf, 80)    -- 50  push rax
    elif op == 51:
        -- link66 op 51 bufset(base, i, v): TOS = v, next = i, next = base. Mirrors the i386 op-51
        -- register convention exactly (:15286-15294) -- pop v, pop i, pop base -- widened to 64-bit
        -- slots with the SS override dropped. Pushes v BACK (52 push rdx), so bufset's value is the
        -- word that was stored and the fill echo grades the store's own argument; removing that push
        -- is M-op51noret, which is size-preserving because 52 and 90 are both one byte. 8 bytes.
        do append(obuf, 90)    -- 5A  pop rdx  (v)
        do append(obuf, 89)    -- 59  pop rcx  (i)
        do append(obuf, 88)    -- 58  pop rax  (base)
        do append(obuf, 72)    -- 48
        do append(obuf, 137)   -- 89
        do append(obuf, 20)    -- 14
        do append(obuf, 200)   -- C8  mov [rax+rcx*8],rdx   (SIB scale bits 11 = x8)
        do append(obuf, 82)    -- 52  push rdx
    elif op == 20:
        let callee = get(code, i).1
        let nargs = get(code, i).2
        let cbase = get(bases, callee)
        if nc_tap_is_tco(code, i, n, funcs, is_main, nparams):
            -- gyre TAIL site: the constant-stack transition; endoff is the byte after
            -- the E9's rel32 (the transition is the whole per-site emission).
            obuf = nc_tap_emit_tail_call(obuf, nargs, frame, cbase, endoff)
        else:
            let call_end = get(offs, i) + 5
            do append(obuf, 232)   -- E8 call rel32
            obuf = nc_append_rel32(obuf, cbase, call_end)
            if nargs > 0:
                if 8 * nargs <= 127:
                    do append(obuf, 72)    -- 48 83 C4 ib add rsp,imm8
                    do append(obuf, 131)
                    do append(obuf, 196)
                    do append(obuf, 8 * nargs)
                else:
                    do append(obuf, 72)    -- 48 81 C4 id add rsp,imm32
                    do append(obuf, 129)
                    do append(obuf, 196)
                    obuf = nc_append_le32(obuf, 8 * nargs)
                end
            end
            do append(obuf, 80)    -- 50 push rax
        end
    elif op == 21:
        if il == 1:
            do append(obuf, 88)
        else:
            do append(obuf, 88)
            do append(obuf, 233)
            obuf = nc_append_le32(obuf, epi - endoff)
        end
    end
    return nc_tap_lower_body(obuf, code, i + 1, n, offs, epi, bases, funcs, is_main, nparams, frame, buf_2m)
end

-- callee image bases (i starts at 1; bases[0] = main entry, already added).
func nc_tap_callee_bases(funcs, i, nf, cur, bases):
    if i >= nf:
        return bases
    end
    do add(bases, cur)
    let fn = get(funcs, i)
    let frame = nc_tap_frame_size(fn)
    return nc_tap_callee_bases(funcs, i + 1, nf, cur + nc_tap_func_total(fn, funcs, 0, frame), bases)
end

func nc_tap_emit_callees(buf, funcs, i, nf, bases, buf_2m):
    if i >= nf:
        return buf
    end
    let fn = get(funcs, i)
    let code = fn.4
    let n = count(code)
    let frame = nc_tap_frame_size(fn)
    if frame > 0:
        buf = nc_tap_emit_prologue(buf, 0, fn.2, frame)
    end
    let pbase = get(bases, i) + nc_tap_prologue_len(0, fn.2, frame)
    let lay = nc_tap_offsets_loop(code, 0, n, pbase, new_array(int), funcs, 0, fn.2, frame)
    buf = nc_tap_lower_body(buf, code, 0, n, lay.0, lay.1, bases, funcs, 0, fn.2, frame, buf_2m)
    buf = nc_tap_emit_epilogue(buf, 0, frame)
    return nc_tap_emit_callees(buf, funcs, i + 1, nf, bases, buf_2m)
end

-- each call op targets an in-range NON-main function with matching arity.
func nc_tap_calls_ok(code, i, n, funcs, nf):
    if i >= n:
        return true
    end
    if get(code, i).0 == 20:
        let callee = get(code, i).1
        let nargs = get(code, i).2
        if callee == 0:
            let e1 = nc_fail(606, 0, "multiboot32-long64: cannot call main (the entry is not a callee)")
            return false
        end
        if callee >= nf:
            let e2 = nc_fail(607, 0, "multiboot32-long64: call target out of range")
            return false
        end
        if get(funcs, callee).2 != nargs:
            let e3 = nc_fail(608, 0, "multiboot32-long64: call arity mismatch")
            return false
        end
    end
    return nc_tap_calls_ok(code, i + 1, n, funcs, nf)
end

func nc_tap_func_ok(fn, funcs, nf, is_main):
    let code = fn.4
    let n = count(code)
    if not nc_tap_body_ok(code, n):
        let e4 = nc_fail(605, 0, "multiboot32-long64: function body not in the call+recursion subset")
        return false
    end
    if nc_tap_frame_size(fn) > 15:
        let e5 = nc_fail(602, 0, "multiboot32-long64: too many slots (max 15)")
        return false
    end
    if fn.2 > 14:
        let e6 = nc_fail(609, 0, "multiboot32-long64: more than 14 parameters (param-copy disp8 bound)")
        return false
    end
    if is_main == 1:
        if fn.2 != 0:
            let e7 = nc_fail(601, 0, "multiboot32-long64: main must take no parameters")
            return false
        end
    end
    return nc_tap_calls_ok(code, 0, n, funcs, nf)
end

func nc_tap_all_funcs_ok(funcs, i, nf):
    if i >= nf:
        return true
    end
    let ismain = 0
    if i == 0:
        ismain = 1
    end
    if not nc_tap_func_ok(get(funcs, i), funcs, nf, ismain):
        return false
    end
    return nc_tap_all_funcs_ok(funcs, i + 1, nf)
end

func nc_tap_roundup_2m(v):
    let r = v % 2097152
    if r == 0:
        return v
    end
    return v + 2097152 - r
end

-- identity-map the low 1 GiB as 2-MiB PS pages EXCEPT the guard page (its 2-MiB slot left
-- NON-PRESENT), so a stack overflow past the stack's own 2-MiB page faults instead of
-- corrupting the page tables.
func nc_tap_emit_pd_loop(buf, i, guard_2m, guard_lo_2m):
    if i >= 512:
        return buf
    end
    if i * 2097152 == guard_2m:
        buf = nc_append_le32(buf, 0)
        buf = nc_append_le32(buf, 0)
    elif i * 2097152 == guard_lo_2m:
        buf = nc_append_le32(buf, 0)
        buf = nc_append_le32(buf, 0)
    else:
        buf = nc_append_le32(buf, i * 2097152 + 131)
        buf = nc_append_le32(buf, 0)
    end
    return nc_tap_emit_pd_loop(buf, i + 1, guard_2m, guard_lo_2m)
end

-- hearken/riposte: any function body containing op 45 (input_byte) OR op 53 (output_byte)
-- means the image touches the COM1 UART, so UART init (56 bytes) is emitted ONCE at
-- long_entry. Neither op anywhere -> uart_len=0 -> byte-identical to taproot. (riposte
-- widened the predicate from op-45-only; an op-45-only program keeps the SAME block at the
-- SAME offset, so every hearken golden is byte-identical under the widened predicate.)
func nc_tap_code_uses_uart(code, i, n):
    if i >= n:
        return false
    end
    if get(code, i).0 == 45:
        return true
    end
    if get(code, i).0 == 53:
        return true
    end
    return nc_tap_code_uses_uart(code, i + 1, n)
end

func nc_tap_uses_uart(funcs, i, nf):
    if i >= nf:
        return false
    end
    let fn = get(funcs, i)
    let code = fn.4
    if nc_tap_code_uses_uart(code, 0, count(code)):
        return true
    end
    return nc_tap_uses_uart(funcs, i + 1, nf)
end

-- folio activation examines every lowered function, not reachability. The
-- non-input path emits neither capture nor validation and keeps its old bytes.
func nc_tap_code_uses_boot(code, i, n):
    if i >= n:
        return false
    end
    if get(code, i).0 == 57:
        return true
    end
    return nc_tap_code_uses_boot(code, i + 1, n)
end

func nc_tap_uses_boot(funcs, i, nf):
    if i >= nf:
        return false
    end
    let fn = get(funcs, i)
    let code = fn.4
    if nc_tap_code_uses_boot(code, 0, count(code)):
        return true
    end
    return nc_tap_uses_boot(funcs, i + 1, nf)
end

-- All validation failures branch backward to this boot path's inline stub.
-- Offsets are within cbuf, just like the existing tap layout; no patch table.
func nc_tap_boot_fail_branch(buf, cc, fail_off):
    do append(buf, 15)
    do append(buf, cc)
    let endoff = length(freeze(buf)) + 4
    return nc_append_rel32(buf, fail_off, endoff)
end

-- Validate the COMPLETE span [rax,rax+span) before dereferencing metadata.
-- RAX was loaded through EAX, so adding 16/28 at 64-bit width cannot wrap.
-- Accept nonnull spans wholly below 0xA0000, or wholly in [esp_val,64 MiB).
-- This appliance policy excludes image, guards, stack and the firmware hole;
-- it is not general physical-memory discovery. Clobbers RCX, preserves RAX.
-- Fixed 47 bytes; the forward JBE skips the 25-byte high-range checks.
func nc_tap_boot_span(buf, span, esp_val, fail_off):
    do append(buf, 72)   -- 48 85 C0 test rax,rax
    do append(buf, 133)
    do append(buf, 192)
    buf = nc_tap_boot_fail_branch(buf, 132, fail_off)  -- jz
    do append(buf, 72)   -- 48 8D 48 ib lea rcx,[rax+span]
    do append(buf, 141)
    do append(buf, 72)
    do append(buf, span)
    do append(buf, 72)   -- 48 81 F9 00000A00 cmp rcx,0xA0000
    do append(buf, 129)
    do append(buf, 249)
    buf = nc_append_le32(buf, 655360)
    do append(buf, 118)  -- 76 19 jbe accepted
    do append(buf, 25)
    do append(buf, 72)   -- 48 3D id cmp rax,esp_val
    do append(buf, 61)
    buf = nc_append_le32(buf, esp_val)
    buf = nc_tap_boot_fail_branch(buf, 130, fail_off)  -- jb
    do append(buf, 72)   -- 48 81 F9 00000004 cmp rcx,64 MiB
    do append(buf, 129)
    do append(buf, 249)
    buf = nc_append_le32(buf, 67108864)
    return nc_tap_boot_fail_branch(buf, 135, fail_off) -- ja
end

-- folio's 259-byte pre-main initializer, after mov esp,esp_val. The 32-bit
-- capture used ESI/EDI; explicitly normalize both here in 64-bit mode before
-- inspecting either value. Incoming upper register halves are not trustworthy.
-- R12/R13 become cursor/end only after complete descriptor validation. All
-- currently admitted tap operations, callee frames and TCO preserve them.
func nc_tap_boot_init(buf, esp_val):
    let start = length(freeze(buf))
    do append(buf, 137)  -- 89 F6 mov esi,esi (zero-extend saved magic)
    do append(buf, 246)
    do append(buf, 137)  -- 89 FF mov edi,edi (zero-extend saved MBI pointer)
    do append(buf, 255)
    do append(buf, 235)  -- EB 49 jump over the 73-byte failure stub
    do append(buf, 73)
    let fail_off = length(freeze(buf))
    do append(buf, 102)  -- 66 BA E900 mov dx,0xE9
    do append(buf, 186)
    do append(buf, 233)
    do append(buf, 0)
    buf = nc32_emit_out_char(buf, 66)  -- BI\n, before the ordinary grade-1 tail
    buf = nc32_emit_out_char(buf, 73)
    buf = nc32_emit_out_char(buf, 10)
    do append(buf, 176)  -- B0 01 mov al,1
    do append(buf, 1)
    buf = nc32_emit_epilogue(buf)
    do append(buf, 129)  -- 81 FE 02B0AD2B cmp esi,Multiboot magic
    do append(buf, 254)
    buf = nc_append_le32(buf, 732803074)
    buf = nc_tap_boot_fail_branch(buf, 133, fail_off) -- jne (no metadata load yet)
    do append(buf, 137)  -- 89 F8 mov eax,edi
    do append(buf, 248)
    buf = nc_tap_boot_span(buf, 28, esp_val, fail_off)
    do append(buf, 246)  -- F6 00 08 test byte [rax],8 (module-present flag)
    do append(buf, 0)
    do append(buf, 8)
    buf = nc_tap_boot_fail_branch(buf, 132, fail_off) -- jz
    do append(buf, 131)  -- 83 78 14 01 cmp dword [rax+20],1
    do append(buf, 120)
    do append(buf, 20)
    do append(buf, 1)
    buf = nc_tap_boot_fail_branch(buf, 133, fail_off) -- jne
    do append(buf, 139)  -- 8B 40 18 mov eax,[rax+24] (zero-extended descriptor)
    do append(buf, 64)
    do append(buf, 24)
    buf = nc_tap_boot_span(buf, 16, esp_val, fail_off)
    do append(buf, 68)   -- 44 8B 20 mov r12d,[rax] (module start)
    do append(buf, 139)
    do append(buf, 32)
    do append(buf, 68)   -- 44 8B 68 04 mov r13d,[rax+4] (module end)
    do append(buf, 139)
    do append(buf, 104)
    do append(buf, 4)
    do append(buf, 77)   -- 4D 39 EC cmp r12,r13 (ordered extent)
    do append(buf, 57)
    do append(buf, 236)
    buf = nc_tap_boot_fail_branch(buf, 135, fail_off) -- ja
    do append(buf, 76)   -- 4C 89 E1 mov rcx,r12
    do append(buf, 137)
    do append(buf, 225)
    do append(buf, 76)   -- 4C 09 E9 or rcx,r13
    do append(buf, 9)
    do append(buf, 233)
    do append(buf, 116)  -- 74 1A jz accepted: GRUB's exact empty sentinel 0,0
    do append(buf, 26)
    do append(buf, 73)   -- 49 81 FC id cmp r12,esp_val
    do append(buf, 129)
    do append(buf, 252)
    buf = nc_append_le32(buf, esp_val)
    buf = nc_tap_boot_fail_branch(buf, 130, fail_off) -- jb
    do append(buf, 73)   -- 49 81 FD 00000004 cmp r13,64 MiB
    do append(buf, 129)
    do append(buf, 253)
    buf = nc_append_le32(buf, 67108864)
    buf = nc_tap_boot_fail_branch(buf, 135, fail_off) -- ja
    if length(freeze(buf)) != start + 259:
        let failed = nc_fail(656, 0, "multiboot32-long64: boot initializer length invariant")
        return buf
    end
    return buf
end

-- link66 BUFFER MODE, the exact mirror of the uart predicate above: any function body containing
-- op 49 (bufbase), 50 (bufget) or 51 (bufset) means the image needs the runtime-indexed buffer, so
-- the two-guard layout, the buffer page and the exact p_memsz are emitted. NONE of them anywhere ->
-- buffer mode off -> the layout, the PD and p_memsz are byte-identical to taproot/hearken/riposte/
-- gyre, which is why this change cannot move any of the 29 committed long64 goldens.
func nc_tap_code_uses_buf(code, i, n):
    if i >= n:
        return false
    end
    let op = get(code, i).0
    if op == 49:
        return true
    end
    if op == 50:
        return true
    end
    if op == 51:
        return true
    end
    return nc_tap_code_uses_buf(code, i + 1, n)
end

func nc_tap_uses_buf(funcs, i, nf):
    if i >= nf:
        return false
    end
    let fn = get(funcs, i)
    let code = fn.4
    if nc_tap_code_uses_buf(code, 0, count(code)):
        return true
    end
    return nc_tap_uses_buf(funcs, i + 1, nf)
end

-- the IR gate's census: how many INDEXED ops (50/51) the whole program contains. bufbase alone
-- hands a program a live absolute pointer into a page it never indexes, which is buffer geometry
-- bought and not used; the gate below refuses it.
func nc_tap_code_idx_ops(code, i, n, acc):
    if i >= n:
        return acc
    end
    let op = get(code, i).0
    if op == 50:
        acc = acc + 1
    end
    if op == 51:
        acc = acc + 1
    end
    return nc_tap_code_idx_ops(code, i + 1, n, acc)
end

func nc_tap_idx_ops(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let fn = get(funcs, i)
    let code = fn.4
    acc = nc_tap_code_idx_ops(code, 0, count(code), acc)
    return nc_tap_idx_ops(funcs, i + 1, nf, acc)
end

-- the taproot driver (multiple functions, or folio input). Layout (V0=0x10000c):
-- [folio capture: 4 bytes iff boot_read] [56-byte head -> ljmp long_entry]
-- [mov esp,esp_val] [folio validation: 259 bytes iff boot_read] [uart init: 56 bytes iff any func
-- reads input (hearken)] [optional main rbp frame] [main body -- calls to callees via E8
-- rel32] [grading tail: shr rax,0x20] [shared 58-byte epilogue] [CALLEE BLOCK: funcs[1..],
-- each prologue+body+epilogue] [GDT/GDTR 30] [pad to 4 KiB] [PML4][PDPT][PD w/ guard]. main
-- never falls through to the callees (the epilogue exits via isa-debug-exit); they are
-- entered only by call.
func nc_tap_emit_program(funcs, mainidx):
    let nf = count(funcs)
    if mainidx != 0:
        let e0 = nc_fail(600, 0, "multiboot32-long64: main not the entry (index 0)")
        return 0
    end
    if not equal(get(funcs, 0).0, "main"):
        let e0b = nc_fail(600, 0, "multiboot32-long64: entry function is not main")
        return 0
    end
    if not nc_tap_all_funcs_ok(funcs, 0, nf):
        return 0
    end
    let mainfn = get(funcs, 0)
    let maincode = mainfn.4
    let mainn = count(maincode)
    let main_frame = nc_tap_frame_size(mainfn)
    let main_prefix = 5
    if main_frame > 0:
        main_prefix = 12
    end
    let uart_len = 0
    if nc_tap_uses_uart(funcs, 0, nf):
        uart_len = 56
    end
    let uses_boot = nc_tap_uses_boot(funcs, 0, nf)
    let capture_len = 0
    let boot_init_len = 0
    if uses_boot:
        capture_len = 4
        boot_init_len = 259
    end
    let head_len = capture_len + 56
    let main_bodylen = nc_tap_body_size(maincode, 0, mainn, 0, funcs, 1, 0, main_frame)
    let v0 = 1048588
    let long_entry_vaddr = v0 + head_len
    let main_body_base = head_len + main_prefix + boot_init_len + uart_len
    let main_epi_abs = main_body_base + main_bodylen
    let callee_block_start = main_epi_abs + 4 + 58
    let bases = new_array(int)
    do add(bases, head_len)
    bases = nc_tap_callee_bases(funcs, 1, nf, callee_block_start, bases)
    let callee_block_len = nc_tap_callees_total(funcs, 1, nf, 0)
    let gdt_off = callee_block_start + callee_block_len
    let gdt_vaddr = v0 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let tables_end = gdtr_vaddr + 6
    let pml4_vaddr = nc32_roundup_4k(tables_end)
    let pdpt_vaddr = pml4_vaddr + 4096
    let pd_vaddr = pdpt_vaddr + 4096
    let load_end = pd_vaddr + 4096
    -- link66 BUFFER MODE. Off -> every line below is exactly what taproot/hearken/riposte/gyre
    -- emit today, which is what keeps the 29 committed long64 goldens byte-identical.
    let uses_buf = nc_tap_uses_buf(funcs, 0, nf)
    if uses_buf:
        -- THE IR GATE. Buffer mode buys a 2-MiB page, two non-present guards and an absolute base
        -- immediate. A program that takes all of that and never indexes the page (bufbase() with no
        -- bufget/bufset anywhere) is refused rather than quietly handed a live pointer it cannot use.
        if nc_tap_idx_ops(funcs, 0, nf, 0) < 1:
            let fb = nc_fail(655, 0, "multiboot32-long64: buffer mode needs at least one bufget/bufset")
            return 0
        end
    end
    -- guard_2m is the HIGH guard in both modes -- the stack's own overflow backstop -- so the stack
    -- relationship never changes. In buffer mode a SECOND non-present 2-MiB slot (guard_lo_2m) is
    -- opened below the buffer, giving the layout
    --     load_end -> [guard_lo NON-PRESENT] [buf_2m 2 MiB PRESENT] [guard_hi NON-PRESENT] [stack]
    -- so index -1 faults into guard_lo, index 262143 is the last live slot (2 MiB / 8 B = 262144
    -- slots) and index 262144 faults into guard_hi. Those are SC3's three boundary probes, decided
    -- by the page tables rather than by a bounds check the program could omit. Outside buffer mode
    -- guard_lo_2m is -1, which no PD index can equal, so the PD is byte-identical to today's.
    let guard_lo_2m = 0 - 1
    let buf_2m = 0
    let guard_2m = nc_tap_roundup_2m(load_end)
    if uses_buf:
        guard_lo_2m = guard_2m
        buf_2m = guard_lo_2m + 2097152
        guard_2m = buf_2m + 2097152
    end
    let stack_2m_base = guard_2m + 2097152
    let esp_val = stack_2m_base + 2097152
    if esp_val > 67108864:
        let f7 = nc_fail(603, 0, "multiboot32-long64: stack exceeds the 64-MiB target RAM budget")
        return 0
    end
    let cbuf = new_buffer()
    if uses_boot:
        -- Capture before the old 32-bit head clobbers EAX/ECX/EDX. Do not
        -- push to the unspecified incoming stack; ESI/EDI survive the head.
        do append(cbuf, 137)  -- 89 C6 mov esi,eax (Multiboot magic)
        do append(cbuf, 198)
        do append(cbuf, 137)  -- 89 DF mov edi,ebx (information pointer)
        do append(cbuf, 223)
    end
    cbuf = nc32_long_emit_head(cbuf, gdtr_vaddr, pml4_vaddr, long_entry_vaddr)
    do append(cbuf, 188)   -- BC mov esp,imm32
    cbuf = nc_append_le32(cbuf, esp_val)
    if uses_boot:
        cbuf = nc_tap_boot_init(cbuf, esp_val)
    end
    if uart_len > 0:
        cbuf = nc32_uart_init(cbuf)   -- hearken: COM1 init once, before the main frame
    end
    if main_frame > 0:
        do append(cbuf, 72)    -- 48 89 E5 mov rbp,rsp
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 72)    -- 48 83 EC ib sub rsp,8S
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 8 * main_frame)
    end
    if uses_boot and length(freeze(cbuf)) != main_body_base:
        let fboot = nc_fail(656, 0, "multiboot32-long64: boot prefix length invariant")
        return 0
    end
    let mlay = nc_tap_offsets_loop(maincode, 0, mainn, main_body_base, new_array(int), funcs, 1, 0, main_frame)
    cbuf = nc_tap_lower_body(cbuf, maincode, 0, mainn, mlay.0, mlay.1, bases, funcs, 1, 0, main_frame, buf_2m)
    do append(cbuf, 72)    -- 48 C1 E8 20 shr rax,0x20 (grading tail)
    do append(cbuf, 193)
    do append(cbuf, 232)
    do append(cbuf, 32)
    cbuf = nc32_emit_epilogue(cbuf)
    if length(freeze(cbuf)) != callee_block_start:
        let f8 = nc_fail(610, 0, "multiboot32-long64: main block length invariant")
        return 0
    end
    cbuf = nc_tap_emit_callees(cbuf, funcs, 1, nf, bases, buf_2m)
    if length(freeze(cbuf)) != gdt_off:
        let f9 = nc_fail(611, 0, "multiboot32-long64: callee block length invariant")
        return 0
    end
    cbuf = nc32_long_emit_gdt(cbuf, gdt_vaddr)
    let pre_pml4_len = length(freeze(cbuf))
    let pad_to_pml4 = pml4_vaddr - v0 - pre_pml4_len
    cbuf = nc_emit_zeroes_loop(cbuf, pad_to_pml4)
    cbuf = nc32_long_emit_pml4(cbuf, pdpt_vaddr)
    cbuf = nc32_long_emit_pdpt(cbuf, pd_vaddr)
    cbuf = nc_tap_emit_pd_loop(cbuf, 0, guard_2m, guard_lo_2m)
    let frozen_code = freeze(cbuf)
    let code_len = length(frozen_code)
    if code_len != load_end - v0:
        let f6 = nc_fail(604, 0, "multiboot32-long64: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    -- p_memsz. Outside buffer mode this stays the landed filesz+16384 (D23's known
    -- under-declaration, deliberately untouched here so no golden moves). IN BUFFER MODE it is
    -- EXACT: the segment reserves every byte from its own load address 0x100000 up to the high
    -- guard, so the page the program indexes is DECLARED memory rather than memory the image merely
    -- happens to find mapped. M-memsz reverts this to filesz+16384 and the static phdr assert
    -- (p_memsz == guard_hi_2m - 0x100000) catches it without a boot.
    let memsz = filesz + 16384
    if uses_buf:
        memsz = guard_2m - 1048576
    end
    if uses_boot:
        -- Reserve the COMPLETE new input image, including guards and stack,
        -- before a loader places its module. Applied after buffer reservation.
        -- Non-input images retain the historical p_memsz and D23 scope.
        memsz = esp_val - 1048576
    end
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

func nc_emit_multiboot32_long64_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1 or nc_tap_uses_boot(funcs, 0, count(funcs)):
        return nc_tap_emit_program(funcs, prog.2)
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(501, 0, "multiboot32-long64: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc64_body_ok(code, n):
        let f3 = nc_fail(502, 0, "multiboot32-long64: body not in the control-flow+locals 64-bit subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 15:
        let f4 = nc_fail(504, 0, "multiboot32-long64: too many locals (max 15)")
        return 0
    end
    let prefix_len = 5
    if nlocals > 0:
        prefix_len = 12
    end
    let lay = nc64_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc64_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let f5 = nc_fail(505, 0, "multiboot32-long64: body length invariant (a lowered op was dropped or mis-sized)")
        return 0
    end
    let v0 = 1048588
    let long_entry_vaddr = v0 + 56
    let region_len = prefix_len + bodylen + 4
    let epi_off = 56 + region_len
    let gdt_off = epi_off + 58
    let gdt_vaddr = v0 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let tables_end = gdtr_vaddr + 6
    let pml4_vaddr = nc32_roundup_4k(tables_end)
    let pdpt_vaddr = pml4_vaddr + 4096
    let pd_vaddr = pdpt_vaddr + 4096
    let load_end = pd_vaddr + 4096
    let esp_val = load_end + 16384
    if esp_val > 1073741824:
        let f7 = nc_fail(503, 0, "multiboot32-long64: image exceeds the identity-mapped low 1 GiB")
        return 0
    end
    let cbuf = new_buffer()
    cbuf = nc32_long_emit_head(cbuf, gdtr_vaddr, pml4_vaddr, long_entry_vaddr)
    do append(cbuf, 188)
    cbuf = nc_append_le32(cbuf, esp_val)
    if nlocals > 0:
        do append(cbuf, 72)
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 72)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 8 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    do append(cbuf, 72)
    do append(cbuf, 193)
    do append(cbuf, 232)
    do append(cbuf, 32)
    cbuf = nc32_emit_epilogue(cbuf)
    cbuf = nc32_long_emit_gdt(cbuf, gdt_vaddr)
    let pre_pml4_len = length(freeze(cbuf))
    let pad_to_pml4 = pml4_vaddr - v0 - pre_pml4_len
    cbuf = nc_emit_zeroes_loop(cbuf, pad_to_pml4)
    cbuf = nc32_long_emit_pml4(cbuf, pdpt_vaddr)
    cbuf = nc32_long_emit_pdpt(cbuf, pd_vaddr)
    cbuf = nc32_long_emit_pd_loop(cbuf, 0)
    let frozen_code = freeze(cbuf)
    let code_len = length(frozen_code)
    if code_len != load_end - v0:
        let f6 = nc_fail(504, 0, "multiboot32-long64: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let memsz = filesz + 16384
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end
