-- ===== tandem (link 28): the cooperative TWO-PROGRAM module mode. Admits the same recursion/sys_read/sys_write
-- subset as module-mmj/mumbani PLUS the new yield() op (op 52), and REQUIRES >=1 yield (the cooperative-scheduler
-- rendezvous primitive). sys_read/sys_write are free (program A reads+echoes+yields each word; program B yields to
-- receive + writes the derived word). module_byte()/input_byte() banned (CPL3). Both compiled programs reuse
-- nc_ouro_emit_funcs wholesale. Byte-identical to tandem_ref.module_A_real()/module_B_real(). =====
func nc_tandem_count_yield_loop(code, i, n, cnt):
    if i >= n:
        return cnt
    end
    let c = cnt
    if get(code, i).0 == 52:
        c = cnt + 1
    end
    return nc_tandem_count_yield_loop(code, i + 1, n, c)
end

func nc_tandem_total_yield(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let code = get(funcs, i).4
    return nc_tandem_total_yield(funcs, i + 1, nf, acc + nc_tandem_count_yield_loop(code, 0, count(code), 0))
end

func nc_is_module_tandem(source):
    let marker = "-- emit: module-tandem"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

func nc_emit_module_tandem_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    let nf = count(funcs)
    if prog.2 != 0:
        let e0 = nc_fail(650, 0, "module-tandem: main not the entry (index 0)")
        return 0
    end
    let mainfn = get(funcs, 0)
    if not equal(mainfn.0, "main"):
        let e0b = nc_fail(650, 0, "module-tandem: entry function is not main")
        return 0
    end
    if mainfn.2 != 0:
        let e1 = nc_fail(651, 0, "module-tandem: main must take no parameters")
        return 0
    end
    if nc_tandem_total_yield(funcs, 0, nf, 0) < 1:
        let e2 = nc_fail(652, 0, "module-tandem: program must yield() at least once (the cooperative scheduler primitive)")
        return 0
    end
    if nc_ouro_total_module(funcs, 0, nf, 0) != 0:
        let e3 = nc_fail(653, 0, "module-tandem: module_byte() is kernel-only; a module reads via sys_read()")
        return 0
    end
    if nc_ouro_total_input(funcs, 0, nf, 0) != 0:
        let e4 = nc_fail(654, 0, "module-tandem: input_byte() faults at CPL3; a module reads via sys_read()")
        return 0
    end
    if not nc_ouro_all_funcs_ok(funcs, 0, nf):
        return 0
    end
    let bases = nc_ouro_bases_loop(funcs, 0, nf, 0, new_array(int))
    let mbuf = new_buffer()
    mbuf = nc_ouro_emit_funcs(mbuf, funcs, 0, nf, bases)
    do fwriter(freeze(mbuf))
    return 0
end

