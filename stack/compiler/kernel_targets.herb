func nc32_roundup_4k(v):
    let r = v % 4096
    if r == 0:
        return v
    end
    return v + 4096 - r
end

-- hoopteeter: the fixed 56-byte LONG-MODE TRANSITION head (emitter-laid-out structure, like
-- the ELF/MB headers -- honest structure, not compiled Herbert). In execution order (entered
-- AFTER the compiled body has stashed V in esi): cli; lgdt my own GDT (which has a 64-bit
-- L=1 code descriptor at 0x08); normalize CR4 = PAE only (Multiboot leaves CR4 UNDEFINED --
-- chosen's lesson, but here we SET PAE for 4-level paging); mov cr3 = PML4 physical; set
-- EFER.LME via wrmsr to MSR 0xC0000080 (RMW: rdmsr; or eax,0x100; wrmsr -- LME-only, NXE stays
-- clear); set CR0.PG (now in IA-32e COMPATIBILITY mode); ljmp 0x08:long_entry -- reload CS into
-- the 64-bit segment, entering true 64-bit mode. Two le32 fields vary (gdtr_vaddr, pml4_vaddr)
-- plus the ljmp target (long_entry_vaddr); everything else is a fixed byte sequence the
-- white-box gate pins exactly. CR4=0x20 and the ljmp selector 0x08 are load-bearing.
func nc32_long_emit_head(buf, gdtr_vaddr, pml4_vaddr, long_entry_vaddr):
    do append(buf, 250)
    do append(buf, 15)
    do append(buf, 1)
    do append(buf, 21)
    buf = nc_append_le32(buf, gdtr_vaddr)
    do append(buf, 184)
    do append(buf, 32)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 224)
    do append(buf, 184)
    buf = nc_append_le32(buf, pml4_vaddr)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 216)
    do append(buf, 185)
    do append(buf, 128)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 192)
    do append(buf, 15)
    do append(buf, 50)
    do append(buf, 13)
    do append(buf, 0)
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 15)
    do append(buf, 48)
    do append(buf, 15)
    do append(buf, 32)
    do append(buf, 192)
    do append(buf, 13)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 128)
    do append(buf, 15)
    do append(buf, 34)
    do append(buf, 192)
    do append(buf, 234)
    buf = nc_append_le32(buf, long_entry_vaddr)
    do append(buf, 8)
    do append(buf, 0)
    return buf
end

-- hoopteeter: the 30-byte GDT + GDTR. A 3-entry GDT: null, a 64-bit CODE descriptor
-- 0x00AF9A000000FFFF (P/DPL0/S/exec, G=1, and L=1 -- the long-mode bit, the single bit that
-- distinguishes true 64-bit from compatibility mode; the compat twin 0x00CF9A000000FFFF is
-- banned by the white-box gate), and a data descriptor 0x00AF92000000FFFF; then GDTR (limit
-- 0x17 = 3*8-1, base gdt_vaddr). Emitter-laid-out at a fixed vaddr.
func nc32_long_emit_gdt(buf, gdt_vaddr):
    buf = nc_emit_zeroes_loop(buf, 8)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 154)
    do append(buf, 175)
    do append(buf, 0)
    do append(buf, 255)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 146)
    do append(buf, 175)
    do append(buf, 0)
    do append(buf, 23)
    do append(buf, 0)
    buf = nc_append_le32(buf, gdt_vaddr)
    return buf
end

-- hoopteeter: the PML4 (4 KiB). Entry 0 -> the PDPT (present+RW), the rest not present. PAE
-- entries are 8 bytes; the next-table pointer is the low dword (the table is 4 KiB-aligned, so
-- +3 == |present|RW), the high dword is 0 (no NX -- EFER.NXE stays clear, so bit 63 must be 0).
func nc32_long_emit_pml4(buf, pdpt_vaddr):
    buf = nc_append_le32(buf, pdpt_vaddr + 3)
    buf = nc_append_le32(buf, 0)
    buf = nc_emit_zeroes_loop(buf, 4088)
    return buf
end

-- hoopteeter: the PDPT (4 KiB). Entry 0 -> the PD (present+RW), the rest not present.
func nc32_long_emit_pdpt(buf, pd_vaddr):
    buf = nc_append_le32(buf, pd_vaddr + 3)
    buf = nc_append_le32(buf, 0)
    buf = nc_emit_zeroes_loop(buf, 4088)
    return buf
end

-- hoopteeter: the PD (4 KiB, 512 entries) identity-mapping the WHOLE low 1 GiB as 512 2-MiB
-- PAE pages: pd[i] = (i * 0x200000) | present | RW | PS(0x80) == i*2097152 + 0x83. i*0x200000
-- (tonka's `*`, no bit-shift) is 2-MiB-aligned so the low [20:0] frame bits are zero (a 2-MiB
-- PS page requires this). Mapping the full low 1 GiB (table size is a fixed 4 KiB regardless of
-- N) removes any image/stack/table-coverage question from the threat model -- nothing the image
-- touches is ever outside the map, so no spurious #PF/triple-fault as the image grows.
func nc32_long_emit_pd_loop(buf, i):
    if i >= 512:
        return buf
    end
    buf = nc_append_le32(buf, i * 2097152 + 131)
    buf = nc_append_le32(buf, 0)
    return nc32_long_emit_pd_loop(buf, i + 1)
end

-- toggler (TENTH kernel-arc link): "-- emit: multiboot32-long64" selects the freestanding image
-- that crosses into 64-bit long mode and runs a GENUINELY 64-bit COMPILED body -- the x86-64
-- BACKEND REUNIFICATION. hoopteeter (multiboot32-long) computes V in a 32-bit body and a canned
-- 16-byte observable derives the proof byte; toggler instead lowers the body through the SAME
-- near-axis 64-bit leaf emitters the Linux-ELF64 path uses (nc_emit_push_int/add/sub/mul -- REX.W),
-- AFTER entering long mode, so the proof byte = high dword of the body's OWN 64-bit result (a
-- multiply whose product exceeds 2^32: wrong under 32-bit-width arithmetic). One 64-bit lowering
-- table, both targets. Minimal slice -- straight-line arithmetic {PUSH_INT, ADD, SUB, MUL, RET},
-- single main(), no params/locals/branches (64-bit locals/branches widen a later link). With no
-- branches there are no body rel32s, so no layout pass is needed (emit the body, then measure).
-- The "-long64" suffix means nc_is_multiboot32 / _idt / _page / _store / _demand / _timer / _tick /
-- _long do NOT match (each requires its own marker followed by a newline; here source[mlen]='6').
func nc_is_multiboot32_long64(source):
    let marker = "-- emit: multiboot32-long64"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- The widened 64-bit subset (trikea/f2): PUSH_INT (0), LOAD_LOCAL (3), STORE_LOCAL (4), ADD (5),
-- SUB (6), EQ (11), NE (12), BR (16), BR_IF_FALSE (17), MUL (42), RET (21). Mirrors the proven
-- 32-bit toakie control-flow+locals subset but at 64-bit width: locals are 8-byte rbp-frame slots
-- ([rbp - 8*(slot+1)]) and branches resolve through a 64-bit layout pass. Still rejects call (20),
-- bitwise (36/37), div/mod (43/44), and anything else -- those remain deferred.
func nc64_op_allowed(op):
    if op == 0:
        return true
    end
    if op == 3:
        return true
    end
    if op == 4:
        return true
    end
    if op == 5:
        return true
    end
    if op == 6:
        return true
    end
    if op == 11:
        return true
    end
    if op == 12:
        return true
    end
    if op == 16:
        return true
    end
    if op == 17:
        return true
    end
    if op == 42:
        return true
    end
    if op == 21:
        return true
    end
    return false
end

-- Stack effect of each admitted 64-bit op (pops then pushes). REUSES the width-agnostic nc32_pops/
-- nc32_pushes (stack semantics are width-independent), but adds NE (op 12), which nc32 never admitted
-- and so leaves at 0/0: NE has the SAME stack effect as EQ (op 11) -- pop 2 operands, push 1 result.
-- Without this, an NE in a 64-bit body would be tracked as a no-op in the depth walk and mis-verify.
func nc64_pops(op):
    if op == 12:
        return 2
    end
    return nc32_pops(op)
end

func nc64_pushes(op):
    if op == 12:
        return 1
    end
    return nc32_pushes(op)
end

-- Two-pass CFG verifier mirroring nc32 (PASS A: forward depth walk; PASS B: nc32_check_branches for
-- forward-only + merge-point depth agreement). A COPY of nc32_build_depths with the depth cap at 1500
-- (NOT 3000) -- 64-bit pushes are 8 bytes (1500*8 = 12 KiB < the 16 KiB stack reserve above load_end),
-- and using nc64_pops/nc64_pushes so NE (op 12) is accounted. Records the depth BEFORE each instr;
-- rejects any unknown opcode, any underflow, any RET not at depth exactly 1. Returns (ok, depths).
func nc64_build_depths(code, i, n, cur, depths):
    if i >= n:
        return (1, depths)
    end
    let op = get(code, i).0
    if not nc64_op_allowed(op):
        return (0, depths)
    end
    if cur > 1500:
        return (0, depths)
    end
    let pops = nc64_pops(op)
    if cur < pops:
        return (0, depths)
    end
    do add(depths, cur)
    if op == 21:
        if cur != 1:
            return (0, depths)
        end
    end
    return nc64_build_depths(code, i + 1, n, cur - pops + nc64_pushes(op), depths)
end

-- The full 64-bit subset gate (mirrors nc32_body_ok): ends in RET, all opcodes admitted +
-- stack-balanced (PASS A), all branches forward + depth-agreeing (PASS B, reusing the width-agnostic
-- nc32_check_branches). Defense-in-depth: the far-axis oracle has no C reference, so the gate proves
-- the body's well-formedness itself before the 64-bit layout pass resolves branch rel32s.
func nc64_body_ok(code, n):
    if n == 0:
        return false
    end
    if get(code, n - 1).0 != 21:
        return false
    end
    let bd = nc64_build_depths(code, 0, n, 0, new_array(int))
    if bd.0 == 0:
        return false
    end
    return nc32_check_branches(code, 0, n, bd.1)
end

-- Byte size each op lowers to (matching the EXACT 64-bit lowering in nc64_lower_loop): PUSH_INT 11
-- (48 B8 imm64; push), LOAD_LOCAL 5 (48 8B 45 disp8; push), STORE_LOCAL 5 (pop; 48 89 45 disp8),
-- ADD/SUB 6 (REX.W), EQ/NE 13 (pop;pop; REX.W cmp; setcc; movzx; push), BR 5 (e9 rel32),
-- BR_IF_FALSE 10 (pop; test; je rel32), MUL 7 (REX.W imul), RET 1 if last (pop rax; fall through to
-- the grading tail) else 6 (pop rax; jmp epilogue). Drives the two-pass layout that resolves branch
-- rel32s AND the driver's body-length invariant (a mis-sized/dropped op is caught, never silently
-- mis-emitted -- the no-silent-drop guard the other freestanding drivers carry).
func nc64_op_size(op, is_last):
    if op == 0:
        return 11
    end
    if op == 3:
        return 5
    end
    if op == 4:
        return 5
    end
    if op == 5:
        return 6
    end
    if op == 6:
        return 6
    end
    if op == 11:
        return 13
    end
    if op == 12:
        return 13
    end
    if op == 16:
        return 5
    end
    if op == 17:
        return 10
    end
    if op == 42:
        return 7
    end
    if op == 21:
        if is_last == 1:
            return 1
        end
        return 6
    end
    return 0
end

-- PASS 1 layout (mirrors nc32_layout_loop at 64-bit width): byte offset of each instr from code start
-- (offsets INCLUDE the prefix, so a branch rel cancels the prefix). Returns (offs, epilogue_off); a
-- branch target == n resolves to epilogue_off.
func nc64_layout_loop(code, i, n, cur, offs):
    if i >= n:
        return (offs, cur)
    end
    do add(offs, cur)
    let il = 0
    if i == n - 1:
        il = 1
    end
    return nc64_layout_loop(code, i + 1, n, cur + nc64_op_size(get(code, i).0, il), offs)
end

-- Frame-local displacement as a disp8 byte: [rbp - 8*(slot+1)]. nlocals is capped at 15 upstream
-- (max slot 14), so 8*(slot+1) <= 120 fits a signed byte. The cap is 15 not 16 because the frame
-- prologue is `sub rsp, imm8` (48 83 EC ib), which SIGN-EXTENDS: frame = 8*16 = 128 would encode as
-- 0x80 = -128 and ADD to rsp. So 15 locals (frame 120, 0x78) is the true boundary, not the disp8 limit.
func nc64_emit_local_disp(buf, slot):
    do append(buf, 256 - 8 * (slot + 1))
    return buf
end

-- PASS 2 lowering (mirrors nc32_lower_loop at 64-bit width): emit each instr's bytes, resolving
-- BR/BR_IF_FALSE/mid-RET rel32 from the layout. REUSES the near-axis 64-bit leaf emitters for
-- PUSH_INT/ADD/SUB/MUL (the reunification -- each carries REX.W 0x48); locals use 8-byte rbp-frame
-- slots ([rbp - 8*(slot+1)]); EQ/NE lower to REX.W cmp + setcc + movzx; branches use the same forward
-- rel32 machinery as nc32 (gated forward-only, so every rel32 is non-negative). Terminal RET lowers to
-- a single `pop rax` (0x58, the driver appends the grading tail); a mid-body RET lowers to pop rax;
-- jmp epilogue.
func nc64_lower_loop(buf, code, i, n, offs, epi):
    if i >= n:
        return buf
    end
    let op = get(code, i).0
    let il = 0
    if i == n - 1:
        il = 1
    end
    let endoff = get(offs, i) + nc64_op_size(op, il)
    if op == 0:
        buf = nc_emit_push_int(buf, get(code, i).1)
    elif op == 3:
        do append(buf, 72)
        do append(buf, 139)
        do append(buf, 69)
        buf = nc64_emit_local_disp(buf, get(code, i).1)
        do append(buf, 80)
    elif op == 4:
        do append(buf, 88)
        do append(buf, 72)
        do append(buf, 137)
        do append(buf, 69)
        buf = nc64_emit_local_disp(buf, get(code, i).1)
    elif op == 5:
        buf = nc_emit_add(buf)
    elif op == 6:
        buf = nc_emit_sub(buf)
    elif op == 11:
        do append(buf, 89)
        do append(buf, 88)
        do append(buf, 72)
        do append(buf, 57)
        do append(buf, 200)
        do append(buf, 15)
        do append(buf, 148)
        do append(buf, 194)
        do append(buf, 72)
        do append(buf, 15)
        do append(buf, 182)
        do append(buf, 194)
        do append(buf, 80)
    elif op == 12:
        do append(buf, 89)
        do append(buf, 88)
        do append(buf, 72)
        do append(buf, 57)
        do append(buf, 200)
        do append(buf, 15)
        do append(buf, 149)
        do append(buf, 194)
        do append(buf, 72)
        do append(buf, 15)
        do append(buf, 182)
        do append(buf, 194)
        do append(buf, 80)
    elif op == 16:
        do append(buf, 233)
        let t = get(code, i).1
        let toff = epi
        if t < n:
            toff = get(offs, t)
        end
        buf = nc_append_le32(buf, toff - endoff)
    elif op == 17:
        do append(buf, 88)
        do append(buf, 72)
        do append(buf, 133)
        do append(buf, 192)
        do append(buf, 15)
        do append(buf, 132)
        let t2 = get(code, i).1
        let toff2 = epi
        if t2 < n:
            toff2 = get(offs, t2)
        end
        buf = nc_append_le32(buf, toff2 - endoff)
    elif op == 42:
        buf = nc_emit_mul(buf)
    elif op == 21:
        if il == 1:
            do append(buf, 88)
        else:
            do append(buf, 88)
            do append(buf, 233)
            buf = nc_append_le32(buf, epi - endoff)
        end
    end
    return nc64_lower_loop(buf, code, i + 1, n, offs, epi)
end

-- trikea/f2 driver (widened toggler). Layout (vaddr V0=0x10000c): [56-byte transition head -> ljmp
-- 0x08:long_entry] [@long_entry (64-bit): mov esp,esp_val (BC imm32 -- zero-extends rsp; the one extra
-- instruction long mode needs because the 32-bit handoff leaves rsp[63:32] undefined)] [optional rbp
-- frame: mov rbp,rsp (48 89 E5) + sub rsp,8*nlocals (48 83 EC imm8) -- present iff the body uses
-- locals] [the compiled body lowered via nc64_lower_loop -- if/else + rbp-frame locals + 64-bit
-- arithmetic; mid-body RET jmps to the grading tail, terminal RET (pop rax) falls through] [shr
-- rax,0x20 -- the grading tail: high dword of the body's 64-bit result into al] [shared 58-byte
-- epilogue: frame 0xDE<byte>0xAD on 0xE9 + result-dependent isa-debug-exit] [GDT/GDTR 30] [pad to
-- 4 KiB] [PML4][PDPT][PD]. The prefix is 5 bytes (mov esp) with no locals, 12 (mov esp + mov rbp,rsp +
-- sub rsp,imm8) with locals; branch rel32s resolve through nc64_layout_loop (the prefix is the layout
-- origin, so rel32s cancel it). Reuses hoopteeter's transition head/GDT/PAE tables and lingo's ehdr/
-- phdr/mbheader + the shared epilogue verbatim, so the nine prior modes are byte-identical and the
-- self-host fixpoint is preserved. For a straight-line no-locals body, prefix_len=5 and the layout/lower
-- produce IDENTICAL bytes to the pre-widen path -> byte-identical image (the f2 byte-identity guarantee).
-- ============================================================================
-- taproot (native-codegen link 62 / kernel-arc link 46): USER CALLS + RECURSION on
-- the sovereign x86-64 freestanding target. Widens multiboot32-long64 from a single
-- main() to a MULTI-FUNCTION program with recursion -- ouroboros's proven 32-bit call
-- ABI (push args; push rbp/mov rbp,rsp/sub rsp; param-copy; add rsp cleanup; push rax
-- result; backward E8 rel32) widened to 8-byte slots + REX.W. Herbert has no loops and
-- this target has no TCO, so recursion-via-call is the only iteration -- without it no
-- freestanding program of substance exists.
--
-- Dispatch: the long64 driver routes count(funcs)==1 to the UNTOUCHED single-function
-- path (byte-identical: link26/29 goldens are all single-main), count(funcs)>1 here.
-- main is funcs[0] (the graded entry; special prefix = the mode-setup mov esp + optional
-- rbp frame, then grading tail + shared epilogue; NEVER a call target). Callees (funcs[1..])
-- are standard 64-bit functions placed after main's epilogue, entered only by E8 rel32.
-- Calling main (index 0) is BANNED (it would re-run the mode setup and exit, never returning).
--
-- SAFETY (guard page -- the load-bearing invariant): the stack is relocated to its OWN
-- 2-MiB identity page, with the 2-MiB page BELOW it marked NON-PRESENT in the PD, so a
-- recursion that overflows the stack takes a #PF -> triple-fault (a deterministic,
-- observable divergence) instead of SILENTLY CORRUPTING the page tables (which sit just
-- above the image). The single-function path keeps the whole-low-1-GiB identity map.
-- ============================================================================

func nc_tap_op_allowed(op):
    if op == 57:
        return true
    end
    if op == 20:
        return true
    end
    if op == 45:
        return true
    end
    if op == 53:
        return true
    end
    if op == 49:
        return true
    end
    if op == 50:
        return true
    end
    if op == 51:
        return true
    end
    return nc64_op_allowed(op)
end

func nc_tap_pops(op, nargs):
    if op == 57:
        return 0
    end
    if op == 20:
        return nargs
    end
    if op == 45:
        return 0
    end
    if op == 53:
        return 1
    end
    if op == 49:
        return 0
    end
    if op == 50:
        return 2
    end
    if op == 51:
        return 3
    end
    return nc64_pops(op)
end

func nc_tap_pushes(op):
    if op == 57:
        return 1
    end
    if op == 20:
        return 1
    end
    if op == 45:
        return 1
    end
    if op == 53:
        return 1
    end
    if op == 49:
        return 1
    end
    if op == 50:
        return 1
    end
    if op == 51:
        return 1
    end
    return nc64_pushes(op)
end

-- PASS A depth walk (op-20-aware; mirrors nc64_build_depths). Cap 1500 (each push is
-- 8 bytes); the guard page is the runtime backstop for deeper recursion.
func nc_tap_build_depths(code, i, n, cur, depths):
    if i >= n:
        return (1, depths)
    end
    let op = get(code, i).0
    if not nc_tap_op_allowed(op):
        return (0, depths)
    end
    if cur > 1500:
        return (0, depths)
    end
    let pops = nc_tap_pops(op, get(code, i).2)
    if cur < pops:
        return (0, depths)
    end
    do add(depths, cur)
    if op == 21:
        if cur != 1:
            return (0, depths)
        end
    end
    return nc_tap_build_depths(code, i + 1, n, cur - pops + nc_tap_pushes(op), depths)
end

func nc_tap_body_ok(code, n):
    if n == 0:
        return false
    end
    if get(code, n - 1).0 != 21:
        return false
    end
    let bd = nc_tap_build_depths(code, 0, n, 0, new_array(int))
    if bd.0 == 0:
        return false
    end
    return nc32_check_branches(code, 0, n, bd.1)
end

-- op-20 size at 64-bit width: E8 rel32 (5) + caller cleanup (0 / add rsp,imm8 = 4 /
-- add rsp,imm32 = 7) + push rax (1). Every other op reuses nc64_op_size.
func nc_tap_op_size(op, nargs, is_last):
    if op == 57:
        return 19
    end
    if op == 20:
        let cl = 0
        if nargs > 0:
            if 8 * nargs <= 127:
                cl = 4
            else:
                cl = 7
            end
        end
        return 5 + cl + 1
    end
    if op == 45:
        return 18
    end
    if op == 53:
        return 18
    end
    if op == 49:
        return 11
    end
    if op == 50:
        return 7
    end
    if op == 51:
        return 8
    end
    return nc64_op_size(op, is_last)
end

func nc_tap_frame_size(fn):
    let code = fn.4
    let n = count(code)
    let s = nc32_nlocals_loop(code, 0, n, 0)
    if fn.2 > s:
        s = fn.2
    end
    return s
end

-- gyre (link65): tail-call eligibility on the long64 tap target -- the Linux-parity
-- rule (nc_is_tail_call precedent + EQUAL ARGUMENT WORDS + non-main caller). Every tap
-- slot is one word, so equal argument words == equal arity; every tap function returns
-- exactly one word (op-21 depth-1 invariant), so the Linux rw==my_rw leg is structural.
-- main is EXCLUDED: its prologue has no push rbp and no return address ([rbp]/[rbp+8]
-- would be garbage above the relocated stack top), and its op-21 falls into the grading
-- tail -- a tail transition from main would be flatly wrong, so its calls stay E8.
func nc_tap_is_tco(code, i, n, funcs, is_main, nparams):
    if is_main == 1:
        return false
    end
    if not nc_is_tail_call(code, i, n):
        return false
    end
    if get(funcs, get(code, i).1).2 == nparams:
        return true
    end
    return false
end

-- gyre: tail-transition byte length. Frame-zero caller (nparams==0, no locals -- the
-- operand stack holds exactly nargs==0 words at a tail site, so rsp ALREADY points AT
-- the return address and rbp is already the parent's): bare `E9 rel32` = 5. Frameful
-- caller: preamble (4+4) + 9 per copied arg (48 8B 44 24 ib = 5; 48 89 45 ib = 4) +
-- store r11 (4) + lea rsp (4) + mov rbp,r10 (3) + E9 rel32 (5) = 24 + 9*nargs. The
-- 14-param cap keeps every displacement disp8 (src max 8*13=104, dst max 8+8*14=120).
func nc_tap_tail_len(nargs, frame):
    if frame == 0:
        return 5
    end
    return 24 + 9 * nargs
end

-- gyre: per-site op size -- the tail-aware wrapper the tap grouping/sizing walkers
-- (nc_tap_body_size, nc_tap_offsets_loop, nc_tap_lower_body) use, so a TAIL op-20 is
-- sized as its transition and every other op keeps nc_tap_op_size. Sizing and lowering
-- consult the SAME nc_tap_is_tco predicate, so the ERR 610/611 block-length invariants
-- keep their teeth over tail sites.
func nc_tap_op_size_at(code, i, n, funcs, is_main, nparams, frame):
    if nc_tap_is_tco(code, i, n, funcs, is_main, nparams):
        return nc_tap_tail_len(get(code, i).2, frame)
    end
    let il = 0
    if i == n - 1:
        il = 1
    end
    return nc_tap_op_size(get(code, i).0, get(code, i).2, il)
end

-- gyre: copy the k-th of nf argument words from the OPERAND STACK into the caller's
-- incoming argument slots. The operand stack is the parallel-move staging area (the
-- Linux nc_emit_tail_copy_loop discipline): every new argument was fully evaluated and
-- pushed BEFORE any destination slot is written, so a swap `return f(b, a)` reads both
-- sources from staged copies, never from a clobbered slot. At a tail site the operand
-- stack holds EXACTLY the nf argument words (op-21 depth-1 invariant), arg k deepest:
-- src = [rsp + 8*(nf-1-k)]; dst = [rbp + 8 + 8*(nf-k)] -- arg k's own incoming slot
-- under the equal-arity rule (the Linux ng==nf specialization), disjoint from every
-- src because the operand stack sits below the frame while the slots sit above rbp.
func nc_tap_emit_tail_copy(obuf, k, nf):
    if k >= nf:
        return obuf
    end
    do append(obuf, 72)    -- 48 8B 44 24 ib mov rax,[rsp + 8*(nf-1-k)]
    do append(obuf, 139)
    do append(obuf, 68)
    do append(obuf, 36)
    do append(obuf, 8 * (nf - 1 - k))
    do append(obuf, 72)    -- 48 89 45 ib    mov [rbp + 8 + 8*(nf-k)],rax
    do append(obuf, 137)
    do append(obuf, 69)
    do append(obuf, 8 + 8 * (nf - k))
    return nc_tap_emit_tail_copy(obuf, k + 1, nf)
end

-- gyre: the TAIL transition -- the long64 port of the proven Linux nc_emit_tail_call,
-- same structure, tap ABI. Frameful caller:
--   4C 8B 5D 08  mov r11,[rbp+8]   save the return address BEFORE any slot is touched
--   4C 8B 55 00  mov r10,[rbp]     save the parent rbp
--   <copy loop>                    stage-copy nf args operand-stack -> incoming slots
--   4C 89 5D 08  mov [rbp+8],r11   rewrite the return-address slot (equal arity makes
--                                  this slot the SAME [rbp+8] -- kept for byte-level
--                                  parity with the Linux sequence's rslot store)
--   48 8D 65 08  lea rsp,[rbp+8]   the STACK RECLAMATION: locals + operand stack are
--                                  released in one move; rsp now points AT the return
--                                  address -- exactly a fresh E8 entry's stack shape
--   4C 89 D5     mov rbp,r10       restore the parent rbp
--   E9 rel32     jmp callee ENTRY  the callee's own prologue re-frames at the SAME
--                                  address -> constant stack at any depth
-- Frame-zero caller (nparams==0): rsp already points AT the return address and rbp is
-- already the parent's, so the transition is the bare E9. Either way the callee entry
-- state is byte-for-byte what an E8 call would have produced (minus the pushed frame).
func nc_tap_emit_tail_call(obuf, nargs, frame, cbase, tail_end):
    if frame == 0:
        do append(obuf, 233)   -- E9 rel32 jmp callee entry
        return nc_append_rel32(obuf, cbase, tail_end)
    end
    do append(obuf, 76)    -- 4C 8B 5D 08 mov r11,[rbp+8]
    do append(obuf, 139)
    do append(obuf, 93)
    do append(obuf, 8)
    do append(obuf, 76)    -- 4C 8B 55 00 mov r10,[rbp]
    do append(obuf, 139)
    do append(obuf, 85)
    do append(obuf, 0)
    obuf = nc_tap_emit_tail_copy(obuf, 0, nargs)
    do append(obuf, 76)    -- 4C 89 5D 08 mov [rbp+8],r11
    do append(obuf, 137)
    do append(obuf, 93)
    do append(obuf, 8)
    do append(obuf, 72)    -- 48 8D 65 08 lea rsp,[rbp+8] (reclaim locals + operands)
    do append(obuf, 141)
    do append(obuf, 101)
    do append(obuf, 8)
    do append(obuf, 76)    -- 4C 89 D5    mov rbp,r10
    do append(obuf, 137)
    do append(obuf, 213)
    do append(obuf, 233)   -- E9 rel32    jmp callee entry
    return nc_append_rel32(obuf, cbase, tail_end)
end

-- prologue bytes. main (frame>0): mov rbp,rsp (3) + sub rsp,8S (4) = 7. callee (frame>0):
-- push rbp (1) + mov rbp,rsp (3) + sub rsp,8S (4) + nparams*8 param-copies. frame==0: none.
func nc_tap_prologue_len(is_main, nparams, frame):
    if frame == 0:
        return 0
    end
    if is_main == 1:
        return 7
    end
    return 8 + nparams * 8
end

func nc_tap_epilogue_len(is_main, frame):
    if is_main == 1:
        return 0
    end
    if frame > 0:
        return 5
    end
    return 1
end

-- gyre: body sizing is TAIL-AWARE via nc_tap_op_size_at (a tail op-20 is sized as its
-- transition), so it threads (funcs, is_main, nparams, frame) -- the same context the
-- lowering consults, keeping sizes and bytes in lockstep for the ERR 610/611 checks.
func nc_tap_body_size(code, i, n, acc, funcs, is_main, nparams, frame):
    if i >= n:
        return acc
    end
    return nc_tap_body_size(code, i + 1, n, acc + nc_tap_op_size_at(code, i, n, funcs, is_main, nparams, frame), funcs, is_main, nparams, frame)
end

func nc_tap_func_total(fn, funcs, is_main, frame):
    let code = fn.4
    let n = count(code)
    return nc_tap_prologue_len(is_main, fn.2, frame) + nc_tap_body_size(code, 0, n, 0, funcs, is_main, fn.2, frame) + nc_tap_epilogue_len(is_main, frame)
end

func nc_tap_callees_total(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let fn = get(funcs, i)
    let frame = nc_tap_frame_size(fn)
    return nc_tap_callees_total(funcs, i + 1, nf, acc + nc_tap_func_total(fn, funcs, 0, frame))
end

-- absolute instruction offsets within one function (cur starts at the function's body
-- base = its image base + its prologue length). gyre: tail-aware via nc_tap_op_size_at.
func nc_tap_offsets_loop(code, i, n, cur, offs, funcs, is_main, nparams, frame):
    if i >= n:
        return (offs, cur)
    end
    do add(offs, cur)
    return nc_tap_offsets_loop(code, i + 1, n, cur + nc_tap_op_size_at(code, i, n, funcs, is_main, nparams, frame), offs, funcs, is_main, nparams, frame)
end

-- mov rax,[rbp + 16 + 8*(nparams-1-i)] (48 8B 45 disp8); mov [rbp - 8*(i+1)],rax
-- (48 89 45 disp8). Source disp bound: nparams<=14 -> 16+8*13=120<=127.
func nc_tap_emit_param_copies(obuf, i, nparams):
    if i >= nparams:
        return obuf
    end
    do append(obuf, 72)
    do append(obuf, 139)
    do append(obuf, 69)
    do append(obuf, 16 + 8 * (nparams - 1 - i))
    do append(obuf, 72)
    do append(obuf, 137)
    do append(obuf, 69)
    do append(obuf, 256 - 8 * (i + 1))
    return nc_tap_emit_param_copies(obuf, i + 1, nparams)
end

func nc_tap_emit_prologue(obuf, is_main, nparams, frame):
    if is_main == 1:
        do append(obuf, 72)    -- 48 89 E5 mov rbp,rsp
        do append(obuf, 137)
        do append(obuf, 229)
        do append(obuf, 72)    -- 48 83 EC ib sub rsp,8S
        do append(obuf, 131)
        do append(obuf, 236)
        do append(obuf, 8 * frame)
        return obuf
    end
    do append(obuf, 85)        -- 55 push rbp
    do append(obuf, 72)        -- 48 89 E5 mov rbp,rsp
    do append(obuf, 137)
    do append(obuf, 229)
    do append(obuf, 72)        -- 48 83 EC ib sub rsp,8S
    do append(obuf, 131)
    do append(obuf, 236)
    do append(obuf, 8 * frame)
    return nc_tap_emit_param_copies(obuf, 0, nparams)
end

func nc_tap_emit_epilogue(obuf, is_main, frame):
    if is_main == 1:
        return obuf
    end
    if frame > 0:
        do append(obuf, 72)    -- 48 89 EC mov rsp,rbp
        do append(obuf, 137)
        do append(obuf, 236)
        do append(obuf, 93)    -- 5D pop rbp
        do append(obuf, 195)   -- C3 ret
        return obuf
    end
    do append(obuf, 195)       -- C3 ret
    return obuf
end

-- lower one function body at 64-bit width with ABSOLUTE image offsets. Identical to
-- nc64_lower_loop for ops {0,3,4,5,6,11,12,16,17,42,21}; adds op 20 (call): E8 rel32 to
-- the callee's image base (bases[callee]) -- FORWARD or BACKWARD (recursion) via the
-- signed nc_append_rel32 -- + add rsp,8*nargs cleanup + push rax. gyre: an op-20 that
-- nc_tap_is_tco accepts (non-main, nc_is_tail_call, equal argument words) is lowered as
-- the constant-stack TAIL transition (nc_tap_emit_tail_call, E9 -- never E8) instead;
-- the op-21 after a tail site is still emitted (dead but shape-preserving, the Linux
-- lowering's discipline). NON-tail calls keep the E8 + cleanup + push rax form.
func nc_tap_lower_body(obuf, code, i, n, offs, epi, bases, funcs, is_main, nparams, frame, buf_2m):
    if i >= n:
        return obuf
    end
    let op = get(code, i).0
    let il = 0
    if i == n - 1:
        il = 1
    end
    let endoff = get(offs, i) + nc_tap_op_size_at(code, i, n, funcs, is_main, nparams, frame)
    if op == 0:
        obuf = nc_emit_push_int(obuf, get(code, i).1)
    elif op == 3:
        do append(obuf, 72)
        do append(obuf, 139)
        do append(obuf, 69)
        obuf = nc64_emit_local_disp(obuf, get(code, i).1)
        do append(obuf, 80)
    elif op == 4:
        do append(obuf, 88)
        do append(obuf, 72)
        do append(obuf, 137)
        do append(obuf, 69)
        obuf = nc64_emit_local_disp(obuf, get(code, i).1)
    elif op == 5:
        obuf = nc_emit_add(obuf)
    elif op == 6:
        obuf = nc_emit_sub(obuf)
    elif op == 11:
        do append(obuf, 89)
        do append(obuf, 88)
        do append(obuf, 72)
        do append(obuf, 57)
        do append(obuf, 200)
        do append(obuf, 15)
        do append(obuf, 148)
        do append(obuf, 194)
        do append(obuf, 72)
        do append(obuf, 15)
        do append(obuf, 182)
        do append(obuf, 194)
        do append(obuf, 80)
    elif op == 12:
        do append(obuf, 89)
        do append(obuf, 88)
        do append(obuf, 72)
        do append(obuf, 57)
        do append(obuf, 200)
        do append(obuf, 15)
        do append(obuf, 149)
        do append(obuf, 194)
        do append(obuf, 72)
        do append(obuf, 15)
        do append(obuf, 182)
        do append(obuf, 194)
        do append(obuf, 80)
    elif op == 16:
        do append(obuf, 233)
        let t = get(code, i).1
        let toff = epi
        if t < n:
            toff = get(offs, t)
        end
        obuf = nc_append_le32(obuf, toff - endoff)
    elif op == 17:
        do append(obuf, 88)
        do append(obuf, 72)
        do append(obuf, 133)
        do append(obuf, 192)
        do append(obuf, 15)
        do append(obuf, 132)
        let t2 = get(code, i).1
        let toff2 = epi
        if t2 < n:
            toff2 = get(offs, t2)
        end
        obuf = nc_append_le32(obuf, toff2 - endoff)
    elif op == 42:
        obuf = nc_emit_mul(obuf)
    elif op == 57:
        -- folio: R12/R13 are reserved cursor/end across all admitted ops and
        -- ordinary/tail calls. Compare BEFORE loading; EOF leaves both alone.
        do append(obuf, 184)  -- B8 00010000 mov eax,256
        obuf = nc_append_le32(obuf, 256)
        do append(obuf, 77)   -- 4D 39 EC cmp r12,r13
        do append(obuf, 57)
        do append(obuf, 236)
        do append(obuf, 115)  -- 73 08 jae done (unsigned)
        do append(obuf, 8)
        do append(obuf, 65)   -- 41 0F B6 04 24 movzx eax,byte [r12]
        do append(obuf, 15)
        do append(obuf, 182)
        do append(obuf, 4)
        do append(obuf, 36)
        do append(obuf, 73)   -- 49 FF C4 inc r12
        do append(obuf, 255)
        do append(obuf, 196)
        do append(obuf, 80)   -- done: push rax
    elif op == 45:
        -- hearken op_input_byte on the long64 target: poll COM1 LSR (0x3FD) for Data-Ready,
        -- then read the RBR (0x3F8) and push the byte zero-extended. 18 bytes, byte-identical
        -- to the proven i386 op-45 lowering -- port I/O + movzx + push are opcode-identical in
        -- long mode, and push (0x50) pushes 8 bytes (the long64 slot). Self-contained (the jz
        -- back-edge is an internal rel8), fully position-independent -> no layout dependence.
        do append(obuf, 102)   -- 66
        do append(obuf, 186)   -- BA  mov dx, 0x03FD (LSR)
        do append(obuf, 253)   -- FD
        do append(obuf, 3)     -- 03
        do append(obuf, 236)   -- EC  in al, dx
        do append(obuf, 168)   -- A8  test al,
        do append(obuf, 1)     -- 01     1 (Data-Ready)
        do append(obuf, 116)   -- 74  jz
        do append(obuf, 247)   -- F7     rel8 -9 -> back to the mov dx,0x3FD
        do append(obuf, 102)   -- 66
        do append(obuf, 186)   -- BA  mov dx, 0x03F8 (RBR)
        do append(obuf, 248)   -- F8
        do append(obuf, 3)     -- 03
        do append(obuf, 236)   -- EC  in al, dx  (the live byte)
        do append(obuf, 15)    -- 0F
        do append(obuf, 182)   -- B6  movzx eax, al
        do append(obuf, 192)   -- C0
        do append(obuf, 80)    -- 50  push rax (8-byte slot; upper 32 bits zeroed by movzx eax)
    elif op == 53:
        -- riposte op_output_byte on the long64 target: WRITE-THEN-DRAIN. Pop the argument,
        -- write its low byte to the COM1 THR (0x3F8), then poll LSR (0x3FD) bit 6 (TEMT --
        -- transmitter fully EMPTY, holding+shift both drained) before returning, so every
        -- op-53 leaves the byte ON THE WIRE and the THR free (the invariant that makes the
        -- unconditional write safe). STEP-0 proved the weaker THRE-before-write discipline
        -- LOSES bytes on Bochs's baud-paced TX model (back-to-back drops + a last-byte loss
        -- to shutdown); TEMT-after-write is also the real-16550-correct drain for the pinned
        -- physical target. Pushes the FULL argument back (rbx untouched by the poll), so the
        -- return value is v, not the al-truncated device byte. 18 self-contained bytes
        -- (internal rel8 back-edge only), position-independent -> no layout dependence.
        do append(obuf, 91)    -- 5B  pop rbx (the argument; bl = the wire byte)
        do append(obuf, 102)   -- 66
        do append(obuf, 186)   -- BA  mov dx, 0x03F8 (THR)
        do append(obuf, 248)   -- F8
        do append(obuf, 3)     -- 03
        do append(obuf, 136)   -- 88
        do append(obuf, 216)   -- D8  mov al, bl
        do append(obuf, 238)   -- EE  out dx, al  (the byte leaves the program)
        do append(obuf, 102)   -- 66
        do append(obuf, 186)   -- BA  mov dx, 0x03FD (LSR)
        do append(obuf, 253)   -- FD
        do append(obuf, 3)     -- 03
        do append(obuf, 236)   -- EC  in al, dx
        do append(obuf, 168)   -- A8  test al,
        do append(obuf, 64)    -- 40     0x40 (TEMT)
        do append(obuf, 116)   -- 74  jz
        do append(obuf, 247)   -- F7     rel8 -9 -> back to the mov dx,0x3FD
        do append(obuf, 83)    -- 53  push rbx (the full argument -- the op's value)
    elif op == 49:
        -- link66 op 49 bufbase(): push the 2-MiB-aligned base of the runtime-indexed buffer page as
        -- an ABSOLUTE immediate. buf_2m is a LAYOUT fact derived below from the phdr's own load_end,
        -- not a stack address -- long mode is flat and the buffer page is identity-mapped by the PD,
        -- so no segment override and no frame dependence (contrast the i386 op 49, which pushes
        -- [ebp+0] because its buffer lives in the module stack segment). movabs is the only 64-bit
        -- immediate form; 11 bytes. This immediate is what the gate's bufbase-eq leg decodes and
        -- compares against the phdr-derived base, and what M-basebias perturbs by +8.
        do append(obuf, 72)    -- 48
        do append(obuf, 184)   -- B8  movabs rax, imm64
        obuf = nc_append_le64(obuf, buf_2m)
        do append(obuf, 80)    -- 50  push rax
    elif op == 50:
        -- link66 op 50 bufget(base, k): TOS = k, next = base. The long64 analogue of the i386
        -- chiefturbo lowering (:15274-15283), with the SS override dropped (flat long mode) and the
        -- scale widened 4 -> 8 because a slot is a 64-bit word. 7 bytes, position-independent.
        do append(obuf, 89)    -- 59  pop rcx  (k)
        do append(obuf, 90)    -- 5A  pop rdx  (base)
        do append(obuf, 72)    -- 48
        do append(obuf, 139)   -- 8B
        do append(obuf, 4)     -- 04
        do append(obuf, 202)   -- CA  mov rax,[rdx+rcx*8]   (SIB scale bits 11 = x8)
        do append(obuf, 80)    -- 50  push rax
    elif op == 51:
        -- link66 op 51 bufset(base, i, v): TOS = v, next = i, next = base. Mirrors the i386 op-51
        -- register convention exactly (:15286-15294) -- pop v, pop i, pop base -- widened to 64-bit
        -- slots with the SS override dropped. Pushes v BACK (52 push rdx), so bufset's value is the
        -- word that was stored and the fill echo grades the store's own argument; removing that push
        -- is M-op51noret, which is size-preserving because 52 and 90 are both one byte. 8 bytes.
        do append(obuf, 90)    -- 5A  pop rdx  (v)
        do append(obuf, 89)    -- 59  pop rcx  (i)
        do append(obuf, 88)    -- 58  pop rax  (base)
        do append(obuf, 72)    -- 48
        do append(obuf, 137)   -- 89
        do append(obuf, 20)    -- 14
        do append(obuf, 200)   -- C8  mov [rax+rcx*8],rdx   (SIB scale bits 11 = x8)
        do append(obuf, 82)    -- 52  push rdx
    elif op == 20:
        let callee = get(code, i).1
        let nargs = get(code, i).2
        let cbase = get(bases, callee)
        if nc_tap_is_tco(code, i, n, funcs, is_main, nparams):
            -- gyre TAIL site: the constant-stack transition; endoff is the byte after
            -- the E9's rel32 (the transition is the whole per-site emission).
            obuf = nc_tap_emit_tail_call(obuf, nargs, frame, cbase, endoff)
        else:
            let call_end = get(offs, i) + 5
            do append(obuf, 232)   -- E8 call rel32
            obuf = nc_append_rel32(obuf, cbase, call_end)
            if nargs > 0:
                if 8 * nargs <= 127:
                    do append(obuf, 72)    -- 48 83 C4 ib add rsp,imm8
                    do append(obuf, 131)
                    do append(obuf, 196)
                    do append(obuf, 8 * nargs)
                else:
                    do append(obuf, 72)    -- 48 81 C4 id add rsp,imm32
                    do append(obuf, 129)
                    do append(obuf, 196)
                    obuf = nc_append_le32(obuf, 8 * nargs)
                end
            end
            do append(obuf, 80)    -- 50 push rax
        end
    elif op == 21:
        if il == 1:
            do append(obuf, 88)
        else:
            do append(obuf, 88)
            do append(obuf, 233)
            obuf = nc_append_le32(obuf, epi - endoff)
        end
    end
    return nc_tap_lower_body(obuf, code, i + 1, n, offs, epi, bases, funcs, is_main, nparams, frame, buf_2m)
end

-- callee image bases (i starts at 1; bases[0] = main entry, already added).
func nc_tap_callee_bases(funcs, i, nf, cur, bases):
    if i >= nf:
        return bases
    end
    do add(bases, cur)
    let fn = get(funcs, i)
    let frame = nc_tap_frame_size(fn)
    return nc_tap_callee_bases(funcs, i + 1, nf, cur + nc_tap_func_total(fn, funcs, 0, frame), bases)
end

func nc_tap_emit_callees(buf, funcs, i, nf, bases, buf_2m):
    if i >= nf:
        return buf
    end
    let fn = get(funcs, i)
    let code = fn.4
    let n = count(code)
    let frame = nc_tap_frame_size(fn)
    if frame > 0:
        buf = nc_tap_emit_prologue(buf, 0, fn.2, frame)
    end
    let pbase = get(bases, i) + nc_tap_prologue_len(0, fn.2, frame)
    let lay = nc_tap_offsets_loop(code, 0, n, pbase, new_array(int), funcs, 0, fn.2, frame)
    buf = nc_tap_lower_body(buf, code, 0, n, lay.0, lay.1, bases, funcs, 0, fn.2, frame, buf_2m)
    buf = nc_tap_emit_epilogue(buf, 0, frame)
    return nc_tap_emit_callees(buf, funcs, i + 1, nf, bases, buf_2m)
end

-- each call op targets an in-range NON-main function with matching arity.
func nc_tap_calls_ok(code, i, n, funcs, nf):
    if i >= n:
        return true
    end
    if get(code, i).0 == 20:
        let callee = get(code, i).1
        let nargs = get(code, i).2
        if callee == 0:
            let e1 = nc_fail(606, 0, "multiboot32-long64: cannot call main (the entry is not a callee)")
            return false
        end
        if callee >= nf:
            let e2 = nc_fail(607, 0, "multiboot32-long64: call target out of range")
            return false
        end
        if get(funcs, callee).2 != nargs:
            let e3 = nc_fail(608, 0, "multiboot32-long64: call arity mismatch")
            return false
        end
    end
    return nc_tap_calls_ok(code, i + 1, n, funcs, nf)
end

func nc_tap_func_ok(fn, funcs, nf, is_main):
    let code = fn.4
    let n = count(code)
    if not nc_tap_body_ok(code, n):
        let e4 = nc_fail(605, 0, "multiboot32-long64: function body not in the call+recursion subset")
        return false
    end
    if nc_tap_frame_size(fn) > 15:
        let e5 = nc_fail(602, 0, "multiboot32-long64: too many slots (max 15)")
        return false
    end
    if fn.2 > 14:
        let e6 = nc_fail(609, 0, "multiboot32-long64: more than 14 parameters (param-copy disp8 bound)")
        return false
    end
    if is_main == 1:
        if fn.2 != 0:
            let e7 = nc_fail(601, 0, "multiboot32-long64: main must take no parameters")
            return false
        end
    end
    return nc_tap_calls_ok(code, 0, n, funcs, nf)
end

func nc_tap_all_funcs_ok(funcs, i, nf):
    if i >= nf:
        return true
    end
    let ismain = 0
    if i == 0:
        ismain = 1
    end
    if not nc_tap_func_ok(get(funcs, i), funcs, nf, ismain):
        return false
    end
    return nc_tap_all_funcs_ok(funcs, i + 1, nf)
end

func nc_tap_roundup_2m(v):
    let r = v % 2097152
    if r == 0:
        return v
    end
    return v + 2097152 - r
end

-- identity-map the low 1 GiB as 2-MiB PS pages EXCEPT the guard page (its 2-MiB slot left
-- NON-PRESENT), so a stack overflow past the stack's own 2-MiB page faults instead of
-- corrupting the page tables.
func nc_tap_emit_pd_loop(buf, i, guard_2m, guard_lo_2m):
    if i >= 512:
        return buf
    end
    if i * 2097152 == guard_2m:
        buf = nc_append_le32(buf, 0)
        buf = nc_append_le32(buf, 0)
    elif i * 2097152 == guard_lo_2m:
        buf = nc_append_le32(buf, 0)
        buf = nc_append_le32(buf, 0)
    else:
        buf = nc_append_le32(buf, i * 2097152 + 131)
        buf = nc_append_le32(buf, 0)
    end
    return nc_tap_emit_pd_loop(buf, i + 1, guard_2m, guard_lo_2m)
end

-- hearken/riposte: any function body containing op 45 (input_byte) OR op 53 (output_byte)
-- means the image touches the COM1 UART, so UART init (56 bytes) is emitted ONCE at
-- long_entry. Neither op anywhere -> uart_len=0 -> byte-identical to taproot. (riposte
-- widened the predicate from op-45-only; an op-45-only program keeps the SAME block at the
-- SAME offset, so every hearken golden is byte-identical under the widened predicate.)
func nc_tap_code_uses_uart(code, i, n):
    if i >= n:
        return false
    end
    if get(code, i).0 == 45:
        return true
    end
    if get(code, i).0 == 53:
        return true
    end
    return nc_tap_code_uses_uart(code, i + 1, n)
end

func nc_tap_uses_uart(funcs, i, nf):
    if i >= nf:
        return false
    end
    let fn = get(funcs, i)
    let code = fn.4
    if nc_tap_code_uses_uart(code, 0, count(code)):
        return true
    end
    return nc_tap_uses_uart(funcs, i + 1, nf)
end

-- folio activation examines every lowered function, not reachability. The
-- non-input path emits neither capture nor validation and keeps its old bytes.
func nc_tap_code_uses_boot(code, i, n):
    if i >= n:
        return false
    end
    if get(code, i).0 == 57:
        return true
    end
    return nc_tap_code_uses_boot(code, i + 1, n)
end

func nc_tap_uses_boot(funcs, i, nf):
    if i >= nf:
        return false
    end
    let fn = get(funcs, i)
    let code = fn.4
    if nc_tap_code_uses_boot(code, 0, count(code)):
        return true
    end
    return nc_tap_uses_boot(funcs, i + 1, nf)
end

-- All validation failures branch backward to this boot path's inline stub.
-- Offsets are within cbuf, just like the existing tap layout; no patch table.
func nc_tap_boot_fail_branch(buf, cc, fail_off):
    do append(buf, 15)
    do append(buf, cc)
    let endoff = buffer_length(buf) + 4
    return nc_append_rel32(buf, fail_off, endoff)
end

-- Validate the COMPLETE span [rax,rax+span) before dereferencing metadata.
-- RAX was loaded through EAX, so adding 16/28 at 64-bit width cannot wrap.
-- Accept nonnull spans wholly below 0xA0000, or wholly in [esp_val,64 MiB).
-- This appliance policy excludes image, guards, stack and the firmware hole;
-- it is not general physical-memory discovery. Clobbers RCX, preserves RAX.
-- Fixed 47 bytes; the forward JBE skips the 25-byte high-range checks.
func nc_tap_boot_span(buf, span, esp_val, fail_off):
    do append(buf, 72)   -- 48 85 C0 test rax,rax
    do append(buf, 133)
    do append(buf, 192)
    buf = nc_tap_boot_fail_branch(buf, 132, fail_off)  -- jz
    do append(buf, 72)   -- 48 8D 48 ib lea rcx,[rax+span]
    do append(buf, 141)
    do append(buf, 72)
    do append(buf, span)
    do append(buf, 72)   -- 48 81 F9 00000A00 cmp rcx,0xA0000
    do append(buf, 129)
    do append(buf, 249)
    buf = nc_append_le32(buf, 655360)
    do append(buf, 118)  -- 76 19 jbe accepted
    do append(buf, 25)
    do append(buf, 72)   -- 48 3D id cmp rax,esp_val
    do append(buf, 61)
    buf = nc_append_le32(buf, esp_val)
    buf = nc_tap_boot_fail_branch(buf, 130, fail_off)  -- jb
    do append(buf, 72)   -- 48 81 F9 00000004 cmp rcx,64 MiB
    do append(buf, 129)
    do append(buf, 249)
    buf = nc_append_le32(buf, 67108864)
    return nc_tap_boot_fail_branch(buf, 135, fail_off) -- ja
end

-- folio's 259-byte pre-main initializer, after mov esp,esp_val. The 32-bit
-- capture used ESI/EDI; explicitly normalize both here in 64-bit mode before
-- inspecting either value. Incoming upper register halves are not trustworthy.
-- R12/R13 become cursor/end only after complete descriptor validation. All
-- currently admitted tap operations, callee frames and TCO preserve them.
func nc_tap_boot_init(buf, esp_val):
    let start = buffer_length(buf)
    do append(buf, 137)  -- 89 F6 mov esi,esi (zero-extend saved magic)
    do append(buf, 246)
    do append(buf, 137)  -- 89 FF mov edi,edi (zero-extend saved MBI pointer)
    do append(buf, 255)
    do append(buf, 235)  -- EB 49 jump over the 73-byte failure stub
    do append(buf, 73)
    let fail_off = buffer_length(buf)
    do append(buf, 102)  -- 66 BA E900 mov dx,0xE9
    do append(buf, 186)
    do append(buf, 233)
    do append(buf, 0)
    buf = nc32_emit_out_char(buf, 66)  -- BI\n, before the ordinary grade-1 tail
    buf = nc32_emit_out_char(buf, 73)
    buf = nc32_emit_out_char(buf, 10)
    do append(buf, 176)  -- B0 01 mov al,1
    do append(buf, 1)
    buf = nc32_emit_epilogue(buf)
    do append(buf, 129)  -- 81 FE 02B0AD2B cmp esi,Multiboot magic
    do append(buf, 254)
    buf = nc_append_le32(buf, 732803074)
    buf = nc_tap_boot_fail_branch(buf, 133, fail_off) -- jne (no metadata load yet)
    do append(buf, 137)  -- 89 F8 mov eax,edi
    do append(buf, 248)
    buf = nc_tap_boot_span(buf, 28, esp_val, fail_off)
    do append(buf, 246)  -- F6 00 08 test byte [rax],8 (module-present flag)
    do append(buf, 0)
    do append(buf, 8)
    buf = nc_tap_boot_fail_branch(buf, 132, fail_off) -- jz
    do append(buf, 131)  -- 83 78 14 01 cmp dword [rax+20],1
    do append(buf, 120)
    do append(buf, 20)
    do append(buf, 1)
    buf = nc_tap_boot_fail_branch(buf, 133, fail_off) -- jne
    do append(buf, 139)  -- 8B 40 18 mov eax,[rax+24] (zero-extended descriptor)
    do append(buf, 64)
    do append(buf, 24)
    buf = nc_tap_boot_span(buf, 16, esp_val, fail_off)
    do append(buf, 68)   -- 44 8B 20 mov r12d,[rax] (module start)
    do append(buf, 139)
    do append(buf, 32)
    do append(buf, 68)   -- 44 8B 68 04 mov r13d,[rax+4] (module end)
    do append(buf, 139)
    do append(buf, 104)
    do append(buf, 4)
    do append(buf, 77)   -- 4D 39 EC cmp r12,r13 (ordered extent)
    do append(buf, 57)
    do append(buf, 236)
    buf = nc_tap_boot_fail_branch(buf, 135, fail_off) -- ja
    do append(buf, 76)   -- 4C 89 E1 mov rcx,r12
    do append(buf, 137)
    do append(buf, 225)
    do append(buf, 76)   -- 4C 09 E9 or rcx,r13
    do append(buf, 9)
    do append(buf, 233)
    do append(buf, 116)  -- 74 1A jz accepted: GRUB's exact empty sentinel 0,0
    do append(buf, 26)
    do append(buf, 73)   -- 49 81 FC id cmp r12,esp_val
    do append(buf, 129)
    do append(buf, 252)
    buf = nc_append_le32(buf, esp_val)
    buf = nc_tap_boot_fail_branch(buf, 130, fail_off) -- jb
    do append(buf, 73)   -- 49 81 FD 00000004 cmp r13,64 MiB
    do append(buf, 129)
    do append(buf, 253)
    buf = nc_append_le32(buf, 67108864)
    buf = nc_tap_boot_fail_branch(buf, 135, fail_off) -- ja
    if buffer_length(buf) != start + 259:
        let failed = nc_fail(656, 0, "multiboot32-long64: boot initializer length invariant")
        return buf
    end
    return buf
end

-- link66 BUFFER MODE, the exact mirror of the uart predicate above: any function body containing
-- op 49 (bufbase), 50 (bufget) or 51 (bufset) means the image needs the runtime-indexed buffer, so
-- the two-guard layout, the buffer page and the exact p_memsz are emitted. NONE of them anywhere ->
-- buffer mode off -> the layout, the PD and p_memsz are byte-identical to taproot/hearken/riposte/
-- gyre, which is why this change cannot move any of the 29 committed long64 goldens.
func nc_tap_code_uses_buf(code, i, n):
    if i >= n:
        return false
    end
    let op = get(code, i).0
    if op == 49:
        return true
    end
    if op == 50:
        return true
    end
    if op == 51:
        return true
    end
    return nc_tap_code_uses_buf(code, i + 1, n)
end

func nc_tap_uses_buf(funcs, i, nf):
    if i >= nf:
        return false
    end
    let fn = get(funcs, i)
    let code = fn.4
    if nc_tap_code_uses_buf(code, 0, count(code)):
        return true
    end
    return nc_tap_uses_buf(funcs, i + 1, nf)
end

-- the IR gate's census: how many INDEXED ops (50/51) the whole program contains. bufbase alone
-- hands a program a live absolute pointer into a page it never indexes, which is buffer geometry
-- bought and not used; the gate below refuses it.
func nc_tap_code_idx_ops(code, i, n, acc):
    if i >= n:
        return acc
    end
    let op = get(code, i).0
    if op == 50:
        acc = acc + 1
    end
    if op == 51:
        acc = acc + 1
    end
    return nc_tap_code_idx_ops(code, i + 1, n, acc)
end

func nc_tap_idx_ops(funcs, i, nf, acc):
    if i >= nf:
        return acc
    end
    let fn = get(funcs, i)
    let code = fn.4
    acc = nc_tap_code_idx_ops(code, 0, count(code), acc)
    return nc_tap_idx_ops(funcs, i + 1, nf, acc)
end

-- the taproot driver (multiple functions, or folio input). Layout (V0=0x10000c):
-- [folio capture: 4 bytes iff boot_read] [56-byte head -> ljmp long_entry]
-- [mov esp,esp_val] [folio validation: 259 bytes iff boot_read] [uart init: 56 bytes iff any func
-- reads input (hearken)] [optional main rbp frame] [main body -- calls to callees via E8
-- rel32] [grading tail: shr rax,0x20] [shared 58-byte epilogue] [CALLEE BLOCK: funcs[1..],
-- each prologue+body+epilogue] [GDT/GDTR 30] [pad to 4 KiB] [PML4][PDPT][PD w/ guard]. main
-- never falls through to the callees (the epilogue exits via isa-debug-exit); they are
-- entered only by call.
func nc_tap_emit_program(funcs, mainidx):
    let nf = count(funcs)
    if mainidx != 0:
        let e0 = nc_fail(600, 0, "multiboot32-long64: main not the entry (index 0)")
        return 0
    end
    if not equal(get(funcs, 0).0, "main"):
        let e0b = nc_fail(600, 0, "multiboot32-long64: entry function is not main")
        return 0
    end
    if not nc_tap_all_funcs_ok(funcs, 0, nf):
        return 0
    end
    let mainfn = get(funcs, 0)
    let maincode = mainfn.4
    let mainn = count(maincode)
    let main_frame = nc_tap_frame_size(mainfn)
    let main_prefix = 5
    if main_frame > 0:
        main_prefix = 12
    end
    let uart_len = 0
    if nc_tap_uses_uart(funcs, 0, nf):
        uart_len = 56
    end
    let uses_boot = nc_tap_uses_boot(funcs, 0, nf)
    let capture_len = 0
    let boot_init_len = 0
    if uses_boot:
        capture_len = 4
        boot_init_len = 259
    end
    let head_len = capture_len + 56
    let main_bodylen = nc_tap_body_size(maincode, 0, mainn, 0, funcs, 1, 0, main_frame)
    let v0 = 1048588
    let long_entry_vaddr = v0 + head_len
    let main_body_base = head_len + main_prefix + boot_init_len + uart_len
    let main_epi_abs = main_body_base + main_bodylen
    let callee_block_start = main_epi_abs + 4 + 58
    let bases = new_array(int)
    do add(bases, head_len)
    bases = nc_tap_callee_bases(funcs, 1, nf, callee_block_start, bases)
    let callee_block_len = nc_tap_callees_total(funcs, 1, nf, 0)
    let gdt_off = callee_block_start + callee_block_len
    let gdt_vaddr = v0 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let tables_end = gdtr_vaddr + 6
    let pml4_vaddr = nc32_roundup_4k(tables_end)
    let pdpt_vaddr = pml4_vaddr + 4096
    let pd_vaddr = pdpt_vaddr + 4096
    let load_end = pd_vaddr + 4096
    -- link66 BUFFER MODE. Off -> every line below is exactly what taproot/hearken/riposte/gyre
    -- emit today, which is what keeps the 29 committed long64 goldens byte-identical.
    let uses_buf = nc_tap_uses_buf(funcs, 0, nf)
    if uses_buf:
        -- THE IR GATE. Buffer mode buys a 2-MiB page, two non-present guards and an absolute base
        -- immediate. A program that takes all of that and never indexes the page (bufbase() with no
        -- bufget/bufset anywhere) is refused rather than quietly handed a live pointer it cannot use.
        if nc_tap_idx_ops(funcs, 0, nf, 0) < 1:
            let fb = nc_fail(655, 0, "multiboot32-long64: buffer mode needs at least one bufget/bufset")
            return 0
        end
    end
    -- guard_2m is the HIGH guard in both modes -- the stack's own overflow backstop -- so the stack
    -- relationship never changes. In buffer mode a SECOND non-present 2-MiB slot (guard_lo_2m) is
    -- opened below the buffer, giving the layout
    --     load_end -> [guard_lo NON-PRESENT] [buf_2m 2 MiB PRESENT] [guard_hi NON-PRESENT] [stack]
    -- so index -1 faults into guard_lo, index 262143 is the last live slot (2 MiB / 8 B = 262144
    -- slots) and index 262144 faults into guard_hi. Those are SC3's three boundary probes, decided
    -- by the page tables rather than by a bounds check the program could omit. Outside buffer mode
    -- guard_lo_2m is -1, which no PD index can equal, so the PD is byte-identical to today's.
    let guard_lo_2m = 0 - 1
    let buf_2m = 0
    let guard_2m = nc_tap_roundup_2m(load_end)
    if uses_buf:
        guard_lo_2m = guard_2m
        buf_2m = guard_lo_2m + 2097152
        guard_2m = buf_2m + 2097152
    end
    let stack_2m_base = guard_2m + 2097152
    let esp_val = stack_2m_base + 2097152
    if esp_val > 67108864:
        let f7 = nc_fail(603, 0, "multiboot32-long64: stack exceeds the 64-MiB target RAM budget")
        return 0
    end
    let cbuf = new_buffer()
    if uses_boot:
        -- Capture before the old 32-bit head clobbers EAX/ECX/EDX. Do not
        -- push to the unspecified incoming stack; ESI/EDI survive the head.
        do append(cbuf, 137)  -- 89 C6 mov esi,eax (Multiboot magic)
        do append(cbuf, 198)
        do append(cbuf, 137)  -- 89 DF mov edi,ebx (information pointer)
        do append(cbuf, 223)
    end
    cbuf = nc32_long_emit_head(cbuf, gdtr_vaddr, pml4_vaddr, long_entry_vaddr)
    do append(cbuf, 188)   -- BC mov esp,imm32
    cbuf = nc_append_le32(cbuf, esp_val)
    if uses_boot:
        cbuf = nc_tap_boot_init(cbuf, esp_val)
    end
    if uart_len > 0:
        cbuf = nc32_uart_init(cbuf)   -- hearken: COM1 init once, before the main frame
    end
    if main_frame > 0:
        do append(cbuf, 72)    -- 48 89 E5 mov rbp,rsp
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 72)    -- 48 83 EC ib sub rsp,8S
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 8 * main_frame)
    end
    if uses_boot and buffer_length(cbuf) != main_body_base:
        let fboot = nc_fail(656, 0, "multiboot32-long64: boot prefix length invariant")
        return 0
    end
    let mlay = nc_tap_offsets_loop(maincode, 0, mainn, main_body_base, new_array(int), funcs, 1, 0, main_frame)
    cbuf = nc_tap_lower_body(cbuf, maincode, 0, mainn, mlay.0, mlay.1, bases, funcs, 1, 0, main_frame, buf_2m)
    do append(cbuf, 72)    -- 48 C1 E8 20 shr rax,0x20 (grading tail)
    do append(cbuf, 193)
    do append(cbuf, 232)
    do append(cbuf, 32)
    cbuf = nc32_emit_epilogue(cbuf)
    if buffer_length(cbuf) != callee_block_start:
        let f8 = nc_fail(610, 0, "multiboot32-long64: main block length invariant")
        return 0
    end
    cbuf = nc_tap_emit_callees(cbuf, funcs, 1, nf, bases, buf_2m)
    if buffer_length(cbuf) != gdt_off:
        let f9 = nc_fail(611, 0, "multiboot32-long64: callee block length invariant")
        return 0
    end
    cbuf = nc32_long_emit_gdt(cbuf, gdt_vaddr)
    let pre_pml4_len = buffer_length(cbuf)
    let pad_to_pml4 = pml4_vaddr - v0 - pre_pml4_len
    cbuf = nc_emit_zeroes_loop(cbuf, pad_to_pml4)
    cbuf = nc32_long_emit_pml4(cbuf, pdpt_vaddr)
    cbuf = nc32_long_emit_pdpt(cbuf, pd_vaddr)
    cbuf = nc_tap_emit_pd_loop(cbuf, 0, guard_2m, guard_lo_2m)
    let frozen_code = freeze(cbuf)
    let code_len = length(frozen_code)
    if code_len != load_end - v0:
        let f6 = nc_fail(604, 0, "multiboot32-long64: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    -- p_memsz. Outside buffer mode this stays the landed filesz+16384 (D23's known
    -- under-declaration, deliberately untouched here so no golden moves). IN BUFFER MODE it is
    -- EXACT: the segment reserves every byte from its own load address 0x100000 up to the high
    -- guard, so the page the program indexes is DECLARED memory rather than memory the image merely
    -- happens to find mapped. M-memsz reverts this to filesz+16384 and the static phdr assert
    -- (p_memsz == guard_hi_2m - 0x100000) catches it without a boot.
    let memsz = filesz + 16384
    if uses_buf:
        memsz = guard_2m - 1048576
    end
    if uses_boot:
        -- Reserve the COMPLETE new input image, including guards and stack,
        -- before a loader places its module. Applied after buffer reservation.
        -- Non-input images retain the historical p_memsz and D23 scope.
        memsz = esp_val - 1048576
    end
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

func nc_emit_multiboot32_long64_program(source):
    let checked = nc_check_source(source)
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1 or nc_tap_uses_boot(funcs, 0, count(funcs)):
        return nc_tap_emit_program(funcs, prog.2)
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let f2 = nc_fail(501, 0, "multiboot32-long64: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if not nc64_body_ok(code, n):
        let f3 = nc_fail(502, 0, "multiboot32-long64: body not in the control-flow+locals 64-bit subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 15:
        let f4 = nc_fail(504, 0, "multiboot32-long64: too many locals (max 15)")
        return 0
    end
    let prefix_len = 5
    if nlocals > 0:
        prefix_len = 12
    end
    let lay = nc64_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc64_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = buffer_length(bodybuf)
    if bodylen != epi - prefix_len:
        let f5 = nc_fail(505, 0, "multiboot32-long64: body length invariant (a lowered op was dropped or mis-sized)")
        return 0
    end
    let v0 = 1048588
    let long_entry_vaddr = v0 + 56
    let region_len = prefix_len + bodylen + 4
    let epi_off = 56 + region_len
    let gdt_off = epi_off + 58
    let gdt_vaddr = v0 + gdt_off
    let gdtr_vaddr = gdt_vaddr + 24
    let tables_end = gdtr_vaddr + 6
    let pml4_vaddr = nc32_roundup_4k(tables_end)
    let pdpt_vaddr = pml4_vaddr + 4096
    let pd_vaddr = pdpt_vaddr + 4096
    let load_end = pd_vaddr + 4096
    let esp_val = load_end + 16384
    if esp_val > 1073741824:
        let f7 = nc_fail(503, 0, "multiboot32-long64: image exceeds the identity-mapped low 1 GiB")
        return 0
    end
    let cbuf = new_buffer()
    cbuf = nc32_long_emit_head(cbuf, gdtr_vaddr, pml4_vaddr, long_entry_vaddr)
    do append(cbuf, 188)
    cbuf = nc_append_le32(cbuf, esp_val)
    if nlocals > 0:
        do append(cbuf, 72)
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 72)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 8 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    do append(cbuf, 72)
    do append(cbuf, 193)
    do append(cbuf, 232)
    do append(cbuf, 32)
    cbuf = nc32_emit_epilogue(cbuf)
    cbuf = nc32_long_emit_gdt(cbuf, gdt_vaddr)
    let pre_pml4_len = buffer_length(cbuf)
    let pad_to_pml4 = pml4_vaddr - v0 - pre_pml4_len
    cbuf = nc_emit_zeroes_loop(cbuf, pad_to_pml4)
    cbuf = nc32_long_emit_pml4(cbuf, pdpt_vaddr)
    cbuf = nc32_long_emit_pdpt(cbuf, pd_vaddr)
    cbuf = nc32_long_emit_pd_loop(cbuf, 0)
    let frozen_code = freeze(cbuf)
    let code_len = length(frozen_code)
    if code_len != load_end - v0:
        let f6 = nc_fail(504, 0, "multiboot32-long64: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let memsz = filesz + 16384
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end
