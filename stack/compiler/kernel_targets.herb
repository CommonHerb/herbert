-- Multiboot header REQUESTING memory info (flags bit1=MEMINFO): magic 1BADB002, flags 2,
-- checksum 0xE4524FFC. A NEW function -- the shared nc32_emit_mbheader (flags=0) is untouched
-- (fixpoint-safe). lodger consumes the mmap, so it requests it.
func nc32_emit_mbheader_meminfo(buf):
    do append(buf, 2)
    do append(buf, 176)
    do append(buf, 173)
    do append(buf, 27)
    do append(buf, 2)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 252)
    do append(buf, 79)
    do append(buf, 82)
    do append(buf, 228)
    return buf
end

func nc32_count_module_loop(code, i, n, cnt):
    if i >= n:
        return cnt
    end
    let c = cnt
    if get(code, i).0 == 46:
        c = c + 1
    end
    return nc32_count_module_loop(code, i + 1, n, c)
end

func nc32_count_module(code, n):
    return nc32_count_module_loop(code, 0, n, 0)
end

-- op 46 (module_byte) has the SAME stack effect as push_int (op 0); map it to op 0 for
-- nc32_body_ok's depth walk (the input-mode proxy pattern). The REAL code keeps op 46.
func nc32_module_proxy_loop(out, code, i, n):
    if i >= n:
        return out
    end
    let e = get(code, i)
    if e.0 == 46:
        do add(out, (0, 0, 0))
    else:
        do add(out, e)
    end
    return nc32_module_proxy_loop(out, code, i + 1, n)
end

func nc32_module_proxy(code, n):
    return nc32_module_proxy_loop(new_array((int, int, int)), code, 0, n)
end

-- coalgate: count op 47 (sys_read) occurrences -- the module's single input read must be present exactly once.
func nc32_count_sysread_loop(code, i, n, cnt):
    if i >= n:
        return cnt
    end
    let c = cnt
    if get(code, i).0 == 47:
        c = cnt + 1
    end
    return nc32_count_sysread_loop(code, i + 1, n, c)
end

func nc32_count_sysread(code, n):
    return nc32_count_sysread_loop(code, 0, n, 0)
end

-- op 47 (sys_read) has the SAME stack effect as push_int (op 0); map it to op 0 for nc32_body_ok's
-- depth/branch walk (the module/input proxy pattern). The REAL code keeps op 47 for the lowering.
func nc32_sysread_proxy_loop(out, code, i, n):
    if i >= n:
        return out
    end
    let e = get(code, i)
    if e.0 == 47:
        do add(out, (0, 0, 0))
    else:
        do add(out, e)
    end
    return nc32_sysread_proxy_loop(out, code, i + 1, n)
end

func nc32_sysread_proxy(code, n):
    return nc32_sysread_proxy_loop(new_array((int, int, int)), code, 0, n)
end

-- holler (link 24): count op 48 (sys_write) occurrences -- the compiled module must emit >= 1 (else it is just
-- a coalgate module; the headline capability is the module emitting its OWN output).
func nc32_count_syswrite_loop(code, i, n, cnt):
    if i >= n:
        return cnt
    end
    let c = cnt
    if get(code, i).0 == 48:
        c = cnt + 1
    end
    return nc32_count_syswrite_loop(code, i + 1, n, c)
end

func nc32_count_syswrite(code, n):
    return nc32_count_syswrite_loop(code, 0, n, 0)
end

-- holler module proxy for nc32_body_ok's depth walk: op 47 (sys_read) -> op 0 (push, +1, like coalgate);
-- op 48 (sys_write) -> op 4 (store_local, pop 1) THEN op 0 (push, +1) = NET 0 (pop the arg, push the result).
-- The 48->two-op expansion makes the proxy LONGER than the code, which is safe ONLY because the holler module
-- is straight-line (nc32_has_branch rejects branches), so nc32_check_branches has nothing to align; the depth
-- walk just needs the net stack effect right. body_ok is called with count(proxy), not count(code).
func nc32_holler_proxy_loop(out, code, i, n):
    if i >= n:
        return out
    end
    let e = get(code, i)
    if e.0 == 47:
        do add(out, (0, 0, 0))
    elif e.0 == 48:
        do add(out, (4, 0, 0))
        do add(out, (0, 0, 0))
    else:
        do add(out, e)
    end
    return nc32_holler_proxy_loop(out, code, i + 1, n)
end

func nc32_holler_proxy(code, n):
    return nc32_holler_proxy_loop(new_array((int, int, int)), code, 0, n)
end

func nc_is_multiboot32_lodger(source):
    let marker = "-- emit: multiboot32-lodger"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- lodger driver: head (program-lifecycle germ) + compiled body (reads module_byte() exactly
-- once, straight-line toakie subset) + shared epilogue. prefix_len = 1493 (head ends at cld;
-- +5 if the body has an ebp frame). Reuses nc32_emit_ehdr/phdr/epilogue verbatim; the mbheader
-- is the MEMINFO variant.
func nc_emit_multiboot32_lodger_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let fa = nc_fail(530, 0, "multiboot32-lodger: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let fb = nc_fail(531, 0, "multiboot32-lodger: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if nc32_count_module(code, n) != 1:
        let fi = nc_fail(532, 0, "multiboot32-lodger: main must read module_byte() exactly once")
        return 0
    end
    if nc32_has_branch(code, n):
        let fh = nc_fail(533, 0, "multiboot32-lodger: control flow (if/branch) not in the straight-line lodger subset")
        return 0
    end
    let proxy = nc32_module_proxy(code, n)
    if not nc32_body_ok(proxy, n):
        let fc = nc_fail(534, 0, "multiboot32-lodger: body not in the module/locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let fd = nc_fail(535, 0, "multiboot32-lodger: too many locals (max 31)")
        return 0
    end
    let prefix_len = 1493
    if nlocals > 0:
        prefix_len = 1498
    end
    let lay = nc32_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let fe = nc_fail(536, 0, "multiboot32-lodger: body length invariant")
        return 0
    end
    let code_len = prefix_len + bodylen + 58
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let cbuf = new_buffer()
    cbuf = nc32_lodger_emit_head(cbuf, esp_top)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    let frozen_code = freeze(cbuf)
    if length(frozen_code) != code_len:
        let fg = nc_fail(537, 0, "multiboot32-lodger: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader_meminfo(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

func nc32_trikon_data():
    return ""
end

func nc32_trikon_hexval(c):
    if c >= 97:
        return c - 87
    end
    return c - 48
end

func nc32_trikon_prefix_loop(buf, hx, hlen, hi, bi, esp_top):
    if hi >= hlen:
        return buf
    end
    if bi == 216 or bi == 944 or bi == 972 or bi == 1375 or bi == 1662 or bi == 2310:
        buf = nc_append_le32(buf, esp_top)
        return nc32_trikon_prefix_loop(buf, hx, hlen, hi + 8, bi + 4, esp_top)
    end
    let b = nc32_trikon_hexval(index(hx, hi)) * 16 + nc32_trikon_hexval(index(hx, hi + 1))
    do append(buf, b)
    return nc32_trikon_prefix_loop(buf, hx, hlen, hi + 2, bi + 1, esp_top)
end

func nc32_trikon_emit_prefix(buf, esp_top):
    let hx = nc32_trikon_data()
    return nc32_trikon_prefix_loop(buf, hx, length(hx), 0, 0, esp_top)
end
func nc_is_multiboot32_trikon(source):
    let marker = "-- emit: multiboot32-trikon"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- trikonderoga driver: the ring-3-on-the-module link. Reuses lodger's discover+allocate machinery
-- (now folded into nc32_trikon_emit_prefix) but runs the build-unknown module at CPL 3 on the
-- allocated page; the module EXITS via int 0x30 (the first syscall) and a hostile `out` faults #GP.
-- Layout: [prefix = head+handlers+tables, 2410 fixed] [body] [epilogue 58]. The body is lodger's
-- straight-line module_byte() subset verbatim; the exit handler stores the module status into the
-- answer cell, then jmps to the body (which reads it and the epilogue emits f(status)).
func nc_emit_multiboot32_trikon_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let fa = nc_fail(540, 0, "multiboot32-trikon: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let fb = nc_fail(541, 0, "multiboot32-trikon: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if nc32_count_module(code, n) != 1:
        let fi = nc_fail(542, 0, "multiboot32-trikon: main must read module_byte() exactly once")
        return 0
    end
    if nc32_has_branch(code, n):
        let fh = nc_fail(543, 0, "multiboot32-trikon: control flow (if/branch) not in the straight-line subset")
        return 0
    end
    let proxy = nc32_module_proxy(code, n)
    if not nc32_body_ok(proxy, n):
        let fc = nc_fail(544, 0, "multiboot32-trikon: body not in the module/locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let fd = nc_fail(545, 0, "multiboot32-trikon: too many locals (max 31)")
        return 0
    end
    let prefix_len = 2410
    if nlocals > 0:
        prefix_len = 2415
    end
    let lay = nc32_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let fe = nc_fail(546, 0, "multiboot32-trikon: body length invariant")
        return 0
    end
    let code_len = prefix_len + bodylen + 58
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let cbuf = new_buffer()
    cbuf = nc32_trikon_emit_prefix(cbuf, esp_top)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    let frozen_code = freeze(cbuf)
    if length(frozen_code) != code_len:
        let fg = nc_fail(547, 0, "multiboot32-trikon: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader_meminfo(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end



-- nokta (link 19) compact prefix emitter (machine-generated from nokta_ref.py; do not hand-edit).
-- HEAD-portion (head+handlers+GDT/IDT/TSS+align-pad) is hex-data with esp_top substitution; the
-- PD+PT identity map is loop-generated (chosen's pattern). Output == nokta_ref.build_code prefix.
func nc32_nokta_data():
    return ""
end

func nc32_nokta_hexval(c):
    if c >= 97:
        return c - 87
    end
    return c - 48
end

func nc32_nokta_head_loop(buf, hx, hlen, hi, bi, esp_top):
    if hi >= hlen:
        return buf
    end
    if bi == 216 or bi == 944 or bi == 972 or bi == 1375 or bi == 1733 or bi == 2542:
        buf = nc_append_le32(buf, esp_top)
        return nc32_nokta_head_loop(buf, hx, hlen, hi + 8, bi + 4, esp_top)
    end
    let b = nc32_nokta_hexval(index(hx, hi)) * 16 + nc32_nokta_hexval(index(hx, hi + 1))
    do append(buf, b)
    return nc32_nokta_head_loop(buf, hx, hlen, hi + 2, bi + 1, esp_top)
end

-- page directory: PDE[i] -> PT_i | present|RW|US (0x7) for i < NPT, else 0. NPT page tables.
func nc32_nokta_pd_loop(buf, i):
    if i >= 1024:
        return buf
    end
    if i < 4:
        buf = nc_append_le32(buf, 1056768 + i * 4096 + 7)
    else:
        buf = nc_append_le32(buf, 0)
    end
    return nc32_nokta_pd_loop(buf, i + 1)
end

-- page tables: PTE[g] -> g*4096 | present|RW (0x3), Supervisor (US=0). 1024*NPT entries.
func nc32_nokta_pt_loop(buf, g, gmax):
    if g >= gmax:
        return buf
    end
    buf = nc_append_le32(buf, g * 4096 + 3)
    return nc32_nokta_pt_loop(buf, g + 1, gmax)
end

func nc32_nokta_emit_prefix(buf, esp_top):
    let hx = nc32_nokta_data()
    buf = nc32_nokta_head_loop(buf, hx, length(hx), 0, 0, esp_top)
    buf = nc32_nokta_pd_loop(buf, 0)
    buf = nc32_nokta_pt_loop(buf, 0, 4096)
    return buf
end

func nc32_emit_mbheader_pgalign(buf):
    do append(buf, 2)
    do append(buf, 176)
    do append(buf, 173)
    do append(buf, 27)
    do append(buf, 3)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 251)
    do append(buf, 79)
    do append(buf, 82)
    do append(buf, 228)
    return buf
end

func nc_is_multiboot32_nokta(source):
    let marker = "-- emit: multiboot32-nokta"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

func nc_emit_multiboot32_nokta_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let fa = nc_fail(550, 0, "multiboot32-nokta: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let fb = nc_fail(551, 0, "multiboot32-nokta: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if nc32_count_module(code, n) != 1:
        let fi = nc_fail(552, 0, "multiboot32-nokta: main must read module_byte() exactly once")
        return 0
    end
    if nc32_has_branch(code, n):
        let fh = nc_fail(553, 0, "multiboot32-nokta: control flow (if/branch) not in the straight-line subset")
        return 0
    end
    let proxy = nc32_module_proxy(code, n)
    if not nc32_body_ok(proxy, n):
        let fc = nc_fail(554, 0, "multiboot32-nokta: body not in the module/locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let fd = nc_fail(555, 0, "multiboot32-nokta: too many locals (max 31)")
        return 0
    end
    let prefix_len = 24564
    if nlocals > 0:
        prefix_len = 24569
    end
    let lay = nc32_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let fe = nc_fail(556, 0, "multiboot32-nokta: body length invariant")
        return 0
    end
    let code_len = prefix_len + bodylen + 58
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let cbuf = new_buffer()
    cbuf = nc32_nokta_emit_prefix(cbuf, esp_top)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    let frozen_code = freeze(cbuf)
    if length(frozen_code) != code_len:
        let fg = nc_fail(557, 0, "multiboot32-nokta: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader_pgalign(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end





-- sitopia (link 20) compact prefix emitter (machine-generated from sitopia_ref.py; do not hand-edit).
-- HEAD-portion (head+handlers+GDT/IDT/TSS+align-pad) is hex-data with esp_top substitution; the
-- PD+PT identity map is loop-generated (chosen's pattern). Output == sitopia_ref.build_code prefix.
func nc32_sitopia_data():
    return ""
end

func nc32_sitopia_hexval(c):
    if c >= 97:
        return c - 87
    end
    return c - 48
end

func nc32_sitopia_head_loop(buf, hx, hlen, hi, bi, esp_top):
    if hi >= hlen:
        return buf
    end
    if bi == 216 or bi == 944 or bi == 972 or bi == 1375 or bi == 1795 or bi == 2698:
        buf = nc_append_le32(buf, esp_top)
        return nc32_sitopia_head_loop(buf, hx, hlen, hi + 8, bi + 4, esp_top)
    end
    let b = nc32_sitopia_hexval(index(hx, hi)) * 16 + nc32_sitopia_hexval(index(hx, hi + 1))
    do append(buf, b)
    return nc32_sitopia_head_loop(buf, hx, hlen, hi + 2, bi + 1, esp_top)
end

-- page directory: PDE[i] -> PT_i | present|RW|US (0x7) for i < NPT, else 0. NPT page tables.
func nc32_sitopia_pd_loop(buf, i):
    if i >= 1024:
        return buf
    end
    if i < 4:
        buf = nc_append_le32(buf, 1056768 + i * 4096 + 7)
    else:
        buf = nc_append_le32(buf, 0)
    end
    return nc32_sitopia_pd_loop(buf, i + 1)
end

-- page tables: PTE[g] -> g*4096 | present|RW (0x3), Supervisor (US=0). 1024*NPT entries.
func nc32_sitopia_pt_loop(buf, g, gmax):
    if g >= gmax:
        return buf
    end
    buf = nc_append_le32(buf, g * 4096 + 3)
    return nc32_sitopia_pt_loop(buf, g + 1, gmax)
end

func nc32_sitopia_emit_prefix(buf, esp_top):
    let hx = nc32_sitopia_data()
    buf = nc32_sitopia_head_loop(buf, hx, length(hx), 0, 0, esp_top)
    buf = nc32_sitopia_pd_loop(buf, 0)
    buf = nc32_sitopia_pt_loop(buf, 0, 4096)
    return buf
end

func nc_is_multiboot32_sitopia(source):
    let marker = "-- emit: multiboot32-sitopia"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- sitopia (link 20): the syscall ROUND-TRIP. Same body subset / layout / epilogue as nokta (the kernel body
-- is a PURE CONDUIT: module_byte() echoes [answer]); the NEW capability lives entirely in the prefix (the
-- resumable SYS_READ/SYS_EXIT handler + COM1 UART init). So this driver == nokta's with the sitopia prefix.
func nc_emit_multiboot32_sitopia_program(source):
    let tokens = lex_source(source)
    let nodes = pool_new()
    let parsed = parse_program(tokens, 0, nodes)
    let type_pool = nc_type_pool_new()
    let ast_result = nc_verify_ast(nodes, parsed.0, type_pool)
    if ast_result.0 != 0:
        return 0
    end
    let prog = lower_program_poly(nodes, parsed.0, type_pool, ast_result.2)
    let funcs = prog.0
    if count(funcs) != 1:
        let fa = nc_fail(560, 0, "multiboot32-sitopia: main may not call other functions")
        return 0
    end
    let mainfn = get(funcs, prog.2)
    if mainfn.2 != 0:
        let fb = nc_fail(561, 0, "multiboot32-sitopia: main must take no parameters")
        return 0
    end
    let code = mainfn.4
    let n = count(code)
    if nc32_count_module(code, n) != 1:
        let fi = nc_fail(562, 0, "multiboot32-sitopia: main must read module_byte() exactly once")
        return 0
    end
    if nc32_has_branch(code, n):
        let fh = nc_fail(563, 0, "multiboot32-sitopia: control flow (if/branch) not in the straight-line subset")
        return 0
    end
    let proxy = nc32_module_proxy(code, n)
    if not nc32_body_ok(proxy, n):
        let fc = nc_fail(564, 0, "multiboot32-sitopia: body not in the module/locals subset")
        return 0
    end
    let nlocals = nc32_nlocals_loop(code, 0, n, 0)
    if nlocals > 31:
        let fd = nc_fail(565, 0, "multiboot32-sitopia: too many locals (max 31)")
        return 0
    end
    let prefix_len = 24564
    if nlocals > 0:
        prefix_len = 24569
    end
    let lay = nc32_layout_loop(code, 0, n, prefix_len, new_array(int))
    let offs = lay.0
    let epi = lay.1
    let bodybuf = new_buffer()
    bodybuf = nc32_lower_loop(bodybuf, code, 0, n, offs, epi)
    let bodylen = length(freeze(bodybuf))
    if bodylen != epi - prefix_len:
        let fe = nc_fail(566, 0, "multiboot32-sitopia: body length invariant")
        return 0
    end
    let code_len = prefix_len + bodylen + 58
    let memsz = 12 + code_len + 16384
    let esp_top = 1048576 + memsz
    let cbuf = new_buffer()
    cbuf = nc32_sitopia_emit_prefix(cbuf, esp_top)
    if nlocals > 0:
        do append(cbuf, 137)
        do append(cbuf, 229)
        do append(cbuf, 131)
        do append(cbuf, 236)
        do append(cbuf, 4 * nlocals)
    end
    cbuf = append_str(cbuf, freeze(bodybuf))
    cbuf = nc32_emit_epilogue(cbuf)
    let frozen_code = freeze(cbuf)
    if length(frozen_code) != code_len:
        let fg = nc_fail(567, 0, "multiboot32-sitopia: code length invariant")
        return 0
    end
    let filesz = 12 + code_len
    let shoff = nc32_roundup4(4096 + 12 + code_len)
    let entry = 1048588
    let img = new_buffer()
    img = nc32_emit_ehdr(img, entry, shoff)
    img = nc32_emit_phdr(img, filesz, memsz)
    img = nc_emit_zeroes_loop(img, 4096 - 84)
    img = nc32_emit_mbheader_pgalign(img)
    img = append_str(img, frozen_code)
    img = nc_emit_zeroes_loop(img, shoff - 4096 - 12 - code_len)
    img = nc_emit_zeroes_loop(img, 40)
    do fwriter(freeze(img))
    return 0
end

