    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    return buf
end

func nc_emit_phdr(buf, img, align_hi):
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 5)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
