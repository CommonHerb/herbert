    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 2)
    do append(buf, 0)
    do append(buf, 62)
    do append(buf, 0)
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 120)
    do append(buf, 0)
