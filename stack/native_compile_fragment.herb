    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 23)
    do append(buf, 77)
    do append(buf, 139)
    do append(buf, 80)
    do append(buf, 16)
    if width == 1:
        do append(buf, 73)
        do append(buf, 139)
