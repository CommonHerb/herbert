-- ===== mumbani (link 27 / native-codegen Link 43): MULTI-PAGE WORKING MEMORY. The kernel hands the compiled
-- module a working set LARGER THAN ONE PAGE (D20's second installment). TWO additive modes, NO change to any
-- existing mode: (1) module-mumbani = module-mmj with sys_read relaxed ==1 -> >=1 (the reverse forcing program
-- reads n + N words), reusing the ENTIRE nc_ouro_* emitter unchanged; (2) multiboot32-mumbani = the holler kernel
-- with npages=4 (3 alloc-size immediates 0x1000->0x4000 + the alloc_lo User-flip widened 1 PTE -> 4 PTEs). The
-- head blob is machine-generated from holler_ref.build_code(npages=4) (collision-proof diff recipe); PD/PT REUSE
-- geeking's loops verbatim (the 4-page User map is a RUNTIME flip in the head, not a PD/PT change); prefix_len is
-- UNCHANGED at 24564 (the extra flip bytes are absorbed by the pre-PD align-pad, like holler's do_write arm). =====

func nc_is_module_mumbani(source):
    let marker = "-- emit: module-mumbani"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

