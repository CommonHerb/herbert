func nc_emit_new_buffer(buf):
    return nc_emit_new_heap_header(buf, 2)
end

func nc_emit_new_array(buf, width):
    return nc_emit_new_heap_header(buf, nc_mul8(width + width))
end

func nc_emit_count(buf):
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 139)
    do append(buf, 0)
    do append(buf, 80)
    return buf
end

func nc_emit_get_loads(buf, width, j):
    if j >= width:
        return buf
    end
    buf = nc_emit_rsi_load_rax(buf, nc_mul8(j))
    do append(buf, 80)
    return nc_emit_get_loads(buf, width, j + 1)
end

func nc_emit_get(buf, width, line, diag_get_off, instr_off):
    do append(buf, 89)
    do append(buf, 65)
