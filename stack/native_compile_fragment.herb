-- Herbert diagnostics fragment. This is the error fragment with source
-- locations threaded through lexing, parsing, AST construction, and static
-- checking. It reads a Herbert program from stdin, emits a located diagnostic
-- for malformed input, and otherwise compiles and runs the program through
-- the same lowerer/VM path as the error fragment.
--
-- AST representation. Each node is a tuple (tag, atoms, kids, line) where:
--   - tag    : string — the S-expression head (e.g. "program", "add",
--                       "name", "if", "clause", "type-tuple", "dot")
--   - atoms  : array(string) — verbatim atoms following the tag (names,
--                       decimal integers for int/char/str payloads,
--                       "true"/"false", type words)
--   - kids   : array(int) — indices of child nodes in the shared pool
-- The pool is an array((string, array(string), array(int), int)). Children
-- are referenced by integer index into the pool — Herbert types are
-- finite (no recursive type aliases), so a node cannot directly contain
-- an array of nodes; an index-into-the-pool encoding is the standard
-- arena representation and lets a tuple-and-array AST hold the tree.
-- Counts (`count(pool)`, indices into arrays) are always non-negative,
-- so the parser never produces a negative intermediate value.
--
-- Parser structure. Each parse routine takes (tokens, pos, pool) and
-- returns (node_idx, new_pos). For list-collecting helpers (params,
-- args, statements) the caller passes the destination array and the
-- helper returns just the new position. Keyword classification is
-- positional: the lexer never tags keywords — an IDENTIFIER token's
-- text is inspected by the parser at the point where the grammar
-- decides whether `let`/`if`/`and`/`int`/... starts a production or
-- names a value. The full set of decision points is small and local
-- to each routine.
--
-- Serializer. `ser_dump` (the ast-dump route's) walks the pool and
-- appends bytes to a shared buffer (the buffer is mutated by reference;
-- the caller threads its handle through assignment). One special case:
-- a `dot` node emits kids before atoms (the spec writes `(dot EXPR N)`);
-- every other node emits atoms before kids.

-- ====================================================================
-- LEXER FUNCTIONS (verbatim from stack/lexer_fragment.herb)
-- ====================================================================

func is_digit(c):
    return c >= '0' and c <= '9'
end

func is_lower(c):
    return c >= 'a' and c <= 'z'
end

func is_upper(c):
    return c >= 'A' and c <= 'Z'
end

func is_alpha(c):
    return is_lower(c) or is_upper(c)
end

func is_ident_start(c):
    return is_alpha(c) or c == '_'
end

func is_ident_cont(c):
    return is_ident_start(c) or is_digit(c)
end

func is_ws(c):
    return c == ' ' or c == '\n' or c == 9 or c == 13
end

func is_two_byte_op_start(c):
    return c == '=' or c == '!' or c == '<' or c == '>'
end

-- `<<` and `>>` are two-byte operators (a doubled `<`/`>`). They must be lexed
-- before the single-byte `<`/`>` (longest match), so the scanner checks this
-- before is_one_byte_op below.
func is_shift_op_start(c):
    return c == '<' or c == '>'
end

func is_one_byte_op(c):
    return c == '=' or c == '+' or c == '-' or c == '*' or c == '/' or c == '%' or c == '<' or c == '>' or c == '&' or c == '|' or c == '^' or c == '~'
end

func end_of_ident(src, i, n):
    if i >= n:
        return i
    elif is_ident_cont(index(src, i)):
        return end_of_ident(src, i + 1, n)
    else:
        return i
    end
end

func end_of_int(src, i, n):
    if i >= n:
        return i
    elif is_digit(index(src, i)):
        return end_of_int(src, i + 1, n)
    else:
        return i
    end
end

func end_of_line(src, i, n):
    if i >= n:
        return i
    elif index(src, i) == '\n':
        return i
    else:
        return end_of_line(src, i + 1, n)
    end
end

func end_of_string(src, i, n):
    let c = index(src, i)
    if c == '"':
        return i + 1
    elif c == '\\':
        return end_of_string(src, i + 2, n)
    else:
        return end_of_string(src, i + 1, n)
    end
end

func end_of_char(src, i, n):
    if index(src, i) == '\\':
        return i + 3
    else:
        return i + 2
    end
end

func pour(src, from, to, b):
    if from >= to:
        return b
    else:
        do append(b, index(src, from))
        return pour(src, from + 1, to, b)
    end
end

func slice_text(src, from, to):
    return freeze(pour(src, from, to, new_buffer()))
end

func scan(src, i, n, line, out):
    if i >= n:
        return out
    end
    let c = index(src, i)
    if is_ws(c):
        if c == '\n':
            return scan(src, i + 1, n, line + 1, out)
        end
        return scan(src, i + 1, n, line, out)
    elif c == '-' and i + 1 < n and index(src, i + 1) == '-':
        return scan(src, end_of_line(src, i + 2, n), n, line, out)
    elif is_ident_start(c):
        let j = end_of_ident(src, i + 1, n)
        do add(out, (0, slice_text(src, i, j), line))
        return scan(src, j, n, line, out)
    elif is_digit(c):
        let j = end_of_int(src, i + 1, n)
        do add(out, (1, slice_text(src, i, j), line))
        return scan(src, j, n, line, out)
    elif c == '"':
        let j = end_of_string(src, i + 1, n)
        do add(out, (2, slice_text(src, i, j), line))
        return scan(src, j, n, line, out)
    elif c == '\'':
        let j = end_of_char(src, i + 1, n)
        do add(out, (3, slice_text(src, i, j), line))
        return scan(src, j, n, line, out)
    elif is_two_byte_op_start(c) and i + 1 < n and index(src, i + 1) == '=':
        do add(out, (5, slice_text(src, i, i + 2), line))
        return scan(src, i + 2, n, line, out)
    elif is_shift_op_start(c) and i + 1 < n and index(src, i + 1) == c:
        do add(out, (5, slice_text(src, i, i + 2), line))
        return scan(src, i + 2, n, line, out)
    elif is_one_byte_op(c):
        do add(out, (5, slice_text(src, i, i + 1), line))
        return scan(src, i + 1, n, line, out)
    else:
        do add(out, (4, slice_text(src, i, i + 1), line))
        return scan(src, i + 1, n, line, out)
    end
end

func lex_source(src):
    return scan(src, 0, length(src), 1, new_array((int, string, int)))
end

-- ====================================================================
-- DECIMAL CONVERSION (no */% in Herbert; build div10/mod10 by subtraction)
-- ====================================================================

func div10_acc(n, q):
    if n < 10:
        return q
    end
    return div10_acc(n - 10, q + 1)
end

func div10(n):
    return div10_acc(n, 0)
end

func mod10(n):
    if n < 10:
        return n
    end
    return mod10(n - 10)
end

-- Append decimal digits of n to buf, high-order first. Recursive on
-- div10(n); not a true tail call but the interpreter's heap-stack
-- model has no fixed depth ceiling.
func emit_decimal(buf, n):
    if n >= 10:
        buf = emit_decimal(buf, div10(n))
    end
    do append(buf, 48 + mod10(n))
    return buf
end

func int_to_str(n):
    return freeze(emit_decimal(new_buffer(), n))
end

-- ====================================================================
-- STRING / BUFFER HELPERS
-- ====================================================================

func append_str_loop(buf, s, i, n):
    if i >= n:
        return buf
    end
    do append(buf, index(s, i))
    return append_str_loop(buf, s, i + 1, n)
end

func append_str(buf, s):
    return append_str_loop(buf, s, 0, length(s))
end

-- ====================================================================
-- AST NODE POOL
-- ====================================================================

func pool_new():
    return new_array((string, array(string), array(int), int))
end

func add_node(pool, tag, atoms, kids, line):
    do add(pool, (tag, atoms, kids, line))
    return count(pool) - 1
end

func atoms0():
    return new_array(string)
end

func atoms1(s):
    let a = new_array(string)
    do add(a, s)
    return a
end

func kids0():
    return new_array(int)
end

func kids1(i):
    let a = new_array(int)
    do add(a, i)
    return a
end

func kids2(a, b):
    let r = new_array(int)
    do add(r, a)
    do add(r, b)
    return r
end

func make_binop(pool, tag, lidx, ridx, line):
    return add_node(pool, tag, atoms0(), kids2(lidx, ridx), line)
end

-- ====================================================================
-- CHAR / STRING LITERAL DECODING
-- ====================================================================

-- s is the raw lexed CHAR text, e.g. "'a'" or "'\\n'" — three or four
-- bytes including the surrounding single quotes. Returns the byte value.
func decode_char(s):
    let c1 = index(s, 1)
    if c1 == '\\':
        let c2 = index(s, 2)
        if c2 == 'n':
            return 10
        end
        if c2 == '\\':
            return 92
        end
        return 39
    end
    return c1
end

-- s is the raw lexed STRING text including the surrounding double quotes.
-- Walk s[1 .. length(s)-1) decoding \n \\ \" into a buffer; returns the
-- frozen byte string.
func decode_string_loop(s, i, end_i, buf):
    if i >= end_i:
        return buf
    end
    let c = index(s, i)
    if c == '\\':
        let c2 = index(s, i + 1)
        if c2 == 'n':
            do append(buf, 10)
            return decode_string_loop(s, i + 2, end_i, buf)
        end
        if c2 == '\\':
            do append(buf, 92)
            return decode_string_loop(s, i + 2, end_i, buf)
        end
        do append(buf, 34)
        return decode_string_loop(s, i + 2, end_i, buf)
    end
    do append(buf, c)
    return decode_string_loop(s, i + 1, end_i, buf)
end

func decode_string(s):
    return freeze(decode_string_loop(s, 1, length(s) - 1, new_buffer()))
end

-- Append decimal forms of each byte of `bytes` (a string) as a fresh
-- entry in the `atoms` array.
func collect_str_atoms(atoms, bytes, i, n):
    if i >= n:
        return atoms
    end
    do add(atoms, int_to_str(index(bytes, i)))
    return collect_str_atoms(atoms, bytes, i + 1, n)
end

-- Large literals reuse the immutable decimal strings for all 256 byte values.
-- Keep the same AST atoms while avoiding one new decimal buffer per byte.
func byte_decimal_strings_loop(out, i):
    if i >= 256:
        return out
    end
    do add(out, int_to_str(i))
    return byte_decimal_strings_loop(out, i + 1)
end

func collect_str_atoms_cached(atoms, bytes, i, n, cache):
    if i >= n:
        return atoms
    end
    do add(atoms, get(cache, index(bytes, i)))
    return collect_str_atoms_cached(atoms, bytes, i + 1, n, cache)
end

-- ====================================================================
-- TOKEN INSPECTION
-- ====================================================================

func tok_is_ident_text(tokens, pos, text):
    if pos >= count(tokens):
        return false
    end
    let t = get(tokens, pos)
    return t.0 == 0 and equal(t.1, text)
end

func tok_is_punct_text(tokens, pos, text):
    if pos >= count(tokens):
        return false
    end
    let t = get(tokens, pos)
    return t.0 == 4 and equal(t.1, text)
end

func tok_is_op_text(tokens, pos, text):
    if pos >= count(tokens):
        return false
    end
    let t = get(tokens, pos)
    return t.0 == 5 and equal(t.1, text)
end

-- ====================================================================
-- TYPE EXPRESSIONS (only inside new_array(...))
-- ====================================================================

func parse_type(tokens, pos, pool):
    let t = get(tokens, pos)
    let ln = t.2
    if t.0 == 0:
        if equal(t.1, "array"):
            -- array ( TYPE )
            pos = pos + 2
            let r = parse_type(tokens, pos, pool)
            pos = r.1 + 1
            return (add_node(pool, "type-array", atoms0(), kids1(r.0), ln), pos)
        end
        return (add_node(pool, "type", atoms1(t.1), kids0(), ln), pos + 1)
    end
    -- LPAREN starts a tuple type
    pos = pos + 1
    let kids = new_array(int)
    let r = parse_type(tokens, pos, pool)
    do add(kids, r.0)
    pos = parse_type_tail(tokens, r.1, pool, kids)
    pos = pos + 1
    return (add_node(pool, "type-tuple", atoms0(), kids, ln), pos)
end

func parse_type_tail(tokens, pos, pool, kids):
    if tok_is_punct_text(tokens, pos, ","):
        let r = parse_type(tokens, pos + 1, pool)
        do add(kids, r.0)
        return parse_type_tail(tokens, r.1, pool, kids)
    end
    return pos
end

-- ====================================================================
-- EXPRESSIONS
-- ====================================================================

func parse_expr(tokens, pos, pool):
    return parse_bitwise(tokens, pos, pool)
end

-- Bitwise/shift level (settled precedence c). Sits above the classless ladder:
-- parse a classless expression; if a bitwise/shift operator follows, the left
-- operand must be a single parenthesised/atomic primary (not a bare classless
-- chain) and the whole chain must stay within one class. A mix plants an
-- `nc_class_mix` poison node that nc_verify_ast rejects with ERR 442. This makes
-- `a & b | c`, `a << 2 + 3`, `x & 1 == 0`, and `1 + 2 << 1` all reject while
-- their fully-parenthesised forms parse. The existing ladder is unchanged.

-- Plant the `nc_class_mix` poison node and STOP the parser cleanly. The node is
-- added to the pool (so the post-parse all-functions scan in nc_verify_ast finds
-- it and rejects with ERR 442, regardless of reachability), and the returned
-- position is end-of-input so the enclosing body/func/program parse terminates
-- immediately instead of misparsing the leftover tokens (which, in a function
-- followed by more `func`s, runs parse_atom off the token stream -> a `get: out
-- of range` crash). A class-mix is always a reject, so discarding any trailing
-- tokens is correct -- the program will be rejected whole.
func plant_class_mix(tokens, pool, line):
    return (add_node(pool, "nc_class_mix", atoms0(), kids0(), line), count(tokens))
end

func parse_bitwise(tokens, pos, pool):
    -- Retain the first primary's endpoint while completing the same classless
    -- ladder. Re-parsing it duplicates every nested left bitwise subtree.
    let primary = parse_not(tokens, pos, pool)
    let r = parse_mul_loop(tokens, primary.1, pool, primary.0)
    r = parse_add_loop(tokens, r.1, pool, r.0)
    r = parse_cmp_loop(tokens, r.1, pool, r.0)
    r = parse_and_loop(tokens, r.1, pool, r.0)
    r = parse_or_loop(tokens, r.1, pool, r.0)
    let cls = 0
    if r.1 < count(tokens):
        cls = bit_class(get(tokens, r.1).1)
        if get(tokens, r.1).0 != 5:
            cls = 0
        end
    end
    if cls == 0:
        return r
    end
    -- A bitwise/shift op follows. A different endpoint means the ladder consumed
    -- an unparenthesised classless operator after the primary -> mix.
    if primary.1 != r.1:
        return plant_class_mix(tokens, pool, get(tokens, r.1).2)
    end
    return parse_bitwise_loop(tokens, r.1, pool, r.0, cls)
end

func parse_bitwise_loop(tokens, pos, pool, lidx, cls):
    let oc = bin_op_class(tokens, pos)
    if oc == 0:
        -- End of the expression (`)`, `,`, `:`, `.`, `end`, EOF, ...).
        return (lidx, pos)
    end
    if oc == 5:
        -- A classless binary op after a committed bitwise chain: mix.
        return plant_class_mix(tokens, pool, get(tokens, pos).2)
    end
    if oc != cls:
        -- A different bitwise class without parentheses: mix.
        return plant_class_mix(tokens, pool, get(tokens, pos).2)
    end
    let op_tok = get(tokens, pos)
    let r = parse_not(tokens, pos + 1, pool)
    return parse_bitwise_loop(tokens, r.1, pool, make_binop(pool, bit_tag(op_tok.1), lidx, r.0, op_tok.2), cls)
end

func parse_or_loop(tokens, pos, pool, lidx):
    if tok_is_ident_text(tokens, pos, "or"):
        let op_tok = get(tokens, pos)
        let r = parse_and(tokens, pos + 1, pool)
        return parse_or_loop(tokens, r.1, pool, make_binop(pool, "or", lidx, r.0, op_tok.2))
    end
    return (lidx, pos)
end

func parse_and(tokens, pos, pool):
    let r = parse_cmp(tokens, pos, pool)
    return parse_and_loop(tokens, r.1, pool, r.0)
end

func parse_and_loop(tokens, pos, pool, lidx):
    if tok_is_ident_text(tokens, pos, "and"):
        let op_tok = get(tokens, pos)
        let r = parse_cmp(tokens, pos + 1, pool)
        return parse_and_loop(tokens, r.1, pool, make_binop(pool, "and", lidx, r.0, op_tok.2))
    end
    return (lidx, pos)
end

func cmp_tag(text):
    if equal(text, "=="):
        return "eq"
    end
    if equal(text, "!="):
        return "ne"
    end
    if equal(text, "<"):
        return "lt"
    end
    if equal(text, ">"):
        return "gt"
    end
    if equal(text, "<="):
        return "le"
    end
    if equal(text, ">="):
        return "ge"
    end
    return ""
end

func parse_cmp(tokens, pos, pool):
    let r = parse_add(tokens, pos, pool)
    return parse_cmp_loop(tokens, r.1, pool, r.0)
end

func parse_cmp_loop(tokens, pos, pool, lidx):
    if pos >= count(tokens):
        return (lidx, pos)
    end
    let t = get(tokens, pos)
    if t.0 == 5:
        let tag = cmp_tag(t.1)
        if not equal(tag, ""):
            let r = parse_add(tokens, pos + 1, pool)
            return parse_cmp_loop(tokens, r.1, pool, make_binop(pool, tag, lidx, r.0, t.2))
        end
    end
    return (lidx, pos)
end

func add_tag(text):
    if equal(text, "+"):
        return "add"
    end
    if equal(text, "-"):
        return "sub"
    end
    return ""
end

-- Multiplicative operator -> AST tag. `*` `/` `%` bind tighter than `+ -`. They
-- are ordinary arithmetic (same operator class as add/sub), so no class-mix
-- poison applies to them; they just join the arithmetic ladder a tier tighter.
func mul_tag(text):
    if equal(text, "*"):
        return "mul"
    end
    if equal(text, "/"):
        return "div"
    end
    if equal(text, "%"):
        return "mod"
    end
    return ""
end

-- The bitwise/shift operators split into mutually-exclusive classes:
-- 1 = AND (&), 2 = OR (|), 3 = XOR (^), 4 = SHIFT (<< >>). 0 = not a
-- bitwise/shift op. Mirrors the C bootstrap's bit_class. Same-class chaining is
-- allowed and left-associative; mixing classes (or mixing with the classless
-- ladder) without parentheses is a parse-time reject (settled precedence c).
func bit_class(text):
    if equal(text, "&"):
        return 1
    end
    if equal(text, "|"):
        return 2
    end
    if equal(text, "^"):
        return 3
    end
    if equal(text, "<<"):
        return 4
    end
    if equal(text, ">>"):
        return 4
    end
    return 0
end

-- AST tag for a bitwise/shift operator token (only called when bit_class != 0).
func bit_tag(text):
    if equal(text, "&"):
        return "band"
    end
    if equal(text, "|"):
        return "bor"
    end
    if equal(text, "^"):
        return "bxor"
    end
    if equal(text, "<<"):
        return "shl"
    end
    return "shr"
end

-- Class id of the binary operator token at `pos` (kind-5 op or `and`/`or`
-- ident), for the require-parens mix check. Returns:
--   0  not a binary operator (ends the expression: ) , : . end EOF etc.)
--   1..4  a bitwise/shift class (see bit_class)
--   5  a classless binary op (+ - cmp and or) -- mixing one of these with a
--      committed bitwise chain (without parens) is a reject.
func bin_op_class(tokens, pos):
    if pos >= count(tokens):
        return 0
    end
    let t = get(tokens, pos)
    if t.0 == 0:
        if equal(t.1, "and") or equal(t.1, "or"):
            return 5
        end
        return 0
    end
    if t.0 != 5:
        return 0
    end
    let bc = bit_class(t.1)
    if bc != 0:
        return bc
    end
    if not equal(add_tag(t.1), ""):
        return 5
    end
    if not equal(mul_tag(t.1), ""):
        return 5
    end
    if not equal(cmp_tag(t.1), ""):
        return 5
    end
    return 0
end

func parse_add(tokens, pos, pool):
    let r = parse_mul(tokens, pos, pool)
    return parse_add_loop(tokens, r.1, pool, r.0)
end

func parse_add_loop(tokens, pos, pool, lidx):
    if pos >= count(tokens):
        return (lidx, pos)
    end
    let t = get(tokens, pos)
    if t.0 == 5:
        let tag = add_tag(t.1)
        if not equal(tag, ""):
            let r = parse_mul(tokens, pos + 1, pool)
            return parse_add_loop(tokens, r.1, pool, make_binop(pool, tag, lidx, r.0, t.2))
        end
    end
    return (lidx, pos)
end

-- Multiplicative tier (`*` `/` `%`): one precedence level tighter than additive
-- `+ -`, looser than the prefix-unary level (parse_not). Left-associative.
-- Mirrors parse_add, calling parse_not for its operands.
func parse_mul(tokens, pos, pool):
    let r = parse_not(tokens, pos, pool)
    return parse_mul_loop(tokens, r.1, pool, r.0)
end

func parse_mul_loop(tokens, pos, pool, lidx):
    if pos >= count(tokens):
        return (lidx, pos)
    end
    let t = get(tokens, pos)
    if t.0 == 5:
        let tag = mul_tag(t.1)
        if not equal(tag, ""):
            let r = parse_not(tokens, pos + 1, pool)
            return parse_mul_loop(tokens, r.1, pool, make_binop(pool, tag, lidx, r.0, t.2))
        end
    end
    return (lidx, pos)
end

func parse_not(tokens, pos, pool):
    if tok_is_ident_text(tokens, pos, "not"):
        let t = get(tokens, pos)
        let r = parse_not(tokens, pos + 1, pool)
        return (add_node(pool, "not", atoms0(), kids1(r.0), t.2), r.1)
    end
    -- `~` is the bitwise one's-complement unary: a distinct AST kind ("bnot")
    -- from boolean `not`, with an int (not bool) type rule, at the same prefix
    -- precedence level.
    if tok_is_op_text(tokens, pos, "~"):
        let t = get(tokens, pos)
        let r = parse_not(tokens, pos + 1, pool)
        return (add_node(pool, "bnot", atoms0(), kids1(r.0), t.2), r.1)
    end
    return parse_dot(tokens, pos, pool)
end

func parse_dot(tokens, pos, pool):
    let r = parse_atom(tokens, pos, pool)
    return parse_dot_loop(tokens, r.1, pool, r.0)
end

func parse_dot_loop(tokens, pos, pool, lidx):
    if tok_is_punct_text(tokens, pos, "."):
        let dot_tok = get(tokens, pos)
        let idx_tok = get(tokens, pos + 1)
        let new_idx = add_node(pool, "dot", atoms1(idx_tok.1), kids1(lidx), dot_tok.2)
        return parse_dot_loop(tokens, pos + 2, pool, new_idx)
    end
    return (lidx, pos)
end

func parse_atom(tokens, pos, pool):
    let t = get(tokens, pos)
    let k = t.0
    let s = t.1
    let ln = t.2
    if k == 1:
        return (add_node(pool, "int", atoms1(s), kids0(), ln), pos + 1)
    end
    if k == 3:
        return (add_node(pool, "char", atoms1(int_to_str(decode_char(s))), kids0(), ln), pos + 1)
    end
    if k == 2:
        let frozen = decode_string(s)
        let n = length(frozen)
        let atoms = atoms1(int_to_str(n))
        if n >= 1024:
            let cache = byte_decimal_strings_loop(new_array(string), 0)
            atoms = collect_str_atoms_cached(atoms, frozen, 0, n, cache)
        else:
            atoms = collect_str_atoms(atoms, frozen, 0, n)
        end
        return (add_node(pool, "str", atoms, kids0(), ln), pos + 1)
    end
    if k == 0:
        if equal(s, "true"):
            return (add_node(pool, "bool", atoms1("true"), kids0(), ln), pos + 1)
        end
        if equal(s, "false"):
            return (add_node(pool, "bool", atoms1("false"), kids0(), ln), pos + 1)
        end
        if tok_is_punct_text(tokens, pos + 1, "("):
            return parse_call(tokens, pos, pool)
        end
        return (add_node(pool, "name", atoms1(s), kids0(), ln), pos + 1)
    end
    -- LPAREN: grouping or tuple
    return parse_group_or_tuple(tokens, pos + 1, pool, ln)
end

func parse_call(tokens, pos, pool):
    let name_tok = get(tokens, pos)
    let name = name_tok.1
    let ln = name_tok.2
    pos = pos + 2
    if equal(name, "new_array"):
        let r = parse_type(tokens, pos, pool)
        pos = r.1 + 1
        return (add_node(pool, "call", atoms1(name), kids1(r.0), ln), pos)
    end
    let kids = new_array(int)
    if tok_is_punct_text(tokens, pos, ")"):
        return (add_node(pool, "call", atoms1(name), kids, ln), pos + 1)
    end
    pos = parse_args_loop(tokens, pos, pool, kids)
    pos = pos + 1
    return (add_node(pool, "call", atoms1(name), kids, ln), pos)
end

func parse_args_loop(tokens, pos, pool, kids):
    let r = parse_expr(tokens, pos, pool)
    do add(kids, r.0)
    if tok_is_punct_text(tokens, r.1, ","):
        return parse_args_loop(tokens, r.1 + 1, pool, kids)
    end
    return r.1
end

func parse_group_or_tuple(tokens, pos, pool, line):
    let r = parse_expr(tokens, pos, pool)
    let first_idx = r.0
    pos = r.1
    if tok_is_punct_text(tokens, pos, ","):
        let kids = new_array(int)
        do add(kids, first_idx)
        pos = parse_tuple_tail(tokens, pos + 1, pool, kids)
        pos = pos + 1
        return (add_node(pool, "tuple", atoms0(), kids, line), pos)
    end
    pos = pos + 1
    return (first_idx, pos)
end

func parse_tuple_tail(tokens, pos, pool, kids):
    let r = parse_expr(tokens, pos, pool)
    do add(kids, r.0)
    if tok_is_punct_text(tokens, r.1, ","):
        return parse_tuple_tail(tokens, r.1 + 1, pool, kids)
    end
    return r.1
end

-- ====================================================================
-- STATEMENTS
-- ====================================================================

func is_body_terminator(tokens, pos):
    if pos >= count(tokens):
        return true
    end
    let t = get(tokens, pos)
    if t.0 != 0:
        return false
    end
    if equal(t.1, "end"):
        return true
    end
    if equal(t.1, "elif"):
        return true
    end
    if equal(t.1, "else"):
        return true
    end
    return false
end

func parse_body(tokens, pos, pool):
    let stmt_kids = new_array(int)
    pos = parse_body_loop(tokens, pos, pool, stmt_kids)
    let line = 0
    if pos < count(tokens):
        let t = get(tokens, pos)
        line = t.2
    end
    return (add_node(pool, "body", atoms0(), stmt_kids, line), pos)
end

func parse_body_loop(tokens, pos, pool, stmt_kids):
    if is_body_terminator(tokens, pos):
        return pos
    end
    let r = parse_stmt(tokens, pos, pool)
    do add(stmt_kids, r.0)
    return parse_body_loop(tokens, r.1, pool, stmt_kids)
end

func parse_stmt(tokens, pos, pool):
    let t = get(tokens, pos)
    -- t is IDENTIFIER per grammar
    let text = t.1
    let ln = t.2
    if equal(text, "let"):
        return parse_let(tokens, pos + 1, pool, ln)
    end
    if equal(text, "return"):
        return parse_return(tokens, pos + 1, pool, ln)
    end
    if equal(text, "do"):
        return parse_do(tokens, pos + 1, pool, ln)
    end
    if equal(text, "if"):
        return parse_if(tokens, pos + 1, pool, ln)
    end
    if equal(text, "while"):
        return parse_while(tokens, pos + 1, pool, ln)
    end
    return parse_assign(tokens, pos, pool, ln)
end

func parse_let(tokens, pos, pool, line):
    let name_tok = get(tokens, pos)
    let name = name_tok.1
    let r = parse_expr(tokens, pos + 2, pool)
    return (add_node(pool, "let", atoms1(name), kids1(r.0), line), r.1)
end

func parse_return(tokens, pos, pool, line):
    let r = parse_expr(tokens, pos, pool)
    return (add_node(pool, "return", atoms0(), kids1(r.0), line), r.1)
end

func parse_do(tokens, pos, pool, line):
    let r = parse_expr(tokens, pos, pool)
    return (add_node(pool, "do", atoms0(), kids1(r.0), line), r.1)
end

func parse_assign(tokens, pos, pool, line):
    let name_tok = get(tokens, pos)
    let name = name_tok.1
    if tok_is_punct_text(tokens, pos + 1, "."):
        let field_atoms = new_array(string)
        do add(field_atoms, name)
        do add(field_atoms, get(tokens, pos + 2).1)
        let fr = parse_expr(tokens, pos + 4, pool)
        return (add_node(pool, "field-assign", field_atoms, kids1(fr.0), line), fr.1)
    end
    let r = parse_expr(tokens, pos + 2, pool)
    return (add_node(pool, "assign", atoms1(name), kids1(r.0), line), r.1)
end

func parse_if(tokens, pos, pool, line):
    let if_kids = new_array(int)
    pos = parse_clause_into(tokens, pos, pool, if_kids)
    pos = parse_elifs(tokens, pos, pool, if_kids)
    if tok_is_ident_text(tokens, pos, "else"):
        let r = parse_else_clause(tokens, pos + 1, pool)
        do add(if_kids, r.0)
        pos = r.1
    end
    -- consume "end"
    pos = pos + 1
    return (add_node(pool, "if", atoms0(), if_kids, line), pos)
end

-- while EXPR ':' body 'end': kids are the condition and the body. The
-- structural pass has already required the colon, a statement and the end.
func parse_while(tokens, pos, pool, line):
    let cr = parse_expr(tokens, pos, pool)
    let br = parse_body(tokens, cr.1 + 1, pool)
    -- consume "end"
    return (add_node(pool, "while", atoms0(), kids2(cr.0, br.0), line), br.1 + 1)
end

func parse_elifs(tokens, pos, pool, if_kids):
    if tok_is_ident_text(tokens, pos, "elif"):
        pos = parse_clause_into(tokens, pos + 1, pool, if_kids)
        return parse_elifs(tokens, pos, pool, if_kids)
    end
    return pos
end

-- Safe token line lookup: the token's line, or 0 if pos is out of range. Used on
-- error-recovery paths where a class-mix has made parse_expr stop at end-of-input
-- (plant_class_mix), so `pos` can sit past the last token; a bare get(tokens, pos)
-- would then fault. The line is only cosmetic here (the program is rejected via
-- the nc_class_mix scan), so 0 is fine.
func tok_line_or0(tokens, pos):
    if pos >= count(tokens):
        return 0
    end
    return get(tokens, pos).2
end

func parse_clause_into(tokens, pos, pool, if_kids):
    let cr = parse_expr(tokens, pos, pool)
    pos = cr.1 + 1
    let br = parse_body(tokens, pos, pool)
    let cidx = add_node(pool, "clause", atoms0(), kids2(cr.0, br.0), tok_line_or0(tokens, pos))
    do add(if_kids, cidx)
    return br.1
end

func parse_else_clause(tokens, pos, pool):
    -- pos is just after 'else'; consume ':'
    let line = get(tokens, pos - 1).2
    pos = pos + 1
    let br = parse_body(tokens, pos, pool)
    return (add_node(pool, "else", atoms0(), kids1(br.0), line), br.1)
end

-- ====================================================================
-- FUNCTIONS / PROGRAM
-- ====================================================================

-- The program node's kids are its functions; its atoms are the pool indices of
-- its record declarations, in decimal (none in a program without records).
func parse_program(tokens, pos, pool):
    let kids = new_array(int)
    let recs = new_array(string)
    pos = parse_funcs(tokens, pos, pool, kids, recs)
    let line = 0
    if count(tokens) > 0:
        line = get(tokens, 0).2
    end
    return (add_node(pool, "program", recs, kids, line), pos)
end

func parse_funcs(tokens, pos, pool, kids, recs):
    if pos >= count(tokens):
        return pos
    end
    if err_is_ref_record_head(tokens, pos):
        let rf = parse_recorddef(tokens, pos + 1, pool, "ref-record")
        do add(recs, int_to_str(rf.0))
        return parse_funcs(tokens, rf.1, pool, kids, recs)
    end
    if err_is_record_head(tokens, pos):
        let rr = parse_recorddef(tokens, pos, pool, "record")
        do add(recs, int_to_str(rr.0))
        return parse_funcs(tokens, rr.1, pool, kids, recs)
    end
    let r = parse_funcdef(tokens, pos, pool)
    do add(kids, r.0)
    return parse_funcs(tokens, r.1, pool, kids, recs)
end

-- record NAME: FIELD: TYPE ... end -> ("record", [NAME, FIELD...], [type...]);
-- ref record NAME: ... end is the same node tagged "ref-record".
func parse_record_fields(tokens, pos, pool, atoms, kids):
    if tok_is_ident_text(tokens, pos, "end"):
        return pos + 1
    end
    do add(atoms, get(tokens, pos).1)
    let r = parse_type(tokens, pos + 2, pool)
    do add(kids, r.0)
    return parse_record_fields(tokens, r.1, pool, atoms, kids)
end

func parse_recorddef(tokens, pos, pool, tag):
    let line = get(tokens, pos).2
    let atoms = new_array(string)
    do add(atoms, get(tokens, pos + 1).1)
    let kids = new_array(int)
    pos = parse_record_fields(tokens, pos + 3, pool, atoms, kids)
    return (add_node(pool, tag, atoms, kids, line), pos)
end

func is_record_decl_tag(tag):
    return equal(tag, "record") or equal(tag, "ref-record")
end

-- Constructors parse as calls. In a program that declares records, every call
-- whose callee is a record becomes "record-new", so no call walker sees one.
func record_decl_names_loop(nodes, recs, i, names):
    if i >= count(recs):
        return names
    end
    let decl = get(nodes, parse_decimal(get(recs, i)))
    do add(names, get(decl.1, 0))
    return record_decl_names_loop(nodes, recs, i + 1, names)
end

func record_decl_names(nodes, prog_idx):
    return record_decl_names_loop(nodes, get(nodes, prog_idx).1, 0, new_array(string))
end

func retag_record_calls_loop(nodes, names, out, i):
    if i >= count(nodes):
        return out
    end
    let node = get(nodes, i)
    if equal(node.0, "call") and err_name_seen(names, get(node.1, 0)):
        do add(out, ("record-new", node.1, node.2, node.3))
        return retag_record_calls_loop(nodes, names, out, i + 1)
    end
    do add(out, node)
    return retag_record_calls_loop(nodes, names, out, i + 1)
end

func retag_record_calls(nodes, prog_idx):
    if count(get(nodes, prog_idx).1) == 0:
        return nodes
    end
    return retag_record_calls_loop(nodes, record_decl_names(nodes, prog_idx), pool_new(), 0)
end

-- A statement call: `do CALL(...)` whose callee is not a void builtin means
-- `let NAME = CALL(...)` with a NAME no source can spell, so the result is
-- discarded and every later stage sees an ordinary let. Runs after
-- retag_record_calls, so a record construction stays "record-new" (ERR 448).
func do_call_needs_let(nodes, node):
    if not equal(node.0, "do"):
        return false
    end
    let call = get(nodes, get(node.2, 0))
    return equal(call.0, "call") and not err_is_void_builtin(get(call.1, 0))
end

func do_calls_any(nodes, i):
    if i >= count(nodes):
        return false
    end
    if do_call_needs_let(nodes, get(nodes, i)):
        return true
    end
    return do_calls_any(nodes, i + 1)
end

func retag_do_calls_loop(nodes, out, i):
    if i >= count(nodes):
        return out
    end
    let node = get(nodes, i)
    if do_call_needs_let(nodes, node):
        let name = freeze(emit_decimal(append_str(new_buffer(), "do "), i))
        do add(out, ("let", atoms1(name), node.2, node.3))
        return retag_do_calls_loop(nodes, out, i + 1)
    end
    do add(out, node)
    return retag_do_calls_loop(nodes, out, i + 1)
end

func retag_do_calls(nodes):
    if not do_calls_any(nodes, 0):
        return nodes
    end
    return retag_do_calls_loop(nodes, pool_new(), 0)
end

func parse_funcdef(tokens, pos, pool):
    -- tokens[pos+0]: "func"; pos+1: name; pos+2: "("
    let line = get(tokens, pos).2
    let name_tok = get(tokens, pos + 1)
    let name = name_tok.1
    pos = pos + 3
    let pr = parse_param_list(tokens, pos, pool)
    pos = pr.1 + 2
    let br = parse_body(tokens, pos, pool)
    pos = br.1 + 1
    let kids = kids2(pr.0, br.0)
    return (add_node(pool, "func", atoms1(name), kids, line), pos)
end

func parse_param_list(tokens, pos, pool):
    let atoms = new_array(string)
    let line = get(tokens, pos).2
    if tok_is_punct_text(tokens, pos, ")"):
        return (add_node(pool, "params", atoms, kids0(), line), pos)
    end
    pos = parse_param_loop(tokens, pos, atoms)
    return (add_node(pool, "params", atoms, kids0(), line), pos)
end

func parse_param_loop(tokens, pos, atoms):
    let t = get(tokens, pos)
    do add(atoms, t.1)
    if tok_is_punct_text(tokens, pos + 1, ","):
        return parse_param_loop(tokens, pos + 2, atoms)
    end
    return pos + 1
end

-- ====================================================================
-- SERIALIZER
-- ====================================================================

func emit_atoms(buf, atoms, i, n):
    if i >= n:
        return buf
    end
    do append(buf, ' ')
    buf = append_str(buf, get(atoms, i))
    return emit_atoms(buf, atoms, i + 1, n)
end

-- ====================================================================
-- AST-DUMP MODE (parser-equivalence altimeter)
--
-- When the source's first line is the directive `-- emit: ast-dump`, the
-- backend lexes and parses with the SAME production front end it compiles
-- with (lex_source + parse_program), then serializes the raw parse tree
-- with `ser_dump` and writes it to stdout. No verify, no lower,
-- no emit -- this is the parser's own tree, observable for the first time.
-- It exists so an independent C AST-dumper (built from bootstrap/parse.c
-- structs) can be diffed against the PRODUCTION parser over a corpus while
-- the C bootstrap still exists (the pre-switchover parser altimeter), and
-- so gen-1 can dump that tree NATIVELY (removing C from the dump path).
-- ====================================================================

func nc_is_ast_dump(source):
    let marker = "-- emit: ast-dump"
    let mlen = length(marker)
    if not nc_mb_marker_match(source, marker, 0, mlen):
        return false
    end
    if length(source) <= mlen:
        return false
    end
    return index(source, mlen) == 10
end

-- Dump serializer. It canonicalizes the "char" tag to "int". A Herbert char literal IS an int value (byte_codepoint); the C
-- bootstrap's lexer stores char literals as TOK_INT_LIT, so parse.c yields an
-- E_INT node with no char provenance. Canonicalizing only the TAG (never the
-- value atom) makes the parser-structure comparison meaningful while STILL
-- surfacing any real value/structure divergence (the value atom is untouched).
func ser_dump(buf, pool, idx):
    let node = get(pool, idx)
    let tag = node.0
    let atoms = node.1
    let kids = node.2
    do append(buf, '(')
    if equal(tag, "char"):
        buf = append_str(buf, "int")
    else:
        buf = append_str(buf, tag)
    end
    if equal(tag, "dot"):
        buf = emit_kids_dump(buf, pool, kids, 0, count(kids))
        buf = emit_atoms(buf, atoms, 0, count(atoms))
    elif equal(tag, "program"):
        buf = emit_record_dumps(buf, pool, atoms, 0)
        buf = emit_kids_dump(buf, pool, kids, 0, count(kids))
    else:
        buf = emit_atoms(buf, atoms, 0, count(atoms))
        buf = emit_kids_dump(buf, pool, kids, 0, count(kids))
    end
    do append(buf, ')')
    return buf
end

-- The program node's atoms index its record declarations; dump them as trees.
func emit_record_dumps(buf, pool, recs, i):
    if i >= count(recs):
        return buf
    end
    do append(buf, ' ')
    buf = ser_dump(buf, pool, parse_decimal(get(recs, i)))
    return emit_record_dumps(buf, pool, recs, i + 1)
end

func emit_kids_dump(buf, pool, kids, i, n):
    if i >= n:
        return buf
    end
    do append(buf, ' ')
    buf = ser_dump(buf, pool, get(kids, i))
    return emit_kids_dump(buf, pool, kids, i + 1, n)
end

-- Validate `source` with the checked lexer and parser before an emit route
-- builds its tree with the unchecked ones (the hosted path in routes.herb does
-- the same before parse_program). On failure, report the located diagnostic
-- the hosted path reports and exit 1. On success the route lexes and parses
-- exactly as before, so an accepted program's tree and image do not change.
func nc_check_source(source):
    let lexed = err_lex_source(source)
    if lexed.0 == err_err_tag():
        do stderr_write(serialize_diagnostic(lexed.1))
        do stderr_write("\n")
        do process_exit(1)
        return 0
    end
    let structure = err_parse_program(lexed.2, lexed.3)
    if structure.0 == err_err_tag():
        do stderr_write(serialize_diagnostic(structure.1))
        do stderr_write("\n")
        do process_exit(1)
        return 0
    end
    return 0
end

func nc_emit_ast_dump_program(source):
    do nc_check_source(source)
    let tokens = lex_source(source)
    let parsed_nodes = pool_new()
    let parsed = parse_program(tokens, 0, parsed_nodes)
    let nodes = retag_record_calls(parsed_nodes, parsed.0)
    let buf = new_buffer()
    buf = ser_dump(buf, nodes, parsed.0)
    do flogger(freeze(buf))
    do flogger("\n")
    return 0
end

-- ====================================================================
-- EMITTER
-- ====================================================================

func fault(msg):
    let a = new_array((int, int))
    return get(a, 0)
end

func times10(n):
    return n + n + n + n + n + n + n + n + n + n
end

func parse_decimal_loop(s, i, n, acc):
    if i >= n:
        return acc
    end
    return parse_decimal_loop(s, i + 1, n, times10(acc) + index(s, i) - '0')
end

func parse_decimal(s):
    return parse_decimal_loop(s, 0, length(s), 0)
end

func op_push_int():
    return 0
end

func op_push_bool():
    return 1
end

func op_push_str():
    return 2
end

func op_load_local():
    return 3
end

func op_store_local():
    return 4
end

func op_add():
    return 5
end

func op_sub():
    return 6
end

func op_lt():
    return 7
end

func op_le():
    return 8
end

func op_gt():
    return 9
end

func op_ge():
    return 10
end

func op_eq():
    return 11
end

func op_ne():
    return 12
end

func op_not():
    return 13
end

func op_make_tuple():
    return 14
end

func op_tuple_get():
    return 15
end

func op_br():
    return 16
end

func op_br_if_false():
    return 17
end

func op_br_and():
    return 18
end

func op_br_or():
    return 19
end

func op_call():
    return 20
end

func op_ret():
    return 21
end

func op_length():
    return 22
end

func op_index():
    return 23
end

func op_slice():
    return 24
end

func op_equal():
    return 25
end

func op_new_buffer():
    return 26
end

func op_freeze():
    return 27
end

func op_new_array():
    return 28
end

-- Ref records: add leaving the array on the stack, and a field store.
func op_arr_add_keep():
    return 63
end

func op_set_field():
    return 64
end

func op_get_field():
    return 65
end

func op_get():
    return 29
end

func op_count():
    return 30
end

func op_buf_append():
    return 31
end

func op_arr_add():
    return 32
end

func op_clogger():
    return 33
end

func op_flogger():
    return 34
end

func op_fwriter():
    return 35
end

-- Bitwise / shift opcodes. Appended at 36-41 (the dense 0-35 space is full and
-- the VM range-checks binops; never renumber an existing opcode). band/bor/bxor/
-- shl/shr are int x int -> int binops; bnot is the int -> int one's-complement
-- unary (a distinct opcode from boolean `not` at 13).
func op_band():
    return 36
end

func op_bor():
    return 37
end

func op_bxor():
    return 38
end

func op_shl():
    return 39
end

func op_shr():
    return 40
end

func op_bnot():
    return 41
end

-- Multiplicative opcodes. Appended at 42-44 after the current max (op_bnot=41);
-- NEVER renumber an existing opcode (the VM range-checks binops and pass-1 sizes
-- by op number). mul/div/mod are int x int -> int binops. div/mod also fault on a
-- zero divisor (a located runtime fault, exit-status parity with the C oracle),
-- so they are "faultable" (see nc_code_has_faultable_loop); mul never faults.
func op_mul():
    return 42
end

func op_div():
    return 43
end

func op_mod():
    return 44
end

-- trukfit (f3, device input): a 0-arg value builtin that reads ONE byte from the
-- COM1 RBR. Lowered ONLY by the multiboot32-input emit mode (nc32_lower_loop op 45);
-- it is deliberately absent from nc32_op_allowed/nc32_pops/nc32_pushes so every
-- OTHER mode and the near-axis path reject it (a body carrying op 45 fails the depth
-- gate / is rejected explicitly), keeping the device read isolated to the input mode.
func op_input_byte():
    return 45
end

func op_module_byte():
    return 46
end

-- coalgate (link 22) op_sys_read: the MODULE-SIDE syscall builtin. Unlike op_module_byte (op 46, which
-- reads the kernel's absolute [answer] cell -- a kernel-only primitive), sys_read() lowers to the
-- position-independent SYS_READ syscall (int 0x30, eax=0): the kernel delivers a late-bound byte the
-- CPL3 module cannot read itself, and irets back with it in eax. Absent from nc32_op_allowed/pops/pushes
-- (like op 45/46), so only the coalgate mode's sysread_proxy admits it; every other mode rejects it.
func op_sys_read():
    return 47
end

-- holler (link 24) op_sys_write: the MODULE-SIDE output syscall builtin. sys_write(v) emits le32(v) (4 bytes)
-- via the bounds-checked SYS_WRITE syscall (int 0x30, eax=2): the CPL3 module hands the kernel a pointer to v
-- on its OWN operand stack (ecx=esp, edx=4); the kernel relays the 4 bytes ONLY if [ecx,ecx+4) lies in the
-- module's User page [alloc_lo,alloc_hi) (the access_ok confused-deputy check). A VALUE builtin returning 0.
-- Absent from nc32_op_allowed/pops/pushes (like op 45/46/47): only the holler module mode's holler_proxy
-- admits it (net 0: pop the arg, push the result); every other mode rejects a body carrying op 48.
func op_sys_write():
    return 48
end

-- tandem (link 28) op_yield: the COOPERATIVE-SCHEDULER builtin. yield(v) passes v to the peer program via the
-- kernel's one-cell mailbox and switches to it (SYS_YIELD = int 0x30, eax=3); when this program is resumed, the
-- call RETURNS the value the peer last passed (a synchronous rendezvous). Lowers to 10 bytes (mov eax,3; int 0x30;
-- mov [esp],eax) -- net stack 0 (pop the arg at TOS, push the return into the same slot), exactly like op 48.
-- Absent from nc32_op_allowed/pops/pushes (like op 45/46/47/48): only the tandem module mode admits op 52.
func op_yield():
    return 52
end

-- chiefturbo (link 26) runtime-indexed-memory builtins. bufbase() pushes the captured buffer base (alloc_lo,
-- stashed at [ebp+0] by main's capture prologue); bufget(base,k) is a register-indexed SS-relative load
-- buf[k]; bufset(base,i,v) is a register-indexed SS-relative store buf[i]=v. Absent from nc32_op_allowed/
-- pops/pushes (like op 45/46/47/48): only the chiefturbo module mode admits a body carrying op 49/50/51.
func op_bufbase():
    return 49
end

func op_bufget():
    return 50
end

func op_bufset():
    return 51
end

-- riposte (nc link 64, 48th kernel-arc link): output_byte(v) -- the sovereign long64
-- target's FIRST program-authored device OUTPUT. A 1-arg VALUE builtin: writes v&0xff to
-- the COM1 THR (0x3F8), then polls LSR.TEMT (0x3FD bit 6) until the byte is FULLY ON THE
-- WIRE (write-then-drain -- STEP-0 proved Bochs's baud-paced TX drops back-to-back bytes
-- under a THRE-only discipline and loses the LAST byte to shutdown without the drain),
-- and returns v (pops 1, pushes 1 -- the FULL 64-bit argument, so a checksum consuming
-- the return value pins push-semantics beyond the al-truncated device write). Admitted
-- ONLY by the multi-function long64 path (nc_tap_*); absent from nc32/nc64/every other
-- op_allowed, so all other modes reject a body carrying op 53. 53 because 46-52 are taken.
func op_output_byte():
    return 53
end

-- Linux-hosted process I/O only. Existing opcode numbers and target allowlists
-- stay unchanged. process_exit is void; stderr_write consumes a string and
-- returns zero on complete transfer or a positive Linux errno on failure.
func op_process_exit():
    return 54
end

func op_stderr_write():
    return 55
end

-- Checked hosted input: one abstract (int, string), three machine words.
func op_stdin_read():
    return 56
end

-- folio (link67): sovereign boot-file input, admitted only by nc_tap_*.
-- One scalar result: the next byte 0..255, or stable EOF 256. Unlike the
-- historical module_byte answer cell, this consumes a validated module extent.
func op_boot_read():
    return 57
end

-- Linux/x86-64 hosted boundary. These generic operations are deliberately not
-- admitted by any freestanding target or by the VM. The syscall and borrowed
-- address are UNSAFE escape hatches: Linux can read/write the pointed storage,
-- and append may move a buffer's backing allocation. Safe byte access is bounded
-- by the initialized length; buffer_set requires a byte exactly as append does.
func op_linux_syscall6():
    return 58
end

func op_buffer_address():
    return 59
end

func op_buffer_get():
    return 60
end

func op_buffer_set():
    return 61
end

func op_buffer_length():
    return 62
end

func nc_is_hosted_memory_builtin(name):
    return equal(name, "linux_syscall6") or equal(name, "buffer_address") or equal(name, "buffer_get") or equal(name, "buffer_set") or equal(name, "buffer_length")
end

func emit_instr(ir, op, a, b):
    do add(ir, (0, op, a, b, 0, "", 0))
    return ir
end

func emit_instr_line(ir, op, a, b, line):
    do add(ir, (0, op, a, b, 0, "", line))
    return ir
end

func emit_instr_meta(ir, op, a, b, meta):
    do add(ir, (0, op, a, b, meta, "", 0))
    return ir
end

func emit_target_instr(ir, op, label):
    do add(ir, (0, op, 0, 0, 0, label, 0))
    return ir
end

func emit_label(ir, label):
    do add(ir, (1, 0, 0, 0, 0, label, 0))
    return ir
end

func make_label(prefix, n):
    let buf = new_buffer()
    buf = append_str(buf, prefix)
    buf = append_str(buf, int_to_str(n))
    return freeze(buf)
end

func collect_labels_loop(ir, i, n, pc, labels):
    if i >= n:
        return labels
    end
    let item = get(ir, i)
    if item.0 == 1:
        do add(labels, (item.5, pc))
        return collect_labels_loop(ir, i + 1, n, pc, labels)
    end
    return collect_labels_loop(ir, i + 1, n, pc + 1, labels)
end

func collect_labels(ir):
    return collect_labels_loop(ir, 0, count(ir), 0, new_array((string, int)))
end

func find_label_pos_loop(labels, name, i, n):
    if i >= n:
        return fault("missing label")
    end
    let item = get(labels, i)
    if equal(item.0, name):
        return item.1
    end
    return find_label_pos_loop(labels, name, i + 1, n)
end

func find_label_pos(labels, name):
    return find_label_pos_loop(labels, name, 0, count(labels))
end

func resolve_ir_loop(ir, i, n, labels, out):
    if i >= n:
        return out
    end
    let item = get(ir, i)
    if item.0 == 1:
        return resolve_ir_loop(ir, i + 1, n, labels, out)
    end
    if equal(item.5, ""):
        do add(out, (item.1, item.2, item.3))
    else:
        do add(out, (item.1, find_label_pos(labels, item.5), item.3))
    end
    return resolve_ir_loop(ir, i + 1, n, labels, out)
end

func resolve_ir(ir):
    let labels = collect_labels(ir)
    return resolve_ir_loop(ir, 0, count(ir), labels, new_array((int, int, int)))
end

func resolve_new_array_meta_loop(ir, i, n, out):
    if i >= n:
        return out
    end
    let item = get(ir, i)
    if item.0 == 1:
        return resolve_new_array_meta_loop(ir, i + 1, n, out)
    end
    do add(out, item.4)
    return resolve_new_array_meta_loop(ir, i + 1, n, out)
end

func resolve_new_array_meta(ir):
    return resolve_new_array_meta_loop(ir, 0, count(ir), new_array(int))
end

func resolve_instr_lines_loop(ir, i, n, out):
    if i >= n:
        return out
    end
    let item = get(ir, i)
    if item.0 == 1:
        return resolve_instr_lines_loop(ir, i + 1, n, out)
    end
    do add(out, item.6)
    return resolve_instr_lines_loop(ir, i + 1, n, out)
end

func resolve_instr_lines(ir):
    return resolve_instr_lines_loop(ir, 0, count(ir), new_array(int))
end

-- A lowering environment is (names, slots, next slot, count). Names and slots
-- are the persistent chunked arrays of types_and_inference.herb (nc_pget,
-- nc_pset_str, nc_pset_int): a copy shares them, and leaving a scope only lowers
-- count. The next slot keeps counting, so no two declarations share a slot.
func env_from_params_loop(params, i, n, env):
    if i >= n:
        return env
    end
    return env_from_params_loop(params, i + 1, n, env_let(env, get(params, i)))
end

func env_from_params(params):
    return env_from_params_loop(params, 0, count(params), (new_array(array(string)), new_array(array(int)), 0, 0))
end

func env_let(env, name):
    return (nc_pset_str(env.0, env.3, name), nc_pset_int(env.1, env.3, env.2), env.2 + 1, env.3 + 1)
end

func env_lookup_loop(env, name, n):
    if n == 0:
        return fault("name undefined")
    end
    let k = n - 1
    if equal(nc_pget(env.0, k), name):
        return nc_pget(env.1, k)
    end
    return env_lookup_loop(env, name, k)
end

func env_lookup(env, name):
    return env_lookup_loop(env, name, env.3)
end

func env_rebuild(env, keep):
    return (env.0, env.1, env.2, keep)
end

func string_from_atoms_loop(atoms, i, n, buf):
    if i >= n:
        return buf
    end
    do append(buf, parse_decimal(get(atoms, i)))
    return string_from_atoms_loop(atoms, i + 1, n, buf)
end

func string_from_atoms(atoms):
    let n = parse_decimal(get(atoms, 0))
    if n + 1 != count(atoms):
        return fault("bad string node")
    end
    return freeze(string_from_atoms_loop(atoms, 1, count(atoms), new_buffer()))
end

func intern_string_loop(strings, s, i, n):
    if i >= n:
        do add(strings, s)
        return count(strings) - 1
    end
    if equal(get(strings, i), s):
        return i
    end
    return intern_string_loop(strings, s, i + 1, n)
end

func intern_string(strings, s):
    return intern_string_loop(strings, s, 0, count(strings))
end

func opcode_for_binop(tag):
    if equal(tag, "add"):
        return op_add()
    end
    if equal(tag, "sub"):
        return op_sub()
    end
    if equal(tag, "mul"):
        return op_mul()
    end
    if equal(tag, "div"):
        return op_div()
    end
    if equal(tag, "mod"):
        return op_mod()
    end
    if equal(tag, "eq"):
        return op_eq()
    end
    if equal(tag, "ne"):
        return op_ne()
    end
    if equal(tag, "lt"):
        return op_lt()
    end
    if equal(tag, "le"):
        return op_le()
    end
    if equal(tag, "gt"):
        return op_gt()
    end
    if equal(tag, "ge"):
        return op_ge()
    end
    if equal(tag, "band"):
        return op_band()
    end
    if equal(tag, "bor"):
        return op_bor()
    end
    if equal(tag, "bxor"):
        return op_bxor()
    end
    if equal(tag, "shl"):
        return op_shl()
    end
    return op_shr()
end

func emit_exprs(kids, i, n, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    if i >= n:
        return ir
    end
    ir = emit_expr(get(kids, i), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    return emit_exprs(kids, i + 1, n, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
end

func emit_call_expr(name, kids, call_node_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let call_line = get(nodes, call_node_idx).3
    if equal(name, "new_array"):
        let elem = nc_type_from_type_expr(type_pool, nodes, get(kids, 0))
        if elem.0 != 0:
            return fault("bad new_array meta")
        end
        return emit_instr_meta(ir, op_new_array(), 0, 0, nc_type_intern_array(type_pool, nc_type_erase(type_pool, elem.1)))
    end
    ir = emit_exprs(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    if equal(name, "linux_syscall6"):
        return emit_instr(ir, op_linux_syscall6(), 0, 0)
    end
    if equal(name, "buffer_address"):
        return emit_instr(ir, op_buffer_address(), 0, 0)
    end
    if equal(name, "buffer_get"):
        return emit_instr_line(ir, op_buffer_get(), 0, 0, call_line)
    end
    if equal(name, "buffer_set"):
        return emit_instr_line(ir, op_buffer_set(), 0, 0, call_line)
    end
    if equal(name, "buffer_length"):
        return emit_instr(ir, op_buffer_length(), 0, 0)
    end
    if equal(name, "clogger"):
        return emit_instr(ir, op_clogger(), 0, 0)
    end
    if equal(name, "stdin_read"):
        return emit_instr(ir, op_stdin_read(), 0, 0)
    end
    if equal(name, "stderr_write"):
        return emit_instr(ir, op_stderr_write(), 0, 0)
    end
    if equal(name, "length"):
        return emit_instr(ir, op_length(), 0, 0)
    end
    if equal(name, "index"):
        return emit_instr_line(ir, op_index(), 0, 0, call_line)
    end
    if equal(name, "slice"):
        return emit_instr(ir, op_slice(), 0, 0)
    end
    if equal(name, "equal"):
        return emit_instr(ir, op_equal(), 0, 0)
    end
    if equal(name, "new_buffer"):
        return emit_instr(ir, op_new_buffer(), 0, 0)
    end
    if equal(name, "freeze"):
        return emit_instr(ir, op_freeze(), 0, 0)
    end
    if equal(name, "get"):
        return emit_instr_line(ir, op_get(), 0, 0, call_line)
    end
    if equal(name, "count"):
        return emit_instr(ir, op_count(), 0, 0)
    end
    if equal(name, "input_byte"):
        return emit_instr(ir, op_input_byte(), 0, 0)
    end
    if equal(name, "boot_read"):
        return emit_instr(ir, op_boot_read(), 0, 0)
    end
    if equal(name, "output_byte"):
        return emit_instr(ir, op_output_byte(), 0, 0)
    end
    if equal(name, "module_byte"):
        return emit_instr(ir, op_module_byte(), 0, 0)
    end
    if equal(name, "sys_read"):
        return emit_instr(ir, op_sys_read(), 0, 0)
    end
    if equal(name, "sys_write"):
        return emit_instr(ir, op_sys_write(), 0, 0)
    end
    if equal(name, "yield"):
        return emit_instr(ir, op_yield(), 0, 0)
    end
    if equal(name, "bufbase"):
        return emit_instr(ir, op_bufbase(), 0, 0)
    end
    if equal(name, "bufget"):
        return emit_instr(ir, op_bufget(), 0, 0)
    end
    if equal(name, "bufset"):
        return emit_instr(ir, op_bufset(), 0, 0)
    end
    if equal(name, "append") or equal(name, "add") or equal(name, "flogger") or equal(name, "process_exit"):
        return fault("void builtin in expression")
    end
    return emit_instr(ir, op_call(), nc_poly_lowered_call_target(type_pool, poly, caller_inst_idx, call_node_idx, call_line), count(kids))
end

func emit_expr(node_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let node = get(nodes, node_idx)
    let tag = node.0
    let atoms = node.1
    let kids = node.2
    if equal(tag, "int"):
        return emit_instr(ir, op_push_int(), parse_decimal(get(atoms, 0)), 0)
    end
    if equal(tag, "char"):
        return emit_instr(ir, op_push_int(), parse_decimal(get(atoms, 0)), 0)
    end
    if equal(tag, "str"):
        let s = string_from_atoms(atoms)
        return emit_instr(ir, op_push_str(), intern_string(strings, s), 0)
    end
    if equal(tag, "bool"):
        if equal(get(atoms, 0), "true"):
            return emit_instr(ir, op_push_bool(), 1, 0)
        end
        return emit_instr(ir, op_push_bool(), 0, 0)
    end
    if equal(tag, "name"):
        return emit_instr(ir, op_load_local(), env_lookup(env, get(atoms, 0)), 0)
    end
    if equal(tag, "and"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        let done = make_label("and", count(ir))
        ir = emit_target_instr(ir, op_br_and(), done)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_label(ir, done)
    end
    if equal(tag, "or"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        let done = make_label("or", count(ir))
        ir = emit_target_instr(ir, op_br_or(), done)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_label(ir, done)
    end
    if equal(tag, "not"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_not(), 0, 0)
    end
    if equal(tag, "bnot"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_bnot(), 0, 0)
    end
    if equal(tag, "add") or equal(tag, "sub") or equal(tag, "mul") or equal(tag, "div") or equal(tag, "mod") or equal(tag, "eq") or equal(tag, "ne") or equal(tag, "lt") or equal(tag, "le") or equal(tag, "gt") or equal(tag, "ge") or equal(tag, "band") or equal(tag, "bor") or equal(tag, "bxor") or equal(tag, "shl") or equal(tag, "shr"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, opcode_for_binop(tag), 0, 0)
    end
    if equal(tag, "tuple"):
        ir = emit_exprs(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_make_tuple(), count(kids), 0)
    end
    if equal(tag, "record-new"):
        let decl_idx = nc_record_decl_find(nodes, prog_idx, get(atoms, 0))
        if equal(get(nodes, decl_idx).0, "ref-record"):
            -- A ref record is a one-element array of the tuple of its fields.
            let rt = nc_record_type(type_pool, nodes, decl_idx, new_array(int))
            ir = emit_instr_meta(ir, op_new_array(), 0, 0, nc_type_erase(type_pool, rt.1))
            ir = emit_exprs(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
            ir = emit_instr(ir, op_make_tuple(), count(kids), 0)
            return emit_instr(ir, op_arr_add_keep(), 0, 0)
        end
        ir = emit_exprs(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_make_tuple(), count(kids), 0)
    end
    if equal(tag, "dot"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        if not is_digit(index(get(atoms, 0), 0)):
            let shape = lowered_field(poly, nodes, caller_inst_idx, node_idx, node)
            if equal(get(nodes, shape.4).0, "ref-record"):
                -- In place: the field's words straight from the record's element.
                return emit_instr(ir, op_get_field(), shape.2, 0)
            end
            return emit_instr(ir, op_tuple_get(), shape.2, 0)
        end
        return emit_instr(ir, op_tuple_get(), parse_decimal(get(atoms, 0)), 0)
    end
    if equal(tag, "call"):
        return emit_call_expr(get(atoms, 0), kids, node_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    end
    return fault("bad expression")
end

func if_ends_return(kids, i, n, nodes):
    if i >= n:
        return false
    end
    let arm = get(nodes, get(kids, i))
    if equal(arm.0, "else"):
        return body_ends_return(get(arm.2, 0), nodes)
    end
    if not body_ends_return(get(arm.2, 1), nodes):
        return false
    end
    return if_ends_return(kids, i + 1, n, nodes)
end

func stmt_ends_return(stmt_idx, nodes):
    let stmt = get(nodes, stmt_idx)
    if equal(stmt.0, "return"):
        return true
    end
    if equal(stmt.0, "if"):
        return if_ends_return(stmt.2, 0, count(stmt.2), nodes)
    end
    return false
end

func body_has_return(stmts, i, n, nodes):
    if i >= n:
        return false
    end
    if stmt_ends_return(get(stmts, i), nodes):
        return true
    end
    return body_has_return(stmts, i + 1, n, nodes)
end

func body_ends_return(body_idx, nodes):
    -- A return or exhaustive returning if terminates this body. Inference,
    -- branch joins and lowering must agree about that boundary, including nesting.
    let body = get(nodes, body_idx)
    return body_has_return(body.2, 0, count(body.2), nodes)
end

func emit_body(stmts, i, n, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    if i >= n:
        return env
    end
    env = emit_stmt(get(stmts, i), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    -- Inference ends this body at a returning statement. Lowering must not request
    -- specializations or local metadata for statements inference never visited.
    if stmt_ends_return(get(stmts, i), nodes):
        return env
    end
    return emit_body(stmts, i + 1, n, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
end

func emit_do_call(call_idx, stmt_line, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let node = get(nodes, call_idx)
    if not equal(node.0, "call"):
        return fault("do non-call")
    end
    let name = get(node.1, 0)
    let kids = node.2
    if equal(name, "append"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr_line(ir, op_buf_append(), 0, 0, stmt_line)
    end
    if equal(name, "add"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_expr(get(kids, 1), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_arr_add(), 0, 0)
    end
    if equal(name, "flogger"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_flogger(), 0, 0)
    end
    if equal(name, "fwriter"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_fwriter(), 0, 0)
    end
    if equal(name, "process_exit"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_instr(ir, op_process_exit(), 0, 0)
    end
    return fault("bad do call")
end

func emit_if_arms(kids, i, n, env, ir, strings, nodes, prog_idx, type_pool, join_label, caller_inst_idx, poly):
    if i >= n:
        return env
    end
    let arm_idx = get(kids, i)
    let arm = get(nodes, arm_idx)
    let scope_mark = env.3
    if equal(arm.0, "else"):
        let body_idx = get(arm.2, 0)
        let body = get(nodes, body_idx)
        let body_env = emit_body(body.2, 0, count(body.2), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return env_rebuild(body_env, scope_mark)
    end
    let next_label = make_label("if", count(ir))
    ir = emit_expr(get(arm.2, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    ir = emit_target_instr(ir, op_br_if_false(), next_label)
    let body_idx = get(arm.2, 1)
    let body = get(nodes, body_idx)
    let body_env = emit_body(body.2, 0, count(body.2), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    env = env_rebuild(body_env, scope_mark)
    if (not body_ends_return(body_idx, nodes)) and i + 1 < n:
        ir = emit_target_instr(ir, op_br(), join_label)
    end
    ir = emit_label(ir, next_label)
    return emit_if_arms(kids, i + 1, n, env, ir, strings, nodes, prog_idx, type_pool, join_label, caller_inst_idx, poly)
end

func emit_if_stmt(kids, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let join_label = make_label("join", count(ir))
    env = emit_if_arms(kids, 0, count(kids), env, ir, strings, nodes, prog_idx, type_pool, join_label, caller_inst_idx, poly)
    ir = emit_label(ir, join_label)
    return env
end

-- top: condition; br_if_false exit; body; br top; exit. The branch back is
-- the only backward branch the IR has; a body that ends in a return has no
-- fall-through, so it gets none (as an if arm gets no branch to its join).
-- The body's names close at end, as an arm's do; their slots stay allocated.
func emit_while_stmt(kids, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let top_label = make_label("loop", count(ir))
    ir = emit_label(ir, top_label)
    let exit_label = make_label("exit", count(ir))
    let scope_mark = env.3
    ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    ir = emit_target_instr(ir, op_br_if_false(), exit_label)
    let body_idx = get(kids, 1)
    let body = get(nodes, body_idx)
    let body_env = emit_body(body.2, 0, count(body.2), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    if not body_ends_return(body_idx, nodes):
        ir = emit_target_instr(ir, op_br(), top_label)
    end
    ir = emit_label(ir, exit_label)
    return env_rebuild(body_env, scope_mark)
end

-- (position, field count, declaration) of FIELD in the one record that
-- declares it, or (-1, 0, 0) when no record or more than one does.
func unique_record_field_loop(nodes, field, i, found):
    if i >= count(nodes):
        return found
    end
    let node = get(nodes, i)
    if is_record_decl_tag(node.0):
        let fi = nc_record_field_index(nodes, i, field)
        if fi != 0 - 1:
            if found.0 != 0 - 1:
                return (0 - 1, 0, 0)
            end
            found = (fi, count(node.1) - 1, i)
        end
    end
    return unique_record_field_loop(nodes, field, i + 1, found)
end

-- Inference records each field's position per instance. A missing entry means
-- the value's type stayed unknown there, as after a never-returning helper,
-- whose code the tuple form also compiles; resolve by the field's name when
-- exactly one record declares it.
func lowered_field(poly, nodes, inst_idx, node_idx, node):
    let i = nc_poly_field_find_loop(poly.3, inst_idx, node_idx, 0)
    if i == 0 - 1:
        let field = get(node.1, count(node.1) - 1)
        let u = unique_record_field_loop(nodes, field, 0, (0 - 1, 0, 0))
        if u.0 == 0 - 1:
            do nc_fail(446, node.3, field)
            return (inst_idx, node_idx, 0, 0, 0)
        end
        return (inst_idx, node_idx, u.0, u.1, u.2)
    end
    return get(poly.3, i)
end

func emit_field_update(k, n, i, slot, value_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    if i >= n:
        return ir
    end
    if i == k:
        ir = emit_expr(value_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return emit_field_update(k, n, i + 1, slot, value_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    end
    ir = emit_instr(ir, op_load_local(), slot, 0)
    ir = emit_instr(ir, op_tuple_get(), i, 0)
    return emit_field_update(k, n, i + 1, slot, value_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
end

func emit_stmt(stmt_idx, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly):
    let stmt = get(nodes, stmt_idx)
    let tag = stmt.0
    let atoms = stmt.1
    let kids = stmt.2
    if equal(tag, "let"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_instr(ir, op_store_local(), env.2, 0)
        return env_let(env, get(atoms, 0))
    end
    if equal(tag, "assign"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_instr(ir, op_store_local(), env_lookup(env, get(atoms, 0)), 0)
        return env
    end
    if equal(tag, "field-assign"):
        -- The same code as x = (x.0, ..., e, ..., x.n-1) for a tuple.
        let shape = lowered_field(poly, nodes, caller_inst_idx, stmt_idx, stmt)
        let slot = env_lookup(env, get(atoms, 0))
        if equal(get(nodes, shape.4).0, "ref-record"):
            -- In place: the field's words go into the record's one element.
            let fields = nc_type_children(type_pool, nc_record_type(type_pool, nodes, shape.4, new_array(int)).1)
            ir = emit_instr(ir, op_load_local(), slot, 0)
            ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
            ir = emit_instr(ir, op_set_field(), nc_type_width_tuple(type_pool, fields, 0, shape.2, 0), nc_type_width(type_pool, get(fields, shape.2)))
            return env
        end
        ir = emit_field_update(shape.2, shape.3, 0, slot, get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_instr(ir, op_make_tuple(), shape.3, 0)
        ir = emit_instr(ir, op_store_local(), slot, 0)
        return env
    end
    if equal(tag, "return"):
        ir = emit_expr(get(kids, 0), env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        ir = emit_instr(ir, op_ret(), 0, 0)
        return env
    end
    if equal(tag, "do"):
        ir = emit_do_call(get(kids, 0), stmt.3, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
        return env
    end
    if equal(tag, "if"):
        return emit_if_stmt(kids, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    end
    if equal(tag, "while"):
        return emit_while_stmt(kids, env, ir, strings, nodes, prog_idx, type_pool, caller_inst_idx, poly)
    end
    return fault("bad statement")
end

func lower_func_poly(func_idx, inst_idx, entry_pc, strings, nodes, prog_idx, type_pool, poly):
    let fn = get(nodes, func_idx)
    let name = get(fn.1, 0)
    let params_node = get(nodes, get(fn.2, 0))
    let body_node = get(nodes, get(fn.2, 1))
    let env = env_from_params(params_node.1)
    let ir = new_array((int, int, int, int, int, string, int))
    let out_env = emit_body(body_node.2, 0, count(body_node.2), env, ir, strings, nodes, prog_idx, type_pool, inst_idx, poly)
    let code = resolve_ir(ir)
    let new_array_meta = resolve_new_array_meta(ir)
    let instr_lines = resolve_instr_lines(ir)
    return (name, entry_pc, count(params_node.1), out_env.2, code, new_array_meta, instr_lines)
end

func lower_program_poly_loop(instances, i, entry_pc, funcs, strings, nodes, prog_idx, type_pool, poly):
    if i >= count(instances):
        return funcs
    end
    let prog = get(nodes, prog_idx)
    let inst = get(instances, i)
    let fn = lower_func_poly(get(prog.2, inst.0), i, entry_pc, strings, nodes, prog_idx, type_pool, poly)
    do add(funcs, fn)
    return lower_program_poly_loop(instances, i + 1, entry_pc + count(fn.4), funcs, strings, nodes, prog_idx, type_pool, poly)
end

func lower_program_poly(nodes, prog_idx, type_pool, poly):
    let strings = new_array(string)
    let funcs = new_array((string, int, int, int, array((int, int, int)), array(int), array(int)))
    funcs = lower_program_poly_loop(poly.0, 0, 0, funcs, strings, nodes, prog_idx, type_pool, poly)
    return (funcs, strings, 0)
end

func lower_program(nodes, prog_idx, type_pool):
    let ast_result = nc_verify_ast(nodes, prog_idx, type_pool)
    if ast_result.0 != 0:
        return (new_array((string, int, int, int, array((int, int, int)), array(int), array(int))), new_array(string), 0)
    end
    return lower_program_poly(nodes, prog_idx, type_pool, ast_result.2)
end

-- ====================================================================
-- ERROR-HANDLING FRONT END
-- ====================================================================

func err_ok_tag():
    return 0
end

func err_err_tag():
    return 1
end

func err_no_diag():
    return (0, 0, "")
end

func err_diag(code, line, payload):
    return (code, line, payload)
end

func diagnostic_with_payload(prefix, payload, suffix):
    let buf = new_buffer()
    buf = append_str(buf, prefix)
    buf = append_str(buf, payload)
    buf = append_str(buf, suffix)
    return freeze(buf)
end

func diagnostic_message(code, payload):
    if code == 101:
        return "unexpected character"
    end
    if code == 102:
        return "expected digit"
    end
    if code == 103:
        return "integer literal does not fit in 64 bits"
    end
    if code == 104:
        return "unknown escape sequence"
    end
    if code == 105:
        return "unterminated escape"
    end
    if code == 106:
        return "newline in string literal"
    end
    if code == 107:
        return "unterminated string literal"
    end
    if code == 108:
        return "empty character literal"
    end
    if code == 109:
        return "character literal not closed"
    end
    if code == 110:
        return "newline in character literal"
    end
    if code == 201:
        return "expected 'func' at top level"
    end
    if code == 202:
        return "invalid function header"
    end
    if code == 203:
        return "expected end"
    end
    if code == 204:
        return "expected expression"
    end
    if code == 205:
        return "'do' must be followed by a call"
    end
    if code == 206:
        return "expected integer after '.'"
    end
    if code == 207:
        return "expected ')'"
    end
    if code == 208:
        return "new_array requires a type argument"
    end
    if code == 209:
        return "function body must contain at least one statement"
    end
    if code == 210:
        return "if/elif/else arm must contain at least one statement"
    end
    if code == 211:
        return "invalid type expression"
    end
    if code == 212:
        return "invalid assignment or name"
    end
    if code == 213:
        return "invalid record declaration"
    end
    if code == 214:
        return "while body must contain at least one statement"
    end
    if code == 301:
        return diagnostic_with_payload("duplicate let '", payload, "' in this scope")
    end
    if code == 302:
        return diagnostic_with_payload("undefined name '", payload, "'")
    end
    if code == 303:
        return diagnostic_with_payload("assignment to undefined name '", payload, "'")
    end
    if code == 304:
        return diagnostic_with_payload("unknown function '", payload, "'")
    end
    if code == 305:
        return diagnostic_with_payload("wrong number of arguments to '", payload, "'")
    end
    if code == 306:
        return diagnostic_with_payload("wrong number of arguments to '", payload, "'")
    end
    if code == 307:
        return diagnostic_with_payload("wrong number of arguments to '", payload, "'")
    end
    if code == 308:
        return diagnostic_with_payload("builtin '", payload, "' has no value")
    end
    if code == 310:
        return diagnostic_with_payload("'do' requires a value-less call, got '", payload, "'")
    end
    if code == 311:
        return diagnostic_with_payload("duplicate parameter '", payload, "'")
    end
    if code == 312:
        return diagnostic_with_payload("duplicate function '", payload, "'")
    end
    if code == 313:
        return diagnostic_with_payload("function reuses built-in name '", payload, "'")
    end
    if code == 314:
        return "no main function defined"
    end
    if code == 315:
        return diagnostic_with_payload("function '", payload, "' must take zero parameters")
    end
    if code == 316:
        return diagnostic_with_payload("function '", payload, "' may complete without returning")
    end
    return "unknown error"
end

func serialize_diagnostic(diag):
    let code = diag.0
    let line = diag.1
    let payload = diag.2
    let buf = new_buffer()
    if line > 0:
        buf = append_str(buf, "line ")
        buf = append_str(buf, int_to_str(line))
        buf = append_str(buf, ": ")
    else:
        buf = append_str(buf, "program: ")
    end
    buf = append_str(buf, diagnostic_message(code, payload))
    buf = append_str(buf, " (ERR ")
    buf = append_str(buf, int_to_str(code))
    buf = append_str(buf, ")")
    return freeze(buf)
end

func err_empty_tokens():
    return new_array((int, string, int))
end

func err_lex_ok(tokens, eof_line):
    return (err_ok_tag(), err_no_diag(), tokens, eof_line)
end

func err_lex_fail(diag):
    return (err_err_tag(), diag, err_empty_tokens(), 0)
end

func err_pos_ok(pos):
    return (err_ok_tag(), err_no_diag(), pos)
end

func err_pos_fail(diag):
    return (err_err_tag(), diag, 0)
end

func err_parse_ok(pos):
    return (err_ok_tag(), err_no_diag(), pos, 0)
end

func err_parse_ok_extra(pos, extra):
    return (err_ok_tag(), err_no_diag(), pos, extra)
end

func err_parse_fail(diag):
    return (err_err_tag(), diag, 0, 0)
end

func err_parse_fail_at(code, line):
    return err_parse_fail(err_diag(code, line, ""))
end

func err_parse_fail_payload(code, line, payload):
    return err_parse_fail(err_diag(code, line, payload))
end

func err_token_line(tokens, pos, ctx):
    if pos >= count(tokens):
        return ctx.0
    end
    let t = get(tokens, pos)
    return t.2
end

func err_parse_fail_current(code, tokens, pos, ctx):
    return err_parse_fail_at(code, err_token_line(tokens, pos, ctx))
end

func err_expr_other():
    return 0
end

func err_expr_call():
    return 1
end

func err_expr_new_array():
    return 2
end

func err_is_valid_punct(c):
    return c == '(' or c == ')' or c == ',' or c == '.' or c == ':'
end

func err_end_of_int(src, i, n, line, acc):
    if i >= n:
        return err_pos_ok(i)
    end
    let c = index(src, i)
    if not is_digit(c):
        return err_pos_ok(i)
    end
    let d = c - '0'
    if acc > 1844674407370955161:
        return err_pos_fail(err_diag(103, line, ""))
    end
    if acc == 1844674407370955161 and d > 5:
        return err_pos_fail(err_diag(103, line, ""))
    end
    return err_end_of_int(src, i + 1, n, line, times10(acc) + d)
end

func err_string_escape_ok(c):
    return c == 'n' or c == '\\' or c == '"'
end

func err_char_escape_ok(c):
    return c == 'n' or c == '\\' or c == '\''
end

func err_end_of_string(src, i, n, line):
    if i >= n:
        return err_pos_fail(err_diag(107, line, ""))
    end
    let c = index(src, i)
    if c == '"':
        return err_pos_ok(i + 1)
    end
    if c == '\n':
        return err_pos_fail(err_diag(106, line, ""))
    end
    if c == '\\':
        if i + 1 >= n:
            return err_pos_fail(err_diag(105, line, ""))
        end
        if not err_string_escape_ok(index(src, i + 1)):
            return err_pos_fail(err_diag(104, line, ""))
        end
        return err_end_of_string(src, i + 2, n, line)
    end
    return err_end_of_string(src, i + 1, n, line)
end

func err_check_char_close(src, pos, n, line):
    if pos >= n:
        return err_pos_fail(err_diag(109, line, ""))
    end
    if index(src, pos) == '\n':
        return err_pos_fail(err_diag(110, line, ""))
    end
    if index(src, pos) != '\'':
        return err_pos_fail(err_diag(109, line, ""))
    end
    return err_pos_ok(pos + 1)
end

func err_end_of_char(src, i, n, line):
    if i >= n:
        return err_pos_fail(err_diag(109, line, ""))
    end
    let c = index(src, i)
    if c == '\n':
        return err_pos_fail(err_diag(110, line, ""))
    end
    if c == '\'':
        return err_pos_fail(err_diag(108, line, ""))
    end
    if c == '\\':
        if i + 1 >= n:
            return err_pos_fail(err_diag(105, line, ""))
        end
        if not err_char_escape_ok(index(src, i + 1)):
            return err_pos_fail(err_diag(104, line, ""))
        end
        return err_check_char_close(src, i + 2, n, line)
    end
    return err_check_char_close(src, i + 1, n, line)
end

func err_scan(src, i, n, line, out):
    if i >= n:
        return err_lex_ok(out, line)
    end
    let c = index(src, i)
    if is_ws(c):
        if c == '\n':
            return err_scan(src, i + 1, n, line + 1, out)
        end
        return err_scan(src, i + 1, n, line, out)
    elif c == '-' and i + 1 < n and index(src, i + 1) == '-':
        return err_scan(src, end_of_line(src, i + 2, n), n, line, out)
    elif is_ident_start(c):
        let j = end_of_ident(src, i + 1, n)
        do add(out, (0, slice_text(src, i, j), line))
        return err_scan(src, j, n, line, out)
    elif is_digit(c):
        let r = err_end_of_int(src, i, n, line, 0)
        if r.0 == err_err_tag():
            return err_lex_fail(r.1)
        end
        do add(out, (1, slice_text(src, i, r.2), line))
        return err_scan(src, r.2, n, line, out)
    elif c == '"':
        let r = err_end_of_string(src, i + 1, n, line)
        if r.0 == err_err_tag():
            return err_lex_fail(r.1)
        end
        do add(out, (2, slice_text(src, i, r.2), line))
        return err_scan(src, r.2, n, line, out)
    elif c == '\'':
        let r = err_end_of_char(src, i + 1, n, line)
        if r.0 == err_err_tag():
            return err_lex_fail(r.1)
        end
        do add(out, (3, slice_text(src, i, r.2), line))
        return err_scan(src, r.2, n, line, out)
    elif is_two_byte_op_start(c) and i + 1 < n and index(src, i + 1) == '=':
        do add(out, (5, slice_text(src, i, i + 2), line))
        return err_scan(src, i + 2, n, line, out)
    elif is_shift_op_start(c) and i + 1 < n and index(src, i + 1) == c:
        do add(out, (5, slice_text(src, i, i + 2), line))
        return err_scan(src, i + 2, n, line, out)
    elif is_one_byte_op(c):
        do add(out, (5, slice_text(src, i, i + 1), line))
        return err_scan(src, i + 1, n, line, out)
    elif err_is_valid_punct(c):
        do add(out, (4, slice_text(src, i, i + 1), line))
        return err_scan(src, i + 1, n, line, out)
    end
    return err_lex_fail(err_diag(101, line, slice_text(src, i, i + 1)))
end

func err_lex_source(src):
    return err_scan(src, 0, length(src), 1, new_array((int, string, int)))
end

func err_is_reserved_word(s):
    if equal(s, "func") or equal(s, "let") or equal(s, "return") or equal(s, "do"):
        return true
    end
    if equal(s, "if") or equal(s, "elif") or equal(s, "else") or equal(s, "end"):
        return true
    end
    if equal(s, "while"):
        return true
    end
    if equal(s, "and") or equal(s, "or") or equal(s, "not"):
        return true
    end
    if equal(s, "true") or equal(s, "false"):
        return true
    end
    if equal(s, "int") or equal(s, "bool") or equal(s, "string"):
        return true
    end
    return equal(s, "buffer") or equal(s, "array")
end

func err_is_valid_name_token(tokens, pos):
    if pos >= count(tokens):
        return false
    end
    let t = get(tokens, pos)
    return t.0 == 0 and not err_is_reserved_word(t.1)
end

func err_name_seen_loop(names, start, n, name):
    if start >= n:
        return false
    end
    if equal(get(names, start), name):
        return true
    end
    return err_name_seen_loop(names, start + 1, n, name)
end

func err_name_seen(names, name):
    return err_name_seen_loop(names, 0, count(names), name)
end

func err_parse_type(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    if pos >= count(tokens):
        return err_parse_fail_at(211, line)
    end
    let t = get(tokens, pos)
    if t.0 == 0:
        if equal(t.1, "int") or equal(t.1, "bool") or equal(t.1, "string") or equal(t.1, "buffer"):
            return err_parse_ok(pos + 1)
        end
        if err_is_record_name(ctx, t.1):
            return err_parse_ok(pos + 1)
        end
        if equal(t.1, "array"):
            if not tok_is_punct_text(tokens, pos + 1, "("):
                return err_parse_fail_current(211, tokens, pos + 1, ctx)
            end
            let r = err_parse_type(tokens, pos + 2, ctx)
            if r.0 == err_err_tag():
                return r
            end
            if not tok_is_punct_text(tokens, r.2, ")"):
                return err_parse_fail_current(211, tokens, r.2, ctx)
            end
            return err_parse_ok(r.2 + 1)
        end
        return err_parse_fail_at(211, line)
    end
    if tok_is_punct_text(tokens, pos, "("):
        let r = err_parse_type(tokens, pos + 1, ctx)
        if r.0 == err_err_tag():
            return r
        end
        return err_parse_type_tuple_tail(tokens, r.2, ctx, 1, line)
    end
    return err_parse_fail_at(211, line)
end

func err_parse_type_tuple_tail(tokens, pos, ctx, n_items, tuple_line):
    if tok_is_punct_text(tokens, pos, ","):
        let r = err_parse_type(tokens, pos + 1, ctx)
        if r.0 == err_err_tag():
            return r
        end
        return err_parse_type_tuple_tail(tokens, r.2, ctx, n_items + 1, tuple_line)
    end
    if not tok_is_punct_text(tokens, pos, ")"):
        return err_parse_fail_current(211, tokens, pos, ctx)
    end
    if n_items < 2:
        return err_parse_fail_at(211, tuple_line)
    end
    return err_parse_ok(pos + 1)
end

-- This checked pass recognizes structure, not expression meaning. Share the
-- AST parser's operator vocabulary; leave precedence and class-mixing ERR 442
-- to that parser. A flat operand/operator chain avoids a second precedence
-- ladder drifting behind the language. Groups/calls still recurse structurally.
-- The root kind records only whether the complete expression is a call, for do.
func err_parse_expr(tokens, pos, ctx):
    let r = err_parse_not(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_expr_tail(tokens, r.2, ctx, r.3)
end

func err_parse_expr_tail(tokens, pos, ctx, root_kind):
    if bin_op_class(tokens, pos) == 0:
        return err_parse_ok_extra(pos, root_kind)
    end
    let r = err_parse_not(tokens, pos + 1, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_expr_tail(tokens, r.2, ctx, err_expr_other())
end

func err_parse_not(tokens, pos, ctx):
    if tok_is_ident_text(tokens, pos, "not") or tok_is_op_text(tokens, pos, "~"):
        let r = err_parse_not(tokens, pos + 1, ctx)
        if r.0 == err_err_tag():
            return r
        end
        return err_parse_ok_extra(r.2, err_expr_other())
    end
    return err_parse_dot(tokens, pos, ctx)
end

func err_parse_dot(tokens, pos, ctx):
    let r = err_parse_atom(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_dot_loop(tokens, r.2, ctx, r.3)
end

func err_parse_dot_loop(tokens, pos, ctx, root_kind):
    if tok_is_punct_text(tokens, pos, "."):
        if pos + 1 >= count(tokens):
            return err_parse_fail_current(206, tokens, pos + 1, ctx)
        end
        let idx_tok = get(tokens, pos + 1)
        if idx_tok.0 == 0 and err_has_records(ctx) and err_is_valid_name_token(tokens, pos + 1):
            return err_parse_dot_loop(tokens, pos + 2, ctx, err_expr_other())
        end
        if idx_tok.0 != 1:
            return err_parse_fail_at(206, idx_tok.2)
        end
        return err_parse_dot_loop(tokens, pos + 2, ctx, err_expr_other())
    end
    return err_parse_ok_extra(pos, root_kind)
end

func err_parse_atom(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    if pos >= count(tokens):
        return err_parse_fail_at(204, line)
    end
    let t = get(tokens, pos)
    let k = t.0
    let s = t.1
    if k == 1 or k == 2 or k == 3:
        return err_parse_ok_extra(pos + 1, err_expr_other())
    end
    if k == 0:
        if equal(s, "true") or equal(s, "false"):
            return err_parse_ok_extra(pos + 1, err_expr_other())
        end
        if err_is_reserved_word(s):
            return err_parse_fail_at(204, line)
        end
        if tok_is_punct_text(tokens, pos + 1, "("):
            return err_parse_call(tokens, pos, ctx)
        end
        return err_parse_ok_extra(pos + 1, err_expr_other())
    end
    if tok_is_punct_text(tokens, pos, "("):
        return err_parse_group_or_tuple(tokens, pos + 1, ctx)
    end
    return err_parse_fail_at(204, line)
end

func err_parse_call(tokens, pos, ctx):
    let name_tok = get(tokens, pos)
    let name = name_tok.1
    let line = name_tok.2
    pos = pos + 2
    if equal(name, "new_array"):
        if tok_is_punct_text(tokens, pos, ")"):
            return err_parse_fail_at(208, line)
        end
        let r = err_parse_type(tokens, pos, ctx)
        if r.0 == err_err_tag():
            return r
        end
        if not tok_is_punct_text(tokens, r.2, ")"):
            return err_parse_fail_current(208, tokens, r.2, ctx)
        end
        return err_parse_ok_extra(r.2 + 1, err_expr_new_array())
    end
    if tok_is_punct_text(tokens, pos, ")"):
        return err_parse_ok_extra(pos + 1, err_expr_call())
    end
    let r = err_parse_args_loop(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    if not tok_is_punct_text(tokens, r.2, ")"):
        return err_parse_fail_current(207, tokens, r.2, ctx)
    end
    return err_parse_ok_extra(r.2 + 1, err_expr_call())
end

func err_parse_args_loop(tokens, pos, ctx):
    let r = err_parse_expr(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    if tok_is_punct_text(tokens, r.2, ","):
        return err_parse_args_loop(tokens, r.2 + 1, ctx)
    end
    return err_parse_ok(r.2)
end

func err_parse_group_or_tuple(tokens, pos, ctx):
    let r = err_parse_expr(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    if tok_is_punct_text(tokens, r.2, ","):
        let tr = err_parse_tuple_tail(tokens, r.2 + 1, ctx)
        if tr.0 == err_err_tag():
            return tr
        end
        if not tok_is_punct_text(tokens, tr.2, ")"):
            return err_parse_fail_current(207, tokens, tr.2, ctx)
        end
        return err_parse_ok_extra(tr.2 + 1, err_expr_other())
    end
    if not tok_is_punct_text(tokens, r.2, ")"):
        return err_parse_fail_current(207, tokens, r.2, ctx)
    end
    return err_parse_ok_extra(r.2 + 1, r.3)
end

func err_parse_tuple_tail(tokens, pos, ctx):
    let r = err_parse_expr(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    if tok_is_punct_text(tokens, r.2, ","):
        return err_parse_tuple_tail(tokens, r.2 + 1, ctx)
    end
    return err_parse_ok(r.2)
end

func err_parse_body(tokens, pos, ctx, seen_count):
    if is_body_terminator(tokens, pos):
        return err_parse_ok_extra(pos, seen_count)
    end
    let r = err_parse_stmt(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_body(tokens, r.2, ctx, seen_count + 1)
end

func err_parse_stmt(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    if pos >= count(tokens):
        return err_parse_fail_at(205, line)
    end
    let t = get(tokens, pos)
    if t.0 != 0:
        return err_parse_fail_at(205, line)
    end
    let text = t.1
    if equal(text, "let"):
        return err_parse_let(tokens, pos + 1, ctx)
    end
    if equal(text, "return"):
        let r = err_parse_expr(tokens, pos + 1, ctx)
        if r.0 == err_err_tag():
            return r
        end
        return err_parse_ok(r.2)
    end
    if equal(text, "do"):
        return err_parse_do(tokens, pos + 1, ctx, line)
    end
    if equal(text, "if"):
        return err_parse_if(tokens, pos + 1, ctx, line)
    end
    if equal(text, "while"):
        return err_parse_while(tokens, pos + 1, ctx, line)
    end
    if err_is_reserved_word(text):
        return err_parse_fail_at(205, line)
    end
    return err_parse_assign(tokens, pos, ctx)
end

func err_parse_let(tokens, pos, ctx):
    if not err_is_valid_name_token(tokens, pos):
        return err_parse_fail_current(212, tokens, pos, ctx)
    end
    if not tok_is_op_text(tokens, pos + 1, "="):
        return err_parse_fail_current(212, tokens, pos + 1, ctx)
    end
    let r = err_parse_expr(tokens, pos + 2, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_ok(r.2)
end

func err_parse_assign(tokens, pos, ctx):
    if not err_is_valid_name_token(tokens, pos):
        return err_parse_fail_current(212, tokens, pos, ctx)
    end
    if err_has_records(ctx) and tok_is_punct_text(tokens, pos + 1, ".") and err_is_valid_name_token(tokens, pos + 2) and tok_is_op_text(tokens, pos + 3, "="):
        let fr = err_parse_expr(tokens, pos + 4, ctx)
        if fr.0 == err_err_tag():
            return fr
        end
        return err_parse_ok(fr.2)
    end
    if not tok_is_op_text(tokens, pos + 1, "="):
        return err_parse_fail_current(212, tokens, pos, ctx)
    end
    let r = err_parse_expr(tokens, pos + 2, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_ok(r.2)
end

func err_parse_do(tokens, pos, ctx, do_line):
    let r = err_parse_expr(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    -- new_array is call-shaped too. Whether a callee is permitted in a do
    -- statement belongs to native semantic checking, not this structural pass.
    if r.3 != err_expr_call() and r.3 != err_expr_new_array():
        return err_parse_fail_at(205, do_line)
    end
    return err_parse_ok(r.2)
end

func err_parse_if(tokens, pos, ctx, if_line):
    let cr = err_parse_expr(tokens, pos, ctx)
    if cr.0 == err_err_tag():
        return cr
    end
    if not tok_is_punct_text(tokens, cr.2, ":"):
        return err_parse_fail_current(204, tokens, cr.2, ctx)
    end
    let br = err_parse_body(tokens, cr.2 + 1, ctx, 0)
    if br.0 == err_err_tag():
        return br
    end
    if br.3 == 0:
        return err_parse_fail_at(210, if_line)
    end
    let ar = err_parse_elifs(tokens, br.2, ctx, if_line)
    if ar.0 == err_err_tag():
        return ar
    end
    pos = ar.2
    if tok_is_ident_text(tokens, pos, "else"):
        let er = err_parse_else(tokens, pos + 1, ctx, if_line)
        if er.0 == err_err_tag():
            return er
        end
        pos = er.2
    end
    if not tok_is_ident_text(tokens, pos, "end"):
        return err_parse_fail_current(203, tokens, pos, ctx)
    end
    return err_parse_ok(pos + 1)
end

-- while EXPR ':' body 'end'. The same codes as an if arm, except that an
-- empty body is 214 so the message can name the loop.
func err_parse_while(tokens, pos, ctx, while_line):
    let cr = err_parse_expr(tokens, pos, ctx)
    if cr.0 == err_err_tag():
        return cr
    end
    if not tok_is_punct_text(tokens, cr.2, ":"):
        return err_parse_fail_current(204, tokens, cr.2, ctx)
    end
    let br = err_parse_body(tokens, cr.2 + 1, ctx, 0)
    if br.0 == err_err_tag():
        return br
    end
    if br.3 == 0:
        return err_parse_fail_at(214, while_line)
    end
    if not tok_is_ident_text(tokens, br.2, "end"):
        return err_parse_fail_current(203, tokens, br.2, ctx)
    end
    return err_parse_ok(br.2 + 1)
end

func err_parse_elifs(tokens, pos, ctx, if_line):
    if tok_is_ident_text(tokens, pos, "elif"):
        let cr = err_parse_expr(tokens, pos + 1, ctx)
        if cr.0 == err_err_tag():
            return cr
        end
        if not tok_is_punct_text(tokens, cr.2, ":"):
            return err_parse_fail_current(204, tokens, cr.2, ctx)
        end
        let br = err_parse_body(tokens, cr.2 + 1, ctx, 0)
        if br.0 == err_err_tag():
            return br
        end
        if br.3 == 0:
            return err_parse_fail_at(210, if_line)
        end
        return err_parse_elifs(tokens, br.2, ctx, if_line)
    end
    return err_parse_ok(pos)
end

func err_parse_else(tokens, pos, ctx, if_line):
    if not tok_is_punct_text(tokens, pos, ":"):
        return err_parse_fail_current(203, tokens, pos, ctx)
    end
    let br = err_parse_body(tokens, pos + 1, ctx, 0)
    if br.0 == err_err_tag():
        return br
    end
    if br.3 == 0:
        return err_parse_fail_at(210, if_line)
    end
    return err_parse_ok(br.2)
end

func err_parse_param_loop(tokens, pos, ctx, params):
    if not err_is_valid_name_token(tokens, pos):
        return err_parse_fail_current(202, tokens, pos, ctx)
    end
    let param_tok = get(tokens, pos)
    let name = param_tok.1
    if err_name_seen(params, name):
        return err_parse_fail_payload(311, param_tok.2, name)
    end
    do add(params, name)
    if tok_is_punct_text(tokens, pos + 1, ","):
        return err_parse_param_loop(tokens, pos + 2, ctx, params)
    end
    return err_parse_ok_extra(pos + 1, count(params))
end

func err_parse_param_list(tokens, pos, ctx):
    let params = new_array(string)
    if tok_is_punct_text(tokens, pos, ")"):
        return err_parse_ok_extra(pos, 0)
    end
    return err_parse_param_loop(tokens, pos, ctx, params)
end

func err_parse_func(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    if not err_is_valid_name_token(tokens, pos + 1):
        return err_parse_fail_current(202, tokens, pos + 1, ctx)
    end
    if not tok_is_punct_text(tokens, pos + 2, "("):
        return err_parse_fail_current(202, tokens, pos + 2, ctx)
    end
    let pr = err_parse_param_list(tokens, pos + 3, ctx)
    if pr.0 == err_err_tag():
        return pr
    end
    if not tok_is_punct_text(tokens, pr.2, ")"):
        return err_parse_fail_current(202, tokens, pr.2, ctx)
    end
    if not tok_is_punct_text(tokens, pr.2 + 1, ":"):
        return err_parse_fail_current(202, tokens, pr.2 + 1, ctx)
    end
    let br = err_parse_body(tokens, pr.2 + 2, ctx, 0)
    if br.0 == err_err_tag():
        return br
    end
    if br.3 == 0:
        return err_parse_fail_at(209, line)
    end
    if not tok_is_ident_text(tokens, br.2, "end"):
        return err_parse_fail_current(203, tokens, br.2, ctx)
    end
    return err_parse_ok(br.2 + 1)
end

func err_parse_program_loop(tokens, pos, ctx):
    if pos >= count(tokens):
        return err_parse_ok(pos)
    end
    if err_is_ref_record_head(tokens, pos):
        let rf = err_parse_record(tokens, pos + 1, ctx)
        if rf.0 == err_err_tag():
            return rf
        end
        return err_parse_program_loop(tokens, rf.2, ctx)
    end
    if err_is_record_head(tokens, pos):
        let rr = err_parse_record(tokens, pos, ctx)
        if rr.0 == err_err_tag():
            return rr
        end
        return err_parse_program_loop(tokens, rr.2, ctx)
    end
    if not tok_is_ident_text(tokens, pos, "func"):
        return err_parse_fail_current(201, tokens, pos, ctx)
    end
    let r = err_parse_func(tokens, pos, ctx)
    if r.0 == err_err_tag():
        return r
    end
    return err_parse_program_loop(tokens, r.2, ctx)
end

-- A program that declares records may use their names as types and may use
-- field syntax (e.FIELD, x.FIELD = e). The names come from a token scan for a
-- top-level `record NAME :`; without one, field syntax and named types stay
-- structural errors (206, 211, 212).
func err_is_record_head(tokens, pos):
    if not tok_is_ident_text(tokens, pos, "record"):
        return false
    end
    if not err_is_valid_name_token(tokens, pos + 1):
        return false
    end
    return tok_is_punct_text(tokens, pos + 2, ":")
end

-- Only a declaration at the top level counts: the scan tracks block depth
-- (func, if, while and a record head open a block, end closes one), so the
-- same tokens inside a function body leave the program record-free.
func err_is_ref_record_head(tokens, pos):
    return tok_is_ident_text(tokens, pos, "ref") and err_is_record_head(tokens, pos + 1)
end

func err_record_names_scan(tokens, pos, names, depth):
    if pos >= count(tokens):
        return names
    end
    if depth == 0 and err_is_ref_record_head(tokens, pos):
        do add(names, get(tokens, pos + 2).1)
        return err_record_names_scan(tokens, pos + 4, names, 1)
    end
    if depth == 0 and err_is_record_head(tokens, pos):
        do add(names, get(tokens, pos + 1).1)
        return err_record_names_scan(tokens, pos + 3, names, 1)
    end
    if tok_is_ident_text(tokens, pos, "func") or tok_is_ident_text(tokens, pos, "if") or tok_is_ident_text(tokens, pos, "while"):
        return err_record_names_scan(tokens, pos + 1, names, depth + 1)
    end
    if depth > 0 and tok_is_ident_text(tokens, pos, "end"):
        return err_record_names_scan(tokens, pos + 1, names, depth - 1)
    end
    return err_record_names_scan(tokens, pos + 1, names, depth)
end

func err_is_record_name(ctx, name):
    return err_name_seen(ctx.1, name)
end

func err_has_records(ctx):
    return count(ctx.1) > 0
end

-- record NAME: FIELD: TYPE ... end, with at least two fields (ERR 213).
func err_parse_record_fields(tokens, pos, ctx, n_fields, record_line):
    if tok_is_ident_text(tokens, pos, "end"):
        if n_fields < 2:
            return err_parse_fail_at(213, record_line)
        end
        return err_parse_ok(pos + 1)
    end
    if not err_is_valid_name_token(tokens, pos):
        return err_parse_fail_at(213, err_token_line(tokens, pos, ctx))
    end
    if not tok_is_punct_text(tokens, pos + 1, ":"):
        return err_parse_fail_at(213, err_token_line(tokens, pos + 1, ctx))
    end
    let t = err_parse_type(tokens, pos + 2, ctx)
    if t.0 == err_err_tag():
        return t
    end
    return err_parse_record_fields(tokens, t.2, ctx, n_fields + 1, record_line)
end

func err_parse_record(tokens, pos, ctx):
    let line = err_token_line(tokens, pos, ctx)
    let name = get(tokens, pos + 1).1
    if equal(name, "record") or equal(name, "ref"):
        return err_parse_fail_at(213, line)
    end
    return err_parse_record_fields(tokens, pos + 3, ctx, 0, line)
end

func err_parse_program(tokens, eof_line):
    let names = err_record_names_scan(tokens, 0, new_array(string), 0)
    return err_parse_program_loop(tokens, 0, (eof_line, names))
end

func err_is_builtin_name(name):
    if nc_is_hosted_memory_builtin(name):
        return true
    end
    if equal(name, "boot_read"):
        return true
    end
    if equal(name, "length") or equal(name, "index") or equal(name, "slice"):
        return true
    end
    if equal(name, "equal") or equal(name, "new_buffer") or equal(name, "freeze"):
        return true
    end
    if equal(name, "new_array") or equal(name, "get") or equal(name, "count"):
        return true
    end
    if equal(name, "bufbase") or equal(name, "bufget") or equal(name, "bufset"):
        return true
    end
    if equal(name, "process_exit") or equal(name, "stderr_write") or equal(name, "stdin_read"):
        return true
    end
    return equal(name, "append") or equal(name, "add") or equal(name, "clogger") or equal(name, "flogger") or equal(name, "fwriter") or equal(name, "input_byte") or equal(name, "module_byte") or equal(name, "sys_read") or equal(name, "sys_write") or equal(name, "yield") or equal(name, "output_byte")
end

func err_is_void_builtin(name):
    return equal(name, "append") or equal(name, "add") or equal(name, "flogger") or equal(name, "fwriter") or equal(name, "process_exit")
end

func err_value_builtin_arity(name):
    if equal(name, "linux_syscall6"):
        return 7
    end
    if equal(name, "buffer_address") or equal(name, "buffer_length"):
        return 1
    end
    if equal(name, "buffer_get"):
        return 2
    end
    if equal(name, "buffer_set"):
        return 3
    end
    if equal(name, "boot_read"):
        return 0
    end
    if equal(name, "stdin_read"):
        return 0
    end
    if equal(name, "stderr_write"):
        return 1
    end
    if equal(name, "length"):
        return 1
    end
    if equal(name, "index"):
        return 2
    end
    if equal(name, "equal"):
        return 2
    end
    if equal(name, "new_buffer"):
        return 0
    end
    if equal(name, "freeze"):
        return 1
    end
    if equal(name, "get"):
        return 2
    end
    if equal(name, "count"):
        return 1
    end
    if equal(name, "sys_write"):
        return 1
    end
    if equal(name, "output_byte"):
        return 1
    end
    if equal(name, "yield"):
        return 1
    end
    if equal(name, "bufget"):
        return 2
    end
    if equal(name, "bufset"):
        return 3
    end
    if equal(name, "input_byte") or equal(name, "module_byte") or equal(name, "sys_read") or equal(name, "bufbase"):
        return 0
    end
    return 0
end

func err_void_builtin_arity(name):
    if equal(name, "process_exit"):
        return 1
    end
    if equal(name, "fwriter"):
        return 1
    end
    if equal(name, "flogger"):
        return 1
    end
    return 2
end

-- ====================================================================
-- NATIVE CODEGEN LINK 4 BACK END
-- ====================================================================

func nc_diag_msg(code, payload):
    if code == 401:
        return "native-subset: bare clogger() call not allowed; use let h=clogger() then index(h,k)"
    end
    if code == 402:
        return "native-subset: index() must be called as index(<input-handle>,<int-literal>)"
    end
    if code == 403:
        return "native-subset: input handle must only be used as index(h,k); cannot return/pass/use-in-arithmetic/re-store it"
    end
    if code == 404:
        return diagnostic_with_payload("native-subset: forbidden construct '", payload, "'")
    end
    if code == 408:
        return diagnostic_with_payload("native-subset: forbidden bytecode opcode '", payload, "'")
    end
    if code == 409:
        return diagnostic_with_payload("native-subset: user-defined function calls are forbidden '", payload, "'")
    end
    if code == 411:
        if equal(payload, "stdin_read"):
            return "native-subset: more than one input operation (clogger()/stdin_read()) is not allowed"
        end
        return "native-subset: more than one clogger() call is not allowed"
    end
    if code == 412:
        return diagnostic_with_payload("native-subset: expected int expression", payload, "")
    end
    if code == 413:
        return diagnostic_with_payload("native-subset: expected bool expression", payload, "")
    end
    if code == 414:
        return "native-subset: branch join has conflicting local classes"
    end
    if code == 415:
        return diagnostic_with_payload("native-subset: invalid branch target ", payload, "")
    end
    if code == 416:
        return "native-subset: stack depth mismatch or underflow"
    end
    if code == 417:
        return "native-subset: bad push_bool payload"
    end
    if code == 418:
        return diagnostic_with_payload("native-subset: native layout invariant failed ", payload, "")
    end
    if code == 419:
        return diagnostic_with_payload("native-subset: unknown callee '", payload, "'")
    end
    if code == 420:
        return diagnostic_with_payload("native-subset: arity mismatch at call to '", payload, "'")
    end
    if code == 421:
        return "native-subset: user functions may not call main"
    end
    if code == 422:
        return "native-subset: argument/parameter class conflict"
    end
    if code == 423:
        return "native-subset: return class conflict"
    end
    if code == 424:
        return "native-subset: ambiguous or unconstrained function signature"
    end
    if code == 425:
        return "native-subset: input handle crosses a function boundary"
    end
    if code == 426:
        return "native-subset: invalid bytecode CALL target or arity"
    end
    if code == 427:
        return "native-subset: call/jmp/branch rel32 out of range"
    end
    if code == 428:
        return "native-subset: frame, signed displacement, or layout overflow"
    end
    if code == 429:
        return "native-subset: invalid function table"
    end
    if code == 430:
        return "native-subset: structural type conflict"
    end
    if code == 431:
        return "native-subset: tuple access on non-tuple or out of range"
    end
    if code == 432:
        return "native-subset: main must return int or bool"
    end
    if code == 433:
        return "native-subset: local rebind changes value width"
    end
    if code == 434:
        return "native-subset: invalid new_array type expression"
    end
    if code == 435:
        return "native-subset: array operation on non-array"
    end
    if code == 436:
        return "native-subset: array element type mismatch"
    end
    if code == 437:
        return "native-subset: buffer operation on non-buffer"
    end
    if code == 438:
        return "native-subset: deferred native operation"
    end
    if code == 439:
        return "native-subset: missing NEW_ARRAY metadata"
    end
    if code == 440:
        return "native-subset: value-less builtin used as a value"
    end
    if code == 441:
        return "native-subset: polymorphic instantiation does not terminate"
    end
    if code == 442:
        return "native-subset: bitwise/shift operator mixed with another operator class without parentheses"
    end
    if code == 444:
        return diagnostic_with_payload("native-subset: no field '", payload, "' in this record")
    end
    if code == 445:
        return "native-subset: a record's fields are read by name, not by position"
    end
    if code == 446:
        return diagnostic_with_payload("native-subset: field '", payload, "' used on a value that is not a record")
    end
    if code == 448:
        return "native-subset: a record construction is not a statement"
    end
    -- Kernel-route codes carry their own text, which names the route and the rule.
    if code > 442 and length(payload) > 0:
        return diagnostic_with_payload("native-subset: ", payload, "")
    end
    return "native-subset: unknown error"
end

func nc_serialize_diag(code, line, payload):
    let msg = nc_diag_msg(code, payload)
    let buf = new_buffer()
    if line > 0:
        buf = append_str(buf, "line ")
        buf = append_str(buf, int_to_str(line))
        buf = append_str(buf, ": ")
    else:
        buf = append_str(buf, "program: ")
    end
    buf = append_str(buf, msg)
    buf = append_str(buf, " (ERR ")
    buf = append_str(buf, int_to_str(code))
    buf = append_str(buf, ")")
    return freeze(buf)
end

func nc_fail(code, line, payload):
    do stderr_write(nc_serialize_diag(code, line, payload))
    do stderr_write("\n")
    do process_exit(1)
    return 1
end

func nc_type_unknown():
    return 0
end

func nc_type_int():
    return 1
end

func nc_type_bool():
    return 2
end

func nc_type_string():
    return 3
end

func nc_type_buffer():
    return 4
end

func nc_type_struct_base():
    return 5
end

-- Pool fields: interned types, inference phases, retained diagnostics.
-- Phase 3 keeps the usual immediate errors outside signature inference.
func nc_type_pool_new():
    let phases = new_array((int, int))
    do add(phases, (3, 0))
    return (new_array((int, array(int))), phases, new_array((int, int, string)))
end

func nc_infer_phase(pool):
    return get(pool.1, count(pool.1) - 1)
end

-- A failed speculative scalar rebind can poison a return or call target.
-- Retain the first conflict so inference can retry without publishing an error.
-- A failed retry must still report the original error, including its payload.
func nc_infer_fail(pool, code, line, payload):
    let phase = nc_infer_phase(pool)
    if phase.0 == 3:
        return nc_fail(code, line, payload)
    end
    if count(pool.2) > phase.1:
        return 1
    end
    if code != 430 and phase.0 != 2:
        return nc_fail(code, line, payload)
    end
    do add(pool.2, (code, line, payload))
    return 1
end

-- After a successful retry the first attempt's diagnostic is still in the
-- pool: phase entry i - 1, the one before phase 2, indexes it.
func nc_retry_before_index(phases, i, n):
    if i >= n:
        return 0 - 1
    end
    if get(phases, i).0 == 2 and i > 0:
        return i - 1
    end
    return nc_retry_before_index(phases, i + 1, n)
end

func nc_retry_used(pool):
    return nc_retry_before_index(pool.1, 0, count(pool.1)) != 0 - 1
end

func nc_retry_diag_fail(pool, code, line, payload):
    let before = nc_retry_before_index(pool.1, 0, count(pool.1))
    if before != 0 - 1:
        let entered = get(pool.1, before)
        if entered.1 < count(pool.2):
            let original = get(pool.2, entered.1)
            return nc_fail(original.0, original.1, original.2)
        end
    end
    return nc_fail(code, line, payload)
end

func nc_type_kind(pool, t):
    if t < nc_type_struct_base():
        return 0
    end
    return get(pool.0, t - nc_type_struct_base()).0
end

func nc_type_children(pool, t):
    return get(pool.0, t - nc_type_struct_base()).1
end

func nc_type_is_tuple(pool, t):
    return nc_type_kind(pool, t) == 1
end

func nc_type_is_array(pool, t):
    return nc_type_kind(pool, t) == 2
end

func nc_type_tuple_children(pool, t):
    return nc_type_children(pool, t)
end

-- A record's type is a pool entry whose kind is 1000 plus its declaration's
-- node index and whose children are its field types: nominal to inference,
-- laid out as the tuple of its fields everywhere else (see nc_type_erase).
func nc_record_kind_base():
    return 1000
end

-- Value records are kind 1000 plus the declaration's node index, as in R1;
-- ref records (one heap word, fields updated in place) are 2^32 + 1000 plus
-- it, far above any node index, so the two ranges never meet however large
-- the program (a boundary at 2000 misread a record declared after node 1000).
func nc_ref_record_kind_base():
    return 4294968296
end

func nc_type_is_record(pool, t):
    let k = nc_type_kind(pool, t)
    return k >= nc_record_kind_base() and k < nc_ref_record_kind_base()
end

func nc_type_is_ref_record(pool, t):
    return nc_type_kind(pool, t) >= nc_ref_record_kind_base()
end

func nc_type_any_record(pool, t):
    return nc_type_kind(pool, t) >= nc_record_kind_base()
end

func nc_type_record_decl(pool, t):
    if nc_type_is_ref_record(pool, t):
        return nc_type_kind(pool, t) - nc_ref_record_kind_base()
    end
    return nc_type_kind(pool, t) - nc_record_kind_base()
end

func nc_type_array_elem(pool, t):
    return get(nc_type_children(pool, t), 0)
end

-- link12 (D14 string/nested): a result type the native back end can canonically
-- render is int, bool, string, or a tuple (>= 2 children) whose every element is
-- itself renderable -- recursively. (Arrays/buffers as result/element are a later
-- D14 installment and still ERR432.) This SUPERSEDES the garland flat-int/bool
-- predicate at the main-return gate; a flat int/bool tuple is the special case
-- where every leaf is int/bool, and renders byte-identically (the plan below emits
-- the same primitives at the same word offsets).
func nc_renderable_kids_loop(pool, kids, i, n):
    if i >= n:
        return true
    end
    if not nc_type_renderable_rec(pool, get(kids, i)):
        return false
    end
    return nc_renderable_kids_loop(pool, kids, i + 1, n)
end

func nc_type_renderable_rec(pool, t):
    if t == nc_type_int() or t == nc_type_bool() or t == nc_type_string():
        return true
    end
    if nc_type_is_tuple(pool, t) or nc_type_is_record(pool, t):
        let kids = nc_type_tuple_children(pool, t)
        let n = count(kids)
        if n < 2:
            return false
        end
        return nc_renderable_kids_loop(pool, kids, 0, n)
    end
    return false
end

-- A renderable AGGREGATE (the entry-stub render-head case): renderable AND width
-- 2..15 result words. The 15-word cap keeps every render disp/imm at the byte
-- encoding the layout-length math assumes (the staging slot at [rsp+8W] needs a
-- disp8, and the per-element [rsp+8w] loads too). A bare string is width 2; a
-- scalar int/bool is width 1 (the kringle single-word path, not this one).
func nc_type_is_renderable_aggregate(pool, t):
    if not nc_type_renderable_rec(pool, t):
        return false
    end
    let w = nc_type_width(pool, t)
    if w < 2:
        return false
    end
    if w > 15:
        return false
    end
    return true
end

-- Linearize a renderable result type into a flat RENDER PLAN of tokens (kind, arg)
-- consumed identically by the byte-length pass (nc_rplan_body_len) and the emitter
-- (nc_emit_rplan) -- so the length/emit lockstep is structural, not a fragile
-- parallel recursion. Token kinds:
--   0 PUTC  arg=byte  : write one literal byte         (20 bytes)  '(' ')' '\n'
--   1 PUTSEP          : write ", "                      (22 bytes)
--   2 RINT  arg=word  : render int  at result word arg (10 bytes)
--   3 RBOOL arg=word  : render bool at result word arg (10 bytes)
--   4 RSTR  arg=word  : render str  at words arg,arg+1 (15 bytes)
-- Result words are the flattened sret buffer; a string is 2 words (ptr at w,
-- length at w+1: nc_emit_push_str pushes ptr then length, nc_emit_ret stores them
-- low->high). A nested tuple flattens contiguously, so the word offset accumulates
-- by each element's width (int/bool +1, string +2).
func nc_build_plan_kids(pool, kids, i, n, word, out):
    if i >= n:
        return (out, word)
    end
    if i > 0:
        do add(out, (1, 0))
    end
    let r = nc_build_plan_rec(pool, get(kids, i), word, out)
    return nc_build_plan_kids(pool, kids, i + 1, n, r.1, r.0)
end

func nc_build_plan_rec(pool, t, word, out):
    if t == nc_type_int():
        do add(out, (2, word))
        return (out, word + 1)
    end
    if t == nc_type_bool():
        do add(out, (3, word))
        return (out, word + 1)
    end
    if t == nc_type_string():
        do add(out, (4, word))
        return (out, word + 2)
    end
    do add(out, (0, 40))
    let kids = nc_type_tuple_children(pool, t)
    let r = nc_build_plan_kids(pool, kids, 0, count(kids), word, out)
    do add(r.0, (0, 41))
    return (r.0, r.1)
end

func nc_build_render_plan(pool, t):
    let out = new_array((int, int))
    if not nc_type_is_renderable_aggregate(pool, t):
        return out
    end
    let r = nc_build_plan_rec(pool, t, 0, out)
    do add(r.0, (0, 10))
    return r.0
end

func nc_type_equal_children(pool, a, b, i, n):
    if i >= n:
        return true
    end
    if not nc_type_equal(pool, get(a, i), get(b, i)):
        return false
    end
    return nc_type_equal_children(pool, a, b, i + 1, n)
end

func nc_type_equal(pool, a, b):
    if a == b:
        return true
    end
    if nc_type_kind(pool, a) != 0 and nc_type_kind(pool, a) == nc_type_kind(pool, b):
        let ca = nc_type_children(pool, a)
        let cb = nc_type_children(pool, b)
        if count(ca) != count(cb):
            return false
        end
        return nc_type_equal_children(pool, ca, cb, 0, count(ca))
    end
    return false
end

func nc_type_tuple_matches_loop(pool, children, existing, i, n):
    if i >= n:
        return true
    end
    if not nc_type_equal(pool, get(children, i), get(existing, i)):
        return false
    end
    return nc_type_tuple_matches_loop(pool, children, existing, i + 1, n)
end

func nc_type_struct_matches(pool, kind, children, type_id):
    if nc_type_kind(pool, type_id) != kind:
        return false
    end
    let existing = nc_type_children(pool, type_id)
    if count(children) != count(existing):
        return false
    end
    return nc_type_tuple_matches_loop(pool, children, existing, 0, count(children))
end

func nc_type_intern_struct_loop(pool, kind, children, i, n):
    if i >= n:
        let id = count(pool.0) + nc_type_struct_base()
        do add(pool.0, (kind, children))
        return id
    end
    let tid = i + nc_type_struct_base()
    if nc_type_struct_matches(pool, kind, children, tid):
        return tid
    end
    return nc_type_intern_struct_loop(pool, kind, children, i + 1, n)
end

func nc_type_intern_tuple(pool, children):
    return nc_type_intern_struct_loop(pool, 1, children, 0, count(pool.0))
end

func nc_type_stdin_result(pool):
    -- Intern lazily so programs without checked input retain their type IDs.
    let kids = new_array(int)
    do add(kids, nc_type_int())
    do add(kids, nc_type_string())
    return nc_type_intern_tuple(pool, kids)
end

func nc_type_intern_array(pool, elem):
    let kids = new_array(int)
    do add(kids, elem)
    return nc_type_intern_struct_loop(pool, 2, kids, 0, count(pool.0))
end

func nc_type_width_tuple(pool, kids, i, n, acc):
    if i >= n:
        return acc
    end
    return nc_type_width_tuple(pool, kids, i + 1, n, acc + nc_type_width(pool, get(kids, i)))
end

func nc_type_width(pool, t):
    if t == nc_type_unknown():
        return 0
    end
    if t == nc_type_int() or t == nc_type_bool():
        return 1
    end
    if t == nc_type_string():
        return 2
    end
    if t == nc_type_buffer():
        return 1
    end
    if nc_type_is_array(pool, t) or nc_type_is_ref_record(pool, t):
        return 1
    end
    let kids = nc_type_tuple_children(pool, t)
    return nc_type_width_tuple(pool, kids, 0, count(kids), 0)
end

func nc_type_has_unknown_tuple(pool, kids, i, n):
    if i >= n:
        return false
    end
    if nc_type_has_unknown(pool, get(kids, i)):
        return true
    end
    return nc_type_has_unknown_tuple(pool, kids, i + 1, n)
end

func nc_type_has_unknown(pool, t):
    if t == nc_type_unknown():
        return true
    end
    if nc_type_kind(pool, t) != 0:
        let kids = nc_type_children(pool, t)
        return nc_type_has_unknown_tuple(pool, kids, 0, count(kids))
    end
    return false
end

func nc_type_vector_has_unknown(pool, vec, i, n):
    if i >= n:
        return false
    end
    if nc_type_has_unknown(pool, get(vec, i)):
        return true
    end
    return nc_type_vector_has_unknown(pool, vec, i + 1, n)
end

func nc_type_vector_equal_loop(pool, a, b, i, n):
    if i >= n:
        return true
    end
    if not nc_type_equal(pool, get(a, i), get(b, i)):
        return false
    end
    return nc_type_vector_equal_loop(pool, a, b, i + 1, n)
end

func nc_type_vector_equal(pool, a, b):
    if count(a) != count(b):
        return false
    end
    return nc_type_vector_equal_loop(pool, a, b, 0, count(a))
end

func nc_type_embeds_any_child(pool, a, kids, i, n):
    if i >= n:
        return false
    end
    if nc_type_embeds(pool, a, get(kids, i)):
        return true
    end
    return nc_type_embeds_any_child(pool, a, kids, i + 1, n)
end

func nc_type_embeds_tuple_positions(pool, a, b, i, n):
    if i >= n:
        return true
    end
    if not nc_type_embeds(pool, get(a, i), get(b, i)):
        return false
    end
    return nc_type_embeds_tuple_positions(pool, a, b, i + 1, n)
end

func nc_type_embeds(pool, a, b):
    if nc_type_equal(pool, a, b):
        return true
    end
    if nc_type_is_tuple(pool, b):
        let bkids = nc_type_tuple_children(pool, b)
        if nc_type_embeds_any_child(pool, a, bkids, 0, count(bkids)):
            return true
        end
    end
    if nc_type_is_array(pool, b):
        if nc_type_embeds(pool, a, nc_type_array_elem(pool, b)):
            return true
        end
    end
    if nc_type_is_tuple(pool, a) and nc_type_is_tuple(pool, b):
        let akids = nc_type_tuple_children(pool, a)
        let bkids2 = nc_type_tuple_children(pool, b)
        if count(akids) == count(bkids2):
            return nc_type_embeds_tuple_positions(pool, akids, bkids2, 0, count(akids))
        end
    end
    if nc_type_is_array(pool, a) and nc_type_is_array(pool, b):
        return nc_type_embeds(pool, nc_type_array_elem(pool, a), nc_type_array_elem(pool, b))
    end
    return false
end

func nc_poly_vector_embeds_loop(pool, old_args, new_args, i, n, strict):
    if i >= n:
        return strict
    end
    if not nc_type_embeds(pool, get(old_args, i), get(new_args, i)):
        return false
    end
    if not nc_type_equal(pool, get(old_args, i), get(new_args, i)):
        strict = true
    end
    return nc_poly_vector_embeds_loop(pool, old_args, new_args, i + 1, n, strict)
end

func nc_poly_vector_grows(pool, old_args, new_args):
    if count(old_args) != count(new_args):
        return false
    end
    return nc_poly_vector_embeds_loop(pool, old_args, new_args, 0, count(old_args), false)
end

func nc_type_merge_possible_children(pool, a, b, i, n):
    if i >= n:
        return true
    end
    if not nc_type_merge_possible(pool, get(a, i), get(b, i)):
        return false
    end
    return nc_type_merge_possible_children(pool, a, b, i + 1, n)
end

func nc_type_merge_possible(pool, old, want):
    if old == nc_type_unknown() or want == nc_type_unknown():
        return true
    end
    if nc_type_equal(pool, old, want):
        return true
    end
    if nc_type_is_array(pool, old) and nc_type_is_array(pool, want):
        return nc_type_merge_possible(pool, nc_type_array_elem(pool, old), nc_type_array_elem(pool, want))
    end
    if nc_type_is_tuple(pool, old) and nc_type_is_tuple(pool, want):
        let oa = nc_type_tuple_children(pool, old)
        let wa = nc_type_tuple_children(pool, want)
        if count(oa) != count(wa):
            return false
        end
        return nc_type_merge_possible_children(pool, oa, wa, 0, count(oa))
    end
    return false
end

func nc_type_has_array_unknown(pool, t):
    if nc_type_is_array(pool, t):
        if nc_type_has_unknown(pool, nc_type_array_elem(pool, t)):
            return true
        end
    end
    if nc_type_is_tuple(pool, t):
        return nc_type_has_array_unknown_children(pool, nc_type_tuple_children(pool, t), 0, count(nc_type_tuple_children(pool, t)))
    end
    return false
end

func nc_type_has_array_unknown_children(pool, kids, i, n):
    if i >= n:
        return false
    end
    if nc_type_has_array_unknown(pool, get(kids, i)):
        return true
    end
    return nc_type_has_array_unknown_children(pool, kids, i + 1, n)
end

func nc_type_merge_children(pool, a, b, i, n, out, changed, line, cache):
    if i >= n:
        return (0, out, changed)
    end
    let m = nc_type_merge_cached(pool, get(a, i), get(b, i), line, cache)
    if m.0 != 0:
        return (m.0, out, changed)
    end
    do add(out, m.1)
    return nc_type_merge_children(pool, a, b, i + 1, n, out, nc_or_changed(changed, m.2), line, cache)
end

func nc_type_merge_struct(pool, old, want, line, cache):
    if nc_type_is_array(pool, old) and nc_type_is_array(pool, want):
        let merged_elem = nc_type_merge_cached(pool, nc_type_array_elem(pool, old), nc_type_array_elem(pool, want), line, cache)
        if merged_elem.0 != 0:
            return (nc_infer_fail(pool, 436, line, ""), old, 0)
        end
        let aid = nc_type_intern_array(pool, merged_elem.1)
        if nc_type_equal(pool, aid, old):
            return (0, old, 0)
        end
        return (0, aid, 1)
    end
    if nc_type_is_tuple(pool, old) and nc_type_is_tuple(pool, want):
        let oa = nc_type_tuple_children(pool, old)
        let wa = nc_type_tuple_children(pool, want)
        if count(oa) != count(wa):
            return (nc_infer_fail(pool, 430, line, ""), old, 0)
        end
        let merged = nc_type_merge_children(pool, oa, wa, 0, count(oa), new_array(int), 0, line, cache)
        if merged.0 != 0:
            return (merged.0, old, 0)
        end
        let tid = nc_type_intern_tuple(pool, merged.1)
        if nc_type_equal(pool, tid, old):
            return (0, old, 0)
        end
        return (0, tid, 1)
    end
    return (nc_infer_fail(pool, 430, line, ""), old, 0)
end

-- A growing recursive return can share the same subtree in many tuple
-- positions. Reuse each completed pair within this merge so the syntax-depth
-- bound below is reached without expanding the interned DAG into a tree.
-- Keep the original left-to-right traversal and interning order on first visits.
func nc_type_merge_cache_find(cache, old, want, i):
    if i >= count(cache):
        return 0 - 1
    end
    let entry = get(cache, i)
    if entry.0 == old and entry.1 == want:
        return i
    end
    return nc_type_merge_cache_find(cache, old, want, i + 1)
end

func nc_type_merge_cached(pool, old, want, line, cache):
    if want == nc_type_unknown():
        return (0, old, 0)
    end
    if old == nc_type_unknown():
        return (0, want, 1)
    end
    if nc_type_equal(pool, old, want):
        return (0, old, 0)
    end
    let found = nc_type_merge_cache_find(cache, old, want, 0)
    if found != 0 - 1:
        let entry = get(cache, found)
        return (0, entry.2, entry.3)
    end
    let merged = nc_type_merge_struct(pool, old, want, line, cache)
    if merged.0 == 0:
        do add(cache, (old, want, merged.1, merged.2))
    end
    return merged
end

func nc_type_merge(pool, old, want, line):
    if want == nc_type_unknown():
        return (0, old, 0)
    end
    if old == nc_type_unknown():
        return (0, want, 1)
    end
    if nc_type_equal(pool, old, want):
        return (0, old, 0)
    end
    return nc_type_merge_cached(pool, old, want, line, new_array((int, int, int, int)))
end

func nc_type_is_int_bool(t):
    return t == nc_type_int() or t == nc_type_bool()
end

func nc_type_from_type_expr_children(pool, nodes, kids, i, n, out, line, visiting):
    if i >= n:
        return (0, nc_type_intern_tuple(pool, out))
    end
    let r = nc_type_from_type_expr_v(pool, nodes, get(kids, i), visiting)
    if r.0 != 0:
        return r
    end
    do add(out, r.1)
    return nc_type_from_type_expr_children(pool, nodes, kids, i + 1, n, out, line, visiting)
end

func nc_record_decl_scan(nodes, name, i):
    if i >= count(nodes):
        return 0 - 1
    end
    let node = get(nodes, i)
    if is_record_decl_tag(node.0) and equal(get(node.1, 0), name):
        return i
    end
    return nc_record_decl_scan(nodes, name, i + 1)
end

-- The same search through the program node's list of its records, which is far
-- shorter than the node pool; construction sites look up their record this way.
func nc_record_decl_find_loop(nodes, recs, name, i):
    if i >= count(recs):
        return 0 - 1
    end
    let decl_idx = parse_decimal(get(recs, i))
    if equal(get(get(nodes, decl_idx).1, 0), name):
        return decl_idx
    end
    return nc_record_decl_find_loop(nodes, recs, name, i + 1)
end

func nc_record_decl_find(nodes, prog_idx, name):
    return nc_record_decl_find_loop(nodes, get(nodes, prog_idx).1, name, 0)
end

func nc_record_field_index_loop(atoms, field, i):
    if i >= count(atoms):
        return 0 - 1
    end
    if equal(get(atoms, i), field):
        return i - 1
    end
    return nc_record_field_index_loop(atoms, field, i + 1)
end

-- The field's position, or -1. A record node's atoms are its name, then its fields.
func nc_record_field_index(nodes, decl_idx, field):
    return nc_record_field_index_loop(get(nodes, decl_idx).1, field, 1)
end

func nc_ints_copy_loop(a, i, out):
    if i >= count(a):
        return out
    end
    do add(out, get(a, i))
    return nc_ints_copy_loop(a, i + 1, out)
end

func nc_ints_with(a, v):
    let out = nc_ints_copy_loop(a, 0, new_array(int))
    do add(out, v)
    return out
end

func nc_record_field_types(pool, nodes, kids, i, out, visiting):
    if i >= count(kids):
        return (0, out)
    end
    let r = nc_type_from_type_expr_v(pool, nodes, get(kids, i), visiting)
    if r.0 != 0:
        return (r.0, out)
    end
    do add(out, r.1)
    return nc_record_field_types(pool, nodes, kids, i + 1, out, visiting)
end

-- visiting holds the records being built on this path; meeting one again
-- means a record contains itself, which would make it infinitely wide.
func nc_record_type(pool, nodes, decl_idx, visiting):
    let decl = get(nodes, decl_idx)
    if nc_tuple_int_array_has(visiting, decl_idx, 0, count(visiting)):
        return (nc_infer_fail(pool, 447, decl.3, diagnostic_with_payload("record '", get(decl.1, 0), "' contains itself")), 0)
    end
    let fields = nc_record_field_types(pool, nodes, decl.2, 0, new_array(int), nc_ints_with(visiting, decl_idx))
    if fields.0 != 0:
        return (fields.0, 0)
    end
    let base = nc_record_kind_base()
    if equal(decl.0, "ref-record"):
        base = nc_ref_record_kind_base()
    end
    return (0, nc_type_intern_struct_loop(pool, base + decl_idx, fields.1, 0, count(pool.0)))
end

func nc_type_from_type_expr(pool, nodes, type_idx):
    return nc_type_from_type_expr_v(pool, nodes, type_idx, new_array(int))
end

func nc_type_from_type_expr_v(pool, nodes, type_idx, visiting):
    let node = get(nodes, type_idx)
    if equal(node.0, "type"):
        let name = get(node.1, 0)
        if equal(name, "int"):
            return (0, nc_type_int())
        end
        if equal(name, "bool"):
            return (0, nc_type_bool())
        end
        if equal(name, "string"):
            return (0, nc_type_string())
        end
        if equal(name, "buffer"):
            return (0, nc_type_buffer())
        end
        let decl = nc_record_decl_scan(nodes, name, 0)
        if decl != 0 - 1:
            return nc_record_type(pool, nodes, decl, visiting)
        end
        return (nc_infer_fail(pool, 434, node.3, ""), 0)
    end
    if equal(node.0, "type-array"):
        if count(node.2) != 1:
            return (nc_infer_fail(pool, 434, node.3, ""), 0)
        end
        let elem = nc_type_from_type_expr_v(pool, nodes, get(node.2, 0), visiting)
        if elem.0 != 0:
            return elem
        end
        return (0, nc_type_intern_array(pool, elem.1))
    end
    if equal(node.0, "type-tuple"):
        if count(node.2) < 2:
            return (nc_infer_fail(pool, 434, node.3, ""), 0)
        end
        return nc_type_from_type_expr_children(pool, nodes, node.2, 0, count(node.2), new_array(int), node.3, visiting)
    end
    return (nc_infer_fail(pool, 434, node.3, ""), 0)
end

func nc_assignment_type_ok(pool, old, got):
    if old == nc_type_unknown() or got == nc_type_unknown():
        return true
    end
    if nc_type_equal(pool, old, got):
        return true
    end
    return nc_type_is_int_bool(old) and nc_type_is_int_bool(got)
end

func nc_count_input_expr(nodes, idx, input_name):
    let node = get(nodes, idx)
    let tag = node.0
    let kids = node.2
    if equal(tag, "call"):
        let name = get(node.1, 0)
        if equal(name, input_name):
            return 1
        end
    end
    return nc_count_input_kids(nodes, kids, 0, count(kids), input_name)
end

func nc_count_input_kids(nodes, kids, i, n, input_name):
    if i >= n:
        return 0
    end
    return nc_count_input_expr(nodes, get(kids, i), input_name) + nc_count_input_kids(nodes, kids, i + 1, n, input_name)
end

func nc_count_input_body(nodes, stmts, i, n, input_name):
    if i >= n:
        return 0
    end
    let stmt = get(nodes, get(stmts, i))
    let tag = stmt.0
    let kids = stmt.2
    let here = 0
    if equal(tag, "let") or equal(tag, "assign") or equal(tag, "return") or equal(tag, "field-assign"):
        here = nc_count_input_expr(nodes, get(kids, 0), input_name)
    elif equal(tag, "if"):
        here = nc_count_input_if_arms(nodes, kids, 0, count(kids), input_name)
    elif equal(tag, "while"):
        let wb = get(nodes, get(kids, 1))
        here = nc_count_input_expr(nodes, get(kids, 0), input_name) + nc_count_input_body(nodes, wb.2, 0, count(wb.2), input_name)
    elif equal(tag, "do"):
        here = nc_count_input_expr(nodes, get(kids, 0), input_name)
    end
    return here + nc_count_input_body(nodes, stmts, i + 1, n, input_name)
end

func nc_count_input_if_arms(nodes, kids, i, n, input_name):
    if i >= n:
        return 0
    end
    let arm = get(nodes, get(kids, i))
    let body_idx = 0
    let here = 0
    if equal(arm.0, "else"):
        body_idx = get(arm.2, 0)
    else:
        here = nc_count_input_expr(nodes, get(arm.2, 0), input_name)
        body_idx = get(arm.2, 1)
    end
    let body = get(nodes, body_idx)
    return here + nc_count_input_body(nodes, body.2, 0, count(body.2), input_name) + nc_count_input_if_arms(nodes, kids, i + 1, n, input_name)
end

func nc_check_input_scope(pool, nodes, fn_node):
    let body = get(nodes, get(fn_node.2, 1))
    let legacy = nc_count_input_body(nodes, body.2, 0, count(body.2), "clogger")
    let checked = nc_count_input_body(nodes, body.2, 0, count(body.2), "stdin_read")
    let payload = ""
    if checked > 0:
        payload = "stdin_read"
    end
    if equal(get(fn_node.1, 0), "main"):
        if legacy + checked > 1:
            return nc_infer_fail(pool, 411, fn_node.3, payload)
        end
    elif checked > 0:
        return nc_infer_fail(pool, 404, fn_node.3, "stdin_read")
    elif legacy > 0:
        return nc_infer_fail(pool, 404, fn_node.3, "clogger")
    end
    return 0
end

-- A local environment is (count, names, classes). Names and classes are
-- persistent arrays in chunks of 32 entries: a copy shares every chunk, and a
-- change copies one chunk and the chunk list, so branches and assignments no
-- longer copy every local. Entries at count and above are dead; the next local
-- declared reuses its position. Every environment value stays valid as it was.
func nc_chunk_copy_int(src, i, n, slot, value, out):
    if i >= n:
        if slot == n:
            do add(out, value)
        end
        return out
    end
    if i == slot:
        do add(out, value)
    else:
        do add(out, get(src, i))
    end
    return nc_chunk_copy_int(src, i + 1, n, slot, value, out)
end

func nc_chunk_copy_str(src, i, n, slot, value, out):
    if i >= n:
        if slot == n:
            do add(out, value)
        end
        return out
    end
    if i == slot:
        do add(out, value)
    else:
        do add(out, get(src, i))
    end
    return nc_chunk_copy_str(src, i + 1, n, slot, value, out)
end

func nc_chunks_copy(src, i, n, at, chunk, out):
    if i >= n:
        if at == n:
            do add(out, chunk)
        end
        return out
    end
    if i == at:
        do add(out, chunk)
    else:
        do add(out, get(src, i))
    end
    return nc_chunks_copy(src, i + 1, n, at, chunk, out)
end

func nc_pget(chunks, i):
    return get(get(chunks, i / 32), i % 32)
end

func nc_pset_int(chunks, i, value):
    let at = i / 32
    let old = new_array(int)
    if at < count(chunks):
        old = get(chunks, at)
    end
    let chunk = nc_chunk_copy_int(old, 0, count(old), i % 32, value, new_array(int))
    return nc_chunks_copy(chunks, 0, count(chunks), at, chunk, new_array(array(int)))
end

func nc_pset_str(chunks, i, value):
    let at = i / 32
    let old = new_array(string)
    if at < count(chunks):
        old = get(chunks, at)
    end
    let chunk = nc_chunk_copy_str(old, 0, count(old), i % 32, value, new_array(string))
    return nc_chunks_copy(chunks, 0, count(chunks), at, chunk, new_array(array(string)))
end

func nc_class_env_new():
    return (0, new_array(array(string)), new_array(array(int)))
end

func nc_class_env_count(env):
    return env.0
end

func nc_class_env_class(env, idx):
    return nc_pget(env.2, idx)
end

func nc_class_env_add(env, name, klass):
    let n = env.0
    return (n + 1, nc_pset_str(env.1, n, name), nc_pset_int(env.2, n, klass))
end

func nc_class_env_clone(env):
    return env
end

func nc_class_env_prefix(env, keep):
    return (keep, env.1, env.2)
end

func nc_class_env_lookup_info_loop(env, name, n):
    if n == 0:
        return (0, 0, 0)
    end
    let k = n - 1
    if equal(nc_pget(env.1, k), name):
        return (1, k, nc_pget(env.2, k))
    end
    return nc_class_env_lookup_info_loop(env, name, k)
end

func nc_class_env_lookup_info(env, name):
    return nc_class_env_lookup_info_loop(env, name, env.0)
end

func nc_int_array_set_loop(src, i, n, target, value, out):
    if i >= n:
        return out
    end
    if i == target:
        do add(out, value)
    else:
        do add(out, get(src, i))
    end
    return nc_int_array_set_loop(src, i + 1, n, target, value, out)
end

func nc_int_array_set(src, target, value):
    return nc_int_array_set_loop(src, 0, count(src), target, value, new_array(int))
end

func nc_array_int_set_loop(src, i, n, target, value, out):
    if i >= n:
        return out
    end
    if i == target:
        do add(out, value)
    else:
        do add(out, get(src, i))
    end
    return nc_array_int_set_loop(src, i + 1, n, target, value, out)
end

func nc_array_int_set(src, target, value):
    return nc_array_int_set_loop(src, 0, count(src), target, value, new_array(array(int)))
end

func nc_class_env_set_idx(env, idx, klass):
    return (env.0, env.1, nc_pset_int(env.2, idx, klass))
end

func nc_make_unknowns_loop(i, n, out):
    if i >= n:
        return out
    end
    do add(out, 0)
    return nc_make_unknowns_loop(i + 1, n, out)
end

func nc_make_unknowns(n):
    return nc_make_unknowns_loop(0, n, new_array(int))
end

func nc_sig_init_loop(func_kids, i, n, nodes, params, returns):
    if i >= n:
        return (params, returns)
    end
    let fn = get(nodes, get(func_kids, i))
    let pn = get(nodes, get(fn.2, 0))
    do add(params, nc_make_unknowns(count(pn.1)))
    do add(returns, 0)
    return nc_sig_init_loop(func_kids, i + 1, n, nodes, params, returns)
end

func nc_sig_init(nodes, prog_idx):
    let prog = get(nodes, prog_idx)
    return nc_sig_init_loop(prog.2, 0, count(prog.2), nodes, new_array(array(int)), new_array(int))
end

func nc_sig_get_param(sig, fn_idx, param_idx):
    return get(get(sig.0, fn_idx), param_idx)
end

func nc_sig_get_ret(sig, fn_idx):
    return get(sig.1, fn_idx)
end

func nc_sig_set_param(sig, fn_idx, param_idx, klass):
    let parr = get(sig.0, fn_idx)
    let new_parr = nc_int_array_set(parr, param_idx, klass)
    return (nc_array_int_set(sig.0, fn_idx, new_parr), sig.1)
end

func nc_sig_set_ret(sig, fn_idx, klass):
    return (sig.0, nc_int_array_set(sig.1, fn_idx, klass))
end

func nc_poly_max_instances():
    return 4096
end

func nc_poly_lookup_instance_loop(pool, instances, base_fn_idx, params, i, n):
    if i >= n:
        return 0 - 1
    end
    let inst = get(instances, i)
    if inst.0 == base_fn_idx:
        if nc_type_vector_equal(pool, inst.1, params):
            return i
        end
    end
    return nc_poly_lookup_instance_loop(pool, instances, base_fn_idx, params, i + 1, n)
end

func nc_poly_lookup_instance(pool, instances, base_fn_idx, params):
    return nc_poly_lookup_instance_loop(pool, instances, base_fn_idx, params, 0, count(instances))
end

func nc_poly_guard_parent_chain(pool, instances, parent_idx, base_fn_idx, params, line):
    if parent_idx == 0 - 1:
        return 0
    end
    let parent = get(instances, parent_idx)
    if parent.0 == base_fn_idx:
        if nc_poly_vector_grows(pool, parent.1, params):
            return nc_infer_fail(pool, 441, line, "")
        end
    end
    return nc_poly_guard_parent_chain(pool, instances, parent.5, base_fn_idx, params, line)
end

func nc_poly_make_instance(base_fn_idx, params, ret, depth, lowered_idx, parent_idx):
    return (base_fn_idx, params, ret, depth, lowered_idx, parent_idx)
end

func nc_poly_get_or_create(pool, poly, base_fn_idx, params, parent_idx, sig, line):
    let instances = poly.0
    let existing = nc_poly_lookup_instance(pool, instances, base_fn_idx, params)
    if existing != 0 - 1:
        return (0, existing, sig, 0)
    end
    if count(instances) >= nc_poly_max_instances():
        return (nc_infer_fail(pool, 441, line, ""), 0, sig, 0)
    end
    let guard = nc_poly_guard_parent_chain(pool, instances, parent_idx, base_fn_idx, params, line)
    if guard != 0:
        return (guard, 0, sig, 0)
    end
    let depth = 0
    if parent_idx != 0 - 1:
        depth = get(instances, parent_idx).3 + 1
    end
    let lowered = count(instances)
    do add(instances, nc_poly_make_instance(base_fn_idx, params, nc_type_unknown(), depth, lowered, parent_idx))
    do add(sig.0, params)
    do add(sig.1, nc_type_unknown())
    return (0, lowered, sig, 1)
end

func nc_poly_call_target_find_loop(targets, caller_inst_idx, call_node_idx, i, n):
    if i >= n:
        return 0 - 1
    end
    let target = get(targets, i)
    if target.0 == caller_inst_idx and target.1 == call_node_idx:
        return i
    end
    return nc_poly_call_target_find_loop(targets, caller_inst_idx, call_node_idx, i + 1, n)
end

func nc_poly_call_target_find(targets, caller_inst_idx, call_node_idx):
    return nc_poly_call_target_find_loop(targets, caller_inst_idx, call_node_idx, 0, count(targets))
end

func nc_poly_record_call_target(pool, poly, caller_inst_idx, call_node_idx, callee_inst_idx):
    let targets = poly.1
    let existing = nc_poly_call_target_find(targets, caller_inst_idx, call_node_idx)
    if existing == 0 - 1:
        do add(targets, (caller_inst_idx, call_node_idx, callee_inst_idx))
        return 0
    end
    let old = get(targets, existing)
    if old.2 != callee_inst_idx:
        return nc_infer_fail(pool, 430, 0, "")
    end
    return 0
end

func nc_poly_lowered_call_target(pool, poly, caller_inst_idx, call_node_idx, call_line):
    let targets = poly.1
    let existing = nc_poly_call_target_find(targets, caller_inst_idx, call_node_idx)
    if existing == 0 - 1:
        -- A call can lack a target when an argument stayed unknown, as a
        -- never-returning helper's result does. Without a retry this is ERR 424
        -- at the call's line. After a successful retry it reports the first
        -- attempt's retained diagnostic instead, whatever local the call
        -- concerns; that diagnostic need not describe this call.
        if nc_retry_used(pool):
            return nc_retry_diag_fail(pool, 430, 0, "")
        end
        return nc_fail(424, call_line, "")
    end
    return get(targets, existing).2
end

func nc_poly_seed_main(nodes, prog_idx):
    let main_lookup = nc_func_lookup(nodes, prog_idx, "main")
    let instances = new_array((int, array(int), int, int, int, int))
    let call_targets = new_array((int, int, int))
    let pushes = new_array((int, int))
    let params = new_array(array(int))
    let returns = new_array(int)
    let empty = new_array(int)
    do add(instances, nc_poly_make_instance(main_lookup.1, empty, nc_type_unknown(), 0, 0, 0 - 1))
    do add(params, empty)
    do add(returns, nc_type_unknown())
    return ((params, returns), (instances, call_targets, pushes, new_array((int, int, int, int, int))))
end

func nc_poly_current_base(funcs, fn_idx):
    return get(funcs.0, fn_idx).0
end

func nc_or_changed(a, b):
    if a != 0 or b != 0:
        return 1
    end
    return 0
end

func nc_func_lookup_loop(func_kids, i, n, name, nodes):
    if i >= n:
        return (0, 0, 0, 0)
    end
    let fn = get(nodes, get(func_kids, i))
    if equal(get(fn.1, 0), name):
        let pn = get(nodes, get(fn.2, 0))
        return (1, i, count(pn.1), fn.3)
    end
    return nc_func_lookup_loop(func_kids, i + 1, n, name, nodes)
end

func nc_func_lookup(nodes, prog_idx, name):
    let prog = get(nodes, prog_idx)
    return nc_func_lookup_loop(prog.2, 0, count(prog.2), name, nodes)
end

func nc_table_check_loop(func_kids, i, n, seen, nodes, main_count, main_params, main_line):
    if i >= n:
        if main_count != 1:
            return nc_fail(429, 0, "main")
        end
        if main_params != 0:
            return nc_fail(429, main_line, "main")
        end
        return 0
    end
    let fn = get(nodes, get(func_kids, i))
    let name = get(fn.1, 0)
    if err_is_builtin_name(name):
        return nc_fail(429, fn.3, name)
    end
    if err_name_seen(seen, name):
        return nc_fail(429, fn.3, name)
    end
    do add(seen, name)
    let pn = get(nodes, get(fn.2, 0))
    if equal(name, "main"):
        main_count = main_count + 1
        main_params = count(pn.1)
        main_line = fn.3
    end
    return nc_table_check_loop(func_kids, i + 1, n, seen, nodes, main_count, main_params, main_line)
end

func nc_table_check(nodes, prog_idx):
    let prog = get(nodes, prog_idx)
    return nc_table_check_loop(prog.2, 0, count(prog.2), new_array(string), nodes, 0, 0, 0)
end

-- zelph: never-returning-function (type-bottom) recognition.
func nc_expr_count_name(nodes, idx, name):
    let node = get(nodes, idx)
    if equal(node.0, "name") and equal(get(node.1, 0), name):
        return 1
    end
    return nc_kids_count_name(nodes, node.2, 0, count(node.2), name)
end

func nc_kids_count_name(nodes, kids, i, n, name):
    if i >= n:
        return 0
    end
    return nc_expr_count_name(nodes, get(kids, i), name) + nc_kids_count_name(nodes, kids, i + 1, n, name)
end

func nc_body_count_name(nodes, stmts, i, n, name):
    if i >= n:
        return 0
    end
    let stmt = get(nodes, get(stmts, i))
    let tag = stmt.0
    let here = 0
    if equal(tag, "let") or equal(tag, "assign") or equal(tag, "return") or equal(tag, "do"):
        here = nc_expr_count_name(nodes, get(stmt.2, 0), name)
    elif equal(tag, "field-assign"):
        here = nc_expr_count_name(nodes, get(stmt.2, 0), name)
        if equal(get(stmt.1, 0), name):
            here = here + 1
        end
    elif equal(tag, "if"):
        here = nc_if_count_name(nodes, stmt.2, 0, count(stmt.2), name)
    elif equal(tag, "while"):
        let wb = get(nodes, get(stmt.2, 1))
        here = nc_expr_count_name(nodes, get(stmt.2, 0), name) + nc_body_count_name(nodes, wb.2, 0, count(wb.2), name)
    end
    return here + nc_body_count_name(nodes, stmts, i + 1, n, name)
end

func nc_if_count_name(nodes, kids, i, n, name):
    if i >= n:
        return 0
    end
    let arm = get(nodes, get(kids, i))
    let here = 0
    let body_idx = 0
    if equal(arm.0, "else"):
        body_idx = get(arm.2, 0)
    else:
        here = nc_expr_count_name(nodes, get(arm.2, 0), name)
        body_idx = get(arm.2, 1)
    end
    let body = get(nodes, body_idx)
    return here + nc_body_count_name(nodes, body.2, 0, count(body.2), name) + nc_if_count_name(nodes, kids, i + 1, n, name)
end

func nc_body_assigns_name(nodes, stmts, i, n, name):
    if i >= n:
        return false
    end
    let stmt = get(nodes, get(stmts, i))
    let tag = stmt.0
    if equal(tag, "assign") or equal(tag, "field-assign"):
        if equal(get(stmt.1, 0), name):
            return true
        end
    elif equal(tag, "if"):
        if nc_if_assigns_name(nodes, stmt.2, 0, count(stmt.2), name):
            return true
        end
    elif equal(tag, "while"):
        let wb = get(nodes, get(stmt.2, 1))
        if nc_body_assigns_name(nodes, wb.2, 0, count(wb.2), name):
            return true
        end
    end
    return nc_body_assigns_name(nodes, stmts, i + 1, n, name)
end

func nc_if_assigns_name(nodes, kids, i, n, name):
    if i >= n:
        return false
    end
    let arm = get(nodes, get(kids, i))
    let body_idx = 0
    if equal(arm.0, "else"):
        body_idx = get(arm.2, 0)
    else:
        body_idx = get(arm.2, 1)
    end
    let body = get(nodes, body_idx)
    if nc_body_assigns_name(nodes, body.2, 0, count(body.2), name):
        return true
    end
    return nc_if_assigns_name(nodes, kids, i + 1, n, name)
end

func nc_body_let_target_count_name(nodes, stmts, i, n, name):
    if i >= n:
        return 0
    end
    let stmt = get(nodes, get(stmts, i))
    let tag = stmt.0
    let here = 0
    if equal(tag, "let"):
        if equal(get(stmt.1, 0), name):
            here = 1
        end
    elif equal(tag, "if"):
        here = nc_if_let_target_count_name(nodes, stmt.2, 0, count(stmt.2), name)
    elif equal(tag, "while"):
        let wb = get(nodes, get(stmt.2, 1))
        here = nc_body_let_target_count_name(nodes, wb.2, 0, count(wb.2), name)
    end
    return here + nc_body_let_target_count_name(nodes, stmts, i + 1, n, name)
end

func nc_if_let_target_count_name(nodes, kids, i, n, name):
    if i >= n:
        return 0
    end
    let arm = get(nodes, get(kids, i))
    let body_idx = 0
    if equal(arm.0, "else"):
        body_idx = get(arm.2, 0)
    else:
        body_idx = get(arm.2, 1)
    end
    let body = get(nodes, body_idx)
    return nc_body_let_target_count_name(nodes, body.2, 0, count(body.2), name) + nc_if_let_target_count_name(nodes, kids, i + 1, n, name)
end

func nc_top_let_is_new_array(nodes, stmts, i, n, name):
    if i >= n:
        return false
    end
    let stmt = get(nodes, get(stmts, i))
    if equal(stmt.0, "let") and equal(get(stmt.1, 0), name):
        let val = get(nodes, get(stmt.2, 0))
        if equal(val.0, "call") and equal(get(val.1, 0), "new_array"):
            return true
        end
        return false
    end
    return nc_top_let_is_new_array(nodes, stmts, i + 1, n, name)
end

func nc_return_is_trap(nodes, top_stmts, before, expr_idx):
    let node = get(nodes, expr_idx)
    if not equal(node.0, "call"):
        return false
    end
    if not equal(get(node.1, 0), "get"):
        return false
    end
    if count(node.2) != 2:
        return false
    end
    let arr = get(nodes, get(node.2, 0))
    if not equal(arr.0, "name"):
        return false
    end
    let xname = get(arr.1, 0)
    -- The fresh array's let must be a top-level statement that runs before the
    -- one holding this return. A later let leaves the name bound to a parameter
    -- or earlier value here, and that function does return.
    if not nc_top_let_is_new_array(nodes, top_stmts, 0, before, xname):
        return false
    end
    if nc_body_let_target_count_name(nodes, top_stmts, 0, count(top_stmts), xname) != 1:
        return false
    end
    if nc_body_count_name(nodes, top_stmts, 0, count(top_stmts), xname) != 1:
        return false
    end
    if nc_body_assigns_name(nodes, top_stmts, 0, count(top_stmts), xname):
        return false
    end
    return true
end

-- `before` is the top-level position of the statement being walked; nested
-- bodies inherit it from the top-level if that contains them.
func nc_returns_all_trap(nodes, top_stmts, stmts, i, n, top, before):
    if i >= n:
        return (true, 0)
    end
    let stmt = get(nodes, get(stmts, i))
    let tag = stmt.0
    let here_ok = true
    let here_cnt = 0
    let here_before = before
    if top:
        here_before = i
    end
    if equal(tag, "return"):
        here_cnt = 1
        here_ok = nc_return_is_trap(nodes, top_stmts, here_before, get(stmt.2, 0))
    elif equal(tag, "if"):
        let r = nc_if_returns_all_trap(nodes, top_stmts, here_before, stmt.2, 0, count(stmt.2))
        here_ok = r.0
        here_cnt = r.1
    elif equal(tag, "while"):
        let wb = get(nodes, get(stmt.2, 1))
        let wr = nc_returns_all_trap(nodes, top_stmts, wb.2, 0, count(wb.2), false, here_before)
        here_ok = wr.0
        here_cnt = wr.1
    end
    if not here_ok:
        return (false, here_cnt)
    end
    let rest = nc_returns_all_trap(nodes, top_stmts, stmts, i + 1, n, top, before)
    return (rest.0, here_cnt + rest.1)
end

func nc_if_returns_all_trap(nodes, top_stmts, before, kids, i, n):
    if i >= n:
        return (true, 0)
    end
    let arm = get(nodes, get(kids, i))
    let body_idx = 0
    if equal(arm.0, "else"):
        body_idx = get(arm.2, 0)
    else:
        body_idx = get(arm.2, 1)
    end
    let body = get(nodes, body_idx)
    let r = nc_returns_all_trap(nodes, top_stmts, body.2, 0, count(body.2), false, before)
    if not r.0:
        return (false, r.1)
    end
    let rest = nc_if_returns_all_trap(nodes, top_stmts, before, kids, i + 1, n)
    return (rest.0, r.1 + rest.1)
end

func nc_func_never_returns_node(nodes, fn):
    -- main is never called, so its result is never used at another type.
    if equal(get(fn.1, 0), "main"):
        return false
    end
    let body = get(nodes, get(fn.2, 1))
    let stmts = body.2
    let r = nc_returns_all_trap(nodes, stmts, stmts, 0, count(stmts), true, 0)
    if r.1 == 0:
        return false
    end
    return r.0
end

func nc_func_never_returns(nodes, prog_idx, fn_idx):
    let prog = get(nodes, prog_idx)
    return nc_func_never_returns_node(nodes, get(nodes, get(prog.2, fn_idx)))
end

func nc_sig_unify_param(pool, sig, fn_idx, param_idx, want, line):
    let old = nc_sig_get_param(sig, fn_idx, param_idx)
    let u = nc_type_merge(pool, old, want, line)
    if u.0 != 0:
        return (u.0, sig, 0)
    end
    if u.2 == 0:
        return (0, sig, 0)
    end
    return (0, nc_sig_set_param(sig, fn_idx, param_idx, u.1), 1)
end

func nc_tuple_depth_cached(depths, t):
    if t < nc_type_struct_base():
        return 0
    end
    return get(depths, t - nc_type_struct_base())
end

func nc_tuple_depth_kids(depths, kids, i, n, depth):
    if i >= n:
        return depth
    end
    let child = nc_tuple_depth_cached(depths, get(kids, i))
    if child > depth:
        depth = child
    end
    return nc_tuple_depth_kids(depths, kids, i + 1, n, depth)
end

-- Interned types only refer to earlier pool entries. Measure the DAG once,
-- rather than expanding shared children such as (f(), f()) exponentially.
-- Arrays carry their element's tuple depth without adding a tuple level.
func nc_tuple_depth_loop(pool, t, i, depths):
    if i > t - nc_type_struct_base():
        return nc_tuple_depth_cached(depths, t)
    end
    let entry = get(pool.0, i)
    let depth = nc_tuple_depth_kids(depths, entry.1, 0, count(entry.1), 0)
    if entry.0 == 1:
        depth = depth + 1
    end
    do add(depths, depth)
    return nc_tuple_depth_loop(pool, t, i + 1, depths)
end

-- Record the supplier of a structural return constraint, not its current depth:
-- that type can contain the same recursion whose growth we are checking.
func nc_tuple_note_push(funcs, inst, caller, want):
    if want < nc_type_struct_base():
        return 0
    end
    return nc_tuple_note_push_loop(funcs.2, inst, caller, 0, count(funcs.2))
end

func nc_tuple_note_push_loop(pushes, inst, caller, i, n):
    if i >= n:
        do add(pushes, (inst, caller))
        return 0
    end
    let p = get(pushes, i)
    if p.0 == inst and p.1 == caller:
        return 0
    end
    return nc_tuple_note_push_loop(pushes, inst, caller, i + 1, n)
end

func nc_tuple_sites_node(nodes, idx, acc):
    let node = get(nodes, idx)
    let c = 0
    if equal(node.0, "tuple") or equal(node.0, "type-tuple") or equal(node.0, "record-new") or equal(node.0, "field-assign"):
        c = 1
    end
    if equal(node.0, "call"):
        if equal(get(node.1, 0), "stdin_read"):
            c = 1
        end
    end
    return nc_tuple_sites_kids(nodes, node.2, 0, count(node.2), acc + c)
end

func nc_tuple_sites_kids(nodes, kids, i, n, acc):
    if i >= n:
        return acc
    end
    return nc_tuple_sites_kids(nodes, kids, i + 1, n, nc_tuple_sites_node(nodes, get(kids, i), acc))
end

func nc_tuple_int_array_has(a, v, i, n):
    if i >= n:
        return false
    end
    if get(a, i) == v:
        return true
    end
    return nc_tuple_int_array_has(a, v, i + 1, n)
end

func nc_tuple_add_callees(targets, cur, i, n, order):
    if i >= n:
        return 0
    end
    let t = get(targets, i)
    if t.0 == cur:
        if not nc_tuple_int_array_has(order, t.2, 0, count(order)):
            do add(order, t.2)
        end
    end
    return nc_tuple_add_callees(targets, cur, i + 1, n, order)
end

func nc_tuple_depth_vec(depths, vec, i, n, best):
    if i >= n:
        return best
    end
    let d = nc_tuple_depth_cached(depths, get(vec, i))
    if d > best:
        best = d
    end
    return nc_tuple_depth_vec(depths, vec, i + 1, n, best)
end

func nc_tuple_add_pushers(pushes, inst, i, n, order):
    if i >= n:
        return 0
    end
    let p = get(pushes, i)
    if p.0 == inst:
        if not nc_tuple_int_array_has(order, p.1, 0, count(order)):
            do add(order, p.1)
        end
    end
    return nc_tuple_add_pushers(pushes, inst, i + 1, n, order)
end

-- A finite return path gains levels only at tuple literals, tuple type
-- expressions and stdin_read, or from fully known specialization parameters.
-- Merge, arrays and projections add no level. Walk callees AND suppliers of
-- pushed return constraints, counting each instance's constructors only once.
-- A push can carry recursive growth; following its supplier keeps the budget
-- finite instead of adding that growth to the budget on every round.
-- A supplier's other syntax and callees can raise this conservative bound.
-- Stop once the budget reaches the checked depth, since that cannot reject.
func nc_tuple_local_budget(nodes, fn_nodes, funcs, depths, order, pos, sites, edge, depth):
    if sites + edge >= depth:
        return sites + edge
    end
    if pos >= count(order):
        return sites + edge
    end
    let cur = get(order, pos)
    let inst = get(funcs.0, cur)
    let here = nc_tuple_sites_node(nodes, get(fn_nodes, inst.0), 0)
    let e = nc_tuple_depth_vec(depths, inst.1, 0, count(inst.1), edge)
    do nc_tuple_add_pushers(funcs.2, cur, 0, count(funcs.2), order)
    do nc_tuple_add_callees(funcs.1, cur, 0, count(funcs.1), order)
    return nc_tuple_local_budget(nodes, fn_nodes, funcs, depths, order, pos + 1, sites + here, e, depth)
end

func nc_check_recursive_tuple(pool, nodes, prog_idx, funcs, t, line, fn_idx):
    if t < nc_type_struct_base() or not nc_type_has_unknown(pool, t):
        return 0
    end
    let depths = new_array(int)
    do nc_tuple_depth_loop(pool, count(pool.0) + nc_type_struct_base() - 1, 0, depths)
    let depth = nc_tuple_depth_cached(depths, t)
    let prog = get(nodes, prog_idx)
    let order = new_array(int)
    do add(order, fn_idx)
    if nc_tuple_local_budget(nodes, prog.2, funcs, depths, order, 0, 0, 0, depth) < depth:
        return nc_infer_fail(pool, 430, line, "")
    end
    return 0
end

func nc_sig_unify_ret(pool, sig, fn_idx, want, line, nodes, prog_idx, funcs):
    let old = nc_sig_get_ret(sig, fn_idx)
    if old != want:
        let growth = nc_check_recursive_tuple(pool, nodes, prog_idx, funcs, want, line, fn_idx)
        if growth != 0:
            return (growth, sig, 0)
        end
    end
    let u = nc_type_merge(pool, old, want, line)
    if u.0 != 0:
        return (u.0, sig, 0)
    end
    if u.2 == 0:
        return (0, sig, 0)
    end
    return (0, nc_sig_set_ret(sig, fn_idx, u.1), 1)
end

func nc_seed_params_loop(params, i, n, sig, fn_idx, env):
    if i >= n:
        return env
    end
    env = nc_class_env_add(env, get(params, i), nc_sig_get_param(sig, fn_idx, i))
    return nc_seed_params_loop(params, i + 1, n, sig, fn_idx, env)
end

func nc_func_env_from_params(nodes, fn_node, sig, fn_idx):
    let pn = get(nodes, get(fn_node.2, 0))
    return nc_seed_params_loop(pn.1, 0, count(pn.1), sig, fn_idx, nc_class_env_new())
end

func nc_constrain_name(pool, nodes, node, env, want, sig, fn_idx, n_params):
    let name = get(node.1, 0)
    let li = nc_class_env_lookup_info(env, name)
    if li.0 == 0:
        return (nc_infer_fail(pool, 404, node.3, "undefined-name"), env, sig, 0)
    end
    let u = nc_type_merge(pool, li.2, want, node.3)
    if u.0 != 0:
        return (u.0, env, sig, 0)
    end
    if u.2 == 0:
        return (0, env, sig, 0)
    end
    env = nc_class_env_set_idx(env, li.1, u.1)
    let changed = 0
    -- During retry an unknown rebound parameter describes its new value,
    -- not the incoming argument. Only refine an unchanged parameter binding.
    if li.1 < n_params and (nc_infer_phase(pool).0 != 2 or li.2 == nc_sig_get_param(sig, fn_idx, li.1)):
        let su = nc_sig_unify_param(pool, sig, fn_idx, li.1, u.1, node.3)
        if su.0 != 0:
            return (su.0, env, sig, changed)
        end
        sig = su.1
        changed = su.2
    end
    return (0, env, sig, changed)
end

func nc_expect_concrete(pool, got, want, line):
    if got == 0 or want == 0 or nc_type_equal(pool, got, want):
        return 0
    end
    return nc_infer_fail(pool, 430, line, "")
end

func nc_expect_array_elem(pool, got, want, line):
    if got == 0 or want == 0 or nc_type_equal(pool, got, want):
        return 0
    end
    if nc_type_has_unknown(pool, got) or nc_type_has_unknown(pool, want):
        if not nc_type_merge_possible(pool, got, want):
            return nc_infer_fail(pool, 436, line, "")
        end
        let m = nc_type_merge(pool, got, want, line)
        if m.0 == 0:
            return 0
        end
        return m.0
    end
    return nc_infer_fail(pool, 436, line, "")
end

func nc_constrain_string_value(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params, line):
    let r = nc_infer_expr(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, r.2, r.3, r.4)
    end
    if r.1 == nc_type_buffer():
        return (nc_infer_fail(pool, 438, line, ""), r.2, r.3, r.4)
    end
    if r.1 == nc_type_unknown():
        return nc_constrain_expr(pool, nodes, prog_idx, idx, r.2, nc_type_string(), r.3, fn_idx, funcs, n_params)
    end
    let chk = nc_expect_concrete(pool, r.1, nc_type_string(), line)
    if chk != 0:
        return (chk, r.2, r.3, r.4)
    end
    return (0, r.2, r.3, r.4)
end

func nc_constrain_flogger_string_value(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params, line):
    let r = nc_infer_expr(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, r.2, r.3, r.4)
    end
    if r.1 == nc_type_unknown():
        return nc_constrain_expr(pool, nodes, prog_idx, idx, r.2, nc_type_string(), r.3, fn_idx, funcs, n_params)
    end
    let chk = nc_expect_concrete(pool, r.1, nc_type_string(), line)
    if chk != 0:
        return (chk, r.2, r.3, r.4)
    end
    return (0, r.2, r.3, r.4)
end

func nc_constrain_buffer_value(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params, line):
    let r = nc_infer_expr(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, r.2, r.3, r.4)
    end
    if r.1 == nc_type_unknown():
        return nc_constrain_expr(pool, nodes, prog_idx, idx, r.2, nc_type_buffer(), r.3, fn_idx, funcs, n_params)
    end
    if r.1 != nc_type_buffer():
        return (nc_infer_fail(pool, 437, line, ""), r.2, r.3, r.4)
    end
    return (0, r.2, r.3, r.4)
end

func nc_constrain_array_value(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params, want_elem, line):
    let want = nc_type_intern_array(pool, want_elem)
    let r = nc_infer_expr(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, r.2, r.3, r.4)
    end
    if r.1 == nc_type_unknown():
        return nc_constrain_expr(pool, nodes, prog_idx, idx, r.2, want, r.3, fn_idx, funcs, n_params)
    end
    if not nc_type_is_array(pool, r.1):
        return (nc_infer_fail(pool, 435, line, ""), r.2, r.3, r.4)
    end
    let merged = nc_type_merge(pool, r.1, want, line)
    if merged.0 != 0:
        return (merged.0, r.2, r.3, r.4)
    end
    if merged.2 == 0:
        return (0, r.2, r.3, r.4)
    end
    return nc_constrain_expr(pool, nodes, prog_idx, idx, r.2, merged.1, r.3, fn_idx, funcs, n_params)
end

func nc_collect_call_arg_types(pool, nodes, prog_idx, kids, i, n, env, sig, fn_idx, funcs, n_params, args, changed):
    if i >= n:
        return (0, args, env, sig, changed)
    end
    let arg_idx = get(kids, i)
    let ar = nc_infer_expr(pool, nodes, prog_idx, arg_idx, env, sig, fn_idx, funcs, n_params)
    if ar.0 != 0:
        return (ar.0, args, ar.2, ar.3, nc_or_changed(changed, ar.4))
    end
    do add(args, ar.1)
    return nc_collect_call_arg_types(pool, nodes, prog_idx, kids, i + 1, n, ar.2, ar.3, fn_idx, funcs, n_params, args, nc_or_changed(changed, ar.4))
end

func nc_poly_constrain_user_call(pool, nodes, prog_idx, call_idx, env, want, sig, fn_idx, funcs, n_params):
    let node = get(nodes, call_idx)
    let name = get(node.1, 0)
    let callee = nc_func_lookup(nodes, prog_idx, name)
    if callee.0 == 0:
        return (nc_infer_fail(pool, 419, node.3, name), env, sig, 0)
    end
    if equal(name, "main"):
        return (nc_infer_fail(pool, 421, node.3, ""), env, sig, 0)
    end
    if callee.2 != count(node.2):
        return (nc_infer_fail(pool, 420, node.3, name), env, sig, 0)
    end
    let ar = nc_collect_call_arg_types(pool, nodes, prog_idx, node.2, 0, count(node.2), env, sig, fn_idx, funcs, n_params, new_array(int), 0)
    if ar.0 != 0:
        return (ar.0, ar.2, ar.3, ar.4)
    end
    if nc_type_vector_has_unknown(pool, ar.1, 0, count(ar.1)):
        return (0, ar.2, ar.3, ar.4)
    end
    let gi = nc_poly_get_or_create(pool, funcs, callee.1, ar.1, fn_idx, ar.3, node.3)
    if gi.0 != 0:
        return (gi.0, ar.2, gi.2, nc_or_changed(ar.4, gi.3))
    end
    let rec = nc_poly_record_call_target(pool, funcs, fn_idx, call_idx, gi.1)
    if rec != 0:
        return (rec, ar.2, gi.2, nc_or_changed(ar.4, gi.3))
    end
    let changed = nc_or_changed(ar.4, gi.3)
    if nc_func_never_returns(nodes, prog_idx, callee.1):
        return (0, ar.2, gi.2, changed)
    end
    do nc_tuple_note_push(funcs, gi.1, fn_idx, want)
    let su = nc_sig_unify_ret(pool, gi.2, gi.1, want, node.3, nodes, prog_idx, funcs)
    if su.0 != 0:
        return (su.0, ar.2, gi.2, changed)
    end
    return (0, ar.2, su.1, nc_or_changed(changed, su.2))
end

func nc_poly_infer_user_call(pool, nodes, prog_idx, call_idx, env, sig, fn_idx, funcs, n_params):
    let node = get(nodes, call_idx)
    let name = get(node.1, 0)
    let callee = nc_func_lookup(nodes, prog_idx, name)
    if callee.0 == 0:
        return (nc_infer_fail(pool, 419, node.3, name), 0, env, sig, 0)
    end
    if equal(name, "main"):
        return (nc_infer_fail(pool, 421, node.3, ""), 0, env, sig, 0)
    end
    if callee.2 != count(node.2):
        return (nc_infer_fail(pool, 420, node.3, name), 0, env, sig, 0)
    end
    let ar = nc_collect_call_arg_types(pool, nodes, prog_idx, node.2, 0, count(node.2), env, sig, fn_idx, funcs, n_params, new_array(int), 0)
    if ar.0 != 0:
        return (ar.0, 0, ar.2, ar.3, ar.4)
    end
    if nc_type_vector_has_unknown(pool, ar.1, 0, count(ar.1)):
        return (0, nc_type_unknown(), ar.2, ar.3, ar.4)
    end
    let gi = nc_poly_get_or_create(pool, funcs, callee.1, ar.1, fn_idx, ar.3, node.3)
    if gi.0 != 0:
        return (gi.0, 0, ar.2, gi.2, nc_or_changed(ar.4, gi.3))
    end
    let rec = nc_poly_record_call_target(pool, funcs, fn_idx, call_idx, gi.1)
    if rec != 0:
        return (rec, 0, ar.2, gi.2, nc_or_changed(ar.4, gi.3))
    end
    return (0, nc_sig_get_ret(gi.2, gi.1), ar.2, gi.2, nc_or_changed(ar.4, gi.3))
end

func nc_constrain_expr(pool, nodes, prog_idx, idx, env, want, sig, fn_idx, funcs, n_params):
    if want == 0:
        return (0, env, sig, 0)
    end
    let node = get(nodes, idx)
    if equal(node.0, "name"):
        return nc_constrain_name(pool, nodes, node, env, want, sig, fn_idx, n_params)
    end
    if equal(node.0, "call"):
        let name = get(node.1, 0)
        if not err_is_builtin_name(name):
            return nc_poly_constrain_user_call(pool, nodes, prog_idx, idx, env, want, sig, fn_idx, funcs, n_params)
        end
        if equal(name, "get"):
            if count(node.2) != err_value_builtin_arity(name):
                return (nc_infer_fail(pool, 420, node.3, name), env, sig, 0)
            end
            let ar = nc_constrain_array_value(pool, nodes, prog_idx, get(node.2, 0), env, sig, fn_idx, funcs, n_params, want, node.3)
            if ar.0 != 0:
                return ar
            end
            let kr = nc_constrain_expr(pool, nodes, prog_idx, get(node.2, 1), ar.1, nc_type_int(), ar.2, fn_idx, funcs, n_params)
            return (kr.0, kr.1, kr.2, nc_or_changed(ar.3, kr.3))
        end
    end
    let r = nc_infer_expr(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, r.2, r.3, r.4)
    end
    let chk = nc_expect_concrete(pool, r.1, want, node.3)
    if chk != 0:
        return (chk, r.2, r.3, r.4)
    end
    return (0, r.2, r.3, r.4)
end

func nc_tuple_type_from_exprs(pool, nodes, prog_idx, kids, i, n, env, sig, fn_idx, funcs, n_params, child_types, changed):
    if i >= n:
        return (0, nc_type_intern_tuple(pool, child_types), env, sig, changed)
    end
    let r = nc_infer_expr(pool, nodes, prog_idx, get(kids, i), env, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, 0, r.2, r.3, nc_or_changed(changed, r.4))
    end
    do add(child_types, r.1)
    return nc_tuple_type_from_exprs(pool, nodes, prog_idx, kids, i + 1, n, r.2, r.3, fn_idx, funcs, n_params, child_types, nc_or_changed(changed, r.4))
end

func nc_tuple_child_start_loop(pool, kids, i, target, acc):
    if i >= target:
        return acc
    end
    return nc_tuple_child_start_loop(pool, kids, i + 1, target, acc + nc_type_width(pool, get(kids, i)))
end

-- Keep the arity metadata shared, but guard only the supported ordinary value
-- calls here. Type constructors, void-as-value, unsupported calls and low-level
-- target intrinsics have separate contracts; a default arity is not a whitelist.
func nc_has_value_arity_guard(name):
    if nc_is_hosted_memory_builtin(name):
        return true
    end
    if equal(name, "boot_read"):
        return true
    end
    if equal(name, "input_byte") or equal(name, "module_byte") or equal(name, "sys_read") or equal(name, "bufbase"):
        return true
    end
    if equal(name, "sys_write") or equal(name, "output_byte") or equal(name, "yield") or equal(name, "bufget") or equal(name, "bufset"):
        return true
    end
    if equal(name, "stderr_write") or equal(name, "stdin_read"):
        return true
    end
    if equal(name, "clogger") or equal(name, "new_buffer"):
        return true
    end
    if equal(name, "length") or equal(name, "freeze") or equal(name, "count"):
        return true
    end
    return equal(name, "index") or equal(name, "equal") or equal(name, "get")
end

-- All five hosted calls return int. Buffer calls constrain their first argument
-- to buffer; the syscall's seven arguments and the remaining byte arguments are
-- ints. Keep this in normal inference so wrappers and polymorphic calls work.
func nc_infer_hosted_memory_args(pool, nodes, prog_idx, kids, i, n, is_buffer, env, sig, fn_idx, funcs, n_params, line, changed):
    if i >= n:
        return (0, nc_type_int(), env, sig, changed)
    end
    let want = nc_type_int()
    if is_buffer and i == 0:
        want = nc_type_buffer()
    end
    let r = nc_constrain_expr(pool, nodes, prog_idx, get(kids, i), env, want, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, 0, r.1, r.2, nc_or_changed(changed, r.3))
    end
    return nc_infer_hosted_memory_args(pool, nodes, prog_idx, kids, i + 1, n, is_buffer, r.1, r.2, fn_idx, funcs, n_params, line, nc_or_changed(changed, r.3))
end

func nc_infer_expr(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params):
    let node = get(nodes, idx)
    let tag = node.0
    let kids = node.2
    if equal(tag, "int") or equal(tag, "char"):
        return (0, nc_type_int(), env, sig, 0)
    end
    if equal(tag, "bool"):
        return (0, nc_type_bool(), env, sig, 0)
    end
    if equal(tag, "str"):
        return (0, nc_type_string(), env, sig, 0)
    end
    if equal(tag, "tuple"):
        return nc_tuple_type_from_exprs(pool, nodes, prog_idx, kids, 0, count(kids), env, sig, fn_idx, funcs, n_params, new_array(int), 0)
    end
    if equal(tag, "dot"):
        let r = nc_infer_expr(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params)
        if r.0 != 0:
            return r
        end
        if r.1 == nc_type_unknown():
            return (0, nc_type_unknown(), r.2, r.3, r.4)
        end
        let field = get(node.1, 0)
        if not is_digit(index(field, 0)):
            return nc_infer_field_read(pool, nodes, idx, node, field, r, funcs, fn_idx)
        end
        if nc_type_any_record(pool, r.1):
            return (nc_infer_fail(pool, 445, node.3, ""), 0, r.2, r.3, r.4)
        end
        if not nc_type_is_tuple(pool, r.1):
            return (nc_infer_fail(pool, 431, node.3, ""), 0, r.2, r.3, r.4)
        end
        let children = nc_type_tuple_children(pool, r.1)
        let elem = parse_decimal(get(node.1, 0))
        if elem >= count(children):
            return (nc_infer_fail(pool, 431, node.3, ""), 0, r.2, r.3, r.4)
        end
        return (0, get(children, elem), r.2, r.3, r.4)
    end
    if equal(tag, "name"):
        let name = get(node.1, 0)
        let li = nc_class_env_lookup_info(env, name)
        if li.0 == 0:
            return (nc_infer_fail(pool, 404, node.3, "undefined-name"), 0, env, sig, 0)
        end
        return (0, li.2, env, sig, 0)
    end
    if equal(tag, "record-new"):
        return nc_infer_record_new(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params)
    end
    if equal(tag, "add") or equal(tag, "sub") or equal(tag, "mul") or equal(tag, "div") or equal(tag, "mod") or equal(tag, "band") or equal(tag, "bor") or equal(tag, "bxor") or equal(tag, "shl") or equal(tag, "shr"):
        -- Arithmetic and bitwise/shift binops are all int x int -> int: constrain
        -- both operands to int and yield int. mul/div/mod join add/sub here
        -- (ordinary arithmetic). A non-int operand hits the existing type-mismatch
        -- fail code via nc_constrain_expr (no new fail code needed).
        let l = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_int(), sig, fn_idx, funcs, n_params)
        if l.0 != 0:
            return (l.0, 0, l.1, l.2, l.3)
        end
        let r = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 1), l.1, nc_type_int(), l.2, fn_idx, funcs, n_params)
        if r.0 != 0:
            return (r.0, 0, r.1, r.2, nc_or_changed(l.3, r.3))
        end
        return (0, nc_type_int(), r.1, r.2, nc_or_changed(l.3, r.3))
    end
    if equal(tag, "eq") or equal(tag, "ne") or equal(tag, "lt") or equal(tag, "le") or equal(tag, "gt") or equal(tag, "ge"):
        let l = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_int(), sig, fn_idx, funcs, n_params)
        if l.0 != 0:
            return (l.0, 0, l.1, l.2, l.3)
        end
        let r = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 1), l.1, nc_type_int(), l.2, fn_idx, funcs, n_params)
        if r.0 != 0:
            return (r.0, 0, r.1, r.2, nc_or_changed(l.3, r.3))
        end
        return (0, nc_type_bool(), r.1, r.2, nc_or_changed(l.3, r.3))
    end
    if equal(tag, "and") or equal(tag, "or"):
        let l = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_bool(), sig, fn_idx, funcs, n_params)
        if l.0 != 0:
            return (l.0, 0, l.1, l.2, l.3)
        end
        let r = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 1), l.1, nc_type_bool(), l.2, fn_idx, funcs, n_params)
        if r.0 != 0:
            return (r.0, 0, r.1, r.2, nc_or_changed(l.3, r.3))
        end
        return (0, nc_type_bool(), r.1, r.2, nc_or_changed(l.3, r.3))
    end
    if equal(tag, "not"):
        let r = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_bool(), sig, fn_idx, funcs, n_params)
        if r.0 != 0:
            return (r.0, 0, r.1, r.2, r.3)
        end
        return (0, nc_type_bool(), r.1, r.2, r.3)
    end
    if equal(tag, "bnot"):
        -- `~` is int -> int (one's complement), the int-typed counterpart of the
        -- bool-typed `not` above. Constraining the operand to int rejects `~true`
        -- via the existing type-mismatch fail code.
        let r = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_int(), sig, fn_idx, funcs, n_params)
        if r.0 != 0:
            return (r.0, 0, r.1, r.2, r.3)
        end
        return (0, nc_type_int(), r.1, r.2, r.3)
    end
    if equal(tag, "nc_class_mix"):
        -- Poison node planted by the parser when bitwise/shift operators are
        -- mixed with another operator class (or a different bitwise class)
        -- without parentheses. Reject with the dedicated precedence fail code.
        return (nc_infer_fail(pool, 442, node.3, ""), 0, env, sig, 0)
    end
    if equal(tag, "call"):
        let name = get(node.1, 0)
        -- Check count before indexing or inferring arguments. Extra arguments
        -- must not escape inference and reach lowering without call metadata.
        if nc_has_value_arity_guard(name) and count(kids) != err_value_builtin_arity(name):
            return (nc_infer_fail(pool, 420, node.3, name), 0, env, sig, 0)
        end
        if nc_is_hosted_memory_builtin(name):
            return nc_infer_hosted_memory_args(pool, nodes, prog_idx, kids, 0, count(kids), not equal(name, "linux_syscall6"), env, sig, fn_idx, funcs, n_params, node.3, 0)
        end
        if equal(name, "clogger"):
            return (0, nc_type_string(), env, sig, 0)
        end
        if equal(name, "stdin_read"):
            return (0, nc_type_stdin_result(pool), env, sig, 0)
        end
        if equal(name, "stderr_write"):
            let sw = nc_constrain_flogger_string_value(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params, node.3)
            if sw.0 != 0:
                return (sw.0, 0, sw.1, sw.2, sw.3)
            end
            return (0, nc_type_int(), sw.1, sw.2, sw.3)
        end
        if equal(name, "input_byte"):
            return (0, nc_type_int(), env, sig, 0)
        end
        if equal(name, "boot_read"):
            return (0, nc_type_int(), env, sig, 0)
        end
        if equal(name, "module_byte"):
            return (0, nc_type_int(), env, sig, 0)
        end
        if equal(name, "sys_read"):
            return (0, nc_type_int(), env, sig, 0)
        end
        if equal(name, "sys_write"):
            let sw = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_int(), sig, fn_idx, funcs, n_params)
            if sw.0 != 0:
                return (sw.0, 0, sw.1, sw.2, sw.3)
            end
            return (0, nc_type_int(), sw.1, sw.2, sw.3)
        end
        if equal(name, "output_byte"):
            -- riposte: output_byte(v) -- v int, returns v (int). The device write truncates
            -- to v&0xff on the wire; the RETURNED value is the full argument (op 53 push rbx).
            let ob = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_int(), sig, fn_idx, funcs, n_params)
            if ob.0 != 0:
                return (ob.0, 0, ob.1, ob.2, ob.3)
            end
            return (0, nc_type_int(), ob.1, ob.2, ob.3)
        end
        if equal(name, "yield"):
            let yl = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_int(), sig, fn_idx, funcs, n_params)
            if yl.0 != 0:
                return (yl.0, 0, yl.1, yl.2, yl.3)
            end
            return (0, nc_type_int(), yl.1, yl.2, yl.3)
        end
        if equal(name, "bufbase"):
            -- chiefturbo: bufbase() takes no args, returns the buffer base (int).
            return (0, nc_type_int(), env, sig, 0)
        end
        if equal(name, "bufget"):
            -- chiefturbo: bufget(base, k) -- both int, returns the loaded word (int).
            let bg0 = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_int(), sig, fn_idx, funcs, n_params)
            if bg0.0 != 0:
                return (bg0.0, 0, bg0.1, bg0.2, bg0.3)
            end
            let bg1 = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 1), bg0.1, nc_type_int(), bg0.2, fn_idx, funcs, n_params)
            if bg1.0 != 0:
                return (bg1.0, 0, bg1.1, bg1.2, nc_or_changed(bg0.3, bg1.3))
            end
            return (0, nc_type_int(), bg1.1, bg1.2, nc_or_changed(bg0.3, bg1.3))
        end
        if equal(name, "bufset"):
            -- chiefturbo: bufset(base, i, v) -- all int, returns the stored value v (int).
            let bs0 = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), env, nc_type_int(), sig, fn_idx, funcs, n_params)
            if bs0.0 != 0:
                return (bs0.0, 0, bs0.1, bs0.2, bs0.3)
            end
            let bs1 = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 1), bs0.1, nc_type_int(), bs0.2, fn_idx, funcs, n_params)
            if bs1.0 != 0:
                return (bs1.0, 0, bs1.1, bs1.2, nc_or_changed(bs0.3, bs1.3))
            end
            let bs2 = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 2), bs1.1, nc_type_int(), bs1.2, fn_idx, funcs, n_params)
            if bs2.0 != 0:
                return (bs2.0, 0, bs2.1, bs2.2, nc_or_changed(nc_or_changed(bs0.3, bs1.3), bs2.3))
            end
            return (0, nc_type_int(), bs2.1, bs2.2, nc_or_changed(nc_or_changed(bs0.3, bs1.3), bs2.3))
        end
        if equal(name, "length"):
            let r = nc_constrain_string_value(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params, node.3)
            if r.0 != 0:
                return (r.0, 0, r.1, r.2, r.3)
            end
            return (0, nc_type_int(), r.1, r.2, r.3)
        end
        if equal(name, "index"):
            let s = nc_constrain_string_value(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params, node.3)
            if s.0 != 0:
                return (s.0, 0, s.1, s.2, s.3)
            end
            let k = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 1), s.1, nc_type_int(), s.2, fn_idx, funcs, n_params)
            if k.0 != 0:
                return (k.0, 0, k.1, k.2, nc_or_changed(s.3, k.3))
            end
            return (0, nc_type_int(), k.1, k.2, nc_or_changed(s.3, k.3))
        end
        if equal(name, "equal"):
            let l = nc_constrain_string_value(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params, node.3)
            if l.0 != 0:
                return (l.0, 0, l.1, l.2, l.3)
            end
            let r = nc_constrain_string_value(pool, nodes, prog_idx, get(kids, 1), l.1, l.2, fn_idx, funcs, n_params, node.3)
            if r.0 != 0:
                return (r.0, 0, r.1, r.2, nc_or_changed(l.3, r.3))
            end
            return (0, nc_type_bool(), r.1, r.2, nc_or_changed(l.3, r.3))
        end
        if equal(name, "slice"):
            return (nc_infer_fail(pool, 438, node.3, ""), 0, env, sig, 0)
        end
        if equal(name, "new_buffer"):
            return (0, nc_type_buffer(), env, sig, 0)
        end
        if equal(name, "freeze"):
            let b = nc_constrain_buffer_value(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params, node.3)
            if b.0 != 0:
                return (b.0, 0, b.1, b.2, b.3)
            end
            return (0, nc_type_string(), b.1, b.2, b.3)
        end
        if equal(name, "new_array"):
            if count(kids) != 1:
                return (nc_infer_fail(pool, 434, node.3, ""), 0, env, sig, 0)
            end
            let elem = nc_type_from_type_expr(pool, nodes, get(kids, 0))
            if elem.0 != 0:
                return (elem.0, 0, env, sig, 0)
            end
            return (0, nc_type_intern_array(pool, elem.1), env, sig, 0)
        end
        if equal(name, "get"):
            let a = nc_infer_expr(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params)
            if a.0 != 0:
                return a
            end
            let k = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 1), a.2, nc_type_int(), a.3, fn_idx, funcs, n_params)
            if k.0 != 0:
                return (k.0, 0, k.1, k.2, nc_or_changed(a.4, k.3))
            end
            if a.1 == nc_type_unknown():
                let ar = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), k.1, nc_type_intern_array(pool, nc_type_unknown()), k.2, fn_idx, funcs, n_params)
                if ar.0 != 0:
                    return (ar.0, 0, ar.1, ar.2, nc_or_changed(nc_or_changed(a.4, k.3), ar.3))
                end
                return (0, nc_type_unknown(), ar.1, ar.2, nc_or_changed(nc_or_changed(a.4, k.3), ar.3))
            end
            if not nc_type_is_array(pool, a.1):
                return (nc_infer_fail(pool, 435, node.3, ""), 0, k.1, k.2, nc_or_changed(a.4, k.3))
            end
            return (0, nc_type_array_elem(pool, a.1), k.1, k.2, nc_or_changed(a.4, k.3))
        end
        if equal(name, "count"):
            let a = nc_infer_expr(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params)
            if a.0 != 0:
                return a
            end
            if a.1 == nc_type_unknown():
                let ar = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), a.2, nc_type_intern_array(pool, nc_type_unknown()), a.3, fn_idx, funcs, n_params)
                if ar.0 != 0:
                    return (ar.0, 0, ar.1, ar.2, nc_or_changed(a.4, ar.3))
                end
                return (0, nc_type_int(), ar.1, ar.2, nc_or_changed(a.4, ar.3))
            end
            if not nc_type_is_array(pool, a.1):
                return (nc_infer_fail(pool, 435, node.3, ""), 0, a.2, a.3, a.4)
            end
            return (0, nc_type_int(), a.2, a.3, a.4)
        end
        if err_is_void_builtin(name):
            return (nc_infer_fail(pool, 440, node.3, name), 0, env, sig, 0)
        end
        if err_is_builtin_name(name):
            return (nc_infer_fail(pool, 438, node.3, name), 0, env, sig, 0)
        end
        return nc_poly_infer_user_call(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params)
    end
    return (nc_infer_fail(pool, 404, node.3, tag), 0, env, sig, 0)
end

func nc_rebind_env_type(pool, env, idx, old, got, line):
    if old != nc_type_unknown() and got != nc_type_unknown():
        if nc_type_has_unknown(pool, old) or nc_type_has_unknown(pool, got):
            if not nc_type_merge_possible(pool, old, got):
                if nc_type_is_array(pool, old) or nc_type_is_array(pool, got):
                    return (nc_infer_fail(pool, 436, line, ""), env)
                end
                return (nc_infer_fail(pool, 430, line, ""), env)
            end
            let mp = nc_type_merge(pool, old, got, line)
            if mp.0 != 0:
                return (mp.0, env)
            end
            return (0, nc_class_env_set_idx(env, idx, mp.1))
        end
        if nc_type_width(pool, old) != nc_type_width(pool, got):
            return (nc_infer_fail(pool, 433, line, ""), env)
        end
        if nc_type_is_array(pool, old) or nc_type_is_array(pool, got):
            if not nc_type_equal(pool, old, got):
                return (nc_infer_fail(pool, 436, line, ""), env)
            end
        end
        if not nc_assignment_type_ok(pool, old, got):
            return (nc_infer_fail(pool, 430, line, ""), env)
        end
    end
    if got == nc_type_unknown():
        -- Inferring the RHS can refine this binding after the initial lookup.
        if nc_type_is_int_bool(old) or nc_type_is_int_bool(nc_class_env_class(env, idx)):
            let phase = nc_infer_phase(pool)
            if phase.0 == 2:
                -- Rebuild all dependent signatures with the new value unknown,
                -- rather than committing the previous value's scalar type.
                return (0, nc_class_env_set_idx(env, idx, got))
            end
            if phase.0 == 0:
                do add(pool.1, (1, phase.1))
            end
        end
        return (0, env)
    end
    return (0, nc_class_env_set_idx(env, idx, got))
end

func nc_rhs_never_returns(nodes, prog_idx, idx):
    let node = get(nodes, idx)
    if not equal(node.0, "call"):
        return false
    end
    let callee = nc_func_lookup(nodes, prog_idx, get(node.1, 0))
    if callee.0 == 0:
        return false
    end
    return nc_func_never_returns(nodes, prog_idx, callee.1)
end

func nc_infer_field_read(pool, nodes, idx, node, field, r, funcs, fn_idx):
    if not nc_type_any_record(pool, r.1):
        return (nc_infer_fail(pool, 446, node.3, field), 0, r.2, r.3, r.4)
    end
    let fi = nc_record_field_index(nodes, nc_type_record_decl(pool, r.1), field)
    if fi == 0 - 1:
        return (nc_infer_fail(pool, 444, node.3, field), 0, r.2, r.3, r.4)
    end
    do nc_poly_note_field(funcs, fn_idx, idx, fi, 0, nc_type_record_decl(pool, r.1))
    return (0, get(nc_type_children(pool, r.1), fi), r.2, r.3, r.4)
end

-- An argument or a new field value of the wrong type is ERR 430, as for tuples.
func nc_record_value_ok(pool, want, got, line):
    if got == nc_type_unknown():
        return 0
    end
    if nc_type_equal(pool, want, got):
        return 0
    end
    return nc_type_merge(pool, want, got, line).0
end

func nc_infer_record_args(pool, nodes, prog_idx, kids, fields, i, env, sig, fn_idx, funcs, n_params, changed, line):
    if i >= count(kids):
        return (0, env, sig, changed)
    end
    let r = nc_infer_expr(pool, nodes, prog_idx, get(kids, i), env, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, r.2, r.3, nc_or_changed(changed, r.4))
    end
    let ok = nc_record_value_ok(pool, get(fields, i), r.1, line)
    if ok != 0:
        return (ok, r.2, r.3, nc_or_changed(changed, r.4))
    end
    return nc_infer_record_args(pool, nodes, prog_idx, kids, fields, i + 1, r.2, r.3, fn_idx, funcs, n_params, nc_or_changed(changed, r.4), line)
end

func nc_infer_record_new(pool, nodes, prog_idx, idx, env, sig, fn_idx, funcs, n_params):
    let node = get(nodes, idx)
    let name = get(node.1, 0)
    let rt = nc_record_type(pool, nodes, nc_record_decl_find(nodes, prog_idx, name), new_array(int))
    if rt.0 != 0:
        return (rt.0, 0, env, sig, 0)
    end
    let fields = nc_type_children(pool, rt.1)
    if count(node.2) != count(fields):
        return (nc_infer_fail(pool, 420, node.3, name), 0, env, sig, 0)
    end
    let a = nc_infer_record_args(pool, nodes, prog_idx, node.2, fields, 0, env, sig, fn_idx, funcs, n_params, 0, node.3)
    if a.0 != 0:
        return (a.0, 0, a.1, a.2, a.3)
    end
    return (0, rt.1, a.1, a.2, a.3)
end

-- x.FIELD = e rebinds the local x to a copy with one field replaced. While x's
-- type is still unknown (a callee not yet inferred this round), defer the
-- check to a later round, as a field read does.
func nc_infer_field_assign(pool, nodes, prog_idx, stmt_idx, env, sig, fn_idx, funcs, n_params):
    let node = get(nodes, stmt_idx)
    let field = get(node.1, 1)
    let li = nc_class_env_lookup_info(env, get(node.1, 0))
    if li.0 == 0:
        return (nc_infer_fail(pool, 404, node.3, "assign-undefined"), env, sig, 0, 0)
    end
    let r = nc_infer_expr(pool, nodes, prog_idx, get(node.2, 0), env, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, r.2, r.3, r.4, 0)
    end
    if li.2 == nc_type_unknown():
        return (0, r.2, r.3, r.4, 0)
    end
    if not nc_type_any_record(pool, li.2):
        return (nc_infer_fail(pool, 446, node.3, field), r.2, r.3, r.4, 0)
    end
    let fi = nc_record_field_index(nodes, nc_type_record_decl(pool, li.2), field)
    if fi == 0 - 1:
        return (nc_infer_fail(pool, 444, node.3, field), r.2, r.3, r.4, 0)
    end
    let children = nc_type_children(pool, li.2)
    let ok = nc_record_value_ok(pool, get(children, fi), r.1, node.3)
    if ok != 0:
        return (ok, r.2, r.3, r.4, 0)
    end
    do nc_poly_note_field(funcs, fn_idx, stmt_idx, fi, count(children), nc_type_record_decl(pool, li.2))
    return (0, r.2, r.3, r.4, 0)
end

func nc_infer_stmt(pool, nodes, prog_idx, stmt_idx, env, sig, fn_idx, funcs, n_params):
    let node = get(nodes, stmt_idx)
    let tag = node.0
    let kids = node.2
    if equal(tag, "let"):
        let r = nc_infer_expr(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params)
        if r.0 != 0:
            return (r.0, r.2, r.3, r.4, 0)
        end
        env = nc_class_env_add(r.2, get(node.1, 0), r.1)
        return (0, env, r.3, r.4, 0)
    end
    if equal(tag, "field-assign"):
        return nc_infer_field_assign(pool, nodes, prog_idx, stmt_idx, env, sig, fn_idx, funcs, n_params)
    end
    if equal(tag, "assign"):
        let li = nc_class_env_lookup_info(env, get(node.1, 0))
        if li.0 == 0:
            return (nc_infer_fail(pool, 404, node.3, "assign-undefined"), env, sig, 0, 0)
        end
        let r = nc_infer_expr(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params)
        if r.0 != 0:
            return (r.0, r.2, r.3, r.4, 0)
        end
        -- A direct never-returning call will stay unknown on every round.
        -- Keep the prior binding so dependent calls retain their targets.
        if r.1 == nc_type_unknown():
            if nc_infer_phase(pool).0 == 2:
                if nc_rhs_never_returns(nodes, prog_idx, get(kids, 0)):
                    return (0, r.2, r.3, r.4, 0)
                end
            end
        end
        let rb = nc_rebind_env_type(pool, r.2, li.1, li.2, r.1, node.3)
        if rb.0 != 0:
            return (rb.0, r.2, r.3, r.4, 0)
        end
        return (0, rb.1, r.3, r.4, 0)
    end
    if equal(tag, "return"):
        let r = nc_infer_expr(pool, nodes, prog_idx, get(kids, 0), env, sig, fn_idx, funcs, n_params)
        if r.0 != 0:
            return (r.0, r.2, r.3, r.4, 1)
        end
        sig = r.3
        let changed = r.4
        if nc_func_never_returns(nodes, prog_idx, nc_poly_current_base(funcs, fn_idx)):
            return (0, r.2, sig, changed, 1)
        end
        if r.1 != 0:
            let su = nc_sig_unify_ret(pool, sig, fn_idx, r.1, node.3, nodes, prog_idx, funcs)
            if su.0 != 0:
                return (su.0, r.2, sig, changed, 1)
            end
            sig = su.1
            changed = nc_or_changed(changed, su.2)
        else:
            let retc = nc_sig_get_ret(sig, fn_idx)
            if retc != 0:
                let cu = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), r.2, retc, sig, fn_idx, funcs, n_params)
                if cu.0 != 0:
                    return (cu.0, cu.1, cu.2, changed, 1)
                end
                sig = cu.2
                changed = nc_or_changed(changed, cu.3)
            end
        end
        return (0, r.2, sig, changed, 1)
    end
    if equal(tag, "do"):
        let call_node = get(nodes, get(kids, 0))
        if equal(call_node.0, "record-new"):
            return (nc_infer_fail(pool, 448, call_node.3, ""), env, sig, 0, 0)
        end
        if equal(call_node.0, "call"):
            let name = get(call_node.1, 0)
            let ckids = call_node.2
            -- Supported void builtins share the same arity-first rule.
            -- In particular, append/add must not silently discard extra args.
            if err_is_void_builtin(name) and count(ckids) != err_void_builtin_arity(name):
                return (nc_infer_fail(pool, 420, call_node.3, name), env, sig, 0, 0)
            end
            if equal(name, "process_exit"):
                let pe = nc_constrain_expr(pool, nodes, prog_idx, get(ckids, 0), env, nc_type_int(), sig, fn_idx, funcs, n_params)
                -- No new noreturn inference: retain the existing syntactic
                -- return requirement, including checking following statements.
                return (pe.0, pe.1, pe.2, pe.3, 0)
            end
            if equal(name, "append"):
                let b = nc_constrain_buffer_value(pool, nodes, prog_idx, get(ckids, 0), env, sig, fn_idx, funcs, n_params, call_node.3)
                if b.0 != 0:
                    return (b.0, b.1, b.2, b.3, 0)
                end
                let v = nc_constrain_expr(pool, nodes, prog_idx, get(ckids, 1), b.1, nc_type_int(), b.2, fn_idx, funcs, n_params)
                return (v.0, v.1, v.2, nc_or_changed(b.3, v.3), 0)
            end
            if equal(name, "add"):
                let a = nc_infer_expr(pool, nodes, prog_idx, get(ckids, 0), env, sig, fn_idx, funcs, n_params)
                if a.0 != 0:
                    return (a.0, a.2, a.3, a.4, 0)
                end
                let v = nc_infer_expr(pool, nodes, prog_idx, get(ckids, 1), a.2, a.3, fn_idx, funcs, n_params)
                if v.0 != 0:
                    return (v.0, v.2, v.3, nc_or_changed(a.4, v.4), 0)
                end
                let changed = nc_or_changed(a.4, v.4)
                env = v.2
                sig = v.3
                if a.1 == nc_type_unknown():
                    let elem = v.1
                    if elem == nc_type_unknown():
                        elem = nc_type_unknown()
                    end
                    let ar = nc_constrain_expr(pool, nodes, prog_idx, get(ckids, 0), env, nc_type_intern_array(pool, elem), sig, fn_idx, funcs, n_params)
                    return (ar.0, ar.1, ar.2, nc_or_changed(changed, ar.3), 0)
                end
                if not nc_type_is_array(pool, a.1):
                    return (nc_infer_fail(pool, 435, call_node.3, ""), env, sig, changed, 0)
                end
                let elem_t = nc_type_array_elem(pool, a.1)
                if v.1 == nc_type_unknown():
                    let vc = nc_constrain_expr(pool, nodes, prog_idx, get(ckids, 1), env, elem_t, sig, fn_idx, funcs, n_params)
                    return (vc.0, vc.1, vc.2, nc_or_changed(changed, vc.3), 0)
                end
                let ok = nc_expect_array_elem(pool, v.1, elem_t, call_node.3)
                if ok != 0:
                    return (ok, env, sig, changed, 0)
                end
                if nc_type_has_unknown(pool, elem_t) and v.1 != nc_type_unknown():
                    let ar2 = nc_constrain_expr(pool, nodes, prog_idx, get(ckids, 0), env, nc_type_intern_array(pool, v.1), sig, fn_idx, funcs, n_params)
                    return (ar2.0, ar2.1, ar2.2, nc_or_changed(changed, ar2.3), 0)
                end
                return (0, env, sig, changed, 0)
            end
            if equal(name, "flogger"):
                let s = nc_constrain_flogger_string_value(pool, nodes, prog_idx, get(ckids, 0), env, sig, fn_idx, funcs, n_params, call_node.3)
                return (s.0, s.1, s.2, s.3, 0)
            end
            if equal(name, "fwriter"):
                let sf = nc_constrain_flogger_string_value(pool, nodes, prog_idx, get(ckids, 0), env, sig, fn_idx, funcs, n_params, call_node.3)
                return (sf.0, sf.1, sf.2, sf.3, 0)
            end
            return (nc_infer_fail(pool, 404, node.3, name), env, sig, 0, 0)
        end
        return (nc_infer_fail(pool, 404, node.3, "do"), env, sig, 0, 0)
    end
    if equal(tag, "if"):
        let r = nc_infer_if(pool, nodes, prog_idx, kids, env, sig, fn_idx, funcs, n_params, node.3)
        if stmt_ends_return(stmt_idx, nodes):
            return (r.0, r.1, r.2, r.3, 1)
        end
        return (r.0, r.1, r.2, r.3, 0)
    end
    if equal(tag, "while"):
        let w = nc_infer_while(pool, nodes, prog_idx, kids, env, sig, fn_idx, funcs, n_params, node.3)
        return (w.0, w.1, w.2, w.3, 0)
    end
    return (nc_infer_fail(pool, 404, node.3, tag), env, sig, 0, 0)
end

func nc_infer_body(pool, nodes, prog_idx, stmts, i, n, env, sig, fn_idx, funcs, n_params, changed):
    if i >= n:
        return (0, env, sig, changed)
    end
    let r = nc_infer_stmt(pool, nodes, prog_idx, get(stmts, i), env, sig, fn_idx, funcs, n_params)
    if r.0 != 0:
        return (r.0, r.1, r.2, nc_or_changed(changed, r.3))
    end
    changed = nc_or_changed(changed, r.3)
    if r.4 != 0:
        return (0, r.1, r.2, changed)
    end
    return nc_infer_body(pool, nodes, prog_idx, stmts, i + 1, n, r.1, r.2, fn_idx, funcs, n_params, changed)
end

func nc_contrib_add(contribs, env):
    do add(contribs, env)
    return contribs
end

func nc_join_merge_class(pool, a, b, line):
    if a == 0:
        return (0, b)
    end
    if b == 0:
        return (0, a)
    end
    let m = nc_type_merge(pool, a, b, line)
    return (m.0, m.1)
end

func nc_join_one_index(pool, contribs, idx, j, n, cur, line):
    if j >= n:
        return (0, cur)
    end
    let env = get(contribs, j)
    let m = nc_join_merge_class(pool, cur, nc_class_env_class(env, idx), line)
    if m.0 != 0:
        return m
    end
    return nc_join_one_index(pool, contribs, idx, j + 1, n, m.1, line)
end

-- The joined environment keeps the entry's names and count; a slot whose
-- merged class differs from the entry's is the only one copied.
func nc_join_build_loop(pool, entry_env, contribs, i, n, env, line):
    if i >= n:
        return (0, env)
    end
    let klass = nc_class_env_class(entry_env, i)
    if count(contribs) > 0:
        let m = nc_join_one_index(pool, contribs, i, 0, count(contribs), 0, line)
        if m.0 != 0:
            return (m.0, env)
        end
        if m.1 != klass:
            env = nc_class_env_set_idx(env, i, m.1)
        end
    end
    return nc_join_build_loop(pool, entry_env, contribs, i + 1, n, env, line)
end

func nc_join_env(pool, entry_env, contribs, line):
    return nc_join_build_loop(pool, entry_env, contribs, 0, entry_env.0, entry_env, line)
end

-- A loop is inferred like an if without else: the condition is a bool against
-- the entry env, the body starts from the entry env, and the exit env joins the
-- entry env (zero iterations) with the body's exit when the body can fall
-- through. Rebinding keeps widths, so one pass over the body is enough.
func nc_infer_while(pool, nodes, prog_idx, kids, env, sig, fn_idx, funcs, n_params, line):
    let entry_env = nc_class_env_clone(env)
    let c = nc_constrain_expr(pool, nodes, prog_idx, get(kids, 0), entry_env, nc_type_bool(), sig, fn_idx, funcs, n_params)
    if c.0 != 0:
        return (c.0, entry_env, c.2, c.3)
    end
    sig = c.2
    let changed = c.3
    let body_idx = get(kids, 1)
    let body = get(nodes, body_idx)
    let br = nc_infer_body(pool, nodes, prog_idx, body.2, 0, count(body.2), nc_class_env_clone(entry_env), sig, fn_idx, funcs, n_params, 0)
    if br.0 != 0:
        return (br.0, entry_env, br.2, nc_or_changed(changed, br.3))
    end
    sig = br.2
    changed = nc_or_changed(changed, br.3)
    let contribs = new_array((int, array(array(string)), array(array(int))))
    if not body_ends_return(body_idx, nodes):
        contribs = nc_contrib_add(contribs, nc_class_env_prefix(br.1, entry_env.0))
    end
    contribs = nc_contrib_add(contribs, nc_class_env_clone(entry_env))
    let joined = nc_join_env(pool, entry_env, contribs, line)
    if joined.0 != 0:
        return (joined.0, entry_env, sig, changed)
    end
    return (0, joined.1, sig, changed)
end

func nc_if_has_else(nodes, kids):
    if count(kids) == 0:
        return false
    end
    let last = get(nodes, get(kids, count(kids) - 1))
    return equal(last.0, "else")
end

func nc_infer_if_arms(pool, nodes, prog_idx, kids, i, n, entry_env, sig, fn_idx, funcs, n_params, contribs, changed):
    if i >= n:
        return (0, contribs, sig, changed)
    end
    let arm = get(nodes, get(kids, i))
    let body_idx = 0
    let env_for_body = nc_class_env_clone(entry_env)
    if equal(arm.0, "else"):
        body_idx = get(arm.2, 0)
    else:
        let c = nc_constrain_expr(pool, nodes, prog_idx, get(arm.2, 0), entry_env, nc_type_bool(), sig, fn_idx, funcs, n_params)
        if c.0 != 0:
            return (c.0, contribs, c.2, nc_or_changed(changed, c.3))
        end
        sig = c.2
        changed = nc_or_changed(changed, c.3)
        body_idx = get(arm.2, 1)
    end
    let body = get(nodes, body_idx)
    let br = nc_infer_body(pool, nodes, prog_idx, body.2, 0, count(body.2), env_for_body, sig, fn_idx, funcs, n_params, 0)
    if br.0 != 0:
        return (br.0, contribs, br.2, nc_or_changed(changed, br.3))
    end
    sig = br.2
    changed = nc_or_changed(changed, br.3)
    if not body_ends_return(body_idx, nodes):
        contribs = nc_contrib_add(contribs, nc_class_env_prefix(br.1, entry_env.0))
    end
    return nc_infer_if_arms(pool, nodes, prog_idx, kids, i + 1, n, entry_env, sig, fn_idx, funcs, n_params, contribs, changed)
end

func nc_infer_if(pool, nodes, prog_idx, kids, env, sig, fn_idx, funcs, n_params, line):
    let entry_env = nc_class_env_clone(env)
    let contribs = new_array((int, array(array(string)), array(array(int))))
    let arms = nc_infer_if_arms(pool, nodes, prog_idx, kids, 0, count(kids), entry_env, sig, fn_idx, funcs, n_params, contribs, 0)
    if arms.0 != 0:
        return (arms.0, entry_env, arms.2, arms.3)
    end
    contribs = arms.1
    if not nc_if_has_else(nodes, kids):
        contribs = nc_contrib_add(contribs, nc_class_env_clone(entry_env))
    end
    let joined = nc_join_env(pool, entry_env, contribs, line)
    if joined.0 != 0:
        return (joined.0, entry_env, arms.2, arms.3)
    end
    return (0, joined.1, arms.2, arms.3)
end

func nc_poly_infer_instance(pool, nodes, prog_idx, funcs, inst_idx, sig):
    let prog = get(nodes, prog_idx)
    let inst = get(funcs.0, inst_idx)
    let fn_node = get(nodes, get(prog.2, inst.0))
    do get(fn_node.1, 0)
    let params_node = get(nodes, get(fn_node.2, 0))
    let body_node = get(nodes, get(fn_node.2, 1))
    let input_scope = nc_check_input_scope(pool, nodes, fn_node)
    if input_scope != 0:
        return (input_scope, sig, 0)
    end
    let env = nc_func_env_from_params(nodes, fn_node, sig, inst_idx)
    let br = nc_infer_body(pool, nodes, prog_idx, body_node.2, 0, count(body_node.2), env, sig, inst_idx, funcs, count(params_node.1), 0)
    return (br.0, br.2, br.3)
end

func nc_poly_infer_instances_loop(pool, nodes, prog_idx, funcs, i, sig, changed):
    if i >= count(funcs.0):
        return (0, sig, changed)
    end
    let r = nc_poly_infer_instance(pool, nodes, prog_idx, funcs, i, sig)
    if r.0 != 0:
        return r
    end
    return nc_poly_infer_instances_loop(pool, nodes, prog_idx, funcs, i + 1, r.1, nc_or_changed(changed, r.2))
end

func nc_poly_sig_solve_loop(pool, nodes, prog_idx, funcs, sig, remaining):
    let r = nc_poly_infer_instances_loop(pool, nodes, prog_idx, funcs, 0, sig, 0)
    if r.0 != 0:
        return r
    end
    if r.2 == 0:
        return r
    end
    if remaining <= 0:
        return (nc_infer_fail(pool, 424, 0, ""), r.1, 0)
    end
    return nc_poly_sig_solve_loop(pool, nodes, prog_idx, funcs, r.1, remaining - 1)
end

func nc_sig_check_params_loop(pool, sig, fn_idx, i, n):
    if i >= n:
        return 0
    end
    let t = nc_sig_get_param(sig, fn_idx, i)
    if nc_type_has_array_unknown(pool, t):
        return nc_infer_fail(pool, 438, 0, "")
    end
    if nc_type_has_unknown(pool, t):
        return nc_infer_fail(pool, 424, 0, "")
    end
    return nc_sig_check_params_loop(pool, sig, fn_idx, i + 1, n)
end

func nc_poly_sig_check_concrete_loop(pool, nodes, prog_idx, funcs, i, sig):
    if i >= count(funcs.0):
        return 0
    end
    let prog = get(nodes, prog_idx)
    let inst = get(funcs.0, i)
    let fn = get(nodes, get(prog.2, inst.0))
    let pn = get(nodes, get(fn.2, 0))
    let pr = nc_sig_check_params_loop(pool, sig, i, 0, count(pn.1))
    if pr != 0:
        return pr
    end
    let nret = nc_func_never_returns_node(nodes, fn)
    let ret = nc_sig_get_ret(sig, i)
    if not nret:
        if nc_type_has_array_unknown(pool, ret):
            return nc_infer_fail(pool, 438, fn.3, "")
        end
        if nc_type_has_unknown(pool, ret):
            return nc_infer_fail(pool, 424, fn.3, "")
        end
    end
    if i == 0 and equal(get(fn.1, 0), "main"):
        if ret != nc_type_int() and ret != nc_type_bool() and not nc_type_is_renderable_aggregate(pool, ret):
            return nc_infer_fail(pool, 432, fn.3, "")
        end
    end
    return nc_poly_sig_check_concrete_loop(pool, nodes, prog_idx, funcs, i + 1, sig)
end

-- Scan EVERY parsed node (the whole pool) for an `nc_class_mix` poison node and
-- return its line, or 0 if none. Class-mix is a syntactic error the parser plants
-- on any class-mixing expression (parse_bitwise/parse_bitwise_loop), so a single
-- linear scan of the pool catches it in ANY function -- reachable from main or
-- not -- matching the C reference, which rejects class-mix syntactically for all
-- functions.
func nc_class_mix_scan_loop(nodes, i, n):
    if i >= n:
        return 0
    end
    if equal(get(nodes, i).0, "nc_class_mix"):
        return get(nodes, i).3
    end
    return nc_class_mix_scan_loop(nodes, i + 1, n)
end

func nc_class_mix_line(nodes):
    return nc_class_mix_scan_loop(nodes, 0, count(nodes))
end

-- Downstream of inference a record is the tuple of its fields, so lowering,
-- metadata and the emitter see exactly the program written with tuples.
func nc_type_erase_list(pool, kids, i, out):
    if i >= count(kids):
        return out
    end
    do add(out, nc_type_erase(pool, get(kids, i)))
    return nc_type_erase_list(pool, kids, i + 1, out)
end

func nc_type_erase(pool, t):
    if t < nc_type_struct_base():
        return t
    end
    if nc_type_is_array(pool, t):
        return nc_type_intern_array(pool, nc_type_erase(pool, nc_type_array_elem(pool, t)))
    end
    let fields = nc_type_intern_tuple(pool, nc_type_erase_list(pool, nc_type_children(pool, t), 0, new_array(int)))
    if nc_type_is_ref_record(pool, t):
        return nc_type_intern_array(pool, fields)
    end
    return fields
end

func nc_erase_param_lists(pool, lists, i, out):
    if i >= count(lists):
        return out
    end
    do add(out, nc_type_erase_list(pool, get(lists, i), 0, new_array(int)))
    return nc_erase_param_lists(pool, lists, i + 1, out)
end

func nc_erase_verified(pool, nodes, prog_idx, verified):
    if count(get(nodes, prog_idx).1) == 0:
        return verified
    end
    let sig = verified.1
    let erased = (nc_erase_param_lists(pool, sig.0, 0, new_array(array(int))), nc_type_erase_list(pool, sig.1, 0, new_array(int)))
    return (verified.0, erased, verified.2)
end

func nc_record_names_dup_loop(nodes, recs, name, i, seen):
    if i >= count(recs):
        return seen
    end
    if equal(get(get(nodes, parse_decimal(get(recs, i))).1, 0), name):
        seen = seen + 1
    end
    return nc_record_names_dup_loop(nodes, recs, name, i + 1, seen)
end

func nc_record_fields_dup_loop(atoms, i):
    if i >= count(atoms):
        return ""
    end
    if nc_record_field_index_loop(atoms, get(atoms, i), 1) != i - 1:
        return get(atoms, i)
    end
    return nc_record_fields_dup_loop(atoms, i + 1)
end

-- Declaration checks, before inference: a record's name is its own, its
-- fields are distinct, and its field types exist and do not contain it (ERR 447,
-- or 434 for an unknown type name).
func nc_records_check(pool, nodes, prog_idx, recs, i):
    if i >= count(recs):
        return 0
    end
    let decl_idx = parse_decimal(get(recs, i))
    let decl = get(nodes, decl_idx)
    let name = get(decl.1, 0)
    if nc_func_lookup(nodes, prog_idx, name).0 != 0:
        return nc_fail(447, decl.3, diagnostic_with_payload("record '", name, "' has the name of a function"))
    end
    if err_is_builtin_name(name):
        return nc_fail(447, decl.3, diagnostic_with_payload("record '", name, "' has the name of a builtin"))
    end
    if nc_record_names_dup_loop(nodes, recs, name, 0, 0) > 1:
        return nc_fail(447, decl.3, diagnostic_with_payload("record '", name, "' is declared more than once"))
    end
    let dup = nc_record_fields_dup_loop(decl.1, 1)
    if length(dup) > 0:
        return nc_fail(447, decl.3, diagnostic_with_payload("field '", dup, "' is declared more than once"))
    end
    let rt = nc_record_type(pool, nodes, decl_idx, new_array(int))
    if rt.0 != 0:
        return rt.0
    end
    return nc_records_check(pool, nodes, prog_idx, recs, i + 1)
end

func nc_poly_field_find_loop(fields, inst, node, i):
    if i >= count(fields):
        return 0 - 1
    end
    let f = get(fields, i)
    if f.0 == inst and f.1 == node:
        return i
    end
    return nc_poly_field_find_loop(fields, inst, node, i + 1)
end

-- Field resolutions per instance: (instance, node, field index, field count,
-- the record's declaration node, whose tag says value or ref).
func nc_poly_note_field(poly, inst, node, field_index, field_count, decl_idx):
    if nc_poly_field_find_loop(poly.3, inst, node, 0) == 0 - 1:
        do add(poly.3, (inst, node, field_index, field_count, decl_idx))
    end
    return 0
end

func nc_verify_ast(nodes, prog_idx, pool):
    -- Reachability-independent class-mix rejection (matches C: a syntactic error in
    -- ANY function, reachable or not). This runs FIRST -- before the function-table
    -- check and the reachability-seeded poly verify (nc_poly_seed_main only seeds
    -- `main` and its call graph). It must precede nc_table_check because a class-mix
    -- makes the parser stop cleanly at end-of-input (plant_class_mix), which can
    -- drop a trailing `main`; reporting the table error first would mask the real
    -- ERR 442 (and diverge from C). A class-mix buried in dead code is no longer
    -- silently accepted, and a class-mix in a called function -- which used to
    -- crash the parser (`get: ... out of range`) -- now rejects cleanly here.
    let mix_line = nc_class_mix_line(nodes)
    if mix_line > 0:
        let mix_instances = new_array((int, array(int), int, int, int, int))
        let mix_targets = new_array((int, int, int))
        return (nc_fail(442, mix_line, ""), nc_sig_init(nodes, prog_idx), (mix_instances, mix_targets, new_array((int, int)), new_array((int, int, int, int, int))))
    end
    let tbl = nc_table_check(nodes, prog_idx)
    if tbl != 0:
        let empty_instances = new_array((int, array(int), int, int, int, int))
        let empty_targets = new_array((int, int, int))
        return (tbl, nc_sig_init(nodes, prog_idx), (empty_instances, empty_targets, new_array((int, int)), new_array((int, int, int, int, int))))
    end
    let rec_check = nc_records_check(pool, nodes, prog_idx, get(nodes, prog_idx).1, 0)
    if rec_check != 0:
        let rec_instances = new_array((int, array(int), int, int, int, int))
        let rec_targets = new_array((int, int, int))
        return (rec_check, nc_sig_init(nodes, prog_idx), (rec_instances, rec_targets, new_array((int, int)), new_array((int, int, int, int, int))))
    end
    -- Preserve successful inference and its instance/emission order. Only an
    -- ERR 430 after an unresolved scalar assignment needs a fresh inference.
    do add(pool.1, (0, count(pool.2)))
    let first = nc_verify_inference(pool, nodes, prog_idx, nc_poly_seed_main(nodes, prog_idx))
    if first.0 == 0:
        do add(pool.1, (3, count(pool.2)))
        return nc_erase_verified(pool, nodes, prog_idx, first)
    end
    let phase = nc_infer_phase(pool)
    let original = get(pool.2, phase.1)
    if phase.0 == 1:
        do add(pool.1, (2, count(pool.2)))
        let retry = nc_verify_inference(pool, nodes, prog_idx, nc_poly_seed_main(nodes, prog_idx))
        if retry.0 == 0:
            do add(pool.1, (3, count(pool.2)))
            return nc_erase_verified(pool, nodes, prog_idx, retry)
        end
    end
    do add(pool.1, (3, count(pool.2)))
    return (nc_fail(original.0, original.1, original.2), first.1, first.2)
end

func nc_verify_inference(pool, nodes, prog_idx, seeded):
    let solved = nc_poly_sig_solve_loop(pool, nodes, prog_idx, seeded.1, seeded.0, nc_poly_max_instances())
    if solved.0 != 0:
        return (solved.0, solved.1, seeded.1)
    end
    let concrete = nc_poly_sig_check_concrete_loop(pool, nodes, prog_idx, seeded.1, 0, solved.1)
    if concrete != 0:
        return (concrete, solved.1, seeded.1)
    end
    let replay = nc_poly_infer_instances_loop(pool, nodes, prog_idx, seeded.1, 0, solved.1, 0)
    return (replay.0, replay.1, seeded.1)
end

-- ====================================================================
-- BYTECODE VERIFY, LAYOUT, AND EMISSION
-- ====================================================================

func nc_code_branches_to_loop(code, target, i, n):
    if i >= n:
        return false
    end
    let instr = get(code, i)
    let op = instr.0
    if op == 16 or op == 17 or op == 18 or op == 19:
        if instr.1 == target:
            return true
        end
    end
    return nc_code_branches_to_loop(code, target, i + 1, n)
end

func nc_code_branches_to(code, target):
    return nc_code_branches_to_loop(code, target, 0, count(code))
end

func nc_is_tail_call(code, i, n):
    if i + 1 >= n:
        return false
    end
    let instr = get(code, i)
    let next = get(code, i + 1)
    if instr.0 != 20 or next.0 != 21:
        return false
    end
    return not nc_code_branches_to(code, i + 1)
end

func nc_opcode_name_for_diag(op):
    if op == 58:
        return "LINUX_SYSCALL6"
    end
    if op == 59:
        return "BUFFER_ADDRESS"
    end
    if op == 60:
        return "BUFFER_GET"
    end
    if op == 61:
        return "BUFFER_SET"
    end
    if op == 62:
        return "BUFFER_LENGTH"
    end
    if op == 63:
        return "ARR_ADD_KEEP"
    end
    if op == 64:
        return "SET_FIELD"
    end
    if op == 65:
        return "GET_FIELD"
    end
    if op == 57:
        return "BOOT_READ"
    end
    if op == 1:
        return "PUSH_BOOL"
    end
    if op == 2:
        return "PUSH_STR"
    end
    if op == 14:
        return "MAKE_TUPLE"
    end
    if op == 15:
        return "TUPLE_GET"
    end
    if op == 20:
        return "CALL"
    end
    if op == 22:
        return "LENGTH"
    end
    if op == 23:
        return "INDEX"
    end
    if op == 24:
        return "SLICE"
    end
    if op == 25:
        return "EQUAL"
    end
    if op == 26:
        return "NEW_BUFFER"
    end
    if op == 27:
        return "FREEZE"
    end
    if op == 28:
        return "NEW_ARRAY"
    end
    if op == 29:
        return "GET"
    end
    if op == 30:
        return "COUNT"
    end
    if op == 31:
        return "BUF_APPEND"
    end
    if op == 32:
        return "ARR_ADD"
    end
    if op == 33:
        return "CLOGGER"
    end
    if op == 34:
        return "FLOGGER"
    end
    if op == 35:
        return "FWRITER"
    end
    if op == 36:
        return "BAND"
    end
    if op == 37:
        return "BOR"
    end
    if op == 38:
        return "BXOR"
    end
    if op == 39:
        return "SHL"
    end
    if op == 40:
        return "SHR"
    end
    if op == 41:
        return "BNOT"
    end
    if op == 42:
        return "MUL"
    end
    if op == 43:
        return "DIV"
    end
    if op == 44:
        return "MOD"
    end
    if op == 54:
        return "PROCESS_EXIT"
    end
    if op == 55:
        return "STDERR_WRITE"
    end
    if op == 56:
        return "STDIN_READ"
    end
    return int_to_str(op)
end

func nc_make_stacks_loop(i, n, out):
    if i >= n:
        return out
    end
    do add(out, new_array(int))
    return nc_make_stacks_loop(i + 1, n, out)
end

func nc_make_stacks(n):
    return nc_make_stacks_loop(0, n, new_array(array(int)))
end

func nc_stack_prefix_loop(stack, i, n, out):
    if i >= n:
        return out
    end
    do add(out, get(stack, i))
    return nc_stack_prefix_loop(stack, i + 1, n, out)
end

func nc_stack_prefix(stack, keep):
    return nc_stack_prefix_loop(stack, 0, keep, new_array(int))
end

func nc_stack_push(stack, t):
    let out = nc_stack_prefix(stack, count(stack))
    do add(out, t)
    return out
end

func nc_stack_pop(stack, line):
    let n = count(stack)
    if n == 0:
        return (nc_fail(416, line, ""), stack, 0)
    end
    return (0, nc_stack_prefix(stack, n - 1), get(stack, n - 1))
end

func nc_stack_word_depth_loop(pool, stack, i, n, acc):
    if i >= n:
        return acc
    end
    return nc_stack_word_depth_loop(pool, stack, i + 1, n, acc + nc_type_width(pool, get(stack, i)))
end

func nc_stack_word_depth(pool, stack):
    return nc_stack_word_depth_loop(pool, stack, 0, count(stack), 0)
end

func nc_init_local_types_params(sig, fn_idx, i, n, out):
    if i >= n:
        return out
    end
    do add(out, nc_sig_get_param(sig, fn_idx, i))
    return nc_init_local_types_params(sig, fn_idx, i + 1, n, out)
end

func nc_init_local_types_fill(i, n, out):
    if i >= n:
        return out
    end
    do add(out, nc_type_unknown())
    return nc_init_local_types_fill(i + 1, n, out)
end

func nc_pfrom_ints_loop(src, i, n, chunk, out):
    if i >= n:
        if count(chunk) > 0:
            do add(out, chunk)
        end
        return out
    end
    if count(chunk) == 32:
        do add(out, chunk)
        chunk = new_array(int)
    end
    do add(chunk, get(src, i))
    return nc_pfrom_ints_loop(src, i + 1, n, chunk, out)
end

func nc_pcount(chunks):
    if count(chunks) == 0:
        return 0
    end
    return (count(chunks) - 1) * 32 + count(get(chunks, count(chunks) - 1))
end

-- A function's local types are a persistent chunked array (nc_pget, nc_pset_int):
-- a store copies one chunk, and edge states share chunks with the current state.
func nc_init_local_types(fn, sig, fn_idx):
    let out = nc_init_local_types_params(sig, fn_idx, 0, fn.2, new_array(int))
    let all = nc_init_local_types_fill(fn.2, fn.3, out)
    return nc_pfrom_ints_loop(all, 0, count(all), new_array(int), new_array(array(int)))
end

func nc_meta_expect_type(pool, got, want, line):
    if nc_type_equal(pool, got, want):
        return 0
    end
    return nc_fail(430, line, "")
end

func nc_meta_pop_expect(pool, stack, want, line):
    let p = nc_stack_pop(stack, line)
    if p.0 != 0:
        return p
    end
    let e = nc_meta_expect_type(pool, p.2, want, line)
    if e != 0:
        return (e, p.1, p.2)
    end
    return p
end

func nc_meta_store_local_type(pool, local_types, slot, got, line):
    if slot >= nc_pcount(local_types):
        return (nc_fail(416, line, ""), local_types)
    end
    let old = nc_pget(local_types, slot)
    if old != nc_type_unknown() and got != nc_type_unknown():
        if nc_type_width(pool, old) != nc_type_width(pool, got):
            return (nc_fail(433, line, ""), local_types)
        end
        if nc_type_is_array(pool, old) or nc_type_is_array(pool, got):
            if not nc_type_equal(pool, old, got):
                return (nc_fail(436, line, ""), local_types)
            end
        end
        if not nc_assignment_type_ok(pool, old, got):
            return (nc_fail(430, line, ""), local_types)
        end
    end
    if got == nc_type_unknown():
        return (0, local_types)
    end
    return (0, nc_pset_int(local_types, slot, got))
end

func nc_meta_tuple_children_from_stack(stack, from, i, n, out):
    if i >= n:
        return out
    end
    do add(out, get(stack, from + i))
    return nc_meta_tuple_children_from_stack(stack, from, i + 1, n, out)
end

func nc_meta_pop_call_args(pool, funcs, sig, callee_idx, stack, arg_i, line):
    if arg_i == 0 - 1:
        return (0, stack)
    end
    let p = nc_stack_pop(stack, line)
    if p.0 != 0:
        return (p.0, stack)
    end
    let want = nc_sig_get_param(sig, callee_idx, arg_i)
    let e = nc_meta_expect_type(pool, p.2, want, line)
    if e != 0:
        return (e, p.1)
    end
    return nc_meta_pop_call_args(pool, funcs, sig, callee_idx, p.1, arg_i - 1, line)
end

func nc_meta_call_arg_words_loop(pool, sig, callee_idx, i, n, acc):
    if i >= n:
        return acc
    end
    return nc_meta_call_arg_words_loop(pool, sig, callee_idx, i + 1, n, acc + nc_type_width(pool, nc_sig_get_param(sig, callee_idx, i)))
end

func nc_meta_call_arg_words(pool, funcs, sig, callee_idx):
    let fn = get(funcs, callee_idx)
    return nc_meta_call_arg_words_loop(pool, sig, callee_idx, 0, fn.2, 0)
end

func nc_meta_pop_hosted_memory(pool, stack, remaining, is_buffer):
    if remaining == 0:
        return (0, stack)
    end
    let want = nc_type_int()
    if is_buffer and remaining == 1:
        want = nc_type_buffer()
    end
    let p = nc_meta_pop_expect(pool, stack, want, 0)
    if p.0 != 0:
        return (p.0, p.1)
    end
    return nc_meta_pop_hosted_memory(pool, p.1, remaining - 1, is_buffer)
end

-- Lowered branches are forward-only. Keep immutable stack/local states only on
-- branch edges, then merge them when their target is visited. A return or BR has
-- no fallthrough state. Frame layout separately retains every lexical slot,
-- including slots declared in returning arms that never reach a later join.
func nc_meta_incoming_loop(i, n, out):
    if i >= n:
        return out
    end
    do add(out, new_array((array(int), array(array(int)))))
    return nc_meta_incoming_loop(i + 1, n, out)
end

func nc_meta_layout_types_loop(local_types, i, n, out):
    if i >= n:
        return out
    end
    let slot = new_array(int)
    do add(slot, nc_pget(local_types, i))
    do add(out, slot)
    return nc_meta_layout_types_loop(local_types, i + 1, n, out)
end

func nc_meta_layout_collect(layout_types, i, n, out):
    if i >= n:
        return out
    end
    let slot = get(layout_types, i)
    do add(out, get(slot, count(slot) - 1))
    return nc_meta_layout_collect(layout_types, i + 1, n, out)
end

func nc_meta_merge_types(pool, a, b, i, n, locals, out):
    if i >= n:
        return (0, out)
    end
    let at = get(a, i)
    let bt = get(b, i)
    if locals and (at == nc_type_unknown() or bt == nc_type_unknown()):
        -- A local is initialized at a join only if every live predecessor
        -- initialized it. Layout knowledge must not make it readable here.
        do add(out, nc_type_unknown())
    else:
        let m = nc_type_merge(pool, at, bt, 0)
        if m.0 != 0:
            return (m.0, out)
        end
        do add(out, m.1)
    end
    return nc_meta_merge_types(pool, a, b, i + 1, n, locals, out)
end

-- At a join a local keeps its class only where every predecessor initialized
-- it (see nc_meta_merge_types); only slots whose merged class differs from the
-- current state's are copied. The merge calls are the same, slot by slot.
func nc_meta_merge_locals(pool, a, b, i, n, out):
    if i >= n:
        return (0, out)
    end
    let at = nc_pget(a, i)
    let bt = nc_pget(b, i)
    let mt = nc_type_unknown()
    if at != nc_type_unknown() and bt != nc_type_unknown():
        let m = nc_type_merge(pool, at, bt, 0)
        if m.0 != 0:
            return (m.0, out)
        end
        mt = m.1
    end
    if mt != at:
        out = nc_pset_int(out, i, mt)
    end
    return nc_meta_merge_locals(pool, a, b, i + 1, n, out)
end

-- The targets of backward unconditional branches (a loop's branch back to its
-- condition). Programs without a loop have none and skip the records below.
func nc_meta_back_targets(code, i, n, out):
    if i >= n:
        return out
    end
    let instr = get(code, i)
    if instr.0 == 16 and instr.1 < i:
        do add(out, instr.1)
    end
    return nc_meta_back_targets(code, i + 1, n, out)
end

func nc_int_array_has(a, i, n, value):
    if i >= n:
        return false
    end
    if get(a, i) == value:
        return true
    end
    return nc_int_array_has(a, i + 1, n, value)
end

func nc_meta_top_find(tops, i, n, pc):
    if i >= n:
        return 0 - 1
    end
    if get(tops, i).0 == pc:
        return i
    end
    return nc_meta_top_find(tops, i + 1, n, pc)
end

func nc_meta_stack_same_loop(pool, a, b, i, n):
    if i >= n:
        return 0
    end
    let m = nc_type_merge(pool, get(a, i), get(b, i), 0)
    if m.0 != 0:
        return m.0
    end
    if m.1 != get(a, i):
        return nc_fail(416, 0, "")
    end
    return nc_meta_stack_same_loop(pool, a, b, i + 1, n)
end

func nc_meta_locals_same_loop(a, b, i, n):
    if i >= n:
        return 0
    end
    if nc_pget(a, i) != nc_pget(b, i):
        return nc_fail(414, 0, "")
    end
    return nc_meta_locals_same_loop(a, b, i + 1, n)
end

-- A branch back to a loop's condition: the state arriving there must merge into
-- the state recorded when the scan passed the condition without changing it,
-- so the one forward pass checked the body under the state of every iteration.
-- Slots are never reused, so a body-local let is unknown at the top and stays
-- unknown under the join; only a loop-carried slot whose class moved fails.
func nc_meta_back_edge_ok(pool, tops, target, stack, local_types):
    let k = nc_meta_top_find(tops, 0, count(tops), target)
    if k == 0 - 1:
        return nc_fail(415, 0, int_to_str(target))
    end
    let top = get(tops, k)
    if count(stack) != count(top.1) or nc_pcount(local_types) != nc_pcount(top.2):
        return nc_fail(416, 0, "")
    end
    let s = nc_meta_stack_same_loop(pool, top.1, stack, 0, count(stack))
    if s != 0:
        return s
    end
    let lm = nc_meta_merge_locals(pool, top.2, local_types, 0, nc_pcount(top.2), top.2)
    if lm.0 != 0:
        return lm.0
    end
    return nc_meta_locals_same_loop(lm.1, top.2, 0, nc_pcount(top.2))
end

func nc_meta_enter_flow(pool, incoming, i, n, stack, local_types, live):
    if i >= n:
        return (0, stack, local_types, live)
    end
    let edge = get(incoming, i)
    if not live:
        return nc_meta_enter_flow(pool, incoming, i + 1, n, edge.0, edge.1, true)
    end
    if count(stack) != count(edge.0) or nc_pcount(local_types) != nc_pcount(edge.1):
        return (nc_fail(416, 0, ""), stack, local_types, live)
    end
    let sm = nc_meta_merge_types(pool, stack, edge.0, 0, count(stack), false, new_array(int))
    if sm.0 != 0:
        return (sm.0, stack, local_types, live)
    end
    let lm = nc_meta_merge_locals(pool, local_types, edge.1, 0, nc_pcount(local_types), local_types)
    if lm.0 != 0:
        return (lm.0, stack, local_types, live)
    end
    return nc_meta_enter_flow(pool, incoming, i + 1, n, sm.1, lm.1, true)
end

-- The scan's result: a status (0 or an error) and what it gathered. Error
-- returns carry the streams gathered so far, which the caller discards.
record MetaScan:
    status: int
    layout_types: array(int)
    stacks: array(array(int))
    tuple_meta: array((int, int, int))
    call_meta: array((int, int, int))
    max_stack: int
    max_sret: int
    input_kind: int
    heap_meta: array((int, int, int))
    has_heap: int
end

func nc_meta_process_loop(pool, funcs, sig, fn_idx, main_idx, strings_count, code, new_array_meta, i, n, stack, local_types, stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap, flow):
    if i >= n:
        let layout_types = nc_meta_layout_collect(flow.2, 0, count(flow.2), new_array(int))
        return MetaScan(0, layout_types, stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
    end
    let incoming = get(flow.0, i)
    let enter = nc_meta_enter_flow(pool, incoming, 0, count(incoming), stack, local_types, flow.1)
    if enter.0 != 0:
        return MetaScan(enter.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
    end
    if not enter.3:
        return MetaScan(nc_fail(416, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
    end
    stack = enter.1
    local_types = enter.2
    flow = (flow.0, true, flow.2, flow.3, flow.4)
    if nc_int_array_has(flow.3, 0, count(flow.3), i):
        do add(flow.4, (i, stack, local_types))
    end
    -- The pass visits each instruction once, in increasing index order. Build
    -- dense metadata streams alongside it; copying an n-entry array for each
    -- CALL/projection/heap operation made both work and arena use quadratic.
    -- Errors return partial streams, which nc_analyze_program_loop discards.
    let tuple_entry = (0 - 1, 0 - 1, 0 - 1)
    let call_entry = (0, 0, 0)
    let heap_entry = (0, 0, 0)
    let instr = get(code, i)
    let op = instr.0
    if op == 17 or op == 18 or op == 19:
        if instr.1 <= i or instr.1 >= n:
            return MetaScan(nc_fail(415, 0, int_to_str(instr.1)), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
    end
    if op == 16:
        if instr.1 == i or instr.1 >= n:
            return MetaScan(nc_fail(415, 0, int_to_str(instr.1)), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
    end
    let na_type = get(new_array_meta, i)
    if op == 28:
        if na_type == 0:
            return MetaScan(nc_fail(439, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
    elif na_type != 0:
        return MetaScan(nc_fail(439, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
    end
    if op >= 26 and op <= 32:
        has_heap = 1
    end
    max_stack = nc_max_i(max_stack, nc_stack_word_depth(pool, stack))
    if op == 0:
        stack = nc_stack_push(stack, nc_type_int())
    elif op == 1:
        if instr.1 != 0 and instr.1 != 1:
            return MetaScan(nc_fail(417, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(stack, nc_type_bool())
    elif op == 2:
        if instr.1 >= strings_count:
            return MetaScan(nc_fail(428, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(stack, nc_type_string())
    elif op == 3:
        if instr.1 >= nc_pcount(local_types):
            return MetaScan(nc_fail(416, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let lt = nc_pget(local_types, instr.1)
        if nc_type_has_unknown(pool, lt):
            return MetaScan(nc_fail(424, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(stack, lt)
    elif op == 4:
        let p = nc_stack_pop(stack, 0)
        if p.0 != 0:
            return MetaScan(p.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let st = nc_meta_store_local_type(pool, local_types, instr.1, p.2, 0)
        if st.0 != 0:
            return MetaScan(st.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = p.1
        local_types = st.1
        if p.2 != nc_type_unknown():
            do add(get(flow.2, instr.1), p.2)
        end
    elif op == 5 or op == 6 or op == 36 or op == 37 or op == 38 or op == 39 or op == 40 or op == 42 or op == 43 or op == 44:
        -- add/sub, the bitwise/shift binops (band/bor/bxor/shl/shr), and the
        -- multiplicative binops (mul/div/mod) all pop two ints and push one int;
        -- identical stack discipline.
        let r = nc_meta_pop_expect(pool, stack, nc_type_int(), 0)
        if r.0 != 0:
            return MetaScan(r.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let l = nc_meta_pop_expect(pool, r.1, nc_type_int(), 0)
        if l.0 != 0:
            return MetaScan(l.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(l.1, nc_type_int())
    elif op == 41:
        -- bnot: pop one int, push one int (the int-typed counterpart of op 13).
        let p = nc_meta_pop_expect(pool, stack, nc_type_int(), 0)
        if p.0 != 0:
            return MetaScan(p.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(p.1, nc_type_int())
    elif op == 7 or op == 8 or op == 9 or op == 10 or op == 11 or op == 12:
        let r = nc_meta_pop_expect(pool, stack, nc_type_int(), 0)
        if r.0 != 0:
            return MetaScan(r.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let l = nc_meta_pop_expect(pool, r.1, nc_type_int(), 0)
        if l.0 != 0:
            return MetaScan(l.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(l.1, nc_type_bool())
    elif op == 13:
        let p = nc_meta_pop_expect(pool, stack, nc_type_bool(), 0)
        if p.0 != 0:
            return MetaScan(p.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(p.1, nc_type_bool())
    elif op == 14:
        if count(stack) < instr.1:
            return MetaScan(nc_fail(416, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let from = count(stack) - instr.1
        let kids = nc_meta_tuple_children_from_stack(stack, from, 0, instr.1, new_array(int))
        stack = nc_stack_prefix(stack, from)
        stack = nc_stack_push(stack, nc_type_intern_tuple(pool, kids))
    elif op == 15:
        let p = nc_stack_pop(stack, 0)
        if p.0 != 0:
            return MetaScan(p.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if not nc_type_is_tuple(pool, p.2):
            return MetaScan(nc_fail(431, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let kids = nc_type_tuple_children(pool, p.2)
        if instr.1 >= count(kids):
            return MetaScan(nc_fail(431, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let elem_t = get(kids, instr.1)
        let tw = nc_type_width(pool, p.2)
        let es = nc_tuple_child_start_loop(pool, kids, 0, instr.1, 0)
        let ew = nc_type_width(pool, elem_t)
        tuple_entry = (tw, es, ew)
        stack = nc_stack_push(p.1, elem_t)
    elif op == 16:
        if instr.1 < i:
            let back = nc_meta_back_edge_ok(pool, flow.4, instr.1, stack, local_types)
            if back != 0:
                return MetaScan(back, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
            end
        else:
            do add(get(flow.0, instr.1), (stack, local_types))
        end
        flow = (flow.0, false, flow.2, flow.3, flow.4)
    elif op == 17:
        let p = nc_meta_pop_expect(pool, stack, nc_type_bool(), 0)
        if p.0 != 0:
            return MetaScan(p.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = p.1
        do add(get(flow.0, instr.1), (stack, local_types))
    elif op == 18 or op == 19:
        let p = nc_meta_pop_expect(pool, stack, nc_type_bool(), 0)
        if p.0 != 0:
            return MetaScan(p.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        -- Short-circuit edges retain their bool; only the RHS path pops it.
        do add(get(flow.0, instr.1), (stack, local_types))
        stack = p.1
    elif op == 20:
        if instr.1 >= count(funcs):
            return MetaScan(nc_fail(426, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if instr.1 == main_idx:
            return MetaScan(nc_fail(421, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let callee = get(funcs, instr.1)
        if instr.2 != callee.2:
            return MetaScan(nc_fail(426, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let popped = nc_meta_pop_call_args(pool, funcs, sig, instr.1, stack, instr.2 - 1, 0)
        if popped.0 != 0:
            return MetaScan(popped.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let ret0 = nc_sig_get_ret(sig, instr.1)
        let nev = ret0 == nc_type_unknown()
        let ret = ret0
        if nev:
            ret = nc_sig_get_ret(sig, fn_idx)
        end
        let rw = nc_type_width(pool, ret)
        let aw = nc_meta_call_arg_words(pool, funcs, sig, instr.1)
        let kind = 0
        if rw > 1:
            kind = 1
        end
        if not nev and nc_is_tail_call(code, i, n):
            let my_ret = nc_sig_get_ret(sig, fn_idx)
            let my_rw = nc_type_width(pool, my_ret)
            let my_aw = nc_meta_call_arg_words(pool, funcs, sig, fn_idx)
            if aw == my_aw and rw == my_rw:
                if rw > 1:
                    kind = 3
                else:
                    kind = 2
                end
            end
        end
        call_entry = (aw, rw, kind)
        if kind == 1 and rw > max_sret:
            max_sret = rw
        end
        stack = nc_stack_push(popped.1, ret)
    elif op == 21:
        if count(stack) != 1:
            return MetaScan(nc_fail(416, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let ret = nc_sig_get_ret(sig, fn_idx)
        if ret != nc_type_unknown():
            if not nc_type_equal(pool, get(stack, 0), ret):
                return MetaScan(nc_fail(430, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
            end
        end
        stack = new_array(int)
        flow = (flow.0, false, flow.2, flow.3, flow.4)
    elif op == 22:
        let p = nc_meta_pop_expect(pool, stack, nc_type_string(), 0)
        if p.0 != 0:
            return MetaScan(p.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(p.1, nc_type_int())
    elif op == 23:
        let idx = nc_meta_pop_expect(pool, stack, nc_type_int(), 0)
        if idx.0 != 0:
            return MetaScan(idx.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let strv = nc_meta_pop_expect(pool, idx.1, nc_type_string(), 0)
        if strv.0 != 0:
            return MetaScan(strv.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(strv.1, nc_type_int())
    elif op == 25:
        let r = nc_meta_pop_expect(pool, stack, nc_type_string(), 0)
        if r.0 != 0:
            return MetaScan(r.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let l = nc_meta_pop_expect(pool, r.1, nc_type_string(), 0)
        if l.0 != 0:
            return MetaScan(l.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(l.1, nc_type_bool())
    elif op == 24:
        return MetaScan(nc_fail(438, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
    elif op == 26:
        heap_entry = (4, 0, 0)
        stack = nc_stack_push(stack, nc_type_buffer())
    elif op == 27:
        let p = nc_meta_pop_expect(pool, stack, nc_type_buffer(), 0)
        if p.0 != 0:
            return MetaScan(nc_fail(437, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(p.1, nc_type_string())
    elif op == 28:
        if not nc_type_is_array(pool, na_type):
            return MetaScan(nc_fail(439, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let elem_t = nc_type_array_elem(pool, na_type)
        let elem_w = nc_type_width(pool, elem_t)
        if elem_w <= 0:
            return MetaScan(nc_fail(438, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        heap_entry = (1, elem_w, elem_t)
        stack = nc_stack_push(stack, na_type)
    elif op == 29:
        let idx = nc_meta_pop_expect(pool, stack, nc_type_int(), 0)
        if idx.0 != 0:
            return MetaScan(idx.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let arr = nc_stack_pop(idx.1, 0)
        if arr.0 != 0:
            return MetaScan(arr.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if not nc_type_is_array(pool, arr.2):
            return MetaScan(nc_fail(435, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let elem_t = nc_type_array_elem(pool, arr.2)
        let elem_w = nc_type_width(pool, elem_t)
        heap_entry = (2, elem_w, elem_t)
        stack = nc_stack_push(arr.1, elem_t)
    elif op == 30:
        let arr = nc_stack_pop(stack, 0)
        if arr.0 != 0:
            return MetaScan(arr.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if not nc_type_is_array(pool, arr.2):
            return MetaScan(nc_fail(435, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(arr.1, nc_type_int())
    elif op == 31:
        let val = nc_meta_pop_expect(pool, stack, nc_type_int(), 0)
        if val.0 != 0:
            return MetaScan(val.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let bufv = nc_meta_pop_expect(pool, val.1, nc_type_buffer(), 0)
        if bufv.0 != 0:
            return MetaScan(nc_fail(437, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = bufv.1
    elif op == 32:
        let val = nc_stack_pop(stack, 0)
        if val.0 != 0:
            return MetaScan(val.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let arr = nc_stack_pop(val.1, 0)
        if arr.0 != 0:
            return MetaScan(arr.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if not nc_type_is_array(pool, arr.2):
            return MetaScan(nc_fail(435, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let elem_t = nc_type_array_elem(pool, arr.2)
        let elem_w = nc_type_width(pool, elem_t)
        let ok = nc_expect_array_elem(pool, val.2, elem_t, 0)
        if ok != 0:
            return MetaScan(ok, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        heap_entry = (3, elem_w, elem_t)
        stack = arr.1
    elif op == 63:
        -- ARR_ADD_KEEP: add, leaving the array (a ref record) on the stack.
        let val = nc_stack_pop(stack, 0)
        if val.0 != 0:
            return MetaScan(val.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let arr = nc_stack_pop(val.1, 0)
        if arr.0 != 0:
            return MetaScan(arr.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if not nc_type_is_array(pool, arr.2):
            return MetaScan(nc_fail(435, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let elem_t = nc_type_array_elem(pool, arr.2)
        let elem_w = nc_type_width(pool, elem_t)
        let ok = nc_expect_array_elem(pool, val.2, elem_t, 0)
        if ok != 0:
            return MetaScan(ok, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        heap_entry = (3, elem_w, elem_t)
        stack = nc_stack_push(arr.1, arr.2)
    elif op == 65:
        -- GET_FIELD (field index): a ref record's field read in place. Records
        -- the element's (width, field start, field width) for the emitter, as
        -- TUPLE_GET does. Not faultable: the one element exists by construction.
        let arr = nc_stack_pop(stack, 0)
        if arr.0 != 0:
            return MetaScan(arr.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if not nc_type_is_array(pool, arr.2):
            return MetaScan(nc_fail(435, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let rec_t = nc_type_array_elem(pool, arr.2)
        if not nc_type_is_tuple(pool, rec_t):
            return MetaScan(nc_fail(431, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let kids = nc_type_tuple_children(pool, rec_t)
        if instr.1 >= count(kids):
            return MetaScan(nc_fail(431, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let field_t = get(kids, instr.1)
        tuple_entry = (nc_type_width(pool, rec_t), nc_tuple_child_start_loop(pool, kids, 0, instr.1, 0), nc_type_width(pool, field_t))
        stack = nc_stack_push(arr.1, field_t)
    elif op == 64:
        -- SET_FIELD (offset, width): a ref record's field written in place.
        let val = nc_stack_pop(stack, 0)
        if val.0 != 0:
            return MetaScan(val.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        let arr = nc_stack_pop(val.1, 0)
        if arr.0 != 0:
            return MetaScan(arr.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if not nc_type_is_array(pool, arr.2):
            return MetaScan(nc_fail(435, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        -- A value whose width is not the field's (a never-returning helper's
        -- result, whose type inference left open) is the width change that the
        -- same update of a value record reports.
        if nc_type_width(pool, val.2) != instr.2:
            return MetaScan(nc_fail(433, 0, ""), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = arr.1
    elif op == 33:
        if fn_idx != main_idx:
            return MetaScan(nc_fail(408, 0, "CLOGGER"), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if has_clogger != 0:
            let payload = ""
            if has_clogger == 2:
                payload = "stdin_read"
            end
            return MetaScan(nc_fail(411, 0, payload), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        has_clogger = 1
        has_heap = 1
        stack = nc_stack_push(stack, nc_type_string())
    elif op == 34:
        let p = nc_meta_pop_expect(pool, stack, nc_type_string(), 0)
        if p.0 != 0:
            return MetaScan(p.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = p.1
    elif op == 35:
        let pf = nc_meta_pop_expect(pool, stack, nc_type_string(), 0)
        if pf.0 != 0:
            return MetaScan(pf.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = pf.1
    elif op == 54:
        let pe = nc_meta_pop_expect(pool, stack, nc_type_int(), 0)
        if pe.0 != 0:
            return MetaScan(pe.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = pe.1
    elif op == 55:
        let sw = nc_meta_pop_expect(pool, stack, nc_type_string(), 0)
        if sw.0 != 0:
            return MetaScan(sw.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(sw.1, nc_type_int())
    elif op >= 58 and op <= 62:
        let arity = 1
        if op == 58:
            arity = 7
        elif op == 60:
            arity = 2
        elif op == 61:
            arity = 3
        end
        let hm = nc_meta_pop_hosted_memory(pool, stack, arity, op != 58)
        if hm.0 != 0:
            return MetaScan(hm.0, new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        stack = nc_stack_push(hm.1, nc_type_int())
    elif op == 56:
        if fn_idx != main_idx:
            return MetaScan(nc_fail(408, 0, "STDIN_READ"), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        if has_clogger != 0:
            return MetaScan(nc_fail(411, 0, "stdin_read"), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
        end
        -- Historical flag name; 1=legacy input, 2=checked input. Consumers
        -- outside this function only test nonzero, not the input's type.
        has_clogger = 2
        has_heap = 1
        stack = nc_stack_push(stack, nc_type_stdin_result(pool))
    else:
        return MetaScan(nc_fail(408, 0, nc_opcode_name_for_diag(op)), new_array(int), stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap)
    end
    max_stack = nc_max_i(max_stack, nc_stack_word_depth(pool, stack))
    do add(tuple_meta, tuple_entry)
    do add(call_meta, call_entry)
    do add(heap_meta, heap_entry)
    return nc_meta_process_loop(pool, funcs, sig, fn_idx, main_idx, strings_count, code, new_array_meta, i + 1, n, stack, local_types, stacks, tuple_meta, call_meta, max_stack, max_sret, has_clogger, heap_meta, has_heap, flow)
end

func nc_build_local_layout_loop(pool, local_types, i, n, bases, widths, base):
    if i >= n:
        return (0, bases, widths, base)
    end
    let t = get(local_types, i)
    if nc_type_has_array_unknown(pool, t):
        return (nc_fail(438, 0, ""), bases, widths, base)
    end
    if nc_type_has_unknown(pool, t):
        return (nc_fail(424, 0, ""), bases, widths, base)
    end
    let w = nc_type_width(pool, t)
    do add(bases, base)
    do add(widths, w)
    return nc_build_local_layout_loop(pool, local_types, i + 1, n, bases, widths, base + w)
end

-- One function's frame layout and per-instruction facts, read by the emitter.
record FunctionMeta:
    pwords: int
    ret: int
    retw: int
    bases: array(int)
    widths: array(int)
    local_words: int
    sret_word: int
    scratch_base: int
    max_sret: int
    stacks: array(array(int))
    tuple_meta: array((int, int, int))
    call_meta: array((int, int, int))
    max_stack: int
    input_kind: int
    heap_meta: array((int, int, int))
    has_heap: int
end

func nc_build_one_meta(pool, prog, sig, fn_idx):
    let funcs = prog.0
    let fn = get(funcs, fn_idx)
    let code = fn.4
    let n = count(code)
    let heap_meta0 = new_array((int, int, int))
    if n == 0 or get(code, n - 1).0 != 21:
        return (nc_fail(416, 0, ""), FunctionMeta(0, 0, 0, new_array(int), new_array(int), 0, 0, 0, 0, new_array(array(int)), new_array((int, int, int)), new_array((int, int, int)), 0, 0, heap_meta0, 0))
    end
    if count(fn.5) != n:
        return (nc_fail(439, 0, ""), FunctionMeta(0, 0, 0, new_array(int), new_array(int), 0, 0, 0, 0, new_array(array(int)), new_array((int, int, int)), new_array((int, int, int)), 0, 0, heap_meta0, 0))
    end
    if count(fn.6) != n:
        return (nc_fail(439, 0, ""), FunctionMeta(0, 0, 0, new_array(int), new_array(int), 0, 0, 0, 0, new_array(array(int)), new_array((int, int, int)), new_array((int, int, int)), 0, 0, heap_meta0, 0))
    end
    let local_types = nc_init_local_types(fn, sig, fn_idx)
    let stacks = nc_make_stacks(0)
    let tuple_meta = new_array((int, int, int))
    let call_meta = new_array((int, int, int))
    let incoming = nc_meta_incoming_loop(0, n, new_array(array((array(int), array(array(int))))))
    let layout_types = nc_meta_layout_types_loop(local_types, 0, nc_pcount(local_types), new_array(array(int)))
    let back_targets = nc_meta_back_targets(code, 0, n, new_array(int))
    let tops = new_array((int, array(int), array(array(int))))
    let flow = (incoming, true, layout_types, back_targets, tops)
    let p = nc_meta_process_loop(pool, funcs, sig, fn_idx, prog.2, count(prog.1), code, fn.5, 0, n, new_array(int), local_types, stacks, tuple_meta, call_meta, 0, 0, 0, heap_meta0, 0, flow)
    if p.status != 0:
        return (p.status, FunctionMeta(0, 0, 0, new_array(int), new_array(int), 0, 0, 0, 0, stacks, tuple_meta, call_meta, 0, 0, p.heap_meta, p.has_heap))
    end
    let lay = nc_build_local_layout_loop(pool, p.layout_types, 0, count(p.layout_types), new_array(int), new_array(int), 0)
    if lay.0 != 0:
        return (lay.0, FunctionMeta(0, 0, 0, new_array(int), new_array(int), 0, 0, 0, 0, stacks, tuple_meta, call_meta, 0, 0, p.heap_meta, p.has_heap))
    end
    let ret = nc_sig_get_ret(sig, fn_idx)
    let retw = nc_type_width(pool, ret)
    let pwords = nc_meta_call_arg_words(pool, funcs, sig, fn_idx)
    let sret_word = 0 - 1
    let hidden = 0
    if retw > 1:
        sret_word = lay.3
        hidden = 1
    end
    let scratch_base = 0 - 1
    if p.max_sret > 0:
        scratch_base = lay.3 + hidden
    end
    return (0, FunctionMeta(pwords, ret, retw, lay.1, lay.2, lay.3, sret_word, scratch_base, p.max_sret, p.stacks, p.tuple_meta, p.call_meta, p.max_stack, p.input_kind, p.heap_meta, p.has_heap))
end

func nc_analyze_program_loop(pool, prog, sig, i, n, metas, has_clogger, has_heap):
    if i >= n:
        return (0, metas, has_clogger, has_heap)
    end
    let m = nc_build_one_meta(pool, prog, sig, i)
    if m.0 != 0:
        return (m.0, metas, has_clogger, has_heap)
    end
    do add(metas, m.1)
    if m.1.input_kind != 0:
        has_clogger = 1
    end
    if m.1.has_heap != 0:
        has_heap = 1
    end
    return nc_analyze_program_loop(pool, prog, sig, i + 1, n, metas, has_clogger, has_heap)
end

func nc_analyze_program(pool, prog, sig):
    return nc_analyze_program_loop(pool, prog, sig, 0, count(prog.0), new_array(FunctionMeta), 0, 0)
end

func nc_code_has_faultable_loop(code, i, n):
    if i >= n:
        return 0
    end
    let op = get(code, i).0
    -- 23/29/31 = index/get/append OOB faults; 43/44 = div/mod by-zero fault.
    -- A faultable op forces the fault-helper block (incl. the exit1 routine the
    -- div/mod zero-check jumps to) to be emitted. op_mul (42) never faults.
    if op == 23 or op == 29 or op == 31 or op == 43 or op == 44 or op == 60 or op == 61:
        return 1
    end
    return nc_code_has_faultable_loop(code, i + 1, n)
end

func nc_funcs_have_faultable_loop(funcs, i, n):
    if i >= n:
        return 0
    end
    if nc_code_has_faultable_loop(get(funcs, i).4, 0, count(get(funcs, i).4)) != 0:
        return 1
    end
    return nc_funcs_have_faultable_loop(funcs, i + 1, n)
end

func nc_prog_has_faultable(prog):
    return nc_funcs_have_faultable_loop(prog.0, 0, count(prog.0))
end

-- Little-endian byte-serialization helpers. Now that tonka added * / %, these
-- use real remainder/division. Pre-tonka (no * / %) they were O(value)
-- repeated-subtraction loops, which hung compilation on a large literal whose
-- PUSH_INT byte split ran billions of iterations (D15 -- throne). The byte
-- values are unchanged; only the cost is (O(value) -> O(1) per byte).
func nc_mod256(v):
    return v % 256
end

func nc_div256(v):
    return v / 256
end

func nc_append_le32(buf, v):
    let b0 = nc_mod256(v)
    let v1 = nc_div256(v)
    let b1 = nc_mod256(v1)
    let v2 = nc_div256(v1)
    let b2 = nc_mod256(v2)
    let v3 = nc_div256(v2)
    let b3 = nc_mod256(v3)
    do append(buf, b0)
    do append(buf, b1)
    do append(buf, b2)
    do append(buf, b3)
    return buf
end

func nc_append_le64(buf, v):
    let b0 = nc_mod256(v)
    let v1 = nc_div256(v)
    let b1 = nc_mod256(v1)
    let v2 = nc_div256(v1)
    let b2 = nc_mod256(v2)
    let v3 = nc_div256(v2)
    let b3 = nc_mod256(v3)
    let v4 = nc_div256(v3)
    let b4 = nc_mod256(v4)
    let v5 = nc_div256(v4)
    let b5 = nc_mod256(v5)
    let v6 = nc_div256(v5)
    let b6 = nc_mod256(v6)
    let v7 = nc_div256(v6)
    let b7 = nc_mod256(v7)
    do append(buf, b0)
    do append(buf, b1)
    do append(buf, b2)
    do append(buf, b3)
    do append(buf, b4)
    do append(buf, b5)
    do append(buf, b6)
    do append(buf, b7)
    return buf
end

func nc_append_s32(buf, neg, mag):
    if neg == 0:
        return nc_append_le32(buf, mag)
    end
    let m = mag - 1
    let b0 = nc_mod256(m)
    let v1 = nc_div256(m)
    let b1 = nc_mod256(v1)
    let v2 = nc_div256(v1)
    let b2 = nc_mod256(v2)
    let v3 = nc_div256(v2)
    let b3 = nc_mod256(v3)
    do append(buf, 255 - b0)
    do append(buf, 255 - b1)
    do append(buf, 255 - b2)
    do append(buf, 255 - b3)
    return buf
end

func nc_append_s8(buf, neg, mag):
    if neg == 0:
        do append(buf, mag)
    elif mag == 0:
        do append(buf, 0)
    else:
        do append(buf, 256 - mag)
    end
    return buf
end

func nc_signed_fits8(neg, mag):
    if neg == 0:
        return mag <= 127
    end
    return mag <= 128
end

func nc_rel_ok(target, base):
    if target >= base:
        return target - base < 2147483648
    end
    return base - target <= 2147483648
end

func nc_append_rel32(buf, target, base):
    if target >= base:
        return nc_append_le32(buf, target - base)
    end
    return nc_append_s32(buf, 1, base - target)
end

func nc_mul8_loop(acc, n):
    if n <= 0:
        return acc
    end
    return nc_mul8_loop(acc + 8, n - 1)
end

func nc_mul8(n):
    return nc_mul8_loop(0, n)
end

func nc_mod16_loop(v):
    if v < 16:
        return v
    end
    return nc_mod16_loop(v - 16)
end

func nc_mod16(v):
    return nc_mod16_loop(v)
end

func nc_round16_up(v):
    let m = nc_mod16(v)
    if m == 0:
        return v
    end
    return v + 16 - m
end

func nc_disp_len_rbp(neg, mag):
    if nc_signed_fits8(neg, mag):
        return 4
    end
    return 7
end

func nc_disp_len_rsp(mag):
    if mag <= 127:
        return 5
    end
    return 8
end

func nc_disp_len_rdi(mag):
    if mag == 0:
        return 3
    end
    if mag <= 127:
        return 4
    end
    return 7
end

func nc_disp_len_rsi(mag):
    if mag == 0:
        return 3
    end
    if mag <= 127:
        return 4
    end
    return 7
end

func nc_disp_len_rsp_r8(mag):
    if mag <= 127:
        return 5
    end
    return 8
end

func nc_disp_pair_from_pos_minus(pos, sub):
    if pos >= sub:
        return (0, pos - sub)
    end
    return (1, sub - pos)
end

func nc_rslot_pair(ng, nf):
    let pos = 8 + nc_mul8(ng)
    let sub = nc_mul8(nf)
    return nc_disp_pair_from_pos_minus(pos, sub)
end

func nc_tail_dst_pair(ng, k):
    let pos = 8 + nc_mul8(ng)
    let sub = nc_mul8(k)
    return nc_disp_pair_from_pos_minus(pos, sub)
end

func nc_tail_copy_len_loop(k, nf, ng, acc):
    if k >= nf:
        return acc
    end
    let src = nc_mul8(nf - 1 - k)
    let dst = nc_tail_dst_pair(ng, k)
    return nc_tail_copy_len_loop(k + 1, nf, ng, acc + nc_disp_len_rsp(src) + nc_disp_len_rbp(dst.0, dst.1))
end

func nc_tail_len(ng, nf):
    let rslot = nc_rslot_pair(ng, nf)
    return 8 + nc_tail_copy_len_loop(0, nf, ng, 0) + nc_disp_len_rbp(rslot.0, rslot.1) + nc_disp_len_rbp(rslot.0, rslot.1) + 3 + 5
end

func nc_cleanup_len(nargs):
    if nc_mul8(nargs) <= 127:
        return 4
    end
    return 7
end

func nc_local_mag(slot):
    return nc_mul8(slot + 1)
end

func nc_sub_len(frame_sz):
    if frame_sz <= 127:
        return 4
    end
    return 7
end

func nc_prologue_len(frame_sz):
    return 4 + nc_sub_len(frame_sz)
end

func nc_max_i(a, b):
    if a > b:
        return a
    end
    return b
end

func nc_frame_total_words(meta):
    let hidden = 0
    if meta.sret_word != 0 - 1:
        hidden = 1
    end
    return meta.local_words + hidden + meta.max_sret
end

func nc_frame_total(meta):
    return nc_round16_up(nc_mul8(nc_frame_total_words(meta)))
end

func nc_fault_route_len():
    return 12
end

func nc_fault_rodata_len():
    return 135
end

func nc_fault_helper_len():
    return 418
end

func nc_write_helper_len():
    return 46
end

func nc_render_int_body_len():
    return 58
end

func nc_render_bool_body_len():
    return 75
end

func nc_render_body_len(main_ret):
    if main_ret == nc_type_bool():
        return nc_render_bool_body_len()
    end
    return nc_render_int_body_len()
end

func nc_render_len(main_ret):
    return nc_render_body_len(main_ret) + nc_write_helper_len()
end

func nc_entry_head_len():
    return 19
end

func nc_entry_layout(has_heap, has_faultable, main_ret, rplan):
    let heap_len = 0
    if has_heap != 0:
        heap_len = 70
    end
    let head_len = nc_entry_head_len()
    let render_len = nc_render_len(main_ret)
    -- link11/link12: a renderable AGGREGATE main (non-empty render plan) inlines its
    -- whole render into the entry head and places the int/bool/str/write helpers in
    -- the render region; the single-word int/bool path keeps the scalar head +
    -- body+write. (A flat int/bool tuple's plan reproduces the garland byte length.)
    if count(rplan) > 0:
        let s = nc_tuple_sret_size(nc_rplan_words(rplan))
        head_len = nc_render_agg_head_len(s, rplan)
        render_len = nc_render_helpers_len()
    end
    let fault_len = 0
    if has_faultable != 0:
        fault_len = nc_fault_helper_len()
    end
    let fault_start = heap_len + head_len
    let render_start = fault_start + fault_len
    let function_start = render_start + render_len
    return (heap_len, head_len, fault_len, render_len, fault_start, render_start, function_start)
end

func nc_fault_helper_start(has_heap, has_faultable, main_ret, rplan):
    return nc_entry_layout(has_heap, has_faultable, main_ret, rplan).4
end

func nc_fault_diag_index_rel():
    return 0
end

func nc_fault_diag_get_rel():
    return 106
end

func nc_fault_diag_append_rel():
    return 212
end

func nc_fault_write_fd2_rel():
    return 307
end

func nc_fault_dec_fd2_rel():
    return 353
end

func nc_fault_exit1_rel():
    return 406
end

func nc_fault_prefix_off():
    return 0
end

func nc_fault_sep_index_off():
    return 14
end

func nc_fault_sep_get_off():
    return 32
end

func nc_fault_sep_append_off():
    return 48
end

func nc_fault_mid_len_off():
    return 69
end

func nc_fault_mid_cnt_off():
    return 91
end

func nc_fault_mid_byte_off():
    return 112
end

func nc_fault_close_paren_nl_off():
    return 132
end

func nc_fault_just_nl_off():
    return 134
end

func nc_arg_copy_len_loop(k, nwords, acc):
    if k >= nwords:
        return acc
    end
    let src_mag = 16 + nc_mul8(nwords - 1 - k)
    let dst_mag = nc_local_mag(k)
    return nc_arg_copy_len_loop(k + 1, nwords, acc + nc_disp_len_rbp(0, src_mag) + nc_disp_len_rbp(1, dst_mag))
end

func nc_load_local_len_loop(base, j, width, acc):
    if j >= width:
        return acc
    end
    return nc_load_local_len_loop(base, j + 1, width, acc + nc_disp_len_rbp(1, nc_local_mag(base + j)) + 1)
end

func nc_load_local_len(base, width):
    return nc_load_local_len_loop(base, 0, width, 0)
end

func nc_store_local_len_loop(base, j, acc):
    if j == 0 - 1:
        return acc
    end
    return nc_store_local_len_loop(base, j - 1, acc + 1 + nc_disp_len_rbp(1, nc_local_mag(base + j)))
end

func nc_store_local_len(base, width):
    return nc_store_local_len_loop(base, width - 1, 0)
end

func nc_sret_save_len(meta):
    if meta.sret_word == 0 - 1:
        return 0
    end
    return nc_disp_len_rbp(1, nc_local_mag(meta.sret_word))
end

func nc_group_single_len(op):
    if op == 0:
        return 11
    end
    if op == 1:
        return 2
    end
    if op == 2:
        return 16
    end
    if op == 5 or op == 6:
        return 6
    end
    if op == 7 or op == 8 or op == 9 or op == 10 or op == 11 or op == 12:
        return 13
    end
    if op == 13:
        return 12
    end
    if op == 14:
        return 0
    end
    if op == 16:
        return 5
    end
    if op == 17:
        return 10
    end
    if op == 18 or op == 19:
        return 17
    end
    if op == 21:
        return 3
    end
    if op == 22:
        return 3
    end
    if op == 23:
        return 27
    end
    if op == 25:
        return 50
    end
    if op == 26:
        return 84
    end
    if op == 27:
        return 75
    end
    if op == 28:
        return 84
    end
    if op == 30:
        return 5
    end
    if op == 31:
        return 135
    end
    if op == 33:
        return 91
    end
    if op == 34:
        return 44
    end
    if op == 35:
        return 593
    end
    if op == 54:
        return 10
    end
    if op == 55:
        return 55
    end
    if op == 56:
        return 106
    end
    if op == 58:
        return 13
    end
    if op == 59:
        return 6
    end
    if op == 60:
        return 33
    end
    if op == 61:
        return 56
    end
    if op == 62:
        return 5
    end
    -- Bitwise / shift (36-41). LOAD-BEARING for branch-displacement layout:
    -- pass 1 sizes every instruction here; a missing arm would give the new
    -- ops length 0 and silently rot every branch offset in any function that
    -- uses them. band/bor/bxor/shl/shr are the same 6-byte shape as add/sub
    -- (pop rcx; pop rax; <3-byte op>; push rax); bnot is 5 bytes (pop rax;
    -- not rax; push rax) like op 30 (count).
    if op == 36 or op == 37 or op == 38 or op == 39 or op == 40:
        return 6
    end
    if op == 41:
        return 5
    end
    -- Multiplicative (42-44). LOAD-BEARING for branch-displacement layout: a
    -- wrong length here silently rots every branch offset in any function that
    -- uses these ops. mul is 7 bytes (pop rcx; pop rax; imul rax,rcx [4 bytes];
    -- push rax). div and mod are 18 bytes each: pop rcx; pop rax; test rcx,rcx
    -- [3]; jz exit1 [6]; xor rdx,rdx [3]; div rcx [3]; push rax|rdx [1]. These
    -- MUST match the byte counts emitted by nc_emit_mul / nc_emit_div_or_mod.
    if op == 42:
        return 7
    end
    if op == 43 or op == 44:
        return 18
    end
    return 0
end

func nc_get_loads_len(width, j, acc):
    if j >= width:
        return acc
    end
    return nc_get_loads_len(width, j + 1, acc + nc_disp_len_rsi(nc_mul8(j)) + 1)
end

func nc_get_len(width):
    if width == 1:
        return 32
    end
    return 51 + nc_get_loads_len(width, 0, 0)
end

func nc_arr_add_store_len(width, k, acc):
    if k == 0 - 1:
        return acc
    end
    return nc_arr_add_store_len(width, k - 1, acc + 1 + nc_disp_len_rsi(nc_mul8(k)))
end

-- SET_FIELD (op 64): [array, w value words] -> stores the words into the
-- array's element at word offset off, then drops the array. Emitted only for a
-- ref record, whose one element exists by construction, so there is no check.
--   mov rax, [rsp + 8w]; mov rax, [rax + 16]; (pop rcx; mov [rax + 8(off + j)], rcx) for j = w-1..0; add rsp, 8
func nc_emit_rax_field_store(buf, mag):
    do append(buf, 72)
    do append(buf, 137)
    if mag <= 127:
        do append(buf, 72)
        do append(buf, mag)
        return buf
    end
    do append(buf, 136)
    return nc_append_le32(buf, mag)
end

func nc_emit_set_field_stores(buf, off, j):
    if j == 0 - 1:
        return buf
    end
    do append(buf, 89)
    buf = nc_emit_rax_field_store(buf, nc_mul8(off + j))
    return nc_emit_set_field_stores(buf, off, j - 1)
end

func nc_emit_set_field(buf, off, w):
    do append(buf, 72)
    do append(buf, 139)
    let mag = nc_mul8(w)
    if mag <= 127:
        do append(buf, 68)
        do append(buf, 36)
        do append(buf, mag)
    else:
        do append(buf, 132)
        do append(buf, 36)
        buf = nc_append_le32(buf, mag)
    end
    do append(buf, 72)
    do append(buf, 139)
    do append(buf, 64)
    do append(buf, 16)
    buf = nc_emit_set_field_stores(buf, off, w - 1)
    do append(buf, 72)
    do append(buf, 131)
    do append(buf, 196)
    do append(buf, 8)
    return buf
end

func nc_set_field_store_len(off, j, acc):
    if j == 0 - 1:
        return acc
    end
    let mag = nc_mul8(off + j)
    let one = 7
    if mag <= 127:
        one = 4
    end
    return nc_set_field_store_len(off, j - 1, acc + 1 + one)
end

-- GET_FIELD (op 65): [ref record] -> the field's w words, read from the
-- record's one element at word offset s. Emitted only for a ref record, whose
-- element exists by construction, so there is no check.
--   pop rax; mov rax, [rax + 16]; push qword [rax + 8(s + j)] for j = 0..w-1
func nc_emit_get_field_loads(buf, s, j, w):
    if j >= w:
        return buf
    end
    let mag = nc_mul8(s + j)
    do append(buf, 255)
    if mag <= 127:
        do append(buf, 112)
        do append(buf, mag)
    else:
        do append(buf, 176)
        buf = nc_append_le32(buf, mag)
    end
    return nc_emit_get_field_loads(buf, s, j + 1, w)
end

func nc_emit_get_field(buf, meta, pc):
    let tm = get(meta.tuple_meta, pc)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 139)
    do append(buf, 64)
    do append(buf, 16)
    return nc_emit_get_field_loads(buf, tm.1, 0, tm.2)
end

func nc_get_field_loads_len(s, j, w, acc):
    if j >= w:
        return acc
    end
    let one = 6
    if nc_mul8(s + j) <= 127:
        one = 3
    end
    return nc_get_field_loads_len(s, j + 1, w, acc + one)
end

func nc_get_field_len(meta, pc):
    let tm = get(meta.tuple_meta, pc)
    return 5 + nc_get_field_loads_len(tm.1, 0, tm.2, 0)
end

func nc_set_field_len(off, w):
    let head = 8
    if nc_mul8(w) <= 127:
        head = 5
    end
    return head + 4 + nc_set_field_store_len(off, w - 1, 0) + 4
end

func nc_arr_add_len(width):
    return nc_disp_len_rsp_r8(nc_mul8(width)) + 177 + nc_arr_add_store_len(width, width - 1, 0)
end

func nc_rsp_store_len(mag):
    return nc_disp_len_rsp(mag)
end

func nc_tuple_get_copy_len_loop(j, f, w, s, acc):
    if j >= f:
        return acc
    end
    let src = nc_mul8(w - 1 - (s + j))
    let dst = nc_mul8(w - 1 - j)
    return nc_tuple_get_copy_len_loop(j + 1, f, w, s, acc + nc_disp_len_rsp(src) + nc_rsp_store_len(dst))
end

func nc_tuple_get_len(meta, pc):
    let tm = get(meta.tuple_meta, pc)
    let drop = tm.0 - tm.2
    let cleanup = 0
    if drop > 0:
        cleanup = nc_cleanup_len(drop)
    end
    return nc_tuple_get_copy_len_loop(0, tm.2, tm.0, tm.1, 0) + cleanup
end

func nc_sret_scratch_mag(base_word, ret_width, k):
    return nc_mul8(base_word + ret_width - k)
end

func nc_call_ret_push_len_loop(base_word, ret_width, k, n, acc):
    if k >= n:
        return acc
    end
    return nc_call_ret_push_len_loop(base_word, ret_width, k + 1, n, acc + nc_disp_len_rbp(1, nc_sret_scratch_mag(base_word, ret_width, k)) + 1)
end

func nc_normal_call_len(meta, pc):
    let cm = get(meta.call_meta, pc)
    if cm.2 == 1:
        return nc_disp_len_rbp(1, nc_sret_scratch_mag(meta.scratch_base, cm.1, 0)) + 5 + nc_cleanup_len(cm.0) + nc_call_ret_push_len_loop(meta.scratch_base, cm.1, 0, cm.1, 0)
    end
    return 5 + nc_cleanup_len(cm.0) + 1
end

func nc_tail_len_for_meta(meta, pc):
    let cm = get(meta.call_meta, pc)
    let extra = 0
    if cm.2 == 3:
        extra = nc_disp_len_rbp(1, nc_local_mag(meta.sret_word))
    end
    return nc_tail_len(meta.pwords, cm.0) + extra
end

func nc_aggregate_ret_store_len_loop(k, retw, acc):
    if k == 0 - 1:
        return acc
    end
    return nc_aggregate_ret_store_len_loop(k - 1, retw, acc + 1 + nc_disp_len_rdi(nc_mul8(k)))
end

func nc_ret_len(meta):
    if meta.retw <= 1:
        return 3
    end
    return nc_disp_len_rbp(1, nc_local_mag(meta.sret_word)) + nc_aggregate_ret_store_len_loop(meta.retw - 1, meta.retw, 0) + 2
end

func nc_group(code, i, n, fn, funcs, meta, metas):
    if i >= n:
        return (0, n)
    end
    let instr = get(code, i)
    let op = instr.0
    if op == 3:
        let base = get(meta.bases, instr.1)
        let width = get(meta.widths, instr.1)
        return (nc_load_local_len(base, width), i + 1)
    end
    if op == 4:
        let base = get(meta.bases, instr.1)
        let width = get(meta.widths, instr.1)
        return (nc_store_local_len(base, width), i + 1)
    end
    if op == 15:
        return (nc_tuple_get_len(meta, i), i + 1)
    end
    if op == 29:
        return (nc_get_len(get(meta.heap_meta, i).1), i + 1)
    end
    if op == 32:
        return (nc_arr_add_len(get(meta.heap_meta, i).1), i + 1)
    end
    if op == 63:
        return (nc_arr_add_len(get(meta.heap_meta, i).1) - 4, i + 1)
    end
    if op == 64:
        return (nc_set_field_len(instr.1, instr.2), i + 1)
    end
    if op == 65:
        return (nc_get_field_len(meta, i), i + 1)
    end
    if op == 20:
        let cm = get(meta.call_meta, i)
        if cm.2 == 2 or cm.2 == 3:
            return (nc_tail_len_for_meta(meta, i), i + 2)
        end
        return (nc_normal_call_len(meta, i), i + 1)
    end
    if op == 21:
        return (nc_ret_len(meta), i + 1)
    end
    return (nc_group_single_len(op), i + 1)
end

func nc_pass1_fill_group(offs, bounds, j, next_i, cur, start):
    if j >= next_i:
        return (offs, bounds)
    end
    do add(offs, cur)
    if j == start:
        do add(bounds, 1)
    else:
        do add(bounds, 0)
    end
    return nc_pass1_fill_group(offs, bounds, j + 1, next_i, cur, start)
end

func nc_pass1_layout_loop(code, i, n, cur, offs, bounds, fn, funcs, meta, metas):
    if i >= n:
        do add(offs, cur)
        do add(bounds, 0)
        return (offs, bounds, cur)
    end
    let g = nc_group(code, i, n, fn, funcs, meta, metas)
    let filled = nc_pass1_fill_group(offs, bounds, i, g.1, cur, i)
    return nc_pass1_layout_loop(code, g.1, n, cur + g.0, filled.0, filled.1, fn, funcs, meta, metas)
end

func nc_pass1_layout(fn, funcs, meta, metas, prefix_len):
    return nc_pass1_layout_loop(fn.4, 0, count(fn.4), prefix_len, new_array(int), new_array(int), fn, funcs, meta, metas)
end

func nc_branch_end_delta(op):
    if op == 16:
        return 5
    end
    if op == 17:
        return 10
    end
    return 13
end

func nc_branch_and_rel_verify_loop(code, i, n, fn, funcs, meta, metas, layout, layouts):
    if i >= n:
        return 0
    end
    let instr = get(code, i)
    let op = instr.0
    let g = nc_group(code, i, n, fn, funcs, meta, metas)
    if op == 16 or op == 17 or op == 18 or op == 19:
        let target = instr.1
        if target >= n or target == i:
            return nc_fail(415, 0, int_to_str(target))
        end
        -- Only an unconditional branch may go backward: a loop's branch back
        -- to its condition.
        if target < i and op != 16:
            return nc_fail(415, 0, int_to_str(target))
        end
        if get(layout.2, target) == 0:
            return nc_fail(415, 0, int_to_str(target))
        end
        let base = layout.0 + get(layout.1, i) + nc_branch_end_delta(op)
        let dest = layout.0 + get(layout.1, target)
        if target > i and dest <= base:
            return nc_fail(415, 0, int_to_str(target))
        end
        if target < i and dest >= base:
            return nc_fail(415, 0, int_to_str(target))
        end
        if not nc_rel_ok(dest, base):
            return nc_fail(427, 0, "")
        end
    end
    if op == 20:
        let callee_layout = get(layouts, instr.1)
        let target_entry = callee_layout.0
        let base = 0
        let cm = get(meta.call_meta, i)
        if cm.2 == 2 or cm.2 == 3:
            base = layout.0 + get(layout.1, i) + g.0
        elif cm.2 == 1:
            base = layout.0 + get(layout.1, i) + nc_disp_len_rbp(1, nc_sret_scratch_mag(meta.scratch_base, cm.1, 0)) + 5
        else:
            base = layout.0 + get(layout.1, i) + 5
        end
        if not nc_rel_ok(target_entry, base):
            return nc_fail(427, 0, "")
        end
    end
    return nc_branch_and_rel_verify_loop(code, g.1, n, fn, funcs, meta, metas, layout, layouts)
end

func nc_verify_layout_rels_loop(funcs, metas, layouts, i, n):
    if i >= n:
        return 0
    end
    let fn = get(funcs, i)
    let meta = get(metas, i)
    let layout = get(layouts, i)
    let r = nc_branch_and_rel_verify_loop(fn.4, 0, count(fn.4), fn, funcs, meta, metas, layout, layouts)
    if r != 0:
        return r
    end
    return nc_verify_layout_rels_loop(funcs, metas, layouts, i + 1, n)
end

func nc_entry_stub_len(has_clogger, has_heap, has_faultable, main_ret, rplan):
    return nc_entry_layout(has_heap, has_faultable, main_ret, rplan).6
end

func nc_pass1_program_loop(funcs, metas, i, n, entry, layouts):
    if i >= n:
        return (0, layouts, entry)
    end
    let fn = get(funcs, i)
    let meta = get(metas, i)
    let frame_sz = nc_frame_total(meta)
    let prefix_len = nc_prologue_len(frame_sz) + nc_sret_save_len(meta) + nc_arg_copy_len_loop(0, meta.pwords, 0)
    let lay = nc_pass1_layout(fn, funcs, meta, metas, prefix_len)
    let fn_len = lay.2
    do add(layouts, (entry, lay.0, lay.1, frame_sz, prefix_len, fn_len))
    return nc_pass1_program_loop(funcs, metas, i + 1, n, entry + fn_len, layouts)
end

func nc_pass1_program(prog, metas, has_clogger, has_heap, has_faultable, rplan):
    let funcs = prog.0
    let layouts = new_array((int, array(int), array(int), int, int, int))
    let main_ret = get(metas, prog.2).ret
    let entry_layout = nc_entry_layout(has_heap, has_faultable, main_ret, rplan)
    let stub_len = nc_entry_stub_len(has_clogger, has_heap, has_faultable, main_ret, rplan)
    let r = nc_pass1_program_loop(funcs, metas, 0, count(funcs), stub_len, layouts)
    if r.0 != 0:
        return r
    end
    let main_layout = get(r.1, prog.2)
    let call_main_base = entry_layout.0 + 5
    if not nc_rel_ok(main_layout.0, call_main_base):
        return (nc_fail(427, 0, ""), r.1, r.2)
    end
    let call_render_base = entry_layout.0 + 10
    if not nc_rel_ok(entry_layout.5, call_render_base):
        return (nc_fail(427, 0, ""), r.1, r.2)
    end
    let vr = nc_verify_layout_rels_loop(funcs, metas, r.1, 0, count(funcs))
    if vr != 0:
        return (vr, r.1, r.2)
    end
    return r
end

func nc_emit_ehdr(buf):
    do append(buf, 127)
    do append(buf, 69)
    do append(buf, 76)
    do append(buf, 70)
    do append(buf, 2)
    do append(buf, 1)
