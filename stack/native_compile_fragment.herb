-- link12: emit the render-plan body (the inline render in the entry stub). Walks the
-- SAME flat token list the length pass sums, so the two cannot drift.
func nc_emit_rplan(buf, rplan, i, n, stage, int_off, bool_off, str_off, write_off):
    if i >= n:
        return buf
    end
    let tok = get(rplan, i)
    if tok.0 == 0:
        buf = nc_emit_render_putc(buf, tok.1, stage, write_off)
    end
    if tok.0 == 1:
        buf = nc_emit_render_putsep(buf, stage, write_off)
    end
    if tok.0 == 2:
        buf = nc_emit_render_word_elem(buf, tok.1, int_off)
    end
    if tok.0 == 3:
        buf = nc_emit_render_word_elem(buf, tok.1, bool_off)
    end
    if tok.0 == 4:
        buf = nc_emit_render_str_elem(buf, tok.1, str_off)
    end
    return nc_emit_rplan(buf, rplan, i + 1, n, stage, int_off, bool_off, str_off, write_off)
end

func nc_emit_fault_exit1(buf):
    do append(buf, 184)
    do append(buf, 231)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 191)
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 15)
    do append(buf, 5)
    return buf
end

func nc_emit_fault_helpers(buf, ro_base, helper_start):
    let write_off = helper_start + nc_fault_write_fd2_rel()
    let dec_off = helper_start + nc_fault_dec_fd2_rel()
    let exit_off = helper_start + nc_fault_exit1_rel()
    buf = nc_emit_diag_index(buf, ro_base, write_off, dec_off, exit_off)
    buf = nc_emit_diag_get(buf, ro_base, write_off, dec_off, exit_off)
    buf = nc_emit_diag_append(buf, ro_base, write_off, dec_off, exit_off)
    buf = nc_emit_write_fd2(buf)
    buf = nc_emit_dec_fd2(buf, write_off)
    return nc_emit_fault_exit1(buf)
end

func nc_emit_rdi_store_rax(buf, mag):
    do append(buf, 72)
    do append(buf, 137)
    if mag == 0:
        do append(buf, 7)
        return buf
    end
    if mag <= 127:
        do append(buf, 71)
        do append(buf, mag)
        return buf
    end
    do append(buf, 135)
    return nc_append_le32(buf, mag)
end

func nc_emit_arg_copies_loop(buf, k, nwords):
    if k >= nwords:
        return buf
    end
    let src_mag = 16 + nc_mul8(nwords - 1 - k)
    let dst_mag = nc_local_mag(k)
    buf = nc_emit_disp_rbp_load_rax(buf, 0, src_mag)
    buf = nc_emit_disp_rbp_store_rax(buf, 1, dst_mag)
    return nc_emit_arg_copies_loop(buf, k + 1, nwords)
end

func nc_emit_sret_save(buf, meta):
    if meta.sret_word == 0 - 1:
        return buf
    end
    return nc_emit_disp_rbp_store_rdi(buf, 1, nc_local_mag(meta.sret_word))
end

func nc_emit_push_int(buf, n):
    do append(buf, 72)
    do append(buf, 184)
    buf = nc_append_le64(buf, n)
    do append(buf, 80)
    return buf
end

func nc_emit_push_bool(buf, n):
    do append(buf, 106)
    do append(buf, n)
    return buf
end

func nc_string_offset_loop(strings, i, target, acc):
    if i >= target:
        return acc
    end
    return nc_string_offset_loop(strings, i + 1, target, acc + length(get(strings, i)))
end

func nc_string_offset(strings, idx):
    return nc_string_offset_loop(strings, 0, idx, 0)
end

func nc_rodata_len_loop(strings, i, n, acc):
    if i >= n:
        return acc
    end
    return nc_rodata_len_loop(strings, i + 1, n, acc + length(get(strings, i)))
end

func nc_rodata_len(strings):
    return nc_rodata_len_loop(strings, 0, count(strings), 0)
end

func nc_emit_push_str(buf, strings, idx, instr_off, code_len):
    let s = get(strings, idx)
    let lit_off = code_len + nc_string_offset(strings, idx)
    do append(buf, 72)
    do append(buf, 141)
    do append(buf, 53)
    buf = nc_append_rel32(buf, lit_off, instr_off + 7)
    do append(buf, 86)
    do append(buf, 72)
    do append(buf, 199)
    do append(buf, 192)
    buf = nc_append_le32(buf, length(s))
    do append(buf, 80)
    return buf
end

func nc_emit_load_local_loop(buf, base, j, width):
    if j >= width:
        return buf
    end
    buf = nc_emit_disp_rbp_load_rax(buf, 1, nc_local_mag(base + j))
    do append(buf, 80)
    return nc_emit_load_local_loop(buf, base, j + 1, width)
end

func nc_emit_load_local(buf, base, width):
    return nc_emit_load_local_loop(buf, base, 0, width)
end

func nc_emit_store_local_loop(buf, base, j):
    if j == 0 - 1:
        return buf
    end
    do append(buf, 88)
    buf = nc_emit_disp_rbp_store_rax(buf, 1, nc_local_mag(base + j))
    return nc_emit_store_local_loop(buf, base, j - 1)
end

func nc_emit_store_local(buf, base, width):
    return nc_emit_store_local_loop(buf, base, width - 1)
end

func nc_emit_add(buf):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 1)
    do append(buf, 200)
    do append(buf, 80)
    return buf
end

func nc_emit_sub(buf):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 41)
    do append(buf, 200)
    do append(buf, 80)
    return buf
end

func nc_emit_cmp_setcc(buf, setcc_byte):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 57)
    do append(buf, 200)
    do append(buf, 15)
    do append(buf, setcc_byte)
    do append(buf, 194)
    do append(buf, 72)
    do append(buf, 15)
    do append(buf, 182)
    do append(buf, 194)
    do append(buf, 80)
    return buf
end

func nc_emit_not(buf):
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 133)
    do append(buf, 192)
    do append(buf, 15)
    do append(buf, 148)
    do append(buf, 192)
    do append(buf, 72)
    do append(buf, 15)
    do append(buf, 182)
    do append(buf, 192)
    do append(buf, 80)
    return buf
end

-- Bitwise / shift emitters. The stack convention pops the right operand into
-- rcx (0x59) and the left into rax (0x58), computes lhs OP rhs into rax, then
-- pushes rax (0x50). Each is 6 bytes (matching the add/sub layout arm); bnot is
-- 5. For shifts the count is already in rcx (so cl), and `shl/shr rax,cl` reads
-- the count from cl, which x86 masks to 6 bits for 64-bit operands -- exactly
-- the `& 63` the C oracle and the meta-circular VM use.
func nc_emit_band(buf):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 33)
    do append(buf, 200)
    do append(buf, 80)
    return buf
end

func nc_emit_bor(buf):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 9)
    do append(buf, 200)
    do append(buf, 80)
    return buf
end

func nc_emit_bxor(buf):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 49)
    do append(buf, 200)
    do append(buf, 80)
    return buf
end

func nc_emit_shl(buf):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 211)
    do append(buf, 224)
    do append(buf, 80)
    return buf
end

func nc_emit_shr(buf):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 211)
    do append(buf, 232)
    do append(buf, 80)
    return buf
end

func nc_emit_bnot(buf):
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 247)
    do append(buf, 208)
    do append(buf, 80)
    return buf
end

-- Multiply: pop rhs->rcx (0x59), pop lhs->rax (0x58), imul rax,rcx
-- (48 0F AF C1), push rax (0x50). imul keeps the low 64 bits, which is the
-- u64 modular-wrap product (identical for signed/unsigned). 7 bytes; must equal
-- nc_group_single_len(42).
func nc_emit_mul(buf):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 15)
    do append(buf, 175)
    do append(buf, 193)
    do append(buf, 80)
    return buf
end

-- Divide / modulo. pop rhs(divisor)->rcx (0x59), pop lhs(dividend)->rax (0x58).
-- Guard divide-by-zero BEFORE `div`: test rcx,rcx (48 85 C9); jz exit1
-- (0F 84 rel32) routes to the shared clean fault-exit (exit 1, empty stdout) --
-- exit-status parity with the C oracle's `herbert: line N: division by zero`.
-- (Exact-stderr text is deferred per the D13 fault-parity convention; the C
-- side keeps the located message, the native side matches exit status + empty
-- stdout. Reusing the located-diagnostic helper would be a much larger addition
-- -- a new ro-data fragment + diag handler -- so exit-status parity is used.)
-- Then xor rdx,rdx (48 31 D2) zero-extends the dividend, div rcx (48 F7 F1)
-- gives the unsigned 64-bit quotient in rax / remainder in rdx; push rax (0x50)
-- for `/`, push rdx (0x52) for `%`. 18 bytes; must equal
-- nc_group_single_len(43/44). The jz rel32 base is instr_off + 11 (the byte
-- after the rel32 field: 1+1+3 prefix + 2 jz opcode + 4 rel32).
func nc_emit_div_or_mod(buf, is_mod, exit_off, instr_off):
    do append(buf, 89)
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 133)
    do append(buf, 201)
    do append(buf, 15)
    do append(buf, 132)
    buf = nc_append_rel32(buf, exit_off, instr_off + 11)
    do append(buf, 72)
    do append(buf, 49)
    do append(buf, 210)
    do append(buf, 72)
    do append(buf, 247)
    do append(buf, 241)
    if is_mod != 0:
        do append(buf, 82)
    else:
        do append(buf, 80)
    end
    return buf
end

func nc_emit_length(buf):
    do append(buf, 88)
    do append(buf, 94)
    do append(buf, 80)
    return buf
end

func nc_emit_index(buf, line, diag_index_off, instr_off):
    do append(buf, 89)
    do append(buf, 90)
    do append(buf, 94)
    do append(buf, 72)
    do append(buf, 57)
    do append(buf, 209)
    do append(buf, 114)
    do append(buf, nc_fault_route_len())
