        do append(buf, 202)
        do append(buf, 80)
        return buf
    end
    do append(buf, 72)
    do append(buf, 105)
    do append(buf, 241)
    buf = nc_append_le32(buf, nc_mul8(width))
    do append(buf, 113)
    do append(buf, 12)
    buf = nc_emit_heap_trap(buf)
    do append(buf, 76)
    do append(buf, 1)
    do append(buf, 214)
    return nc_emit_get_loads(buf, width, 0)
end

func nc_emit_arr_add_stores(buf, k):
    if k == 0 - 1:
        return buf
    end
    do append(buf, 88)
    buf = nc_emit_rsi_store_rax(buf, nc_mul8(k))
    return nc_emit_arr_add_stores(buf, k - 1)
end

func nc_emit_arr_add(buf, width):
    return nc_emit_arr_add_any(buf, width, 0)
end

-- ADD_KEEP (op 63) builds a ref record: add, leaving the array on the stack.
func nc_emit_arr_add_keep(buf, width):
    return nc_emit_arr_add_any(buf, width, 1)
end

