func nc_emit_stdin_read(buf):
    -- Checked hosted input. Preserve r12/r13/r15/rbp and all prior heap data.
    -- Return one (int, string); a failed read never exposes a partial prefix.
    -- 0: mov r8,r14; xor r9d,r9d. Original bump and uncommitted length.
    do append(buf, 77)
    do append(buf, 137)
    do append(buf, 240)
    do append(buf, 69)
    do append(buf, 49)
    do append(buf, 201)
    -- loop (6): remaining = r15-r8-r9; jz probe (45). Never read count zero.
    do append(buf, 76)
    do append(buf, 137)
    do append(buf, 250)
    do append(buf, 76)
    do append(buf, 41)
    do append(buf, 194)
    do append(buf, 76)
    do append(buf, 41)
    do append(buf, 202)
    do append(buf, 116)
    do append(buf, 28)
    -- read(0, r8+r9, remaining). r8/r9 survive the syscall.
    do append(buf, 49)
    do append(buf, 192)
    do append(buf, 49)
    do append(buf, 255)
    do append(buf, 75)
    do append(buf, 141)
    do append(buf, 52)
    do append(buf, 8)
    do append(buf, 15)
    do append(buf, 5)
    -- Retry EINTR at loop (6); other errors -> errno (87); EOF -> success (95).
    do append(buf, 72)
    do append(buf, 131)
    do append(buf, 248)
    do append(buf, 252)
    do append(buf, 116)
    do append(buf, 229)
    do append(buf, 72)
    do append(buf, 133)
    do append(buf, 192)
    do append(buf, 120)
    do append(buf, 49)
    do append(buf, 116)
    do append(buf, 55)
    -- Accumulate positive short transfer; loop (6).
    do append(buf, 73)
    do append(buf, 1)
    do append(buf, 193)
    do append(buf, 235)
    do append(buf, 217)
    -- probe (45): reserve ONE scratch word; retry (49) does not reserve again.
    do append(buf, 72)
    do append(buf, 131)
    do append(buf, 236)
    do append(buf, 8)
    -- read(0, rsp, 1); retry EINTR at (49).
    do append(buf, 49)
    do append(buf, 192)
    do append(buf, 49)
    do append(buf, 255)
    do append(buf, 72)
    do append(buf, 137)
    do append(buf, 230)
    do append(buf, 186)
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 15)
    do append(buf, 5)
    do append(buf, 72)
    do append(buf, 131)
    do append(buf, 248)
    do append(buf, 252)
    do append(buf, 116)
    do append(buf, 236)
    -- Restore probe scratch before every terminal path; errno (87), EOF (95).
    do append(buf, 72)
    do append(buf, 131)
    do append(buf, 196)
    do append(buf, 8)
    do append(buf, 72)
    do append(buf, 133)
    do append(buf, 192)
    do append(buf, 120)
    do append(buf, 9)
    do append(buf, 116)
    do append(buf, 15)
    -- Extra byte means overflow: positive synthetic ENOMEM; failure (90).
    do append(buf, 184)
    do append(buf, 12)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 235)
    do append(buf, 3)
    -- errno (87): positive errno; failure (90): discard prefix, preserve r14.
    do append(buf, 72)
    do append(buf, 247)
    do append(buf, 216)
    do append(buf, 69)
    do append(buf, 49)
    do append(buf, 201)
    do append(buf, 235)
    do append(buf, 6)
    -- success (95): commit complete input and status zero.
    do append(buf, 79)
    do append(buf, 141)
    do append(buf, 52)
    do append(buf, 8)
    do append(buf, 49)
    do append(buf, 192)
    -- result (101): status / original pointer / length. Total 106 bytes.
    do append(buf, 80)
    do append(buf, 65)
    do append(buf, 80)
    do append(buf, 65)
    do append(buf, 81)
    return buf
end

-- The operand stack contains nr,a1,a2,a3,a4,a5,a6 in that order. Linux takes
-- rax,rdi,rsi,rdx,r10,r8,r9 and destroys rcx/r11 (both caller scratch here).
-- No libc, errno conversion, allocation, EINTR retry, or descriptor policy is
-- hidden in this primitive. Higher-level Herbert code owns those decisions.
func nc_emit_linux_syscall6(buf):
    do append(buf, 65)
    do append(buf, 89)
    do append(buf, 65)
    do append(buf, 88)
    do append(buf, 65)
    do append(buf, 90)
    do append(buf, 90)
    do append(buf, 94)
    do append(buf, 95)
    do append(buf, 88)
    do append(buf, 15)
    do append(buf, 5)
    do append(buf, 80)
    return buf
end

func nc_emit_buffer_address(buf):
    -- pop rax; mov rax,[rax+16]; push rax. The header stays private.
    do append(buf, 88)
    do append(buf, 72)
    do append(buf, 139)
    do append(buf, 64)
    do append(buf, 16)
    do append(buf, 80)
    return buf
end

func nc_emit_buffer_get(buf, line, diag_get_off, instr_off):
    -- rcx=index, r8=header, r9=length. Reuse the located get-bounds route.
    do append(buf, 89)
    do append(buf, 65)
    do append(buf, 88)
    do append(buf, 77)
    do append(buf, 139)
    do append(buf, 8)
    do append(buf, 76)
    do append(buf, 57)
    do append(buf, 201)
    do append(buf, 114)
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 23)
    do append(buf, 77)
    do append(buf, 139)
    do append(buf, 80)
    do append(buf, 16)
    -- movzx eax,byte [r10+rcx]; push rax.
    do append(buf, 65)
    do append(buf, 15)
    do append(buf, 182)
    do append(buf, 4)
    do append(buf, 10)
    do append(buf, 80)
    return buf
end

func nc_emit_buffer_set(buf, line, diag_get_off, diag_append_off, instr_off):
    -- Validate the value before the index, consistently with append's byte
    -- contract. Failure is located and cannot write outside the initialized span.
    do append(buf, 89)
    do append(buf, 72)
    do append(buf, 129)
    do append(buf, 249)
    do append(buf, 255)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 118)
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_append_off, instr_off + 22)
    -- Save the validated byte in edx; then load index, header and length.
    do append(buf, 137)
    do append(buf, 202)
    do append(buf, 89)
    do append(buf, 65)
    do append(buf, 88)
    do append(buf, 77)
    do append(buf, 139)
    do append(buf, 8)
    do append(buf, 76)
    do append(buf, 57)
    do append(buf, 201)
    do append(buf, 114)
    do append(buf, nc_fault_route_len())
    buf = nc_emit_fault_route(buf, line, diag_get_off, instr_off + 47)
    do append(buf, 77)
    do append(buf, 139)
    do append(buf, 80)
    do append(buf, 16)
    -- mov byte [r10+rcx],dl; push rdx (the written byte).
    do append(buf, 65)
    do append(buf, 136)
    do append(buf, 20)
    do append(buf, 10)
    do append(buf, 82)
    return buf
end

func nc_emit_process_exit(buf):
    -- 10 bytes: pop rdi; mov eax,231; syscall; ud2. Linux exit_group
    -- supplies the low eight status bits to the parent. Never fall through
    -- to main's renderer, even if the syscall unexpectedly returns.
    do append(buf, 95)
    do append(buf, 184)
    do append(buf, 231)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 15)
    do append(buf, 5)
    do append(buf, 15)
    do append(buf, 11)
    return buf
end

func nc_emit_stderr_write(buf):
    -- 55 bytes. Pop len/ptr into rdx/rsi; push one int result. No heap,
    -- frame, or callee-saved register changes. Empty input succeeds without
    -- a syscall. Retry EINTR; advance after real partial writes. Other raw
    -- negative syscall results become positive errno; zero progress is EIO.
    -- SIGPIPE remains inherited: a broken pipe may terminate the process.
    do append(buf, 90)
    do append(buf, 94)
    -- loop (2): test rdx,rdx; jz success (52)
    do append(buf, 72)
    do append(buf, 133)
    do append(buf, 210)
    do append(buf, 116)
    do append(buf, 45)
    -- mov eax,1; mov edi,2; syscall
    do append(buf, 184)
    do append(buf, 1)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 191)
    do append(buf, 2)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 15)
    do append(buf, 5)
    -- cmp rax,-4; je loop (2)
    do append(buf, 72)
    do append(buf, 131)
    do append(buf, 248)
    do append(buf, 252)
    do append(buf, 116)
    do append(buf, 233)
    -- test rax,rax; js errno (40); jz zero (45)
    do append(buf, 72)
    do append(buf, 133)
    do append(buf, 192)
    do append(buf, 120)
    do append(buf, 10)
    do append(buf, 116)
    do append(buf, 13)
    -- add rsi,rax; sub rdx,rax; jmp loop (2)
    do append(buf, 72)
    do append(buf, 1)
    do append(buf, 198)
    do append(buf, 72)
    do append(buf, 41)
    do append(buf, 194)
    do append(buf, 235)
    do append(buf, 218)
    -- errno (40): neg rax; jmp done (54)
    do append(buf, 72)
    do append(buf, 247)
    do append(buf, 216)
    do append(buf, 235)
    do append(buf, 9)
    -- zero (45): mov eax,5; jmp done (54)
    do append(buf, 184)
    do append(buf, 5)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 0)
    do append(buf, 235)
    do append(buf, 2)
    -- success (52): xor eax,eax; done (54): push rax
    do append(buf, 49)
    do append(buf, 192)
    do append(buf, 80)
    return buf
end

func nc_emit_fwriter(buf):
    -- Atomic Linux publication of a.out. The instruction-level reference is
    -- bootstrap/tests/fixtures/fwriter_linux_x86_64.s (test-only assembly).
    -- Open the directory, create an unpredictable exclusive temporary, write
    -- all bytes, fsync, check close without retry, then renameat. Errors before
    -- rename preserve a.out and clean our temporary; successful concurrent
    -- writers publish complete last-writer-wins images. Replaces symlinks,
    -- never follows their targets. No directory crash-durability guarantee.
    -- Preserve rbx/r12..r15 and the caller stack. getrandom fails closed.
    do append(buf, 65)
    do append(buf, 88)
    do append(buf, 65)
    do append(buf, 89)
    do append(buf, 83)
    do append(buf, 65)
    do append(buf, 84)
    do append(buf, 65)
    do append(buf, 85)
    do append(buf, 65)
    do append(buf, 86)
    do append(buf, 65)
    do append(buf, 87)
    do append(buf, 72)
    do append(buf, 131)
    do append(buf, 236)
    do append(buf, 96)
    do append(buf, 77)
    do append(buf, 137)
    do append(buf, 206)
    do append(buf, 77)
    do append(buf, 137)
    do append(buf, 199)
    do append(buf, 73)
    do append(buf, 199)
    do append(buf, 196)
    do append(buf, 255)
