func f_Z9(a, b):
	let s = "q\"r\\s\nt"
    let c = '\''
    let d = 'x'
    let e = ((a << 3) >> 1) + (b * 2 - a / 4 % 5)
    let g = ((a & 6) | (b ^ 7))
    let h = ~a
    if a <= b and a >= b or a != b and not (a == b) and a < 10 and b > 2: -- a comment
        return (e, g.0)
    end
    return 0
end

