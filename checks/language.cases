case statement-call-in-branches
source 426
func note(a, v):
    do add(a, v)
    return count(a)
end

func pick(a, n):
    if n == 0:
        do note(a, 10)
    elif n == 1:
        do note(a, 11)
        if count(a) > 1:
            do note(a, 12)
        end
    else:
        do note(a, 13)
    end
    return count(a)
end

func main():
    let a = new_array(int)
    do pick(a, 0)
    do pick(a, 1)
    do pick(a, 2)
    return (count(a), get(a, 0), get(a, 3))
end

