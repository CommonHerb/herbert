func fill_int(a, i, n):
    if i >= n:
        return 0
    end
    do add(a, i)
    return fill_int(a, i + 1, n)
end
func sum_int(a, i, acc):
    if i >= count(a):
        return acc
    end
    return sum_int(a, i + 1, acc + get(a, i))
end
func fill_pair(a, i, n):
    if i >= n:
        return 0
    end
    do add(a, (i, i + 1))
    return fill_pair(a, i + 1, n)
end
func sum_pair(a, i, acc):
    if i >= count(a):
        return acc
    end
    let p = get(a, i)
    return sum_pair(a, i + 1, acc + p.0 + p.1)
end
func fill_tri(a, i, n):
    if i >= n:
        return 0
    end
    do add(a, (i, i + 1, i + 2))
    return fill_tri(a, i + 1, n)
end
