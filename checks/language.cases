case set-ten-million-heap-flat
source 593
func heap_mark():
    return buffer_address(new_buffer())
end

func main():
    let ints = new_array(int)
    let pairs = new_array((int, string))
    let k = 0
    while k < 1000:
        do add(ints, 0)
        do add(pairs, (0, ""))
        k = k + 1
    end
    let m0 = heap_mark()
    let m1 = heap_mark()
    let i = 0
    while i < 10000000:
        do set(ints, i % 1000, i)
        do set(pairs, i % 1000, (i, "s"))
        i = i + 1
    end
    let m2 = heap_mark()
    return ((m2 - m1) - (m1 - m0), get(ints, 999), get(pairs, 0).0, get(pairs, 0).1, count(ints), count(pairs))
end

