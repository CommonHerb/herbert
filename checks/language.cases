case flow-short-circuit-or-and-stack-join
source 765
func mark(value, label):
    do flogger(label)
    return value
end
func probe(a, b, c):
    let result = ("base", 40, mark(a, "a") or (mark(b, "b") and mark(c, "c")), "tail")
    do flogger("|")
    if result.2:
        return length(result.0) + result.1 + length(result.3) + 1
    end
    return length(result.0) + result.1 + length(result.3)
end
func trap():
    return 1 / 0 == 0
end
func guarded(a, b):
    let result = ("guard", a or (b and trap()))
    return result.1
end
func main():
    return (probe(false, false, false), probe(false, false, true), probe(false, true, false), probe(false, true, true), probe(true, false, false), probe(true, false, true), probe(true, true, false), probe(true, true, true), guarded(true, true), guarded(false, false))
end

stdout 68
ab|ab|abc|abc|a|a|a|a|(48, 48, 48, 49, 49, 49, 49, 49, true, false)

end
