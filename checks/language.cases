record Pt:
    x: int
    y: int
end

ref record Box:
    a: int
    b: int
end

func main():
    let p = Pt(10, 20)
    let b = Box(1, 2)
    b.a = 5
    return p.x + p.y + b.a + pad()
end

stdout 3
56

end
case ref-record-field-read-of-call-result
source 138
ref record P:
    x: int
    y: int
end

func make(a):
    return P(a, a + 1)
end

func main():
    return make(3).y * 10 + make(5).x
end

stdout 3
45

end
case ref-record-field-read-tuple-chain
source 190
ref record Mixed:
    s: string
    pair: (int, int)
    z: int
end

func main():
    let r = Mixed("ab", (5, 6), 7)
    return r.pair.1 * 1000 + r.pair.0 * 100 + r.z * 10 + length(r.s)
end

stdout 5
6572

end
case ref-record-field-reads-in-tail-loop
source 295
ref record Acc:
    total: int
    step: int
    left: int
end

func run(a):
    if a.left == 0:
        return a.total
    end
    a.total = a.total + a.step
    a.step = a.step + 1
    a.left = a.left - 1
    return run(a)
end

func main():
    let a = Acc(0, 1, 100000)
    return run(a)
end

stdout 11
5000050000

end
case ref-record-field-read-tuple-from-main
source 165
ref record Box:
    label: string
    pair: (int, int)
    flag: bool
end

func main():
    let b = Box("x", (5, 6), true)
    b.pair = (7, 8)
    return b.pair
