func touch(a, i, n):
    if i == n:
        return 0
    end
    let c = get(a, i)
    c.hits = c.hits + c.v
    return touch(a, i + 1, n)
end

func main():
    let a = new_array(Cell)
    do add(a, Cell(1, 0))
    do add(a, Cell(2, 0))
    do add(a, Cell(3, 0))
    let t1 = touch(a, 0, 3)
    let t2 = touch(a, 0, 3)
    return get(a, 0).hits * 100 + get(a, 1).hits * 10 + get(a, 2).hits
end

