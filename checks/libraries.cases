case file: a save is refused with 116 when another file of the same size and times was moved into the document's place
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- The file at path given the access and modification time 1000 seconds (Linux's utimensat, 280,
-- from the current folder, -100).
func date(path, times):
    return linux_syscall6(280, 0 - 100, buffer_address(linux_cstring(path)), buffer_address(times), 0, 0, 0)
end

-- same.d/NAME-ROUND.txt
func name(what, round):
    let out = new_buffer()
    do text_add(out, "same.d/")
    do text_add(out, what)
    do text_add_whole(out, round)
    do text_add(out, ".txt")
    return freeze(out)
end

func main():
    -- A folder of its own (Linux's mkdir is 83).
    do linux_syscall6(83, buffer_address(linux_cstring("same.d")), 448, 0, 0, 0, 0)
    let times = linux_buffer(32)
    do linux_put64(times, 0, 1000)
    do linux_put64(times, 16, 1000)
    let f = file_new(64)
    let moved = 0
    let swapped = 0
    let whole = 0
    -- Forty times over: a document and another file, five bytes each and dated alike, made within
    -- the same moment; the document is opened; then the other file takes its name. In the even
    -- rounds it is moved over the document (Linux's rename, 82); in the odd rounds the two change
    -- places (renameat2, 316, with its exchange flag, 2), or, where a disk cannot do that, it is
    -- moved as before. Often nothing at all then tells the two apart but which file it is.
    let round = 0
    while round < 40:
        let doc = name("doc-", round)
        let other = name("other-", round)
        do write_file(doc, "old.\n")
        do write_file(other, "new.\n")
        do date(doc, times)
        do date(other, times)
        do file_load(f, linux_cstring(doc), length(doc))
        let exchanged = 1
        if round % 2 == 1: exchanged = linux_syscall6(316, 0 - 100, buffer_address(linux_cstring(other)), 0 - 100, buffer_address(linux_cstring(doc)), 2, 0) end
        if exchanged != 0: do linux_syscall6(82, buffer_address(linux_cstring(other)), buffer_address(linux_cstring(doc)), 0, 0, 0, 0) end
        if file_save(f, linux_cstring("mine\n"), 5) == 0 - 116:
            if round % 2 == 1: swapped = swapped + 1 else: moved = moved + 1 end
        end
        if holds(doc, "new.\n"): whole = whole + 1 end
        round = round + 1
    end
    let out = new_buffer()
    do text_add_whole(out, moved)
    do text_add(out, " of 20 saves refused with 116 after another file was moved over the document\n")
    do text_add_whole(out, swapped)
    do text_add(out, " of 20 saves refused with 116 after the document and another file changed places\n")
    do text_add_whole(out, whole)
    do text_add(out, " of 40 files as the other program left them\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
20 of 20 saves refused with 116 after another file was moved over the document
20 of 20 saves refused with 116 after the document and another file changed places
40 of 40 files as the other program left them
----
end
case file: of folders with one and the same time, file_scan names the first one listed; with the same second, the later nanosecond
libs linux text file_io
source until ----
-- Linux's mkdir, 83.
func make_folder(path):
    return linux_syscall6(83, buffer_address(linux_cstring(path)), 448, 0, 0, 0, 0)
end

-- The folder at path given the modification time seconds and nanoseconds (Linux's utimensat, 280,
-- from the current folder, -100; its two times are access and modification).
func set_time(path, seconds, nanoseconds):
    let times = linux_buffer(32)
    do linux_put64(times, 0, seconds)
    do linux_put64(times, 8, nanoseconds)
    do linux_put64(times, 16, seconds)
    do linux_put64(times, 24, nanoseconds)
    return linux_syscall6(280, 0 - 100, buffer_address(linux_cstring(path)), buffer_address(times), 0, 0, 0)
end

-- The first name beginning with prefix in the folder at path, in the order Linux lists it
-- (getdents64, 217; in each record the length is at 16 and the name from 19).
func first_listed(path, prefix):
    let fd = linux_open(linux_cstring(path), 65536, 0)
    let dents = linux_buffer(4096)
    let got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    while not linux_error(got) and got != 0:
        let p = 0
        while p < got:
            let name = p + 19
            let stop = linux_nul_end(dents, name, p + linux_u16(dents, p + 16))
            if text_starts(dents, name, stop, prefix):
                do linux_close(fd)
                return text_string(dents, name, stop)
            end
            p = p + linux_u16(dents, p + 16)
        end
        got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    end
    do linux_close(fd)
    return ""
end

func scan_name(s):
    let name = file_scan_name(s)
    return text_string(name, 0, linux_nul_end(name, 0, buffer_length(name)))
end

func main():
    do make_folder("tie.d")
    -- Five folders with the very same time.
    do make_folder("tie.d/same-a")
    do make_folder("tie.d/same-b")
    do make_folder("tie.d/same-c")
    do make_folder("tie.d/same-d")
    do make_folder("tie.d/same-e")
    do set_time("tie.d/same-a", 5000, 0)
    do set_time("tie.d/same-b", 5000, 0)
    do set_time("tie.d/same-c", 5000, 0)
    do set_time("tie.d/same-d", 5000, 0)
    do set_time("tie.d/same-e", 5000, 0)
    -- Two pairs with the same second and 100 nanoseconds between them, made in either order.
    do make_folder("tie.d/ns1-early")
    do make_folder("tie.d/ns1-late")
    do make_folder("tie.d/ns2-late")
    do make_folder("tie.d/ns2-early")
    do set_time("tie.d/ns1-early", 6000, 100)
    do set_time("tie.d/ns1-late", 6000, 200)
    do set_time("tie.d/ns2-early", 6000, 100)
    do set_time("tie.d/ns2-late", 6000, 200)
    let f = file_open("tie.d/doc.txt", 64)
    let s = file_scan_new()
    let out = new_buffer()
    do text_add_whole(out, file_scan(f, s, "same-"))
    do text_add(out, " folders with one time: ")
    if equal(scan_name(s), first_listed("tie.d", "same-")): do text_add(out, "the first one listed is named\n") else: do text_add(out, "NOT the first one listed is named\n") end
    do text_add_whole(out, file_scan(f, s, "ns1-"))
    do text_add(out, " folders: ")
    do text_add(out, scan_name(s))
    do text_add(out, "\n")
    do text_add_whole(out, file_scan(f, s, "ns2-"))
    do text_add(out, " folders: ")
    do text_add(out, scan_name(s))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
5 folders with one time: the first one listed is named
2 folders: ns1-late
2 folders: ns2-late
----
end
case recovery: a checkpoint is a private copy in a private folder beside the document, found again as Notes finds it
libs linux text file_io session_recovery
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- "rec1.d/" and the name that ends at the first NUL of b.
func beside(b):
    let out = new_buffer()
    do text_add(out, "rec1.d/")
    do text_add_span(out, b, 0, linux_nul_end(b, 0, buffer_length(b)))
    return freeze(out)
end

-- The permission bits of the file or folder at path, as three octal digits.
func mode(out, path):
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring(path), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    let bits = linux_u32(stat, 24) % 512
    do text_add_whole(out, bits / 64)
    do text_add_whole(out, (bits / 8) % 8)
    return text_add_whole(out, bits % 8)
end

func main():
    -- A folder of its own (Linux's mkdir is 83) with one document in it.
    do linux_syscall6(83, buffer_address(linux_cstring("rec1.d")), 448, 0, 0, 0, 0)
    do write_file("rec1.d/doc.txt", "on disk\n")
    let f = file_open("rec1.d/doc.txt", 64)
    let r = recovery_new(64)
    let out = new_buffer()
    do text_add(out, "checkpoint: ")
    do text_add_whole(out, recovery_save(r, f, linux_cstring("edited, unsaved\n"), 16))
    let s = file_scan_new()
    do text_add(out, "\nfolders named .herbert-notes-... beside the document: ")
    do text_add_whole(out, file_scan(f, s, ".herbert-notes-"))
    let g = file_new(64)
    do text_add(out, "\nrecovery.txt in it, read back: ")
    do text_add_whole(out, file_load_inside(g, f, file_scan_name(s), "recovery.txt"))
    if text_is(g.bytes, 0, file_count(g), "edited, unsaved\n"): do text_add(out, ", the bytes checkpointed") end
    -- The folder's name as file_scan found it, and the copy's path as file_load_inside left it.
    let folder = beside(file_scan_name(s))
    let copy = beside(g.path)
    do text_add(out, "\nfolder mode ")
    do mode(out, folder)
    do text_add(out, ", copy mode ")
    do mode(out, copy)
    do text_add(out, "\n")
    if holds("rec1.d/doc.txt", "on disk\n"): do text_add(out, "the document is as it was\n") end
    do text_add(out, "and it saves as before: ")
    do text_add_whole(out, file_save(f, linux_cstring("saved\n"), 6))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
checkpoint: 0
folders named .herbert-notes-... beside the document: 1
recovery.txt in it, read back: 0, the bytes checkpointed
folder mode 700, copy mode 600
the document is as it was
and it saves as before: 0
----
end
case recovery: a later checkpoint replaces the copy in the same folder
libs linux text file_io session_recovery
source until ----
-- Whether the one session folder beside f's document holds a recovery.txt of exactly s, found as
-- Notes finds it: the folder by its name, then the file inside it.
func copy_is(f, s):
    let scan = file_scan_new()
    if file_scan(f, scan, ".herbert-notes-") != 1: return false end
    let g = file_new(64)
    if file_load_inside(g, f, file_scan_name(scan), "recovery.txt") != 0: return false end
    return text_is(g.bytes, 0, file_count(g), s)
end

func main():
    -- A folder of its own (Linux's mkdir is 83) and a document not yet on disk.
    do linux_syscall6(83, buffer_address(linux_cstring("rec2.d")), 448, 0, 0, 0, 0)
    let f = file_open("rec2.d/doc.txt", 64)
    let r = recovery_new(64)
    let out = new_buffer()
    do text_add_whole(out, recovery_save(r, f, linux_cstring("one\n"), 4))
    if copy_is(f, "one\n"): do text_add(out, ", the copy is the first text") end
    do text_add(out, "\n")
    do text_add_whole(out, recovery_save(r, f, linux_cstring("one two\n"), 8))
    if copy_is(f, "one two\n"): do text_add(out, ", the copy is the second text") end
    do text_add(out, "\nsession folders: ")
    do text_add_whole(out, file_scan(f, file_scan_new(), ".herbert-notes-"))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
