func show(out, t):
    do text_add(out, "[")
    do text_add_span(out, t.bytes, 0, text_length(t))
    do text_add(out, "] cursor ")
    do text_add_whole(out, text_cursor(t))
    return text_add(out, "\n")
end

func main():
    -- Eight bytes of text and so eight bytes of history; all eight deleted as one selection.
    let t = text_buffer(8)
    do text_load(t, linux_cstring("abcdefgh"), 8)
    let out = new_buffer()
    do text_replace(t, 0, 8, t.scratch, 0, 0)
    do show(out, t)
    do text_undo(t)
    do show(out, t)
    do text_redo(t)
    do text_insert(t, 'x')
    do show(out, t)
    do text_undo(t)
    do show(out, t)
    if text_undo(t) == 0: do text_add(out, "nothing more to undo\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
[] cursor 0
[abcdefgh] cursor 0
[x] cursor 1
[] cursor 0
nothing more to undo
----
end
