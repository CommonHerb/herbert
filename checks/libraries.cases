func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

func main():
    -- Opened with mode 644 (420); then made 600 (384) by another program.
    do write_file("perm.txt", "old\n")
    do set_mode("perm.txt", 420)
    let f = file_open("perm.txt", 64)
    do set_mode("perm.txt", 384)
    let out = new_buffer()
    do text_add(out, "a save alone: ")
    do result(out, file_save(f, linux_cstring("new\n"), 4))
    if holds("perm.txt", "old\n"): do text_add(out, ", the file as it was") end
    do text_add(out, "\nfile_recheck: ")
    do result(out, file_recheck(f))
    do text_add(out, ", and it found mode ")
    do octal(out, f.state.mode)
    do text_add(out, "\na save after it: ")
    do result(out, file_save(f, linux_cstring("new\n"), 4))
    if holds("perm.txt", "new\n"): do text_add(out, ", the file is the new text") end
    do text_add(out, ", its mode ")
    do octal(out, mode_of("perm.txt"))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
a save alone: error 116, the file as it was
file_recheck: 0, and it found mode 600
a save after it: 0, the file is the new text, its mode 600
----
end
case file: a read-only file is read and its bits reported; refusing to save over it is left to the caller
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

func octal(out, bits):
    do text_add_whole(out, bits / 64)
    do text_add_whole(out, (bits / 8) % 8)
    return text_add_whole(out, bits % 8)
end

-- The permission bits of the file at path.
func mode_of(path):
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring(path), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    return linux_u32(stat, 24) % 512
end

func main():
    -- Mode 444 (292): nobody may write it. Linux's chmod is 90.
    do write_file("readonly.txt", "old\n")
    do linux_syscall6(90, buffer_address(linux_cstring("readonly.txt")), 292, 0, 0, 0, 0)
    let f = file_open("readonly.txt", 64)
    let out = new_buffer()
    do text_add(out, "opened: ")
    do text_add_whole(out, file_status(f))
    do text_add(out, ", ")
    do text_add_whole(out, file_count(f))
    do text_add(out, " bytes, mode ")
    do octal(out, f.state.mode)
    do text_add(out, "\nfile_recheck: ")
    do text_add_whole(out, file_recheck(f))
    do text_add(out, ", mode ")
    do octal(out, f.state.mode)
    -- The library itself does not refuse: lib/file_io.herb says that refusing a file whose owner
    -- write bit is off is the caller's (Notes does). A save replaces the file and keeps its bits.
    do text_add(out, "\na save through the library: ")
    do text_add_whole(out, file_save(f, linux_cstring("new\n"), 4))
    if holds("readonly.txt", "new\n"): do text_add(out, ", the file is the new text") end
    do text_add(out, ", its mode ")
    do octal(out, mode_of("readonly.txt"))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
opened: 0, 4 bytes, mode 444
file_recheck: 0, mode 444
a save through the library: 0, the file is the new text, its mode 444
----
end
case file: a rescue copy is a new private file beside the document, never written over, and the document is not touched
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- The name of the handle's latest rescue copy.
func copy_name(f):
    let name = file_copy_name(f)
    return text_string(name, 0, linux_nul_end(name, 0, buffer_length(name)))
end

-- The permission bits of the file at path.
func mode_of(path):
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring(path), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    return linux_u32(stat, 24) % 512
end

func main():
    do write_file("rescued.txt", "original\n")
    let f = file_open("rescued.txt", 64)
    let out = new_buffer()
    do text_add_whole(out, file_save_copy(f, linux_cstring("edited\n"), 7))
    let first = copy_name(f)
    let b = linux_cstring(first)
    if text_starts(b, 0, length(first), "herbert-rescue-") and text_is(b, length(first) - 4, length(first), ".txt"): do text_add(out, ", named herbert-rescue-....txt") end
    if holds(first, "edited\n"): do text_add(out, ", holding the edited text") end
    -- 384 is mode 600: the owner alone reads and writes.
    if mode_of(first) == 384: do text_add(out, ", private") end
    do text_add(out, "\n")
    do text_add_whole(out, file_save_copy(f, linux_cstring("edited more\n"), 12))
    let second = copy_name(f)
    if not equal(first, second): do text_add(out, ", under another name") end
    if holds(second, "edited more\n") and holds(first, "edited\n"): do text_add(out, ", both copies whole") end
    do text_add(out, "\n")
    if holds("rescued.txt", "original\n"): do text_add(out, "the document is as it was\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
