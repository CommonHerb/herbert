case file: an outside change seen only in the file's times is refused: a rewrite of the same size, its time put back, or a time moved by one nanosecond or by whole seconds alone with the bits made 600; bits made read-only alone are taken
libs linux text file_io
source until ----
-- A file at path holding the bytes of s with the permission bits mode, made without the library.
func write_file(path, s, mode):
    let fd = linux_open(linux_cstring(path), 577, mode)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    do linux_close(fd)
    return linux_syscall6(90, buffer_address(linux_cstring(path)), mode, 0, 0, 0, 0)
end

-- The file at path rewritten in place, its inode kept, with the bytes of s.
func rewrite(path, s):
    let fd = linux_open(linux_cstring(path), 513, 0)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- The status of the file at path, as Linux's fstat gives it.
func stat_of(path):
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring(path), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    return stat
end

-- The file at path given its access time from stat and the modification time seconds and
-- nanoseconds (Linux's utimensat, 280, from the current folder, -100).
func date(path, stat, seconds, nanoseconds):
    let times = linux_buffer(32)
    do linux_copy(times, 0, stat, 72, 16)
    do linux_put64(times, 16, seconds)
    do linux_put64(times, 24, nanoseconds)
    return linux_syscall6(280, 0 - 100, buffer_address(linux_cstring(path)), buffer_address(times), 0, 0, 0)
end

-- Linux's chmod, 90.
func chmod(path, mode): return linux_syscall6(90, buffer_address(linux_cstring(path)), mode, 0, 0, 0, 0) end

-- 20 ms (Linux's nanosleep, 35), so that the clock the file's times come from has moved on.
func pause():
    let wait = linux_buffer(16)
    do linux_put64(wait, 8, 20000000)
    return linux_sleep(wait)
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

func octal(out, bits):
    do text_add_whole(out, (bits / 64) % 8)
    do text_add_whole(out, (bits / 8) % 8)
    return text_add_whole(out, bits % 8)
end

-- What file_recheck gives twice and the bits it found, what a save then gives, and whether the
-- file holds s at the end, with its bits.
func after(out, what, f, path, s):
    do text_add(out, what)
    do text_add(out, ": file_recheck ")
    do result(out, file_recheck(f))
    do text_add(out, " and mode ")
    do octal(out, f.state.mode)
    do text_add(out, ", again ")
    do result(out, file_recheck(f))
    do text_add(out, ", a save ")
    do result(out, file_save(f, linux_cstring("mine\n"), 5))
    if holds(path, s): do text_add(out, ", the file holds ") else: do text_add(out, ", the file does NOT hold ") end
    if equal(s, "mine\n"): do text_add(out, "the save") else: do text_add(out, "the outside change") end
    do text_add(out, " at mode ")
    do octal(out, linux_u32(stat_of(path), 24))
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do linux_syscall6(83, buffer_address(linux_cstring("seen6.d")), 448, 0, 0, 0, 0)
    -- Rewritten in place, same size, nothing put back.
    do write_file("seen6.d/a.txt", "original\n", 420)
    let a = file_open("seen6.d/a.txt", 64)
    do pause()
    do rewrite("seen6.d/a.txt", "external\n")
    do after(out, "the same size rewritten", a, "seen6.d/a.txt", "external\n")
    -- The same, and made 600.
    do write_file("seen6.d/b.txt", "old untouched\n", 416)
    let b = file_open("seen6.d/b.txt", 64)
    do pause()
    do rewrite("seen6.d/b.txt", "OLD UNTOUCHED\n")
    do chmod("seen6.d/b.txt", 384)
    do after(out, "the same size rewritten, made 600", b, "seen6.d/b.txt", "OLD UNTOUCHED\n")
    -- Rewritten in place, same size, the modification time put back, the bits kept: only the change
    -- time tells (at 104 in Linux's stat).
    do write_file("seen6.d/c.txt", "old untouched\n", 416)
    let c = file_open("seen6.d/c.txt", 64)
    let was = stat_of("seen6.d/c.txt")
    do pause()
    do rewrite("seen6.d/c.txt", "OLD UNTOUCHED\n")
    do date("seen6.d/c.txt", was, linux_u64(was, 88), linux_u64(was, 96))
    do after(out, "the same size rewritten, its time put back", c, "seen6.d/c.txt", "OLD UNTOUCHED\n")
    -- Only the nanoseconds of the modification time moved, by one, and made 600.
    do write_file("seen6.d/d.txt", "old untouched\n", 416)
    let d = file_open("seen6.d/d.txt", 64)
    let then = stat_of("seen6.d/d.txt")
    let nanoseconds = linux_u64(then, 96) + 1
    if nanoseconds == 1000000000: nanoseconds = linux_u64(then, 96) - 1 end
    do date("seen6.d/d.txt", then, linux_u64(then, 88), nanoseconds)
    do chmod("seen6.d/d.txt", 384)
    do after(out, "the time moved by a nanosecond, made 600", d, "seen6.d/d.txt", "old untouched\n")
    -- Only the seconds of the modification time moved, by one, and made 600.
    do write_file("seen6.d/e.txt", "old untouched\n", 416)
    let e = file_open("seen6.d/e.txt", 64)
    let now = stat_of("seen6.d/e.txt")
    do date("seen6.d/e.txt", now, linux_u64(now, 88) + 1, linux_u64(now, 96))
    do chmod("seen6.d/e.txt", 384)
    do after(out, "the time moved by a second, made 600", e, "seen6.d/e.txt", "old untouched\n")
    -- Made read-only while open, nothing else.
    do write_file("seen6.d/g.txt", "old untouched\n", 420)
    let g = file_open("seen6.d/g.txt", 64)
    do chmod("seen6.d/g.txt", 292)
    do after(out, "made 444", g, "seen6.d/g.txt", "mine\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
the same size rewritten: file_recheck error 116 and mode 644, again error 116, a save error 116, the file holds the outside change at mode 644
the same size rewritten, made 600: file_recheck error 116 and mode 600, again error 116, a save error 116, the file holds the outside change at mode 600
the same size rewritten, its time put back: file_recheck error 116 and mode 640, again error 116, a save error 116, the file holds the outside change at mode 640
the time moved by a nanosecond, made 600: file_recheck error 116 and mode 600, again error 116, a save error 116, the file holds the outside change at mode 600
the time moved by a second, made 600: file_recheck error 116 and mode 600, again error 116, a save error 116, the file holds the outside change at mode 600
made 444: file_recheck 0 and mode 444, again 0, a save 0, the file holds the save at mode 444
----
end
case file: a rescue copy takes the next free name and never writes over a file there, leaves the document's outside change still refused, and gives 17 when every name it may try is taken
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- The inode of the file at path (in Linux's stat at 8).
func inode(path):
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring(path), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    return linux_u64(stat, 8)
end

-- herbert-rescue-PID-N.txt, PID being this program's (Linux's getpid, 39).
func rescue_name(n):
    let b = new_buffer()
    do text_add(b, "herbert-rescue-")
    do text_add_whole(b, linux_syscall6(39, 0, 0, 0, 0, 0, 0))
    do text_add(b, "-")
    do text_add_whole(b, n)
    do text_add(b, ".txt")
    return freeze(b)
end

func path(folder, name):
    let b = new_buffer()
    do text_add(b, folder)
    do text_add(b, name)
    return freeze(b)
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

func main():
    let out = new_buffer()
    do linux_syscall6(83, buffer_address(linux_cstring("name6.d")), 448, 0, 0, 0, 0)
    do write_file("name6.d/doc.txt", "old\n")
    let f = file_open("name6.d/doc.txt", 64)
    -- Someone else's file at the first name a copy tries, and the document changed outside.
    do write_file(path("name6.d/", rescue_name(1)), "preexisting rescue")
    do write_file("name6.d/doc.txt", "external edit\n")
    let before = inode("name6.d/doc.txt")
    do text_add(out, "rescue copy: ")
    do result(out, file_save_copy(f, linux_cstring("rescued\n"), 8))
    let name = file_copy_name(f)
    if text_is(name, 0, linux_nul_end(name, 0, buffer_length(name)), rescue_name(2)): do text_add(out, ", named herbert-rescue-PID-2.txt") end
    if holds(path("name6.d/", rescue_name(2)), "rescued\n"): do text_add(out, ", holding the copy") end
    do text_add(out, "\n")
    if holds(path("name6.d/", rescue_name(1)), "preexisting rescue"): do text_add(out, "the file at herbert-rescue-PID-1.txt is whole\n") end
    if holds("name6.d/doc.txt", "external edit\n") and inode("name6.d/doc.txt") == before: do text_add(out, "the document is the same file with the outside change\n") end
    do text_add(out, "file_conflict after the copy: ")
    do result(out, file_conflict(f))
    -- Every name from herbert-rescue-PID-0.txt to -79.txt taken, each by an empty file.
    do linux_syscall6(83, buffer_address(linux_cstring("full6.d")), 448, 0, 0, 0, 0)
    do write_file("full6.d/doc.txt", "taken\n")
    let g = file_open("full6.d/doc.txt", 64)
    let n = 0
    while n < 80:
        do write_file(path("full6.d/", rescue_name(n)), "")
        n = n + 1
    end
    do text_add(out, "\nwith 80 names taken, a rescue copy: ")
    do result(out, file_save_copy(g, linux_cstring("mine\n"), 5))
    let empty = 0
    n = 0
    while n < 80:
        if holds(path("full6.d/", rescue_name(n)), ""): empty = empty + 1 end
        n = n + 1
    end
    do text_add(out, "\n")
    do text_add_whole(out, empty)
    do text_add(out, " of the 80 still empty\n")
    if holds("full6.d/doc.txt", "taken\n"): do text_add(out, "the document is as it was\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
rescue copy: 0, named herbert-rescue-PID-2.txt, holding the copy
the file at herbert-rescue-PID-1.txt is whole
the document is the same file with the outside change
file_conflict after the copy: error 116
with 80 names taken, a rescue copy: error 17
80 of the 80 still empty
the document is as it was
----
end
