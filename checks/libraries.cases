stdout until ----
0, the copy is the first text
0, the copy is the second text
session folders: 1
----
end
case recovery: after a reset the next checkpoint starts a new folder, and the earlier copy stays whole
libs linux text file_io session_recovery
source until ----
-- The name of the newest session folder beside f's document, as file_scan finds it.
func newest(f, s):
    do file_scan(f, s, ".herbert-notes-")
    let name = file_scan_name(s)
    return text_string(name, 0, linux_nul_end(name, 0, buffer_length(name)))
end

-- Whether recovery.txt in the session folder of that name holds exactly text, read as Notes reads it.
func copy_is(f, folder, text):
    let g = file_new(64)
    if file_load_inside(g, f, linux_cstring(folder), "recovery.txt") != 0: return false end
    return text_is(g.bytes, 0, file_count(g), text)
end

func main():
    -- A folder of its own (Linux's mkdir is 83) and a document not yet on disk.
    do linux_syscall6(83, buffer_address(linux_cstring("rec3.d")), 448, 0, 0, 0, 0)
    let f = file_open("rec3.d/doc.txt", 64)
    let r = recovery_new(64)
    let s = file_scan_new()
    let out = new_buffer()
    do text_add_whole(out, recovery_save(r, f, linux_cstring("first session\n"), 14))
    let first = newest(f, s)
    -- The first session's folder is dated long ago (Linux's utimensat, 280, from the current
    -- folder, -100), so that the folder of the second session is the newest whatever the clock says.
    let path = new_buffer()
    do text_add(path, "rec3.d/")
    do text_add(path, first)
    do append(path, 0)
    let times = linux_buffer(32)
    do linux_put64(times, 0, 1000)
    do linux_put64(times, 16, 1000)
    do linux_syscall6(280, 0 - 100, buffer_address(path), buffer_address(times), 0, 0, 0)
    do recovery_reset(r)
    do text_add(out, " ")
    do text_add_whole(out, recovery_save(r, f, linux_cstring("second session\n"), 15))
    let second = newest(f, s)
    do text_add(out, "\nsession folders: ")
    do text_add_whole(out, file_scan(f, s, ".herbert-notes-"))
    do text_add(out, "\n")
    if not equal(first, second): do text_add(out, "the second copy is in another folder\n") end
    if copy_is(f, first, "first session\n") and copy_is(f, second, "second session\n"): do text_add(out, "both copies are whole\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0 0
session folders: 2
the second copy is in another folder
both copies are whole
----
end
case recovery: a session never takes a folder name that is already there
libs linux text file_io session_recovery
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- .herbert-notes-PROCESS-NUMBER, the name a session's folder has, for this process (Linux's getpid, 39),
-- with after added.
func session(number, after):
    let out = new_buffer()
    do text_add(out, ".herbert-notes-")
    do text_add_whole(out, linux_syscall6(39, 0, 0, 0, 0, 0, 0))
    do text_add(out, "-")
    do text_add_whole(out, number)
    do text_add(out, after)
    return freeze(out)
end

func in_folder(name):
    let out = new_buffer()
    do text_add(out, "rec4.d/")
    do text_add(out, name)
    return freeze(out)
end

func main():
    -- A folder of its own (Linux's mkdir is 83). In it, before any checkpoint, a folder that already
    -- has the first name this process's session would take, with a copy inside.
    do linux_syscall6(83, buffer_address(linux_cstring("rec4.d")), 448, 0, 0, 0, 0)
    do linux_syscall6(83, buffer_address(linux_cstring(in_folder(session(1, "")))), 448, 0, 0, 0, 0)
    do write_file(in_folder(session(1, "/recovery.txt")), "an earlier session's\n")
    let f = file_open("rec4.d/doc.txt", 64)
    let r = recovery_new(64)
    let out = new_buffer()
    do text_add_whole(out, recovery_save(r, f, linux_cstring("this session's\n"), 15))
    do text_add(out, "\n")
    let second = session(2, "/recovery.txt")
    if holds(in_folder(second), "this session's\n"): do text_add(out, "the checkpoint went to the second name\n") end
    if holds(in_folder(session(1, "/recovery.txt")), "an earlier session's\n"): do text_add(out, "the folder with the first name is as it was\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
