case file: no temporary file is left behind by saves, taken or refused
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- How many names in the folder at path begin with prefix, "." and ".." not counted. Linux's
-- getdents64 is 217; in each record the length is at 16 and the name from 19.
func names(path, prefix):
    let fd = linux_open(linux_cstring(path), 65536, 0)
    let dents = linux_buffer(4096)
    let found = 0
    let got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    while not linux_error(got) and got != 0:
        let p = 0
        while p < got:
            let name = p + 19
            let stop = linux_nul_end(dents, name, p + linux_u16(dents, p + 16))
            if text_starts(dents, name, stop, prefix) and not text_is(dents, name, stop, ".") and not text_is(dents, name, stop, ".."): found = found + 1 end
            p = p + linux_u16(dents, p + 16)
        end
        got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    end
    do linux_close(fd)
    return found
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

func main():
    -- A folder of its own (Linux's mkdir is 83), one document in it, room for eight bytes.
    do linux_syscall6(83, buffer_address(linux_cstring("tidy.d")), 448, 0, 0, 0, 0)
    do write_file("tidy.d/doc.txt", "old\n")
    let f = file_open("tidy.d/doc.txt", 8)
    let out = new_buffer()
    do text_add(out, "a save: ")
    do result(out, file_save(f, linux_cstring("new\n"), 4))
    do text_add(out, "\na save too large: ")
    do result(out, file_save(f, linux_cstring("123456789"), 9))
    do write_file("tidy.d/doc.txt", "changed outside\n")
    do text_add(out, "\na save after an outside change: ")
    do result(out, file_save(f, linux_cstring("mine\n"), 5))
    do text_add(out, "\na rescue copy: ")
    do result(out, file_save_copy(f, linux_cstring("mine\n"), 5))
    do text_add(out, "\nnames in the folder: ")
    do text_add_whole(out, names("tidy.d", ""))
    do text_add(out, ", the document and the rescue copy\nof them temporary files, .herbert-save-...: ")
    do text_add_whole(out, names("tidy.d", ".herbert-save-"))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
a save: 0
a save too large: error 27
a save after an outside change: error 116
a rescue copy: 0
names in the folder: 2, the document and the rescue copy
of them temporary files, .herbert-save-...: 0
----
end
case file: while saves replace a file, a reader sees the whole old text or the whole new one, never a mix
libs linux text file_io
source until ----
-- What one read of the whole file finds: 1 for 4000 bytes all A, 2 for 2000 bytes all B, 0 for
-- anything else, a file that is not there included.
func look(path, b):
    let fd = linux_open(path, 0, 0)
    if linux_error(fd): return 0 end
    let used = 0
    let got = linux_read(fd, b, 0, 8192)
    while not linux_error(got) and got != 0:
        used = used + got
        got = linux_read(fd, b, used, 8192 - used)
    end
    do linux_close(fd)
    if linux_error(got) or (used != 4000 and used != 2000): return 0 end
    let i = 0
    while i < used:
        if (used == 4000 and buffer_get(b, i) != 'A') or (used == 2000 and buffer_get(b, i) != 'B'): return 0 end
        i = i + 1
    end
    if used == 4000: return 1 end
    return 2
end

func main():
    let old = new_buffer()
    do buffer_fill(old, 4000, 'A')
    let new = new_buffer()
    do buffer_fill(new, 2000, 'B')
    let f = file_open("swapped.txt", 4096)
    do file_save(f, old, 4000)
    -- A second process (Linux's fork, 57) saves the two texts in turn, fifty times each, and ends
    -- with status 0 when every save was taken.
    let saver = linux_syscall6(57, 0, 0, 0, 0, 0, 0)
    if saver == 0:
        let failed = 0
        let round = 0
        while round < 50:
            if file_save(f, new, 2000) != 0 or file_save(f, old, 4000) != 0: failed = 1 end
            round = round + 1
        end
        do process_exit(failed)
        return 0
    end
    -- This process reads the file over and over until the saver has ended (wait4, 61, not waiting).
    let path = linux_cstring("swapped.txt")
    let b = linux_buffer(8192)
    let status = linux_buffer(8)
    let mixed = 0
    while linux_syscall6(61, saver, buffer_address(status), 1, 0, 0, 0) == 0:
        if look(path, b) == 0: mixed = mixed + 1 end
    end
    let out = new_buffer()
    if linux_u32(status, 0) == 0: do text_add(out, "all hundred saves were taken\n") end
    do text_add_whole(out, mixed)
    do text_add(out, " reads found anything but a whole text\n")
    if look(path, b) == 1: do text_add(out, "the file ends as the last text saved\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
all hundred saves were taken
0 reads found anything but a whole text
the file ends as the last text saved
----
end
case file: file_scan counts the folders whose names begin with a prefix, and names the newest of them
libs linux text file_io
source until ----
-- Linux's mkdir (83) and symlink (88), by number.
func make_folder(path):
    return linux_syscall6(83, buffer_address(linux_cstring(path)), 448, 0, 0, 0, 0)
end

-- The folder at path given the modification time seconds (Linux's utimensat, 280, from the
-- current folder, -100; its two times are access and modification, seconds and nanoseconds).
func set_time(path, seconds):
    let times = linux_buffer(32)
    do linux_put64(times, 0, seconds)
    do linux_put64(times, 16, seconds)
    return linux_syscall6(280, 0 - 100, buffer_address(linux_cstring(path)), buffer_address(times), 0, 0, 0)
end

func scan(out, f, s, prefix):
    do text_add(out, prefix)
    do text_add(out, ": ")
    do text_add_whole(out, file_scan(f, s, prefix))
    do text_add(out, " [")
    let name = file_scan_name(s)
    do text_add_span(out, name, 0, linux_nul_end(name, 0, buffer_length(name)))
    return text_add(out, "]\n")
end

func main():
    -- Beside the document: three folders, two of them snap-..., a plain file and a symbolic link
    -- that wear the prefix too. snap-new is made first and given the later time.
    do make_folder("scan.d")
    do make_folder("scan.d/snap-new")
    do make_folder("scan.d/snap-old")
    do make_folder("scan.d/other")
    let fd = linux_open(linux_cstring("scan.d/snap-file"), 577, 420)
    do linux_close(fd)
    do linux_syscall6(88, buffer_address(linux_cstring("snap-old")), buffer_address(linux_cstring("scan.d/snap-link")), 0, 0, 0, 0)
    do set_time("scan.d/snap-new", 2000)
    do set_time("scan.d/snap-old", 1000)
    let f = file_open("scan.d/doc.txt", 64)
    let s = file_scan_new()
    let out = new_buffer()
    do scan(out, f, s, "snap-")
    do scan(out, f, s, "other")
    do scan(out, f, s, "nothing-")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
snap-: 2 [snap-new]
other: 1 [other]
nothing-: 0 []
----
end
case file: file_load_inside reads a file in a folder beside the document, and refuses a folder that is a link
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Linux's mkdir, 83.
func make_folder(path):
    return linux_syscall6(83, buffer_address(linux_cstring(path)), 448, 0, 0, 0, 0)
end

func inside(out, g, f, folder, name):
    do text_add(out, folder)
    do text_add(out, " and ")
    do text_add(out, name)
    do text_add(out, ": ")
    let r = file_load_inside(g, f, linux_cstring(folder), name)
    if linux_error(r):
        do text_add(out, "error ")
        do text_add_whole(out, 0 - r)
    else:
        do text_add_whole(out, r)
    end
    do text_add(out, "; holding ")
    do text_add_whole(out, file_count(g))
    do text_add(out, " bytes of ")
    do text_add_span(out, g.path, 0, linux_nul_end(g.path, 0, buffer_length(g.path)))
    return text_add(out, "\n")
end

func main():
    do make_folder("inside.d")
    do make_folder("inside.d/copies")
    do write_file("inside.d/copies/recovery.txt", "kept copy\n")
    -- Linux's symlink, 88: inside.d/linked points at copies.
    do linux_syscall6(88, buffer_address(linux_cstring("copies")), buffer_address(linux_cstring("inside.d/linked")), 0, 0, 0, 0)
    let f = file_open("inside.d/doc.txt", 64)
    let g = file_new(64)
    let out = new_buffer()
    do inside(out, g, f, "copies", "recovery.txt")
    if text_is(g.bytes, 0, file_count(g), "kept copy\n"): do text_add(out, "the copy's bytes\n") end
    do inside(out, g, f, "linked", "recovery.txt")
    do inside(out, g, f, "copies", "../doc.txt")
    do inside(out, g, f, "..", "recovery.txt")
    do inside(out, g, f, "missing", "recovery.txt")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
