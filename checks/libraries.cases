stdout until ----
two lines: cursor 2, places 0 1 2 4 5
joined: cursor 0, places 0 3 4
undone: cursor 2, places 0 1 2 4 5
----
end
case text buffer: a space that carries an accent is no place to break a line
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func starts(out, what, b, count):
    let t = text_buffer(64)
    do text_load(t, b, count)
    do text_wrap(t, 5, 1)
    do text_add(out, what)
    do text_add(out, ": rows at 0")
    let row = text_wrap_end(t, 0, 0)
    while not row.1:
        do text_add(out, " ")
        do text_add_whole(out, row.0)
        row = text_wrap_end(t, row.0, 0)
    end
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- Five columns. "abc defg" breaks after its space, at 4.
    do starts(out, "a plain space", linux_cstring("abc defg"), 8)
    -- abc, a space with a combining acute accent (three bytes, one character), defg: eight characters
    -- and no blank, so the row is cut after the fifth, d, at byte 7.
    let b = linux_buffer(10)
    do text_put(b, 0, "abc ..defg")
    do buffer_set(b, 4, 204)
    do buffer_set(b, 5, 129)
    do starts(out, "a space with an accent", b, 10)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
a plain space: rows at 0 4
a space with an accent: rows at 0 7
----
end
case text buffer: through 2000 random edits, the places the cursor can stand are those a fresh marking of the text gives
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
ref record Dice:
    seed: int
    rolls: int
end

-- A number from 0 to n - 1, the same sequence on every run.
func roll(d, n):
    d.seed = d.seed * 6364136223846793005 + 1442695040888963407
    d.rolls = d.rolls + 1
    return (d.seed >> 33) % n
end

-- Letters and blanks, a newline, a tab, and scalars that join their neighbours: a combining accent,
-- a regional indicator, a zero-width joiner, an emoji, a Devanagari consonant and its virama, a
-- Hangul syllable and a trailing consonant.
func scalar(k):
    if k < 8: return 'a' + k end
    if k < 11: return ' ' end
    if k == 11: return 10 end
    if k == 12: return 9 end
    if k == 13: return 769 end
    if k == 14: return 127465 end
    if k == 15: return 8205 end
    if k == 16: return 128104 end
    if k == 17: return 2325 end
    if k == 18: return 2381 end
    if k == 19: return 44032 end
    return 4520
end

-- One edit at a random place: a scalar typed, a backspace, a delete, an undo, a redo, or two
-- characters replaced by three bytes. 1 when the text changed.
func edit(t, d):
    do text_seek(t, roll(d, text_length(t) + 1))
    let what = roll(d, 20)
    if what < 11: return text_insert(t, scalar(roll(d, 21))) end
    if what < 14: return text_backspace(t) end
    if what < 17: return text_delete(t) end
    if what == 17: return text_undo(t) end
    if what == 18: return text_redo(t) end
    let from = text_cursor(t)
    if text_replace(t, from, text_next(t, text_next(t, from)), linux_cstring("x\ny"), 0, 3) == 1: return 1 end
    return 0
end

-- How many of the text's flags differ from a marking of the whole text made now.
func differences(t, fresh):
    let n = text_length(t)
    let wrong = 0
    if unicode_grapheme_mark(t.bytes, n, fresh) != 0: wrong = 1 end
    let p = 0
    while p <= n:
        let kept = buffer_get(t.marks, p) != 0
        let made = buffer_get(fresh, p) != 0
        if (kept and not made) or (made and not kept): wrong = wrong + 1 end
        p = p + 1
    end
    return wrong
end

func main():
    let t = text_buffer(256)
    let fresh = linux_buffer(257)
    let d = Dice(2026, 0)
    let changed = 0
    let wrong = 0
    let edits = 0
    while edits < 2000:
        changed = changed + edit(t, d)
        wrong = wrong + differences(t, fresh)
        edits = edits + 1
    end
    let out = new_buffer()
    do text_add_whole(out, wrong)
    do text_add(out, " flags differed\n")
    if changed > 1000: do text_add(out, "more than 1000 of the edits changed the text\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0 flags differed
more than 1000 of the edits changed the text
----
end
case text buffer: through 2000 random edits, rows and their starts are those a fresh count of newlines gives
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
ref record Dice:
    seed: int
    rolls: int
end

-- A number from 0 to n - 1, the same sequence on every run.
func roll(d, n):
    d.seed = d.seed * 6364136223846793005 + 1442695040888963407
    d.rolls = d.rolls + 1
    return (d.seed >> 33) % n
end

-- One edit at a random place: a letter or (one time in three) a newline typed, a backspace, a
-- delete, an undo, a redo, or two characters replaced by three bytes. 1 when the text changed.
func edit(t, d):
    do text_seek(t, roll(d, text_length(t) + 1))
    let what = roll(d, 20)
    if what < 11:
        if roll(d, 3) == 0: return text_insert(t, 10) end
        return text_insert(t, 'a')
    end
    if what < 14: return text_backspace(t) end
    if what < 17: return text_delete(t) end
    if what == 17: return text_undo(t) end
    if what == 18: return text_redo(t) end
    let from = text_cursor(t)
    if text_replace(t, from, text_next(t, text_next(t, from)), linux_cstring("x\ny"), 0, 3) == 1: return 1 end
    return 0
end

-- 1 when the row of p, or the start of that row, is not what counting from the start gives.
func difference(t, p):
    let row = 0
    let start = 0
    let i = 0
    while i < p:
        if buffer_get(t.bytes, i) == 10:
            row = row + 1
            start = i + 1
        end
        i = i + 1
    end
    if text_row(t, p) != row or text_row_offset(t, row) != start: return 1 end
    return 0
end

func main():
    let t = text_buffer(256)
    let d = Dice(1109, 0)
    let changed = 0
    let wrong = 0
    let edits = 0
    while edits < 2000:
        changed = changed + edit(t, d)
        -- Three places looked at after each edit, anywhere in the text.
        wrong = wrong + difference(t, roll(d, text_length(t) + 1))
        wrong = wrong + difference(t, roll(d, text_length(t) + 1))
        wrong = wrong + difference(t, roll(d, text_length(t) + 1))
        edits = edits + 1
    end
    let out = new_buffer()
    do text_add_whole(out, wrong)
    do text_add(out, " rows or row starts differed\n")
    if changed > 1000: do text_add(out, "more than 1000 of the edits changed the text\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0 rows or row starts differed
more than 1000 of the edits changed the text
----
end
case text buffer: through 2000 random edits, a place's screen row and file column are those walked afresh from its line's start
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
ref record Dice:
    seed: int
    rolls: int
end

-- A number from 0 to n - 1, the same sequence on every run.
func roll(d, n):
    d.seed = d.seed * 6364136223846793005 + 1442695040888963407
    d.rolls = d.rolls + 1
    return (d.seed >> 33) % n
end

-- Mostly letters, with blanks, tabs, a few newlines and an accent that joins the letter before it.
func scalar(k):
    if k < 12: return 'a' + k end
    if k < 16: return ' ' end
    if k == 16: return 9 end
    if k == 17: return 10 end
    return 769
end

-- One edit at a random place: a scalar typed, a backspace, a delete, an undo, a redo, or two
-- characters replaced by three bytes. 1 when the text changed.
func edit(t, d):
    do text_seek(t, roll(d, text_length(t) + 1))
    let what = roll(d, 20)
    if what < 13: return text_insert(t, scalar(roll(d, 19))) end
    if what < 15: return text_backspace(t) end
    if what < 17: return text_delete(t) end
    if what == 17: return text_undo(t) end
    if what == 18: return text_redo(t) end
    let from = text_cursor(t)
    if text_replace(t, from, text_next(t, text_next(t, from)), linux_cstring("x y"), 0, 3) == 1: return 1 end
    return 0
end

-- 1 when the row the text remembers for p is not the row found by walking from the start of p's
-- line, or its line and column in the file are not the count of newlines before it and text_column.
func difference(t, p):
    p = text_floor(t, p)
    let r = text_line_start(t, p)
    let row = text_wrap_end(t, r, 0)
    while not row.1 and p >= row.0:
        r = row.0
        row = text_wrap_end(t, r, 0)
    end
    let line = 0
    let i = 0
    while i < p:
        if buffer_get(t.bytes, i) == 10: line = line + 1 end
        i = i + 1
    end
    let file = text_wrap_file(t, p)
    if text_wrap_start(t, p) != r or file.0 != line or file.1 != text_column(t, p): return 1 end
    return 0
end

func main():
    -- Seven columns, every second row remembered.
    let t = text_buffer(512)
    do text_wrap(t, 7, 2)
    let d = Dice(77, 0)
    let changed = 0
    let wrong = 0
    let edits = 0
    while edits < 2000:
        changed = changed + edit(t, d)
        -- The cursor's place and two others looked at after each edit.
        wrong = wrong + difference(t, text_cursor(t))
        wrong = wrong + difference(t, roll(d, text_length(t) + 1))
        wrong = wrong + difference(t, roll(d, text_length(t) + 1))
        edits = edits + 1
    end
    let out = new_buffer()
    do text_add_whole(out, wrong)
    do text_add(out, " places differed\n")
    if changed > 1000: do text_add(out, "more than 1000 of the edits changed the text\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0 places differed
more than 1000 of the edits changed the text
----
end
case text buffer: after an edit at the very end of a long wrapped line, its rows are those of a fresh buffer, found from the rows kept and not by walking the line again
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- A line of 10000 letters, ten columns wide (a thousand rows, every 32nd remembered), then a
-- newline and "tail". The line's far end is looked at, then the edit is made at the line's very
-- end, just before its newline: a letter typed there, or that newline deleted.
func trial(out, what, joining):
    let text = new_buffer()
    do buffer_fill(text, 10000, 'a')
    do text_add(text, "\ntail")
    let t = text_buffer(16384)
    do text_load(t, text, 10005)
    do text_wrap(t, 10, 32)
    do text_wrap_start(t, 9995)
    do text_seek(t, 10000)
    if joining: do text_delete(t) else: do text_insert(t, 'b') end
    -- Where the line ends now, and the row that end is on.
    let stop = text_line_end(t, 0)
    let before = text_wrap_walked(t)
    let row = text_wrap_start(t, stop)
    let walked = text_wrap_walked(t) - before
    do text_add(out, what)
    do text_add(out, ": the line's end ")
    do text_add_whole(out, stop)
    do text_add(out, " is on the row at ")
    do text_add_whole(out, row)
    -- The rows before the last remembered one at or before the edit are kept, so the walk begins
    -- less than twice 32 rows back.
    if walked <= 64: do text_add(out, ", found by walking 64 rows or fewer") else: do text_add(out, ", found by walking MORE than 64 rows") end
    -- A buffer that never saw the edit, loaded with the text as it now is.
    let fresh = text_buffer(16384)
    do text_load(fresh, t.bytes, text_length(t))
    do text_wrap(fresh, 10, 32)
    let differ = 0
    let p = 9000
    while p <= text_length(t):
        if text_wrap_start(t, p) != text_wrap_start(fresh, p): differ = differ + 1 end
        p = p + 1
    end
    do text_add(out, "; ")
    do text_add_whole(out, differ)
    return text_add(out, " places from 9000 on have another row than in a fresh buffer\n")
end

func main():
    let out = new_buffer()
    do trial(out, "a letter typed", false)
    do trial(out, "the newline deleted", true)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
a letter typed: the line's end 10001 is on the row at 10000, found by walking 64 rows or fewer; 0 places from 9000 on have another row than in a fresh buffer
the newline deleted: the line's end 10004 is on the row at 10000, found by walking 64 rows or fewer; 0 places from 9000 on have another row than in a fresh buffer
----
end
case text buffer: with four long lines' rows remembered, a fifth takes the place of the one looked at longest ago
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- Look at a place near the far end of the given line, and say how much of the line was walked
-- to find its row: at most the 8 rows from the nearest remembered one, or all 200.
func look(out, t, line):
    let before = text_wrap_walked(t)
    do text_wrap_start(t, line * 2001 + 1995)
    let walked = text_wrap_walked(t) - before
    do text_add(out, "line ")
    do text_add_whole(out, line)
    if walked <= 8: return text_add(out, ": 8 rows or fewer walked\n") end
    if walked >= 200: return text_add(out, ": the whole line walked\n") end
    do text_add(out, ": ")
    do text_add_whole(out, walked)
    return text_add(out, " rows walked\n")
end

func main():
    -- Five lines of 2000 letters, ten columns wide: 200 rows each, every 8th remembered. Line 0
    -- begins at 0, line 1 at 2001, and so on.
    let text = new_buffer()
    let line = 0
    while line < 5:
        do buffer_fill(text, 2000, 'a')
        if line < 4: do append(text, 10) end
        line = line + 1
    end
    let t = text_buffer(16384)
    do text_load(t, text, 10004)
    do text_wrap(t, 10, 8)
    let out = new_buffer()
    -- Four lines fill the four places rows are remembered in.
    do look(out, t, 0)
    do look(out, t, 1)
    do look(out, t, 2)
    do look(out, t, 3)
    -- Line 0 is looked at again, so line 1 is now the one looked at longest ago.
    do look(out, t, 0)
    -- A fifth line needs a place: line 1's.
    do look(out, t, 4)
    do look(out, t, 0)
    do look(out, t, 2)
    do look(out, t, 3)
    do look(out, t, 1)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
line 0: the whole line walked
line 1: the whole line walked
line 2: the whole line walked
line 3: the whole line walked
line 0: 8 rows or fewer walked
line 4: the whole line walked
line 0: 8 rows or fewer walked
line 2: 8 rows or fewer walked
line 3: 8 rows or fewer walked
line 1: the whole line walked
----
end
case file: a new document saved into the folder reads back byte for byte
libs linux text file_io
source until ----
func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

func main():
    let out = new_buffer()
    let f = file_open("new.txt", 4096)
    do text_add(out, "opened: ")
    do result(out, file_status(f))
    do text_add(out, ", ")
    do text_add_whole(out, file_count(f))
    do text_add(out, " bytes\n")
    -- Every byte there is, 0 to 255, once.
    let bytes = linux_buffer(256)
    let i = 0
    while i < 256:
        do buffer_set(bytes, i, i)
        i = i + 1
    end
    do text_add(out, "saved: ")
    do result(out, file_save(f, bytes, 256))
    -- Read back without the library.
    let back = linux_read_file("new.txt", 4096)
    let differ = 0
    i = 0
    while i < 256 and i < back.2:
        if buffer_get(back.1, i) != i: differ = differ + 1 end
        i = i + 1
    end
    do text_add(out, "\nread back: ")
    do result(out, back.0)
    do text_add(out, ", ")
    do text_add_whole(out, back.2)
    do text_add(out, " bytes, ")
    do text_add_whole(out, differ)
    do text_add(out, " differ\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
opened: 0, 0 bytes
saved: 0
read back: 0, 256 bytes, 0 differ
----
end
case file: saving over a file replaces all of it, and a shorter text leaves no tail of the old one
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

func save(out, f, path, s):
    do text_add_whole(out, file_save(f, linux_cstring(s), length(s)))
    if holds(path, s): return text_add(out, ", and the file is exactly the text saved\n") end
    return text_add(out, ", but the file is NOT the text saved\n")
end

func main():
    do write_file("over.txt", "a long old text\n")
    let f = file_open("over.txt", 64)
    let out = new_buffer()
    do save(out, f, "over.txt", "new\n")
    do save(out, f, "over.txt", "a third, longer text\n")
    do save(out, f, "over.txt", "")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0, and the file is exactly the text saved
0, and the file is exactly the text saved
0, and the file is exactly the text saved
----
end
