case fwriter: a publication whose getrandom fails with EIO or ENOSYS, or gives no bytes, ends with status 1 and its one line, keeps the old a.out and leaves no temporary file
libs linux text fault
source until ----
-- How many names in the folder at path begin with prefix, "." and ".." not counted. Linux's
-- getdents64 is 217; in each record the length is at 16 and the name from 19.
func names(path, prefix):
    let fd = linux_open(linux_cstring(path), 65536, 0)
    let dents = linux_buffer(4096)
    let found = 0
    let got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    while not linux_error(got) and got != 0:
        let p = 0
        while p < got:
            let name = p + 19
            let stop = linux_nul_end(dents, name, p + linux_u16(dents, p + 16))
            if text_starts(dents, name, stop, prefix) and not text_is(dents, name, stop, ".") and not text_is(dents, name, stop, ".."): found = found + 1 end
            p = p + linux_u16(dents, p + 16)
        end
        got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    end
    do linux_close(fd)
    return found
end

-- One publication of "new\n" over a.out, which holds "old\n", in the folder
-- fault-pub-random.d, by a new process given a filter with one rule: kind 0 none,
-- 1 every call of number, 2 only those whose argument 0 is fwriter's
-- temporary file, 3 only those whose argument 0 is fwriter's folder. Its
-- error output goes to fault-pub-random.err, and Linux's alarm stops it after
-- seconds. One line tells how it ended, what a.out holds, how many temporary
-- files there are (when count is true) and what it said.
func trial(out, label, kind, number, error, seconds, count):
    let fd = linux_open(linux_cstring("fault-pub-random.d/a.out"), 577, 420)
    do linux_write(fd, linux_cstring("old\n"), 0, 4)
    do linux_close(fd)
    let status = linux_buffer(8)
    -- fork (57); in the new process: killed (9) if this one ends first
    -- (prctl 157, PR_SET_PDEATHSIG 1), the alarm (37), the error output
    -- moved (dup2, 33), the folder entered (chdir, 80), then the filter.
    let pid = linux_syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid == 0:
        do linux_syscall6(157, 1, 9, 0, 0, 0, 0)
        do linux_syscall6(37, seconds, 0, 0, 0, 0, 0)
        let e = linux_open(linux_cstring("fault-pub-random.err"), 577, 420)
        do linux_syscall6(33, e, 2, 0, 0, 0, 0)
        do linux_close(e)
        do linux_syscall6(80, buffer_address(linux_cstring("fault-pub-random.d")), 0, 0, 0, 0, 0)
        -- Linux gives the lowest free numbers: fwriter's folder takes the
        -- first and its temporary file the second.
        let first = linux_open(linux_cstring("/dev/null"), 0, 0)
        let temporary = linux_open(linux_cstring("/dev/null"), 0, 0)
        do linux_close(first)
        do linux_close(temporary)
        let f = fault_new()
        if kind == 1: do fault_fail(f, number, error) end
        if kind == 2: do fault_fail_equal(f, number, error, 0, temporary) end
        if kind == 3: do fault_fail_equal(f, number, error, 0, first) end
        if fault_start(fault_ready(f)) != 0: do process_exit(99) end
        do fwriter("new\n")
        do process_exit(0)
        return 0
    end
    -- wait4 (61) until it ends.
    let waited = linux_syscall6(61, pid, buffer_address(status), 0, 0, 0, 0)
    while waited == 0 - 4: waited = linux_syscall6(61, pid, buffer_address(status), 0, 0, 0, 0) end
    let st = linux_u32(status, 0)
    do text_add(out, label)
    if (st & 127) != 0:
