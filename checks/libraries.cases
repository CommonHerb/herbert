source until ----
func type_text(t, s):
    let taken = 0
    let i = 0
    while i < length(s):
        taken = taken + text_insert(t, index(s, i))
        i = i + 1
    end
    return taken
end

func show(out, t):
    do text_add(out, "[")
    do text_add_span(out, t.bytes, 0, text_length(t))
    do text_add(out, "] cursor ")
    do text_add_whole(out, text_cursor(t))
    return text_add(out, "\n")
end

func main():
    let t = text_buffer(64)
    let out = new_buffer()
    do text_add_whole(out, type_text(t, "hllo"))
    do text_add(out, " letters taken\n")
    do show(out, t)
    do text_seek(t, 1)
    do text_insert(t, 'e')
    do show(out, t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
