9 allowed
10 allowed
13 kept out
0 kept out
27 kept out
127 kept out
159 kept out
160 allowed
8203 allowed
65279 allowed
65534 allowed
55296 kept out
1114112 kept out
----
end
case utf8: a four-byte scalar is read only in its shortest form, whole, and with three continuation bytes after its first
libs linux text utf8
source until ----
func hex_digit(c):
    if c <= 57: return c - 48 end
    return c - 55
end

-- The bytes s names in hex: two digits a byte, a space between bytes.
func hex(s):
    let b = new_buffer()
    let i = 0
    while i + 1 < length(s):
        do append(b, hex_digit(index(s, i)) * 16 + hex_digit(index(s, i + 1)))
        i = i + 3
    end
    return b
end

-- The bytes s decoded from 0, only the first limit of them counted as there.
func report(out, s, limit):
    let b = hex(s)
    let r = utf8_decode(b, 0, limit)
    do text_add(out, s)
    if limit != buffer_length(b):
        do text_add(out, ", only the first ")
        do text_add_whole(out, limit)
        do text_add(out, " counted")
    end
    if linux_error(r.0):
        do text_add(out, ": refused, error ")
        do text_add_whole(out, 0 - r.0)
        do text_add(out, " at ")
    else:
        do text_add(out, ": scalar ")
        do text_add_whole(out, r.0)
        do text_add(out, " next ")
    end
    do text_add_whole(out, r.1)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- A grinning face; the smallest four-byte scalar, U+10000; the largest, U+10FFFF.
    do report(out, "F0 9F 98 80", 4)
    do report(out, "F0 90 80 80", 4)
    do report(out, "F4 8F BF BF", 4)
    -- Four bytes for what three can say: U+FFFF and U+0000 written long.
    do report(out, "F0 8F BF BF", 4)
    do report(out, "F0 80 80 80", 4)
    -- The letter A (41) where the fourth, the third or the second byte should continue.
    do report(out, "F0 9F 98 41", 4)
    do report(out, "F0 9F 41 80", 4)
    do report(out, "F0 41 98 80", 4)
    -- Cut after three bytes: with nothing after them, and with the fourth byte lying past the limit.
    do report(out, "F0 9F 98", 3)
    do report(out, "F0 9F 98 80", 3)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
F0 9F 98 80: scalar 128512 next 4
F0 90 80 80: scalar 65536 next 4
F4 8F BF BF: scalar 1114111 next 4
F0 8F BF BF: refused, error 84 at 0
F0 80 80 80: refused, error 84 at 0
F0 9F 98 41: refused, error 84 at 0
F0 9F 41 80: refused, error 84 at 0
F0 41 98 80: refused, error 84 at 0
F0 9F 98: refused, error 84 at 0
F0 9F 98 80, only the first 3 counted: refused, error 84 at 0
----
end
case utf8: of the four-byte sequences with any second byte and edge values in the last two, exactly the scalars' own forms decode
libs linux text utf8
source until ----
func main():
    let b = linux_buffer(4)
    let again = linux_buffer(4)
    -- 7F and C0 lie just outside the continuation bytes, 80 and BF are the first and the last of them.
    let edges = linux_buffer(4)
    do buffer_set(edges, 0, 127)
    do buffer_set(edges, 1, 128)
    do buffer_set(edges, 2, 191)
    do buffer_set(edges, 3, 192)
    let tried = 0
    let good = 0
    let wrong = 0
    -- First bytes F0 to F7: every byte that could begin four.
    let first = 240
    while first < 248:
        do buffer_set(b, 0, first)
        let second = 0
        while second < 256:
            do buffer_set(b, 1, second)
            let k = 0
            while k < 16:
                do buffer_set(b, 2, buffer_get(edges, k / 4))
                do buffer_set(b, 3, buffer_get(edges, k % 4))
                let r = utf8_decode(b, 0, 4)
                tried = tried + 1
                if not linux_error(r.0):
                    good = good + 1
                    if r.1 != 4 or r.0 < 65536 or r.0 > 1114111 or utf8_store(again, 0, r.0) != 4 or buffer_get(again, 0) != first or buffer_get(again, 1) != second or buffer_get(again, 2) != buffer_get(b, 2) or buffer_get(again, 3) != buffer_get(b, 3): wrong = wrong + 1 end
                end
                k = k + 1
            end
            second = second + 1
        end
        first = first + 1
    end
    -- The 1048576 four-byte scalars have 256 different first two bytes (4096 scalars to each pair);
    -- each pair is tried with 2 good third bytes and 2 good fourth bytes: 256 * 4.
    let out = new_buffer()
    do text_add_whole(out, tried)
    do text_add(out, " tried, ")
    do text_add_whole(out, good)
    do text_add(out, " decode, ")
    do text_add_whole(out, wrong)
    do text_add(out, " of those to a scalar that stores back as other bytes\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
32768 tried, 1024 decode, 0 of those to a scalar that stores back as other bytes
----
end
case graphemes: plain letters are one cluster each, and a combining accent stays with its letter
libs linux text utf8 unicode_tables unicode_grapheme
source until ----
func hex_digit(c):
    if c <= 57: return c - 48 end
    return c - 55
end

-- The scalars s names in hex, a space between them, as UTF-8 bytes.
func scalars(s):
    let b = new_buffer()
    let one = linux_buffer(4)
    let cp = 0
    let i = 0
    while i <= length(s):
        if i == length(s) or index(s, i) == 32:
            do text_add_span(b, one, 0, utf8_store(one, 0, cp))
            cp = 0
        else:
            cp = cp * 16 + hex_digit(index(s, i))
        end
        i = i + 1
    end
    return b
end

-- The byte offsets where a cluster starts or the text ends.
func boundaries(out, s):
    let b = scalars(s)
    let n = buffer_length(b)
    let marks = linux_buffer(n + 1)
    do text_add(out, s)
    do text_add(out, ":")
    if unicode_grapheme_mark(b, n, marks) != 0: return text_add(out, " refused\n") end
    let p = 0
    while p <= n:
        if buffer_get(marks, p) != 0:
            do text_add(out, " ")
            do text_add_whole(out, p)
        end
        p = p + 1
    end
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- a b c; e, a combining acute (two bytes), x; e with two accents, x; an accent with no letter before it.
    do boundaries(out, "61 62 63")
    do boundaries(out, "65 301 78")
    do boundaries(out, "65 301 308 78")
    do boundaries(out, "301 65")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
61 62 63: 0 1 2 3
65 301 78: 0 3 4
65 301 308 78: 0 5 6
301 65: 0 2 3
----
end
