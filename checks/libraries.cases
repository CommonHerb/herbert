case folder: removing takes a folder with every folder, file and link under it, and leaves alone what its links point at
libs linux text folder
source until ----
func yes(b):
    if b: return "yes" end
    return "no"
end

func folder(path):
    return linux_syscall6(83, buffer_address(linux_cstring(path)), 448, 0, 0, 0, 0)
end

func file(path):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring("kept"), 0, 4)
    return linux_close(fd)
end

func link(target, path):
    return linux_syscall6(88, buffer_address(linux_cstring(target)), buffer_address(linux_cstring(path)), 0, 0, 0, 0)
end

func there(path):
    let fd = linux_open(linux_cstring(path), 0, 0)
    if linux_error(fd): return false end
    do linux_close(fd)
    return true
end

func say(what, result, more):
    let line = new_buffer()
    do text_add(line, what)
    do text_add_whole(line, 0 - result)
    do text_add(line, more)
    do text_add(line, "\n")
    do flogger(freeze(line))
    return 0
end

func main():
    do folder("fr-out")
    do file("fr-out/keep")
    do folder("fr-out/kept-folder")
    do file("fr-out/kept-folder/inside")
    do folder("fr-in")
    do folder("fr-in/top")
    do folder("fr-in/top/empty")
    do folder("fr-in/top/a")
    do folder("fr-in/top/a/b")
    do file("fr-in/top/one")
    do file("fr-in/top/a/two")
    do file("fr-in/top/a/b/three")
    -- Enough names in one folder that Linux hands them over in several goes.
    let i = 0
    while i < 900:
        let name = new_buffer()
        do text_add(name, "fr-in/top/a/a-long-name-so-that-the-names-do-not-fit-in-one-go-")
        do text_add_whole(name, i)
        do file(freeze(name))
        i = i + 1
    end
    do link("../../fr-out/keep", "fr-in/top/to-a-file")
    do link("../../../fr-out/kept-folder", "fr-in/top/a/to-a-folder")
    do link("nowhere", "fr-in/top/to-nothing")
    let fd = folder_open(linux_cstring("fr-in"))
    do say("a folder with folders, files and links under it: ", folder_remove(fd, linux_cstring("top")), "")
    do say("the folder it was in is empty and can be removed: ", linux_syscall6(84, buffer_address(linux_cstring("fr-in")), 0, 0, 0, 0, 0), "")
    do flogger("what its links pointed at is still there: ")
    do flogger(yes(there("fr-out/keep")))
    do flogger(" ")
    do flogger(yes(there("fr-out/kept-folder/inside")))
    do flogger("\n")
    let here = folder_open(linux_cstring("."))
    do file("fr-single")
    do say("a file by itself: ", folder_remove(here, linux_cstring("fr-single")), "")
    do flogger("it is gone: ")
    do flogger(yes(not there("fr-single")))
    do flogger("\n")
    do link("fr-out", "fr-link")
    do say("a link to a folder: ", folder_remove(here, linux_cstring("fr-link")), "")
    do flogger("the link is gone and the folder it pointed at is not: ")
    do flogger(yes(not there("fr-link")))
    do flogger(" ")
    do flogger(yes(there("fr-out/keep")))
    do flogger("\n")
    do process_exit(0)
    return 0
end
----
stdout until ----
a folder with folders, files and links under it: 0
the folder it was in is empty and can be removed: 0
what its links pointed at is still there: yes yes
a file by itself: 0
it is gone: yes
a link to a folder: 0
the link is gone and the folder it pointed at is not: yes yes
----
end
