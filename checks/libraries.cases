case x11: an Xauthority file whose first field claims more bytes than the file holds is refused in words that never show its bytes
libs linux x11
source until ----
func main():
    -- Family 256 (1, 0), then an address field that claims 65535 bytes (255, 255), then a secret in place of them.
    let b = new_buffer()
    do append(b, 1)
    do append(b, 0)
    do append(b, 255)
    do append(b, 255)
    let secret = "MARKER-THE-COOKIE-MUST-NEVER-BE-PRINTED"
    let i = 0
    while i < length(secret):
        do append(b, index(secret, i))
        i = i + 1
    end
    do x11_auth_find(b, 0, buffer_length(b), "0", "here")
    do flogger("found\n")
    return 0
end
