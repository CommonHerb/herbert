case figures: a disk's blocks become what is in use, what is free to its owner and sizes in KiB, or the disk is not shown
libs linux text figures
source until ----
func kib(out, blocks, bytes):
    let k = figures_kib(blocks, bytes)
    do text_add_whole(out, blocks)
    do text_add(out, " blocks of ")
    do text_add_whole(out, bytes)
    if not k.0: return text_add(out, ": too many KiB for 64 bits\n") end
    do text_add(out, ": ")
    do text_add_whole(out, k.1)
    return text_add(out, " KiB\n")
end

func disk(out, what, d, ok, blocks, bfree, bavail, frsize):
    do figures_disk_figures(d, ok, blocks, bfree, bavail, frsize)
    do text_add(out, what)
    if d.state != 1: return text_add(out, ": not shown\n") end
    do text_add(out, ": in use ")
    do text_add_whole(out, d.used)
    do text_add(out, ", free to its owner ")
    do text_add_whole(out, d.avail)
    do text_add(out, ", size ")
    do text_add_whole(out, d.size)
    do text_add(out, " KiB, free ")
    do text_add_whole(out, d.free)
    return text_add(out, " KiB\n")
end

func main():
    let out = new_buffer()
    do kib(out, 10, 4096)
    do kib(out, 3, 512)
    do kib(out, 1000, 1000)
    do kib(out, 18446744073709551615, 512)
    do kib(out, 18446744073709551615, 1024)
    do kib(out, 18446744073709551615, 1025)
    -- statfs's answer: whether it answered, all blocks, free blocks, blocks free to an ordinary user, bytes a block.
    let d = figures_disk_new(".")
    do disk(out, "1000 blocks, 400 free, 300 to the owner", d, true, 1000, 400, 300, 4096)
    do disk(out, "more free than there is", d, true, 100, 150, 50, 1024)
    do disk(out, "statfs refused", d, false, 1000, 400, 300, 4096)
    do disk(out, "no blocks", d, true, 0, 0, 0, 4096)
    do disk(out, "blocks of no bytes", d, true, 1000, 400, 300, 0)
    do disk(out, "in use and free together past 2^64 - 1", d, true, 18446744073709551615, 0, 1, 1)
    -- With nothing in use and nothing free, the disk is full for its owner.
    do text_add(out, "nothing in use, nothing free: ")
    do text_add_whole(out, figures_disk_percent(0, 0))
    do text_add(out, " percent\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
