case text buffer: screen rows are counted down and up across lines, and never past the first or last
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- n rows down from the top row: where that comes to, and into moved how many rows it went.
func down(out, moved, t, n):
    let ahead = text_wrap_ahead(t, 0, n)
    do text_add(out, " ")
    do text_add_whole(out, ahead.0)
    do text_add(moved, " ")
    return text_add_whole(moved, ahead.1)
end

func main():
    -- Four columns, six rows: [abcd] at 0, [efgh] at 4, [ij] at 8, [xyz] at 11, an empty line at 15,
    -- [last] at 16.
    let t = text_buffer(64)
    do text_load(t, linux_cstring("abcdefghij\nxyz\n\nlast"), 20)
    do text_wrap(t, 4, 32)
    let out = new_buffer()
    do text_add(out, "down 1 3 5 9 rows from the top:")
    let moved = new_buffer()
    do down(out, moved, t, 1)
    do down(out, moved, t, 3)
    do down(out, moved, t, 5)
    do down(out, moved, t, 9)
    do text_add(out, "\nrows moved:")
    do text_add(out, freeze(moved))
    do text_add(out, "\nup 1 2 3 5 9 rows from the last row: ")
    do text_add_whole(out, text_wrap_back(t, 16, 1))
    do text_add(out, " ")
    do text_add_whole(out, text_wrap_back(t, 16, 2))
    do text_add(out, " ")
    do text_add_whole(out, text_wrap_back(t, 16, 3))
    do text_add(out, " ")
    do text_add_whole(out, text_wrap_back(t, 16, 5))
    do text_add(out, " ")
    do text_add_whole(out, text_wrap_back(t, 16, 9))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
down 1 3 5 9 rows from the top: 4 11 16 16
rows moved: 1 3 5 5
up 1 2 3 5 9 rows from the last row: 15 11 8 0 0
----
end
case text buffer: rows looked up after an edit are the rows of the text as it now is
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- The row start offset p belongs on: rows of ten letters, and after a newline at split (0 for none)
-- a new line of such rows. The end of a text of whole rows is on the last of them.
func want(p, split, size):
    if split != 0 and p > split: return split + 1 + ((p - split - 1) / 10) * 10 end
    if split == 0 and p == size and p % 10 == 0: return p - 10 end
    return p - p % 10
end

-- How many places are put on another row, looking each up from the start to the end and back.
func misplaced(t, split):
    let size = text_length(t)
    let wrong = 0
    let p = 0
    while p <= size:
        if text_wrap_start(t, p) != want(p, split, size): wrong = wrong + 1 end
        p = p + 1
    end
    while p != 0:
        p = p - 1
        if text_wrap_start(t, p) != want(p, split, size): wrong = wrong + 1 end
    end
    return wrong
end

func trial(out, every):
    -- One line of 150 letters, ten columns wide: fifteen rows, at 0, 10, 20 and so on.
    let t = text_buffer(8192)
    let letters = new_buffer()
    do buffer_fill(letters, 150, 'a')
    do text_load(t, letters, 150)
    do text_wrap(t, 10, every)
    do text_add(out, "as loaded ")
    do text_add_whole(out, misplaced(t, 0))
    do text_add(out, " misplaced, 100 on the row at ")
    do text_add_whole(out, text_wrap_start(t, 100))
    -- A newline typed at 75: the second line begins at 76, its rows at 76, 86, 96 and so on.
    do text_seek(t, 75)
    do text_insert(t, 10)
    do text_add(out, "; with a newline at 75 ")
    do text_add_whole(out, misplaced(t, 75))
    do text_add(out, " misplaced, 100 on the row at ")
    do text_add_whole(out, text_wrap_start(t, 100))
    do text_undo(t)
    do text_add(out, "; the newline undone ")
    do text_add_whole(out, misplaced(t, 0))
    do text_add(out, " misplaced, 100 on the row at ")
    do text_add_whole(out, text_wrap_start(t, 100))
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- Every row remembered, then every fourth.
    do trial(out, 1)
    do trial(out, 4)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
as loaded 0 misplaced, 100 on the row at 100; with a newline at 75 0 misplaced, 100 on the row at 96; the newline undone 0 misplaced, 100 on the row at 100
as loaded 0 misplaced, 100 on the row at 100; with a newline at 75 0 misplaced, 100 on the row at 96; the newline undone 0 misplaced, 100 on the row at 100
----
end
