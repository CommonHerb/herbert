stdout until ----
the text changed: file_recheck error 116, a save error 116, the outside change whole
another file moved into its place: file_recheck error 116, a save error 116, the outside change whole
----
end
case file: a permission change that comes with any other change is not adopted: file_recheck reports the new bits and gives 116, and a save is still refused
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library, with mode 644 (420).
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    do linux_close(fd)
    return linux_syscall6(90, buffer_address(linux_cstring(path)), 420, 0, 0, 0, 0)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- Linux's chmod, 90, to mode 600 (384): the group and the others lose their reading.
func make_private(path):
    return linux_syscall6(90, buffer_address(linux_cstring(path)), 384, 0, 0, 0, 0)
end

-- The file at path given the access and modification times in times (Linux's utimensat, 280,
-- from the current folder, -100).
func date(path, times):
    return linux_syscall6(280, 0 - 100, buffer_address(linux_cstring(path)), buffer_address(times), 0, 0, 0)
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

-- What file_recheck gives and the mode it found, what a save through f then gives, and whether
-- the file at path is still as the other program left it.
func after(out, what, f, path, outside):
    do text_add(out, what)
    do text_add(out, ": file_recheck ")
    do result(out, file_recheck(f))
    do text_add(out, " and mode ")
    do text_add_whole(out, f.state.mode / 64)
    do text_add_whole(out, (f.state.mode / 8) % 8)
    do text_add_whole(out, f.state.mode % 8)
    do text_add(out, ", a save ")
    do result(out, file_save(f, linux_cstring("mine\n"), 5))
    if holds(path, outside): return text_add(out, ", the file as the other program left it\n") end
    return text_add(out, ", the other program's file LOST\n")
end

func main():
    let out = new_buffer()
    -- A time long ago, 1000 seconds, for both of utimensat's times.
    let long_ago = linux_buffer(32)
    do linux_put64(long_ago, 0, 1000)
    do linux_put64(long_ago, 16, 1000)
    -- The text and the permission.
    do write_file("pc-text.txt", "old\n")
    let a = file_open("pc-text.txt", 64)
    do write_file("pc-text.txt", "changed outside\n")
    do make_private("pc-text.txt")
    do after(out, "with the text", a, "pc-text.txt", "changed outside\n")
    -- A longer text with the old modification time put back (in Linux's stat the time is at 88).
    do write_file("pc-size.txt", "old\n")
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring("pc-size.txt"), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    let b = file_open("pc-size.txt", 64)
    do write_file("pc-size.txt", "changed outside\n")
    let back = linux_buffer(32)
    do linux_copy(back, 0, stat, 88, 16)
    do linux_copy(back, 16, stat, 88, 16)
    do date("pc-size.txt", back)
    do make_private("pc-size.txt")
    do after(out, "with the size, the time put back", b, "pc-size.txt", "changed outside\n")
    -- The same bytes with another modification time.
    do write_file("pc-time.txt", "old\n")
    let c = file_open("pc-time.txt", 64)
    do date("pc-time.txt", long_ago)
    do make_private("pc-time.txt")
    do after(out, "with the time alone", c, "pc-time.txt", "old\n")
    -- Another file of the same size and the same time, moved into the document's place (rename, 82).
    do write_file("pc-file.txt", "old\n")
    do date("pc-file.txt", long_ago)
    let d = file_open("pc-file.txt", 64)
    do write_file("pc-other.txt", "NEW\n")
    do date("pc-other.txt", long_ago)
    do make_private("pc-other.txt")
    do linux_syscall6(82, buffer_address(linux_cstring("pc-other.txt")), buffer_address(linux_cstring("pc-file.txt")), 0, 0, 0, 0)
    do after(out, "with the file itself", d, "pc-file.txt", "NEW\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
with the text: file_recheck error 116 and mode 600, a save error 116, the file as the other program left it
with the size, the time put back: file_recheck error 116 and mode 600, a save error 116, the file as the other program left it
with the time alone: file_recheck error 116 and mode 600, a save error 116, the file as the other program left it
with the file itself: file_recheck error 116 and mode 600, a save error 116, the file as the other program left it
----
end
