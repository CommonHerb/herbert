case child: a program is run to its end in the folder given, with its arguments, its input from a file and no environment; its status, its output and its peak memory come back
libs linux text child
source until ----
-- This program runs itself: with an argument it is the program being run.
func say_ran(ran):
    let line = new_buffer()
    do text_add(line, "how it ended: ")
    do text_add_whole(line, ran.0)
    do text_add(line, " ")
    do text_add_whole(line, ran.1)
    do text_add(line, "\n")
    do flogger(freeze(line))
    return 0
end

func show(path):
    let f = linux_read_file(path, 4096)
    do flogger(text_string(f.1, 0, f.2))
    return 0
end

-- What the program being run reports, for the one that runs it to print.
func report(args, input):
    let line = new_buffer()
    do text_add(line, "arguments: ")
    do text_add_whole(line, linux_argument_count(args))
    do text_add(line, " [")
    do text_add(line, linux_argument(args, 1))
    do text_add(line, "] [")
    do text_add(line, linux_argument(args, 2))
    do text_add(line, "]\ninput: ")
    do text_add(line, input)
    do text_add(line, "environment bytes: ")
    do text_add_whole(line, linux_read_file("/proc/self/environ", 4096).2)
    let where = linux_buffer(4096)
    let n = linux_syscall6(79, buffer_address(where), 4096, 0, 0, 0, 0)
    do text_add(line, "\nits folder's name: ")
    let from = n - 1
    while from > 0 and buffer_get(where, from - 1) != 47: from = from - 1 end
    do text_add_span(line, where, from, n - 1 - from)
    do text_add(line, "\n")
    do flogger(freeze(line))
    return 0
end

func main():
    let input = stdin_read()
    let args = linux_arguments()
    let role = linux_argument(args, 1)
    if equal(role, "report"):
        do report(args, input.1)
        do process_exit(5)
    end
    if equal(role, "fill"):
        let big = new_buffer()
        do buffer_fill(big, 67108864, 1)
        do process_exit(0)
    end
    if equal(role, "say"):
        do flogger("said by the program being run\n")
        do stderr_write("and this to its error output\n")
        do process_exit(0)
    end
    do linux_syscall6(83, buffer_address(linux_cstring("ch-folder")), 448, 0, 0, 0, 0)
    let fd = linux_open(linux_cstring("ch-folder/in.txt"), 577, 420)
    do linux_write(fd, linux_cstring("from a file\n"), 0, 12)
    do linux_close(fd)
    let c = child_new()
    let program = linux_cstring("../a.out")
    let argv = child_arguments(3)
    do child_argument(argv, 0, program)
    do child_argument(argv, 1, linux_cstring("report"))
    do child_argument(argv, 2, linux_cstring("two words"))
    do say_ran(child_run(c, linux_cstring("ch-folder"), program, argv, linux_cstring("in.txt"), linux_cstring("out.txt"), c.none, 20))
    do show("ch-folder/out.txt")
    let here = linux_cstring("./a.out")
    let filling = child_arguments(2)
    do child_argument(filling, 0, here)
    do child_argument(filling, 1, linux_cstring("fill"))
    do say_ran(child_run(c, c.none, here, filling, c.none, c.none, c.none, 20))
    if c.peak >= 61440 and c.peak < 131072:
        do flogger("a program that fills 64 MiB had between 60 and 128 MiB in use at its peak\n")
    end
    do flogger("with no file given for its output:\n")
    let again = child_arguments(2)
    do child_argument(again, 0, here)
    do child_argument(again, 1, linux_cstring("say"))
    do say_ran(child_run(c, c.none, here, again, c.none, c.none, linux_cstring("ch-errors.txt"), 20))
    do show("ch-errors.txt")
    do process_exit(0)
    return 0
end
----
stdout until ----
how it ended: 0 5
arguments: 3 [report] [two words]
input: from a file
environment bytes: 0
its folder's name: ch-folder
how it ended: 0 0
a program that fills 64 MiB had between 60 and 128 MiB in use at its peak
with no file given for its output:
said by the program being run
how it ended: 0 0
and this to its error output
----
end
case child: a signal, the time limit, a program that is not there and a folder or an input that is not there each have their own answer
libs linux text child
source until ----
func say(what, ran):
    let line = new_buffer()
    do text_add(line, what)
    do text_add_whole(line, ran.0)
    do text_add(line, " ")
    do text_add_whole(line, ran.1)
    do text_add(line, "\n")
    do flogger(freeze(line))
    return 0
end

func forever():
    let i = 0
    while i < 1:
        i = 0
    end
    return i
end

func main():
    let args = linux_arguments()
    let role = linux_argument(args, 1)
    if equal(role, "signal"):
        do linux_syscall6(62, linux_syscall6(39, 0, 0, 0, 0, 0, 0), 15, 0, 0, 0, 0)
    end
    if equal(role, "forever"):
        do forever()
    end
    let c = child_new()
    let here = linux_cstring("./a.out")
    let argv = child_arguments(2)
    do child_argument(argv, 0, here)
    do child_argument(argv, 1, linux_cstring("signal"))
    do say("stopped by a signal: ", child_run(c, c.none, here, argv, c.none, c.none, c.none, 20))
    do child_argument(argv, 1, linux_cstring("forever"))
    do say("past its time limit of a second: ", child_run(c, c.none, here, argv, c.none, c.none, c.none, 1))
    let missing = linux_cstring("./ch-no-such-program")
    do child_argument(argv, 0, missing)
    do say("a program that is not there: ", child_run(c, c.none, missing, argv, c.none, c.none, c.none, 20))
    do child_argument(argv, 0, here)
    do child_argument(argv, 1, linux_cstring("signal"))
    do say("a folder that is not there: ", child_run(c, linux_cstring("ch-no-such-folder"), here, argv, c.none, c.none, c.none, 20))
    do say("an input file that is not there: ", child_run(c, c.none, here, argv, linux_cstring("ch-no-such-input"), c.none, c.none, 20))
    do process_exit(0)
    return 0
end
