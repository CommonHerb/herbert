end
case text buffer: through random edits, undo, redo, reloads and moves by screen rows on wrapped lines of accents, CJK and emoji, the cursor stays on the start of a character and the text stays UTF-8
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
ref record Dice:
    seed: int
    rolls: int
end

-- A number from 0 to n - 1, the same sequence on every run.
func roll(d, n):
    d.seed = d.seed * 6364136223846793005 + 1442695040888963407
    d.rolls = d.rolls + 1
    return (d.seed >> 33) % n
end

-- Letters, a space, a tab, a newline, é, 漢, a combining acute that joins the character before
-- it, and an emoji.
func scalar(k):
    if k < 6: return 'a' + k end
    if k == 6: return ' ' end
    if k == 7: return 9 end
    if k == 8: return 10 end
    if k == 9: return 233 end
    if k == 10: return 28450 end
    if k == 11: return 769 end
    return 128512
end

-- 1 when the cursor is past the end of the text or on a byte that continues a character (10xxxxxx),
-- or the text does not decode as UTF-8 to its end.
func wrong(t):
    let p = text_cursor(t)
    if p > text_length(t): return 1 end
    if p < text_length(t) and (buffer_get(t.bytes, p) & 192) == 128: return 1 end
    p = 0
    while p < text_length(t):
        let d = utf8_decode(t.bytes, p, text_length(t))
        if linux_error(d.0): return 1 end
        p = d.1
    end
    return 0
end

-- One edit or move: a character typed, backspace, delete, undo, redo, the next two characters
-- replaced by two typed, the cursor put at a random place, or Up, Down or End by screen rows.
-- Now and then the text first loaded is loaded again.
func step(t, d, scratch, first, count):
    let what = roll(d, 24)
    if what < 8: return text_insert(t, scalar(roll(d, 13))) end
    if what < 10: return text_backspace(t) end
    if what < 12: return text_delete(t) end
    if what < 14: return text_undo(t) end
    if what < 15: return text_redo(t) end
    if what < 16:
        let n = utf8_store(scratch, 0, scalar(roll(d, 13)))
        n = utf8_store(scratch, n, scalar(roll(d, 13)))
        let from = text_cursor(t)
        return text_replace(t, from, text_next(t, text_next(t, from)), scratch, 0, n)
    end
    if what < 17: return text_seek(t, roll(d, text_length(t) + 1)) end
    if what < 19: return text_wrap_vertical(t, true, 1 + roll(d, 3)) end
    if what < 21: return text_wrap_vertical(t, false, 1 + roll(d, 3)) end
    if what < 22: return text_wrap_vertical(t, roll(d, 2) == 0, 20) end
    if what < 23: return text_seek(t, text_wrap_last(t, text_wrap_start(t, text_cursor(t)))) end
    return text_load(t, first, count)
end

func main():
    let d = Dice(31, 0)
    let scratch = linux_buffer(8)
    let first = linux_buffer(512)
    let wrongs = 0
    let run = 0
    while run < 160:
        -- Forty characters typed make the first text of this run; then rows 5 to 13 columns wide,
        -- every first, second or third row remembered.
        let t = text_buffer(512)
        let i = 0
        while i < 40:
            do text_insert(t, scalar(roll(d, 13)))
            i = i + 1
        end
        let count = text_length(t)
        do linux_copy(first, 0, t.bytes, 0, count)
        do text_load(t, first, count)
        do text_wrap(t, 5 + roll(d, 9), 1 + roll(d, 3))
        i = 0
        while i < 300:
            do step(t, d, scratch, first, count)
            i = i + 1
            -- The first step that goes wrong ends the run: an edit at a place inside a character
            -- could go on wrong in any way.
            if wrong(t) == 1:
                wrongs = wrongs + 1
                i = 300
            end
        end
        run = run + 1
    end
    let out = new_buffer()
    do text_add_whole(out, wrongs)
    do text_add(out, " of 160 runs of 300 steps left the cursor inside a character or the text not UTF-8\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0 of 160 runs of 300 steps left the cursor inside a character or the text not UTF-8
----
end
case file, text buffer and recovery: a long session at the full capacity, typing, editing, finding, checkpointing and saving, takes no memory and no descriptor round after round, and its copies are the document's bytes
libs linux text utf8 unicode_tables unicode_grapheme file_io text_buffer session_recovery
source until ----
-- What one look at this program's descriptors needs, made before the session starts: dents holds
-- the listing of /proc/self/fd.
record Look:
    dents: buffer
    fd_path: buffer
end

-- How many descriptors this program has open: the names in /proc/self/fd (getdents64, 217). A folder that cannot
-- be opened ends the case with a message, so no count is ever taken for 0.
func descriptors(k):
    let fd = linux_syscall6(2, buffer_address(k.fd_path), 589824, 0, 0, 0, 0)
    if linux_error(fd): return linux_die("the case could not list its descriptors in /proc/self/fd\n") end
    let count = 0
    let got = linux_syscall6(217, fd, buffer_address(k.dents), buffer_length(k.dents), 0, 0, 0)
    while got > 0 and not linux_error(got):
        let p = 0
        while p < got:
            count = count + 1
            p = p + linux_u16(k.dents, p + 16)
        end
        got = linux_syscall6(217, fd, buffer_address(k.dents), buffer_length(k.dents), 0, 0, 0)
    end
    do linux_close(fd)
    return count
end

-- Where the next buffer would be made: the heap's high mark. A program's heap is one reservation
-- made when it starts (docs/LANGUAGE.md), so this mark sees every byte the libraries take, and the
-- process's mapped size could not show more.
func heap_mark(): return buffer_address(new_buffer()) end

-- One round as Notes goes: a character deleted, a letter typed and backspaced, all three undone,
-- the delete redone and undone, a search, a checkpoint and a save of the whole text. How many of
-- those did not give what they should.
func round(f, r, t, query):
    let missed = 0
    do text_seek(t, 0)
    if text_delete(t) != 1 or text_insert(t, 'A') != 1 or text_backspace(t) != 1 or text_undo(t) != 1 or text_undo(t) != 1 or text_undo(t) != 1 or text_redo(t) != 1 or text_undo(t) != 1: missed = missed + 1 end
    if text_find(t, query, 1, 0, false) != 0: missed = missed + 1 end
    let bytes = text_file_bytes(t)
    if recovery_save(r, f, bytes, text_file_length(t)) != 0: missed = missed + 1 end
    if file_save(f, bytes, text_file_length(t)) != 0: missed = missed + 1 end
    return missed
end

func rounds(f, r, t, query, n):
    let missed = 0
    while n != 0:
        missed = missed + round(f, r, t, query)
        n = n - 1
    end
    return missed
end

-- Whether count bytes of b are those of doc.
func full(b, count, doc):
    if count != 65536: return false end
    let i = 0
    while i < 65536:
        if buffer_get(b, i) != buffer_get(doc, i): return false end
        i = i + 1
    end
    return true
end

func main():
    do linux_syscall6(83, buffer_address(linux_cstring("long6.d")), 448, 0, 0, 0, 0)
    -- 1024 lines of 62 A's and CR LF: 65536 bytes, the capacity.
    let doc = new_buffer()
    let line = 0
    while line < 1024:
        let i = 0
        while i < 62:
            do append(doc, 'A')
            i = i + 1
        end
        do append(doc, 13)
        do append(doc, 10)
        line = line + 1
    end
    let fd = linux_open(linux_cstring("long6.d/doc.txt"), 577, 420)
    do linux_write(fd, doc, 0, 65536)
    do linux_close(fd)
    let f = file_open("long6.d/doc.txt", 65536)
    let r = recovery_new(65536)
    let t = text_buffer(65536)
    do text_load(t, f.bytes, file_count(f))
    let query = linux_cstring("A")
    let k = Look(linux_buffer(8192), linux_cstring("/proc/self/fd"))
    let missed = rounds(f, r, t, query, 100)
    let open = descriptors(k)
    let m0 = heap_mark()
    let m1 = heap_mark()
    missed = missed + rounds(f, r, t, query, 300)
    let m2 = heap_mark()
    let out = new_buffer()
    do text_add_whole(out, missed)
    do text_add(out, " steps of 400 rounds did not give what they should\nheap taken by the last 300 rounds: ")
    do text_add_whole(out, (m2 - m1) - (m1 - m0))
    if descriptors(k) == open: do text_add(out, "\nthe same descriptors open") end
    let s = file_scan_new()
    let g = file_new(65536)
    if file_scan(f, s, ".herbert-notes-") == 1 and file_load_inside(g, f, file_scan_name(s), "recovery.txt") == 0 and full(g.bytes, file_count(g), doc): do text_add(out, "\nthe last checkpoint is the 65536 bytes") end
    let back = linux_read_file("long6.d/doc.txt", 65536)
    if back.0 == 0 and full(back.1, back.2, doc): do text_add(out, "\nthe document is the 65536 bytes") end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0 steps of 400 rounds did not give what they should
heap taken by the last 300 rounds: 0
the same descriptors open
the last checkpoint is the 65536 bytes
the document is the 65536 bytes
----
limit 60
end
case text: the readers and the fixed-buffer writers take no memory, call after call
libs linux text
source until ----
-- Where the next buffer would be made: the heap's high mark.
func heap_mark(): return buffer_address(new_buffer()) end

-- Every reader and fixed-buffer writer once, on the line in b and into out: a sum of what they
-- gave, so that none is left out.
func round(b, s, out, n):
    let stop = buffer_length(b)
    let sum = 0
    let field = text_field(b, 0, stop)
    sum = sum + field.1 + text_skip(b, field.1, stop)
    let w = text_whole(b, text_skip(b, field.1, stop), stop)
    sum = sum + w.1 + w.2
    let strict = text_whole_strict(b, 7, stop)
    if strict.0: sum = sum + 1 end
    let sw = text_string_whole(s, 0, length(s))
    let ss = text_string_whole_strict(s, 0, length(s))
    sum = sum + sw.1 + ss.1
    if text_starts(b, 0, stop, "up") and text_is(b, 0, 2, "up") and text_digit(buffer_get(b, 3)) and text_blank(buffer_get(b, 2)) and text_fits(n, 5): sum = sum + 1 end
    let at = text_put(out, 0, "up ")
    at = text_put_whole(out, at, n)
    at = text_put_padded(out, at, n % 100, 3)
    at = text_put_tenths(out, at, n, 1024)
    return sum + at
end

func main():
    let b = linux_cstring("up 12345 07 ok")
    let out = linux_buffer(64)
    let total = 0
    let n = 0
    while n < 1000:
        total = total + round(b, "4096", out, n)
        n = n + 1
    end
    let m0 = heap_mark()
    let m1 = heap_mark()
    while n < 101000:
        total = total + round(b, "4096", out, n)
        n = n + 1
    end
    let m2 = heap_mark()
    let report = new_buffer()
    do text_add(report, "heap taken by 100000 rounds: ")
    do text_add_whole(report, (m2 - m1) - (m1 - m0))
    if total > 0: do text_add(report, "\nevery round worked") end
    do text_add(report, "\n")
    do flogger(freeze(report))
    do process_exit(0)
    return 0
end
----
stdout until ----
heap taken by 100000 rounds: 0
every round worked
----
end
case utf8: a scalar at each edge of a byte count is stored as RFC 3629's own bytes and no others change, and those bytes decode to it
libs linux text utf8
source until ----
-- The bytes h names in hex, two digits each with a space after.
func hex(h):
    let b = new_buffer()
    let i = 0
    while i + 1 < length(h):
        let hi = index(h, i) - 48
        if hi > 9: hi = hi - 7 end
        let lo = index(h, i + 1) - 48
        if lo > 9: lo = lo - 7 end
        do append(b, hi * 16 + lo)
        i = i + 3
    end
    return b
end

func hex_byte(out, v):
    let digits = "0123456789ABCDEF"
    do append(out, index(digits, v / 16))
    do append(out, index(digits, v % 16))
    return 0
end

-- cp stored at 1 in sixteen bytes of Z: what utf8_store gives and all sixteen bytes, a Z shown as
-- Z. Then the bytes h decoded from 0 to their end: the scalar and the place after it.
func check(out, cp, h):
    let b = new_buffer()
    do buffer_fill(b, 16, 'Z')
    do text_add_whole(out, cp)
    do text_add(out, ": next ")
    do text_add_whole(out, utf8_store(b, 1, cp))
    do text_add(out, " [")
    let i = 0
    while i < 16:
        if i > 0: do text_add(out, " ") end
        if buffer_get(b, i) == 'Z': do text_add(out, "Z") else: do hex_byte(out, buffer_get(b, i)) end
        i = i + 1
    end
    let bytes = hex(h)
    let d = utf8_decode(bytes, 0, buffer_length(bytes))
    do text_add(out, "], ")
    do text_add(out, h)
    do text_add(out, "decodes to ")
    do text_add_whole(out, d.0)
    do text_add(out, ", next ")
    do text_add_whole(out, d.1)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do check(out, 128, "C2 80 ")
    do check(out, 2047, "DF BF ")
    do check(out, 2048, "E0 A0 80 ")
    do check(out, 55295, "ED 9F BF ")
    do check(out, 57344, "EE 80 80 ")
    do check(out, 65535, "EF BF BF ")
    do check(out, 65536, "F0 90 80 80 ")
    do check(out, 1114111, "F4 8F BF BF ")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
128: next 3 [Z C2 80 Z Z Z Z Z Z Z Z Z Z Z Z Z], C2 80 decodes to 128, next 2
2047: next 3 [Z DF BF Z Z Z Z Z Z Z Z Z Z Z Z Z], DF BF decodes to 2047, next 2
2048: next 4 [Z E0 A0 80 Z Z Z Z Z Z Z Z Z Z Z Z], E0 A0 80 decodes to 2048, next 3
55295: next 4 [Z ED 9F BF Z Z Z Z Z Z Z Z Z Z Z Z], ED 9F BF decodes to 55295, next 3
57344: next 4 [Z EE 80 80 Z Z Z Z Z Z Z Z Z Z Z Z], EE 80 80 decodes to 57344, next 3
65535: next 4 [Z EF BF BF Z Z Z Z Z Z Z Z Z Z Z Z], EF BF BF decodes to 65535, next 3
65536: next 5 [Z F0 90 80 80 Z Z Z Z Z Z Z Z Z Z Z], F0 90 80 80 decodes to 65536, next 4
1114111: next 5 [Z F4 8F BF BF Z Z Z Z Z Z Z Z Z Z Z], F4 8F BF BF decodes to 1114111, next 4
----
end
case text buffer: backspace, delete and Enter in a CRLF text take and give whole characters and whole CR LF newlines, a surrogate is refused, and undoing everything gives back the loaded bytes
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- The bytes of s, then the bytes h names in hex, two digits each with a space after.
func bytes(s, h):
    let b = new_buffer()
    do text_add(b, s)
    let i = 0
    while i + 1 < length(h):
        let hi = index(h, i) - 48
        if hi > 9: hi = hi - 7 end
        let lo = index(h, i + 1) - 48
        if lo > 9: lo = lo - 7 end
        do append(b, hi * 16 + lo)
        i = i + 3
    end
    return b
end

-- Whether the file's bytes decode as UTF-8 to their end with every CR followed by LF and every LF
-- after a CR.
func valid(t):
    let b = text_file_bytes(t)
    let n = text_file_length(t)
    let p = 0
    while p < n:
        let d = utf8_decode(b, p, n)
        if linux_error(d.0): return false end
        if d.0 == 13 and (p + 1 == n or buffer_get(b, p + 1) != 10): return false end
        if d.0 == 10 and (p == 0 or buffer_get(b, p - 1) != 13): return false end
        p = d.1
    end
    return true
end

-- What an edit gave, the file's bytes (CR as \r, LF as \n, any byte past ~ by its number), and
-- whether they are valid.
func step(out, what, r, t):
    do text_add(out, what)
    do text_add(out, ": ")
    do text_add_whole(out, r)
    do text_add(out, " [")
    let b = text_file_bytes(t)
    let i = 0
    while i < text_file_length(t):
        let ch = buffer_get(b, i)
        if ch == 13: do text_add(out, "\\r") elif ch == 10: do text_add(out, "\\n") elif ch > 126: do text_add(out, "<") do text_add_whole(out, ch) do text_add(out, ">") else: do append(out, ch) end
        i = i + 1
    end
    if valid(t): return text_add(out, "] valid\n") end
    return text_add(out, "] NOT valid\n")
end

func main():
    let out = new_buffer()
    -- A, é, an em dash, B, CR LF, x.
    let loaded = bytes("A", "C3 A9 E2 80 94 42 0D 0A 78 ")
    let t = text_buffer(64)
    do text_load(t, loaded, 10)
    do text_seek(t, 3)
    do step(out, "backspace after é", text_backspace(t), t)
    do text_seek(t, text_find(t, bytes("", "E2 80 94 "), 3, 0, false))
    do step(out, "the dash found, delete", text_delete(t), t)
    do text_seek(t, 2)
    do step(out, "delete before the newline", text_delete(t), t)
    do text_seek(t, text_length(t))
    do step(out, "Enter at the end", text_insert(t, 10), t)
    do step(out, "a surrogate, 55296", text_insert(t, 55296), t)
    let undone = 0
    while text_undo(t) == 1: undone = undone + 1 end
    do text_add(out, "undone ")
    do text_add_whole(out, undone)
    if text_file_length(t) == 10 and text_is(text_file_bytes(t), 0, 10, freeze(loaded)): do text_add(out, " times, the bytes loaded") end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
backspace after é: 1 [A<226><128><148>B\r\nx] valid
the dash found, delete: 1 [AB\r\nx] valid
delete before the newline: 1 [ABx] valid
Enter at the end: 1 [ABx\r\n] valid
a surrogate, 55296: 0 [ABx\r\n] valid
undone 4 times, the bytes loaded
----
end
case file: beside earlier sessions' folders of a long name, an unreadable copy and a copy over the capacity, and a link and a file wearing the name, file_scan and file_load_inside give their answers and change nothing
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

func join(a, b):
    let out = new_buffer()
    do text_add(out, a)
    do text_add(out, b)
    return freeze(out)
end

-- Linux's mkdir (83).
func make_folder(path):
    return linux_syscall6(83, buffer_address(linux_cstring(path)), 448, 0, 0, 0, 0)
end

-- What is at path given the modification time seconds (Linux's utimensat, 280, from the current
-- folder, -100).
func set_time(path, seconds):
    let times = linux_buffer(32)
    do linux_put64(times, 0, seconds)
    do linux_put64(times, 16, seconds)
    return linux_syscall6(280, 0 - 100, buffer_address(linux_cstring(path)), buffer_address(times), 0, 0, 0)
end

-- The type and permission bits of what is at path, not followed (Linux's newfstatat, 262).
func mode(path):
    let stat = linux_buffer(144)
    do linux_syscall6(262, 0 - 100, buffer_address(linux_cstring(path)), buffer_address(stat), 256, 0, 0)
    return linux_u32(stat, 24)
end

-- file_scan's count and the length of the newest folder's name, then file_load_inside of its
-- recovery.txt.
func look(out, f, s, g):
    do text_add_whole(out, file_scan(f, s, ".herbert-notes-"))
    do text_add(out, " folders, the newest named in ")
    do text_add_whole(out, linux_nul_end(file_scan_name(s), 0, 256))
    do text_add(out, " bytes, its copy: ")
    let r = file_load_inside(g, f, file_scan_name(s), "recovery.txt")
    if linux_error(r):
        do text_add(out, "error ")
        do text_add_whole(out, 0 - r)
    else:
        do text_add_whole(out, r)
        if text_is(g.bytes, 0, file_count(g), "long name\n"): do text_add(out, ", its bytes") end
    end
    return text_add(out, "\n")
end

func main():
    do make_folder("early6.d")
    do write_file("early6.d/doc.txt", "alpha\n")
    -- .herbert-notes- and 200 n's: a name of 215 bytes.
    let long = new_buffer()
    do text_add(long, "early6.d/.herbert-notes-")
    do buffer_fill(long, 200, 'n')
    let folder = freeze(long)
    do make_folder(folder)
    do write_file(join(folder, "/recovery.txt"), "long name\n")
    -- A copy nobody may read (mode 000), and a copy one byte over the capacity of 64.
    do make_folder("early6.d/.herbert-notes-1-2")
    do write_file("early6.d/.herbert-notes-1-2/recovery.txt", "secret\n")
    do linux_syscall6(90, buffer_address(linux_cstring("early6.d/.herbert-notes-1-2/recovery.txt")), 0, 0, 0, 0, 0)
    do make_folder("early6.d/.herbert-notes-1-3")
    let big = new_buffer()
    do buffer_fill(big, 65, 'x')
    do write_file("early6.d/.herbert-notes-1-3/recovery.txt", freeze(big))
    -- A symbolic link to the long-named folder, and a plain file, wearing the name (symlink, 88).
    do linux_syscall6(88, buffer_address(linux_cstring(text_string(long, 9, 224))), buffer_address(linux_cstring("early6.d/.herbert-notes-99-9")), 0, 0, 0, 0)
    do write_file("early6.d/.herbert-notes-98-9", "")
    do set_time(folder, 3000)
    do set_time("early6.d/.herbert-notes-1-2", 2000)
    do set_time("early6.d/.herbert-notes-1-3", 1000)
    let f = file_open("early6.d/doc.txt", 64)
    let s = file_scan_new()
    let g = file_new(64)
    let out = new_buffer()
    do look(out, f, s, g)
    do set_time("early6.d/.herbert-notes-1-2", 5000)
    do look(out, f, s, g)
    do set_time("early6.d/.herbert-notes-1-3", 6000)
    do look(out, f, s, g)
    if holds("early6.d/doc.txt", "alpha\n"): do text_add(out, "the document is as it was\n") end
    if holds(join(folder, "/recovery.txt"), "long name\n") and holds("early6.d/.herbert-notes-1-3/recovery.txt", freeze(big)): do text_add(out, "the copies are as they were\n") end
    if mode("early6.d/.herbert-notes-1-2/recovery.txt") == 32768:
        do linux_syscall6(90, buffer_address(linux_cstring("early6.d/.herbert-notes-1-2/recovery.txt")), 384, 0, 0, 0, 0)
        if holds("early6.d/.herbert-notes-1-2/recovery.txt", "secret\n"): do text_add(out, "the unreadable copy is as it was, still mode 000\n") end
    end
    if (mode("early6.d/.herbert-notes-99-9") & 61440) == 40960 and (mode("early6.d/.herbert-notes-98-9") & 61440) == 32768: do text_add(out, "the link is a link and the file a file\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
3 folders, the newest named in 215 bytes, its copy: 0, its bytes
3 folders, the newest named in 18 bytes, its copy: error 13
3 folders, the newest named in 18 bytes, its copy: error 27
the document is as it was
the copies are as they were
the unreadable copy is as it was, still mode 000
the link is a link and the file a file
----
end
case text buffer: a whole text of 60002 bytes replaced by 60001 in one step, as Notes pastes over everything, is one undo step: undo gives back the 60002 bytes exactly and redo the 60001
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- Whether the text is exactly count bytes of b.
func is(t, b, count):
    if text_length(t) != count: return false end
    let i = 0
    while i < count:
        if buffer_get(t.bytes, i) != buffer_get(b, i): return false end
        i = i + 1
    end
    return true
end

func show(out, what, r, t, old, new):
    do text_add(out, what)
    do text_add(out, ": ")
    do text_add_whole(out, r)
    do text_add(out, ", ")
    do text_add_whole(out, text_length(t))
    do text_add(out, " bytes")
    if is(t, old, 60002): do text_add(out, ", the text before the paste") end
    if is(t, new, 60001): do text_add(out, ", the text pasted") end
    return text_add(out, "\n")
end

func main():
    -- 30000 X's, a newline and 30000 Y's; then the same with ! typed at the end.
    let new = new_buffer()
    do buffer_fill(new, 30000, 'X')
    do append(new, 10)
    do buffer_fill(new, 30000, 'Y')
    let old = new_buffer()
    do text_add_span(old, new, 0, 60001)
    do append(old, '!')
    -- Notes' capacity and history: room for one replace of the whole text.
    let t = text_buffer_history(65536, 131072)
    do text_load(t, old, 60002)
    let out = new_buffer()
    do show(out, "everything replaced", text_replace(t, 0, 60002, new, 0, 60001), t, old, new)
    do show(out, "undo", text_undo(t), t, old, new)
    do show(out, "redo", text_redo(t), t, old, new)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
everything replaced: 1, 60001 bytes, the text pasted
undo: 1, 60002 bytes, the text before the paste
redo: 1, 60001 bytes, the text pasted
----
end
