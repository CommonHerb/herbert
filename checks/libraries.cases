func starts(out, t):
    let p = 0
    while p <= text_length(t):
        do text_add(out, " ")
        do text_add_whole(out, text_wrap_start(t, p))
        p = p + 1
    end
    return text_add(out, "\n")
end

func main():
    -- abcdefghij from 0, its newline at 10, xyz from 11, the end at 14: the row start of every place.
    let t = text_buffer(64)
    do text_load(t, linux_cstring("abcdefghij\nxyz"), 14)
    let out = new_buffer()
    do text_add(out, "no width set:")
    do starts(out, t)
    do text_wrap(t, 4, 32)
    do text_add(out, "four columns:")
    do starts(out, t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
