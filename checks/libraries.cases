libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func main():
    -- One line of 10000 letters, ten columns wide: a thousand rows, every 32nd remembered.
    let t = text_buffer(16384)
    let letters = new_buffer()
    do buffer_fill(letters, 10000, 'a')
    do text_load(t, letters, 10000)
    do text_wrap(t, 10, 32)
    let out = new_buffer()
    let before = text_wrap_walked(t)
    do text_add(out, "9995 is on the row at ")
    do text_add_whole(out, text_wrap_start(t, 9995))
    do text_add(out, ", found by walking ")
    do text_add_whole(out, text_wrap_walked(t) - before)
    do text_add(out, " rows\n")
    before = text_wrap_walked(t)
    do text_add(out, "9985 is on the row at ")
    do text_add_whole(out, text_wrap_start(t, 9985))
    if text_wrap_walked(t) - before <= 32: do text_add(out, ", found by walking 32 rows or fewer\n") else: do text_add(out, ", found by walking MORE than 32 rows\n") end
    before = text_wrap_walked(t)
    do text_add(out, "15 is on the row at ")
    do text_add_whole(out, text_wrap_start(t, 15))
    if text_wrap_walked(t) - before <= 32: do text_add(out, ", found by walking 32 rows or fewer\n") else: do text_add(out, ", found by walking MORE than 32 rows\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
9995 is on the row at 9990, found by walking 1000 rows
9985 is on the row at 9980, found by walking 32 rows or fewer
15 is on the row at 10, found by walking 32 rows or fewer
----
end
case text buffer: undo and redo are exact when the history's bytes wrap round the end of their storage
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func show(out, t):
    do text_add(out, "[")
    do text_add_span(out, t.bytes, 0, text_length(t))
    do text_add(out, "] cursor ")
    do text_add_whole(out, text_cursor(t))
    return text_add(out, "\n")
end

func main():
    -- Eight bytes of history. Each replace needs six, so each pushes the one before it out, and the
    -- second and third begin where the bytes before them ended: past the middle, round to the start.
    let t = text_buffer_history(64, 8)
    do text_load(t, linux_cstring("abcdefghij"), 10)
    do text_replace(t, 0, 3, linux_cstring("XYZ"), 0, 3)
    do text_replace(t, 3, 6, linux_cstring("UVW"), 0, 3)
    do text_replace(t, 6, 9, linux_cstring("RST"), 0, 3)
    let out = new_buffer()
    do show(out, t)
    do text_add_whole(out, text_undo(t))
    do text_add(out, " ")
    do show(out, t)
    do text_add_whole(out, text_undo(t))
    do text_add(out, " ")
    do show(out, t)
    do text_add_whole(out, text_redo(t))
    do text_add(out, " ")
    do show(out, t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
[XYZUVWRSTj] cursor 9
1 [XYZUVWghij] cursor 6
0 [XYZUVWghij] cursor 6
1 [XYZUVWRSTj] cursor 9
----
end
case text buffer: when the history pushes out half of a replace, the other half goes with it
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- x loaded, replaced by y (two records in the history, undone as one step), then letters typed
-- after it; then everything undone that can be.
func trial(out, letters):
    let t = text_buffer(512)
    do text_load(t, linux_cstring("x"), 1)
    do text_replace(t, 0, 1, linux_cstring("y"), 0, 1)
    let typed = 0
    while typed < letters:
        do text_insert(t, 'a')
        typed = typed + 1
    end
    let undone = 0
    while text_undo(t) == 1: undone = undone + 1 end
    do text_add_whole(out, letters)
    do text_add(out, " letters typed: ")
    do text_add_whole(out, undone)
    do text_add(out, " steps undone, left [")
    do text_add_span(out, t.bytes, 0, text_length(t))
    return text_add(out, "]\n")
end

func main():
    let out = new_buffer()
    -- 254 letters fill the 256 records: all is undone, the replace too. One more letter pushes the
    -- replace out, both its records: every letter is undone and y stays.
    do trial(out, 254)
    do trial(out, 255)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
