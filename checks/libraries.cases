case figures: a percent is rounded to the nearest, a half upward, exactly, however large the numbers
libs linux text figures
source until ----
func percent(out, part, whole):
    do text_add_whole(out, part)
    do text_add(out, " of ")
    do text_add_whole(out, whole)
    do text_add(out, ": ")
    do text_add_whole(out, figures_percent(part, whole))
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do percent(out, 0, 7)
    do percent(out, 7, 7)
    do percent(out, 1, 3)
    do percent(out, 2, 3)
    do percent(out, 1, 200)
    do percent(out, 1, 201)
    do percent(out, 199, 200)
    -- Of 2^64 - 1, half a percent is 92233720368547758.075: the whole number under it is under half
    -- a percent, the one over it is over.
    do percent(out, 92233720368547758, 18446744073709551615)
    do percent(out, 92233720368547759, 18446744073709551615)
    do percent(out, 9223372036854775808, 18446744073709551615)
    do percent(out, 18446744073709551615, 18446744073709551615)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
