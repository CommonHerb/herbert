case figures: millidegrees round to whole degrees, a half upward, and a drive's shade follows its warning limit
libs linux text figures
source until ----
func shade(out, what, state, reading, warning):
    let s = figures_shade(state, reading, warning)
    do text_add(out, what)
    if s == 0: return text_add(out, ": green\n") end
    if s == 1: return text_add(out, ": amber\n") end
    if s == 2: return text_add(out, ": red\n") end
    return text_add(out, ": grey\n")
end

func main():
    let out = new_buffer()
    do text_add(out, "35499, 35500, 499 and 0 millidegrees:")
    do text_add(out, " ")
    do text_add_whole(out, figures_degrees(35499))
    do text_add(out, " ")
    do text_add_whole(out, figures_degrees(35500))
    do text_add(out, " ")
    do text_add_whole(out, figures_degrees(499))
    do text_add(out, " ")
    do text_add_whole(out, figures_degrees(0))
    do text_add(out, "\n")
    -- A warning limit of 83.85 degrees; amber begins ten degrees under it, at 73.85.
    do shade(out, "73.849 degrees", 1, 73849, 83850)
    do shade(out, "73.850 degrees", 1, 73850, 83850)
    do shade(out, "83.849 degrees", 1, 83849, 83850)
    do shade(out, "83.850 degrees", 1, 83850, 83850)
    do shade(out, "99 degrees with no limit", 1, 99000, 0)
    do shade(out, "no reading", 2, 50000, 83850)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
