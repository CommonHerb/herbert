func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

-- mkdir (83): a folder called name.
func make(name): return linux_syscall6(83, buffer_address(linux_cstring(name)), 448, 0, 0, 0, 0) end

-- Whether name is a folder: open(2) with O_DIRECTORY (65536) works.
func folder(name):
    let fd = linux_open(linux_cstring(name), 65536, 0)
    if linux_error(fd): return false end
    do linux_close(fd)
    return true
end

func main():
    let out = new_buffer()
    do text_add(out, "mkdir before the filter: ")
    do result(out, make("fault-named-before.d"))
    -- Every mkdir from here gives EROFS (30).
    let f = fault_new()
    do text_add(out, "\nthe rule: ")
    do result(out, fault_fail(f, 83, 30))
    do text_add(out, "\nthe filter: ")
    do result(out, fault_start(fault_ready(f)))
    do text_add(out, "\nmkdir: ")
    do result(out, make("fault-named-after.d"))
    do text_add(out, "\nmkdir again: ")
    do result(out, make("fault-named-after.d"))
    if not folder("fault-named-after.d"): do text_add(out, "\nno folder was made") end
    -- mkdirat (258), the same work under another number, is done.
    do text_add(out, "\nmkdirat: ")
    do result(out, linux_syscall6(258, 0 - 100, buffer_address(linux_cstring("fault-named-other.d")), 448, 0, 0, 0))
    if folder("fault-named-other.d"): do text_add(out, ", and its folder is there") end
    -- So are rmdir (84) and a file written and read back.
    do text_add(out, "\nrmdir: ")
    do result(out, linux_syscall6(84, buffer_address(linux_cstring("fault-named-before.d")), 0, 0, 0, 0, 0))
    let fd = linux_open(linux_cstring("fault-named.txt"), 577, 420)
    do linux_write(fd, linux_cstring("kept\n"), 0, 5)
    do linux_close(fd)
    let back = linux_read_file("fault-named.txt", 64)
    if back.0 == 0 and text_is(back.1, 0, back.2, "kept\n"): do text_add(out, "\na file written is read back") end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
