case text buffer: a load refused for mixed newlines or bad bytes keeps the CRLF style, the text, the cursor and undo; a load taken empties undo and redo
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- The bytes of s, then the bytes h names in hex, two digits each with a space after.
func bytes(s, h):
    let b = new_buffer()
    do text_add(b, s)
    let i = 0
    while i + 1 < length(h):
        let hi = index(h, i) - 48
        if hi > 9: hi = hi - 7 end
        let lo = index(h, i + 1) - 48
        if lo > 9: lo = lo - 7 end
        do append(b, hi * 16 + lo)
        i = i + 3
    end
    return b
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

-- The style, the file's bytes (CR as \r, LF as \n, any byte past ~ in hex) and the cursor.
func show(out, t):
    if text_crlf(t): do text_add(out, " CRLF [") else: do text_add(out, " LF [") end
    let b = text_file_bytes(t)
    let i = 0
    while i < text_file_length(t):
        let ch = buffer_get(b, i)
        if ch == 13: do text_add(out, "\\r") elif ch == 10: do text_add(out, "\\n") elif ch > 126: do text_add(out, "<") do text_add_whole(out, ch) do text_add(out, ">") else: do append(out, ch) end
        i = i + 1
    end
    do text_add(out, "] cursor ")
    do text_add_whole(out, text_cursor(t))
    return text_add(out, "\n")
end

func load(out, t, what, b):
    do text_add(out, what)
    do text_add(out, ": ")
    do result(out, text_load(t, b, buffer_length(b)))
    return show(out, t)
end

func main():
    let out = new_buffer()
    -- é café, CR LF; then U+1F600 typed at the end.
    let t = text_buffer(64)
    do text_load(t, bytes("", "C3 A9 20 63 61 66 C3 A9 0D 0A "), 10)
    do text_seek(t, text_length(t))
    do text_insert(t, 128512)
    do text_add(out, "typed")
    do show(out, t)
    do load(out, t, "CRLF then LF", bytes("a\r\nb\n", ""))
    do load(out, t, "a surrogate's bytes", bytes("", "ED A0 80 "))
    do load(out, t, "a C1 control", bytes("", "C3 A9 C2 85 "))
    do text_add(out, "undo: ")
    do text_add_whole(out, text_undo(t))
    do show(out, t)
    -- A text with plain newlines refused a file whose first newline is CR LF.
    let u = text_buffer(64)
    do text_load(u, bytes("a\nb", ""), 3)
    do load(out, u, "plain newlines, then CR LF then LF", bytes("x\r\ny\n", ""))
    -- An edit undone, so that it could be redone, then a load taken.
    do text_insert(u, 'A')
    do text_undo(u)
    do load(out, u, "a load with a redo waiting", bytes("loaded", ""))
    do text_add(out, "undo ")
    do text_add_whole(out, text_undo(u))
    do text_add(out, ", redo ")
    do text_add_whole(out, text_redo(u))
    do show(out, u)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
