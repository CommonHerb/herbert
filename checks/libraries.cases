end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

-- "folder/name".
func within(folder, name):
    let b = new_buffer()
    do text_add(b, folder)
    do text_add(b, "/")
    do text_add(b, name)
    return freeze(b)
end

-- One save of "new\n" over doc.txt, which holds "old\n", in a folder of its
-- own, by a new process given a filter with one rule: kind 1 fails every call
-- of number, kind 2 only those whose argument 0 is above the folder's
-- descriptor (the temporary file's is; the program's own output is not). The
-- new process ends with 100 plus the save's result; the file is looked at
-- here, where there is no filter.
func trial(out, label, folder, kind, number, error):
    do linux_syscall6(83, buffer_address(linux_cstring(folder)), 448, 0, 0, 0, 0)
    let path = within(folder, "doc.txt")
    do write_file(path, "old\n")
    let before = inode(path)
    let status = linux_buffer(8)
    -- fork (57); the new process is killed (9) if this one ends first (prctl
    -- 157, PR_SET_PDEATHSIG 1).
    let pid = linux_syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid == 0:
        do linux_syscall6(157, 1, 9, 0, 0, 0, 0)
        let f = file_open(path, 64)
        let fault = fault_new()
        if kind == 1: do fault_fail(fault, number, error) end
        if kind == 2: do fault_fail_above(fault, number, error, 0, f.state.dirfd) end
        if file_status(f) != 0 or fault_start(fault_ready(fault)) != 0: do process_exit(1) end
        do process_exit(100 + file_save(f, linux_cstring("new\n"), 4))
        return 0
    end
    -- wait4 (61) until it ends.
    let waited = linux_syscall6(61, pid, buffer_address(status), 0, 0, 0, 0)
    while waited == 0 - 4: waited = linux_syscall6(61, pid, buffer_address(status), 0, 0, 0, 0) end
    let st = linux_u32(status, 0)
    do text_add(out, label)
    do text_add(out, ": ")
    if (st & 127) != 0:
        do text_add(out, "stopped by signal ")
        do text_add_whole(out, (st & 127))
    else:
        do result(out, ((st >> 8) & 255) - 100)
    end
    if holds(path, "old\n"): do text_add(out, ", old bytes") end
    if holds(path, "new\n"): do text_add(out, ", new bytes") end
    if inode(path) == before: do text_add(out, ", same file") end
    do text_add(out, ", names ")
    do text_add_whole(out, names(folder, ""))
    do text_add(out, ", temporary ")
    do text_add_whole(out, names(folder, ".herbert-save-"))
    do text_add(out, "\n")
    return 0
end

func main():
    let out = new_buffer()
    -- write 1, fchmod 91, renameat 264, close 3.
    do trial(out, "write ENOSPC", "fault-save-write.d", 2, 1, 28)
    do trial(out, "fchmod EPERM", "fault-save-fchmod.d", 1, 91, 1)
    do trial(out, "renameat EACCES", "fault-save-rename.d", 1, 264, 13)
    do trial(out, "close of the temporary file EIO", "fault-save-close.d", 2, 3, 5)
    do trial(out, "nothing failed", "fault-save-none.d", 0, 0, 0)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
write ENOSPC: error 28, old bytes, same file, names 1, temporary 0
fchmod EPERM: error 1, old bytes, same file, names 1, temporary 0
renameat EACCES: error 13, old bytes, same file, names 1, temporary 0
close of the temporary file EIO: error 5, old bytes, same file, names 1, temporary 0
nothing failed: 0, new bytes, names 1, temporary 0
----
end
