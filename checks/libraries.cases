libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- The row of the letter d, the last byte of the text, and the start of that row.
func last(out, t):
    let d = text_length(t) - 1
    let row = text_row(t, d)
    do text_add(out, "d at ")
    do text_add_whole(out, d)
    do text_add(out, " is on row ")
    do text_add_whole(out, row)
    do text_add(out, ", which starts at ")
    do text_add_whole(out, text_row_offset(t, row))
    return text_add(out, "\n")
end

func main():
    let t = text_buffer(64)
    do text_load(t, linux_cstring("a\nb\nc\nd"), 7)
    let out = new_buffer()
    do last(out, t)
    -- A newline typed at the very start.
    do text_seek(t, 0)
    do text_insert(t, 10)
    do last(out, t)
    -- That newline deleted again.
    do text_seek(t, 0)
    do text_delete(t)
    do last(out, t)
    -- The whole line b, with its newline, cut out.
    do text_replace(t, 2, 4, t.scratch, 0, 0)
    do last(out, t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
d at 6 is on row 3, which starts at 6
d at 7 is on row 4, which starts at 7
d at 6 is on row 3, which starts at 6
d at 4 is on row 2, which starts at 4
----
end
case text buffer: replacing a selection puts the new text in its place, or nothing in its place
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func show(out, t):
    do text_add(out, "[")
    do text_add_span(out, t.bytes, 0, text_length(t))
    do text_add(out, "] cursor ")
    do text_add_whole(out, text_cursor(t))
    return text_add(out, "\n")
end

func main():
    let t = text_buffer(64)
    let out = new_buffer()
    -- "quick" is the selection 4..9.
    do text_load(t, linux_cstring("the quick fox"), 13)
    do text_add_whole(out, text_replace(t, 4, 9, linux_cstring("slow"), 0, 4))
    do text_add(out, " ")
    do show(out, t)
    -- " quick" is 3..9; no bytes take its place.
    do text_load(t, linux_cstring("the quick fox"), 13)
    do text_add_whole(out, text_replace(t, 3, 9, linux_cstring(""), 0, 0))
    do text_add(out, " ")
    do show(out, t)
    -- Nothing selected and nothing to put in: no change, result 0.
    do text_add_whole(out, text_replace(t, 3, 3, linux_cstring(""), 0, 0))
    do text_add(out, " ")
    do show(out, t)
    -- One character typed over the selection "the": Escape is no character to type, J is.
    do text_add_whole(out, text_replace_scalar(t, 0, 3, 27))
    do text_add(out, " ")
    do show(out, t)
    do text_add_whole(out, text_replace_scalar(t, 0, 3, 'J'))
    do text_add(out, " ")
    do show(out, t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
1 [the slow fox] cursor 8
1 [the fox] cursor 3
0 [the fox] cursor 3
0 [the fox] cursor 3
1 [J fox] cursor 1
----
end
