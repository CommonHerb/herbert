    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring("dated.txt"), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    let f = file_open("dated.txt", 64)
    -- Another program writes a longer text and puts the old time back (Linux's utimensat, 280,
    -- from the current folder, -100; its two times are access and modification).
    do write_file("dated.txt", "a longer text from outside\n")
    let times = linux_buffer(32)
    do linux_copy(times, 0, stat, 88, 16)
    do linux_copy(times, 16, stat, 88, 16)
    do linux_syscall6(280, 0 - 100, buffer_address(linux_cstring("dated.txt")), buffer_address(times), 0, 0, 0)
    let saved = file_save(f, linux_cstring("mine\n"), 5)
