-- One rescue copy of the edit, beside doc.txt in a folder of its own, by a new
-- process given a filter: kind 1 fails every fsync (74) with EIO (5), kind 2
-- only the fsync of the document's folder, the File's directory descriptor.
-- The new process ends with 100 plus the copy's result; the folder is looked
-- at here, where there is no filter.
func trial(out, label, folder, kind):
    do linux_syscall6(83, buffer_address(linux_cstring(folder)), 448, 0, 0, 0, 0)
    let path = within(folder, "doc.txt")
    do write_file(path, "original\r\ntext")
    let before = inode(path)
    let status = linux_buffer(8)
    -- fork (57); the new process is killed (9) if this one ends first (prctl
    -- 157, PR_SET_PDEATHSIG 1).
    let pid = linux_syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid == 0:
        do linux_syscall6(157, 1, 9, 0, 0, 0, 0)
