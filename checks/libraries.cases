case text buffer: undoing every edit gives back the loaded text exactly, and redoing them the edited text
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func say(out, flag):
    if flag: return text_add(out, "yes\n") end
    return text_add(out, "NO\n")
end

func main():
    let loaded = "The quick brown fox\njumps over the lazy dog\n"
    let edited = "e very RED brown fox\njumps over the lazy "
    let t = text_buffer(64)
    do text_load(t, linux_cstring(loaded), length(loaded))
    -- Twelve steps: "very " typed after "The " (five), four backspaces at the end, two deletes at the
    -- start, and "quick" (then at 7..12) replaced by "RED" (one).
    do text_seek(t, 4)
    do text_insert(t, 'v')
    do text_insert(t, 'e')
    do text_insert(t, 'r')
    do text_insert(t, 'y')
    do text_insert(t, ' ')
    do text_seek(t, text_length(t))
    do text_backspace(t)
    do text_backspace(t)
    do text_backspace(t)
    do text_backspace(t)
    do text_seek(t, 0)
    do text_delete(t)
    do text_delete(t)
    do text_replace(t, 7, 12, linux_cstring("RED"), 0, 3)
    let out = new_buffer()
    do text_add(out, "edited as meant: ")
    do say(out, text_is(t.bytes, 0, text_length(t), edited))
    let undone = 0
    while text_undo(t) == 1: undone = undone + 1 end
    do text_add_whole(out, undone)
    do text_add(out, " steps undone; the text as loaded: ")
    do say(out, text_is(t.bytes, 0, text_length(t), loaded))
    let redone = 0
    while text_redo(t) == 1: redone = redone + 1 end
    do text_add_whole(out, redone)
    do text_add(out, " steps redone; the text as edited: ")
    do say(out, text_is(t.bytes, 0, text_length(t), edited))
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
edited as meant: yes
12 steps undone; the text as loaded: yes
12 steps redone; the text as edited: yes
----
end
case text buffer: the history keeps the newest 256 steps, and the newest that fit its bytes
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func undo_all(t):
    let undone = 0
    while text_undo(t) == 1: undone = undone + 1 end
    return undone
end

func main():
    let out = new_buffer()
    -- 300 letters typed one at a time into a text with room, and history bytes, for 512.
    let t = text_buffer(512)
    let typed = 0
    while typed < 300:
        do text_insert(t, 'a')
        typed = typed + 1
    end
    do text_add_whole(out, undo_all(t))
    do text_add(out, " steps undone, ")
    do text_add_whole(out, text_length(t))
    do text_add(out, " letters left\n")
    -- Twelve letters typed with eight bytes of history.
    let small = text_buffer_history(64, 8)
    let i = 0
    while i < 12:
        do text_insert(small, index("abcdefghijkl", i))
        i = i + 1
    end
    do text_add_whole(out, undo_all(small))
    do text_add(out, " steps undone, left: ")
    do text_add_span(out, small.bytes, 0, text_length(small))
    do text_add(out, "\n")
    -- Four bytes of history: abcd typed, c and d undone, x typed. The two undone steps are forgotten
    -- and their bytes free again, so a, b and x all fit.
    let tiny = text_buffer_history(64, 4)
    i = 0
    while i < 4:
        do text_insert(tiny, index("abcd", i))
        i = i + 1
    end
    do text_undo(tiny)
    do text_undo(tiny)
    do text_insert(tiny, 'x')
    do text_add_whole(out, undo_all(tiny))
    do text_add(out, " steps undone, left: [")
    do text_add_span(out, tiny.bytes, 0, text_length(tiny))
    do text_add(out, "]\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
256 steps undone, 44 letters left
8 steps undone, left: abcd
3 steps undone, left: []
----
end
