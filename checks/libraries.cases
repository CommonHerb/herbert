case text buffer: a refused load leaves the text, the cursor and the history as they were
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func show(out, t):
    do text_add(out, "[")
    do text_add_span(out, t.bytes, 0, text_length(t))
    do text_add(out, "] cursor ")
    do text_add_whole(out, text_cursor(t))
    return text_add(out, "\n")
end

func refused(out, status):
    if not linux_error(status): return text_add(out, "loaded\n") end
    do text_add(out, "error ")
    do text_add_whole(out, 0 - status)
    return text_add(out, "\n")
end

func main():
    let t = text_buffer(8)
    do text_insert(t, 'a')
    do text_insert(t, 'b')
    do text_insert(t, 'c')
    let out = new_buffer()
    -- The byte FF is never part of UTF-8.
    let bad = linux_cstring("x.")
    do buffer_set(bad, 1, 255)
    do refused(out, text_load(t, bad, 2))
    -- Nine bytes for a text with room for eight.
    do refused(out, text_load(t, linux_cstring("123456789"), 9))
    do show(out, t)
    do text_undo(t)
    do show(out, t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
error 84
error 27
[abc] cursor 3
[ab] cursor 2
----
end
case text buffer: a CRLF file is edited with plain newlines and written back with CRLF
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- count bytes of b, a carriage return shown as \r and a newline as \n.
func plain(out, b, count):
    let i = 0
    while i < count:
        let ch = buffer_get(b, i)
        if ch == 13: do text_add(out, "\\r") elif ch == 10: do text_add(out, "\\n") else: do append(out, ch) end
        i = i + 1
    end
    return text_add(out, "\n")
end

func main():
    let t = text_buffer(64)
    let out = new_buffer()
    do text_add_whole(out, text_load(t, linux_cstring("one\r\ntwo\r\n"), 10))
    if text_crlf(t): do text_add(out, " CRLF") end
    do text_add(out, "\ntext, ")
    do text_add_whole(out, text_length(t))
    do text_add(out, " bytes: ")
    do plain(out, t.bytes, text_length(t))
    do text_add(out, "file, ")
    do text_add_whole(out, text_file_length(t))
    do text_add(out, " bytes: ")
    do plain(out, text_file_bytes(t), text_file_length(t))
    -- A newline typed at the start is one byte of text and two of file.
    do text_insert(t, 10)
    do text_add(out, "text, ")
    do text_add_whole(out, text_length(t))
    do text_add(out, " bytes: ")
    do plain(out, t.bytes, text_length(t))
    do text_add(out, "file, ")
    do text_add_whole(out, text_file_length(t))
    do text_add(out, " bytes: ")
    do plain(out, text_file_bytes(t), text_file_length(t))
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0 CRLF
text, 8 bytes: one\ntwo\n
file, 10 bytes: one\r\ntwo\r\n
text, 9 bytes: \none\ntwo\n
file, 12 bytes: \r\none\r\ntwo\r\n
----
end
case text buffer: mixed line endings, a carriage return alone and control bytes are refused
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func load(out, t, what, s):
    do text_add(out, what)
    let status = text_load(t, linux_cstring(s), length(s))
    if not linux_error(status): return text_add(out, ": loaded\n") end
    do text_add(out, ": error ")
    do text_add_whole(out, 0 - status)
    return text_add(out, "\n")
end

func main():
    let t = text_buffer(64)
    let out = new_buffer()
    do load(out, t, "CRLF then LF", "a\r\nb\n")
    do load(out, t, "LF then CRLF", "a\nb\r\n")
    do load(out, t, "a carriage return inside a line", "a\rb")
    do load(out, t, "a carriage return at the end", "a\r")
    do load(out, t, "a NUL byte", "a\0b")
    do load(out, t, "a tab", "a\tb")
    do load(out, t, "CRLF throughout", "a\r\nb\r\n")
    -- Two bytes loaded from a buffer whose third is a newline: the newline is not part of the text.
    do text_add(out, "a carriage return at the end, a newline lying past the end")
    if text_load(t, linux_cstring("a\r\n"), 2) == 0 - 84: do text_add(out, ": error 84\n") else: do text_add(out, ": NOT refused with 84\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
CRLF then LF: error 84
LF then CRLF: error 84
a carriage return inside a line: error 84
a carriage return at the end: error 84
a NUL byte: error 84
a tab: loaded
CRLF throughout: loaded
a carriage return at the end, a newline lying past the end: error 84
----
end
case text buffer: a CRLF text counts both bytes of every newline against the capacity
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func press(out, t, what, cp):
    do text_add(out, what)
    if text_insert(t, cp) == 1: do text_add(out, " taken") else: do text_add(out, " refused") end
    do text_add(out, ", on disk ")
    do text_add_whole(out, text_file_length(t))
    return text_add(out, "\n")
end

func main():
    -- Room for eight bytes on disk; this file is eight: six of text and two carriage returns.
    let t = text_buffer(8)
    let out = new_buffer()
    do text_add_whole(out, text_load(t, linux_cstring("ab\r\ncd\r\n"), 8))
    do text_add(out, " text ")
    do text_add_whole(out, text_length(t))
    do text_add(out, ", on disk ")
    do text_add_whole(out, text_file_length(t))
    do text_add(out, "\n")
    do press(out, t, "x", 'x')
    -- The last newline backspaced away frees two bytes.
    do text_seek(t, 6)
    do text_backspace(t)
    do press(out, t, "x", 'x')
    do press(out, t, "newline", 10)
    do press(out, t, "y", 'y')
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0 text 6, on disk 8
x refused, on disk 8
x taken, on disk 7
newline refused, on disk 7
y taken, on disk 8
----
end
case text buffer: find goes forward or backward from its start, and on round the end of the text
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func find(out, t, s, start, backward):
    let found = text_find(t, linux_cstring(s), length(s), start, backward)
    do text_add(out, " ")
    if found == 0 - 1: return text_add(out, "none") end
    return text_add_whole(out, found)
end

func main():
    let t = text_buffer(64)
    let out = new_buffer()
    -- abc at 0, at 4 and at 8.
    do text_load(t, linux_cstring("abc abc abc"), 11)
    do text_add(out, "forward from 0 1 4 5 9:")
    do find(out, t, "abc", 0, false)
    do find(out, t, "abc", 1, false)
    do find(out, t, "abc", 4, false)
    do find(out, t, "abc", 5, false)
    do find(out, t, "abc", 9, false)
    do text_add(out, "\nbackward from 10 8 7 3 0:")
    do find(out, t, "abc", 10, true)
    do find(out, t, "abc", 8, true)
    do find(out, t, "abc", 7, true)
    do find(out, t, "abc", 3, true)
    do find(out, t, "abc", 0, true)
    do text_load(t, linux_cstring("abc xyz"), 7)
    do text_add(out, "\nabc in [abc xyz], forward from 1:")
    do find(out, t, "abc", 1, false)
    do text_add(out, "\nxyz in [abc xyz], backward from 2:")
    do find(out, t, "xyz", 2, true)
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
forward from 0 1 4 5 9: 0 4 4 8 0
backward from 10 8 7 3 0: 8 8 4 0 0
abc in [abc xyz], forward from 1: 0
xyz in [abc xyz], backward from 2: 4
----
end
