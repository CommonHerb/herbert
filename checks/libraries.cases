case file and recovery: a save, a rescue copy and a checkpoint whose write fails are refused and change nothing: the document, the earlier checkpoint, no copy and no temporary file left
libs linux text file_io session_recovery
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- The inode of the file at path (in Linux's stat at 8).
func inode(path):
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring(path), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    return linux_u64(stat, 8)
end

-- How many names in the folder at path begin with prefix. Linux's getdents64 is 217; in each
-- record the length is at 16 and the name from 19.
func names(path, prefix):
    let fd = linux_open(linux_cstring(path), 65536, 0)
    let dents = linux_buffer(4096)
    let found = 0
    let got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    while not linux_error(got) and got != 0:
        let p = 0
        while p < got:
            let name = p + 19
            if text_starts(dents, name, linux_nul_end(dents, name, p + linux_u16(dents, p + 16)), prefix): found = found + 1 end
            p = p + linux_u16(dents, p + 16)
        end
        got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    end
    do linux_close(fd)
    return found
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

func main():
    do linux_syscall6(83, buffer_address(linux_cstring("fail6.d")), 448, 0, 0, 0, 0)
    do write_file("fail6.d/doc.txt", "the document\n")
    let f = file_open("fail6.d/doc.txt", 4096)
    let r = recovery_new(4096)
    let first = recovery_save(r, f, linux_cstring("first checkpoint\n"), 17)
    let before = inode("fail6.d/doc.txt")
    let text = linux_cstring("a text longer than eight bytes\n")
    -- The signal for a file grown past its limit ignored (Linux's rt_sigaction, 13: SIGXFSZ is 25,
    -- and 1 is SIG_IGN), so that a write past the limit fails with 27 instead of ending the program.
    let ignore = linux_buffer(32)
    do linux_put64(ignore, 0, 1)
    do linux_syscall6(13, 25, buffer_address(ignore), 0, 8, 0, 0)
    -- No file may grow past eight bytes from here (Linux's prlimit64, 302; RLIMIT_FSIZE is 1).
    let old = linux_buffer(16)
    do linux_syscall6(302, 0, 1, 0, buffer_address(old), 0, 0)
    let low = linux_buffer(16)
    do linux_put64(low, 0, 8)
    do linux_put64(low, 8, linux_u64(old, 8))
    do linux_syscall6(302, 0, 1, buffer_address(low), 0, 0, 0)
    let saved = file_save(f, text, 31)
    let copied = file_save_copy(f, text, 31)
    let checkpoint = recovery_save(r, f, text, 31)
    -- The limit as it was, before anything is written out.
    do linux_syscall6(302, 0, 1, buffer_address(old), 0, 0, 0)
    let out = new_buffer()
    do text_add(out, "first checkpoint: ")
    do result(out, first)
    do text_add(out, "\nwith nothing able to grow past eight bytes: a save ")
    do result(out, saved)
    do text_add(out, ", a rescue copy ")
    do result(out, copied)
    do text_add(out, ", a checkpoint ")
    do result(out, checkpoint)
    do text_add(out, "\n")
    if holds("fail6.d/doc.txt", "the document\n") and inode("fail6.d/doc.txt") == before: do text_add(out, "the document is the same file with its bytes\n") end
    let s = file_scan_new()
    let g = file_new(4096)
    if file_scan(f, s, ".herbert-notes-") == 1 and file_load_inside(g, f, file_scan_name(s), "recovery.txt") == 0:
        if text_is(g.bytes, 0, file_count(g), "first checkpoint\n"): do text_add(out, "recovery.txt is the first checkpoint\n") end
    end
    let folder = new_buffer()
    do text_add(folder, "fail6.d/")
    do text_add_span(folder, file_scan_name(s), 0, linux_nul_end(file_scan_name(s), 0, 256))
    do text_add(out, "rescue copies: ")
    do text_add_whole(out, names("fail6.d", "herbert-rescue-"))
    do text_add(out, ", temporary files beside the document: ")
    do text_add_whole(out, names("fail6.d", ".herbert-save-"))
    do text_add(out, ", in the session folder: ")
    do text_add_whole(out, names(freeze(folder), ".herbert-save-"))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
first checkpoint: 0
with nothing able to grow past eight bytes: a save error 27, a rescue copy error 27, a checkpoint error 27
the document is the same file with its bytes
recovery.txt is the first checkpoint
rescue copies: 0, temporary files beside the document: 0, in the session folder: 0
----
end
case file: after a save left unconfirmed, an outside rewrite of the same size with its time put back is still refused with 116, because the bytes are compared
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

func main():
    do write_file("unsure6.txt", "old untouched\n")
    let f = file_open("unsure6.txt", 64)
    let out = new_buffer()
    do text_add(out, "a save: ")
    do result(out, file_save(f, linux_cstring("new\nnotes\t!\n"), 12))
    -- What a save gives (1) when the check after its rename fails: the file it published is not yet
    -- confirmed as the baseline.
    let st = f.state
    st.uncertain = true
    -- The file's times now: access at 72 and modification at 88 in Linux's stat, sixteen bytes each.
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring("unsure6.txt"), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    -- Another program rewrites the same file in place, twelve other bytes, and puts both times back
    -- (Linux's utimensat, 280, from the current folder, -100).
    do write_file("unsure6.txt", "BAD\nnotes\t!\n")
    let times = linux_buffer(32)
    do linux_copy(times, 0, stat, 72, 32)
    do linux_syscall6(280, 0 - 100, buffer_address(linux_cstring("unsure6.txt")), buffer_address(times), 0, 0, 0)
    do text_add(out, "\nthe next save: ")
    do result(out, file_save(f, linux_cstring("new\nnotes\t!\n"), 12))
    if holds("unsure6.txt", "BAD\nnotes\t!\n"): do text_add(out, ", the other program's bytes whole") end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
