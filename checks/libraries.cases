case figures: the drive and the processor are found by their sensors' names, in a folder the case made, and read from there
libs linux text figures
source until ----
-- A folder (Linux's mkdir, 83), and a file holding text.
func folder(path):
    return linux_syscall6(83, buffer_address(linux_cstring(path)), 448, 0, 0, 0, 0)
end

func put(path, text):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(text), 0, length(text))
    return linux_close(fd)
end

func reading(out, what, sensor):
    do text_add(out, what)
    if sensor.state != 1: return text_add(out, " n/a") end
    do text_add(out, " ")
    return text_add_whole(out, sensor.reading)
end

func main():
    -- hwmon0 is something else; hwmon1 a drive whose critical limit is the nonsense one drive gives;
    -- hwmon2 is missing; hwmon3 an Intel processor sensor; hwmon4 a second drive; hwmon5 an AMD
    -- processor sensor, which is preferred to the Intel one before it.
    do folder("hw.d")
    do folder("hw.d/hwmon0")
    do put("hw.d/hwmon0/name", "acpitz\n")
    do folder("hw.d/hwmon1")
    do put("hw.d/hwmon1/name", "nvme\n")
    do put("hw.d/hwmon1/temp1_input", "35850\n")
    do put("hw.d/hwmon1/temp1_max", "83850\n")
    do put("hw.d/hwmon1/temp1_crit", "65261850\n")
    do folder("hw.d/hwmon3")
    do put("hw.d/hwmon3/name", "coretemp\n")
    do put("hw.d/hwmon3/temp1_input", "41000\n")
    do folder("hw.d/hwmon4")
    do put("hw.d/hwmon4/name", "nvme\n")
    do put("hw.d/hwmon4/temp1_input", "99000\n")
    do folder("hw.d/hwmon5")
    do put("hw.d/hwmon5/name", "k10temp\n")
    do put("hw.d/hwmon5/temp1_input", "52000\n")
    let heat = figures_heat_new()
    do figures_heat_find(heat, "hw.d")
    let out = new_buffer()
    if heat.drive.found:
        do text_add(out, "drive: hwmon")
        do text_add_whole(out, heat.drive.which)
        do text_add(out, ", warning ")
        do text_add_whole(out, heat.drive.warning)
        do text_add(out, ", critical ")
        do text_add_whole(out, heat.drive.critical)
        do text_add(out, "\n")
    end
    if heat.processor.found:
        do text_add(out, "processor: hwmon")
        do text_add_whole(out, heat.processor.which)
        do text_add(out, "\n")
    end
    do figures_heat_read(heat)
    do reading(out, "drive", heat.drive)
    do reading(out, ", processor", heat.processor)
    -- A reading that is not a plain number is no reading.
    do put("hw.d/hwmon1/temp1_input", "-5\n")
    do figures_heat_read(heat)
    do reading(out, "\ndrive", heat.drive)
    do reading(out, ", processor", heat.processor)
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
drive: hwmon1, warning 83850, critical 0
processor: hwmon5
drive 35850, processor 52000
drive n/a, processor 52000
----
end
case figures: the helper's line is written as lib/figures.herb's own example, and read back to the same figures
libs linux text figures
source until ----
func half(out, what, given, first, second):
    do text_add(out, what)
    if not given: return text_add(out, " not given") end
    do text_add(out, " ")
    do text_add_whole(out, first)
    do text_add(out, " ")
    return text_add_whole(out, second)
end

-- Write the line for these readings, show it, read it back and show what the reader found.
func line(out, cpu, memory, disk, drive):
    let b = linux_buffer(figures_reply_longest())
    let n = figures_reply_put(b, cpu, memory, disk, drive)
    do text_add_span(out, b, 0, n)
    let r = figures_reply_new()
    if not figures_reply_read(r, b, n): return text_add(out, "  not read back\n") end
    do text_add(out, "  version ")
    do text_add_whole(out, r.version)
    do half(out, ", cpu", r.cpu, r.total, r.busy)
    do half(out, ", memory", r.memory, r.mem_total, r.mem_available)
    do half(out, ", disk", r.disk, r.used, r.free)
    if r.drive == 0: do text_add(out, ", no drive sensor") end
    do half(out, ", drive", r.drive == 2, r.reading, r.limit)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    let disk = figures_disk_new(".")
    disk.state = 1
    disk.used = 116826368
    disk.avail = 108331196
    let drive = figures_sensor_new()
    drive.found = true
    drive.state = 1
    drive.reading = 35850
    drive.warning = 83850
    do line(out, (true, 10000, 1500), (true, 16384000, 4096000), disk, drive)
    -- A drive that says a thousand degrees or more is sent as unavailable.
    drive.reading = 1000000
    do line(out, (true, 10000, 1500), (true, 16384000, 4096000), disk, drive)
    -- No processor reading, no disk reading and no drive sensor.
    disk.state = 2
    drive.found = false
    do line(out, (false, 0, 0), (true, 16384000, 4096000), disk, drive)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
herbert-scope 2 10000 1500 16384000 4096000 116826368 108331196 35850 83850
  version 2, cpu 10000 1500, memory 16384000 4096000, disk 116826368 108331196, drive 35850 83850
herbert-scope 2 10000 1500 16384000 4096000 116826368 108331196 unavailable
  version 2, cpu 10000 1500, memory 16384000 4096000, disk 116826368 108331196, drive not given
herbert-scope 2 unavailable 16384000 4096000 unavailable none
  version 2, cpu not given, memory 16384000 4096000, disk not given, no drive sensor, drive not given
----
end
case figures: the reply reader takes a line of version 1 or 2 within the rules, and nothing else
libs linux text figures
source until ----
func read(out, what, s):
    let r = figures_reply_new()
    do text_add(out, what)
    if figures_reply_read(r, linux_cstring(s), length(s)): return text_add(out, ": taken\n") end
    return text_add(out, ": refused\n")
end

func main():
    let out = new_buffer()
    do read(out, "version 1", "herbert-scope 1 10000 1500 16384000 4096000\n")
    do read(out, "version 2 with nothing readable", "herbert-scope 2 unavailable unavailable unavailable none\n")
    do read(out, "more memory available than there is", "herbert-scope 1 10 5 100 200\n")
    do read(out, "a drive at 999.999 degrees with a limit of 200", "herbert-scope 2 10 5 100 50 7 7 999999 200000\n")
    do read(out, "no newline at the end", "herbert-scope 1 10000 1500 16384000 4096000")
    do read(out, "version 3", "herbert-scope 3 10000 1500 16384000 4096000\n")
    do read(out, "two spaces together", "herbert-scope 1 10000  1500 16384000 4096000\n")
    do read(out, "a space before the newline", "herbert-scope 1 10000 1500 16384000 4096000 \n")
    do read(out, "a zero in front", "herbert-scope 1 010000 1500 16384000 4096000\n")
    do read(out, "a number of 2^64", "herbert-scope 1 18446744073709551616 5 100 50\n")
    do read(out, "busy above total", "herbert-scope 1 10 11 100 50\n")
    do read(out, "a memory total of zero", "herbert-scope 1 10 5 0 0\n")
    do read(out, "version 1 with version 2's parts", "herbert-scope 1 10 5 100 50 7 7 none\n")
    do read(out, "version 2 without its drive part", "herbert-scope 2 10 5 100 50 7 7\n")
    do read(out, "in use and free together past 2^64 - 1", "herbert-scope 2 10 5 100 50 18446744073709551615 1 none\n")
    do read(out, "a drive at 1000 degrees", "herbert-scope 2 10 5 100 50 7 7 1000000 0\n")
    do read(out, "a drive's limit above 200 degrees", "herbert-scope 2 10 5 100 50 7 7 35850 200001\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
