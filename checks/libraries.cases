func row(out, t, p):
    do text_add(out, " ")
    return text_add_whole(out, text_row(t, p))
end

func start(out, t, row):
    do text_add(out, " ")
    return text_add_whole(out, text_row_offset(t, row))
end

func main():
    -- one at 0, two at 4, three at 8, the end at 13: three rows, 0 to 2.
    let t = text_buffer(64)
    do text_load(t, linux_cstring("one\ntwo\nthree"), 13)
    let out = new_buffer()
    do text_add(out, "rows of 0 3 4 8 13:")
    do row(out, t, 0)
    do row(out, t, 3)
    do row(out, t, 4)
    do row(out, t, 8)
    do row(out, t, 13)
    -- A row past the last gives the end of the text.
    do text_add(out, "\nstarts of rows 0 1 2 3 99:")
    do start(out, t, 0)
    do start(out, t, 1)
    do start(out, t, 2)
    do start(out, t, 3)
    do start(out, t, 99)
    do text_add(out, "\nback and forth, row of 13, of 0, start of 2, of 0, row of 5, start of 1:")
    do row(out, t, 13)
    do row(out, t, 0)
    do start(out, t, 2)
    do start(out, t, 0)
    do row(out, t, 5)
    do start(out, t, 1)
    do text_add(out, "\nrow 99 is held to row ")
    do text_add_whole(out, text_row_clamp(t, 99))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
