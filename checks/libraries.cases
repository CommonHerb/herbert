source until ----
func address(out, s):
    let a = net_ipv4(s)
    do text_add(out, "[")
    do text_add(out, s)
    if not a.0: return text_add(out, "]: refused\n") end
    do text_add(out, "]: ")
    do text_add_whole(out, a.1)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- 18446744073709551617 is 2^64 + 1: read carelessly it wraps to 1, and the address to 127.0.0.1.
    do address(out, "127.0.0.18446744073709551617")
    do address(out, "127.0.0.")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
