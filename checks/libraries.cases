source until ----
-- A file at path holding count bytes x, made without the library.
func write_xs(path, count):
    let b = new_buffer()
    do buffer_fill(b, count, 'x')
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, b, 0, count)
    return linux_close(fd)
end

func refused(out, what, r, f):
    do text_add(out, what)
    if linux_error(r):
        do text_add(out, ": error ")
        do text_add_whole(out, 0 - r)
    else:
        do text_add(out, ": ")
        do text_add_whole(out, r)
    end
    do text_add(out, ", ")
    do text_add_whole(out, file_count(f))
    return text_add(out, " bytes read\n")
end

func main():
    let out = new_buffer()
    do linux_syscall6(83, buffer_address(linux_cstring("bound6.d")), 448, 0, 0, 0, 0)
    do linux_syscall6(83, buffer_address(linux_cstring("bound6.d/.herbert-notes-1-1")), 448, 0, 0, 0, 0)
    do write_xs("bound6.d/big.txt", 100)
    do write_xs("bound6.d/.herbert-notes-1-1/recovery.txt", 100)
    -- Room for seven bytes.
    let f = file_open("bound6.d/big.txt", 7)
    do refused(out, "100 bytes opened", file_status(f), f)
    let doc = file_open("bound6.d/doc.txt", 64)
    let g = file_new(7)
    do refused(out, "100 bytes as a recovery copy", file_load_inside(g, doc, linux_cstring(".herbert-notes-1-1"), "recovery.txt"), g)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
