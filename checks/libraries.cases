func report(out, n):
    if n.0:
        do text_add(out, "number ")
        do text_add_whole(out, n.1)
        do text_add(out, " next ")
        do text_add_whole(out, n.2)
    else:
        do text_add(out, "refused, value ")
        do text_add_whole(out, n.1)
    end
    return text_add(out, "\n")
end

func main():
    let b = linux_cstring("x12")
    let out = new_buffer()
    do report(out, text_whole(b, 0, 3))
    do report(out, text_whole(b, 1, 3))
    do report(out, text_whole(b, 3, 3))
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
