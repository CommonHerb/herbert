func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

-- mkdir (83): a folder called name.
func make(name): return linux_syscall6(83, buffer_address(linux_cstring(name)), 448, 0, 0, 0, 0) end

func main():
    let out = new_buffer()
    -- No filter at address 0 can be read: Linux says EFAULT (14), and then
    -- nothing fails.
    do text_add(out, "a filter Linux cannot read: ")
    do result(out, fault_start(0))
    do text_add(out, "\nmkdir after it: ")
    do result(out, make("fault-limits-1.d"))
    let f = fault_new()
    do text_add(out, "\nerror 4096: ")
    do result(out, fault_fail(f, 83, 4096))
    do text_add(out, "\nargument 6: ")
    do result(out, fault_fail_equal(f, 83, 5, 6, 0))
    do text_add(out, "\nargument 6 above: ")
    do result(out, fault_fail_above(f, 83, 5, 6, 0))
    -- 64 rules of the largest kind: mkdir with its mode (argument 1) above
    -- 0 gives 4095, the largest error, then 63 for calls Linux does not have.
    let taken = 0
    if fault_fail_above(f, 83, 4095, 1, 0) == 0: taken = taken + 1 end
    let i = 0
    while i < 63:
        if fault_fail_above(f, 2000 + i, 5, 0, 0) == 0: taken = taken + 1 end
        i = i + 1
    end
    do text_add(out, "\nrules taken: ")
    do text_add_whole(out, taken)
    do text_add(out, "\none more: ")
    do result(out, fault_fail(f, 84, 5))
    -- Another: 63 rules of the largest kind and one of the smallest leave
    -- room for one more of the smallest only. rmdir (84) gives 39.
    let g = fault_new()
    let j = 0
    while j < 63:
        do fault_fail_above(g, 3000 + j, 5, 0, 0)
        j = j + 1
    end
    do text_add(out, "\n63 long and 1 short: ")
    do result(out, fault_fail(g, 84, 39))
    do text_add(out, "\nequal: ")
    do result(out, fault_fail_equal(g, 3100, 5, 0, 0))
    do text_add(out, "\nabove: ")
    do result(out, fault_fail_above(g, 3101, 5, 0, 0))
    do text_add(out, "\nshort: ")
    do result(out, fault_fail(g, 3102, 5))
    do text_add(out, "\nshort: ")
    do result(out, fault_fail(g, 3103, 5))
    do text_add(out, "\nthe filter: ")
    do result(out, fault_start(fault_ready(f)))
    do text_add(out, "\nmkdir: ")
    do result(out, make("fault-limits-2.d"))
    do text_add(out, "\nthe second filter: ")
    do result(out, fault_start(fault_ready(g)))
    do text_add(out, "\nrmdir: ")
    do result(out, linux_syscall6(84, buffer_address(linux_cstring("fault-limits-1.d")), 0, 0, 0, 0, 0))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
