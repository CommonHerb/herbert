func say(out, flag):
    if flag: return text_add(out, "yes\n") end
    return text_add(out, "no\n")
end

func main():
    let b = linux_cstring("hello world")
    let out = new_buffer()
    do say(out, text_starts(b, 0, 11, "hello"))
    do say(out, text_starts(b, 6, 11, "world"))
    do say(out, text_starts(b, 6, 10, "world"))
    do say(out, text_starts(b, 0, 11, "help"))
    do say(out, text_is(b, 0, 5, "hello"))
    do say(out, text_is(b, 0, 11, "hello"))
    do say(out, text_is(b, 0, 5, "help!"))
    do flogger(freeze(out))
    do process_exit(0)
