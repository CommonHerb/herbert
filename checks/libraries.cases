case file: a save keeps the permission bits the file has, and a new file is private
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Linux's chmod, 90.
func set_mode(path, mode):
    return linux_syscall6(90, buffer_address(linux_cstring(path)), mode, 0, 0, 0, 0)
end

-- The permission bits of the file at path, as three octal digits.
func mode(out, path):
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring(path), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    let bits = linux_u32(stat, 24) % 512
    do text_add_whole(out, bits / 64)
    do text_add_whole(out, (bits / 8) % 8)
    return text_add_whole(out, bits % 8)
end

func main():
    let out = new_buffer()
    -- 416 is 640 in octal: the owner reads and writes, the group reads.
    do write_file("bits.txt", "old\n")
    do set_mode("bits.txt", 416)
    let f = file_open("bits.txt", 64)
    do text_add_whole(out, file_save(f, linux_cstring("new\n"), 4))
    do text_add(out, ", saved over a file of mode 640: ")
    do mode(out, "bits.txt")
    let fresh = file_open("fresh.txt", 64)
    do text_add(out, "\n")
    do text_add_whole(out, file_save(fresh, linux_cstring("new\n"), 4))
    do text_add(out, ", a new file: ")
    do mode(out, "fresh.txt")
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0, saved over a file of mode 640: 640
0, a new file: 600
----
end
