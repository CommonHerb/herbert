    do write_file("fault-dirsync.d/doc.txt", "old\n")
    let f = file_open("fault-dirsync.d/doc.txt", 64)
    -- Only an fsync (74) of the document's folder, the File's directory
    -- descriptor, fails with EIO (5); the temporary file's fsync is done.
    let fault = fault_new()
    do fault_fail_equal(fault, 74, 5, 0, f.state.dirfd)
    let out = new_buffer()
    do text_add(out, "the filter: ")
    do result(out, fault_start(fault_ready(fault)))
    do text_add(out, "\na save while the folder's fsync fails: ")
    do result(out, file_save(f, linux_cstring("new\n"), 4))
    if holds("fault-dirsync.d/doc.txt", "new\n"): do text_add(out, "\nthe file holds the new bytes") end
