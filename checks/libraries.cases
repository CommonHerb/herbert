source until ----
func say(what, result):
    let line = new_buffer()
    do text_add(line, what)
    do text_add_whole(line, 0 - result)
    do text_add(line, "\n")
    do flogger(freeze(line))
    return 0
end

func there(path):
    let fd = linux_open(linux_cstring(path), 0, 0)
    if linux_error(fd): return false end
    do linux_close(fd)
    return true
end

func main():
    do linux_syscall6(83, buffer_address(linux_cstring("fn-folder")), 448, 0, 0, 0, 0)
    do linux_close(linux_open(linux_cstring("fn-folder/file"), 577, 420))
    do linux_syscall6(88, buffer_address(linux_cstring("fn-folder")), buffer_address(linux_cstring("fn-link")), 0, 0, 0, 0)
    let here = folder_open(linux_cstring("."))
    do say("an empty name: ", folder_remove(here, linux_cstring("")))
    do say("the folder's own name, a dot: ", folder_remove(here, linux_cstring(".")))
    do say("its parent's, two dots: ", folder_remove(here, linux_cstring("..")))
    do say("a name with a slash: ", folder_remove(here, linux_cstring("fn-folder/file")))
    do say("a path from the root: ", folder_remove(here, linux_cstring("/fn-folder")))
    do say("a name that ends with a slash: ", folder_remove(here, linux_cstring("fn-folder/")))
    do say("a descriptor that is not one: ", folder_remove(0 - 100, linux_cstring("fn-folder")))
    do say("a name that is not there: ", folder_remove(here, linux_cstring("fn-nothing")))
    if there("fn-folder/file"):
        do flogger("the folder and its file are still there\n")
    end
    do say("opening a file as a folder: ", folder_open(linux_cstring("fn-folder/file")))
    do say("opening a link to a folder: ", folder_open(linux_cstring("fn-link")))
    do process_exit(0)
    return 0
end
