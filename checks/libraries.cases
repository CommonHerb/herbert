..#..
..#..
..#..
..#..
..#..
..#..

#....
#....
#....
#....
#....
#....
#####
----
end
case linux: fields are stored low byte first and read back whole, and a put keeps only its field's low bits
libs linux text
source until ----
func bytes(out, b):
    let i = 0
    while i < buffer_length(b):
        if i != 0: do text_add(out, " ") end
        do text_add_whole(out, buffer_get(b, i))
        i = i + 1
    end
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- 4660 is 1234 in hex, 305419896 is 12345678, 1311768467463790320 is 123456789ABCDEF0.
    let b = linux_buffer(14)
    do linux_put16(b, 0, 4660)
    do linux_put32(b, 2, 305419896)
    do linux_put64(b, 6, 1311768467463790320)
    do bytes(out, b)
    do text_add_whole(out, linux_u16(b, 0))
    do text_add(out, " ")
    do text_add_whole(out, linux_u32(b, 2))
    do text_add(out, " ")
    do text_add_whole(out, linux_u64(b, 6))
    do text_add(out, "\n")
    -- Ten bytes of 170. 65536 + 7 put as 16 bits at 1 is 7; 2^32 + 5 put as 32 bits at 4 is 5.
    let c = new_buffer()
    do buffer_fill(c, 10, 170)
    do linux_put16(c, 1, 65543)
    do linux_put32(c, 4, 4294967301)
    do bytes(out, c)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
52 18 120 86 52 18 240 222 188 154 120 86 52 18
4660 305419896 1311768467463790320
170 7 0 170 5 0 0 0 170 170
----
end
