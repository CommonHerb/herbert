case folder: a folder given through a link is worked in all the same, and the new folder is taken away through the descriptor kept
libs linux text folder
source until ----
func yes(b):
    if b: return "yes\n" end
    return "no\n"
end

func join(a, b):
    let out = new_buffer()
    do text_add(out, a)
    do text_add(out, b)
    return freeze(out)
end

func there(path):
    let stat = linux_buffer(144)
    return linux_syscall6(4, buffer_address(linux_cstring(path)), buffer_address(stat), 0, 0, 0, 0) == 0
end

func say(what, result):
    let line = new_buffer()
    do text_add(line, what)
    do text_add_whole(line, 0 - result)
    do text_add(line, "\n")
    do flogger(freeze(line))
    return 0
end

func main():
    do linux_syscall6(83, buffer_address(linux_cstring("fl-real")), 448, 0, 0, 0, 0)
    do linux_syscall6(88, buffer_address(linux_cstring("fl-real")), buffer_address(linux_cstring("fl-link")), 0, 0, 0, 0)
    let a = folder_own("fl-link", "probe")
    do say("made under a link: ", a.0)
    do flogger("the new folder is in the folder the link points at: ")
    do flogger(yes(there(join("fl-real/", a.2))))
    do linux_close(linux_open(linux_cstring(join(a.1, "/inside")), 577, 420))
    do linux_syscall6(87, buffer_address(linux_cstring("fl-link")), 0, 0, 0, 0, 0)
    do flogger("its path is no use once the link is gone: ")
    do flogger(yes(not there(a.1)))
    do say("taken away through the descriptor kept: ", folder_remove(a.3, linux_cstring(a.2)))
    do flogger("nothing of it is left: ")
    do flogger(yes(not there(join("fl-real/", a.2))))
    let none = folder_own("fl-nowhere", "probe")
    do say("under a folder that is not there: ", none.0)
    do say("and what comes in the descriptor's place is refused: ", folder_remove(none.3, linux_cstring("probe")))
    do process_exit(0)
    return 0
end
