    return text_add_whole(out, text_column(t, p))
end

func main():
    -- e acute at 0 (two bytes), the euro sign at 2 (three), a face at 5 (four), e and a combining
    -- accent at 9 (three bytes, one character), x at 12, the end at 13.
    let t = text_buffer(64)
