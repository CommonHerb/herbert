libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

func main():
    do write_file("touched.txt", "same\n")
    let f = file_open("touched.txt", 64)
    -- Linux's utimensat, 280, from the current folder (-100): the access and the modification time
    -- both set to 1000 seconds, as a program that rewrote the same bytes and dated them would leave.
    let times = linux_buffer(32)
    do linux_put64(times, 0, 1000)
    do linux_put64(times, 16, 1000)
    do linux_syscall6(280, 0 - 100, buffer_address(linux_cstring("touched.txt")), buffer_address(times), 0, 0, 0)
    let saved = file_save(f, linux_cstring("mine\n"), 5)
    let out = new_buffer()
    if linux_error(saved):
        do text_add(out, "error ")
        do text_add_whole(out, 0 - saved)
        do text_add(out, "\n")
    end
    if holds("touched.txt", "same\n"): do text_add(out, "the file is as it was\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
