case text: the strict readers judge a zero in front from where reading starts, not from the start of the buffer or string
libs linux text
source until ----
func report(out, n):
    if n.0:
        do text_add(out, "number ")
        do text_add_whole(out, n.1)
        do text_add(out, " next ")
        return text_add_whole(out, n.2)
    end
    do text_add(out, "refused, value ")
    return text_add_whole(out, n.1)
end

-- s read strictly from at to its end, as a buffer and then as a string.
func both(out, s, at):
    do text_add(out, "[")
    do text_add(out, s)
    do text_add(out, "] from ")
    do text_add_whole(out, at)
    do text_add(out, ": ")
    do report(out, text_whole_strict(linux_cstring(s), at, length(s)))
    do text_add(out, "; as a string: ")
    do report(out, text_string_whole_strict(s, at, length(s)))
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do both(out, "x0", 1)
    do both(out, "x07", 1)
    do both(out, "0 12", 2)
    do both(out, "1 05", 2)
    do both(out, "10 0", 3)
    do both(out, "7 100", 2)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
