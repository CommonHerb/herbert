case net: a dotted address is four numbers from 0 to 255 joined by single dots, and nothing else
libs linux text net
source until ----
func address(out, s):
    let a = net_ipv4(s)
    do text_add(out, "[")
    do text_add(out, s)
    if not a.0: return text_add(out, "]: refused\n") end
    do text_add(out, "]: ")
    do text_add_whole(out, a.1)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- 192 * 16777216 + 168 * 65536 + 1 * 256 + 20 is 3232235796.
    do address(out, "192.168.1.20")
    do address(out, "0.0.0.0")
    do address(out, "127.0.0.1")
    do address(out, "255.255.255.255")
    -- A zero in front counts part by part: 0.10.0.1 has none (10 * 65536 + 1), 1.02.3.4 has one.
    do address(out, "0.10.0.1")
    do address(out, "1.2.3")
    do address(out, "1.2.3.4.5")
    do address(out, "256.1.1.1")
    do address(out, "01.2.3.4")
    do address(out, "1.02.3.4")
    do address(out, "1.2.3.04")
    do address(out, "1..2.3")
    do address(out, " 1.2.3.4")
    do address(out, "1.2.3.4 ")
    do address(out, "1.2.3.4.")
    do address(out, "0x7f.0.0.1")
    do address(out, "+1.2.3.4")
    do address(out, "1.2.3.-4")
    do address(out, "a.b.c.d")
    do address(out, "")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
[192.168.1.20]: 3232235796
[0.0.0.0]: 0
[127.0.0.1]: 2130706433
[255.255.255.255]: 4294967295
[0.10.0.1]: 655361
[1.2.3]: refused
[1.2.3.4.5]: refused
[256.1.1.1]: refused
[01.2.3.4]: refused
[1.02.3.4]: refused
[1.2.3.04]: refused
[1..2.3]: refused
[ 1.2.3.4]: refused
[1.2.3.4 ]: refused
[1.2.3.4.]: refused
[0x7f.0.0.1]: refused
[+1.2.3.4]: refused
[1.2.3.-4]: refused
[a.b.c.d]: refused
[]: refused
----
end
case net: an address is written back as it was read, and its sockaddr carries the port and the address high byte first
libs linux text net
source until ----
func back(out, s):
    let b = linux_buffer(16)
    let at = net_put_address(b, 0, net_ipv4(s).1)
    do text_add_span(out, b, 0, at)
    if text_is(b, 0, at, s): return text_add(out, " as read\n") end
    return text_add(out, " NOT as read\n")
end

func main():
    let out = new_buffer()
    do back(out, "192.168.1.20")
    do back(out, "0.0.0.0")
    do back(out, "255.255.255.255")
    do back(out, "10.0.0.1")
    -- Family 2 in two bytes, low byte first; port 8080 is 31 * 256 + 144; then the address; then eight zeros.
    let b = linux_buffer(16)
    do buffer_set(b, 15, 9)
    do net_sockaddr(b, net_ipv4("192.168.1.20").1, 8080)
    let i = 0
    while i < 16:
        if i != 0: do text_add(out, " ") end
        do text_add_whole(out, buffer_get(b, i))
        i = i + 1
    end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
192.168.1.20 as read
0.0.0.0 as read
255.255.255.255 as read
10.0.0.1 as read
2 0 31 144 192 168 1 20 0 0 0 0 0 0 0 0
----
end
case net: a port is 1 to 65535 and a time limit 1 to 60000, written plainly; a knock outside them is error 22 and makes no socket
libs linux text net
source until ----
func number(out, what, s, n):
    do text_add(out, what)
    do text_add(out, " [")
    do text_add(out, s)
    if not n.0: return text_add(out, "]: refused\n") end
    do text_add(out, "]: ")
    do text_add_whole(out, n.1)
    return text_add(out, "\n")
end

func port(out, s): return number(out, "port", s, net_port(s)) end
func limit(out, s): return number(out, "limit", s, net_limit(s)) end

func main():
    let out = new_buffer()
    do port(out, "1")
    do port(out, "65535")
    do port(out, "0")
    do port(out, "65536")
    do port(out, "080")
    do port(out, "80 ")
    do port(out, "+80")
    do port(out, "8o")
    do port(out, "")
    do limit(out, "60000")
    do limit(out, "60001")
    do limit(out, "0")
    -- Port 0 is out of range: the knock is an error (outcome 4) before any socket is made.
    let n = net_new()
    do text_add(out, "a knock at port 0: outcome ")
    do text_add_whole(out, net_knock(n, net_ipv4("127.0.0.1").1, 0, 1000))
    do text_add(out, ", error ")
    do text_add_whole(out, n.state.error)
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
port [1]: 1
port [65535]: 65535
port [0]: refused
port [65536]: refused
port [080]: refused
port [80 ]: refused
port [+80]: refused
port [8o]: refused
port []: refused
limit [60000]: 60000
limit [60001]: refused
limit [0]: refused
a knock at port 0: outcome 4, error 22
----
end
case grid map: a walled map is read: its size, where P starts, its dots and its cells, with LF or CRLF line ends
libs linux text grid_map
source until ----
func map(out, s):
    let m = grid_map_parse(linux_cstring(s), length(s), 40, 20)
    do text_add_whole(out, m.status)
    do text_add(out, ": ")
    do text_add_whole(out, m.width)
    do text_add(out, " by ")
    do text_add_whole(out, m.height)
    do text_add(out, ", P at cell ")
    do text_add_whole(out, m.spawn)
    do text_add(out, ", dots ")
    do text_add_whole(out, m.dots)
    do text_add(out, ", cells [")
    do text_add_span(out, m.cells, 0, buffer_length(m.cells))
    return text_add(out, "]\n")
end

func main():
    let out = new_buffer()
    -- Three rows of five; P is the second cell of the second row, cell 6 counting from 0.
    do map(out, "#####\n#P .#\n#####\n")
    do map(out, "#####\r\n#P .#\r\n#####")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
0: 5 by 3, P at cell 6, dots 1, cells [######P .######]
0: 5 by 3, P at cell 6, dots 1, cells [######P .######]
----
end
case grid map: a fault in a map is named in words, with its row and column counted from 1 where it has a place
libs linux text grid_map
source until ----
func fault(out, s):
    let m = grid_map_parse(linux_cstring(s), length(s), 40, 20)
    do text_add_whole(out, m.status)
    do text_add(out, " ")
    do text_add(out, grid_map_error(m.status))
    do text_add(out, ", row ")
    do text_add_whole(out, m.error_row)
    do text_add(out, " column ")
    do text_add_whole(out, m.error_column)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do fault(out, "")
    do fault(out, "##\n##\n")
    do fault(out, "#####\n#P.#\n#####\n")
    do fault(out, "#####\n\n#####\n")
    do fault(out, "#####\n#P x#\n#####\n")
    do fault(out, "## ##\n#P.##\n#####\n")
    do fault(out, "#####\n#PP.#\n#####\n")
    do fault(out, "#####\n# ..#\n#####\n")
    do fault(out, "#####\n#P  #\n#####\n")
    do fault(out, "#####\n#P#.#\n#####\n")
    do fault(out, "###\r###\n###\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
