func show(out, t):
    do text_add(out, "[")
    do text_add_span(out, t.bytes, 0, text_length(t))
    do text_add(out, "] cursor ")
    do text_add_whole(out, text_cursor(t))
    return text_add(out, "\n")
end

func undo(out, t):
    if text_undo(t) == 0: return text_add(out, "nothing to undo\n") end
    do text_add(out, "undo: ")
    return show(out, t)
end

func redo(out, t):
    if text_redo(t) == 0: return text_add(out, "nothing to redo\n") end
    do text_add(out, "redo: ")
    return show(out, t)
end

func main():
