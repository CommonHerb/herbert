case sha256: a span inside a buffer is taken alone, the hex goes where it is asked for, and one Sha256 serves again
libs linux text sha256
source until ----
func main():
    let s = sha256_new()
    let data = linux_cstring("xyzabcxyz")
    do sha256_of(s, data, 3, 3)
    let out = new_buffer()
    do buffer_fill(out, 70, 46)
    let next = sha256_put_hex(s, out, 3)
    do flogger(text_string(out, 0, 70))
    do flogger("\n")
    let line = new_buffer()
    do text_add_whole(line, next)
    do text_add(line, " ")
    do text_add_whole(line, sha256_byte(s, 0))
    do text_add(line, " ")
    do text_add_whole(line, sha256_byte(s, 31))
    do text_add(line, "\n")
    do flogger(freeze(line))
    do sha256_of(s, data, 9, 0)
    do flogger(sha256_hex(s))
    do flogger("\n")
    do process_exit(0)
    return 0
end
