    do text_add_whole(out, names("fault-dirsync.d", ""))
    do text_add(out, ", of them temporary files: ")
    do text_add_whole(out, names("fault-dirsync.d", ".herbert-save-"))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
