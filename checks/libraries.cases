source until ----
func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

-- mkdir (83): a folder called name.
func make(name): return linux_syscall6(83, buffer_address(linux_cstring(name)), 448, 0, 0, 0, 0) end

-- The program run a second time, as "child", in the new process.
func child(out):
    do text_add(out, "the program started: mkdir: ")
    do result(out, make("fault-exec-child.d"))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end

func main():
    let out = new_buffer()
    let args = linux_arguments()
    if equal(linux_argument(args, 1), "child"): return child(out) end
    -- The filter, every mkdir giving 30, is made here; the new process only
    -- puts it on.
    let f = fault_new()
    do fault_fail(f, 83, 30)
    let program = fault_ready(f)
    let here = linux_cstring("./a.out")
    let role = linux_cstring("child")
    let argv = linux_buffer(24)
    do linux_put64(argv, 0, buffer_address(here))
    do linux_put64(argv, 8, buffer_address(role))
    let status = linux_buffer(8)
    -- fork (57); in the new process, killed (9) if this one ends first
    -- (prctl 157, PR_SET_PDEATHSIG 1), then the filter, then execve (59).
    let pid = linux_syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid == 0:
        do linux_syscall6(157, 1, 9, 0, 0, 0, 0)
        if fault_start(program) == 0: do linux_syscall6(59, buffer_address(here), buffer_address(argv), 0, 0, 0, 0) end
        do process_exit(99)
        return 0
    end
    -- wait4 (61) until it ends.
    let waited = linux_syscall6(61, pid, buffer_address(status), 0, 0, 0, 0)
    while waited == 0 - 4: waited = linux_syscall6(61, pid, buffer_address(status), 0, 0, 0, 0) end
    do text_add(out, "it ended with status ")
    do text_add_whole(out, ((linux_u32(status, 0) >> 8) & 255))
    do text_add(out, "\nthe process that started it: mkdir: ")
    do result(out, make("fault-exec-starter.d"))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
