case folder: a folder of the program's own is new, private and named for the process, and a second one takes the next name
libs linux text folder
source until ----
func yes(b):
    if b: return "yes\n" end
    return "no\n"
end

func join(a, b):
    let out = new_buffer()
    do text_add(out, a)
    do text_add(out, b)
    return freeze(out)
end

-- Whether s is "probe-" and then digits only, at least one.
func named(s):
    let front = "probe-"
    if length(s) <= length(front): return false end
    let i = 0
    while i < length(front):
        if index(s, i) != index(front, i): return false end
        i = i + 1
    end
    while i < length(s):
        if not text_digit(index(s, i)): return false end
        i = i + 1
    end
    return true
end

func main():
    let a = folder_own(".", "probe")
    let b = folder_own(".", "probe")
    let line = new_buffer()
    do text_add(line, "made: ")
    do text_add_whole(line, a.0)
    do text_add(line, " ")
    do text_add_whole(line, b.0)
    do text_add(line, "\n")
    do flogger(freeze(line))
    do flogger("its path is the folder given, a slash and its name: ")
    do flogger(yes(equal(a.1, join("./", a.2))))
    do flogger("its name is the stem, a dash and a number: ")
    do flogger(yes(named(a.2)))
    do flogger("the second has the first's name and -2: ")
    do flogger(yes(equal(b.2, join(a.2, "-2"))))
    let stat = linux_buffer(144)
    let found = linux_syscall6(4, buffer_address(linux_cstring(a.1)), buffer_address(stat), 0, 0, 0, 0)
    do flogger("it is a folder only its owner may look in: ")
    do flogger(yes(found == 0 and linux_u32(stat, 24) == 16384 + 448))
    let c = folder_own("./no-such-folder", "probe")
    do flogger("under a folder that is not there, error 2 and no path: ")
    do flogger(yes(c.0 == 0 - 2 and length(c.1) == 0 and length(c.2) == 0))
    do process_exit(0)
    return 0
end
----
