-- The document, a first checkpoint and the edit: UTF-8 text with CR LF.
func document(): return "café — é 😀\r\ntext" end
func checkpoint(): return "café — é 😀\r\ntext\r\n" end
func edit(): return "café — é 😀\r\ntext\r\n!" end

-- A first checkpoint of doc.txt, in a folder of its own, then a second, the
-- edit, by a new process given a filter between the two: kind 1 fails every
-- fsync (74) with EIO (5), kind 2 only the fsync of the session folder, the
-- snapshot File's directory descriptor. The new process ends with 100 plus
-- the second checkpoint's result; the folders are looked at here, where there
-- is no filter.
func trial(out, label, folder, kind):
    do linux_syscall6(83, buffer_address(linux_cstring(folder)), 448, 0, 0, 0, 0)
    let path = within(folder, "doc.txt")
    do write_file(path, document())
    let before = inode(path)
    let status = linux_buffer(8)
    -- fork (57); the new process is killed (9) if this one ends first (prctl
    -- 157, PR_SET_PDEATHSIG 1).
    let pid = linux_syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid == 0:
        do linux_syscall6(157, 1, 9, 0, 0, 0, 0)
        let f = file_open(path, 64)
        let r = recovery_new(64)
        let first = recovery_save(r, f, linux_cstring(checkpoint()), length(checkpoint()))
        let snapshot = r.0
        let fault = fault_new()
        if kind == 1: do fault_fail(fault, 74, 5) end
        if kind == 2: do fault_fail_equal(fault, 74, 5, 0, snapshot.state.dirfd) end
        if file_status(f) != 0 or first != 0 or fault_start(fault_ready(fault)) != 0: do process_exit(1) end
        do process_exit(100 + recovery_save(r, f, linux_cstring(edit()), length(edit())))
        return 0
    end
    -- wait4 (61) until it ends.
    let waited = linux_syscall6(61, pid, buffer_address(status), 0, 0, 0, 0)
    while waited == 0 - 4: waited = linux_syscall6(61, pid, buffer_address(status), 0, 0, 0, 0) end
    let st = linux_u32(status, 0)
    do text_add(out, label)
    do text_add(out, ": ")
    if (st & 127) != 0:
        do text_add(out, "stopped by signal ")
        do text_add_whole(out, (st & 127))
    else:
        do result(out, ((st >> 8) & 255) - 100)
    end
    if holds(path, document()) and inode(path) == before: do text_add(out, ", the document as it was") end
    let sessions = names(folder, ".herbert-notes-")
    do text_add(out, ", session folders ")
    do text_add_whole(out, sessions.0)
    let session = within(folder, sessions.1)
    if holds(within(session, "recovery.txt"), checkpoint()): do text_add(out, ", the first checkpoint") end
    if holds(within(session, "recovery.txt"), edit()): do text_add(out, ", the edit") end
    do text_add(out, ", temporary ")
    do text_add_whole(out, names(session, ".herbert-save-").0)
    do text_add(out, "\n")
    return 0
end

func main():
    let out = new_buffer()
    do trial(out, "fsync EIO", "fault-recovery-fsync.d", 1)
    do trial(out, "the session folder's fsync EIO", "fault-recovery-folder.d", 2)
    do trial(out, "nothing failed", "fault-recovery-none.d", 0)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
