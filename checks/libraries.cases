case file: file_scan lists a folder of 1500 other names over several reads and counts and names the session folders wherever they fall
libs linux text file_io
source until ----
-- Linux's mkdir (83).
func make_folder(path):
    return linux_syscall6(83, buffer_address(linux_cstring(path)), 448, 0, 0, 0, 0)
end

-- What is at path given the modification time seconds (Linux's utimensat, 280, from the current
-- folder, -100).
func set_time(path, seconds):
    let times = linux_buffer(32)
    do linux_put64(times, 0, seconds)
    do linux_put64(times, 16, seconds)
    return linux_syscall6(280, 0 - 100, buffer_address(linux_cstring(path)), buffer_address(times), 0, 0, 0)
end

-- many6.d/ and n empty files with long names, from the number first.
func fill(first, n):
    let i = first
    while i < first + n:
        let b = new_buffer()
        do text_add(b, "many6.d/unrelated-entry-with-a-longish-name-")
        do text_add_whole(b, 10000 + i)
        do linux_close(linux_open(linux_cstring(freeze(b)), 577, 420))
        i = i + 1
    end
    return 0
end

func scan(out, f, s):
    do text_add_whole(out, file_scan(f, s, ".herbert-notes-"))
    do text_add(out, " [")
    let name = file_scan_name(s)
    do text_add_span(out, name, 0, linux_nul_end(name, 0, buffer_length(name)))
    return text_add(out, "]\n")
end

func main():
    do make_folder("many6.d")
    -- Three session folders made among 1500 other names, each about 64 bytes of listing: a read of
    -- 32 KiB holds about 500. A plain file wears the prefix too, with the latest time of all.
    do make_folder("many6.d/.herbert-notes-1-1")
    do fill(0, 500)
    do make_folder("many6.d/.herbert-notes-2-1")
    do fill(500, 500)
    do linux_close(linux_open(linux_cstring("many6.d/.herbert-notes-9-9"), 577, 420))
    do fill(1000, 500)
    do make_folder("many6.d/.herbert-notes-3-1")
    do set_time("many6.d/.herbert-notes-1-1", 1000)
    do set_time("many6.d/.herbert-notes-2-1", 3000)
    do set_time("many6.d/.herbert-notes-3-1", 2000)
    do set_time("many6.d/.herbert-notes-9-9", 9000)
    let f = file_open("many6.d/doc.txt", 64)
    let s = file_scan_new()
    let out = new_buffer()
    do scan(out, f, s)
    do scan(out, f, s)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
