case display: an unsupported cluster is one marker, a box with ink inside it
libs linux text pixel_text utf8 unicode_display
source until ----
func hex_digit(c):
    if c <= 57: return c - 48 end
    return c - 55
end

-- The scalars s names in hex, a space between them, as UTF-8 bytes.
func scalars(s):
    let b = new_buffer()
    let one = linux_buffer(4)
    let cp = 0
    let i = 0
    while i <= length(s):
        if i == length(s) or index(s, i) == 32:
            do text_add_span(b, one, 0, utf8_store(one, 0, cp))
            cp = 0
        else:
            cp = cp * 16 + hex_digit(index(s, i))
        end
        i = i + 1
    end
    return b
end

-- Of the cluster s in its cell of 5 columns by 10 rows: how many of the 26 cells round the edge
-- have ink, and how many of the 24 inside.
func marker(out, s):
    let b = scalars(s)
    let shape = unicode_display_shape(b, 0, buffer_length(b))
    let edge = 0
    let inside = 0
    let i = 0
    while i < 50:
        if unicode_display_ink(shape.0, shape.1, shape.2, i):
            if i / 5 == 0 or i / 5 == 9 or i % 5 == 0 or i % 5 == 4: edge = edge + 1 else: inside = inside + 1 end
        end
        i = i + 1
    end
    do text_add(out, s)
    do text_add(out, ": edge ")
    do text_add_whole(out, edge)
    if inside > 0 and inside < 24: return text_add(out, ", some ink inside\n") end
    return text_add(out, ", inside empty or full\n")
end

func main():
    let out = new_buffer()
    -- A CJK character; an emoji family of five scalars; e with a macron, a letter with a mark not drawn.
    do marker(out, "4E2D")
    do marker(out, "1F468 200D 1F469 200D 1F467")
    do marker(out, "65 304")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
4E2D: edge 26, some ink inside
1F468 200D 1F469 200D 1F467: edge 26, some ink inside
65 304: edge 26, some ink inside
----
end
