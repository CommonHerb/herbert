func report(out, s):
    let n = text_whole_strict(linux_cstring(s), 0, length(s))
    do text_add(out, s)
    if n.0:
        do text_add(out, ": number ")
        do text_add_whole(out, n.1)
        do text_add(out, " next ")
        do text_add_whole(out, n.2)
    else:
        do text_add(out, ": refused, value ")
        do text_add_whole(out, n.1)
    end
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do report(out, "0")
    do report(out, "07")
    do report(out, "70")
    do report(out, "00")
    do report(out, "0x")
    do report(out, "x")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
