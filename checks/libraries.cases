func report(out, b, f):
    do text_add_whole(out, f.0)
    do text_add(out, "..")
    do text_add_whole(out, f.1)
    do text_add(out, " [")
    do text_add_span(out, b, f.0, f.1 - f.0)
    return text_add(out, "]\n")
end

func main():
    let b = linux_cstring("  alpha\tbeta  ")
    let out = new_buffer()
    let first = text_field(b, 0, 14)
    do report(out, b, first)
    let second = text_field(b, first.1, 14)
    do report(out, b, second)
    do report(out, b, text_field(b, second.1, 14))
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
