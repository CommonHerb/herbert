func main():
    let t = text_buffer(64)
    do text_insert(t, 'a')
    do text_insert(t, 'b')
    do text_insert(t, 'c')
    do text_undo(t)
    do text_undo(t)
    let out = new_buffer()
    do show(out, t)
    -- Escape is refused, so b can still be redone.
    do text_insert(t, 27)
    do redo(out, t)
    -- x is taken, so c cannot.
    do text_insert(t, 'x')
    do redo(out, t)
    do show(out, t)
    -- And c is gone from the history too: undo steps back through x, b and a.
    do text_undo(t)
    do show(out, t)
    do text_undo(t)
    do show(out, t)
    do text_undo(t)
    do show(out, t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
