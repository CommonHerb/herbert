    if linux_error(saved):
        do text_add(out, "error ")
        do text_add_whole(out, 0 - saved)
        do text_add(out, "\n")
    end
    if holds("dated.txt", "a longer text from outside\n"): do text_add(out, "the outside text is whole\n") end
    do flogger(freeze(out))
    do process_exit(0)
