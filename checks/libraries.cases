    let out = new_buffer()
    do text_add(out, "columns at 0 2 5 9 12 13:")
    do column(out, t, 0)
    do column(out, t, 2)
    do column(out, t, 5)
    do column(out, t, 9)
    do column(out, t, 12)
    do column(out, t, 13)
    do text_add(out, "\ncolumn at 10, inside the accented e:")
    do column(out, t, 10)
    -- a, tab, b, tab, tab, c: the columns of the seven places from the start to the end.
    do text_load(t, linux_cstring("a\tb\t\tc"), 6)
    do text_add(out, "\nwith tabs:")
    let p = 0
    while p <= 6:
        do column(out, t, p)
        p = p + 1
    end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
