libs linux text pixel_text utf8 unicode_display
source until ----
func hex_digit(c):
    if c <= 57: return c - 48 end
    return c - 55
end

-- How many of the scalars s names in hex, a space between them, have a glyph; the count of them is added to out.
func glyphs(out, s):
    let b = linux_buffer(4)
    let have = 0
    let all = 0
    let cp = 0
    let i = 0
    while i <= length(s):
        if i == length(s) or index(s, i) == 32:
            if unicode_display_supported(b, 0, utf8_store(b, 0, cp)): have = have + 1 end
            all = all + 1
            cp = 0
        else:
            cp = cp * 16 + hex_digit(index(s, i))
        end
        i = i + 1
    end
    do text_add_whole(out, have)
    do text_add(out, " of ")
    do text_add_whole(out, all)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- docs/UNICODE.md: six typographic quotes, en and em dash, bullet, ellipsis, euro, five arrows,
    -- minus, not-equal, at-most and at-least.
    do glyphs(out, "2018 2019 201A 201C 201D 201E 2013 2014 2022 2026 20AC 2190 2191 2192 2193 2194 2212 2260 2264 2265")
    -- A quote the guide does not name, a Greek and a Cyrillic letter, a CJK character, an emoji.
    do glyphs(out, "201B 3A9 416 4E2D 1F600")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
