case utf8: nothing past U+10FFFF is read
libs linux text utf8
source until ----
func hex_digit(c):
    if c <= 57: return c - 48 end
    return c - 55
end

-- The bytes s names in hex: two digits a byte, a space between bytes.
func hex(s):
    let b = new_buffer()
    let i = 0
    while i + 1 < length(s):
        do append(b, hex_digit(index(s, i)) * 16 + hex_digit(index(s, i + 1)))
        i = i + 3
    end
    return b
end

func report(out, s):
    let b = hex(s)
    let r = utf8_decode(b, 0, buffer_length(b))
    do text_add(out, s)
    if linux_error(r.0):
        do text_add(out, ": refused, error ")
        do text_add_whole(out, 0 - r.0)
        do text_add(out, " at ")
    else:
        do text_add(out, ": scalar ")
        do text_add_whole(out, r.0)
        do text_add(out, " next ")
    end
    do text_add_whole(out, r.1)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do report(out, "F4 8F BF BF")
    do report(out, "F4 90 80 80")
    do report(out, "F5 80 80 80")
    do report(out, "F8 88 80 80 80")
    do report(out, "FE")
    do report(out, "FF")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
