case net: a reading knock stops at a full reply or at its time limit, a knock on a computer that never answers stops at its limit, neither waits when looked at, and none sends a byte
libs linux text net
source until ----
-- The case plays the other computers on this one: at 127.77.0.1 a listener it accepts from, and at
-- 127.77.0.3 a black hole (a listener whose queue of one is full and never taken from, so Linux drops every
-- further connection to it without a word). Ports are the first free from 47700.
ref record Lab:
    poll: buffer
    clock: buffer
    sa: buffer
    size: buffer
    one: buffer
    got: buffer
    port: int
end

-- A socket bound at address to the first free port from 47700, listening with that queue when listen.
func socket_at(lab, address, listen, queue):
    let fd = linux_socket(2, 1 | 524288, 6)
    if listen: do linux_set_option(fd, 1, 2, lab.one, 1) end
    let port = 47700
    while port < 47800:
        do net_sockaddr(lab.sa, address, port)
        if linux_bind(fd, lab.sa, 16) == 0 and (not listen or linux_listen(fd, queue) == 0):
            lab.port = port
            return fd
        end
        port = port + 1
    end
    do linux_die("no free port from 47700 to 47799\n")
    return 0
end

-- The next connection on a listener, waiting at most 2 seconds: its descriptor, or an error.
func take(lab, fd):
    let ready = linux_poll(fd, lab.poll, 1, 2000)
    if ready == 0 or linux_error(ready): return 0 - 110 end
    do linux_put32(lab.size, 0, 16)
    return linux_accept(fd, lab.sa, lab.size, 2048 | 524288)
end

-- The black hole: a listener with a queue of one, filled with connections of the case's own from
-- 127.77.0.4 until one is not taken within 300 ms (that one is closed). Its port is lab.port.
func hole(lab, address):
    let fd = socket_at(lab, address, true, 0)
    let k = 0
    while k < 8:
        let filler = linux_socket(2, 1 | 2048 | 524288, 6)
        do net_sockaddr(lab.sa, net_ipv4("127.77.0.4").1, 0)
        do linux_bind(filler, lab.sa, 16)
        do net_sockaddr(lab.sa, address, lab.port)
        do linux_connect(filler, lab.sa, 16)
        if linux_poll(filler, lab.poll, 4, 300) == 0:
            do linux_close(filler)
            return fd
        end
        k = k + 1
    end
    do linux_die("no black hole: eight connections were all taken into a queue of one\n")
    return 0
end

-- Scope's way of waiting for a knock begun without waiting: poll its socket, then look.
func finish(lab, n):
    let o = 5
    while o == 5:
        do linux_poll(n.state.fd, lab.poll, n.state.events, net_left(n))
        o = net_check(n)
    end
    return o
end


-- Ten looks at a knock under way, each timed.
func looks(out, lab, n):
    let slow = 0
    let ended = 0
    let k = 0
    while k < 10:
        let before = linux_clock_us(lab.clock)
        if net_check(n) != 5: ended = ended + 1 end
        if linux_clock_us(lab.clock) - before >= 50000: slow = slow + 1 end
        k = k + 1
    end
    do text_add(out, "; 10 looks, ")
    do text_add_whole(out, slow)
    do text_add(out, " slow, ")
    do text_add_whole(out, ended)
    return text_add(out, " ended")
end

func how(out, n, o):
    do text_add(out, ": ")
    do text_add(out, net_outcome_name(o))
    do text_add(out, ", error ")
    return text_add_whole(out, n.state.error)
end

func between(out, n, low, high):
    let e = n.state.elapsed
    if e >= low and e <= high:
        do text_add(out, ", ")
        do text_add_whole(out, low)
        do text_add(out, " to ")
        do text_add_whole(out, high)
        return text_add(out, " ms")
    end
    do text_add(out, ", in ")
    do text_add_whole(out, e)
    return text_add(out, " ms")
end

-- What a reading knock read: how many bytes, and xs of them the byte x when that is not all of them.
func read(out, n, xs):
    do text_add(out, ", got ")
    do text_add_whole(out, n.state.got)
    if xs == n.state.got and xs != 0: do text_add(out, " x") end
    if xs != n.state.got:
        do text_add(out, ", ")
        do text_add_whole(out, xs)
        do text_add(out, " of them x")
    end
    if n.state.closed: return text_add(out, ", closed") end
    return text_add(out, ", not closed")
end

-- What the case's end of a knock's connection hears once the knock has ended: the knock's close (end of
-- file, or a reset when it closed with bytes it never read), and never a byte ("N bytes came").
func far(out, lab, fd):
    do text_add(out, "; far end: ")
    if linux_poll(fd, lab.poll, 1, 1000) == 0:
        do text_add(out, "still open\n")
    else:
        let r = linux_receive(fd, lab.got, 0, 512, 64)
        if r == 0:
            do text_add(out, "end of file\n")
        elif r == 0 - 104:
            do text_add(out, "a reset\n")
        elif linux_error(r):
            do text_add(out, "Linux error ")
            do text_add_whole(out, 0 - r)
            do text_add(out, "\n")
        else:
            do text_add_whole(out, r)
            do text_add(out, " bytes came\n")
        end
    end
    return linux_close(fd)
end

func main():
    let lab = Lab(linux_buffer(8), linux_buffer(16), linux_buffer(16), linux_buffer(8), linux_buffer(8), linux_buffer(512), 0)
    let out = new_buffer()
    let n = net_new()
    let here = net_ipv4("127.77.0.1").1
    let talker = socket_at(lab, here, true, 16)
    let port = lab.port
    let away = net_ipv4("127.77.0.3").1
    let silent = hole(lab, away)
    let deaf = lab.port
    -- A knock that waits, answered.
    do text_add(out, "listener")
    do how(out, n, net_knock(n, here, port, 5000))
    do far(out, lab, take(lab, talker))
    -- A reading knock on a computer that sends 300 bytes and keeps the connection: it stops at its 256.
    do net_start_reading(n, here, port, 5000)
    let peer = take(lab, talker)
    let x = linux_buffer(300)
    let i = 0
    while i < 300:
        do buffer_set(x, i, 120)
        i = i + 1
    end
    do linux_send(peer, x, 0, 300, 16384)
    do text_add(out, "300 bytes")
    do how(out, n, finish(lab, n))
    let xs = 0
    i = 0
    while i < 256:
        if buffer_get(n.reply, i) == 120: xs = xs + 1 end
        i = i + 1
    end
    do read(out, n, xs)
    do between(out, n, 0, 999)
    do far(out, lab, peer)
    -- A reading knock on a computer that takes the connection and says nothing, limit 300 ms.
    do net_start_reading(n, here, port, 300)
    peer = take(lab, talker)
    do text_add(out, "silence")
    do looks(out, lab, n)
    do how(out, n, finish(lab, n))
    do read(out, n, 0)
    do between(out, n, 300, 400)
    do far(out, lab, peer)
    -- The black hole, limit 300 ms: through net_knock, and through net_start with looks.
    do text_add(out, "black hole")
    do how(out, n, net_knock(n, away, deaf, 300))
    do between(out, n, 300, 400)
    do text_add(out, "\nblack hole, begun: ")
    do text_add_whole(out, net_start(n, away, deaf, 300))
    do looks(out, lab, n)
    do how(out, n, finish(lab, n))
    do between(out, n, 300, 400)
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
listener: answered, error 0; far end: end of file
300 bytes: answered, error 0, got 256 x, not closed, 0 to 999 ms; far end: a reset
silence; 10 looks, 0 slow, 0 ended: answered, error 0, got 0, not closed, 300 to 400 ms; far end: end of file
black hole: no answer, error 0, 300 to 400 ms
black hole, begun: 5; 10 looks, 0 slow, 0 ended: no answer, error 0, 300 to 400 ms
----
end
case net: a reading knock on a computer that sends a line and ends its side, or sends two bytes and resets, ends answered, closes its socket and sends nothing
libs linux text net
source until ----
-- The case plays the other computer on this one: a listener at 127.77.0.1, on the first free port from 47700.
ref record Lab:
    poll: buffer
    sa: buffer
    size: buffer
    one: buffer
    got: buffer
    linger: buffer
    null: buffer
    port: int
end

func listener(lab, address):
    let fd = linux_socket(2, 1 | 524288, 6)
    do linux_set_option(fd, 1, 2, lab.one, 1)
    let port = 47700
    while port < 47800:
        do net_sockaddr(lab.sa, address, port)
        if linux_bind(fd, lab.sa, 16) == 0 and linux_listen(fd, 16) == 0:
            lab.port = port
            return fd
        end
        port = port + 1
    end
    do linux_die("no free port from 47700 to 47799\n")
    return 0
end

-- The next connection on the listener, waiting at most 2 seconds: its descriptor, or an error.
func take(lab, fd):
    let ready = linux_poll(fd, lab.poll, 1, 2000)
    if ready == 0 or linux_error(ready): return 0 - 110 end
    do linux_put32(lab.size, 0, 16)
    return linux_accept(fd, lab.sa, lab.size, 2048 | 524288)
end

-- Scope's way of waiting for a knock begun without waiting: poll its socket, then look.
func finish(lab, n):
    let o = 5
    while o == 5:
        do linux_poll(n.state.fd, lab.poll, n.state.events, net_left(n))
        o = net_check(n)
    end
    return o
end

-- The lowest free descriptor: a socket a knock kept would hold it.
func lowest(lab):
    let fd = linux_open(lab.null, 0, 0)
    do linux_close(fd)
    return fd
end

func how(out, n, o):
    do text_add(out, ": ")
    do text_add(out, net_outcome_name(o))
    do text_add(out, ", error ")
    do text_add_whole(out, n.state.error)
    if n.state.closed: return text_add(out, ", closed") end
    return text_add(out, ", not closed")
end

func main():
    let lab = Lab(linux_buffer(8), linux_buffer(16), linux_buffer(8), linux_buffer(8), linux_buffer(512), linux_buffer(8),
                  linux_cstring("/dev/null"), 0)
    let out = new_buffer()
    let n = net_new()
    let here = net_ipv4("127.77.0.1").1
    let talker = listener(lab, here)
    -- "hello" and a newline, then the end of its side (shutdown, call 48, its sending half), the connection kept:
    -- the knock reads the line and the end and closes, and the far end then hears that end and not a byte.
    do net_start_reading(n, here, lab.port, 5000)
    let peer = take(lab, talker)
    do linux_send(peer, linux_cstring("hello\n"), 0, 6, 16384)
    do linux_syscall6(48, peer, 1, 0, 0, 0, 0)
    do text_add(out, "a line, then its end")
    do how(out, n, finish(lab, n))
    do text_add(out, ", got ")
    do text_add_whole(out, n.state.got)
    do text_add(out, "; far end: ")
    if linux_poll(peer, lab.poll, 1, 1000) == 0:
        do text_add(out, "still open\n")
    else:
        let r = linux_receive(peer, lab.got, 0, 512, 64)
        if r == 0:
            do text_add(out, "end of file\n")
        elif linux_error(r):
            do text_add(out, "Linux error ")
            do text_add_whole(out, 0 - r)
            do text_add(out, "\n")
        else:
            do text_add_whole(out, r)
            do text_add(out, " bytes came\n")
        end
    end
    do linux_close(peer)
    -- Two bytes, then a reset (SO_LINGER on, 0 seconds, then close) once the knock is reading: it ends answered with
    -- error 104 (ECONNRESET) and closes its socket.
    let free = lowest(lab)
    do net_start_reading(n, here, lab.port, 5000)
    peer = take(lab, talker)
    do text_add(out, "two bytes, then a reset")
    if net_check(n) != 5 or n.state.events != 1: do text_add(out, " (the knock was not reading yet)") end
    do linux_send(peer, linux_cstring("ab"), 0, 2, 16384)
    do linux_put32(lab.linger, 0, 1)
    do linux_put32(lab.linger, 4, 0)
    do linux_syscall6(54, peer, 1, 13, buffer_address(lab.linger), 8, 0)
    do linux_close(peer)
    do how(out, n, finish(lab, n))
    if lowest(lab) == free: do text_add(out, ", its socket closed\n") else: do text_add(out, ", its socket left open\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
a line, then its end: answered, error 0, closed, got 6; far end: end of file
two bytes, then a reset: answered, error 104, not closed, its socket closed
----
end
case net: Scope's reading knock made thousands of times, on a computer that answers, one that refuses, one that never answers and with no network, leaves no socket open and takes no more memory
libs linux text net fault
source until ----
-- The case plays the other computers on this one: at 127.77.0.1 a listener it accepts from, at 127.77.0.2
-- a socket bound to a port and not listening (it refuses), and at 127.77.0.3 a black hole (a listener whose
-- queue of one is full and never taken from, so Linux drops every further connection to it without a word).
-- Ports are the first free from 47700. Everything the rounds use is made before them, and the looks at the
-- descriptors and the memory read into buffers made then too. Last, Linux fails every connect at once with
-- ENETUNREACH (101), as on a computer with no network, and the knocks go on.
ref record Lab:
    poll: buffer
    clock: buffer
    sa: buffer
    size: buffer
    one: buffer
    got: buffer
    line: buffer
    null: buffer
    status: buffer
    rollup: buffer
    port: int
end

-- A socket bound at address to the first free port from 47700, listening with that queue when listen.
func socket_at(lab, address, listen, queue):
    let fd = linux_socket(2, 1 | 524288, 6)
    if listen: do linux_set_option(fd, 1, 2, lab.one, 1) end
    let port = 47700
    while port < 47800:
        do net_sockaddr(lab.sa, address, port)
        if linux_bind(fd, lab.sa, 16) == 0 and (not listen or linux_listen(fd, queue) == 0):
            lab.port = port
            return fd
        end
        port = port + 1
    end
    do linux_die("no free port from 47700 to 47799\n")
    return 0
end

-- The next connection on a listener, waiting at most 2 seconds: its descriptor, or an error.
func take(lab, fd):
    let ready = linux_poll(fd, lab.poll, 1, 2000)
    if ready == 0 or linux_error(ready): return 0 - 110 end
    do linux_put32(lab.size, 0, 16)
    return linux_accept(fd, lab.sa, lab.size, 2048 | 524288)
end

-- The black hole: a listener with a queue of one, filled with connections of the case's own from
-- 127.77.0.4 until one is not taken within 300 ms (that one is closed). Its port is lab.port.
func hole(lab, address):
    let fd = socket_at(lab, address, true, 0)
    let k = 0
    while k < 8:
        let filler = linux_socket(2, 1 | 2048 | 524288, 6)
        do net_sockaddr(lab.sa, net_ipv4("127.77.0.4").1, 0)
        do linux_bind(filler, lab.sa, 16)
        do net_sockaddr(lab.sa, address, lab.port)
        do linux_connect(filler, lab.sa, 16)
        if linux_poll(filler, lab.poll, 4, 300) == 0:
            do linux_close(filler)
            return fd
        end
        k = k + 1
    end
    do linux_die("no black hole: eight connections were all taken into a queue of one\n")
    return 0
end

-- Scope's way of waiting for a knock begun without waiting: poll its socket, then look.
func finish(lab, n):
    let o = 5
    while o == 5:
        do linux_poll(n.state.fd, lab.poll, n.state.events, net_left(n))
        o = net_check(n)
    end
    return o
end

func knock(lab, n, address, port, limit):
    do net_start_reading(n, address, port, limit)
    return finish(lab, n)
end

-- The lowest free descriptor: a socket a knock kept would hold it.
func lowest(lab):
    let fd = linux_open(lab.null, 0, 0)
    do linux_close(fd)
    return fd
end

-- The number after name at the start of a line of the file at path (a size in KiB). A file that cannot be read,
-- or has no such line, ends the case with a message, so no figure is ever taken for 0.
func number(lab, path, name):
    let fd = linux_open(path, 0, 0)
    if linux_error(fd): return linux_die("the case could not read its memory in /proc/self\n") end
    let n = 0
    let more = true
    while more and n < buffer_length(lab.got):
        let r = linux_read(fd, lab.got, n, buffer_length(lab.got) - n)
        if r == 0 or linux_error(r): more = false else: n = n + r end
    end
    do linux_close(fd)
    let at = 0
    while at < n:
        if text_starts(lab.got, at, n, name): return text_whole(lab.got, text_skip(lab.got, at + length(name), n), n).1 end
        while at < n and buffer_get(lab.got, at) != 10: at = at + 1 end
        at = at + 1
    end
    return linux_die("the case found no memory figure in /proc/self\n")
end

-- What the looks at the long run found: the lowest free descriptor before it, the size and the least and
-- most resident memory from the first look on, and how many looks found the descriptor or the size moved.
ref record Seen:
    free: int
    vm: int
    low: int
    high: int
    looks: int
    fds: int
    vms: int
end

func look(lab, seen):
    let f = lowest(lab)
    let v = number(lab, lab.status, "VmSize:")
    let rss = number(lab, lab.rollup, "Rss:")
    if seen.looks == 0:
        seen.vm = v
        seen.low = rss
        seen.high = rss
    end
    seen.looks = seen.looks + 1
    if f != seen.free: seen.fds = seen.fds + 1 end
    if v != seen.vm: seen.vms = seen.vms + 1 end
    if rss < seen.low: seen.low = rss end
    if rss > seen.high: seen.high = rss end
    return 0
end

func main():
    let lab = Lab(linux_buffer(8), linux_buffer(16), linux_buffer(16), linux_buffer(8), linux_buffer(8), linux_buffer(16384),
                  linux_cstring("hello\n"), linux_cstring("/dev/null"), linux_cstring("/proc/self/status"),
                  linux_cstring("/proc/self/smaps_rollup"), 0)
    let n = net_new()
    let here = net_ipv4("127.77.0.1").1
    let talker = socket_at(lab, here, true, 16)
    let port = lab.port
    let shut = net_ipv4("127.77.0.2").1
    let refuser = socket_at(lab, shut, false, 0)
    let shut_port = lab.port
    let away = net_ipv4("127.77.0.3").1
    let silent = hole(lab, away)
    let deaf = lab.port
    let out = new_buffer()
    let peer = 0
    -- The long run: Scope's reading knock on the listener (which sends a line and closes), the refusing
    -- port and the black hole at 1 ms, looking every 1,000 rounds; then with every connect failed at once by
    -- Linux (ENETUNREACH, 101), as on a computer with no network. A knock that kept 8 bytes more each time
    -- on one path alone would grow by about 34 bytes a round, past 200 KiB in the 7,000 rounds after the
    -- first look.
    let seen = Seen(lowest(lab), 0, 0, 0, 0, 0, 0)
    let f = fault_new()
    do fault_fail(f, 42, 101)
    let program = fault_ready(f)
    let rounds = 8000
    let answered = 0
    let refused = 0
    let unanswered = 0
    let other = 0
    let r = 1
    while r <= rounds:
        do net_start_reading(n, here, port, 5000)
        peer = take(lab, talker)
        do linux_send(peer, lab.line, 0, 6, 16384)
        do linux_close(peer)
        if finish(lab, n) == 0 and n.state.error == 0 and n.state.got == 6 and n.state.closed: answered = answered + 1 else: other = other + 1 end
        if knock(lab, n, shut, shut_port, 5000) == 1: refused = refused + 1 else: other = other + 1 end
        if knock(lab, n, away, deaf, 1) == 2: unanswered = unanswered + 1 else: other = other + 1 end
        if r % 1000 == 0: do look(lab, seen) end
        r = r + 1
    end
    do text_add(out, "8000 rounds: answered with the line and closed ")
    do text_add_whole(out, answered)
    do text_add(out, ", refused ")
    do text_add_whole(out, refused)
    do text_add(out, ", no answer ")
    do text_add_whole(out, unanswered)
    do text_add(out, ", anything else ")
    do text_add_whole(out, other)
    let unreachable = 0
    other = 0
    if fault_start(program) == 0:
        r = 1
        while r <= rounds:
            if knock(lab, n, here, port, 5000) == 3 and n.state.error == 101: unreachable = unreachable + 1 else: other = other + 1 end
            if r % 1000 == 0: do look(lab, seen) end
            r = r + 1
        end
    end
    do text_add(out, "\nwith every connect failed at once: unreachable ")
    do text_add_whole(out, unreachable)
    do text_add(out, ", anything else ")
    do text_add_whole(out, other)
    do text_add(out, "\nlooks: ")
    do text_add_whole(out, seen.looks)
    do text_add(out, ", at which the lowest free descriptor had moved: ")
    do text_add_whole(out, seen.fds)
    do text_add(out, ", at which the size had changed: ")
    do text_add_whole(out, seen.vms)
    if seen.high - seen.low <= 64:
        do text_add(out, "\nresident memory within 64 KiB")
    else:
        do text_add(out, "\nresident memory grew by ")
        do text_add_whole(out, seen.high - seen.low)
        do text_add(out, " KiB")
    end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
