stdout until ----
254 letters typed: 255 steps undone, left [x]
255 letters typed: 255 steps undone, left [y]
----
end
case text buffer: undo in a CRLF text gives back the file's bytes and their count exactly
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- The file's bytes, a carriage return shown as \r and a newline as \n.
func file(out, what, t):
    do text_add(out, what)
    do text_add(out, ", ")
    do text_add_whole(out, text_file_length(t))
    do text_add(out, " bytes: ")
    let b = text_file_bytes(t)
    let i = 0
    while i < text_file_length(t):
        let ch = buffer_get(b, i)
        if ch == 13: do text_add(out, "\\r") elif ch == 10: do text_add(out, "\\n") else: do append(out, ch) end
        i = i + 1
    end
    return text_add(out, "\n")
end

func main():
    let t = text_buffer(64)
    do text_load(t, linux_cstring("a\r\nb\r\nc"), 7)
    let out = new_buffer()
    do file(out, "loaded", t)
    do text_seek(t, 1)
    do text_delete(t)
    do file(out, "first newline deleted", t)
    do text_undo(t)
    do file(out, "undone", t)
    -- The text is a, newline, b, newline, c: both newlines and the b between them are 1..4.
    do text_replace(t, 1, 4, linux_cstring("-"), 0, 1)
    do file(out, "two newlines and b replaced", t)
    do text_undo(t)
    do file(out, "undone", t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
loaded, 7 bytes: a\r\nb\r\nc
first newline deleted, 5 bytes: ab\r\nc
undone, 7 bytes: a\r\nb\r\nc
two newlines and b replaced, 3 bytes: a-c
undone, 7 bytes: a\r\nb\r\nc
----
end
case text buffer: a flag letter typed before two flags pairs them anew, and undo puts the pairs back
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- Where the cursor is, and every place it can stand, from the start to the end.
func places(out, what, t):
    do text_add(out, what)
    do text_add(out, ": cursor ")
    do text_add_whole(out, text_cursor(t))
    do text_add(out, ", places 0")
    let p = 0
    while p < text_length(t):
        p = text_next(t, p)
        do text_add(out, " ")
        do text_add_whole(out, p)
    end
    return text_add(out, "\n")
end

func main():
    -- Four regional indicators, D E F R, four bytes each: two flags.
    let b = linux_buffer(16)
    do utf8_store(b, 0, 127465)
    do utf8_store(b, 4, 127466)
    do utf8_store(b, 8, 127467)
    do utf8_store(b, 12, 127479)
    let t = text_buffer(64)
    do text_load(t, b, 16)
    let out = new_buffer()
    do places(out, "two flags", t)
    -- The indicator A typed at the start: now A D, E F, and R alone. The cursor, sent to 4, would be
    -- inside the first pair, so it goes on to the pair's end.
    do text_insert(t, 127462)
    do places(out, "A typed in front", t)
    do text_undo(t)
    do places(out, "undone", t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
two flags: cursor 0, places 0 8 16
A typed in front: cursor 8, places 0 8 16 20
undone: cursor 0, places 0 8 16
----
end
case text buffer: joining two lines can join an accent to the letter before it, and undo parts them again
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- Where the cursor is, and every place it can stand, from the start to the end.
func places(out, what, t):
    do text_add(out, what)
    do text_add(out, ": cursor ")
    do text_add_whole(out, text_cursor(t))
    do text_add(out, ", places 0")
    let p = 0
    while p < text_length(t):
        p = text_next(t, p)
        do text_add(out, " ")
        do text_add_whole(out, p)
    end
    return text_add(out, "\n")
end

func main():
    -- a, a newline, then a line that begins with a combining acute accent (the two bytes CC 81) and b.
    let b = linux_buffer(5)
    do text_put(b, 0, "a\n..b")
    do buffer_set(b, 2, 204)
    do buffer_set(b, 3, 129)
    let t = text_buffer(64)
    do text_load(t, b, 5)
    do text_seek(t, 2)
    let out = new_buffer()
    do places(out, "two lines", t)
    -- The newline backspaced away: the accent now belongs to a, and 1 is inside that character.
    do text_backspace(t)
    do places(out, "joined", t)
    do text_undo(t)
    do places(out, "undone", t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
