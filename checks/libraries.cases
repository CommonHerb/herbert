case utf8: of every two- and three-byte sequence, only the shortest form of a scalar decodes
libs linux text utf8
source until ----
func main():
    let b = linux_buffer(3)
    let again = linux_buffer(3)
    let ascii = 0
    let twos = 0
    let threes = 0
    let wrong = 0
    -- All 65536 pairs of bytes.
    let first = 0
    while first < 256:
        do buffer_set(b, 0, first)
        let second = 0
        while second < 256:
            do buffer_set(b, 1, second)
            let r = utf8_decode(b, 0, 2)
            if not linux_error(r.0):
                if r.1 == 1:
                    ascii = ascii + 1
                    if r.0 != first or first > 127: wrong = wrong + 1 end
                else:
                    twos = twos + 1
                    if utf8_store(again, 0, r.0) != 2 or buffer_get(again, 0) != first or buffer_get(again, 1) != second: wrong = wrong + 1 end
                end
            end
            second = second + 1
        end
        first = first + 1
    end
    -- All triples whose first byte, E0 to EF, begins a three-byte scalar.
    first = 224
    while first < 240:
        do buffer_set(b, 0, first)
        let second = 0
        while second < 256:
            do buffer_set(b, 1, second)
            let third = 0
            while third < 256:
                do buffer_set(b, 2, third)
                let r = utf8_decode(b, 0, 3)
                if not linux_error(r.0):
                    threes = threes + 1
                    if r.1 != 3 or utf8_store(again, 0, r.0) != 3 or buffer_get(again, 0) != first or buffer_get(again, 1) != second or buffer_get(again, 2) != third: wrong = wrong + 1 end
                end
                third = third + 1
            end
            second = second + 1
        end
        first = first + 1
    end
    let out = new_buffer()
    do text_add_whole(out, ascii)
    do text_add(out, " pairs begin with one of the 128 one-byte scalars\n")
    do text_add_whole(out, twos)
    do text_add(out, " pairs are two-byte scalars\n")
    do text_add_whole(out, threes)
    do text_add(out, " triples are three-byte scalars\n")
    do text_add_whole(out, wrong)
    do text_add(out, " stored back as other bytes\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
