the copy's bytes
linked and recovery.txt: error 20; holding 10 bytes of copies/recovery.txt
copies and ../doc.txt: error 22; holding 10 bytes of copies/recovery.txt
.. and recovery.txt: error 22; holding 10 bytes of copies/recovery.txt
missing and recovery.txt: error 2; holding 10 bytes of copies/recovery.txt
----
end
case file: after the file's text is changed outside, or another file is moved into its place, file_recheck gives 116, a save is still refused, and the outside change stays whole
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

-- What file_recheck and then a save through f give, and whether the file at path is still outside.
func after(out, what, f, path, outside):
    do text_add(out, what)
    do text_add(out, ": file_recheck ")
    do result(out, file_recheck(f))
    do text_add(out, ", a save ")
    do result(out, file_save(f, linux_cstring("mine\n"), 5))
    if holds(path, outside): return text_add(out, ", the outside change whole\n") end
    return text_add(out, ", the outside change LOST\n")
end

func main():
    let out = new_buffer()
    -- Another program rewrites the file while it is open here.
    do write_file("re-text.txt", "old\n")
    let a = file_open("re-text.txt", 64)
    do write_file("re-text.txt", "changed outside\n")
    do after(out, "the text changed", a, "re-text.txt", "changed outside\n")
    -- It moves another file, of the same size, into the document's place (Linux's rename, 82).
    do write_file("re-moved.txt", "old\n")
    let b = file_open("re-moved.txt", 64)
    do write_file("re-other.txt", "NEW\n")
    do linux_syscall6(82, buffer_address(linux_cstring("re-other.txt")), buffer_address(linux_cstring("re-moved.txt")), 0, 0, 0, 0)
    do after(out, "another file moved into its place", b, "re-moved.txt", "NEW\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
