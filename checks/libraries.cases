case file and text buffer: a file's own bytes go through the text and back to disk exactly, and an edit reaches a save, a rescue copy and a checkpoint in the file's own newline style
libs linux text utf8 unicode_tables unicode_grapheme file_io text_buffer session_recovery
source until ----
-- The bytes of s, then the bytes h names in hex, two digits each with a space after.
func bytes(b, s, h):
    do text_add(b, s)
    let i = 0
    while i + 1 < length(h):
        let hi = index(h, i) - 48
        if hi > 9: hi = hi - 7 end
        let lo = index(h, i + 1) - 48
        if lo > 9: lo = lo - 7 end
        do append(b, hi * 16 + lo)
        i = i + 3
    end
    return b
end

-- A file at path holding count bytes of b, made without the library.
func write_file(path, b, count):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, b, 0, count)
    return linux_close(fd)
end

-- Whether count bytes of a and of b are the same.
func same(a, b, count):
    let i = 0
    while i < count:
        if buffer_get(a, i) != buffer_get(b, i): return false end
        i = i + 1
    end
    return true
end

-- Whether the file at path holds exactly count bytes of b and then s, read without the library.
func holds(path, b, count, s):
    let file = linux_read_file(path, 8192)
    return file.0 == 0 and file.2 == count + length(s) and same(file.1, b, count) and text_is(file.1, count, file.2, s)
end

-- The inode of the file at path (in Linux's stat at 8).
func inode(path):
    let stat = linux_buffer(144)
    let fd = linux_open(linux_cstring(path), 0, 0)
    do linux_fstat(fd, stat)
    do linux_close(fd)
    return linux_u64(stat, 8)
end

func loaded(out, f, t, b, count):
    do text_add(out, "opened ")
    do text_add_whole(out, file_status(f))
    do text_add(out, ", ")
    do text_add_whole(out, file_count(f))
    do text_add(out, " bytes; loaded ")
    do text_add_whole(out, text_load(t, f.bytes, file_count(f)))
    if text_crlf(t): do text_add(out, ", CRLF") else: do text_add(out, ", LF") end
    do text_add(out, ", text ")
    do text_add_whole(out, text_length(t))
    do text_add(out, ", file ")
    do text_add_whole(out, text_file_length(t))
    if text_file_length(t) == count and same(text_file_bytes(t), b, count): do text_add(out, ", the file's own bytes") end
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do linux_syscall6(83, buffer_address(linux_cstring("trip6.d")), 448, 0, 0, 0, 0)
    -- A byte order mark, a precomposed and a combining accent, the noncharacter U+FFFE, a joined
    -- emoji (woman, joiner, laptop), a tab, CR LF, and a last line with no newline: 35 bytes.
    let doc = bytes(new_buffer(), "", "EF BB BF ")
    do bytes(doc, "caf", "C3 A9 ")
    do bytes(doc, " e", "CC 81 ")
    do bytes(doc, " ", "EF BF BE ")
    do bytes(doc, " ", "F0 9F 91 A9 E2 80 8D F0 9F 92 BB 09 0D 0A ")
    do bytes(doc, "last", "")
    do write_file("trip6.d/doc.txt", doc, 35)
    let f = file_open("trip6.d/doc.txt", 4096)
    let t = text_buffer(4096)
    do loaded(out, f, t, doc, 35)
    let before = inode("trip6.d/doc.txt")
    do text_add(out, "saved as loaded: ")
    do text_add_whole(out, file_save(f, text_file_bytes(t), text_file_length(t)))
    if inode("trip6.d/doc.txt") != before: do text_add(out, ", a new file in its place") end
    if holds("trip6.d/doc.txt", doc, 35, ""): do text_add(out, ", the same 35 bytes") end
    -- At the end: a newline and !, typed.
    do text_seek(t, text_length(t))
    do text_insert(t, 10)
    do text_insert(t, '!')
    do text_add(out, "\nnewline and ! typed at the end, saved: ")
    do text_add_whole(out, file_save(f, text_file_bytes(t), text_file_length(t)))
    if holds("trip6.d/doc.txt", doc, 35, "\r\n!"): do text_add(out, ", the file is the 35 bytes, CR LF and !") end
    let placed = inode("trip6.d/doc.txt")
    do text_add(out, "\nrescue copy: ")
    do text_add_whole(out, file_save_copy(f, text_file_bytes(t), text_file_length(t)))
    let name = file_copy_name(f)
    let copy = new_buffer()
    do text_add(copy, "trip6.d/")
    do text_add_span(copy, name, 0, linux_nul_end(name, 0, buffer_length(name)))
    if holds(freeze(copy), doc, 35, "\r\n!"): do text_add(out, ", the copy is the 35 bytes, CR LF and !") end
    let r = recovery_new(4096)
    do text_add(out, "\ncheckpoints of the text as loaded and as edited: ")
    do text_add_whole(out, recovery_save(r, f, doc, 35))
    do text_add(out, ", ")
    do text_add_whole(out, recovery_save(r, f, text_file_bytes(t), text_file_length(t)))
    let s = file_scan_new()
    let g = file_new(4096)
    if file_scan(f, s, ".herbert-notes-") == 1 and file_load_inside(g, f, file_scan_name(s), "recovery.txt") == 0:
        if file_count(g) == 38 and same(g.bytes, doc, 35) and text_is(g.bytes, 35, 38, "\r\n!"): do text_add(out, ", recovery.txt is the 35 bytes, CR LF and !") end
    end
    if inode("trip6.d/doc.txt") == placed and holds("trip6.d/doc.txt", doc, 35, "\r\n!"): do text_add(out, "\nthe document is the same file with the same bytes") end
    -- Every newline deleted, then one typed at the start: the file's style stays.
    let p = 0
    while p < text_length(t):
        if buffer_get(t.bytes, p) == 10:
            do text_seek(t, p)
            do text_delete(t)
        else:
            p = p + 1
        end
    end
    do text_seek(t, 0)
    do text_insert(t, 10)
    let last = text_file_bytes(t)
    do text_add(out, "\nevery newline deleted and one typed: ")
    if text_crlf(t) and buffer_get(last, 0) == 13 and buffer_get(last, 1) == 10 and text_file_length(t) == text_length(t) + 1: do text_add(out, "written CR LF") end
    -- x to exactly the capacity, the last two bytes CR LF.
    let full = new_buffer()
    do buffer_fill(full, 4094, 'x')
    do bytes(full, "", "0D 0A ")
    do write_file("trip6.d/full.txt", full, 4096)
    let h = file_open("trip6.d/full.txt", 4096)
    let u = text_buffer(4096)
    do text_add(out, "\nat the capacity: ")
    do loaded(out, h, u, full, 4096)
    -- The first x made a y: still 4096 bytes, saved through the handle that opened them.
    do text_seek(u, 0)
    do text_delete(u)
    do text_insert(u, 'y')
    do text_add(out, "its first x made a y, saved: ")
    do text_add_whole(out, file_save(h, text_file_bytes(u), text_file_length(u)))
    do buffer_set(full, 0, 'y')
    if holds("trip6.d/full.txt", full, 4096, ""): do text_add(out, ", read back exactly") end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
opened 0, 35 bytes; loaded 0, CRLF, text 34, file 35, the file's own bytes
saved as loaded: 0, a new file in its place, the same 35 bytes
newline and ! typed at the end, saved: 0, the file is the 35 bytes, CR LF and !
rescue copy: 0, the copy is the 35 bytes, CR LF and !
checkpoints of the text as loaded and as edited: 0, 0, recovery.txt is the 35 bytes, CR LF and !
the document is the same file with the same bytes
every newline deleted and one typed: written CR LF
at the capacity: opened 0, 4096 bytes; loaded 0, CRLF, text 4095, file 4096, the file's own bytes
its first x made a y, saved: 0, read back exactly
----
end
case text buffer: in a CRLF text every newline takes two bytes of the capacity, an edit refused for room changes nothing, and undo and redo stay exact at the capacity
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- The bytes of s, then the bytes h names in hex, two digits each with a space after.
func bytes(s, h):
    let b = new_buffer()
    do text_add(b, s)
    let i = 0
    while i + 1 < length(h):
        let hi = index(h, i) - 48
        if hi > 9: hi = hi - 7 end
        let lo = index(h, i + 1) - 48
        if lo > 9: lo = lo - 7 end
        do append(b, hi * 16 + lo)
        i = i + 3
    end
    return b
end

-- What an edit gave (1 taken, 0 refused), then the file's bytes, CR as \r, LF as \n and any
-- byte past ~ in hex, and the cursor.
func step(out, what, r, t):
    do text_add(out, what)
    do text_add(out, ": ")
    do text_add_whole(out, r)
    do text_add(out, " [")
    let b = text_file_bytes(t)
    let i = 0
    while i < text_file_length(t):
        let ch = buffer_get(b, i)
        if ch == 13: do text_add(out, "\\r") elif ch == 10: do text_add(out, "\\n") elif ch > 126: do text_add(out, "<") do text_add_whole(out, ch) do text_add(out, ">") else: do append(out, ch) end
        i = i + 1
    end
    do text_add(out, "] ")
    do text_add_whole(out, text_file_length(t))
    do text_add(out, " bytes, cursor ")
    do text_add_whole(out, text_cursor(t))
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- Room for six bytes: é, CR LF (four), the cursor after the newline.
    let t = text_buffer(6)
    do text_load(t, bytes("", "C3 A9 0D 0A "), 4)
    do text_seek(t, 3)
    do step(out, "é", text_insert(t, 233), t)
    do step(out, "newline", text_insert(t, 10), t)
    do step(out, "A", text_insert(t, 'A'), t)
    do step(out, "undo", text_undo(t), t)
    do step(out, "redo", text_redo(t), t)
    -- Five of six bytes used: a newline needs two.
    let u = text_buffer(6)
    do text_load(u, bytes("xxx", "0D 0A "), 5)
    do step(out, "newline", text_insert(u, 10), u)
    do step(out, "A", text_insert(u, 'A'), u)
    do step(out, "newline", text_insert(u, 10), u)
    do step(out, "backspace", text_backspace(u), u)
    do step(out, "newline", text_insert(u, 10), u)
    do text_seek(u, text_length(u))
    do step(out, "backspace at the end", text_backspace(u), u)
    do step(out, "newline", text_insert(u, 10), u)
    do step(out, "undo", text_undo(u), u)
    do step(out, "redo", text_redo(u), u)
    -- All six bytes used.
    let v = text_buffer(6)
    do text_load(v, bytes("xxxx", "0D 0A "), 6)
    do step(out, "A", text_insert(v, 'A'), v)
    do step(out, "newline", text_insert(v, 10), v)
    do step(out, "backspace at the start", text_backspace(v), v)
    do text_seek(v, text_length(v))
    do step(out, "backspace at the end", text_backspace(v), v)
    do step(out, "newline", text_insert(v, 10), v)
    do step(out, "A", text_insert(v, 'A'), v)
    do step(out, "undo", text_undo(v), v)
    do step(out, "undo", text_undo(v), v)
    do step(out, "redo", text_redo(v), v)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
é: 1 [<195><169>\r\n<195><169>] 6 bytes, cursor 5
newline: 0 [<195><169>\r\n<195><169>] 6 bytes, cursor 5
A: 0 [<195><169>\r\n<195><169>] 6 bytes, cursor 5
undo: 1 [<195><169>\r\n] 4 bytes, cursor 3
redo: 1 [<195><169>\r\n<195><169>] 6 bytes, cursor 5
newline: 0 [xxx\r\n] 5 bytes, cursor 0
A: 1 [Axxx\r\n] 6 bytes, cursor 1
newline: 0 [Axxx\r\n] 6 bytes, cursor 1
backspace: 1 [xxx\r\n] 5 bytes, cursor 0
newline: 0 [xxx\r\n] 5 bytes, cursor 0
backspace at the end: 1 [xxx] 3 bytes, cursor 3
newline: 1 [xxx\r\n] 5 bytes, cursor 4
undo: 1 [xxx] 3 bytes, cursor 3
redo: 1 [xxx\r\n] 5 bytes, cursor 4
A: 0 [xxxx\r\n] 6 bytes, cursor 0
newline: 0 [xxxx\r\n] 6 bytes, cursor 0
backspace at the start: 0 [xxxx\r\n] 6 bytes, cursor 0
backspace at the end: 1 [xxxx] 4 bytes, cursor 4
newline: 1 [xxxx\r\n] 6 bytes, cursor 5
A: 0 [xxxx\r\n] 6 bytes, cursor 5
undo: 1 [xxxx] 4 bytes, cursor 4
undo: 1 [xxxx\r\n] 6 bytes, cursor 5
redo: 1 [xxxx] 4 bytes, cursor 4
