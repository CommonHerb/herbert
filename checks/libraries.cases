func main():
    let b = linux_buffer(4)
    let out = new_buffer()
    let ascii = 0
    let cp = 32
    while cp <= 126:
        if supported(b, cp): ascii = ascii + 1 end
        cp = cp + 1
    end
    do text_add_whole(out, ascii)
    do text_add(out, " of the 95 from space to ~\n")
    do text_add(out, "from U+00A0 to U+00FF, without a glyph:")
    cp = 160
    while cp <= 255:
        if not supported(b, cp):
            do text_add(out, " ")
            do text_add_whole(out, cp)
        end
        cp = cp + 1
    end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
