    do text_load(t, linux_cstring("abcdefg\th"), 9)
    do text_wrap(t, 6, 32)
    let out = new_buffer()
    do text_add(out, "the row of h starts at ")
    do text_add_whole(out, text_wrap_start(t, 8))
    do text_add(out, "\nscreen columns 0 1 3 4 5 on it:")
    do text_add(out, " ")
    do text_add_whole(out, text_wrap_position(t, 6, 0))
    do text_add(out, " ")
