case utf8: scalars of one, two, three and four bytes decode to their code points
libs linux text utf8
source until ----
func hex_digit(c):
    if c <= 57: return c - 48 end
    return c - 55
end

-- The bytes s names in hex: two digits a byte, a space between bytes.
func hex(s):
    let b = new_buffer()
    let i = 0
    while i + 1 < length(s):
        do append(b, hex_digit(index(s, i)) * 16 + hex_digit(index(s, i + 1)))
        i = i + 3
    end
    return b
end

func report(out, b, at):
    let r = utf8_decode(b, at, buffer_length(b))
    do text_add(out, "at ")
    do text_add_whole(out, at)
    do text_add(out, ": scalar ")
    do text_add_whole(out, r.0)
    do text_add(out, " next ")
    do text_add_whole(out, r.1)
    return text_add(out, "\n")
end

func main():
    -- A, e with an acute accent (U+00E9), the euro sign (U+20AC), a grinning face (U+1F600).
    let b = hex("41 C3 A9 E2 82 AC F0 9F 98 80")
    let out = new_buffer()
    do report(out, b, 0)
    do report(out, b, 1)
    do report(out, b, 3)
    do report(out, b, 6)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
at 0: scalar 65 next 1
at 1: scalar 233 next 3
at 3: scalar 8364 next 6
at 6: scalar 128512 next 10
----
end
case utf8: every scalar, stored and decoded again, is itself and takes the width utf8_width gives
libs linux text utf8
source until ----
func main():
    let b = linux_buffer(4)
    let widths = linux_buffer(40)
    let wrong = 0
    let cp = 0
    -- Every value from 0 to U+10FFFF; the 2048 surrogates have no width.
    while cp <= 1114111:
        let width = utf8_width(cp)
        do linux_put64(widths, width * 8, linux_u64(widths, width * 8) + 1)
        if width != 0:
            let next = utf8_store(b, 0, cp)
            let back = utf8_decode(b, 0, width)
            if next != width or back.0 != cp or back.1 != width: wrong = wrong + 1 end
        end
        cp = cp + 1
    end
    let out = new_buffer()
    let width = 0
    while width <= 4:
        do text_add_whole(out, linux_u64(widths, width * 8))
        do text_add(out, " of width ")
        do text_add_whole(out, width)
        do text_add(out, "\n")
        width = width + 1
    end
    do text_add_whole(out, wrong)
    do text_add(out, " came back wrong\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
2048 of width 0
128 of width 1
1920 of width 2
61440 of width 3
1048576 of width 4
0 came back wrong
----
end
