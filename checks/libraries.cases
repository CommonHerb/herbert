case sha256: lengths on each side of a block's edge, and 100,000 bytes, as the tool sha256sum gives them
libs linux sha256
source until ----
func show(s, data, count):
    do sha256_of(s, data, 0, count)
    do flogger(sha256_hex(s))
    do flogger("\n")
    return 0
end

func main():
    let s = sha256_new()
    let data = linux_buffer(100000)
    let i = 0
    while i < 100000:
        do buffer_set(data, i, i % 251)
        i = i + 1
    end
    do show(s, data, 55)
    do show(s, data, 56)
    do show(s, data, 63)
    do show(s, data, 64)
    do show(s, data, 65)
    do show(s, data, 119)
    do show(s, data, 120)
    do show(s, data, 100000)
    do process_exit(0)
    return 0
end
