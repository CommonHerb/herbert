libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func place(out, t, p):
    let file = text_wrap_file(t, p)
    do text_add_whole(out, p)
    do text_add(out, ": line ")
    do text_add_whole(out, file.0)
    do text_add(out, " column ")
    do text_add_whole(out, file.1)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- Four columns: abcdefghij from 0 over three rows, its newline at 10, xyz from 11, the end at 14.
    let t = text_buffer(64)
    do text_load(t, linux_cstring("abcdefghij\nxyz"), 14)
    do text_wrap(t, 4, 32)
    do place(out, t, 3)
    do place(out, t, 4)
    do place(out, t, 9)
    do place(out, t, 10)
    do place(out, t, 12)
    do place(out, t, 14)
    -- a, b, a tab to column 4, then cdefgh: g, the seventh byte, is at column 8 of its line.
    do text_load(t, linux_cstring("ab\tcdefgh"), 9)
    do place(out, t, 7)
    do text_add(out, "text_column says ")
    do text_add_whole(out, text_column(t, 7))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
