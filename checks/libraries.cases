libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func show(out, t):
    do text_add(out, "[")
    do text_add_span(out, t.bytes, 0, text_length(t))
    do text_add(out, "] cursor ")
    do text_add_whole(out, text_cursor(t))
    return text_add(out, "\n")
end

func main():
    -- Room for sixteen bytes of text and four bytes of history.
    let t = text_buffer_history(16, 4)
    do text_load(t, linux_cstring("abcdefgh"), 8)
    let out = new_buffer()
    -- Four bytes out and four in are eight to remember.
    do text_add_whole(out, text_replace(t, 0, 4, linux_cstring("WXYZ"), 0, 4))
    do text_add(out, " ")
    do show(out, t)
    -- Two out and two in are four.
    do text_add_whole(out, text_replace(t, 0, 2, linux_cstring("WX"), 0, 2))
    do text_add(out, " ")
    do show(out, t)
    do text_undo(t)
    do show(out, t)
    -- A history of twice the capacity holds a replace of the whole text.
    let whole = text_buffer_history(8, 16)
    do text_load(whole, linux_cstring("abcdefgh"), 8)
    do text_add_whole(out, text_replace(whole, 0, 8, linux_cstring("ABCDEFGH"), 0, 8))
    do text_add(out, " ")
    do show(out, whole)
    do text_undo(whole)
    do show(out, whole)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
