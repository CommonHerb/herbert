func say(out, s):
    let b = scalars(s)
    do text_add(out, s)
    if unicode_display_supported(b, 0, buffer_length(b)): return text_add(out, ": drawn\n") end
    return text_add(out, ": marker\n")
end

func main():
    let out = new_buffer()
    -- AE, Eth, O with stroke, Thorn, sharp s, ae, eth, o with stroke, thorn: each with an acute accent (301).
    do say(out, "C6 301")
    do say(out, "D0 301")
    do say(out, "D8 301")
    do say(out, "DE 301")
    do say(out, "DF 301")
    do say(out, "E6 301")
    do say(out, "F0 301")
    do say(out, "F8 301")
    do say(out, "FE 301")
    if not equal(ink("C6 301"), ink("C6")): do text_add(out, "AE with the accent is not drawn as AE alone\n") end
    -- A Latin-1 sign that is no letter takes no accent: the inverted question mark, the multiplication sign.
    do say(out, "BF 301")
    do say(out, "D7 301")
    -- c with cedilla (E7) has room above: with an acute it is drawn, and drawn as c, cedilla, acute.
    do say(out, "E7 301")
    if equal(ink("E7 301"), ink("63 327 301")): do text_add(out, "E7 301 is drawn as 63 327 301\n") end
    -- It has no room for a second cedilla, nor for a ring (30A), which does not fit over a cedilla.
    do say(out, "E7 327")
    do say(out, "E7 30A")
    -- n with tilde (F1) has room below for a cedilla, none above for a grave (300); a with ring (E5) none for a cedilla.
    do say(out, "F1 327")
    do say(out, "F1 300")
    do say(out, "E5 327")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
