        do text_add(out, "stopped by signal ")
        do text_add_whole(out, (st & 127))
    else:
        do result(out, ((st >> 8) & 255) - 100)
    end
    if holds(path, "original\r\ntext") and inode(path) == before: do text_add(out, ", the document as it was") end
    let copies = names(folder, "herbert-rescue-")
    do text_add(out, ", rescue copies ")
    do text_add_whole(out, copies.0)
    if copies.0 == 1 and holds(within(folder, copies.1), "original\r\ntext\r\n!"): do text_add(out, ", holding the edit") end
    do text_add(out, ", temporary ")
    do text_add_whole(out, names(folder, ".herbert-save-").0)
    do text_add(out, "\n")
    return 0
end

func main():
    let out = new_buffer()
    do trial(out, "fsync EIO", "fault-copy-fsync.d", 1)
    do trial(out, "the folder's fsync EIO", "fault-copy-folder.d", 2)
    do trial(out, "nothing failed", "fault-copy-none.d", 0)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
