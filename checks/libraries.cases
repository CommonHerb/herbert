case text buffer: find does not match the letter under an accent, or one person out of an emoji family
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
func hex_digit(c):
    if c <= 57: return c - 48 end
    return c - 55
end

-- The scalars s names in hex, a space between them, as UTF-8 bytes.
func scalars(s):
    let b = new_buffer()
    let one = linux_buffer(4)
    let cp = 0
    let i = 0
    while i <= length(s):
        if i == length(s) or index(s, i) == 32:
            do text_add_span(b, one, 0, utf8_store(one, 0, cp))
            cp = 0
        else:
            cp = cp * 16 + hex_digit(index(s, i))
        end
        i = i + 1
    end
    return b
end

func find(out, text, query):
    let t = text_buffer(64)
    let b = scalars(text)
    let q = scalars(query)
    do text_load(t, b, buffer_length(b))
    let found = text_find(t, q, buffer_length(q), 0, false)
    do text_add(out, query)
    do text_add(out, " in ")
    do text_add(out, text)
    if found == 0 - 1: return text_add(out, ": none\n") end
    do text_add(out, ": ")
    do text_add_whole(out, found)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- e with a combining acute accent (three bytes), then a plain e at 3.
    do find(out, "65 301 65", "65")
    do find(out, "65 301 65", "65 301")
    do find(out, "65 301 65", "301")
    -- Man, joiner, woman, joiner, girl; the woman or the girl alone is not found, the whole family is.
    do find(out, "1F468 200D 1F469 200D 1F467", "1F469")
    do find(out, "1F468 200D 1F469 200D 1F467", "1F467")
    do find(out, "1F468 200D 1F469 200D 1F467", "1F468 200D 1F469 200D 1F467")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
65 in 65 301 65: 3
65 301 in 65 301 65: 0
301 in 65 301 65: none
1F469 in 1F468 200D 1F469 200D 1F467: none
1F467 in 1F468 200D 1F469 200D 1F467: none
1F468 200D 1F469 200D 1F467 in 1F468 200D 1F469 200D 1F467: 0
----
end
case text buffer: a long line breaks after the last blank that fits, and a word wider than the row where the row is full
libs linux text utf8 unicode_tables unicode_grapheme text_buffer
source until ----
-- The screen rows of the one line s at the given width, each in brackets.
func rows(out, s, width):
    let t = text_buffer(64)
    do text_load(t, linux_cstring(s), length(s))
    do text_wrap(t, width, 1)
    do text_add(out, "width ")
    do text_add_whole(out, width)
    do text_add(out, ":")
    let r = 0
    let going = true
    while going:
        let row = text_wrap_end(t, r, 0)
        do text_add(out, " [")
        do text_add_span(out, t.bytes, r, row.0 - r)
        do text_add(out, "]")
        if row.1: going = false else: r = row.0 end
    end
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do rows(out, "the quick brown fox", 19)
    do rows(out, "the quick brown fox", 10)
    do rows(out, "the quick brown fox", 8)
    do rows(out, "abcdefghij", 4)
    do rows(out, "ab cdefghij", 4)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
