    do undo(out, t)
    do undo(out, t)
    do undo(out, t)
    do redo(out, t)
    do redo(out, t)
    do redo(out, t)
    do redo(out, t)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
