case utf8: the prose policy lets tab and newline in and keeps every other control out
libs linux text utf8
source until ----
func say(out, cp):
    do text_add_whole(out, cp)
    if utf8_text_allowed(cp): return text_add(out, " allowed\n") end
    return text_add(out, " kept out\n")
end

func main():
    let out = new_buffer()
    -- Of 0 to 159: tab, newline and the 95 printable ASCII characters.
    let allowed = 0
    let cp = 0
    while cp < 160:
        if utf8_text_allowed(cp): allowed = allowed + 1 end
        cp = cp + 1
    end
    do text_add_whole(out, allowed)
    do text_add(out, " of the first 160 allowed\n")
    do say(out, 9)
    do say(out, 10)
    do say(out, 13)
    do say(out, 0)
    do say(out, 27)
    do say(out, 127)
    do say(out, 159)
    do say(out, 160)
    -- A zero-width space, a byte order mark and a noncharacter keep their bytes.
    do say(out, 8203)
    do say(out, 65279)
    do say(out, 65534)
    -- A surrogate and a value past U+10FFFF are no scalars at all.
    do say(out, 55296)
    do say(out, 1114112)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
