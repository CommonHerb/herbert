case linux: a number's digits, a path's NUL and an overlapping copy land where their helpers say
libs linux text
source until ----
func main():
    let out = new_buffer()
    -- 0, 7, 10 and 2^64 - 1 written one after another: the offsets after each.
    let b = linux_buffer(32)
    let at = linux_decimal(b, 0, 0)
    do text_add_whole(out, at)
    at = linux_decimal(b, at, 7)
    do text_add(out, " ")
    do text_add_whole(out, at)
    at = linux_decimal(b, at, 10)
    do text_add(out, " ")
    do text_add_whole(out, at)
    at = linux_decimal(b, at, 18446744073709551615)
    do text_add(out, " ")
    do text_add_whole(out, at)
    do text_add(out, " ")
    do text_add_span(out, b, 0, at)
    -- A path is its string and a NUL; with no NUL before the limit, the limit.
    let path = linux_cstring("abc")
    do text_add(out, "\n")
    do text_add_whole(out, buffer_length(path))
    do text_add(out, " bytes, NUL at ")
    do text_add_whole(out, linux_nul_end(path, 0, 4))
    do text_add(out, ", none before 2: ")
    do text_add_whole(out, linux_nul_end(path, 0, 2))
    -- Four bytes moved two places up, then, in a fresh copy, two places down.
    let up = linux_cstring("abcdefgh")
    do linux_copy(up, 2, up, 0, 4)
    let down = linux_cstring("abcdefgh")
    do linux_copy(down, 0, down, 2, 4)
    do text_add(out, "\n")
    do text_add_span(out, up, 0, 8)
    do text_add(out, " ")
    do text_add_span(out, down, 0, 8)
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
1 2 4 24 071018446744073709551615
4 bytes, NUL at 3, none before 2: 2
ababcdgh cdefefgh
----
end
case linux: linux_read_file gives a file's bytes and their count, error 27 for a file over the cap and error 2 for none
libs linux text
source until ----
func read(out, what, path, cap):
    let file = linux_read_file(path, cap)
    do text_add(out, what)
    if linux_error(file.0):
        do text_add(out, ": error ")
        do text_add_whole(out, 0 - file.0)
        return text_add(out, "\n")
    end
    do text_add(out, ": ")
    do text_add_whole(out, file.2)
    do text_add(out, " bytes [")
    do text_add_span(out, file.1, 0, file.2)
    return text_add(out, "]\n")
end

func main():
    -- A file of six bytes and an empty one, written by this case.
    let fd = linux_open(linux_cstring("six.txt"), 577, 420)
    do linux_write(fd, linux_cstring("hello!"), 0, 6)
    do linux_close(fd)
    do linux_close(linux_open(linux_cstring("empty.txt"), 577, 420))
    let out = new_buffer()
    do read(out, "a cap of 16", "six.txt", 16)
    do read(out, "a cap of 6", "six.txt", 6)
    do read(out, "a cap of 5", "six.txt", 5)
    do read(out, "an empty file", "empty.txt", 16)
    do read(out, "no file", "not-there.txt", 16)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
a cap of 16: 6 bytes [hello!]
a cap of 6: 6 bytes [hello!]
a cap of 5: error 27
an empty file: 0 bytes []
no file: error 2
----
end
case linux: arguments are counted and found by number, an empty one told from a missing one; an environment value is found by its whole name
libs linux text
source until ----
func argument(out, args, k):
    do text_add(out, " [")
    do text_add(out, linux_argument(args, k))
    return text_add(out, "]")
end

func value(out, env, name):
    do text_add(out, name)
    do text_add(out, " [")
    do text_add(out, linux_env(env, name))
    return text_add(out, "]\n")
end

func main():
    let out = new_buffer()
    -- A command line as Linux gives it, each argument ended by a NUL: prog, one, an empty one, three.
    let line = linux_buffer(16)
    do text_put(line, 0, "prog")
    do text_put(line, 5, "one")
    do text_put(line, 10, "three")
    let args = (line, 16)
    do text_add_whole(out, linux_argument_count(args))
    do text_add(out, " arguments:")
    do argument(out, args, 0)
    do argument(out, args, 1)
    do argument(out, args, 2)
    do argument(out, args, 3)
    do argument(out, args, 4)
    -- This program itself was started with no arguments.
    do text_add(out, "\nthis program's own count: ")
    do text_add_whole(out, linux_argument_count(linux_arguments()))
    do text_add(out, "\n")
    -- An environment as Linux gives it: NAME=value, each ended by a NUL, zeros after the last.
    let env = linux_buffer(64)
    do text_put(env, 0, "HOME=/home/x")
    do text_put(env, 13, "HOMER=simpson")
    do text_put(env, 27, "EMPTY=")
    do value(out, env, "HOME")
    do value(out, env, "HOMER")
    do value(out, env, "HOM")
    do value(out, env, "EMPTY")
    do value(out, env, "MISSING")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
4 arguments: [prog] [one] [] [three] []
this program's own count: 1
HOME [/home/x]
HOMER [simpson]
HOM []
EMPTY []
MISSING []
----
end
