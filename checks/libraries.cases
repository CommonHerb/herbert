case file: a symbolic link, a folder and a file with a second name are refused, each with its own error
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- Linux's symlink (88), mkdir (83) and link (86), by number.
func make_link(target, path):
    return linux_syscall6(88, buffer_address(linux_cstring(target)), buffer_address(linux_cstring(path)), 0, 0, 0, 0)
end

func make_folder(path):
    return linux_syscall6(83, buffer_address(linux_cstring(path)), 448, 0, 0, 0, 0)
end

func second_name(path, other):
    return linux_syscall6(86, buffer_address(linux_cstring(path)), buffer_address(linux_cstring(other)), 0, 0, 0, 0)
end

func open(out, what, path):
    let f = file_open(path, 64)
    do text_add(out, what)
    if not linux_error(file_status(f)): return text_add(out, ": opened\n") end
    do text_add(out, ": error ")
    do text_add_whole(out, 0 - file_status(f))
    return text_add(out, "\n")
end

func main():
    do write_file("target.txt", "kept\n")
    do make_link("target.txt", "link.txt")
    do make_folder("folder.d")
    do write_file("twice-a.txt", "kept\n")
    do second_name("twice-a.txt", "twice-b.txt")
    let out = new_buffer()
    do open(out, "the plain file", "target.txt")
    do open(out, "a symbolic link to it", "link.txt")
    do open(out, "a folder", "folder.d")
    do open(out, "a file with two names", "twice-a.txt")
    if holds("target.txt", "kept\n") and holds("twice-b.txt", "kept\n"): do text_add(out, "the files are as they were\n") end
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
