func tenths(out, n, unit):
    let b = linux_buffer(32)
    let at = text_put_tenths(b, 0, n, unit)
    do text_add_whole(out, n)
    do text_add(out, " / ")
    do text_add_whole(out, unit)
    do text_add(out, " = ")
    do text_add_span(out, b, 0, at)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    do tenths(out, 1234, 100)
    do tenths(out, 1235, 100)
    do tenths(out, 996, 100)
    do tenths(out, 4, 100)
    do tenths(out, 5, 100)
    do tenths(out, 0, 7)
    do tenths(out, 1, 3)
    do tenths(out, 2, 3)
    do tenths(out, 7, 1)
    do tenths(out, 1536, 1024)
    do tenths(out, 16384000, 1048576)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
