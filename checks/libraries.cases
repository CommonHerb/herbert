stdout until ----
3 [.herbert-notes-2-1]
3 [.herbert-notes-2-1]
----
end
case file: a FIFO at the document's name is refused with 22 at once, opened or loaded into a handle, which keeps its own document; the FIFO stays
libs linux text file_io
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

func main():
    let out = new_buffer()
    do linux_syscall6(83, buffer_address(linux_cstring("fifo6.d")), 448, 0, 0, 0, 0)
    -- A FIFO (Linux's mknod, 133; 4480 is a FIFO with mode 600). Opening one for reading waits for
    -- a writer that never comes, so a library that did would run past the limit below.
    do linux_syscall6(133, buffer_address(linux_cstring("fifo6.d/pipe.txt")), 4480, 0, 0, 0, 0)
    do write_file("fifo6.d/doc.txt", "kept\n")
    do text_add(out, "opened: ")
    do result(out, file_status(file_open("fifo6.d/pipe.txt", 64)))
    let f = file_open("fifo6.d/doc.txt", 64)
    do text_add(out, "\nloaded into a handle on doc.txt: ")
    do result(out, file_load(f, linux_cstring("fifo6.d/pipe.txt"), 16))
    do text_add(out, ", the handle still holds ")
    do text_add_whole(out, file_count(f))
    do text_add(out, " bytes of ")
    do text_add_span(out, f.path, 0, linux_nul_end(f.path, 0, buffer_length(f.path)))
    do text_add(out, "\na save through it: ")
    do result(out, file_save(f, linux_cstring("saved\n"), 6))
    if holds("fifo6.d/doc.txt", "saved\n"): do text_add(out, ", into doc.txt") end
    -- Still a FIFO: the type bits of its stat (at 24 in Linux's stat; 4096 is a FIFO), not followed.
    let stat = linux_buffer(144)
    do linux_syscall6(262, 0 - 100, buffer_address(linux_cstring("fifo6.d/pipe.txt")), buffer_address(stat), 256, 0, 0)
    if (linux_u32(stat, 24) & 61440) == 4096: do text_add(out, "\npipe.txt is still a FIFO") end
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
