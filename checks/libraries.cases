case grid map: the caller's limits hold: a map wider or taller than allowed is refused where it passes them, and limits outside 3 to 255 are refused
libs linux text grid_map
source until ----
func limits(out, what, count, maxw, maxh):
    let s = "#####\n#P .#\n#####\n"
    let m = grid_map_parse(linux_cstring(s), count, maxw, maxh)
    do text_add(out, what)
    do text_add(out, ": ")
    do text_add_whole(out, m.status)
    do text_add(out, ", row ")
    do text_add_whole(out, m.error_row)
    do text_add(out, " column ")
    do text_add_whole(out, m.error_column)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- The map is five wide and three high, eighteen bytes.
    do limits(out, "at most 5 by 3", 18, 5, 3)
    do limits(out, "at most 4 wide", 18, 4, 3)
    do limits(out, "at most 2 high, as a limit may not be", 18, 5, 2)
    do limits(out, "at most 3 wide", 18, 3, 3)
    do limits(out, "a width limit of 256", 18, 256, 3)
    do limits(out, "more bytes than the buffer has", 99, 5, 3)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
at most 5 by 3: 0, row 0 column 0
at most 4 wide: 3, row 1 column 5
at most 2 high, as a limit may not be: 13, row 0 column 0
at most 3 wide: 3, row 1 column 4
a width limit of 256: 13, row 0 column 0
more bytes than the buffer has: 13, row 0 column 0
----
end
case pixel text: every printable ASCII character has its own glyph of 35 cells, and only the space is blank
libs linux text pixel_text
source until ----
-- Whether glyph g is 35 cells of 0 and 1; ink is set to how many are 1.
func cells(g):
    if length(g) != 35: return (false, 0) end
    let ink = 0
    let i = 0
    while i < 35:
        if index(g, i) == '1': ink = ink + 1 elif index(g, i) != '0': return (false, 0) end
        i = i + 1
    end
    return (true, ink)
end

func main():
    let good = 0
    let blank = new_buffer()
    let alike = 0
    let ch = 32
    while ch <= 126:
        let c = cells(pixel_glyph(ch))
        if c.0: good = good + 1 end
        if c.0 and c.1 == 0: do append(blank, ch) end
        let other = ch + 1
        while other <= 126:
            if equal(pixel_glyph(ch), pixel_glyph(other)): alike = alike + 1 end
            other = other + 1
        end
        ch = ch + 1
    end
    -- Any other byte still gets 35 cells, so drawing it reads no cell that is not there.
    let any = 0
    ch = 0
    while ch < 256:
        if cells(pixel_glyph(ch)).0: any = any + 1 end
        ch = ch + 1
    end
    let out = new_buffer()
    do text_add_whole(out, good)
    do text_add(out, " of the 95 from space to ~ are 35 cells\nblank: [")
    do text_add(out, freeze(blank))
    do text_add(out, "]\npairs drawn alike: ")
    do text_add_whole(out, alike)
    do text_add(out, "\nof all 256 bytes, 35 cells: ")
    do text_add_whole(out, any)
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
95 of the 95 from space to ~ are 35 cells
blank: [ ]
pairs drawn alike: 0
of all 256 bytes, 35 cells: 256
----
end
case pixel text: a glyph is seven rows of five cells, top row first: T is a bar over a stem, L a stem on a bar
libs linux text pixel_text
source until ----
func picture(out, ch):
    let g = pixel_glyph(ch)
    let i = 0
    while i < 35:
        if index(g, i) == '1': do text_add(out, "#") else: do text_add(out, ".") end
        if i % 5 == 4: do text_add(out, "\n") end
        i = i + 1
    end
    return 0
end

func main():
    let out = new_buffer()
    do picture(out, 'T')
    do text_add(out, "\n")
    do picture(out, 'L')
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
