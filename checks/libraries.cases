limit 120
end
case net: a reading knock whose connect Linux refuses at once, with no route to the computer, no permission or an error no knock expects, ends at once with its outcome and its socket closed
libs linux text net fault
source until ----
-- Each error in a process of its own (a filter Linux puts on cannot be taken off), Scope's reading knock
-- to 127.77.0.1, with every connect failed by Linux with that error.
func one(name, error):
    let pid = linux_syscall6(57, 0, 0, 0, 0, 0, 0)
    if pid == 0:
        let n = net_new()
        let poll = linux_buffer(8)
        let null = linux_cstring("/dev/null")
        let free = linux_open(null, 0, 0)
        do linux_close(free)
        let f = fault_new()
        do fault_fail(f, 42, error)
        if fault_start(fault_ready(f)) != 0: do linux_die("no filter\n") end
        let o = net_start_reading(n, net_ipv4("127.77.0.1").1, 47799, 2000)
        while o == 5:
            do linux_poll(n.state.fd, poll, n.state.events, net_left(n))
            o = net_check(n)
        end
        let after = linux_open(null, 0, 0)
        let out = new_buffer()
        do text_add(out, name)
        do text_add(out, ": ")
        do text_add(out, net_outcome_name(o))
        do text_add(out, ", error ")
        do text_add_whole(out, n.state.error)
        if after == free: do text_add(out, ", its socket closed\n") else: do text_add(out, ", its socket left open\n") end
        do flogger(freeze(out))
        do process_exit(0)
    end
    let status = linux_buffer(8)
    do linux_syscall6(61, pid, buffer_address(status), 0, 0, 0, 0)
    if linux_u32(status, 0) != 0: do flogger("  that process did not end with status 0\n") end
    return 0
end

func main():
    do one("no route to the computer (EHOSTUNREACH)", 113)
    do one("no permission (EACCES)", 13)
    do one("an error no knock expects (EBADMSG)", 74)
    do process_exit(0)
    return 0
end
----
stdout until ----
no route to the computer (EHOSTUNREACH): unreachable, error 113, its socket closed
no permission (EACCES): error, error 13, its socket closed
an error no knock expects (EBADMSG): error, error 74, its socket closed
----
end
