case figures: with no drive among the sensors the helper's line says none, and a drive reading that is empty or gone is n/a
libs linux text figures
source until ----
func folder(path):
    return linux_syscall6(83, buffer_address(linux_cstring(path)), 448, 0, 0, 0, 0)
end

func put(path, text):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(text), 0, length(text))
    return linux_close(fd)
end

-- Find the sensors under root and write the helper's line for them, with fixed processor, memory and disk.
func line(out, root):
    let heat = figures_heat_new()
    do figures_heat_find(heat, root)
    do figures_heat_read(heat)
    let disk = figures_disk_new(".")
    disk.state = 2
    let b = linux_buffer(figures_reply_longest())
    let n = figures_reply_put(b, (true, 10000, 1500), (true, 16384000, 4096000), disk, heat.drive)
    do text_add(out, root)
    do text_add(out, ": ")
    return text_add_span(out, b, 0, n)
end

func drive(out, what, heat):
    do figures_heat_read(heat)
    do text_add(out, what)
    if heat.drive.state != 1: return text_add(out, ": drive n/a\n") end
    do text_add(out, ": drive ")
    do text_add_whole(out, heat.drive.reading)
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- A computer with no hwmon devices at all, and one whose only device is not a drive.
    do folder("none.d")
    do line(out, "none.d")
    do folder("other.d")
    do folder("other.d/hwmon0")
    do put("other.d/hwmon0/name", "acpitz\n")
    do put("other.d/hwmon0/temp1_input", "27800\n")
    do line(out, "other.d")
    -- A drive whose reading file is emptied, and then taken away, while the program runs.
    do folder("hw.d")
    do folder("hw.d/hwmon1")
    do put("hw.d/hwmon1/name", "nvme\n")
    do put("hw.d/hwmon1/temp1_input", "35850\n")
    let heat = figures_heat_new()
    do figures_heat_find(heat, "hw.d")
    do drive(out, "as found", heat)
    do put("hw.d/hwmon1/temp1_input", "")
    do drive(out, "emptied", heat)
    do linux_syscall6(87, buffer_address(linux_cstring("hw.d/hwmon1/temp1_input")), 0, 0, 0, 0, 0)
    do drive(out, "removed", heat)
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
stdout until ----
none.d: herbert-scope 2 10000 1500 16384000 4096000 unavailable none
other.d: herbert-scope 2 10000 1500 16384000 4096000 unavailable none
as found: drive 35850
emptied: drive n/a
removed: drive n/a
----
end
