case child: a caller whose own standard input and output are closed still gets the right answers, and the program's output goes to its file
libs linux text child
source until ----
-- This program runs itself: as "say" it is the program being run.
func say(what, ran):
    let line = new_buffer()
    do text_add(line, what)
    do text_add_whole(line, ran.0)
    do text_add(line, " ")
    do text_add_whole(line, ran.1)
    do text_add(line, "\n")
    return freeze(line)
end

func main():
    let args = linux_arguments()
    if equal(linux_argument(args, 1), "say"):
        do flogger("said by the program being run\n")
        do process_exit(0)
    end
    let c = child_new()
    let here = linux_cstring("./a.out")
    let missing = linux_cstring("./cc-no-such-program")
    let argv = child_arguments(2)
    do child_argument(argv, 0, here)
    do child_argument(argv, 1, linux_cstring("say"))
    let keep_in = linux_syscall6(72, 0, 0, 10, 0, 0, 0)
    let keep_out = linux_syscall6(72, 1, 0, 11, 0, 0, 0)
    do linux_close(0)
    do linux_close(1)
    let first = say("a program that is not there: ", child_run(c, c.none, missing, argv, c.none, linux_cstring("cc-missing.out"), c.none, 20))
    let second = say("a program that is: ", child_run(c, c.none, here, argv, c.none, linux_cstring("cc.out"), c.none, 20))
    do linux_syscall6(33, keep_in, 0, 0, 0, 0, 0)
    do linux_syscall6(33, keep_out, 1, 0, 0, 0, 0)
    do linux_close(keep_in)
    do linux_close(keep_out)
    do flogger(first)
    do flogger(second)
    let nothing = linux_read_file("cc-missing.out", 4096)
    let said = linux_read_file("cc.out", 4096)
    let line = new_buffer()
    do text_add(line, "the first wrote ")
    do text_add_whole(line, nothing.2)
    do text_add(line, " bytes to its file, and the second: ")
    do text_add_span(line, said.1, 0, said.2)
    do flogger(freeze(line))
    do process_exit(0)
    return 0
end
----
stdout until ----
a program that is not there: 2 0
a program that is: 0 0
the first wrote 0 bytes to its file, and the second: said by the program being run
----
end
case file: a save whose fsync fails is refused with error 5, the file stays the one it was with its bytes, and no temporary file is left
libs linux text file_io fault
source until ----
-- A file at path holding the bytes of s, made without the library.
func write_file(path, s):
    let fd = linux_open(linux_cstring(path), 577, 420)
    do linux_write(fd, linux_cstring(s), 0, length(s))
    return linux_close(fd)
end

-- Whether the file at path holds exactly s, read without the library.
func holds(path, s):
    let file = linux_read_file(path, 4096)
    return file.0 == 0 and text_is(file.1, 0, file.2, s)
end

-- The inode of the file at path (Linux's struct stat has it at 8).
func inode(path):
    let fd = linux_open(linux_cstring(path), 0, 0)
    let answer = linux_buffer(144)
    do linux_fstat(fd, answer)
    do linux_close(fd)
    return linux_u64(answer, 8)
end

-- How many names in the folder at path begin with prefix, "." and ".." not counted. Linux's
-- getdents64 is 217; in each record the length is at 16 and the name from 19.
func names(path, prefix):
    let fd = linux_open(linux_cstring(path), 65536, 0)
    let dents = linux_buffer(4096)
    let found = 0
    let got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    while not linux_error(got) and got != 0:
        let p = 0
        while p < got:
            let name = p + 19
            let stop = linux_nul_end(dents, name, p + linux_u16(dents, p + 16))
            if text_starts(dents, name, stop, prefix) and not text_is(dents, name, stop, ".") and not text_is(dents, name, stop, ".."): found = found + 1 end
            p = p + linux_u16(dents, p + 16)
        end
        got = linux_syscall6(217, fd, buffer_address(dents), 4096, 0, 0, 0)
    end
    do linux_close(fd)
    return found
end

func result(out, r):
    if not linux_error(r): return text_add_whole(out, r) end
    do text_add(out, "error ")
    return text_add_whole(out, 0 - r)
end

func main():
    -- A folder of its own (Linux's mkdir is 83) and one document in it.
    do linux_syscall6(83, buffer_address(linux_cstring("fault-fsync.d")), 448, 0, 0, 0, 0)
    do write_file("fault-fsync.d/doc.txt", "old\n")
    let f = file_open("fault-fsync.d/doc.txt", 64)
    let out = new_buffer()
    do text_add(out, "a save: ")
    do result(out, file_save(f, linux_cstring("first\n"), 6))
    let before = inode("fault-fsync.d/doc.txt")
    -- From here every fsync (74) of this program fails with EIO (5).
    let fault = fault_new()
    do fault_fail(fault, 74, 5)
    do text_add(out, "\nthe filter: ")
    do result(out, fault_start(fault_ready(fault)))
    do text_add(out, "\na save while fsync fails: ")
    do result(out, file_save(f, linux_cstring("second\n"), 7))
    if holds("fault-fsync.d/doc.txt", "first\n"): do text_add(out, "\nthe file holds the first save") end
    if inode("fault-fsync.d/doc.txt") == before: do text_add(out, "\nand is the same file") end
    do text_add(out, "\nnames in the folder: ")
    do text_add_whole(out, names("fault-fsync.d", ""))
    do text_add(out, ", of them temporary files: ")
    do text_add_whole(out, names("fault-fsync.d", ".herbert-save-"))
    do text_add(out, "\n")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
