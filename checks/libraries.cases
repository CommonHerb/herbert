    do show(s, linux_cstring("abc"), 3)
    do show(s, linux_cstring(""), 0)
    do show(s, linux_cstring("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), 56)
    let million = new_buffer()
    do buffer_fill(million, 1000000, 97)
    do show(s, million, 1000000)
    do process_exit(0)
    return 0
end
