case display: a precomposed accented letter is drawn exactly as its letter with the combining accent
libs linux text pixel_text utf8 unicode_display
source until ----
func hex_digit(c):
    if c <= 57: return c - 48 end
    return c - 55
end

-- The scalars s names in hex, a space between them, as UTF-8 bytes.
func scalars(s):
    let b = new_buffer()
    let one = linux_buffer(4)
    let cp = 0
    let i = 0
    while i <= length(s):
        if i == length(s) or index(s, i) == 32:
            do text_add_span(b, one, 0, utf8_store(one, 0, cp))
            cp = 0
        else:
            cp = cp * 16 + hex_digit(index(s, i))
        end
        i = i + 1
    end
    return b
end

-- The ink of the cluster s in its cell of 5 by 10, as fifty characters.
func ink(s):
    let b = scalars(s)
    let shape = unicode_display_shape(b, 0, buffer_length(b))
    let cells = new_buffer()
    let i = 0
    while i < 50:
        if unicode_display_ink(shape.0, shape.1, shape.2, i): do append(cells, '#') else: do append(cells, '.') end
        i = i + 1
    end
    return freeze(cells)
end

func compare(out, whole, parts, bare):
    do text_add(out, whole)
    if equal(ink(whole), ink(parts)): do text_add(out, " is drawn as ") else: do text_add(out, " is NOT drawn as ") end
    do text_add(out, parts)
    if equal(ink(whole), ink(bare)): do text_add(out, ", and no differently from the bare letter") end
    return text_add(out, "\n")
end

func main():
    let out = new_buffer()
    -- e acute, A grave, O circumflex, n tilde, u diaeresis, a ring, c cedilla, y diaeresis.
    do compare(out, "E9", "65 301", "65")
    do compare(out, "C0", "41 300", "41")
    do compare(out, "D4", "4F 302", "4F")
    do compare(out, "F1", "6E 303", "6E")
    do compare(out, "FC", "75 308", "75")
    do compare(out, "E5", "61 30A", "61")
    do compare(out, "E7", "63 327", "63")
    do compare(out, "FF", "79 308", "79")
    do flogger(freeze(out))
    do process_exit(0)
    return 0
end
----
