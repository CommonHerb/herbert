-- The stand-in compiler for the seed maker's checks (checks/seeds.herb): a
-- small program that takes the compiler's place and can fail on purpose, so
-- the checks can show the seed maker refusing each way a compiler can fail
-- it. Needs lib/linux.herb in front.
--
-- Like the compiler it takes no arguments, reads a source from standard
-- input, writes a program to a.out in the folder it runs in, prints the
-- marker "0" and ends with status 0. The program it writes is a copy of
-- itself: a compiler that rebuilds itself. The source's first line says what
-- it does instead, "-- stand-in WORD":
--   same       nothing else
--   drift      the copy is one byte longer than itself, every time: a
--              compiler that never rebuilds itself
--   settle     the copy is longer by the line "settled", and a copy that ends
--              so writes itself unchanged: a new compiler, different from
--              the seed, that rebuilds itself (and can compile nothing)
--   late       the copy is longer by the line "later", and a copy that ends
--              so writes itself and ends with status 7: a new compiler that
--              fails where the seed did not
--   late-noisy, late-marker, late-nothing, late-text, late-link
--              the copy is longer by the line "later", as for late, and a
--              copy that ends so does what noisy, marker, nothing, text or
--              link says below: a new compiler that fails so where the seed
--              did not
--   seesaw     the copy is longer by the line "seesaw-a", and a copy that
--              ends so writes itself with "seesaw-b" in that line's place,
--              and one that ends with "seesaw-b" itself with "seesaw-a": a new
--              compiler that never rebuilds itself, though it writes a copy
--              of its own length
--   heavy      the copy is longer by the line "heavy", and a copy that ends
--              so fills 200 MiB before it writes itself: a new compiler
--              that needs more memory than a compiler may
--   status     ends with status 7
--   crash      writes its copy and the marker, then is stopped by a signal
--   noisy      says a line on standard error
--   marker     prints a second line after the marker
--   silent     prints no marker
--   bare       prints the marker 0 without its newline
--   one        prints the marker 1 and a newline, where 0 and a newline are
--              asked for: a marker of the right length that is not the marker
--   nothing    writes no program
--   text       writes a script, not a Linux program
--   link       writes its copy to the file "copy" beside it and leaves a.out
--              a link to that file, not a file of its own
--   edit PATH  first adds a line to the end of the file at PATH (the rest of
--              the line), making the file if it is not there: a file changed
--              while the seed maker runs, or the mark that a compiler ran
--   flip PATH  first writes the byte X over the first byte of the file at
--              PATH, which keeps its length: a file changed while the seed
--              maker runs, of the size it was
--   relink PATH  first moves the folder at PATH to PATH.moved and puts a link
--              to it at PATH: a folder that is a link since the seed maker
--              looked, with the same files to be found through it
--   swap PATH  first moves the file at PATH into the folder above its own,
--              under its name with .moved after it, and puts a link to it at
--              PATH: a file that is a link since the seed maker looked, with
--              the same bytes to be read through it
--   stop PATH  first writes its process number and a newline to the file at
--              PATH, then stops the program that started it with the signal
--              TERM, then waits 30 seconds before it does anything else: a
--              seed maker stopped from outside while a compiler runs
-- Any other source, a case's program among them, is taken as same.

-- Whether the count bytes of b end with s.
func stand_in_ends(b, count, s):
    if count < length(s): return false end
    let i = 0
    while i < length(s):
        if buffer_get(b, count - length(s) + i) != index(s, i): return false end
        i = i + 1
    end
    return true
end

-- Whether source starts with the stand-in's line for word: "-- stand-in ",
-- the word, and then a space or the end of the line.
func stand_in_asks(source, word):
    let want = "-- stand-in "
    let n = length(want) + length(word)
    if length(source) <= n or not equal(slice(source, 0, length(want)), want): return false end
    return equal(slice(source, length(want), n), word) and (index(source, n) == 32 or index(source, n) == 10)
end

-- The rest of the source's first line from at: the name after the word.
func stand_in_name(source, at):
    let i = at
    while i < length(source) and index(source, i) != 10:
        i = i + 1
    end
    return slice(source, at, i)
end

-- Write a.out, as the compiler does: the count bytes of own and then more.
func stand_in_write(own, count, more):
    let out = linux_buffer(count + length(more))
    do buffer_copy(out, 0, own, 0, count)
    do linux_text(out, count, more)
    do fwriter(freeze(out))
    return 0
end

-- Add a line to the end of the file the source's first line names after
-- "-- stand-in edit ".
func stand_in_edit(source):
    let path = linux_cstring(stand_in_name(source, 17))
    let fd = linux_open(path, 525377, 420)
    if linux_error(fd): return 0 end
    let line = linux_cstring("changed by the stand-in\n")
    do linux_write(fd, line, 0, 24)
    do linux_close(fd)
    return 0
end

-- Write the byte X over the first byte of the file the source's first line
-- names after "-- stand-in flip ". A second time changes nothing more.
func stand_in_flip(source):
    let path = linux_cstring(stand_in_name(source, 17))
    let fd = linux_open(path, 524289, 0)
    if linux_error(fd): return 0 end
    do linux_write(fd, linux_cstring("X"), 0, 1)
    do linux_close(fd)
    return 0
end

-- Move the folder the source's first line names after "-- stand-in relink "
-- and put a link to it in its place. A second time nothing happens: the link
-- cannot be moved onto the folder.
func stand_in_relink(source):
    let name = stand_in_name(source, 19)
    let path = linux_cstring(name)
    let moved = linux_buffer(length(name) + 7)
    do linux_text(moved, 0, name)
    do linux_text(moved, length(name), ".moved")
    if linux_error(linux_syscall6(82, buffer_address(path), buffer_address(moved), 0, 0, 0, 0)): return 0 end
    do linux_syscall6(88, buffer_address(moved), buffer_address(path), 0, 0, 0, 0)
    return 0
end

-- Move the file the source's first line names after "-- stand-in swap " into
-- the folder above its own, under its name with .moved after it, and put a
-- link to it in its place. A second time nothing happens: Linux is asked not
-- to replace a file that is there, and the .moved one is.
func stand_in_swap(source):
    let path = new_buffer()
    let i = 17
    let last = 0
    let before = 0
    while i < length(source) and index(source, i) != 10:
        if index(source, i) == 47:
            before = last
            last = i
        end
        do append(path, index(source, i))
        i = i + 1
    end
    do append(path, 0)
    let moved = new_buffer()
    let k = 17
    while k <= before:
        do append(moved, index(source, k))
        k = k + 1
    end
    k = last + 1
    while k < i:
        do append(moved, index(source, k))
        k = k + 1
    end
    let tail = ".moved"
    k = 0
    while k < length(tail):
        do append(moved, index(tail, k))
        k = k + 1
    end
    do append(moved, 0)
    if linux_error(linux_syscall6(316, 0 - 100, buffer_address(path), 0 - 100, buffer_address(moved), 1, 0)): return 0 end
    do linux_syscall6(88, buffer_address(moved), buffer_address(path), 0, 0, 0, 0)
    return 0
end

-- Write this process's number and a newline to the file the source's first
-- line names after "-- stand-in stop ", stop the program that started it
-- with the signal TERM, and wait 30 seconds.
func stand_in_stop(source):
    let path = linux_cstring(stand_in_name(source, 17))
    let digits = linux_buffer(24)
    let n = linux_decimal(digits, 0, linux_syscall6(39, 0, 0, 0, 0, 0, 0))
    do buffer_set(digits, n, 10)
    let fd = linux_open(path, 524865, 420)
    if not linux_error(fd):
        do linux_write(fd, digits, 0, n + 1)
        do linux_close(fd)
    end
    do linux_syscall6(62, linux_syscall6(110, 0, 0, 0, 0, 0, 0), 15, 0, 0, 0, 0)
    let nap = linux_buffer(16)
    do linux_put64(nap, 0, 30)
    do linux_sleep(nap)
    return 0
end

-- Write the count bytes of own to the file "copy", which may be run, and
-- make a.out a link to it.
func stand_in_link(own, count):
    let fd = linux_open(linux_cstring("copy"), 524865, 493)
    if linux_error(fd): return 0 end
    do linux_write(fd, own, 0, count)
    do linux_close(fd)
    do linux_syscall6(88, buffer_address(linux_cstring("copy")), buffer_address(linux_cstring("a.out")), 0, 0, 0, 0)
    return 0
end

-- Whether source asks for one of the words that grow the copy by "later".
func stand_in_late(source):
    return stand_in_asks(source, "late") or stand_in_asks(source, "late-noisy") or stand_in_asks(source, "late-marker") or stand_in_asks(source, "late-nothing") or stand_in_asks(source, "late-text") or stand_in_asks(source, "late-link")
end

func main():
    let input = stdin_read()
    if input.0 != 0:
        do linux_die("stand-in compiler: cannot read standard input\n")
    end
    let source = input.1
    let self = linux_read_file("/proc/self/exe", 4194304)
    if self.0 != 0:
        do linux_die("stand-in compiler: cannot read its own program\n")
    end
    let own = self.1
    let count = self.2
    let status = 0
    let later = stand_in_ends(own, count, "later\n")
    if stand_in_asks(source, "nothing") or (later and stand_in_asks(source, "late-nothing")):
        do flogger("0\n")
        do process_exit(0)
    elif stand_in_asks(source, "text") or (later and stand_in_asks(source, "late-text")):
        do fwriter("#!/bin/sh\nexit 0\n")
    elif stand_in_asks(source, "drift"):
        do stand_in_write(own, count, "+")
    elif stand_in_asks(source, "seesaw"):
        if stand_in_ends(own, count, "seesaw-a\n"):
            do stand_in_write(own, count - 9, "seesaw-b\n")
        elif stand_in_ends(own, count, "seesaw-b\n"):
            do stand_in_write(own, count - 9, "seesaw-a\n")
        else:
            do stand_in_write(own, count, "seesaw-a\n")
        end
    elif stand_in_asks(source, "settle") and not stand_in_ends(own, count, "settled\n"):
        do stand_in_write(own, count, "settled\n")
    elif stand_in_late(source) and not later:
        do stand_in_write(own, count, "later\n")
    elif stand_in_asks(source, "heavy") and not stand_in_ends(own, count, "heavy\n"):
        do stand_in_write(own, count, "heavy\n")
    elif stand_in_asks(source, "link") or (later and stand_in_asks(source, "late-link")):
        do stand_in_link(own, count)
    else:
        if stand_in_asks(source, "stop"): do stand_in_stop(source) end
        if stand_in_asks(source, "edit"): do stand_in_edit(source) end
        if stand_in_asks(source, "relink"): do stand_in_relink(source) end
        if stand_in_asks(source, "swap"): do stand_in_swap(source) end
        if stand_in_asks(source, "flip"): do stand_in_flip(source) end
        if stand_in_asks(source, "heavy"):
            let big = new_buffer()
            do buffer_fill(big, 209715200, 1)
        end
        do stand_in_write(own, count, "")
        if stand_in_asks(source, "status") or stand_in_asks(source, "late"): status = 7 end
        if stand_in_asks(source, "noisy") or stand_in_asks(source, "late-noisy"): do stderr_write("stand-in compiler: a line nobody asked for\n") end
    end
    if stand_in_asks(source, "bare"):
        do flogger("0")
    elif stand_in_asks(source, "one"):
        do flogger("1\n")
    elif not stand_in_asks(source, "silent"):
        do flogger("0\n")
    end
    if stand_in_asks(source, "marker") or (later and stand_in_asks(source, "late-marker")): do flogger("and a second line\n") end
    if stand_in_asks(source, "crash"): do linux_syscall6(62, linux_syscall6(39, 0, 0, 0, 0, 0, 0), 15, 0, 0, 0, 0) end
    do process_exit(status)
    return 0
end
